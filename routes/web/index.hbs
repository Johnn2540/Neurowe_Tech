<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    {{> header}}
    
    <main>
        <div class="container" style="padding: 120px 0 80px;">
            <div class="text-center" style="margin-bottom: 60px;">
                <h1>Our Services</h1>
                <p style="color: var(--text-secondary); max-width: 600px; margin: 20px auto;">Comprehensive technology solutions tailored to your business needs</p>
            </div>
            
            <div class="services-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
                {{#each services}}
                <div class="service-card" style="background: var(--card-bg); border-radius: 16px; padding: 32px; text-align: center; transition: transform 0.3s, box-shadow 0.3s; cursor: pointer; border: 1px solid var(--border);">
                    <div class="service-icon" style="font-size: 48px; color: {{color}}; margin-bottom: 20px;">
                        <i class="{{icon}}"></i>
                    </div>
                    <h3 style="margin-bottom: 12px;">{{name}}</h3>
                    <p style="color: var(--text-secondary); margin-bottom: 24px;">{{description}}</p>
                    <a href="/services/{{slug}}" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">Learn More <i class="fas fa-arrow-right"></i></a>
                </div>
                {{/each}}
            </div>
        </div>
    </main>
    
    {{> footer}}
</body>
</html>