# Update .gitignore with proper content
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
npm-debug.log*
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.production
.env.*.local

# Database files
*.db
*.sqlite
*.sqlite3
init-db.js

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build files
dist/
build/
.next/
out/

# Render files
.render/

# Coverage directory
coverage/
.nyc_output/

# Temporary files
tmp/
temp/

# Secret files
*.pem
*.key
*.crt
EOF
.vercel
.env*
