.t-author { display:flex; align-items:center; gap:12px; }
.t-avatar { width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.2rem; flex-shrink:0; }
.t-name { font-weight:700; font-size:.88rem; }
.t-role { font-size:.75rem; color:var(--slate); }

/* ══════════════════════════════════════════
   BLOG
══════════════════════════════════════════ */
.blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
.blog-card {
  background:#fff; border-radius:var(--r-xl); padding:26px;
  border:1px solid var(--mist); transition:var(--t); display:flex; flex-direction:column;
}
.blog-card:hover { transform:translateY(-6px); box-shadow:var(--sh-card-h); }
.blog-meta { font-size:.73rem; color:var(--slate); margin-bottom:8px; }
.blog-cat {
  display:inline-block; font-size:.66rem; font-weight:800; padding:3px 12px;
  border-radius:var(--r-pill); text-transform:uppercase; letter-spacing:.5px; margin-bottom:12px;
}
.blog-cat.dev  { background:rgba(37,99,235,.1); color:var(--cobalt); }
.blog-cat.ai   { background:rgba(16,185,129,.1); color:var(--emerald); }
.blog-cat.ui   { background:rgba(124,58,237,.1); color:var(--violet); }
.blog-card h4  { font-size:1rem; font-weight:700; margin-bottom:8px; line-height:1.4; }
.blog-card .desc { font-size:.83rem; color:var(--slate); line-height:1.6; flex-grow:1; margin-bottom:14px; }

/* ══════════════════════════════════════════
   FAQ
══════════════════════════════════════════ */
.faq-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.faq-item {
  background:#fff; border-radius:var(--r-lg); border:1px solid var(--mist);
  overflow:hidden; transition:border-color .3s;
}
.faq-item:hover { border-color:var(--cobalt); }
.faq-q {
  padding:16px 20px; font-weight:700; font-size:.9rem; cursor:pointer;
  display:flex; justify-content:space-between; align-items:center;
  font-family:var(--font-head); transition:var(--t);
}
.faq-icon { color:var(--cobalt); font-size:.78rem; transition:transform .3s; flex-shrink:0; margin-left:12px; }
.faq-a {
  padding:0 20px; max-height:0; overflow:hidden; transition:all .32s;
  color:var(--slate); font-size:.86rem; line-height:1.7;
}
.faq-item.open .faq-a { max-height:200px; padding:0 20px 16px; }
.faq-item.open .faq-icon { transform:rotate(45deg); }

/* ══════════════════════════════════════════
   CONTACT
══════════════════════════════════════════ */
.contact-section { background:var(--g-dark); position:relative; overflow:hidden; }
.contact-form-wrap {
