<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script>
AOS.init({duration:780,once:true,offset:55,easing:'ease-out-cubic'});

/* CURSOR */
(function(){var dot=document.getElementById('cursor-dot'),ring=document.getElementById('cursor-ring'),lbl=document.getElementById('cursor-label');if(!dot||!ring)return;var mx=window.innerWidth/2,my=window.innerHeight/2,rx=mx,ry=my;document.addEventListener('mouseleave',function(){document.body.classList.add('cursor-hidden');});document.addEventListener('mouseenter',function(){document.body.classList.remove('cursor-hidden');});document.addEventListener('mousedown',function(){document.body.classList.add('cursor-click');});document.addEventListener('mouseup',function(){document.body.classList.remove('cursor-click');});window.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;dot.style.left=mx+'px';dot.style.top=my+'px';},{passive:true});(function loop(){rx+=(mx-rx)*.13;ry+=(my-ry)*.13;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(loop);})();function mode(m,t){document.body.classList.remove('cursor-hover','cursor-view','cursor-text');if(m)document.body.classList.add('cursor-'+m);if(lbl)lbl.textContent=t||'';}document.querySelectorAll('a,button,[role="button"]').forEach(function(el){el.addEventListener('mouseenter',function(){mode('hover','');});el.addEventListener('mouseleave',function(){mode('','');});});document.querySelectorAll('input,textarea,select').forEach(function(el){el.addEventListener('mouseenter',function(){mode('text','');});el.addEventListener('mouseleave',function(){mode('','');});});document.querySelectorAll('.service-card').forEach(function(el){el.addEventListener('mouseenter',function(){mode('view','EXPLORE');});el.addEventListener('mouseleave',function(){mode('','');});});document.querySelectorAll('.btn-primary,.btn-orange,.cta-btn-white,.cta-btn-orange,.btn-nav-start').forEach(function(btn){btn.addEventListener('mousemove',function(e){var r=btn.getBoundingClientRect();btn.style.transform='translate('+(e.clientX-r.left-r.width/2)*.28+'px,'+(e.clientY-r.top-r.height/2)*.28+'px)';});btn.addEventListener('mouseleave',function(){btn.style.transform='';});});})();

/* PARTICLES */
(function(){var canvas=document.getElementById('hero-canvas');if(!canvas)return;var ctx=canvas.getContext('2d');var particles=[];function resize(){canvas.width=canvas.offsetWidth;canvas.height=canvas.offsetHeight;}resize();window.addEventListener('resize',resize,{passive:true});function rand(a,b){return Math.random()*(b-a)+a;}for(var i=0;i<55;i++){particles.push({x:rand(0,canvas.width),y:rand(0,canvas.height),vx:rand(-.18,.18),vy:rand(-.18,.18),r:rand(.8,2.2),alpha:rand(.12,.48),color:Math.random()>.55?'rgba(224,92,42,':Math.random()>.5?'rgba(37,99,235,':'rgba(28,43,74,'});}function draw(){ctx.clearRect(0,0,canvas.width,canvas.height);particles.forEach(function(p){p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=canvas.width;if(p.x>canvas.width)p.x=0;if(p.y<0)p.y=canvas.height;if(p.y>canvas.height)p.y=0;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle=p.color+p.alpha+')';ctx.fill();});for(var a=0;a<particles.length;a++)for(var b=a+1;b<particles.length;b++){var dx=particles[a].x-particles[b].x,dy=particles[a].y-particles[b].y,d=Math.sqrt(dx*dx+dy*dy);if(d<110){ctx.beginPath();ctx.moveTo(particles[a].x,particles[a].y);ctx.lineTo(particles[b].x,particles[b].y);ctx.strokeStyle='rgba(37,99,235,'+(0.04*(1-d/110))+')';ctx.lineWidth=.5;ctx.stroke();}}requestAnimationFrame(draw);}draw();})();

/* TYPEWRITER */
(function(){var el=document.getElementById('tw-text');if(!el)return;var phrases=['We Build Professional Websites','We Create Stunning Logos & Posters','We Help Businesses Grow Online','We Teach In-Demand Digital Skills'];var pIdx=0,cIdx=0,del=false;function tick(){var p=phrases[pIdx];if(!del){cIdx++;el.textContent=p.slice(0,cIdx);if(cIdx===p.length){del=true;setTimeout(tick,2500);return;}setTimeout(tick,52);}else{cIdx--;el.textContent=p.slice(0,cIdx);if(cIdx===0){del=false;pIdx=(pIdx+1)%phrases.length;setTimeout(tick,480);return;}setTimeout(tick,28);}}setTimeout(tick,1000);})();

/* SCROLL / NAV */
function smoothTo(id){var el=document.querySelector(id);if(!el)return;var off=document.getElementById('mainNav').offsetHeight;window.scrollTo({top:el.getBoundingClientRect().top+window.pageYOffset-off,behavior:'smooth'});}
document.addEventListener('click',function(e){var link=e.target.closest('a[href^="#"]');if(!link)return;var href=link.getAttribute('href');if(!href||href.length<=1)return;e.preventDefault();closeMob();setTimeout(function(){smoothTo(href);},window.innerWidth<992?310:0);});
var navbar=document.getElementById('mainNav'),backToTop=document.getElementById('back-to-top'),scrollPrg=document.getElementById('scroll-progress'),scrollInd=document.getElementById('scroll-ind');
window.addEventListener('scroll',function(){var st=window.pageYOffset,docH=document.documentElement.scrollHeight-window.innerHeight;scrollPrg.style.width=(docH>0?(st/docH)*100:0)+'%';navbar.classList.toggle('scrolled',st>40);backToTop.classList.toggle('visible',st>400);if(scrollInd)scrollInd.classList.toggle('hidden',st>100);var cur='';document.querySelectorAll('section[id]').forEach(function(s){if(st>=s.offsetTop-navbar.offsetHeight-30)cur=s.id;});document.querySelectorAll('.nav-links .nl-a').forEach(function(a){a.classList.toggle('active',a.getAttribute('href')==='#'+cur);});},{passive:true});
if(scrollInd)scrollInd.addEventListener('click',function(){smoothTo('#services');});
backToTop.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});

/* MOBILE NAV */
var mobOverlay=document.getElementById('mobOverlay'),mobPanel=document.getElementById('mobPanel'),hamBtn=document.getElementById('hamBtn'),mobClose=document.getElementById('mobClose'),mobSvcToggle=document.getElementById('mobSvcToggle'),mobSvcSub=document.getElementById('mobSvcSub');
function openMob(){mobOverlay.classList.add('open');mobPanel.classList.add('open');hamBtn.classList.add('open');hamBtn.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';mobClose.focus();}
function closeMob(){mobPanel.classList.remove('open');mobOverlay.classList.remove('open');hamBtn.classList.remove('open');hamBtn.setAttribute('aria-expanded','false');document.body.style.overflow='';}
hamBtn.addEventListener('click',openMob);mobClose.addEventListener('click',closeMob);mobOverlay.addEventListener('click',closeMob);
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&mobPanel.classList.contains('open'))closeMob();});
mobSvcToggle.addEventListener('click',function(){var o=mobSvcSub.classList.toggle('open');mobSvcToggle.classList.toggle('open',o);mobSvcToggle.setAttribute('aria-expanded',o);});

/* THEME — initial class applied here to prevent FOUC; widget.js handles all button wiring */
(function(){var d=localStorage.getItem('nw-theme')==='dark'||(!localStorage.getItem('nw-theme')&&window.matchMedia('(prefers-color-scheme:dark)').matches);document.body.classList.toggle('dark',d);})();

/* TOAST / COOKIE */
function showToast(msg,col){var t=document.getElementById('toast');t.style.borderLeftColor=col||'var(--emerald)';document.getElementById('toast-msg').textContent=msg;t.classList.add('show');setTimeout(function(){t.classList.remove('show');},3800);}
var cookieBar=document.getElementById('cookie-bar');
if(!localStorage.getItem('nw-cookie'))setTimeout(function(){cookieBar.classList.add('show');},2800);
document.getElementById('cookie-accept').addEventListener('click',function(){localStorage.setItem('nw-cookie','1');cookieBar.classList.remove('show');});

/* COUNTER */
var cObs=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(!entry.isIntersecting)return;var c=entry.target.querySelector('.counter');if(!c||c.dataset.done)return;c.dataset.done='1';var target=+c.dataset.target,step=target/(1600/16),val=0;(function tick(){val=Math.min(val+step,target);c.textContent=Math.floor(val);if(val<target)requestAnimationFrame(tick);})();});},{threshold:.4});
document.querySelectorAll('.stat-card,.impact-item').forEach(function(el){cObs.observe(el);});

/* FAQ */
document.querySelectorAll('.faq-q').forEach(function(q){q.addEventListener('click',function(){var item=q.parentElement,isOpen=item.classList.contains('open');document.querySelectorAll('.faq-item').forEach(function(i){i.classList.remove('open');});if(!isOpen)item.classList.add('open');});});

/* WA TOOLTIP */
(function(){var shown=sessionStorage.getItem('nw-wa-tip');if(!shown){setTimeout(function(){var tip=document.getElementById('wa-tooltip');if(tip){tip.classList.add('show');sessionStorage.setItem('nw-wa-tip','1');}},5500);}var closeBtn=document.getElementById('waTooltipClose');if(closeBtn){closeBtn.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();document.getElementById('wa-tooltip').classList.remove('show');});}var badge=document.getElementById('waBadge'),floatEl=document.getElementById('wa-float');if(floatEl&&badge){floatEl.addEventListener('mouseenter',function(){badge.style.opacity='0';badge.style.transform='scale(0)';});floatEl.addEventListener('click',function(){var tip=document.getElementById('wa-tooltip');if(tip)tip.classList.remove('show');});}})();

/* NEWSLETTER */
document.getElementById('nlForm').addEventListener('submit',async function(e){e.preventDefault();var email=document.getElementById('nlEmail').value.trim(),consent=document.getElementById('nlConsent').checked,btn=document.getElementById('nlBtn'),msg=document.getElementById('nlMsg');if(!email||!/^\S+@\S+\.\S+$/.test(email)){msg.innerHTML='<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Please enter a valid email.</span>';return;}if(!consent){msg.innerHTML='<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Please agree to receive emails.</span>';return;}var orig=btn.innerHTML;btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Subscribing...';btn.disabled=true;try{var res=await fetch('/subscribe',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email})});var data=await res.json();if(data.success){msg.innerHTML='<span style="color:var(--emerald)"><i class="fas fa-check-circle"></i> 🎉 Subscribed!</span>';document.getElementById('nlForm').reset();document.getElementById('nlConsent').checked=true;showToast('Subscribed! Welcome aboard 🎉');}else{msg.innerHTML='<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> '+(data.message||'Failed. Please try again.')+'</span>';}}catch(err){msg.innerHTML='<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Network error. Please try again.</span>';}finally{btn.innerHTML=orig;btn.disabled=false;setTimeout(function(){msg.innerHTML='';},5500);}});
</script>
{{> widget}}

<!-- ═══ PWA Install Popup ═══════════════════════════════════════════════════ -->
<style>
.pwa-popup {
  position: fixed;
  z-index: 99998;
  bottom: 24px;
  right: 24px;
  width: 356px;
  max-width: calc(100vw - 32px);
  background: #ffffff;
  border-radius: 20px;
  box-shadow: 0 20px 60px rgba(15,23,42,.18), 0 8px 20px rgba(15,23,42,.1);
  padding: 22px 22px 20px;
  transform: translateY(calc(100% + 40px));
  opacity: 0;
  transition: transform .44s cubic-bezier(.34,1.56,.64,1), opacity .28s ease;
  pointer-events: none;
  will-change: transform, opacity;
}
.pwa-popup.pwa-popup--visible {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}
.pwa-popup__close {
  position: absolute;
  top: 12px;
  right: 12px;
  background: none;
  border: none;
  cursor: pointer;
  color: #94a3b8;
  padding: 6px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .18s, color .18s;
  line-height: 1;
}
.pwa-popup__close:hover { background: #f1f5f9; color: #475569; }
.pwa-popup__header {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 12px;
  padding-right: 28px;
}
.pwa-popup__logo {
  flex-shrink: 0;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #1c2b4a;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 4px;
  box-shadow: 0 2px 8px rgba(28,43,74,.3);
}
.pwa-popup__logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.pwa-popup__title {
  font-size: 16px;
  font-weight: 700;
  color: #0f172a;
  margin: 0 0 3px;
  line-height: 1.25;
}
.pwa-popup__subtitle {
  font-size: 12px;
  color: #94a3b8;
  margin: 0;
}
.pwa-popup__desc {
  font-size: 13.5px;
  color: #475569;
  margin: 0 0 14px;
  line-height: 1.6;
}
.pwa-popup__features {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 18px;
}
.pwa-popup__feature {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11.5px;
  font-weight: 500;
  color: #1c2b4a;
  background: rgba(28,43,74,.07);
  padding: 4px 10px;
  border-radius: 999px;
}
.pwa-popup__feature svg { color: #059669; flex-shrink: 0; }
.pwa-popup__actions {
  display: flex;
  gap: 10px;
}
.pwa-popup__btn {
  flex: 1;
  border: none;
  border-radius: 11px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  padding: 11px 14px;
  transition: background .2s, transform .18s, box-shadow .18s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-family: inherit;
}
.pwa-popup__btn--install {
  background: #1c2b4a;
  color: #ffffff;
}
.pwa-popup__btn--install:hover {
  background: #2d4270;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(28,43,74,.3);
}
.pwa-popup__btn--install:active { transform: translateY(0); }
.pwa-popup__btn--dismiss {
  background: #f1f5f9;
  color: #64748b;
}
.pwa-popup__btn--dismiss:hover { background: #e2e8f0; color: #334155; }
/* Mobile: full-width bottom sheet */
@media (max-width: 480px) {
  .pwa-popup {
    bottom: 0;
    right: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    border-radius: 20px 20px 0 0;
    padding: 22px 20px calc(20px + env(safe-area-inset-bottom, 0px));
  }
}
/* Dark mode */
body.dark .pwa-popup {
  background: #1e293b;
  box-shadow: 0 20px 60px rgba(0,0,0,.45), 0 8px 20px rgba(0,0,0,.25);
}
body.dark .pwa-popup__title  { color: #f1f5f9; }
body.dark .pwa-popup__desc   { color: #94a3b8; }
body.dark .pwa-popup__subtitle { color: #64748b; }
body.dark .pwa-popup__feature { background: rgba(255,255,255,.08); color: #cbd5e1; }
body.dark .pwa-popup__close  { color: #64748b; }
body.dark .pwa-popup__close:hover { background: rgba(255,255,255,.07); color: #94a3b8; }
body.dark .pwa-popup__btn--dismiss {
  background: rgba(255,255,255,.07);
  color: #94a3b8;
}
body.dark .pwa-popup__btn--dismiss:hover {
  background: rgba(255,255,255,.12);
  color: #cbd5e1;
}
</style>

