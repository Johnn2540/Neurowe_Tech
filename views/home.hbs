<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Web & App Development in Kenya | NeuroWex Tech</title>
  <meta name="description" content="NeuroWex Tech provides professional web development, mobile app development, and graphic design services in Kenya." />
  <link rel="canonical" href="https://neurowextech.co.ke/" />
  <meta property="og:title" content="NeuroWex Tech | Web & App Development Kenya" />
  <meta property="og:type" content="website" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;0,9..144,700;1,9..144,300;1,9..144,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
<style>
:root {
  --blue:        #1a4fd6;
  --blue-d:      #1340b0;
  --blue-l:      #4a7aee;
  --blue-pale:   rgba(26,79,214,.08);
  --blue-pale2:  rgba(26,79,214,.14);
  --orange:      #e8620a;
  --orange-d:    #c94f05;
  --orange-l:    #f28840;
  --orange-pale: rgba(232,98,10,.08);
  --black:       #050810;
  --ink:         #0c1220;
  --ink-2:       #141c30;
  --ink-3:       #1c2840;
  --slate:       #5a6880;
  --slate-l:     #7a8ea8;
  --mist:        #e2e8f5;
  --mist-d:      #cdd6ec;
  --ghost:       #f5f7fd;
  --white:       #ffffff;
  --emerald:     #059669;
  --teal:        #0d9488;
  --rose:        #e11d48;

  --g-blue:      linear-gradient(135deg,#1a4fd6 0%,#1340b0 100%);
  --g-orange:    linear-gradient(135deg,#e8620a 0%,#c94f05 100%);
  --g-hero:      linear-gradient(168deg,#030610 0%,#07102a 50%,#0b1535 100%);
  --g-dark:      linear-gradient(145deg,#080c18 0%,#0e1828 100%);
  --g-surface:   linear-gradient(145deg,#ffffff 0%,#f8faff 100%);

  --r-xs:        6px;
  --r-sm:        10px;
  --r-md:        14px;
  --r-lg:        18px;
  --r-xl:        24px;
  --r-2xl:       32px;
  --r-pill:      999px;

  --nav-h:       68px;
  --ease:        cubic-bezier(.4,0,.2,1);
  --spring:      cubic-bezier(.34,1.56,.64,1);
  --t:           .26s var(--ease);

  --sh-sm:       0 1px 4px rgba(8,12,24,.06), 0 4px 12px rgba(8,12,24,.06);
  --sh-md:       0 4px 16px rgba(8,12,24,.08), 0 12px 36px rgba(8,12,24,.08);
  --sh-lg:       0 12px 40px rgba(8,12,24,.12), 0 4px 12px rgba(8,12,24,.06);
  --sh-blue:     0 8px 28px rgba(26,79,214,.28);
  --sh-orange:   0 8px 28px rgba(232,98,10,.26);
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--ghost);color:var(--ink);overflow-x:hidden;font-size:16px;line-height:1.65}
h1,h2,h3,h4,h5{font-family:'Fraunces',serif;line-height:1.1;letter-spacing:-.02em}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
button{font-family:'Plus Jakarta Sans',sans-serif}

::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--ink)}
::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}

/* SCROLL PROGRESS */
#scroll-progress{position:fixed;top:0;left:0;height:2px;width:0%;background:linear-gradient(90deg,var(--blue),var(--orange));z-index:9999;transition:width .08s linear}

/* ─── NAVBAR ─── */
.navbar{position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);background:rgba(255,255,255,.95);backdrop-filter:blur(24px) saturate(2);border-bottom:1px solid rgba(8,12,24,.06);transition:var(--t)}
.navbar.scrolled{background:rgba(255,255,255,.98);box-shadow:0 2px 24px rgba(8,12,24,.07)}
.nav-inner{max-width:1320px;margin:0 auto;padding:0 24px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}
.nav-brand{font-family:'Fraunces',serif;font-size:1.22rem;font-weight:700;color:var(--ink);flex-shrink:0;letter-spacing:-.04em;display:flex;align-items:center;gap:7px}
.brand-mark{width:30px;height:30px;background:var(--g-blue);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;position:relative;overflow:hidden}
.brand-mark::after{content:'N';font-family:'Fraunces',serif;font-weight:700;font-size:.85rem;color:#fff;line-height:1}
.nav-brand em{font-style:italic;color:var(--orange)}
.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-item{position:relative}
.nl-a{font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 12px;border-radius:var(--r-sm);transition:var(--t);white-space:nowrap;display:flex;align-items:center;gap:5px;font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:.01em}
.nl-a:hover,.nl-a.active{color:var(--blue);background:var(--blue-pale)}
.nl-a .chev{font-size:.52rem;transition:transform .22s}
.nl-item:hover .chev{transform:rotate(180deg)}

/* Mega dropdown */
.mega-drop{position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%) translateY(10px);min-width:560px;background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);box-shadow:0 24px 64px rgba(8,12,24,.14);padding:24px;opacity:0;visibility:hidden;pointer-events:none;transition:all .22s var(--ease)}
.nl-item:hover .mega-drop{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
.mega-drop::before{content:'';position:absolute;top:-5px;left:50%;width:10px;height:10px;background:#fff;border-left:1px solid var(--mist);border-top:1px solid var(--mist);transform:translateX(-50%) rotate(45deg)}
.mega-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0}
.mega-col-label{font-size:.62rem;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--blue);padding:0 8px 10px;display:block;font-family:'Plus Jakarta Sans',sans-serif}
.mega-link{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:var(--r-sm);font-size:.8rem;font-weight:500;color:var(--slate);transition:all .15s}
.mega-link i{width:16px;color:var(--blue);font-size:.76rem;flex-shrink:0;opacity:.8}
.mega-link:hover{background:var(--blue-pale);color:var(--blue);transform:translateX(2px)}
.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}

/* HAMBURGER */
.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:44px;height:44px;background:none;border:none;cursor:pointer;border-radius:var(--r-sm);transition:var(--t);flex-shrink:0;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
.ham-btn:hover{background:var(--blue-pale)}
.ham-line{display:block;width:20px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .26s var(--ease);transform-origin:center;pointer-events:none}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:38px;height:38px;border-radius:var(--r-sm);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:var(--t);-webkit-tap-highlight-color:transparent;touch-action:manipulation;background:var(--blue-pale);color:var(--blue)}
.mob-quick-wa{width:38px;height:38px;border-radius:var(--r-sm);background:rgba(37,211,102,.1);color:#25D366;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:var(--t);-webkit-tap-highlight-color:transparent}

/* Mobile overlay + panel */
.mob-overlay{position:fixed;inset:0;background:rgba(8,12,24,.6);backdrop-filter:blur(8px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(360px,90vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;overflow-x:hidden;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-16px 0 60px rgba(8,12,24,.2);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.82rem;flex-shrink:0;-webkit-tap-highlight-color:transparent}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:12px;padding:12px 22px;font-size:.88rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px;-webkit-tap-highlight-color:transparent}
.mob-link i{width:18px;color:var(--blue);font-size:.8rem;flex-shrink:0}
.mob-link:hover{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-sub-toggle{display:flex;align-items:center;justify-content:space-between;padding:12px 22px;font-size:.88rem;font-weight:600;color:var(--ink);cursor:pointer;transition:var(--t);min-height:48px;-webkit-tap-highlight-color:transparent}
.mob-sub-toggle .left{display:flex;align-items:center;gap:12px}
.mob-sub-toggle .left i{width:18px;color:var(--blue);font-size:.8rem}
.mob-sub-toggle:hover{background:var(--blue-pale);color:var(--blue)}
.mob-sub-toggle .chev-i{font-size:.6rem;color:var(--slate);transition:transform .26s;flex-shrink:0}
.mob-sub-toggle.open .chev-i{transform:rotate(180deg)}
.mob-sub{background:rgba(26,79,214,.03);border-top:1px solid var(--blue-pale);border-bottom:1px solid var(--blue-pale);max-height:0;overflow:hidden;transition:max-height .32s ease}
.mob-sub.open{max-height:700px}
.mob-sub a{display:flex;align-items:center;gap:8px;padding:10px 22px 10px 52px;font-size:.8rem;color:var(--slate);transition:var(--t);min-height:42px;-webkit-tap-highlight-color:transparent}
.mob-sub a i{width:15px;color:var(--blue);font-size:.72rem;flex-shrink:0}
.mob-sub a:hover{color:var(--blue);background:rgba(26,79,214,.05);padding-left:58px}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 18px}
.mob-footer{padding:14px 18px 32px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:9px}

/* ─── BUTTONS ─── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.86rem;border-radius:var(--r-pill);transition:var(--t);cursor:pointer;white-space:nowrap;text-align:center;-webkit-tap-highlight-color:transparent;touch-action:manipulation;border:none;letter-spacing:.01em}
.btn-primary{background:var(--g-blue);color:#fff;padding:12px 26px;box-shadow:var(--sh-blue)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(26,79,214,.38)}
.btn-orange{background:var(--g-orange);color:#fff;padding:12px 26px;box-shadow:var(--sh-orange)}
.btn-orange:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(232,98,10,.38)}
.btn-outline{background:transparent;color:var(--blue);padding:10px 22px;border:1.5px solid var(--blue)}
.btn-outline:hover{background:var(--g-blue);color:#fff;transform:translateY(-2px);box-shadow:var(--sh-blue)}
.btn-ghost{background:rgba(255,255,255,.1);color:#fff;padding:11px 22px;border:1.5px solid rgba(255,255,255,.25);backdrop-filter:blur(8px)}
.btn-ghost:hover{background:rgba(255,255,255,.18);border-color:rgba(255,255,255,.5);transform:translateY(-2px)}
.btn-wa{background:linear-gradient(135deg,#128C7E,#075E54);color:#fff;padding:12px 24px;box-shadow:0 6px 18px rgba(18,140,126,.32)}
.btn-wa:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(18,140,126,.46)}
.btn-nav-signin{font-size:.79rem;font-weight:600;color:var(--slate);padding:7px 16px;border:1.5px solid var(--mist);border-radius:var(--r-pill);background:#fff;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif}
.btn-nav-signin:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-orange{font-size:.79rem;font-weight:700;color:var(--orange);padding:7px 16px;border:1.5px solid rgba(232,98,10,.3);border-radius:var(--r-pill);background:var(--orange-pale);cursor:pointer;display:inline-flex;align-items:center;gap:5px;font-family:'Plus Jakarta Sans',sans-serif}
.btn-nav-orange:hover{background:var(--g-orange);color:#fff;border-color:transparent;box-shadow:var(--sh-orange)}
.btn-nav-start{font-size:.79rem;font-weight:700;color:#fff;padding:8px 20px;border:none;border-radius:var(--r-pill);background:var(--g-blue);cursor:pointer;box-shadow:var(--sh-blue);display:inline-flex;align-items:center;gap:5px;font-family:'Plus Jakarta Sans',sans-serif}
.btn-nav-start:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(26,79,214,.38)}
.btn-sm{padding:8px 18px;font-size:.79rem}
.btn-lg{padding:14px 32px;font-size:.95rem}

/* ─── DARK MODE ─── */
body.dark{background:var(--black);color:rgba(255,255,255,.85)}
body.dark .navbar{background:rgba(8,12,24,.97);border-bottom-color:rgba(255,255,255,.05)}
body.dark .navbar.scrolled{background:rgba(8,12,24,.99)}
body.dark .nl-a{color:rgba(255,255,255,.55)}
body.dark .nl-a:hover,.body.dark .nl-a.active{color:var(--blue-l);background:rgba(26,79,214,.1)}
body.dark .mega-drop{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-drop::before{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-link{color:rgba(255,255,255,.55)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:var(--ink-2)}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link{color:rgba(255,255,255,.82)}
body.dark .mob-close{background:rgba(255,255,255,.07);color:rgba(255,255,255,.7)}
body.dark .mob-sub a{color:rgba(255,255,255,.5)}
body.dark .mob-hr{border-color:rgba(255,255,255,.07)}
body.dark .mob-footer{border-color:rgba(255,255,255,.07)}
body.dark .card{background:var(--ink-2)!important;border-color:rgba(255,255,255,.07)!important}
body.dark .bg-surface{background:var(--ink-2)!important}
body.dark .bg-page{background:var(--ink)!important}
body.dark .text-muted{color:rgba(255,255,255,.42)!important}
body.dark .tech-pill{background:var(--ink-2);border-color:rgba(255,255,255,.09);color:rgba(255,255,255,.75)}
body.dark .faq-item{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .faq-q{color:rgba(255,255,255,.85)}
body.dark .trust-strip{background:var(--ink-2);border-color:rgba(255,255,255,.06)}
body.dark .btn-nav-signin{color:rgba(255,255,255,.55);border-color:rgba(255,255,255,.1);background:transparent}
body.dark #theme-toggle{background:var(--ink-2);border-color:rgba(255,255,255,.09)}
body.dark #theme-toggle svg{stroke:rgba(255,255,255,.75)}

/* ─── UTILITIES ─── */
.container{max-width:1320px;margin:0 auto;padding:0 20px}
.section-py{padding:88px 0}
.section-py-sm{padding:60px 0}
.text-center{text-align:center}
.text-muted{color:var(--slate)}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-orange{background:var(--g-orange);-webkit-background-clip:text;background-clip:text;color:transparent}
.section-kicker{display:inline-flex;align-items:center;gap:7px;border-radius:var(--r-pill);padding:5px 14px;font-size:.67rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;margin-bottom:14px;border:1px solid rgba(26,79,214,.15);background:var(--blue-pale);color:var(--blue);font-family:'Plus Jakarta Sans',sans-serif}
.section-kicker::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue);flex-shrink:0}
.section-kicker.orange{background:var(--orange-pale);color:var(--orange);border-color:rgba(232,98,10,.15)}
.section-kicker.orange::before{background:var(--orange)}
.section-kicker.teal{background:rgba(13,148,136,.08);color:var(--teal);border-color:rgba(13,148,136,.15)}
.section-kicker.teal::before{background:var(--teal)}
.section-title{font-size:clamp(1.75rem,5vw,3.2rem);font-weight:700;margin-bottom:16px;line-height:1.08}
.section-body{color:var(--slate);font-size:clamp(.9rem,2.5vw,1.05rem);line-height:1.78;max-width:560px}

/* ─── ANIMATIONS ─── */
@keyframes float-a{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.45)}}
@keyframes wa-ripple{0%{transform:scale(1);opacity:.65}100%{transform:scale(2);opacity:0}}
@keyframes bounce-up{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-8px)}}
@keyframes bar-shift{0%{background-position:0%}100%{background-position:200%}}
@keyframes badge-pop{0%{transform:scale(0)}100%{transform:scale(1)}}
@keyframes dot-pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.45);opacity:.5}}

/* ─── FIXED WIDGETS ─── */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:44px;height:44px;background:#fff;border:1.5px solid rgba(8,12,24,.08);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 20px rgba(8,12,24,.1);transition:var(--t);touch-action:manipulation;-webkit-tap-highlight-color:transparent}
#theme-toggle svg{width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;display:block;transition:stroke .2s}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(22deg) scale(1.08);box-shadow:0 8px 28px rgba(26,79,214,.34)}
#theme-toggle:hover svg{stroke:#fff}

#back-to-top{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);z-index:10000;width:50px;height:50px;background:var(--g-blue);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .35s,transform .45s var(--spring);box-shadow:var(--sh-blue);touch-action:manipulation}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto;animation:bounce-up 2.4s ease-in-out infinite}
#back-to-top:hover{animation-play-state:paused}
#back-to-top svg{width:18px;height:18px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round}

/* WhatsApp float */
#wa-float{position:fixed;bottom:88px;right:20px;z-index:10001;cursor:pointer;text-decoration:none;display:block}
.wa-ring-1,.wa-ring-2{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-ripple 2.8s ease-out infinite;pointer-events:none}
.wa-ring-2{animation-delay:1.2s}
.wa-pill{display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:9px 18px 9px 9px;box-shadow:0 6px 28px rgba(18,140,126,.44),0 2px 8px rgba(0,0,0,.12);transition:transform .32s var(--spring),box-shadow .3s;white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-4px) scale(1.03);box-shadow:0 16px 40px rgba(18,140,126,.56)}
.wa-icon-circle{width:38px;height:38px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;position:relative;transition:transform .28s}
#wa-float:hover .wa-icon-circle{transform:rotate(-10deg) scale(1.08)}
.wa-status-dot{position:absolute;top:1px;right:1px;width:10px;height:10px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite}
.wa-text-wrap{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.65rem;color:rgba(255,255,255,.6);font-weight:600}
.wa-cta{font-size:.9rem;color:#fff;font-weight:800;font-family:'Fraunces',serif}
.wa-arrow-icon{color:rgba(255,255,255,.65);font-size:.7rem;margin-left:2px;transition:transform .22s}
#wa-float:hover .wa-arrow-icon{transform:translateX(3px)}
.wa-badge{position:absolute;top:-5px;right:-5px;width:19px;height:19px;background:#ef4444;border:2px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.58rem;color:#fff;font-weight:800;animation:badge-pop .55s var(--spring) both}

#wa-tooltip{position:fixed;bottom:156px;right:22px;z-index:10002;background:#fff;color:#111;border-radius:14px 14px 4px 14px;padding:11px 32px 11px 14px;box-shadow:0 8px 32px rgba(0,0,0,.16);font-size:.78rem;font-weight:600;font-family:'Plus Jakarta Sans',sans-serif;max-width:215px;line-height:1.5;opacity:0;pointer-events:none;transform:translateY(8px) scale(.94);transition:opacity .28s,transform .3s var(--spring);border:1px solid rgba(37,211,102,.18)}
#wa-tooltip.show{opacity:1;pointer-events:auto;transform:translateY(0) scale(1)}
#wa-tooltip strong{color:#128C7E;display:block;margin-bottom:3px;font-size:.8rem}
#wa-tooltip .tt-close{position:absolute;top:8px;right:9px;font-size:.62rem;color:#999;cursor:pointer;background:none;border:none;line-height:1;padding:2px;transition:color .2s}
#wa-tooltip .tt-close:hover{color:#ef4444}
#wa-tooltip::after{content:'';position:absolute;bottom:-8px;right:18px;width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:8px solid #fff;filter:drop-shadow(0 2px 4px rgba(0,0,0,.08))}

@media(max-width:767px){
  #wa-float{bottom:76px;right:14px}
  .wa-text-wrap,.wa-arrow-icon{display:none}
  .wa-pill{padding:0;width:54px;height:54px;border-radius:50%;justify-content:center}
  .wa-icon-circle{width:54px;height:54px;font-size:1.45rem}
  #wa-tooltip{bottom:140px;right:10px;max-width:185px}
  #theme-toggle{bottom:14px;left:14px;width:40px;height:40px}
  #back-to-top{bottom:14px;width:46px;height:46px}
}

/* Toast */
#toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-md);padding:12px 18px;font-size:.83rem;display:flex;align-items:center;gap:9px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:220px;max-width:calc(100vw - 44px);white-space:nowrap}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* Cookie */
#cookie-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.82);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;z-index:9998;transform:translateY(100%);transition:transform .4s;border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap}
#cookie-bar.show{transform:translateY(0)}
#cookie-bar p{font-size:.78rem;margin:0;flex:1;min-width:200px}
#cookie-accept{background:var(--blue);color:#fff;border:none;padding:8px 20px;border-radius:var(--r-pill);font-size:.8rem;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;transition:var(--t);flex-shrink:0}
#cookie-accept:hover{background:var(--blue-d)}

/* Scroll indicator */
#scroll-ind{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;z-index:100;opacity:1;transition:opacity .5s}
#scroll-ind.hidden{opacity:0;pointer-events:none}
.si-pill{width:20px;height:34px;border:1.5px solid rgba(255,255,255,.28);border-radius:10px;display:flex;align-items:flex-start;justify-content:center;padding-top:5px}
.si-dot{width:2.5px;height:7px;background:#fff;border-radius:2px;animation:float-a 1.8s ease-in-out infinite}
.si-label{font-size:7px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,.38);font-family:'Plus Jakarta Sans',sans-serif}

/* ─── HERO ─── */
.hero{min-height:100svh;padding-top:var(--nav-h);background:var(--g-hero);position:relative;overflow:hidden;display:flex;align-items:center}
.hero-mesh{position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(26,79,214,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(26,79,214,.04) 1px,transparent 1px);background-size:44px 44px}
.hero-orb-1{position:absolute;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(26,79,214,.18) 0%,transparent 68%);top:-200px;right:-100px;pointer-events:none}
.hero-orb-2{position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(232,98,10,.12) 0%,transparent 70%);bottom:-60px;left:0;pointer-events:none}
.hero-orb-3{position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(13,148,136,.06) 0%,transparent 70%);top:50%;left:44%;transform:translate(-50%,-50%);pointer-events:none}
.hero-inner{position:relative;z-index:1;display:flex;flex-direction:column;gap:36px;padding:60px 0 100px;width:100%}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-pill);padding:6px 16px;color:rgba(255,255,255,.75);font-size:.73rem;font-weight:700;margin-bottom:18px;backdrop-filter:blur(8px);letter-spacing:.3px;align-self:flex-start;font-family:'Plus Jakarta Sans',sans-serif}
.hero-badge .dot{width:6px;height:6px;border-radius:50%;background:#34d399;animation:pulse-dot 2s infinite;flex-shrink:0}
.hero h1{font-size:clamp(2.1rem,8vw,5rem);font-weight:700;color:#fff;line-height:1.04;margin-bottom:20px}
.hero h1 em{font-style:italic;background:linear-gradient(135deg,var(--orange-l) 0%,var(--orange) 50%,var(--orange-d) 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-sub{color:rgba(255,255,255,.55);font-size:clamp(.9rem,3vw,1.08rem);line-height:1.82;margin-bottom:30px;max-width:480px}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap}
.hero-actions .btn{flex:1;min-width:140px;max-width:240px}
.hero-trust{display:flex;gap:20px;flex-wrap:wrap;margin-top:24px;padding-top:24px;border-top:1px solid rgba(255,255,255,.08)}
.hero-trust-item{display:flex;align-items:center;gap:7px;font-size:.76rem;color:rgba(255,255,255,.5);font-weight:600;font-family:'Plus Jakarta Sans',sans-serif}
.hero-trust-item i{color:#34d399;font-size:.76rem}
.code-box{background:rgba(5,8,16,.88);border:1px solid rgba(26,79,214,.24);border-radius:var(--r-xl);padding:26px 30px;font-family:'JetBrains Mono',monospace;font-size:.76rem;line-height:1.92;position:relative;backdrop-filter:blur(16px);animation:float-a 6s ease-in-out infinite}
.code-box::before{content:'';position:absolute;top:0;left:0;right:0;height:1.5px;background:linear-gradient(90deg,transparent,var(--blue),var(--orange),transparent);border-radius:var(--r-xl) var(--r-xl) 0 0}
.code-dots{display:flex;gap:6px;margin-bottom:18px}
.code-dots span{width:9px;height:9px;border-radius:50%}
.code-dots span:nth-child(1){background:#ef4444}
.code-dots span:nth-child(2){background:var(--orange)}
.code-dots span:nth-child(3){background:#34d399}
.kw{color:#7ea8f8}.fn{color:#4fc4a0}.str{color:#f5a060}.cm{color:#2e4060}
.cursor{display:inline-block;width:2px;height:.9em;background:var(--blue-l);animation:blink 1s step-end infinite;vertical-align:text-bottom;margin-left:1px}
.hero-chips{display:flex;gap:9px;margin-top:16px;flex-wrap:wrap}
.chip{padding:6px 14px;border-radius:var(--r-pill);font-size:.72rem;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif}
.chip-blue{background:rgba(26,79,214,.15);border:1px solid rgba(26,79,214,.26);color:#7ea8f8}
.chip-orange{background:rgba(232,98,10,.14);border:1px solid rgba(232,98,10,.26);color:var(--orange-l)}

/* ─── LEARN BANNER ─── */
.learn-banner{background:linear-gradient(135deg,#003d37,#004e44,#006655);padding:22px 0;position:relative;overflow:hidden}
.learn-banner::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(13,148,136,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(13,148,136,.05) 1px,transparent 1px);background-size:38px 38px}
.learn-banner-inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.learn-banner-icon{width:44px;height:44px;background:rgba(13,148,136,.2);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;color:var(--teal);font-size:1.18rem;border:1px solid rgba(13,148,136,.25);flex-shrink:0}
.learn-banner-text{display:flex;align-items:center;gap:14px;flex:1;min-width:0}
.learn-banner-content h4{font-size:.9rem;font-weight:700;color:#fff;margin-bottom:2px;font-family:'Plus Jakarta Sans',sans-serif}
.learn-banner-content p{font-size:.75rem;color:rgba(255,255,255,.5);margin:0;font-family:'Plus Jakarta Sans',sans-serif}
.learn-banner-badges{display:flex;gap:7px;flex-wrap:wrap}
.learn-badge{padding:4px 11px;border-radius:var(--r-pill);font-size:.66rem;font-weight:700;background:rgba(255,255,255,.08);color:rgba(255,255,255,.65);border:1px solid rgba(255,255,255,.1)}

/* ─── MARQUEE ─── */
.marquee-wrap{background:var(--blue);padding:12px 0;overflow:hidden;white-space:nowrap}
.marquee-track{display:inline-flex;animation:marquee 32s linear infinite}
.marquee-track:hover{animation-play-state:paused}
.marquee-item{display:inline-flex;align-items:center;gap:7px;padding:0 26px;color:rgba(255,255,255,.88);font-size:.82rem;font-weight:600;font-family:'Plus Jakarta Sans',sans-serif}
.marquee-sep{opacity:.28}

/* ─── TRUST STRIP ─── */
.trust-strip{background:#fff;border-top:1px solid var(--mist);border-bottom:1px solid var(--mist);padding:20px 0;overflow-x:auto}
.trust-inner{display:flex;flex-wrap:wrap;justify-content:center;gap:20px 32px}
.trust-item{display:flex;align-items:center;gap:8px;font-size:.78rem;font-weight:700;color:var(--ink);white-space:nowrap;font-family:'Plus Jakarta Sans',sans-serif}

/* ─── SERVICES ─── */
.services-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);transition:var(--t);overflow:hidden;box-shadow:var(--sh-sm)}
.service-card{display:block;text-decoration:none;color:inherit;position:relative;cursor:pointer}
.service-card:hover{transform:translateY(-5px);box-shadow:var(--sh-lg);border-color:rgba(26,79,214,.16)}
.service-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--orange));transform:scaleX(0);transform-origin:left;transition:transform .36s;z-index:3}
.service-card:hover::before{transform:scaleX(1)}
.svc-img-wrap{height:136px;overflow:hidden;position:relative}
.svc-img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.service-card:hover .svc-img{transform:scale(1.07)}
.svc-overlay{position:absolute;inset:0;background:rgba(255,255,255,.97);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;opacity:0;transition:opacity .26s;z-index:2;text-align:center;padding:16px;backdrop-filter:blur(8px)}
.service-card:hover .svc-overlay{opacity:1}
.svc-ov-icon{width:44px;height:44px;background:var(--g-blue);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.05rem;transform:scale(.85);transition:transform .3s var(--spring) .04s}
.service-card:hover .svc-ov-icon{transform:scale(1)}
.svc-ov-title{font-family:'Fraunces',serif;font-weight:600;font-size:.88rem;color:var(--blue)}
.svc-ov-sub{font-size:.7rem;color:var(--slate)}
.svc-ov-btn{display:inline-flex;align-items:center;gap:5px;background:var(--g-blue);color:#fff;padding:6px 14px;border-radius:var(--r-pill);font-size:.71rem;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif}
.svc-icon-wrap{position:relative;z-index:2;margin:-22px 0 11px 18px;width:44px;height:44px;background:#fff;border-radius:12px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(8,12,24,.1);border:1px solid var(--mist)}
.svc-body{padding:0 18px 18px}
.svc-body h3{font-size:.96rem;font-weight:600;margin-bottom:5px;font-family:'Fraunces',serif}
.svc-body p{font-size:.79rem;color:var(--slate);line-height:1.6;margin-bottom:11px}
.svc-pill{display:inline-flex;align-items:center;gap:4px;font-size:.66rem;font-weight:800;color:var(--blue);background:var(--blue-pale);padding:4px 10px;border-radius:var(--r-pill);transition:var(--t);font-family:'Plus Jakarta Sans',sans-serif;text-transform:uppercase;letter-spacing:.5px}
.service-card:hover .svc-pill{background:var(--blue);color:#fff}

/* ─── STATS ─── */
.stats-section{padding:56px 0}
.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.stat-card{background:#fff;border-radius:var(--r-xl);padding:28px 22px;text-align:center;border:1px solid var(--mist);transition:var(--t);position:relative;overflow:hidden;box-shadow:var(--sh-sm)}
.stat-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--g-blue);transform:scaleX(0);transform-origin:left;transition:transform .32s}
.stat-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.stat-card:hover::after{transform:scaleX(1)}
.stat-num{font-family:'Fraunces',serif;font-size:clamp(1.9rem,6vw,3.1rem);font-weight:700;line-height:1}
.stat-label{font-size:.78rem;color:var(--slate);margin-top:6px;font-weight:500;font-family:'Plus Jakarta Sans',sans-serif}

/* ─── PROCESS ─── */
.process-grid{display:grid;grid-template-columns:1fr;gap:16px}
.process-card{background:#fff;border-radius:var(--r-xl);padding:30px 26px;border:1px solid var(--mist);transition:var(--t);position:relative;overflow:hidden;box-shadow:var(--sh-sm)}
.process-card::before{content:'';position:absolute;top:0;left:0;bottom:0;width:3px;background:var(--g-blue);opacity:0;transition:opacity .28s}
.process-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.process-card:hover::before{opacity:1}
.process-num{font-family:'Fraunces',serif;font-size:2.8rem;font-weight:700;background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1;margin-bottom:14px;opacity:.55}
.process-card h4{font-size:1.02rem;font-weight:700;margin-bottom:8px;font-family:'Fraunces',serif}
.process-card p{font-size:.81rem;color:var(--slate);line-height:1.68}
.process-arrow{display:none}

/* ─── LEARN SECTION ─── */
.learn-section{background:linear-gradient(168deg,#003d37,#004e44,#005a50);position:relative;overflow:hidden}
.learn-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 72% 50%,rgba(13,148,136,.18) 0%,transparent 55%),radial-gradient(ellipse at 20% 85%,rgba(232,98,10,.07) 0%,transparent 50%)}
.learn-section::after{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(13,148,136,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(13,148,136,.04) 1px,transparent 1px);background-size:44px 44px}
.learn-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr;gap:44px}
.learn-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.learn-card{background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.09);border-radius:var(--r-lg);padding:18px 15px;transition:var(--t)}
.learn-card:hover{background:rgba(255,255,255,.1);border-color:rgba(13,148,136,.3);transform:translateY(-3px)}
.learn-card-icon{font-size:1.6rem;margin-bottom:8px;display:block}
.learn-card h5{font-size:.86rem;font-weight:700;color:#fff;margin-bottom:4px;font-family:'Fraunces',serif}
.learn-card p{font-size:.73rem;color:rgba(255,255,255,.48);margin:0;line-height:1.55}
.learn-pill{display:inline-flex;align-items:center;gap:4px;background:rgba(13,148,136,.15);color:#5eead4;border-radius:var(--r-pill);padding:3px 10px;font-size:.64rem;font-weight:700;margin-top:8px;font-family:'Plus Jakarta Sans',sans-serif}
.learn-meta{display:flex;gap:16px;flex-wrap:wrap;margin-top:14px}
.learn-meta-item{display:flex;align-items:center;gap:6px;font-size:.74rem;color:rgba(255,255,255,.48);font-weight:600;font-family:'Plus Jakarta Sans',sans-serif}
.learn-meta-item i{color:#5eead4;font-size:.72rem}

/* ─── GRAPHIC DESIGN ─── */
.graphic-section{background:var(--g-dark);position:relative;overflow:hidden}
.graphic-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 28% 52%,rgba(26,79,214,.09) 0%,transparent 58%),radial-gradient(ellipse at 82% 78%,rgba(232,98,10,.07) 0%,transparent 50%)}
.graphic-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;position:relative;z-index:1}
.graphic-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-xl);padding:22px 16px;text-align:center;color:#fff;transition:var(--t);cursor:pointer}
.graphic-card:hover{background:rgba(255,255,255,.08);border-color:rgba(232,98,10,.28);transform:translateY(-4px)}
.graphic-icon{font-size:1.8rem;margin-bottom:10px;display:block}
.graphic-card h4{font-size:.9rem;font-weight:700;margin-bottom:4px;font-family:'Fraunces',serif}
.graphic-card p{font-size:.72rem;color:rgba(255,255,255,.48);margin-bottom:10px;font-family:'Plus Jakarta Sans',sans-serif}
.graphic-price{display:inline-block;background:rgba(232,98,10,.16);color:var(--orange-l);border-radius:var(--r-pill);padding:3px 12px;font-size:.65rem;font-weight:800;font-family:'Plus Jakarta Sans',sans-serif}

/* ─── TECH STACK ─── */
.tech-wrap{display:flex;flex-wrap:wrap;gap:9px;justify-content:center}
.tech-pill{display:inline-flex;align-items:center;gap:7px;background:#fff;border:1px solid var(--mist);border-radius:var(--r-sm);padding:8px 14px;font-size:.79rem;font-weight:600;color:var(--ink);transition:var(--t);white-space:nowrap;font-family:'Plus Jakarta Sans',sans-serif;box-shadow:var(--sh-sm)}
.tech-pill:hover{border-color:var(--blue);color:var(--blue);transform:translateY(-2px);box-shadow:0 6px 18px rgba(26,79,214,.12)}

/* ─── PORTFOLIO ─── */
.portfolio-grid{display:grid;grid-template-columns:1fr;gap:20px}
.portfolio-card{background:#fff;border-radius:var(--r-xl);overflow:hidden;border:1px solid var(--mist);transition:var(--t);box-shadow:var(--sh-sm)}
.portfolio-card:hover{transform:translateY(-5px);box-shadow:var(--sh-lg)}
.port-img-wrap{position:relative;overflow:hidden;height:188px}
.port-img{width:100%;height:100%;object-fit:cover;transition:transform .46s}
.portfolio-card:hover .port-img{transform:scale(1.06)}
.port-overlay{position:absolute;inset:0;background:rgba(26,79,214,.82);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .26s}
.portfolio-card:hover .port-overlay{opacity:1}
.port-overlay i{color:#fff;font-size:1.55rem;transform:scale(.85);transition:transform .26s}
.portfolio-card:hover .port-overlay i{transform:scale(1)}
.port-body{padding:20px}
.port-tag{display:inline-block;font-size:.63rem;font-weight:800;padding:3px 11px;border-radius:var(--r-pill);background:var(--blue-pale);color:var(--blue);text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px;font-family:'Plus Jakarta Sans',sans-serif}
.port-body h4{font-size:1.02rem;font-weight:700;margin-bottom:6px;font-family:'Fraunces',serif}
.port-body .desc{font-size:.8rem;color:var(--slate);line-height:1.62;margin-bottom:10px}
.port-techs{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px}
.tech-sm{background:var(--blue-pale);color:var(--blue);padding:3px 9px;border-radius:var(--r-pill);font-size:.66rem;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif}
.port-filter-row{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:28px;overflow-x:auto;padding-bottom:4px}
.pf-btn{padding:7px 18px;border-radius:var(--r-pill);font-size:.77rem;font-weight:700;cursor:pointer;border:1.5px solid var(--blue);color:var(--blue);background:transparent;font-family:'Plus Jakarta Sans',sans-serif;transition:var(--t);white-space:nowrap;touch-action:manipulation}
.pf-btn.active,.pf-btn:hover{background:var(--g-blue);color:#fff;border-color:transparent}

/* ─── TEAM ─── */
.team-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.team-card{background:#fff;border-radius:var(--r-xl);padding:28px 18px;text-align:center;border:1px solid var(--mist);transition:var(--t);box-shadow:var(--sh-sm)}
.team-card:hover{transform:translateY(-5px);box-shadow:var(--sh-lg)}
.team-avatar{width:82px;height:82px;border-radius:50%;overflow:hidden;margin:0 auto 14px;background:var(--mist);position:relative;box-shadow:0 0 0 3px var(--mist)}
.team-card:hover .team-avatar{box-shadow:0 0 0 3px var(--blue)}
.team-avatar img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
.team-card:hover .team-avatar img{transform:scale(1.06)}
.team-avatar-fb{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:2.4rem;color:var(--blue)}
.team-card h5{font-size:.96rem;font-weight:700;margin-bottom:3px;font-family:'Fraunces',serif}
.team-role{font-size:.71rem;color:var(--orange);margin-bottom:9px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;text-transform:uppercase;letter-spacing:.6px}
.team-bio{font-size:.77rem;color:var(--slate);line-height:1.6;margin-bottom:12px}
.team-socials{display:flex;justify-content:center;gap:7px}
.team-socials a{width:30px;height:30px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:var(--blue-pale);color:var(--blue);font-size:.78rem;transition:var(--t);touch-action:manipulation}
.team-socials a:hover{background:var(--blue);color:#fff;transform:translateY(-2px)}

/* ─── PRICING ─── */
.pricing-grid{display:grid;grid-template-columns:1fr;gap:16px}
.pricing-card{background:#fff;border-radius:var(--r-xl);padding:28px 22px;border:1px solid var(--mist);transition:var(--t);position:relative;display:flex;flex-direction:column;box-shadow:var(--sh-sm)}
.pricing-card:not(.featured):hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.pricing-card.featured{background:var(--ink);color:#fff;border:none;box-shadow:0 20px 56px rgba(8,12,24,.28)}
.badge-hot{position:absolute;top:14px;right:14px;background:var(--orange);color:#fff;font-size:.62rem;font-weight:800;padding:3px 10px;border-radius:var(--r-pill);letter-spacing:.5px;text-transform:uppercase;font-family:'Plus Jakarta Sans',sans-serif}
.price-tier{font-size:.75rem;color:var(--slate);margin-bottom:6px;font-weight:500;font-family:'Plus Jakarta Sans',sans-serif}
.pricing-card.featured .price-tier{color:rgba(255,255,255,.45)}
.price-val{font-family:'Fraunces',serif;font-size:clamp(1.35rem,4vw,2rem);font-weight:700;margin-bottom:18px}
.price-list{list-style:none;flex-grow:1}
.price-list li{padding:7px 0;border-bottom:1px solid rgba(8,12,24,.05);display:flex;align-items:center;gap:8px;font-size:.8rem;font-family:'Plus Jakarta Sans',sans-serif}
.pricing-card.featured .price-list li{border-bottom-color:rgba(255,255,255,.07)}
.price-list li .ok{color:var(--emerald)}
.price-list li .no{color:var(--slate);opacity:.45}

/* ─── TESTIMONIALS ─── */
.testimonial-grid{display:grid;grid-template-columns:1fr;gap:16px}
.testimonial-card{background:#fff;border-radius:var(--r-xl);padding:26px 22px;border:1px solid var(--mist);transition:var(--t);display:flex;flex-direction:column;box-shadow:var(--sh-sm);position:relative;overflow:hidden}
.testimonial-card::before{content:'"';position:absolute;top:-10px;left:16px;font-family:'Fraunces',serif;font-size:8rem;color:var(--blue-pale);line-height:1;pointer-events:none}
.testimonial-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.t-stars{color:var(--orange);letter-spacing:1px;margin-bottom:12px;font-size:.92rem}
.t-quote{font-style:italic;color:var(--slate);line-height:1.8;font-size:.86rem;flex-grow:1;margin-bottom:18px;position:relative;z-index:1}
.t-author{display:flex;align-items:center;gap:12px}
.t-avatar{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.t-name{font-weight:700;font-size:.84rem;font-family:'Fraunces',serif}
.t-role{font-size:.7rem;color:var(--slate)}

/* ─── BLOG ─── */
.blog-grid{display:grid;grid-template-columns:1fr;gap:20px}
.blog-card{background:#fff;border-radius:var(--r-xl);padding:24px;border:1px solid var(--mist);transition:var(--t);display:flex;flex-direction:column;box-shadow:var(--sh-sm)}
.blog-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.blog-meta{font-size:.7rem;color:var(--slate-l);margin-bottom:8px;font-family:'Plus Jakarta Sans',sans-serif}
.blog-cat{display:inline-block;font-size:.62rem;font-weight:800;padding:3px 10px;border-radius:var(--r-pill);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;font-family:'Plus Jakarta Sans',sans-serif}
.blog-cat.dev{background:var(--blue-pale);color:var(--blue)}
.blog-cat.ai{background:rgba(5,150,105,.08);color:var(--emerald)}
.blog-cat.ui{background:var(--orange-pale);color:var(--orange)}
.blog-card h4{font-size:.97rem;font-weight:700;margin-bottom:8px;line-height:1.42;font-family:'Fraunces',serif}
.blog-card .desc{font-size:.8rem;color:var(--slate);line-height:1.66;flex-grow:1;margin-bottom:14px}

/* ─── FAQ ─── */
.faq-grid{display:grid;grid-template-columns:1fr;gap:10px}
.faq-item{background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);overflow:hidden;transition:border-color .24s;box-shadow:var(--sh-sm)}
.faq-item:hover{border-color:var(--blue)}
.faq-q{padding:16px 20px;font-weight:700;font-size:.86rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'Plus Jakarta Sans',sans-serif;transition:var(--t);min-height:54px;touch-action:manipulation}
.faq-icon{color:var(--blue);font-size:.72rem;transition:transform .26s;flex-shrink:0;margin-left:12px}
.faq-a{padding:0 20px;max-height:0;overflow:hidden;transition:all .3s;color:var(--slate);font-size:.83rem;line-height:1.76}
.faq-item.open .faq-a{max-height:220px;padding:0 20px 16px}
.faq-item.open .faq-icon{transform:rotate(45deg)}
.faq-item.open{border-color:var(--blue-l)}

/* ─── CTA BAND ─── */
.cta-section{background:linear-gradient(135deg,var(--blue) 0%,var(--blue-d) 45%,#0e2d88 100%);position:relative;overflow:hidden}
.cta-section::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:40px 40px}
.cta-section::after{content:'';position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(255,255,255,.06) 0%,transparent 70%);border-radius:50%}
.cta-inner{position:relative;z-index:1;text-align:center}
.cta-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:28px}
.cta-btn-white{background:#fff;color:var(--blue);font-weight:800;border-radius:var(--r-pill);padding:13px 28px;font-size:.9rem;font-family:'Plus Jakarta Sans',sans-serif;display:inline-flex;align-items:center;gap:7px;transition:var(--t);box-shadow:0 6px 22px rgba(0,0,0,.15)}
.cta-btn-white:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(0,0,0,.22)}
.cta-btn-orange{background:var(--g-orange);color:#fff;font-weight:800;border-radius:var(--r-pill);padding:13px 26px;font-size:.9rem;font-family:'Plus Jakarta Sans',sans-serif;display:inline-flex;align-items:center;gap:7px;transition:var(--t);box-shadow:var(--sh-orange)}
.cta-btn-orange:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(232,98,10,.44)}

/* ─── FOOTER ─── */
footer{background:#050810;color:rgba(255,255,255,.5);font-size:.82rem;border-top:1px solid rgba(255,255,255,.05)}
.footer-accent-bar{height:2px;background:linear-gradient(90deg,#1a4fd6,#e8620a,#1a4fd6);background-size:200% 100%;animation:bar-shift 6s linear infinite}
.footer-cta-strip{background:linear-gradient(135deg,#0c1630,#101f40);border-bottom:1px solid rgba(255,255,255,.05);padding:32px 0}
.footer-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.footer-cta-text h4{font-family:'Fraunces',serif;font-size:clamp(1rem,3vw,1.38rem);font-weight:700;color:#fff;margin-bottom:3px;line-height:1.2}
.footer-cta-text p{font-size:.77rem;color:rgba(255,255,255,.38);margin:0}
.footer-cta-actions{display:flex;gap:10px;flex-wrap:wrap;flex-shrink:0}
.footer-body{padding:56px 0 38px}
.footer-cols{display:grid;grid-template-columns:2fr 1fr 1fr 1.6fr;gap:36px 30px}
.footer-brand-name{font-family:'Fraunces',serif;font-size:1.16rem;font-weight:700;color:#fff;letter-spacing:-.04em;display:flex;align-items:center;gap:8px;margin-bottom:10px}
.footer-brand-name em{font-style:italic;color:#e8620a}
.footer-brand-mark{width:28px;height:28px;background:var(--g-blue);border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:.82rem;color:#fff;flex-shrink:0}
.footer-tagline{font-size:.78rem;color:rgba(255,255,255,.36);line-height:1.76;max-width:280px;margin-bottom:18px}
.footer-socials{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.fsoc{width:34px;height:34px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);color:rgba(255,255,255,.5);font-size:.8rem;transition:all .2s;text-decoration:none}
.fsoc:hover{transform:translateY(-3px)}
.fsoc.tw:hover{background:#1da1f2;color:#fff}
.fsoc.li:hover{background:#0077b5;color:#fff}
.fsoc.gh:hover{background:#fff;color:#111}
.fsoc.ig:hover{background:linear-gradient(135deg,#fd5949,#d6249f,#285aeb);color:#fff}
.fsoc.yt:hover{background:#ff0000;color:#fff}
.fsoc.wa:hover{background:#25D366;color:#fff}
.footer-col-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:.64rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:rgba(255,255,255,.28);margin-bottom:16px;display:flex;align-items:center;gap:7px}
.footer-col-title::before{content:'';display:inline-block;width:11px;height:1.5px;background:var(--blue);border-radius:2px;flex-shrink:0}
.footer-links{list-style:none;padding:0;margin:0}
.footer-links li{margin-bottom:10px}
.footer-links a{color:rgba(255,255,255,.42);text-decoration:none;font-size:.78rem;transition:color .18s,padding-left .18s;display:inline-flex;align-items:center;gap:6px}
.footer-links a:hover{color:#fff;padding-left:3px}
.footer-links a i{width:13px;font-size:.68rem;flex-shrink:0;opacity:.5}
.footer-links a.academy-link{color:#5eead4;font-weight:600}
.footer-contact-item{display:flex;align-items:flex-start;gap:10px;margin-bottom:14px}
.fci-icon{width:30px;height:30px;flex-shrink:0;background:rgba(26,79,214,.12);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--blue-l);font-size:.7rem;margin-top:1px}
.fci-text{display:flex;flex-direction:column;gap:2px}
.fci-label{font-size:.6rem;color:rgba(255,255,255,.24);font-weight:800;letter-spacing:.7px;text-transform:uppercase}
.fci-val{font-size:.78rem;color:rgba(255,255,255,.6)}
.fci-val a{color:rgba(255,255,255,.6);text-decoration:none;transition:color .2s}
.fci-val a:hover{color:var(--orange-l)}
.footer-hours{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:7px;padding:7px 11px;font-size:.71rem;color:rgba(255,255,255,.38);margin-top:4px}
.hours-dot{width:6px;height:6px;background:#34d399;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite;flex-shrink:0}
.footer-divider{border:none;border-top:1px solid rgba(255,255,255,.06)}
.footer-bottom-bar{padding:18px 0}
.footer-bottom-inner{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.footer-copy{font-size:.72rem;color:rgba(255,255,255,.22)}
.footer-legal{display:flex;gap:20px;flex-wrap:wrap}
.footer-legal a{font-size:.71rem;color:rgba(255,255,255,.25);text-decoration:none;transition:color .18s}
.footer-legal a:hover{color:rgba(255,255,255,.6)}
.footer-made-in{font-size:.71rem;color:rgba(255,255,255,.18);display:flex;align-items:center;gap:4px}
.footer-made-in span{color:var(--orange-l)}

/* ─── NEWSLETTER ─── */
.newsletter-section{background:linear-gradient(135deg,#edf1ff,#ecfdf5)}
.newsletter-box{background:#fff;border-radius:var(--r-2xl);padding:36px 28px;border:1px solid var(--mist);box-shadow:var(--sh-md)}
.nl-icon{width:50px;height:50px;background:var(--blue-pale);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:var(--blue);margin-bottom:14px}
.nl-form{position:relative;display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.nl-form-inp{flex:1;min-width:0;padding:13px 16px 13px 44px;border:1.5px solid var(--mist);border-radius:var(--r-pill);font-size:15px;font-family:'Plus Jakarta Sans',sans-serif;transition:var(--t);background:#fff;color:var(--ink);outline:none}
.nl-form-inp:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,79,214,.08)}
.nl-form i{position:absolute;left:16px;color:var(--slate-l);font-size:.86rem;pointer-events:none;top:50%;transform:translateY(-50%)}
.nl-submit{background:var(--g-blue);color:#fff;border:none;padding:12px 22px;border-radius:var(--r-pill);font-weight:700;font-size:.82rem;font-family:'Plus Jakarta Sans',sans-serif;transition:var(--t);cursor:pointer;white-space:nowrap;flex-shrink:0;touch-action:manipulation}
.nl-submit:hover{background:var(--g-orange)}
.nl-submit:disabled{opacity:.6;cursor:not-allowed}
.nl-grid{display:grid;grid-template-columns:1fr;gap:28px}

/* ─── RESPONSIVE ─── */
@media(max-width:539px){
  .footer-cols{grid-template-columns:1fr 1fr;gap:24px 16px}
  .footer-col-brand{grid-column:1 / -1}
  .footer-col-contact{grid-column:1 / -1}
  .footer-cta-inner{flex-direction:column;align-items:flex-start}
  .footer-cta-actions{width:100%}
  .footer-cta-actions a{flex:1;justify-content:center}
  .footer-bottom-inner{flex-direction:column;align-items:center;text-align:center;gap:10px}
  .footer-legal{justify-content:center;gap:12px}
}
@media(max-width:1023px){
  .footer-cols{grid-template-columns:1fr 1fr;gap:28px 24px}
  .footer-col-brand{grid-column:1 / -1}
}

.grid-3-contact{display:grid;grid-template-columns:1fr;gap:12px}
.contact-info-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:var(--r-lg);padding:16px 14px;text-align:center;transition:var(--t)}
