<style>
/* ═══════════════════════════════════════
   DESIGN TOKENS — UDEMY-LEVEL PRO THEME
═══════════════════════════════════════ */
:root {
  /* Brand */
  --primary: #1c2b4a;
  --primary-d: #111d33;
  --primary-l: #2d4270;
  --accent: #e05c2a;
  --accent-d: #c44e21;
  --accent-l: #f07040;
  --accent-pale: rgba(224,92,42,.08);

  /* Blues */
  --blue: #2563eb;
  --blue-d: #1d4ed8;
  --blue-l: #3b82f6;
  --blue-pale: rgba(37,99,235,.07);
  --blue-pale2: rgba(37,99,235,.13);

  /* Neutrals */
  --ink: #0f172a;
  --ink-2: #1e293b;
  --ink-3: #1e2a3b;
  --slate: #64748b;
  --slate-l: #94a3b8;
  --mist: #e2e8f0;
  --ghost: #f8fafc;
  --white: #ffffff;
  --surface: #f1f5f9;

  /* Status */
  --emerald: #059669;
  --teal: #0d9488;
  --gold: #d97706;
  --rose: #e11d48;

  /* Gradients */
  --g-primary: linear-gradient(135deg, #1c2b4a, #2d4270);
  --g-accent: linear-gradient(135deg, #e05c2a, #c44e21);
  --g-blue: linear-gradient(135deg, #2563eb, #1d4ed8);
  --g-hero: linear-gradient(158deg, #060c1a 0%, #0c1628 45%, #111f3a 100%);

  /* Radius */
  --r-xs: 4px; --r-sm: 6px; --r-md: 8px; --r-lg: 12px;
  --r-xl: 16px; --r-2xl: 20px; --r-pill: 999px;

  /* Nav */
  --nav-h: 64px;

  /* Shadows */
  --sh-sm: 0 1px 3px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04);
  --sh-md: 0 4px 16px rgba(15,23,42,.08), 0 2px 6px rgba(15,23,42,.05);
  --sh-lg: 0 12px 40px rgba(15,23,42,.12), 0 4px 12px rgba(15,23,42,.06);
  --sh-xl: 0 20px 60px rgba(15,23,42,.16), 0 8px 20px rgba(15,23,42,.08);
  --sh-blue: 0 4px 18px rgba(37,99,235,.28);
  --sh-accent: 0 4px 18px rgba(224,92,42,.28);

  /* Ease */
  --ease: cubic-bezier(.4, 0, .2, 1);
  --spring: cubic-bezier(.34, 1.56, .64, 1);
  --t: .22s var(--ease);

  /* Fonts */
  --font-display: 'Fraunces', Georgia, serif;
  --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;

  --slide-dur: 7s; --slide-fade: 1.1s;
}

/* ═══════════════════════════════════════
   RESET
═══════════════════════════════════════ */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box }
html { scroll-behavior:smooth; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility }
body { font-family:var(--font-body); background:var(--ghost); color:var(--ink); overflow-x:hidden; font-size:16px; line-height:1.6 }
h1,h2,h3,h4,h5,h6 { font-family:var(--font-display); line-height:1.1; letter-spacing:-.02em }
a { text-decoration:none; color:inherit }
img { max-width:100%; display:block }
::-webkit-scrollbar { width:4px }
::-webkit-scrollbar-track { background:var(--ink) }
::-webkit-scrollbar-thumb { background:var(--blue); border-radius:4px }

/* ═══════════════════════════════════════
   CURSOR
═══════════════════════════════════════ */
@media(pointer:fine) { body { cursor:none } a,button,[role="button"] { cursor:none } }
#cursor-dot { position:fixed;width:7px;height:7px;border-radius:50%;background:var(--accent);pointer-events:none;z-index:99999;transform:translate(-50%,-50%);mix-blend-mode:normal;transition:background .2s,transform .1s }
#cursor-ring { position:fixed;width:34px;height:34px;border-radius:50%;border:1.5px solid rgba(224,92,42,.45);pointer-events:none;z-index:99998;transform:translate(-50%,-50%);transition:width .18s var(--ease),height .18s var(--ease),border-color .18s,transform .07s }
body.cursor-hover #cursor-dot { transform:translate(-50%,-50%) scale(2.2);background:var(--blue) }
body.cursor-hover #cursor-ring { width:52px;height:52px;border-color:rgba(37,99,235,.35) }

/* ═══════════════════════════════════════
   SCROLL PROGRESS
═══════════════════════════════════════ */
#scroll-progress { position:fixed;top:0;left:0;height:2px;width:0%;background:linear-gradient(90deg,var(--accent),var(--blue));z-index:9999;transition:width .06s linear }

/* ═══════════════════════════════════════
   DARK MODE
═══════════════════════════════════════ */
body.dark { background:#0a0f1e; color:rgba(255,255,255,.88) }
body.dark .navbar { background:rgba(10,15,30,.97);border-bottom-color:rgba(255,255,255,.06) }
body.dark .navbar.scrolled { background:rgba(10,15,30,.99);box-shadow:0 1px 16px rgba(0,0,0,.3) }
body.dark .nl-a { color:rgba(255,255,255,.6) }
body.dark .nl-a:hover { color:var(--blue-l);background:rgba(37,99,235,.1) }
body.dark .mega-drop { background:#1a2236;border-color:rgba(255,255,255,.08) }
body.dark .mega-drop::before { background:#1a2236;border-color:rgba(255,255,255,.08) }
body.dark .mega-link { color:rgba(255,255,255,.6) }
body.dark .ham-line { background:rgba(255,255,255,.85) }
body.dark .mob-panel { background:#1a2236 }
body.dark .mob-head { border-color:rgba(255,255,255,.07) }
body.dark .mob-link { color:rgba(255,255,255,.85) }
body.dark .mob-close { background:rgba(255,255,255,.08);color:rgba(255,255,255,.8) }
body.dark .mob-sub a { color:rgba(255,255,255,.55) }
body.dark .mob-hr { border-color:rgba(255,255,255,.08) }
body.dark .mob-footer { border-color:rgba(255,255,255,.08) }
body.dark .card-white { background:#1a2236!important;border-color:rgba(255,255,255,.07)!important }
body.dark .text-muted { color:rgba(255,255,255,.45)!important }
body.dark .bg-ghost { background:#111827!important }
body.dark .bg-white-section { background:#0f1726!important }
body.dark .tech-pill { background:#1a2236;border-color:rgba(255,255,255,.09);color:rgba(255,255,255,.78) }
body.dark .faq-item { background:#1a2236;border-color:rgba(255,255,255,.07) }
body.dark .faq-q { color:rgba(255,255,255,.87) }
body.dark .process-card { background:#1a2236;border-color:rgba(255,255,255,.07) }
body.dark .stat-card { background:#1a2236;border-color:rgba(255,255,255,.07) }
body.dark .testimonial-card { background:#1a2236;border-color:rgba(255,255,255,.08) }
body.dark .pricing-card { background:#1a2236;border-color:rgba(255,255,255,.07) }
body.dark .pricing-card.featured { background:#0f1726 }
body.dark .portfolio-card { background:#1a2236;border-color:rgba(255,255,255,.07) }
body.dark .team-card { background:#1a2236;border-color:rgba(255,255,255,.07) }
body.dark .blog-card { background:#1a2236;border-color:rgba(255,255,255,.07) }
body.dark .service-card { background:#1a2236;border-color:rgba(255,255,255,.07) }
body.dark .trust-strip { background:#1a2236;border-color:rgba(255,255,255,.06) }
body.dark .newsletter-box { background:#1a2236;border-color:rgba(255,255,255,.08) }
body.dark .nl-form-inp { background:#0f1726;border-color:rgba(255,255,255,.09);color:#fff }
body.dark .nl-form-inp::placeholder { color:rgba(255,255,255,.3) }
body.dark .btn-nav-signin { color:rgba(255,255,255,.6);border-color:rgba(255,255,255,.12);background:transparent }
body.dark .newsletter-section { background:linear-gradient(135deg,#1a2236,#0f1726) }
body.dark #theme-toggle { background:#1a2236;border-color:rgba(255,255,255,.1) }
body.dark #theme-toggle svg { stroke:rgba(255,255,255,.8) }
body.dark .why-card { background:#1a2236;border-color:rgba(255,255,255,.07) }
body.dark .why-card h3 { color:rgba(255,255,255,.9) }
body.dark .hcp-card { background:rgba(255,255,255,.04) }
body.dark .section-divider { border-color:rgba(255,255,255,.07) }
body.dark .rating-bar-bg { background:rgba(255,255,255,.08) }
body.dark .learn-card { background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.09) }
body.dark .stat-badge { background:rgba(37,99,235,.18) }
body.dark .feature-check-row { border-bottom-color:rgba(255,255,255,.06) }

/* ═══════════════════════════════════════
   UTILITIES
═══════════════════════════════════════ */
.container { max-width:1280px; margin:0 auto; padding:0 20px }
.section-py { padding:80px 0 } .section-py-sm { padding:52px 0 }
.text-center { text-align:center }
.text-muted { color:var(--slate) }
.g-blue { background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent }
.g-accent { background:var(--g-accent);-webkit-background-clip:text;background-clip:text;color:transparent }

/* Section label — Udemy-style pill */
.section-tag {
  display:inline-flex; align-items:center; gap:6px;
  background:var(--blue-pale); color:var(--blue);
  border-radius:var(--r-pill); padding:4px 14px;
  font-size:.7rem; font-weight:700; letter-spacing:1.8px; text-transform:uppercase;
  margin-bottom:14px; border:1px solid var(--blue-pale2);
  font-family:var(--font-body);
}
.section-tag.orange { background:var(--accent-pale);color:var(--accent);border-color:rgba(224,92,42,.14) }
.section-title { font-size:clamp(1.75rem,4.5vw,2.9rem);font-weight:400;margin-bottom:16px;line-height:1.1 }
.section-sub { color:var(--slate);font-size:clamp(.9rem,2vw,1.05rem);line-height:1.75;max-width:580px }

.mt-12{margin-top:12px}.mt-16{margin-top:16px}.mt-20{margin-top:20px}
.mt-24{margin-top:24px}.mt-32{margin-top:32px}.mt-40{margin-top:40px}
.mb-0{margin-bottom:0}.mb-8{margin-bottom:8px}
.flex{display:flex}.flex-wrap{flex-wrap:wrap}
.gap-8{gap:8px}.gap-12{gap:12px}.gap-16{gap:16px}
.items-center{align-items:center}.justify-center{justify-content:center}
.section-divider { border:none;border-top:1px solid var(--mist);margin:0 }

/* ═══════════════════════════════════════
   ANIMATIONS
═══════════════════════════════════════ */
@keyframes float-a { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
@keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }
@keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.4)} }
@keyframes wa-ring { 0%{inset:-2px;opacity:.7} 100%{inset:-14px;opacity:0} }
@keyframes bounce-up { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(-8px)} }
@keyframes bar-grow { to{width:var(--w)} }
@keyframes ring-draw { from{stroke-dasharray:0 275} to{stroke-dasharray:230 45} }
@keyframes ring-fill { from{stroke-dasharray:0 56.5} to{stroke-dasharray:56.5 0} }
@keyframes slide-ken-burns { 0%{transform:scale(1) translate(0,0)} 100%{transform:scale(1.07) translate(-.8%,-.8%)} }
@keyframes hero-text-in { 0%{opacity:0;transform:translateY(22px)} 100%{opacity:1;transform:none} }
@keyframes badge-pop { 0%{transform:scale(0)} 100%{transform:scale(1)} }
@keyframes dot-pulse { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.45);opacity:.6} }
@keyframes bar-shift { 0%{background-position:0%} 100%{background-position:200%} }
@keyframes tw-blink { 0%,100%{opacity:1} 50%{opacity:0} }
@keyframes live-ping { 0%{transform:scale(1);opacity:.8} 100%{transform:scale(2.4);opacity:0} }
@keyframes text-reveal { to{clip-path:inset(0 0% 0 0)} }

/* ═══════════════════════════════════════
   FIXED WIDGETS
═══════════════════════════════════════ */
#theme-toggle {
  position:fixed;bottom:22px;left:22px;z-index:10000;
  width:42px;height:42px;background:#fff;
  border:1px solid rgba(15,23,42,.1);border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;box-shadow:var(--sh-md);transition:var(--t)
}
#theme-toggle svg { width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;transition:stroke .2s }
#theme-toggle:hover { background:var(--blue);border-color:var(--blue);transform:rotate(18deg) scale(1.06);box-shadow:var(--sh-blue) }
#theme-toggle:hover svg { stroke:#fff }

#back-to-top {
  position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);z-index:10000;
  width:48px;height:48px;background:var(--primary);border:none;border-radius:50%;
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  opacity:0;pointer-events:none;
  transition:opacity .35s,transform .45s var(--spring),box-shadow .3s;
  box-shadow:var(--sh-lg)
}
#back-to-top.visible { opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto;animation:bounce-up 2.4s ease-in-out infinite }
#back-to-top:hover { animation-play-state:paused;box-shadow:0 0 0 8px rgba(28,43,74,.12),var(--sh-lg) }
#back-to-top svg { width:19px;height:19px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round }
#back-to-top .btt-ring { position:absolute;inset:0;border-radius:50%;border:2px solid rgba(37,99,235,.35);animation:wa-ring 2.4s ease-out infinite }

/* WA FLOAT */
#wa-tooltip {
  position:fixed;bottom:160px;right:22px;z-index:10002;
  background:#fff;color:#111;border-radius:14px 14px 4px 14px;
  padding:11px 32px 11px 13px;box-shadow:var(--sh-xl);
  font-size:.78rem;font-weight:600;max-width:215px;line-height:1.45;
  opacity:0;pointer-events:none;transform:translateY(8px) scale(.94);
  transition:opacity .28s,transform .3s var(--spring);
  border:1px solid rgba(37,211,102,.2)
}
#wa-tooltip.show { opacity:1;pointer-events:auto;transform:translateY(0) scale(1) }
#wa-tooltip strong { color:#128C7E;display:block;margin-bottom:2px;font-size:.8rem }
#wa-tooltip .tt-close { position:absolute;top:7px;right:9px;font-size:.65rem;color:#999;cursor:pointer;background:none;border:none;padding:2px;transition:color .2s }
#wa-tooltip .tt-close:hover { color:#ef4444 }
#wa-tooltip::after { content:'';position:absolute;bottom:-8px;right:18px;width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:8px solid #fff }

#wa-float { position:fixed;bottom:88px;right:20px;z-index:10001;text-decoration:none;display:block }
@keyframes wa-ripple { 0%{transform:scale(1);opacity:.65} 100%{transform:scale(1.9);opacity:0} }
.wa-ring-1,.wa-ring-2 { position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-ripple 2.8s ease-out infinite;pointer-events:none }
.wa-ring-2 { animation-delay:1.15s }
.wa-pill { display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:9px 18px 9px 9px;box-shadow:0 6px 28px rgba(18,140,126,.42);transition:transform .32s var(--spring),box-shadow .3s;white-space:nowrap }
#wa-float:hover .wa-pill { transform:translateY(-4px) scale(1.03);box-shadow:0 16px 40px rgba(18,140,126,.55) }
.wa-icon-circle { width:38px;height:38px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;position:relative;transition:transform .3s }
#wa-float:hover .wa-icon-circle { transform:rotate(-10deg) scale(1.08) }
.wa-status-dot { position:absolute;top:1px;right:1px;width:10px;height:10px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite }
.wa-text-wrap { display:flex;flex-direction:column;gap:1px }
.wa-label { font-size:.67rem;color:rgba(255,255,255,.65);letter-spacing:.3px;font-weight:600 }
.wa-cta { font-size:.9rem;color:#fff;font-weight:800;font-family:var(--font-body) }
.wa-arrow-icon { color:rgba(255,255,255,.7);font-size:.72rem;margin-left:2px;transition:transform .24s }
#wa-float:hover .wa-arrow-icon { transform:translateX(3px) }
.wa-badge { position:absolute;top:-5px;right:-5px;width:19px;height:19px;background:#ef4444;border:2px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.6rem;color:#fff;font-weight:800;animation:badge-pop .55s var(--spring) both }

/* TOAST / COOKIE */
#toast { position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-lg);padding:13px 18px;font-size:.84rem;display:flex;align-items:center;gap:10px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:220px;max-width:calc(100vw - 44px);white-space:nowrap }
#toast.show { opacity:1;transform:translateX(-50%) translateY(0) }
#cookie-bar { position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.82);padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:14px;z-index:9998;transform:translateY(100%);transition:transform .4s;border-top:1px solid rgba(255,255,255,.07);flex-wrap:wrap }
#cookie-bar.show { transform:translateY(0) }
#cookie-bar p { font-size:.8rem;margin:0;flex:1;min-width:200px }
#cookie-accept { background:var(--blue);color:#fff;border:none;padding:8px 20px;border-radius:var(--r-pill);font-size:.81rem;cursor:pointer;font-family:var(--font-body);font-weight:700;transition:var(--t) }
#cookie-accept:hover { background:var(--blue-d) }

/* ═══════════════════════════════════════
   NAVBAR — Udemy-inspired clean top bar
═══════════════════════════════════════ */
.navbar {
  position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);
  background:rgba(255,255,255,.97);backdrop-filter:blur(20px) saturate(1.6);
  border-bottom:1px solid rgba(15,23,42,.08);transition:var(--t)
}
.navbar.scrolled { background:rgba(255,255,255,.99);box-shadow:0 1px 18px rgba(15,23,42,.08) }
.nav-inner { max-width:1280px;margin:0 auto;padding:0 20px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px }
.nav-brand { font-family:var(--font-display);font-size:1.2rem;font-weight:600;color:var(--primary);flex-shrink:0;letter-spacing:-.3px;display:flex;align-items:center;gap:7px }
.brand-dot { width:8px;height:8px;background:var(--accent);border-radius:50%;display:inline-block;flex-shrink:0;box-shadow:0 0 8px rgba(224,92,42,.55);animation:pulse-dot 3s infinite }
.nav-brand em { font-style:normal;color:var(--accent) }
.nav-links { display:none;align-items:center;gap:1px;list-style:none;flex:1;justify-content:center }
.nl-item { position:relative }
.nl-a { font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 11px;border-radius:var(--r-md);transition:var(--t);white-space:nowrap;display:flex;align-items:center;gap:4px }
.nl-a:hover,.nl-a.active { color:var(--primary);background:rgba(15,23,42,.05) }
.nl-a .arrow { font-size:.55rem;transition:transform .25s }
.nl-item:hover .arrow { transform:rotate(180deg) }

/* Mega drop */
.mega-drop { position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%) translateY(8px);min-width:560px;background:#fff;border-radius:var(--r-xl);border:1px solid rgba(15,23,42,.07);box-shadow:var(--sh-xl);padding:24px;opacity:0;visibility:hidden;pointer-events:none;transition:all .18s var(--ease) }
.nl-item:hover .mega-drop { opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0) }
.mega-drop::before { content:'';position:absolute;top:-6px;left:50%;width:11px;height:11px;background:#fff;border-left:1px solid rgba(15,23,42,.07);border-top:1px solid rgba(15,23,42,.07);transform:translateX(-50%) rotate(45deg) }
.mega-grid { display:grid;grid-template-columns:1fr 1fr 1fr }
.mega-col-label { font-size:.63rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--blue);padding:0 8px 10px;display:block }
.mega-link { display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:var(--r-md);font-size:.82rem;font-weight:500;color:var(--slate);transition:all .14s }
.mega-link i { width:17px;color:var(--blue);font-size:.78rem;flex-shrink:0 }
.mega-link:hover { background:var(--blue-pale);color:var(--blue);transform:translateX(2px) }

.nav-cta { display:none;align-items:center;gap:8px;flex-shrink:0 }

/* Hamburger */
.ham-btn { display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:42px;height:42px;background:none;border:none;cursor:pointer;border-radius:var(--r-md);transition:var(--t);flex-shrink:0 }
.ham-btn:hover { background:rgba(15,23,42,.06) }
.ham-line { display:block;width:22px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .26s var(--ease);transform-origin:center }
.ham-btn.open .ham-line:nth-child(1) { transform:translateY(7px) rotate(45deg) }
.ham-btn.open .ham-line:nth-child(2) { opacity:0;transform:scaleX(0) }
.ham-btn.open .ham-line:nth-child(3) { transform:translateY(-7px) rotate(-45deg) }
.mob-quick { display:flex;align-items:center;gap:6px;flex-shrink:0 }
.mob-quick-btn { width:38px;height:38px;border-radius:var(--r-md);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.88rem;transition:var(--t);background:var(--blue-pale);color:var(--blue) }
.mob-quick-wa { width:38px;height:38px;border-radius:var(--r-md);background:rgba(37,211,102,.1);color:#25D366;display:flex;align-items:center;justify-content:center;font-size:.88rem;transition:var(--t) }

/* Mobile panel */
.mob-overlay { position:fixed;inset:0;background:rgba(10,15,30,.55);backdrop-filter:blur(5px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s }
.mob-overlay.open { opacity:1;visibility:visible }
.mob-panel { position:fixed;top:0;right:0;width:min(360px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-8px 0 40px rgba(10,15,30,.16);display:flex;flex-direction:column }
.mob-panel.open { transform:translateX(0) }
.mob-head { display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0 }
.mob-close { width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.85rem }
.mob-close:hover { background:#ef4444;color:#fff }
.mob-body { padding:8px 0;flex:1 }
.mob-link { display:flex;align-items:center;gap:11px;padding:13px 22px;font-size:.91rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px }
.mob-link i { width:19px;color:var(--blue);font-size:.84rem;flex-shrink:0 }
.mob-link:hover { background:var(--blue-pale);color:var(--blue);padding-left:28px }
.mob-sub-toggle { display:flex;align-items:center;justify-content:space-between;padding:13px 22px;font-size:.91rem;font-weight:600;color:var(--ink);cursor:pointer;transition:var(--t);min-height:48px }
.mob-sub-toggle .left { display:flex;align-items:center;gap:11px }
.mob-sub-toggle .left i { width:19px;color:var(--blue);font-size:.84rem }
.mob-sub-toggle:hover { background:var(--blue-pale);color:var(--blue) }
.mob-sub-toggle .chev { font-size:.64rem;color:var(--slate);transition:transform .28s;flex-shrink:0 }
.mob-sub-toggle.open .chev { transform:rotate(180deg) }
.mob-sub { background:rgba(37,99,235,.03);border-top:1px solid rgba(37,99,235,.07);border-bottom:1px solid rgba(37,99,235,.07);max-height:0;overflow:hidden;transition:max-height .35s ease }
.mob-sub.open { max-height:700px }
.mob-sub a { display:flex;align-items:center;gap:9px;padding:11px 22px 11px 50px;font-size:.83rem;color:var(--slate);transition:var(--t);min-height:44px }
.mob-sub a i { width:16px;color:var(--blue);font-size:.76rem;flex-shrink:0 }
.mob-sub a:hover { color:var(--blue);background:rgba(37,99,235,.05);padding-left:56px }
.mob-hr { border:none;border-top:1px solid var(--mist);margin:6px 20px }
.mob-footer { padding:14px 18px 32px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:10px }

/* ═══════════════════════════════════════
   BUTTONS
═══════════════════════════════════════ */
.btn-primary,.btn-accent,.btn-outline,.btn-ghost-white,.btn-wa {
  display:inline-flex;align-items:center;gap:7px;cursor:pointer;border:none;
  padding:12px 24px;border-radius:var(--r-md);font-weight:700;font-size:.875rem;
  transition:var(--t);white-space:nowrap;letter-spacing:.01em;text-align:center;justify-content:center;
  font-family:var(--font-body)
}
.btn-primary { background:var(--primary);color:#fff;box-shadow:var(--sh-sm) }
.btn-primary:hover { background:var(--primary-l);transform:translateY(-1px);box-shadow:var(--sh-md) }
.btn-accent { background:var(--accent);color:#fff;box-shadow:var(--sh-accent) }
.btn-accent:hover { background:var(--accent-d);transform:translateY(-1px);box-shadow:0 8px 24px rgba(224,92,42,.32) }
/* keep compatibility with btn-orange alias */
.btn-orange { display:inline-flex;align-items:center;gap:7px;cursor:pointer;border:none;padding:12px 24px;border-radius:var(--r-md);font-weight:700;font-size:.875rem;transition:var(--t);white-space:nowrap;text-align:center;justify-content:center;font-family:var(--font-body);background:var(--accent);color:#fff;box-shadow:var(--sh-accent) }
.btn-orange:hover { background:var(--accent-d);transform:translateY(-1px) }
.btn-outline { background:transparent;color:var(--blue);border:1.5px solid var(--blue) }
.btn-outline:hover { background:var(--blue);color:#fff;transform:translateY(-1px);box-shadow:var(--sh-blue) }
.btn-ghost-white { background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.25);backdrop-filter:blur(8px) }
.btn-ghost-white:hover { background:rgba(255,255,255,.18);transform:translateY(-1px) }
.btn-wa { background:linear-gradient(135deg,#25D366,#1aad54);color:#fff;box-shadow:0 4px 14px rgba(37,211,102,.26) }
.btn-wa:hover { transform:translateY(-1px);box-shadow:0 10px 28px rgba(37,211,102,.38) }
.btn-nav-signin { display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:var(--slate);padding:7px 14px;border:1.5px solid var(--mist);border-radius:var(--r-md);transition:var(--t);background:#fff;cursor:pointer;font-family:var(--font-body) }
.btn-nav-signin:hover { color:var(--blue);border-color:var(--blue) }
.btn-nav-orange { display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:var(--accent);padding:7px 14px;border:1.5px solid rgba(224,92,42,.3);border-radius:var(--r-md);transition:var(--t);background:var(--accent-pale);cursor:pointer;font-family:var(--font-body) }
.btn-nav-orange:hover { background:var(--accent);color:#fff;border-color:transparent }
.btn-nav-start { display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:#fff;padding:8px 18px;border:none;border-radius:var(--r-md);transition:var(--t);background:var(--primary);cursor:pointer;font-family:var(--font-body) }
.btn-nav-start:hover { background:var(--primary-l);transform:translateY(-1px);box-shadow:var(--sh-md) }
.btn-pdf { display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:#fff;border:none;padding:13px 28px;border-radius:var(--r-md);font-weight:700;font-size:.9rem;transition:var(--t);cursor:pointer;box-shadow:var(--sh-accent);font-family:var(--font-body) }
.btn-pdf:hover { background:var(--accent-d);transform:translateY(-2px) }
.btn-hero-primary { display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-body);font-weight:700;font-size:.92rem;color:#fff;background:var(--accent);border:none;border-radius:var(--r-md);padding:13px 26px;cursor:pointer;transition:all .24s;box-shadow:0 4px 20px rgba(224,92,42,.36) }
.btn-hero-primary:hover { background:var(--accent-d);transform:translateY(-2px);box-shadow:0 10px 32px rgba(224,92,42,.46) }
.btn-hero-primary i { transition:transform .2s }
.btn-hero-primary:hover i { transform:translateX(3px) }
.btn-hero-ghost { display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-body);font-weight:700;font-size:.92rem;color:#fff;background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.2);border-radius:var(--r-md);padding:12px 22px;cursor:pointer;transition:all .24s;backdrop-filter:blur(10px) }
.btn-hero-ghost:hover { background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.38);transform:translateY(-2px) }
.btn-hero-wa { display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-body);font-weight:700;font-size:.92rem;color:#fff;background:linear-gradient(135deg,#128C7E,#075E54);border:none;border-radius:var(--r-md);padding:13px 20px;cursor:pointer;transition:all .24s;box-shadow:0 4px 16px rgba(18,140,126,.26) }
.btn-hero-wa:hover { transform:translateY(-2px);box-shadow:0 10px 28px rgba(18,140,126,.4) }

/* ═══════════════════════════════════════
   HERO
═══════════════════════════════════════ */
.hero { min-height:100svh;padding-top:var(--nav-h);position:relative;overflow:hidden;display:flex;align-items:stretch }
.hero-slides { position:absolute;inset:0;z-index:0 }
.hero-slide { position:absolute;inset:0;opacity:0;transition:opacity var(--slide-fade) ease-in-out;will-change:opacity }
.hero-slide.active { opacity:1 }
.hero-slide img { width:100%;height:100%;object-fit:cover;object-position:center top;animation:slide-ken-burns var(--slide-dur) ease-in-out forwards }
.hero-slide::after { content:'';position:absolute;inset:0;background:linear-gradient(165deg,rgba(4,8,22,.96) 0%,rgba(8,14,32,.91) 38%,rgba(10,18,42,.62) 66%,rgba(4,8,22,.8) 100%) }
@media(min-width:992px) { .hero-slide::after { background:linear-gradient(108deg,rgba(4,8,22,.97) 0%,rgba(8,14,32,.94) 32%,rgba(10,18,42,.5) 58%,rgba(4,8,22,.1) 100%) } }
#hero-canvas { position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.38 }
.hero-mesh { position:absolute;inset:0;z-index:2;pointer-events:none;background-image:linear-gradient(rgba(37,99,235,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.035) 1px,transparent 1px);background-size:56px 56px }
.hero-orb-1 { position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.12) 0%,transparent 65%);top:-180px;right:-80px;pointer-events:none;z-index:2 }
.hero-orb-2 { position:absolute;width:450px;height:450px;border-radius:50%;background:radial-gradient(circle,rgba(224,92,42,.08) 0%,transparent 68%);bottom:-80px;left:-60px;pointer-events:none;z-index:2 }

.hero-inner { position:relative;z-index:5;width:100%;display:flex;flex-direction:column;justify-content:center;padding:80px 0 110px;gap:0 }
.hero-copy { flex:1;min-width:0;display:flex;flex-direction:column }
.hero-copy>* { opacity:0;animation:hero-text-in .75s cubic-bezier(.22,1,.36,1) forwards }
.h-anim-1{animation-delay:.08s}.h-anim-2{animation-delay:.22s}.h-anim-3{animation-delay:.38s}
.h-anim-4{animation-delay:.54s}.h-anim-5{animation-delay:.7s}

/* Live badge */
.hero-badge { display:inline-flex;align-items:center;gap:9px;border-radius:var(--r-pill);padding:5px 13px 5px 7px;font-size:.71rem;font-weight:600;margin-bottom:20px;align-self:flex-start;letter-spacing:.2px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);color:rgba(255,255,255,.75);backdrop-filter:blur(12px) }
.hero-badge-dot { width:20px;height:20px;border-radius:50%;background:rgba(5,185,120,.18);border:1px solid rgba(5,185,120,.35);display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative }
.hero-badge-dot::after { content:'';width:7px;height:7px;border-radius:50%;background:#05b978;animation:pulse-dot 2.2s ease-in-out infinite;display:block }
.hero-badge-dot::before { content:'';position:absolute;inset:0;border-radius:50%;border:1px solid #05b978;animation:live-ping 2.2s ease-out infinite }
.hero-badge-sep { width:1px;height:11px;background:rgba(255,255,255,.18) }
.hero-headline { margin-bottom:22px }
.hero-eyebrow-line { font-family:var(--font-body);font-size:clamp(.68rem,1.6vw,.8rem);font-weight:600;letter-spacing:3px;text-transform:uppercase;color:rgba(224,160,100,.9);margin-bottom:12px;display:flex;align-items:center;gap:10px }
.hero-eyebrow-line::before { content:'';width:24px;height:1.5px;background:rgba(224,160,100,.7);flex-shrink:0 }
.hero h1 { font-family:var(--font-display);font-size:clamp(2.5rem,7vw,5.2rem);font-weight:400;color:#fff;line-height:1.02;letter-spacing:-.03em;margin:0;font-style:italic }
.hero h1 .line-plain { display:block;font-style:normal }
.hero h1 .line-outline { display:block;color:transparent;-webkit-text-stroke:2px rgba(224,160,100,.8);text-stroke:2px rgba(224,160,100,.8);font-size:clamp(2.9rem,8.5vw,6rem);letter-spacing:-.05em;line-height:.95;position:relative;font-style:normal }
.hero h1 .line-outline::after { content:attr(data-text);position:absolute;left:0;top:0;background:linear-gradient(135deg,rgba(248,200,130,.95),rgba(224,92,42,.9),rgba(195,60,18,.85));-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-stroke:0;clip-path:inset(0 55% 0 0);animation:text-reveal 1.4s .5s cubic-bezier(.22,1,.36,1) forwards }
.hero-typewriter { display:block;font-style:italic;font-size:clamp(1.3rem,3.2vw,2.6rem);font-weight:400;color:rgba(255,255,255,.45);font-family:var(--font-display);letter-spacing:-.02em;margin-top:7px;line-height:1.2;min-height:1.4em }
.tw-cursor { display:inline-block;width:2.5px;height:.78em;background:rgba(224,160,100,.8);margin-left:3px;vertical-align:text-bottom;animation:tw-blink .9s step-end infinite;border-radius:2px }
.hero-desc { color:rgba(255,255,255,.56);font-size:clamp(.9rem,2vw,1.03rem);line-height:1.85;margin-bottom:32px;max-width:500px;font-weight:400 }
.hero-desc strong { color:rgba(255,255,255,.82);font-weight:600 }
.hero-actions { display:flex;gap:10px;flex-wrap:wrap;margin-bottom:34px }
.hero-actions a { flex:1;min-width:148px;max-width:255px }
.hero-proof { display:flex;align-items:center;gap:20px;flex-wrap:wrap;padding-top:22px;border-top:1px solid rgba(255,255,255,.07) }
.hero-proof-avatars { display:flex;flex-shrink:0 }
.proof-avatar { width:30px;height:30px;border-radius:50%;border:2px solid rgba(4,8,22,.7);overflow:hidden;margin-left:-7px;background:var(--primary);display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;color:#fff }
.proof-avatar:first-child { margin-left:0 }
.hero-proof-text { flex:1;min-width:0 }
.proof-rating { display:flex;align-items:center;gap:5px;margin-bottom:2px }
.proof-stars { color:var(--gold);font-size:.78rem;letter-spacing:1px }
.proof-score { font-family:var(--font-body);font-size:.84rem;font-weight:700;color:#fff }
.proof-label { font-size:.68rem;color:rgba(255,255,255,.42) }
.hero-proof-divider { width:1px;height:34px;background:rgba(255,255,255,.1) }
.hero-stat-pill { text-align:center }
.stat-pill-val { font-family:var(--font-mono);font-size:1.25rem;font-weight:500;color:#fff;line-height:1 }
.stat-pill-label { font-size:.65rem;color:rgba(255,255,255,.36);margin-top:2px;text-transform:uppercase;letter-spacing:1px }

/* Hero card panel */
.hero-card-panel { display:none;flex-direction:column;flex-shrink:0;width:355px;position:relative }
@media(min-width:1100px) { .hero-card-panel { display:flex } }
.hcp-card { background:rgba(255,255,255,.055);backdrop-filter:blur(28px);border:1px solid rgba(255,255,255,.1);border-radius:22px;padding:22px;position:relative;overflow:hidden;animation:float-a 6s ease-in-out infinite }
.hcp-card::before { content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent) }
.hcp-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:18px }
.hcp-logo { display:flex;align-items:center;gap:9px }
.hcp-logo-mark { width:34px;height:34px;background:var(--g-primary);border-radius:9px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;color:#fff;font-family:var(--font-body) }
.hcp-logo-name { font-size:.86rem;font-weight:700;color:rgba(255,255,255,.9);line-height:1;font-family:var(--font-body) }
.hcp-logo-sub { font-size:.61rem;color:rgba(255,255,255,.36) }
.hcp-live { display:flex;align-items:center;gap:5px;background:rgba(5,185,120,.11);border:1px solid rgba(5,185,120,.22);border-radius:var(--r-pill);padding:4px 10px }
.hcp-live-dot { width:5px;height:5px;border-radius:50%;background:#05b978;animation:pulse-dot 2s infinite;flex-shrink:0 }
.hcp-live-text { font-size:.61rem;font-weight:700;color:#05b978;letter-spacing:.3px;font-family:var(--font-body) }
.hcp-ring-row { display:flex;align-items:center;gap:16px;margin-bottom:18px }
.hcp-ring { position:relative;width:84px;height:84px;flex-shrink:0 }
.hcp-ring svg { width:100%;height:100%;transform:rotate(-90deg) }
.hcp-ring-track { fill:none;stroke:rgba(255,255,255,.07);stroke-width:7 }
.hcp-ring-fill { fill:none;stroke:url(#ring-grad);stroke-width:7;stroke-linecap:round;stroke-dasharray:230 45;animation:ring-draw 1.8s .8s cubic-bezier(.22,1,.36,1) both }
.hcp-ring-center { position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center }
.hcp-ring-val { font-size:1.2rem;font-weight:500;color:#fff;line-height:1;font-family:var(--font-mono) }
.hcp-ring-lbl { font-size:.53rem;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.8px }
.hcp-ring-meta-title { font-family:var(--font-body);font-size:.9rem;font-weight:700;color:#fff;margin-bottom:4px }
.hcp-ring-meta-sub { font-size:.71rem;color:rgba(255,255,255,.4);line-height:1.5 }
.hcp-ring-badges { display:flex;gap:5px;margin-top:7px;flex-wrap:wrap }
.hcp-rbadge { padding:3px 9px;border-radius:var(--r-pill);font-size:.6rem;font-weight:700;font-family:var(--font-body) }
.hcp-rb-blue { background:rgba(37,99,235,.2);color:#7ea8f8;border:1px solid rgba(37,99,235,.28) }
.hcp-rb-orange { background:rgba(224,92,42,.18);color:var(--accent-l);border:1px solid rgba(224,92,42,.22) }
.hcp-rb-green { background:rgba(5,185,120,.14);color:#34d399;border:1px solid rgba(5,185,120,.2) }
.hcp-stats { display:flex;flex-direction:column;gap:9px;margin-bottom:16px }
.hcp-stat-row { display:flex;align-items:center;gap:9px }
.hcp-stat-icon { width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:.7rem;flex-shrink:0 }
.hcp-stat-info { flex:1 }
.hcp-stat-label { font-size:.66rem;color:rgba(255,255,255,.42);margin-bottom:3px;display:flex;justify-content:space-between }
.hcp-stat-label span { color:rgba(255,255,255,.74);font-weight:600 }
.hcp-stat-bar { height:4px;background:rgba(255,255,255,.09);border-radius:3px;overflow:hidden }
.hcp-stat-fill { height:100%;border-radius:3px;animation:bar-grow .9s ease forwards;width:0 }
.hcp-tech { display:flex;gap:5px;flex-wrap:wrap }
.hcp-tech-pill { padding:3px 9px;border-radius:var(--r-pill);font-size:.6rem;font-weight:600;background:rgba(255,255,255,.065);color:rgba(255,255,255,.58);border:1px solid rgba(255,255,255,.09) }
.hcp-mini-row { display:flex;gap:9px;margin-top:10px }
.hcp-mini { flex:1;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);border-radius:13px;padding:13px;animation:float-a 7s 1.2s ease-in-out infinite }
.hcp-mini:nth-child(2) { animation-delay:2.1s;animation-duration:5.8s }
.hcp-mini-val { font-size:1.45rem;font-weight:500;color:#fff;line-height:1;margin-bottom:3px;font-family:var(--font-mono) }
.hcp-mini-label { font-size:.6rem;color:rgba(255,255,255,.36);text-transform:uppercase;letter-spacing:.8px }
.hcp-mini-change { font-size:.62rem;font-weight:600;color:#34d399;display:flex;align-items:center;gap:3px;margin-top:5px }

/* Slide controls */
#scroll-ind { position:absolute;bottom:26px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;z-index:10;opacity:1;transition:opacity .5s }
#scroll-ind.hidden { opacity:0;pointer-events:none }
.si-pill { width:19px;height:32px;border:1.5px solid rgba(255,255,255,.24);border-radius:10px;display:flex;align-items:flex-start;justify-content:center;padding-top:5px }
.si-dot { width:2.5px;height:6px;background:#fff;border-radius:2px;animation:float-a 1.8s ease-in-out infinite }
.si-label { font-size:7px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,.28);font-family:var(--font-body) }
.slide-counter { position:absolute;top:calc(var(--nav-h) + 14px);right:20px;z-index:10;font-family:var(--font-mono);font-size:.63rem;color:rgba(255,255,255,.26);letter-spacing:1.5px;display:flex;align-items:center;gap:3px }
.slide-counter .current { color:rgba(255,255,255,.68);font-size:.72rem }
.slider-controls { position:absolute;bottom:32px;left:50%;transform:translateX(-50%);z-index:10;display:flex;align-items:center;gap:9px }
@media(min-width:992px) { .slider-controls { left:auto;right:0;bottom:50%;transform:translateY(50%);flex-direction:column;gap:8px } }
.slider-dot-wrap { position:relative;display:flex;align-items:center;justify-content:center;width:20px;height:20px }
.slider-dot-svg { position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg);pointer-events:none }
.slider-dot-ring { fill:none;stroke:rgba(255,255,255,0);stroke-width:1.5;stroke-dasharray:0 56.5;stroke-linecap:round;transition:stroke .2s }
.slider-dot-wrap.active .slider-dot-ring { stroke:rgba(255,255,255,.55);animation:ring-fill var(--slide-dur) linear forwards }
.slider-dot { width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.22);border:none;cursor:pointer;transition:all .28s;padding:0;flex-shrink:0 }
.slider-dot.active { background:#fff;transform:scale(1.5) }
.slider-arrow { position:absolute;top:50%;transform:translateY(-50%);z-index:10;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);backdrop-filter:blur(8px);color:#fff;font-size:.78rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--t) }
.slider-arrow:hover { background:rgba(255,255,255,.16) }
.slider-arrow.prev { left:14px } .slider-arrow.next { right:14px }
@media(min-width:992px) { .slider-arrow { display:none } }

/* ═══════════════════════════════════════
   LIVE TICKER
═══════════════════════════════════════ */
.live-ticker { background:var(--ink-2);border-top:1px solid rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.05);padding:9px 0;overflow:hidden;position:relative;z-index:2 }
.live-ticker-inner { display:flex;align-items:center }
.lt-label { flex-shrink:0;display:flex;align-items:center;gap:6px;background:var(--blue);color:#fff;padding:3px 13px;font-family:var(--font-body);font-size:.62rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;margin-right:16px;border-radius:0 var(--r-pill) var(--r-pill) 0;white-space:nowrap }
.lt-label-dot { width:5px;height:5px;border-radius:50%;background:#fff;animation:pulse-dot 1.8s infinite }
.lt-track { display:inline-flex;animation:marquee 22s linear infinite;white-space:nowrap }
.lt-item { display:inline-flex;align-items:center;gap:8px;padding:0 18px;color:rgba(255,255,255,.58);font-size:.78rem;font-weight:500 }
.lt-item strong { color:#fff;font-weight:700 }
.lt-sep { color:rgba(255,255,255,.16) }

/* ═══════════════════════════════════════
   LEARN BANNER — Udemy-style promo strip
═══════════════════════════════════════ */
.learn-banner { background:linear-gradient(135deg,#003d37,#004d40 50%,#00695c);padding:18px 0;border-bottom:1px solid rgba(0,176,156,.18);position:relative;overflow:hidden }
.learn-banner::before { content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(0,176,156,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,176,156,.05) 1px,transparent 1px);background-size:36px 36px }
.learn-banner-inner { position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap }
.learn-banner-icon { width:42px;height:42px;background:rgba(0,176,156,.2);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;color:var(--teal);font-size:1.15rem;border:1px solid rgba(0,176,156,.28);flex-shrink:0 }
.learn-banner-text { display:flex;align-items:center;gap:12px;flex:1;min-width:0 }
.learn-banner-content h4 { font-family:var(--font-body);font-size:.92rem;font-weight:800;color:#fff;margin-bottom:2px }
.learn-banner-content p { font-size:.76rem;color:rgba(255,255,255,.52);margin:0 }
.learn-banner-badges { display:flex;gap:7px;flex-wrap:wrap }
.learn-badge { padding:3px 11px;border-radius:var(--r-pill);font-size:.66rem;font-weight:700;background:rgba(255,255,255,.07);color:rgba(255,255,255,.68);border:1px solid rgba(255,255,255,.09) }

/* ═══════════════════════════════════════
   MARQUEE
═══════════════════════════════════════ */
.marquee-wrap { background:var(--primary);padding:10px 0;overflow:hidden;white-space:nowrap }
.marquee-track { display:inline-flex;animation:marquee 30s linear infinite }
.marquee-track:hover { animation-play-state:paused }
.marquee-item { display:inline-flex;align-items:center;gap:8px;padding:0 24px;color:rgba(255,255,255,.88);font-size:.82rem;font-weight:600 }
.marquee-sep { opacity:.28 }

/* ═══════════════════════════════════════
   TRUST STRIP — Udemy-style endorsements
═══════════════════════════════════════ */
.trust-strip { background:#fff;border-top:1px solid var(--mist);border-bottom:1px solid var(--mist);padding:16px 0;overflow-x:auto }
.trust-inner { display:flex;flex-wrap:wrap;justify-content:center;gap:18px 26px }
.trust-item { display:flex;align-items:center;gap:7px;font-family:var(--font-body);font-size:.78rem;font-weight:700;color:var(--ink);white-space:nowrap }
.trust-item i { font-size:.92rem }

/* ═══════════════════════════════════════
   SERVICES — Udemy-style clean cards
═══════════════════════════════════════ */
.services-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:12px }
.service-card { background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);overflow:hidden;position:relative;transition:var(--t);cursor:pointer;display:block;text-decoration:none;color:inherit }
.service-card:hover { transform:translateY(-4px);box-shadow:var(--sh-lg);border-color:rgba(37,99,235,.15) }
.service-card::before { content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--accent));transform:scaleX(0);transform-origin:left;transition:transform .35s;z-index:3 }
.service-card:hover::before { transform:scaleX(1) }
.svc-img-wrap { height:126px;overflow:hidden;position:relative }
.svc-img { width:100%;height:100%;object-fit:cover;transition:transform .5s }
.service-card:hover .svc-img { transform:scale(1.06) }
.svc-overlay { position:absolute;inset:0;background:rgba(255,255,255,.97);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;opacity:0;transition:opacity .26s;z-index:2;text-align:center;padding:16px;backdrop-filter:blur(5px) }
.service-card:hover .svc-overlay { opacity:1 }
.svc-ov-icon { width:44px;height:44px;background:var(--g-blue);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.05rem;transform:scale(.85);transition:transform .3s var(--spring) .04s }
.service-card:hover .svc-ov-icon { transform:scale(1) }
.svc-ov-title { font-family:var(--font-body);font-weight:700;font-size:.84rem;color:var(--blue);transform:translateY(5px);transition:transform .26s .05s }
.svc-ov-sub { font-size:.69rem;color:var(--slate);transform:translateY(5px);transition:transform .26s .08s }
.service-card:hover .svc-ov-title,.service-card:hover .svc-ov-sub { transform:translateY(0) }
.svc-ov-btn { display:inline-flex;align-items:center;gap:5px;background:var(--g-blue);color:#fff;padding:6px 13px;border-radius:var(--r-md);font-size:.7rem;font-weight:700;transform:translateY(5px);transition:transform .26s .11s;font-family:var(--font-body) }
.service-card:hover .svc-ov-btn { transform:translateY(0) }
.svc-icon-wrap { position:relative;z-index:2;margin:-18px 0 9px 14px;width:42px;height:42px;background:#fff;border-radius:11px;display:flex;align-items:center;justify-content:center;box-shadow:var(--sh-sm);border:1px solid var(--mist) }
.svc-body { padding:0 14px 14px }
.svc-body h3 { font-family:var(--font-body);font-size:.93rem;font-weight:700;margin-bottom:4px }
.svc-body p { font-size:.78rem;color:var(--slate);line-height:1.55;margin-bottom:9px }
.svc-pill { display:inline-flex;align-items:center;gap:4px;font-size:.66rem;font-weight:800;color:var(--blue);background:var(--blue-pale);padding:3px 10px;border-radius:var(--r-pill);transition:var(--t);font-family:var(--font-body) }
.service-card:hover .svc-pill { background:var(--blue);color:#fff }

/* ═══════════════════════════════════════
   UDEMY-STYLE RATING FEATURE
═══════════════════════════════════════ */
.rating-section { background:#fff;padding:52px 0 }
.rating-grid { display:grid;grid-template-columns:1fr 2fr;gap:36px;align-items:center }
.rating-big-num { font-family:var(--font-mono);font-size:5rem;font-weight:400;line-height:1;color:var(--primary) }
.rating-stars-lg { color:var(--gold);font-size:1.6rem;letter-spacing:4px;margin:8px 0 }
.rating-label { font-size:.84rem;color:var(--slate);font-weight:600 }
.rating-bars { display:flex;flex-direction:column;gap:7px }
.rating-bar-row { display:flex;align-items:center;gap:10px;font-size:.8rem }
.rating-bar-label { color:var(--slate);width:40px;text-align:right;flex-shrink:0 }
.rating-bar-bg { background:var(--surface);border-radius:var(--r-pill);height:8px;flex:1;overflow:hidden }
.rating-bar-fill { height:100%;border-radius:var(--r-pill);background:var(--gold) }
.rating-bar-pct { color:var(--slate);width:34px;text-align:right;flex-shrink:0 }

/* ═══════════════════════════════════════
   STATS — Udemy-style metric blocks
═══════════════════════════════════════ */
.stats-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:12px }
.stat-card { background:#fff;border-radius:var(--r-lg);padding:24px 18px;text-align:center;border:1px solid var(--mist);transition:var(--t);position:relative;overflow:hidden }
.stat-card::after { content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--g-blue);transform:scaleX(0);transform-origin:left;transition:transform .32s }
.stat-card:hover { transform:translateY(-3px);box-shadow:var(--sh-lg) }
.stat-card:hover::after { transform:scaleX(1) }
.stat-num { font-family:var(--font-mono);font-size:clamp(1.8rem,5.5vw,2.9rem);font-weight:500 }
.stat-label { font-family:var(--font-body);font-size:.78rem;color:var(--slate);margin-top:5px;font-weight:600 }
.stat-sub { font-size:.69rem;color:var(--slate-l);margin-top:3px;font-weight:400;opacity:.7 }

/* ═══════════════════════════════════════
   PROCESS
═══════════════════════════════════════ */
.process-grid { display:grid;grid-template-columns:1fr;gap:12px }
.process-card { background:#fff;border-radius:var(--r-lg);padding:24px 20px;border:1px solid var(--mist);transition:var(--t);position:relative }
.process-card:hover { transform:translateY(-3px);box-shadow:var(--sh-lg) }
.process-num { font-family:var(--font-mono);font-size:2.2rem;font-weight:400;background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1;margin-bottom:11px;opacity:.55 }
.process-card h4 { font-family:var(--font-body);font-size:1rem;font-weight:700;margin-bottom:6px }
.process-card p { font-size:.82rem;color:var(--slate);line-height:1.65 }
.process-arrow { display:none }

/* ═══════════════════════════════════════
   WHY US
═══════════════════════════════════════ */
.why-grid { display:grid;grid-template-columns:1fr;gap:14px }
.why-card { background:#fff;border-radius:var(--r-lg);padding:26px 20px;border:1px solid var(--mist);transition:var(--t);position:relative;overflow:hidden }
.why-card:hover { transform:translateY(-4px);box-shadow:var(--sh-lg);border-color:rgba(37,99,235,.14) }
.why-card::before { content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--accent));transform:scaleX(0);transform-origin:left;transition:transform .35s }
.why-card:hover::before { transform:scaleX(1) }
.why-card-num { font-family:var(--font-mono);font-size:2.4rem;font-weight:400;background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent;opacity:.14;line-height:1;position:absolute;top:13px;right:16px }
.why-card-icon { width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.05rem;margin-bottom:12px }
.why-card h3 { font-family:var(--font-body);font-size:1.03rem;font-weight:700;margin-bottom:7px;color:var(--ink) }
.why-card p { font-size:.82rem;color:var(--slate);line-height:1.68;margin-bottom:12px }
.why-card-badge { display:inline-flex;align-items:center;gap:4px;border-radius:var(--r-pill);padding:3px 11px;font-size:.67rem;font-weight:700;font-family:var(--font-body) }
.why-card-badge.blue { background:var(--blue-pale);color:var(--blue);border:1px solid rgba(37,99,235,.16) }
.why-card-badge.orange { background:var(--accent-pale);color:var(--accent);border:1px solid rgba(224,92,42,.16) }
.why-card-badge.green { background:rgba(5,150,105,.09);color:var(--emerald);border:1px solid rgba(5,150,105,.18) }
.why-card-badge.purple { background:rgba(124,58,237,.09);color:#7c3aed;border:1px solid rgba(124,58,237,.18) }
.featured-why { background:var(--g-primary);border:none;display:flex;align-items:center;justify-content:center }
.featured-why::before { background:linear-gradient(90deg,rgba(255,255,255,.12),rgba(255,255,255,.02)) }
.why-feat-inner { text-align:center }
.why-feat-icon { width:52px;height:52px;background:rgba(255,255,255,.13);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.3rem;color:rgba(255,200,120,.9);margin:0 auto 11px }
.why-feat-val { font-family:var(--font-mono);font-size:2.7rem;font-weight:400;color:#fff;line-height:1;margin-bottom:4px }
.why-feat-label { font-family:var(--font-body);font-size:.76rem;font-weight:700;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:11px }
.why-feat-sub { font-size:.79rem;color:rgba(255,255,255,.48);line-height:1.6;max-width:210px;margin:0 auto }

/* ═══════════════════════════════════════
   LEARN SECTION
═══════════════════════════════════════ */
.learn-section { background:linear-gradient(158deg,#003d37,#004d40 40%,#005248);position:relative;overflow:hidden }
.learn-section::before { content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 70% 50%,rgba(0,176,156,.18) 0%,transparent 60%),radial-gradient(ellipse at 20% 80%,rgba(224,92,42,.07) 0%,transparent 50%) }
.learn-section::after { content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(0,176,156,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(0,176,156,.04) 1px,transparent 1px);background-size:44px 44px }
.learn-inner { position:relative;z-index:1;display:grid;grid-template-columns:1fr;gap:38px }
.learn-tag { display:inline-flex;align-items:center;gap:6px;background:rgba(0,176,156,.16);color:#5eead4;border-radius:var(--r-pill);padding:4px 13px;font-family:var(--font-body);font-size:.65rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;margin-bottom:13px;border:1px solid rgba(0,176,156,.22) }
.learn-tag::before { content:'';width:5px;height:5px;border-radius:50%;background:#5eead4 }
.learn-inner h2 { font-size:clamp(1.65rem,4.5vw,2.8rem);font-weight:400;color:#fff;margin-bottom:13px;line-height:1.1 }
.learn-inner h2 span { color:rgba(255,180,100,.9) }
.learn-inner p { color:rgba(255,255,255,.55);font-size:clamp(.88rem,2.3vw,.98rem);line-height:1.76;margin-bottom:22px }
.learn-cards { display:grid;grid-template-columns:1fr 1fr;gap:10px }
.learn-card { background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.09);border-radius:var(--r-lg);padding:15px 13px;transition:var(--t) }
.learn-card:hover { background:rgba(255,255,255,.09);border-color:rgba(0,176,156,.28);transform:translateY(-3px) }
.learn-card-icon { font-size:1.45rem;margin-bottom:7px;display:block }
.learn-card h5 { font-family:var(--font-body);font-size:.86rem;font-weight:700;color:#fff;margin-bottom:3px }
.learn-card p { font-size:.73rem;color:rgba(255,255,255,.48);margin:0;line-height:1.5 }
.learn-pill { display:inline-flex;align-items:center;gap:4px;background:rgba(0,176,156,.14);color:#5eead4;border-radius:var(--r-pill);padding:3px 9px;font-size:.63rem;font-weight:700;margin-top:6px }
.learn-actions { display:flex;gap:10px;flex-wrap:wrap }
.learn-meta { display:flex;gap:13px;flex-wrap:wrap;margin-top:11px }
.learn-meta-item { display:flex;align-items:center;gap:5px;font-size:.74rem;color:rgba(255,255,255,.48);font-weight:600 }
.learn-meta-item i { color:#5eead4;font-size:.72rem }

/* ═══════════════════════════════════════
   GRAPHIC DESIGN
═══════════════════════════════════════ */
.graphic-section { background:linear-gradient(145deg,#090f1e,#121f38);position:relative;overflow:hidden }
.graphic-section::before { content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 50%,rgba(37,99,235,.09) 0%,transparent 55%),radial-gradient(ellipse at 80% 80%,rgba(224,92,42,.07) 0%,transparent 50%) }
.graphic-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:10px;position:relative;z-index:1 }
.graphic-card { background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-xl);padding:18px 13px;text-align:center;color:#fff;transition:var(--t);cursor:pointer }
.graphic-card:hover { background:rgba(255,255,255,.08);border-color:rgba(224,92,42,.28);transform:translateY(-3px) }
.graphic-icon { font-size:1.6rem;margin-bottom:8px;display:block }
.graphic-card h4 { font-family:var(--font-body);font-size:.87rem;font-weight:700;margin-bottom:4px }
.graphic-card p { font-size:.72rem;color:rgba(255,255,255,.48);margin-bottom:8px }
.graphic-price { display:inline-block;background:rgba(224,92,42,.16);color:var(--accent-l);border-radius:var(--r-pill);padding:3px 10px;font-size:.65rem;font-weight:800;font-family:var(--font-body) }

/* ═══════════════════════════════════════
   TECH STACK
═══════════════════════════════════════ */
.tech-wrap { display:flex;flex-wrap:wrap;gap:8px;justify-content:center }
.tech-pill { display:inline-flex;align-items:center;gap:7px;background:#fff;border:1px solid var(--mist);border-radius:var(--r-md);padding:7px 12px;font-family:var(--font-body);font-size:.79rem;font-weight:700;color:var(--ink);transition:var(--t);white-space:nowrap }
.tech-pill:hover { border-color:var(--blue);color:var(--blue);transform:translateY(-2px);box-shadow:0 5px 16px rgba(37,99,235,.1) }

/* ═══════════════════════════════════════
   PORTFOLIO
═══════════════════════════════════════ */
.portfolio-grid { display:grid;grid-template-columns:1fr;gap:16px }
.portfolio-card { background:#fff;border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--mist);transition:var(--t) }
.portfolio-card:hover { transform:translateY(-4px);box-shadow:var(--sh-lg) }
.port-img-wrap { position:relative;overflow:hidden;height:175px }
.port-img { width:100%;height:100%;object-fit:cover;transition:transform .45s }
.portfolio-card:hover .port-img { transform:scale(1.05) }
.port-overlay { position:absolute;inset:0;background:rgba(28,43,74,.8);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .26s }
.portfolio-card:hover .port-overlay { opacity:1 }
.port-overlay i { color:#fff;font-size:1.5rem;transform:scale(.85);transition:transform .26s }
.portfolio-card:hover .port-overlay i { transform:scale(1) }
.port-body { padding:15px }
.port-tag { display:inline-block;font-family:var(--font-body);font-size:.63rem;font-weight:800;padding:3px 10px;border-radius:var(--r-pill);background:var(--blue-pale);color:var(--blue);text-transform:uppercase;letter-spacing:.9px;margin-bottom:7px }
.port-body h4 { font-family:var(--font-body);font-size:.98rem;font-weight:700;margin-bottom:5px }
.port-body .desc { font-size:.8rem;color:var(--slate);line-height:1.56;margin-bottom:8px }
.port-techs { display:flex;flex-wrap:wrap;gap:5px;margin-bottom:11px }
.tech-sm { background:var(--blue-pale);color:var(--blue);padding:2px 8px;border-radius:var(--r-pill);font-family:var(--font-body);font-size:.65rem;font-weight:700 }
.port-filter-row { display:flex;gap:7px;flex-wrap:wrap;justify-content:center;margin-bottom:24px;overflow-x:auto;padding-bottom:4px }
.pf-btn { padding:6px 15px;border-radius:var(--r-pill);font-family:var(--font-body);font-size:.77rem;font-weight:700;cursor:pointer;border:1.5px solid var(--primary);color:var(--primary);background:transparent;transition:var(--t);white-space:nowrap }
.pf-btn.active,.pf-btn:hover { background:var(--primary);color:#fff;border-color:transparent }

/* ═══════════════════════════════════════
   TEAM
═══════════════════════════════════════ */
.team-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:13px }
