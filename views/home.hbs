<style>
:root {
  --primary:#1c2b4a; --primary-d:#111d33; --primary-l:#2d4270;
  --accent:#e05c2a; --accent-d:#c44e21; --accent-l:#f07040; --accent-pale:rgba(224,92,42,.08);
  --blue:#2563eb; --blue-d:#1d4ed8; --blue-l:#3b82f6;
  --blue-pale:rgba(37,99,235,.07); --blue-pale2:rgba(37,99,235,.13);
  --orange:#e05c2a; --orange-pale:rgba(224,92,42,.08);
  --ink:#0f172a; --ink-2:#1e293b; --ink-3:#1e2a3b;
  --slate:#64748b; --slate-l:#94a3b8;
  --mist:#e2e8f0; --ghost:#f8fafc; --white:#ffffff; --surface:#f1f5f9;
  --emerald:#059669; --teal:#0d9488; --gold:#d97706; --rose:#e11d48;
  --g-primary:linear-gradient(135deg,#1c2b4a,#2d4270);
  --g-accent:linear-gradient(135deg,#e05c2a,#c44e21);
  --g-blue:linear-gradient(135deg,#2563eb,#1d4ed8);
  --g-brand:linear-gradient(135deg,#1c2b4a 0%,#2563eb 50%,#e05c2a 100%);
  --g-hero:linear-gradient(158deg,#060c1a 0%,#0c1628 45%,#111f3a 100%);
  --r-xs:4px;--r-sm:6px;--r-md:8px;--r-lg:12px;--r-xl:16px;--r-2xl:20px;--r-pill:999px;
  --nav-h:66px;
  --sh-sm:0 1px 3px rgba(15,23,42,.06),0 1px 2px rgba(15,23,42,.04);
  --sh-md:0 4px 16px rgba(15,23,42,.08),0 2px 6px rgba(15,23,42,.05);
  --sh-lg:0 12px 40px rgba(15,23,42,.12),0 4px 12px rgba(15,23,42,.06);
  --sh-xl:0 20px 60px rgba(15,23,42,.16),0 8px 20px rgba(15,23,42,.08);
  --sh-blue:0 4px 18px rgba(37,99,235,.28);
  --sh-accent:0 4px 18px rgba(224,92,42,.28);
  --ease:cubic-bezier(.4,0,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);--t:.22s var(--ease);
  --font-display:'Fraunces',Georgia,serif;
  --font-body:'Plus Jakarta Sans',system-ui,sans-serif;
  --font-mono:'JetBrains Mono',monospace;
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{font-family:var(--font-body);background:var(--ghost);color:var(--ink);overflow-x:hidden;font-size:16px;line-height:1.6}
h1,h2,h3,h4,h5,h6{font-family:var(--font-display);line-height:1.1;letter-spacing:-.02em}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--ink)}
::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}

@media(pointer:fine){body{cursor:none}a,button,[role="button"],input,textarea,select,label{cursor:none}}
#cursor-dot{position:fixed;width:8px;height:8px;border-radius:50%;background:var(--accent);pointer-events:none;z-index:99999;transform:translate(-50%,-50%);transition:background .25s,transform .2s var(--spring),opacity .2s,width .18s,height .18s,border-radius .18s;will-change:left,top}
#cursor-ring{position:fixed;width:36px;height:36px;border-radius:50%;border:1.5px solid rgba(224,92,42,.5);pointer-events:none;z-index:99998;transform:translate(-50%,-50%);transition:width .22s var(--ease),height .22s var(--ease),border-color .22s,background .22s,opacity .2s;display:flex;align-items:center;justify-content:center;will-change:left,top}
#cursor-label{font-size:.52rem;font-weight:800;color:#fff;letter-spacing:.1em;text-transform:uppercase;opacity:0;transition:opacity .15s;white-space:nowrap;user-select:none;pointer-events:none}
body.cursor-hover #cursor-dot{transform:translate(-50%,-50%) scale(2.5);background:var(--blue)}
body.cursor-hover #cursor-ring{width:54px;height:54px;border-color:rgba(37,99,235,.4)}
body.cursor-view #cursor-dot{transform:translate(-50%,-50%) scale(0);opacity:0}
body.cursor-view #cursor-ring{width:66px;height:66px;background:rgba(37,99,235,.88);border-color:transparent}
body.cursor-view #cursor-label{opacity:1}
body.cursor-text #cursor-dot{width:2px;height:18px;border-radius:1px;background:var(--blue);transform:translate(-50%,-50%)}
body.cursor-text #cursor-ring{width:0;height:0;opacity:0}
body.cursor-click #cursor-dot{transform:translate(-50%,-50%) scale(.5)}
body.cursor-click #cursor-ring{width:22px;height:22px;border-color:rgba(224,92,42,.8)}
body.cursor-hidden #cursor-dot,body.cursor-hidden #cursor-ring{opacity:0}
#scroll-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,var(--primary),var(--blue),var(--accent));z-index:9999;transition:width .06s linear}

/* DARK MODE */
body.dark{background:#0a0f1e;color:rgba(255,255,255,.88)}
body.dark .navbar{background:rgba(10,15,30,.97);border-bottom-color:rgba(255,255,255,.06)}
body.dark .navbar.scrolled{background:rgba(10,15,30,.99);box-shadow:0 1px 16px rgba(0,0,0,.3)}
body.dark .nl-a{color:rgba(255,255,255,.6)}
body.dark .nl-a:hover{color:var(--blue-l);background:rgba(37,99,235,.1)}
body.dark .mega-drop{background:#1a2236;border-color:rgba(255,255,255,.08)}
body.dark .mega-drop::before{background:#1a2236;border-color:rgba(255,255,255,.08)}
body.dark .mega-link{color:rgba(255,255,255,.6)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:#1a2236}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link{color:rgba(255,255,255,.85)}
body.dark .mob-close{background:rgba(255,255,255,.08);color:rgba(255,255,255,.8)}
body.dark .mob-sub a{color:rgba(255,255,255,.55)}
body.dark .mob-hr{border-color:rgba(255,255,255,.08)}
body.dark .mob-footer{border-color:rgba(255,255,255,.08)}
body.dark .card-white{background:#1a2236!important;border-color:rgba(255,255,255,.07)!important}
body.dark .text-muted{color:rgba(255,255,255,.45)!important}
body.dark .bg-ghost{background:#111827!important}
body.dark .bg-white-section{background:#0f1726!important}
body.dark .tech-pill{background:#1a2236;border-color:rgba(255,255,255,.09);color:rgba(255,255,255,.78)}
body.dark .faq-item{background:#1a2236;border-color:rgba(255,255,255,.07)}
body.dark .faq-q{color:rgba(255,255,255,.87)}
body.dark .stat-card{background:#1a2236;border-color:rgba(255,255,255,.07)}
body.dark .testimonial-card{background:#1a2236;border-color:rgba(255,255,255,.08)}
body.dark .service-card{background:#1a2236;border-color:rgba(255,255,255,.07)}
body.dark .trust-strip{background:#1a2236;border-color:rgba(255,255,255,.06)}
body.dark .newsletter-box{background:#1a2236;border-color:rgba(255,255,255,.08)}
body.dark .nl-form-inp{background:#0f1726;border-color:rgba(255,255,255,.09);color:#fff}
body.dark .nl-form-inp::placeholder{color:rgba(255,255,255,.3)}
body.dark .btn-nav-signin{color:rgba(255,255,255,.6);border-color:rgba(255,255,255,.12);background:transparent}
body.dark .newsletter-section{background:linear-gradient(135deg,#1a2236,#0f1726)}
body.dark #theme-toggle{background:#1a2236;border-color:rgba(255,255,255,.1)}
body.dark #theme-toggle svg{stroke:rgba(255,255,255,.8)}
body.dark .section-divider{border-color:rgba(255,255,255,.07)}
body.dark .rating-bar-bg{background:rgba(255,255,255,.08)}
body.dark .value-card{background:#1a2236;border-color:rgba(255,255,255,.07)}
body.dark .impact-card{background:#1a2236;border-color:rgba(255,255,255,.07)}

/* UTILITIES */
.container{max-width:1280px;margin:0 auto;padding:0 20px}
.section-py{padding:88px 0}.section-py-sm{padding:56px 0}
.text-center{text-align:center}
.text-muted{color:var(--slate)}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-accent{background:var(--g-accent);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-brand{background:var(--g-brand);-webkit-background-clip:text;background-clip:text;color:transparent}

.section-tag{display:inline-flex;align-items:center;gap:6px;background:var(--blue-pale);color:var(--blue);border-radius:var(--r-pill);padding:5px 16px;font-size:.68rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;border:1px solid var(--blue-pale2);font-family:var(--font-body)}
.section-tag.orange{background:var(--accent-pale);color:var(--accent);border-color:rgba(224,92,42,.18)}
.section-tag.dark-tag{background:rgba(255,255,255,.08);color:rgba(255,255,255,.7);border-color:rgba(255,255,255,.14)}
.section-title{font-size:clamp(1.8rem,4.5vw,3rem);font-weight:400;margin-bottom:18px;line-height:1.08}
.section-sub{color:var(--slate);font-size:clamp(.9rem,2vw,1.06rem);line-height:1.78;max-width:600px}
.section-divider{border:none;border-top:1px solid var(--mist);margin:0}

.mt-40{margin-top:40px}.mb-0{margin-bottom:0}
.flex{display:flex}.flex-wrap{flex-wrap:wrap}.gap-8{gap:8px}.gap-16{gap:16px}
.items-center{align-items:center}.justify-center{justify-content:center}

/* ANIMATIONS */
@keyframes float-a{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
@keyframes wa-ring{0%{inset:-2px;opacity:.7}100%{inset:-14px;opacity:0}}
@keyframes bounce-up{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-8px)}}
@keyframes dot-pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.45);opacity:.6}}
@keyframes bar-shift{0%{background-position:0%}100%{background-position:200%}}
@keyframes tw-blink{0%,100%{opacity:1}50%{opacity:0}}
@keyframes live-ping{0%{transform:scale(1);opacity:.8}100%{transform:scale(2.4);opacity:0}}
@keyframes hero-text-in{0%{opacity:0;transform:translateY(22px)}100%{opacity:1;transform:none}}
@keyframes badge-pop{0%{transform:scale(0)}100%{transform:scale(1)}}
@keyframes wa-ripple{0%{transform:scale(1);opacity:.65}100%{transform:scale(1.9);opacity:0}}
@keyframes ken-burns{0%{transform:scale(1)}100%{transform:scale(1.08)}}
@keyframes slide-in-r{0%{opacity:0;transform:translateX(40px)}100%{opacity:1;transform:none}}
@keyframes glass-shimmer{0%{background-position:-200% center}100%{background-position:200% center}}

/* FIXED WIDGETS */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:42px;height:42px;background:#fff;border:1px solid rgba(15,23,42,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:var(--sh-md);transition:var(--t)}
#theme-toggle svg{width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;transition:stroke .2s}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(18deg) scale(1.06);box-shadow:var(--sh-blue)}
#theme-toggle:hover svg{stroke:#fff}

#back-to-top{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);z-index:10000;width:48px;height:48px;background:var(--primary);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .35s,transform .45s var(--spring),box-shadow .3s;box-shadow:var(--sh-lg)}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto;animation:bounce-up 2.4s ease-in-out infinite}
#back-to-top svg{width:19px;height:19px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
#back-to-top .btt-ring{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(37,99,235,.35);animation:wa-ring 2.4s ease-out infinite}

#wa-tooltip{position:fixed;bottom:160px;right:22px;z-index:10002;background:#fff;color:#111;border-radius:14px 14px 4px 14px;padding:11px 32px 11px 13px;box-shadow:var(--sh-xl);font-size:.78rem;font-weight:600;max-width:215px;line-height:1.45;opacity:0;pointer-events:none;transform:translateY(8px) scale(.94);transition:opacity .28s,transform .3s var(--spring);border:1px solid rgba(37,211,102,.2)}
#wa-tooltip.show{opacity:1;pointer-events:auto;transform:translateY(0) scale(1)}
#wa-tooltip strong{color:#128C7E;display:block;margin-bottom:2px;font-size:.8rem}
#wa-tooltip .tt-close{position:absolute;top:7px;right:9px;font-size:.65rem;color:#999;cursor:pointer;background:none;border:none;padding:2px;transition:color .2s}
#wa-tooltip .tt-close:hover{color:#ef4444}
#wa-tooltip::after{content:'';position:absolute;bottom:-8px;right:18px;width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:8px solid #fff}

#wa-float{position:fixed;bottom:88px;right:20px;z-index:10001;text-decoration:none;display:block}
.wa-ring-1,.wa-ring-2{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-ripple 2.8s ease-out infinite;pointer-events:none}
.wa-ring-2{animation-delay:1.15s}
.wa-pill{display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:9px 18px 9px 9px;box-shadow:0 6px 28px rgba(18,140,126,.42);transition:transform .32s var(--spring),box-shadow .3s;white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-4px) scale(1.03);box-shadow:0 16px 40px rgba(18,140,126,.55)}
.wa-icon-circle{width:38px;height:38px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;position:relative;transition:transform .3s}
#wa-float:hover .wa-icon-circle{transform:rotate(-10deg) scale(1.08)}
.wa-status-dot{position:absolute;top:1px;right:1px;width:10px;height:10px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite}
.wa-text-wrap{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.67rem;color:rgba(255,255,255,.65);letter-spacing:.3px;font-weight:600}
.wa-cta{font-size:.9rem;color:#fff;font-weight:800;font-family:var(--font-body)}
.wa-arrow-icon{color:rgba(255,255,255,.7);font-size:.72rem;margin-left:2px;transition:transform .24s}
#wa-float:hover .wa-arrow-icon{transform:translateX(3px)}
.wa-badge{position:absolute;top:-5px;right:-5px;width:19px;height:19px;background:#ef4444;border:2px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.6rem;color:#fff;font-weight:800;animation:badge-pop .55s var(--spring) both}

#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-lg);padding:13px 18px;font-size:.84rem;display:flex;align-items:center;gap:10px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:220px;max-width:calc(100vw - 44px)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#cookie-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.82);padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:14px;z-index:9998;transform:translateY(100%);transition:transform .4s;border-top:1px solid rgba(255,255,255,.07);flex-wrap:wrap}
#cookie-bar.show{transform:translateY(0)}
#cookie-bar p{font-size:.8rem;margin:0;flex:1;min-width:200px}
#cookie-accept{background:var(--blue);color:#fff;border:none;padding:8px 20px;border-radius:var(--r-pill);font-size:.81rem;cursor:pointer;font-family:var(--font-body);font-weight:700;transition:var(--t)}
#cookie-accept:hover{background:var(--blue-d)}

/* NAVBAR */
.navbar{position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);background:rgba(255,255,255,.97);backdrop-filter:blur(20px) saturate(1.6);border-bottom:1px solid rgba(15,23,42,.08);transition:var(--t)}
.navbar.scrolled{background:rgba(255,255,255,.99);box-shadow:0 1px 18px rgba(15,23,42,.08)}
.nav-inner{max-width:1280px;margin:0 auto;padding:0 20px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}

.nav-brand{display:flex;align-items:center;gap:10px;flex-shrink:0;text-decoration:none}
.nav-logo-circle{width:40px;height:40px;border-radius:50%;overflow:hidden;border:2.5px solid var(--accent);flex-shrink:0;box-shadow:0 0 0 3px rgba(224,92,42,.12),0 0 0 5px rgba(37,99,235,.08);transition:var(--t);background:var(--primary)}
.nav-logo-circle img{width:100%;height:100%;object-fit:cover}
.nav-brand-text{font-family:var(--font-display);font-size:1.18rem;font-weight:600;color:var(--primary);letter-spacing:-.3px;line-height:1}
.nav-brand-text em{font-style:normal;color:var(--accent)}
.nav-brand:hover .nav-logo-circle{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.15),0 0 0 6px rgba(224,92,42,.06)}

.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-item{position:relative}
.nl-a{font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 12px;border-radius:var(--r-md);transition:var(--t);white-space:nowrap;display:flex;align-items:center;gap:4px}
.nl-a:hover,.nl-a.active{color:var(--primary);background:rgba(15,23,42,.05)}
.nl-a .arrow{font-size:.55rem;transition:transform .25s}
.nl-item:hover .arrow{transform:rotate(180deg)}

.mega-drop{position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%) translateY(8px);min-width:580px;background:#fff;border-radius:var(--r-xl);border:1px solid rgba(15,23,42,.07);box-shadow:var(--sh-xl);padding:24px;opacity:0;visibility:hidden;pointer-events:none;transition:all .18s var(--ease)}
.nl-item:hover .mega-drop{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
.mega-drop::before{content:'';position:absolute;top:-6px;left:50%;width:11px;height:11px;background:#fff;border-left:1px solid rgba(15,23,42,.07);border-top:1px solid rgba(15,23,42,.07);transform:translateX(-50%) rotate(45deg)}
.mega-grid{display:grid;grid-template-columns:1fr 1fr 1fr}
.mega-col-label{font-size:.63rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--blue);padding:0 8px 10px;display:block}
.mega-link{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:var(--r-md);font-size:.82rem;font-weight:500;color:var(--slate);transition:all .14s}
.mega-link i{width:17px;color:var(--blue);font-size:.78rem;flex-shrink:0}
.mega-link:hover{background:var(--blue-pale);color:var(--blue);transform:translateX(2px)}

.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}
.btn-nav-signin{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:var(--slate);padding:7px 14px;border:1.5px solid var(--mist);border-radius:var(--r-md);transition:var(--t);background:#fff;cursor:pointer;font-family:var(--font-body)}
.btn-nav-signin:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-orange{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:var(--accent);padding:7px 14px;border:1.5px solid rgba(224,92,42,.3);border-radius:var(--r-md);transition:var(--t);background:var(--accent-pale);cursor:pointer;font-family:var(--font-body)}
.btn-nav-orange:hover{background:var(--accent);color:#fff;border-color:transparent}
.btn-nav-start{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:#fff;padding:8px 18px;border:none;border-radius:var(--r-md);transition:var(--t);background:linear-gradient(135deg,var(--primary),var(--blue));cursor:pointer;font-family:var(--font-body)}
.btn-nav-start:hover{opacity:.9;transform:translateY(-1px);box-shadow:var(--sh-blue)}

.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:42px;height:42px;background:none;border:none;cursor:pointer;border-radius:var(--r-md);transition:var(--t);flex-shrink:0}
.ham-btn:hover{background:rgba(15,23,42,.06)}
.ham-line{display:block;width:22px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .26s var(--ease);transform-origin:center}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(7px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:38px;height:38px;border-radius:var(--r-md);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.88rem;transition:var(--t);background:var(--blue-pale);color:var(--blue)}
.mob-quick-wa{width:38px;height:38px;border-radius:var(--r-md);background:rgba(37,211,102,.1);color:#25D366;display:flex;align-items:center;justify-content:center;font-size:.88rem;transition:var(--t)}

.mob-overlay{position:fixed;inset:0;background:rgba(10,15,30,.55);backdrop-filter:blur(5px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(360px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-8px 0 40px rgba(10,15,30,.16);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.85rem}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:11px;padding:13px 22px;font-size:.91rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px}
.mob-link i{width:19px;color:var(--blue);font-size:.84rem;flex-shrink:0}
.mob-link:hover{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-sub-toggle{display:flex;align-items:center;justify-content:space-between;padding:13px 22px;font-size:.91rem;font-weight:600;color:var(--ink);cursor:pointer;transition:var(--t);min-height:48px}
.mob-sub-toggle .left{display:flex;align-items:center;gap:11px}
.mob-sub-toggle .left i{width:19px;color:var(--blue);font-size:.84rem}
.mob-sub-toggle:hover{background:var(--blue-pale);color:var(--blue)}
.mob-sub-toggle .chev{font-size:.64rem;color:var(--slate);transition:transform .28s;flex-shrink:0}
.mob-sub-toggle.open .chev{transform:rotate(180deg)}
.mob-sub{background:rgba(37,99,235,.03);border-top:1px solid rgba(37,99,235,.07);border-bottom:1px solid rgba(37,99,235,.07);max-height:0;overflow:hidden;transition:max-height .35s ease}
.mob-sub.open{max-height:700px}
.mob-sub a{display:flex;align-items:center;gap:9px;padding:11px 22px 11px 50px;font-size:.83rem;color:var(--slate);transition:var(--t);min-height:44px}
.mob-sub a i{width:16px;color:var(--blue);font-size:.76rem;flex-shrink:0}
.mob-sub a:hover{color:var(--blue);background:rgba(37,99,235,.05);padding-left:56px}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 20px}
.mob-footer{padding:14px 18px 32px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:10px}

/* BUTTONS */
.btn-primary,.btn-accent,.btn-outline,.btn-ghost-white,.btn-wa{display:inline-flex;align-items:center;gap:7px;cursor:pointer;border:none;padding:12px 24px;border-radius:var(--r-md);font-weight:700;font-size:.875rem;transition:var(--t);white-space:nowrap;letter-spacing:.01em;text-align:center;justify-content:center;font-family:var(--font-body)}
.btn-primary{background:linear-gradient(135deg,var(--primary),var(--primary-l));color:#fff;box-shadow:var(--sh-sm)}
.btn-primary:hover{opacity:.9;transform:translateY(-1px);box-shadow:var(--sh-md)}
.btn-accent{background:var(--accent);color:#fff;box-shadow:var(--sh-accent)}
.btn-accent:hover{background:var(--accent-d);transform:translateY(-1px)}
.btn-orange{display:inline-flex;align-items:center;gap:7px;cursor:pointer;border:none;padding:12px 24px;border-radius:var(--r-md);font-weight:700;font-size:.875rem;transition:var(--t);white-space:nowrap;text-align:center;justify-content:center;font-family:var(--font-body);background:var(--accent);color:#fff;box-shadow:var(--sh-accent)}
.btn-orange:hover{background:var(--accent-d);transform:translateY(-1px)}
.btn-outline{background:transparent;color:var(--blue);border:1.5px solid var(--blue)}
.btn-outline:hover{background:var(--blue);color:#fff;transform:translateY(-1px);box-shadow:var(--sh-blue)}
.btn-ghost-white{background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.25);backdrop-filter:blur(8px)}
.btn-ghost-white:hover{background:rgba(255,255,255,.18);transform:translateY(-1px)}
.btn-wa{background:linear-gradient(135deg,#25D366,#1aad54);color:#fff;box-shadow:0 4px 14px rgba(37,211,102,.26)}
.btn-wa:hover{transform:translateY(-1px);box-shadow:0 10px 28px rgba(37,211,102,.38)}
.btn-hero-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-body);font-weight:700;font-size:.95rem;color:#fff;background:var(--accent);border:none;border-radius:var(--r-md);padding:14px 28px;cursor:pointer;transition:all .24s;box-shadow:0 4px 20px rgba(224,92,42,.36)}
.btn-hero-primary:hover{background:var(--accent-d);transform:translateY(-2px);box-shadow:0 10px 32px rgba(224,92,42,.46)}
.btn-hero-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-body);font-weight:700;font-size:.95rem;color:#fff;background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.22);border-radius:var(--r-md);padding:13px 24px;cursor:pointer;transition:all .24s}
.btn-hero-ghost:hover{background:rgba(255,255,255,.15);border-color:rgba(255,255,255,.4);transform:translateY(-2px)}

/* HERO */
.hero{min-height:100svh;padding-top:var(--nav-h);position:relative;overflow:hidden;display:flex;align-items:stretch;background:linear-gradient(158deg,#060c1a 0%,#0c1628 45%,#111f3a 100%)}
.hero-bg-img{position:absolute;inset:0;z-index:0}
.hero-bg-img img{width:100%;height:100%;object-fit:cover;object-position:center;animation:ken-burns 14s ease-in-out infinite alternate}
.hero-bg-overlay{position:absolute;inset:0;background:linear-gradient(165deg,rgba(4,8,22,.97) 0%,rgba(8,14,32,.9) 38%,rgba(10,18,42,.62) 66%,rgba(4,8,22,.78) 100%);z-index:1}
#hero-canvas{position:absolute;inset:0;z-index:2;pointer-events:none;opacity:.35}
.hero-mesh{position:absolute;inset:0;z-index:2;pointer-events:none;background-image:linear-gradient(rgba(37,99,235,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.03) 1px,transparent 1px);background-size:56px 56px}
.hero-orb-1{position:absolute;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.14) 0%,transparent 65%);top:-200px;right:-100px;pointer-events:none;z-index:2}
.hero-orb-2{position:absolute;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(224,92,42,.1) 0%,transparent 68%);bottom:-100px;left:-80px;pointer-events:none;z-index:2}
.hero-orb-3{position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(28,43,74,.25) 0%,transparent 70%);top:30%;right:35%;pointer-events:none;z-index:2}

.hero-inner{position:relative;z-index:5;width:100%;display:flex;flex-direction:column;justify-content:center;padding:88px 0 110px;gap:0}
.hero-copy{flex:1;min-width:0;display:flex;flex-direction:column}
.hero-copy>*{opacity:0;animation:hero-text-in .75s cubic-bezier(.22,1,.36,1) forwards}
.h-anim-1{animation-delay:.08s}.h-anim-2{animation-delay:.22s}.h-anim-3{animation-delay:.38s}
.h-anim-4{animation-delay:.54s}.h-anim-5{animation-delay:.7s}

.hero-badge{display:inline-flex;align-items:center;gap:9px;border-radius:var(--r-pill);padding:6px 14px 6px 8px;font-size:.72rem;font-weight:600;margin-bottom:22px;align-self:flex-start;letter-spacing:.2px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);color:rgba(255,255,255,.75);backdrop-filter:blur(16px)}
.hero-badge-dot{width:20px;height:20px;border-radius:50%;background:rgba(5,185,120,.18);border:1px solid rgba(5,185,120,.35);display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative}
.hero-badge-dot::after{content:'';width:7px;height:7px;border-radius:50%;background:#05b978;animation:pulse-dot 2.2s ease-in-out infinite;display:block}
.hero-badge-dot::before{content:'';position:absolute;inset:0;border-radius:50%;border:1px solid #05b978;animation:live-ping 2.2s ease-out infinite}
.hero-badge-sep{width:1px;height:11px;background:rgba(255,255,255,.18)}

.hero-eyebrow{font-family:var(--font-body);font-size:clamp(.68rem,1.6vw,.8rem);font-weight:600;letter-spacing:3.5px;text-transform:uppercase;color:rgba(224,160,100,.9);margin-bottom:14px;display:flex;align-items:center;gap:10px}
.hero-eyebrow::before{content:'';width:28px;height:1.5px;background:linear-gradient(90deg,rgba(224,92,42,.8),rgba(37,99,235,.6));flex-shrink:0}

.hero-heading{margin-bottom:16px}
.hero-heading h1{font-family:var(--font-display);font-size:clamp(2rem,5.5vw,4rem);font-weight:400;color:#fff;line-height:1.06;letter-spacing:-.03em;margin:0}
.hero-heading .main-line{display:block;font-style:normal;font-weight:300;color:rgba(255,255,255,.68);font-size:clamp(1.1rem,2.5vw,1.7rem);letter-spacing:.05em;text-transform:uppercase;font-family:var(--font-body);margin-bottom:6px}
.hero-heading .big-line{display:block;font-style:italic;font-size:clamp(2.5rem,7vw,5rem);line-height:.95;background:linear-gradient(135deg,rgba(248,200,130,.95),rgba(224,92,42,.9),rgba(195,60,18,.85));-webkit-background-clip:text;background-clip:text;color:transparent}

.hero-typewriter{display:block;font-size:clamp(1rem,2.5vw,1.65rem);font-weight:600;color:rgba(255,255,255,.7);font-family:var(--font-body);margin-top:12px;min-height:2.1em;line-height:1.35}
.tw-text{color:rgba(120,180,255,.95)}
.tw-cursor{display:inline-block;width:2.5px;height:.82em;background:rgba(37,99,235,.9);margin-left:2px;vertical-align:text-bottom;animation:tw-blink .9s step-end infinite;border-radius:2px}

.hero-tagline{font-family:var(--font-body);font-size:.8rem;font-weight:700;color:rgba(255,255,255,.35);letter-spacing:4px;text-transform:uppercase;margin-top:8px;margin-bottom:22px;display:flex;align-items:center;gap:8px}
.hero-tagline::before,.hero-tagline::after{content:'';flex:1;height:1px;background:rgba(255,255,255,.1);max-width:40px}

.hero-desc{color:rgba(255,255,255,.56);font-size:clamp(.88rem,1.8vw,1rem);line-height:1.85;margin-bottom:32px;max-width:540px}
.hero-desc strong{color:rgba(255,255,255,.85);font-weight:600}

.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:34px}
.hero-actions a{flex:1;min-width:140px;max-width:230px}

.hero-proof{display:flex;align-items:center;gap:18px;flex-wrap:wrap;padding-top:22px;border-top:1px solid rgba(255,255,255,.08)}
.proof-avatars{display:flex;flex-shrink:0}
.proof-avatar{width:30px;height:30px;border-radius:50%;border:2px solid rgba(4,8,22,.7);overflow:hidden;margin-left:-7px;background:var(--primary);display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;color:#fff}
.proof-avatar:first-child{margin-left:0}
.proof-text{flex:1;min-width:0}
.proof-stars{color:var(--gold);font-size:.8rem;letter-spacing:1px}
.proof-score{font-family:var(--font-body);font-size:.84rem;font-weight:700;color:#fff;display:inline;margin-left:4px}
.proof-label{font-size:.68rem;color:rgba(255,255,255,.38);margin-top:1px}
.proof-divider{width:1px;height:32px;background:rgba(255,255,255,.1)}
.proof-stat{text-align:center}
.stat-val{font-family:var(--font-mono);font-size:1.18rem;font-weight:500;color:#fff;line-height:1}
.stat-lbl{font-size:.62rem;color:rgba(255,255,255,.35);margin-top:2px;text-transform:uppercase;letter-spacing:1px}

/* HERO IMAGE PANEL — glassmorphism card */
.hero-image-panel{display:none;flex-shrink:0;width:460px;position:relative;align-items:center;justify-content:center}
.hero-img-frame{position:relative;width:100%;height:560px;border-radius:28px;overflow:hidden;box-shadow:0 40px 100px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.06)}
.hero-img-frame img{width:100%;height:100%;object-fit:cover;object-position:center top}
.hero-img-frame::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(4,8,22,.92) 100%);z-index:1}
.hero-img-badge{position:absolute;bottom:24px;left:18px;right:18px;z-index:2;background:rgba(10,15,30,.7);backdrop-filter:blur(20px) saturate(1.5);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:16px 18px;display:flex;align-items:center;gap:14px;box-shadow:0 8px 32px rgba(0,0,0,.3)}
.hero-img-badge::before{content:'';position:absolute;inset:0;border-radius:16px;background:linear-gradient(135deg,rgba(37,99,235,.08),rgba(224,92,42,.05));pointer-events:none}
.hib-icon{width:38px;height:38px;background:linear-gradient(135deg,var(--accent),var(--accent-d));border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:.9rem;color:#fff;flex-shrink:0;box-shadow:0 4px 12px rgba(224,92,42,.3)}
.hib-text{flex:1}
.hib-title{font-size:.84rem;font-weight:700;color:#fff;margin-bottom:2px;font-family:var(--font-body)}
.hib-sub{font-size:.69rem;color:rgba(255,255,255,.44)}
.hib-rating{display:flex;flex-direction:column;align-items:flex-end}
.hib-stars{color:var(--gold);font-size:.78rem}
.hib-score{font-family:var(--font-mono);font-size:.92rem;font-weight:500;color:#fff}

/* Float cards on hero image */
.hero-float-card{position:absolute;background:rgba(10,15,30,.72);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:12px 15px;z-index:3;box-shadow:0 8px 24px rgba(0,0,0,.35)}
.hero-float-card.top-right{top:22px;right:-22px;animation:float-a 5s ease-in-out infinite}
.hero-float-card.mid-left{bottom:40%;left:-28px;animation:float-a 6s 1.2s ease-in-out infinite}
.hfc-icon{font-size:1.1rem;margin-bottom:4px}
.hfc-val{font-family:var(--font-mono);font-size:1.1rem;font-weight:500;color:#fff;line-height:1}
.hfc-label{font-size:.6rem;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.8px;margin-top:2px}

#scroll-ind{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;z-index:10;opacity:1;transition:opacity .5s}
#scroll-ind.hidden{opacity:0;pointer-events:none}
.si-pill{width:19px;height:32px;border:1.5px solid rgba(255,255,255,.24);border-radius:10px;display:flex;align-items:flex-start;justify-content:center;padding-top:5px}
.si-dot{width:2.5px;height:6px;background:#fff;border-radius:2px;animation:float-a 1.8s ease-in-out infinite}
.si-label{font-size:7px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,.28);font-family:var(--font-body)}

/* TICKER */
.live-ticker{background:var(--ink-2);border-bottom:1px solid rgba(255,255,255,.05);padding:9px 0;overflow:hidden;position:relative;z-index:2}
.lt-label{flex-shrink:0;display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--blue),var(--blue-d));color:#fff;padding:3px 13px;font-family:var(--font-body);font-size:.62rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;margin-right:16px;border-radius:0 var(--r-pill) var(--r-pill) 0;white-space:nowrap}
.lt-label-dot{width:5px;height:5px;border-radius:50%;background:#fff;animation:pulse-dot 1.8s infinite}
.lt-track{display:inline-flex;animation:marquee 22s linear infinite;white-space:nowrap}
.lt-item{display:inline-flex;align-items:center;gap:8px;padding:0 18px;color:rgba(255,255,255,.58);font-size:.78rem;font-weight:500}
.lt-item strong{color:#fff;font-weight:700}
.lt-sep{color:rgba(255,255,255,.16)}

/* LEARN BANNER */
.learn-banner{background:linear-gradient(135deg,#003d37,#004d40 50%,#00695c);padding:18px 0;border-bottom:1px solid rgba(0,176,156,.18);position:relative;overflow:hidden}
.learn-banner::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(0,176,156,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,176,156,.05) 1px,transparent 1px);background-size:36px 36px}
.learn-banner-inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.learn-banner-icon{width:42px;height:42px;background:rgba(0,176,156,.2);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;color:var(--teal);font-size:1.15rem;border:1px solid rgba(0,176,156,.28);flex-shrink:0}
.learn-banner-text{display:flex;align-items:center;gap:12px;flex:1;min-width:0}
.learn-banner-content h4{font-family:var(--font-body);font-size:.92rem;font-weight:800;color:#fff;margin-bottom:2px}
.learn-banner-content p{font-size:.76rem;color:rgba(255,255,255,.52);margin:0}
.learn-badge{padding:3px 11px;border-radius:var(--r-pill);font-size:.66rem;font-weight:700;background:rgba(255,255,255,.07);color:rgba(255,255,255,.68);border:1px solid rgba(255,255,255,.09)}

/* MARQUEE */
.marquee-wrap{background:var(--primary);padding:11px 0;overflow:hidden;white-space:nowrap}
.marquee-track{display:inline-flex;animation:marquee 32s linear infinite}
.marquee-track:hover{animation-play-state:paused}
.marquee-item{display:inline-flex;align-items:center;gap:8px;padding:0 24px;color:rgba(255,255,255,.88);font-size:.82rem;font-weight:600}
.marquee-item .dot{width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0}
.marquee-sep{opacity:.28}

/* TRUST STRIP */
.trust-strip{background:#fff;border-top:1px solid var(--mist);border-bottom:1px solid var(--mist);padding:18px 0;overflow-x:auto}
.trust-inner{display:flex;flex-wrap:wrap;justify-content:center;gap:16px 28px}
.trust-item{display:flex;align-items:center;gap:8px;font-family:var(--font-body);font-size:.8rem;font-weight:700;color:var(--ink);white-space:nowrap}
.trust-item i{font-size:.95rem}

/* SERVICES */
.services-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.service-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);overflow:hidden;position:relative;transition:var(--t);display:flex;flex-direction:column;color:inherit;text-decoration:none}
.service-card:hover{transform:translateY(-6px);box-shadow:var(--sh-lg);border-color:rgba(37,99,235,.15)}
.service-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--primary),var(--blue),var(--accent));transform:scaleX(0);transform-origin:left;transition:transform .38s;z-index:3}
.service-card:hover::before{transform:scaleX(1)}

.svc-img-wrap{height:148px;overflow:hidden;position:relative;flex-shrink:0;background:var(--surface)}
.svc-img{width:100%;height:100%;object-fit:cover;transition:transform .55s}
.service-card:hover .svc-img{transform:scale(1.08)}
.svc-img-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2.8rem}

.svc-icon-wrap{position:relative;z-index:2;margin:-22px 0 11px 18px;width:46px;height:46px;background:#fff;border-radius:13px;display:flex;align-items:center;justify-content:center;box-shadow:var(--sh-md);border:1px solid var(--mist);flex-shrink:0;transition:var(--t)}
.service-card:hover .svc-icon-wrap{border-color:var(--blue-pale2);box-shadow:var(--sh-blue)}

.svc-body{padding:0 18px 20px;flex:1;display:flex;flex-direction:column}
.svc-body h3{font-family:var(--font-body);font-size:.97rem;font-weight:700;margin-bottom:7px;color:var(--ink);line-height:1.3}
.svc-body p{font-size:.81rem;color:var(--slate);line-height:1.62;margin-bottom:16px;flex:1}
.svc-btn{display:inline-flex;align-items:center;gap:6px;font-size:.79rem;font-weight:700;color:var(--blue);background:var(--blue-pale);padding:8px 15px;border-radius:var(--r-md);transition:var(--t);border:1px solid rgba(37,99,235,.14);align-self:flex-start;font-family:var(--font-body)}
.svc-btn:hover,.service-card:hover .svc-btn{background:linear-gradient(135deg,var(--blue),var(--blue-d));color:#fff;border-color:transparent;box-shadow:var(--sh-blue)}
.svc-btn i{font-size:.65rem;transition:transform .2s}
.service-card:hover .svc-btn i{transform:translateX(3px)}

/* STATS — bold brand color integration */
.stats-section{background:linear-gradient(135deg,var(--primary),var(--primary-l) 50%,#1a3560);position:relative;overflow:hidden}
.stats-section::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(37,99,235,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.06) 1px,transparent 1px);background-size:48px 48px}
.stats-section::after{content:'';position:absolute;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(224,92,42,.12) 0%,transparent 65%);bottom:-150px;right:-100px;pointer-events:none}
.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;position:relative;z-index:1}
.stat-card{padding:40px 28px;text-align:center;position:relative;overflow:hidden;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-xl);margin:6px;transition:var(--t)}
.stat-card:hover{background:rgba(255,255,255,.08);transform:translateY(-4px)}
.stat-card::before{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--accent));transform:scaleX(0);transform-origin:left;transition:transform .35s}
.stat-card:hover::before{transform:scaleX(1)}
.stat-num{font-family:var(--font-mono);font-size:clamp(2rem,5.5vw,3.2rem);font-weight:400;color:#fff;line-height:1;margin-bottom:6px}
.stat-num .accent-num{color:var(--accent-l)}
.stat-num .blue-num{color:rgba(147,197,253,1)}
.stat-label{font-family:var(--font-body);font-size:.82rem;color:rgba(255,255,255,.58);font-weight:600;text-transform:uppercase;letter-spacing:1px}
.stat-sub{font-size:.7rem;color:rgba(255,255,255,.3);margin-top:4px}

/* RATING */
.rating-section{background:#fff;padding:64px 0}
.rating-wrap{display:grid;grid-template-columns:1fr;gap:40px;align-items:center;max-width:720px;margin:0 auto}
.rating-left{text-align:center}
.rating-big-num{font-family:var(--font-mono);font-size:6rem;font-weight:400;line-height:1;background:linear-gradient(135deg,var(--primary),var(--blue));-webkit-background-clip:text;background-clip:text;color:transparent}
.rating-stars-lg{font-size:1.8rem;letter-spacing:5px;margin:8px 0;background:linear-gradient(90deg,var(--gold),var(--accent));-webkit-background-clip:text;background-clip:text;color:transparent}
.rating-label{font-size:.86rem;color:var(--slate);font-weight:600}
.rating-count{font-size:.76rem;color:var(--slate-l);margin-top:4px}
.rating-bars{display:flex;flex-direction:column;gap:8px}
.rating-bar-row{display:flex;align-items:center;gap:10px;font-size:.8rem}
.rating-bar-label{color:var(--slate);width:40px;text-align:right;flex-shrink:0}
.rating-bar-bg{background:var(--surface);border-radius:var(--r-pill);height:9px;flex:1;overflow:hidden}
.rating-bar-fill{height:100%;border-radius:var(--r-pill);background:linear-gradient(90deg,var(--blue),var(--accent))}
.rating-bar-pct{color:var(--slate);width:34px;text-align:right;flex-shrink:0;font-weight:600}

/* VALUE CARDS — replaces "Why Us" with cleaner design */
.value-section{background:linear-gradient(158deg,#060c1a,#0c1628 50%,#0a1020);position:relative;overflow:hidden}
.value-section::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(37,99,235,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.04) 1px,transparent 1px);background-size:52px 52px}
.value-section::after{content:'';position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.1) 0%,transparent 65%);top:-200px;right:-100px;pointer-events:none}
.value-grid{display:grid;grid-template-columns:1fr;gap:16px;position:relative;z-index:1}
.value-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-xl);padding:28px 24px;transition:var(--t);position:relative;overflow:hidden}
.value-card:hover{background:rgba(255,255,255,.08);border-color:rgba(37,99,235,.25);transform:translateY(-4px)}
.value-card::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--accent));transform:scaleX(0);transform-origin:left;transition:transform .35s}
.value-card:hover::after{transform:scaleX(1)}
.value-icon{width:50px;height:50px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.15rem;margin-bottom:14px;transition:var(--t)}
.value-card:hover .value-icon{transform:scale(1.08)}
.value-card h3{font-family:var(--font-body);font-size:1.05rem;font-weight:700;color:#fff;margin-bottom:8px}
.value-card p{font-size:.83rem;color:rgba(255,255,255,.48);line-height:1.7;margin-bottom:14px}
.value-badge{display:inline-flex;align-items:center;gap:5px;border-radius:var(--r-pill);padding:4px 12px;font-size:.68rem;font-weight:700;font-family:var(--font-body)}
.vb-blue{background:rgba(37,99,235,.18);color:rgba(147,197,253,.9);border:1px solid rgba(37,99,235,.25)}
.vb-orange{background:rgba(224,92,42,.18);color:rgba(251,146,60,.9);border:1px solid rgba(224,92,42,.25)}
.vb-green{background:rgba(5,150,105,.15);color:rgba(52,211,153,.9);border:1px solid rgba(5,150,105,.22)}
.vb-purple{background:rgba(124,58,237,.18);color:rgba(167,139,250,.9);border:1px solid rgba(124,58,237,.25)}
.vb-white{background:rgba(255,255,255,.1);color:rgba(255,255,255,.7);border:1px solid rgba(255,255,255,.15)}

/* IMPACT NUMBERS */
.impact-strip{background:linear-gradient(90deg,var(--primary) 0%,#1a3266 33%,#1c3870 66%,var(--primary) 100%);padding:36px 0;border-top:1px solid rgba(37,99,235,.2);border-bottom:1px solid rgba(37,99,235,.2)}
.impact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0;position:relative;z-index:1}
.impact-item{text-align:center;padding:20px 16px;position:relative}
.impact-item::after{content:'';position:absolute;right:0;top:20%;bottom:20%;width:1px;background:rgba(255,255,255,.1)}
.impact-item:nth-child(2n)::after{display:none}
.impact-val{font-family:var(--font-mono);font-size:clamp(1.6rem,4vw,2.4rem);font-weight:500;color:#fff;line-height:1;margin-bottom:4px}
.impact-val .v-accent{color:var(--accent-l)}
.impact-val .v-blue{color:rgba(147,197,253,1)}
.impact-label{font-size:.72rem;color:rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:1.2px;font-weight:600}

/* TESTIMONIALS */
.testimonial-grid{display:grid;grid-template-columns:1fr;gap:14px}
.testimonial-card{background:#fff;border-radius:var(--r-xl);padding:26px 22px;border:1px solid var(--mist);transition:var(--t);display:flex;flex-direction:column;position:relative;overflow:hidden}
.testimonial-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.testimonial-card::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(180deg,var(--blue),var(--accent));border-radius:3px 0 0 3px}
.t-stars{color:var(--gold);letter-spacing:2px;margin-bottom:12px;font-size:.95rem}
.t-quote{font-style:italic;color:var(--slate);line-height:1.8;font-size:.86rem;flex-grow:1;margin-bottom:16px}
.t-author{display:flex;align-items:center;gap:11px}
.t-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.05rem;flex-shrink:0;border:2px solid var(--mist)}
.t-name{font-family:var(--font-body);font-weight:700;font-size:.85rem}
.t-role{font-size:.71rem;color:var(--slate)}
.test-featured{background:linear-gradient(135deg,var(--primary),#1a3266);border-radius:var(--r-2xl);padding:40px 36px;position:relative;overflow:hidden;margin-bottom:10px;border:1px solid rgba(37,99,235,.2)}
.test-featured::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:linear-gradient(180deg,var(--blue),var(--accent))}
.test-featured::after{content:'';position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(224,92,42,.1) 0%,transparent 70%);bottom:-100px;right:-80px;pointer-events:none}
.tf-quote-mark{font-family:var(--font-display);font-size:7rem;line-height:.6;color:var(--blue);opacity:.2;margin-bottom:-14px;display:block}
blockquote.tf-quote{font-size:clamp(1.05rem,2.6vw,1.32rem);font-weight:400;color:rgba(255,255,255,.9);line-height:1.76;font-style:italic;margin-bottom:22px;position:relative;z-index:1}
.tf-author{display:flex;align-items:center;gap:14px;position:relative;z-index:1;flex-wrap:wrap}
.tf-avatar{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-body);font-weight:700;font-size:1.05rem;color:#fff;flex-shrink:0;border:2px solid rgba(255,255,255,.15)}
.tf-name{font-family:var(--font-body);font-weight:700;font-size:.92rem;color:#fff;margin-bottom:2px}
.tf-role{font-size:.73rem;color:rgba(255,255,255,.45)}
.tf-stars{margin-left:auto;color:var(--gold);font-size:1rem;letter-spacing:2px}

/* FAQ */
.faq-grid{display:grid;grid-template-columns:1fr;gap:9px}
.faq-item{background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);overflow:hidden;transition:border-color .22s,box-shadow .22s}
.faq-item:hover{border-color:rgba(37,99,235,.2)}
.faq-item.open{border-color:var(--blue);box-shadow:0 4px 16px rgba(37,99,235,.08)}
.faq-q{padding:15px 18px;font-family:var(--font-body);font-weight:700;font-size:.86rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;transition:var(--t);min-height:52px}
.faq-icon{width:20px;height:20px;border-radius:50%;background:var(--blue-pale);color:var(--blue);display:flex;align-items:center;justify-content:center;font-size:.65rem;transition:transform .26s,background .22s;flex-shrink:0;margin-left:12px}
.faq-item.open .faq-icon{transform:rotate(45deg);background:var(--blue);color:#fff}
.faq-a{padding:0 18px;max-height:0;overflow:hidden;transition:all .32s;color:var(--slate);font-size:.83rem;line-height:1.75}
.faq-item.open .faq-a{max-height:250px;padding:0 18px 15px}

/* NEWSLETTER */
.newsletter-section{background:linear-gradient(135deg,#eef2ff,#f0fdf4)}
.newsletter-box{background:#fff;border-radius:var(--r-2xl);padding:32px 24px;border:1px solid var(--mist);box-shadow:var(--sh-md);transition:var(--t);position:relative;overflow:hidden}
.newsletter-box::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--primary),var(--blue),var(--accent))}
.newsletter-box:hover{transform:translateY(-2px);box-shadow:var(--sh-lg)}
.nl-icon{width:48px;height:48px;background:linear-gradient(135deg,var(--blue-pale),rgba(224,92,42,.08));border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:1.35rem;color:var(--blue);margin-bottom:12px;border:1px solid var(--blue-pale2)}
.nl-form{position:relative;display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.nl-form-inp{flex:1;min-width:0;padding:12px 13px 12px 42px;border:1.5px solid var(--mist);border-radius:var(--r-md);font-size:16px;font-family:var(--font-body);transition:var(--t);background:#fff;color:var(--ink);outline:none}
.nl-form-inp:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.08)}
.nl-form i{position:absolute;left:15px;color:var(--slate);font-size:.86rem;pointer-events:none;top:50%;transform:translateY(-50%)}
.nl-submit{background:linear-gradient(135deg,var(--primary),var(--blue));color:#fff;border:none;padding:11px 22px;border-radius:var(--r-md);font-family:var(--font-body);font-weight:700;font-size:.82rem;transition:var(--t);cursor:pointer;white-space:nowrap;flex-shrink:0;box-shadow:var(--sh-blue)}
.nl-submit:hover{opacity:.9;transform:translateY(-1px)}
.nl-submit:disabled{opacity:.65;cursor:not-allowed}
.nl-grid{display:grid;grid-template-columns:1fr;gap:28px}

/* CTA BAND */
.cta-section{background:linear-gradient(135deg,var(--primary) 0%,#1a3266 40%,var(--primary-l) 70%,#1c3870 100%);position:relative;overflow:hidden}
.cta-section::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:44px 44px}
.cta-section::after{content:'';position:absolute;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(224,92,42,.15) 0%,transparent 65%);bottom:-200px;right:-100px}
.cta-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;position:relative;z-index:1}
.cta-btn-white{background:#fff;color:var(--primary);font-weight:800;border-radius:var(--r-md);padding:13px 26px;font-size:.9rem;display:inline-flex;align-items:center;gap:7px;transition:var(--t);box-shadow:0 4px 18px rgba(0,0,0,.14);font-family:var(--font-body)}
.cta-btn-white:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(0,0,0,.22);color:var(--blue)}
.cta-btn-orange{background:var(--accent);color:#fff;font-weight:800;border-radius:var(--r-md);padding:13px 24px;font-size:.9rem;display:inline-flex;align-items:center;gap:7px;transition:var(--t);box-shadow:var(--sh-accent);font-family:var(--font-body)}
.cta-btn-orange:hover{background:var(--accent-d);transform:translateY(-2px)}

/* FOOTER */
footer{background:#060d1e;color:rgba(255,255,255,.5);font-size:.82rem;border-top:1px solid rgba(255,255,255,.05)}
.footer-accent-bar{height:3px;background:linear-gradient(90deg,var(--primary),var(--blue),var(--accent),var(--blue),var(--primary));background-size:300% 100%;animation:bar-shift 8s linear infinite}
.footer-cta-strip{background:linear-gradient(135deg,#0d1936,#101f3a);border-bottom:1px solid rgba(255,255,255,.05);padding:30px 0}
.footer-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
.footer-cta-text h4{font-family:var(--font-body);font-size:clamp(.98rem,3vw,1.35rem);font-weight:800;color:#fff;margin-bottom:3px;line-height:1.2}
.footer-cta-text p{font-size:.77rem;color:rgba(255,255,255,.4);margin:0}
.footer-cta-actions{display:flex;gap:10px;flex-wrap:wrap;flex-shrink:0}
.footer-body{padding:52px 0 36px}
.footer-cols{display:grid;grid-template-columns:2fr 1fr 1fr 1.6fr;gap:34px 26px}
.footer-brand-name{font-family:var(--font-display);font-size:1.14rem;font-weight:600;color:#fff;letter-spacing:-.3px;display:flex;align-items:center;gap:8px;margin-bottom:10px}
.footer-brand-name em{font-style:normal;color:var(--accent)}
.footer-brand-dot{width:7px;height:7px;background:var(--accent);border-radius:50%;box-shadow:0 0 8px rgba(224,92,42,.55);flex-shrink:0}
.footer-tagline{font-size:.78rem;color:rgba(255,255,255,.36);line-height:1.74;max-width:275px;margin-bottom:16px}
.footer-socials{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px}
.fsoc{width:32px;height:32px;border-radius:var(--r-md);display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);color:rgba(255,255,255,.5);font-size:.8rem;transition:all .2s;text-decoration:none}
.fsoc:hover{transform:translateY(-3px)}
.fsoc.tw:hover{background:#1da1f2;color:#fff}
.fsoc.li:hover{background:#0077b5;color:#fff}
.fsoc.gh:hover{background:#fff;color:#111}
.fsoc.ig:hover{background:linear-gradient(135deg,#fd5949,#d6249f,#285aeb);color:#fff}
.fsoc.yt:hover{background:#ff0000;color:#fff}
.fsoc.wa:hover{background:#25D366;color:#fff}
.footer-col-title{font-size:.66rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:rgba(255,255,255,.28);margin-bottom:15px;display:flex;align-items:center;gap:6px;font-family:var(--font-body)}
.footer-col-title::before{content:'';display:inline-block;width:12px;height:2px;background:linear-gradient(90deg,var(--blue),var(--accent));border-radius:2px;flex-shrink:0}
.footer-links{list-style:none;padding:0;margin:0}
.footer-links li{margin-bottom:8px}
.footer-links a{color:rgba(255,255,255,.4);text-decoration:none;font-size:.78rem;transition:color .18s,padding-left .18s;display:inline-flex;align-items:center;gap:5px}
.footer-links a:hover{color:#fff;padding-left:3px}
.footer-links a i{width:13px;font-size:.68rem;flex-shrink:0;opacity:.5}
.footer-links a.academy-link{color:#5eead4;font-weight:600}
.footer-contact-item{display:flex;align-items:flex-start;gap:9px;margin-bottom:12px}
.fci-icon{width:28px;height:28px;flex-shrink:0;background:rgba(37,99,235,.1);border-radius:7px;display:flex;align-items:center;justify-content:center;color:var(--blue-l);font-size:.7rem;margin-top:1px}
.fci-text{display:flex;flex-direction:column;gap:2px}
.fci-label{font-size:.6rem;color:rgba(255,255,255,.25);font-weight:700;letter-spacing:.6px;text-transform:uppercase}
.fci-val{font-size:.77rem;color:rgba(255,255,255,.64)}
.fci-val a{color:rgba(255,255,255,.64);text-decoration:none;transition:color .18s}
.fci-val a:hover{color:var(--accent-l)}
.footer-hours{display:inline-flex;align-items:center;gap:5px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:7px;padding:6px 10px;font-size:.71rem;color:rgba(255,255,255,.36);margin-top:4px}
.hours-dot{width:5px;height:5px;background:#0dbf7e;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite;flex-shrink:0}
.footer-divider{border:none;border-top:1px solid rgba(255,255,255,.06)}
