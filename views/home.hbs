<style>
/* ══════════════════════════════════════════
   DESIGN TOKENS
══════════════════════════════════════════ */
:root {
  --ink:        #0a0f1e;
  --ink-2:      #141929;
  --ink-3:      #1c2340;
  --mid:        #2a3356;
  --slate:      #64748b;
  --mist:       #e8edf8;
  --ghost:      #f4f6fc;
  --white:      #ffffff;
  --cobalt:     #2563eb;
  --cobalt-d:   #1d4ed8;
  --cobalt-l:   #3b82f6;
  --amber:      #f59e0b;
  --amber-d:    #d97706;
  --emerald:    #10b981;
  --rose:       #f43f5e;
  --violet:     #7c3aed;
  --cyan:       #06b6d4;

  --g-cobalt:   linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  --g-amber:    linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  --g-violet:   linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  --g-hero:     linear-gradient(160deg, #060d1f 0%, #0d1535 50%, #111d45 100%);
  --g-dark:     linear-gradient(145deg, #0a0f1e 0%, #141929 100%);

  --r-xl:       24px;
  --r-lg:       16px;
  --r-md:       12px;
  --r-sm:       8px;
  --r-pill:     999px;

  --nav-h:      72px;
  --ease:       cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring:cubic-bezier(0.34, 1.56, 0.64, 1);
  --t:          0.3s var(--ease);

  --font-head:  'Clash Display', sans-serif;
  --font-body:  'Plus Jakarta Sans', sans-serif;
  --font-mono:  'JetBrains Mono', monospace;

  --sh-cobalt:  0 8px 32px rgba(37,99,235,.28);
  --sh-amber:   0 8px 32px rgba(245,158,11,.28);
  --sh-card:    0 2px 12px rgba(10,15,30,.08), 0 1px 3px rgba(10,15,30,.06);
  --sh-card-h:  0 16px 48px rgba(10,15,30,.14), 0 4px 12px rgba(10,15,30,.08);
}

/* ══════════════════════════════════════════
   RESET & BASE
══════════════════════════════════════════ */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

body {
  font-family: var(--font-body);
  background: var(--ghost);
  color: var(--ink);
  overflow-x: hidden;
  font-size: 16px;
}

h1,h2,h3,h4,h5,h6 { font-family: var(--font-head); line-height: 1.15; letter-spacing: -0.4px; }

a { text-decoration: none; color: inherit; }

img { max-width: 100%; display: block; }

::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(--ink-2); }
::-webkit-scrollbar-thumb { background: var(--cobalt); border-radius: 4px; }

/* ══════════════════════════════════════════
   SCROLL PROGRESS
══════════════════════════════════════════ */
#scroll-progress {
  position: fixed; top:0; left:0; height: 3px; width:0%;
  background: linear-gradient(90deg, var(--cobalt), var(--amber));
  z-index: 9999; transition: width .1s linear;
  box-shadow: 0 0 12px rgba(37,99,235,.6);
}

/* ══════════════════════════════════════════
   NAVBAR
══════════════════════════════════════════ */
.navbar {
  position: fixed; top:0; left:0; right:0; z-index: 1040;
  height: var(--nav-h);
  background: rgba(255,255,255,.95);
  backdrop-filter: blur(24px) saturate(1.6);
  border-bottom: 1px solid rgba(10,15,30,.07);
  transition: var(--t);
}
.navbar.scrolled {
  background: rgba(255,255,255,.99);
  box-shadow: 0 1px 24px rgba(10,15,30,.1);
}
.nav-inner {
  max-width: 1280px; margin:0 auto; padding:0 24px;
  height: 100%; display:flex; align-items:center; justify-content:space-between; gap:16px;
}
.nav-brand {
  font-family: var(--font-head); font-size: 1.35rem; font-weight: 700;
  background: var(--g-cobalt); -webkit-background-clip:text; background-clip:text; color:transparent;
  flex-shrink: 0; letter-spacing: -0.5px;
}
.nav-brand em { font-style:normal; color: var(--amber); background:none; -webkit-background-clip:unset; background-clip:unset; }

.nav-links {
  display: flex; align-items:center; gap:4px; list-style:none; flex:1; justify-content:center;
}
.nav-links .nl-item { position: relative; }
.nav-links .nl-a {
  font-size: .84rem; font-weight: 600; color: var(--slate); padding: 8px 12px;
  border-radius: var(--r-md); transition: var(--t); white-space: nowrap; display:flex; align-items:center; gap:4px;
}
.nav-links .nl-a:hover, .nav-links .nl-a.active { color: var(--cobalt); background: rgba(37,99,235,.07); }
.nl-a .arrow { font-size: .6rem; transition: transform .3s; }
.nl-item:hover .arrow { transform: rotate(180deg); }

/* Mega dropdown */
.mega-drop {
  position: absolute; top: calc(100% + 8px); left:50%;
  transform: translateX(-50%) translateY(6px);
  min-width: 520px; background: #fff; border-radius: var(--r-xl);
  border: 1px solid rgba(10,15,30,.08);
  box-shadow: 0 24px 64px rgba(10,15,30,.14), 0 4px 16px rgba(10,15,30,.06);
  padding: 20px; opacity:0; visibility:hidden; pointer-events:none;
  transition: all .22s var(--ease);
}
.nl-item:hover .mega-drop {
  opacity:1; visibility:visible; pointer-events:auto; transform: translateX(-50%) translateY(0);
}
.mega-drop::before {
  content:''; position:absolute; top:-6px; left:50%;
  width:12px; height:12px; background:#fff;
  border-left:1px solid rgba(10,15,30,.08); border-top:1px solid rgba(10,15,30,.08);
  transform:translateX(-50%) rotate(45deg);
}
.mega-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:0; }
.mega-col-label {
  font-size:.67rem; font-weight:800; letter-spacing:1.6px; text-transform:uppercase;
  color:var(--cobalt); padding:0 8px 8px; display:block;
}
.mega-link {
  display:flex; align-items:center; gap:8px; padding:8px 10px;
  border-radius:var(--r-md); font-size:.82rem; font-weight:500; color:var(--slate);
  transition:all .18s;
}
.mega-link i { width:18px; color:var(--cobalt); font-size:.8rem; flex-shrink:0; }
.mega-link:hover { background:rgba(37,99,235,.07); color:var(--cobalt); transform:translateX(2px); }

.nav-cta { display:flex; align-items:center; gap:8px; flex-shrink:0; }

/* Hamburger */
.ham-btn {
  display:none; flex-direction:column; gap:5px; align-items:center; justify-content:center;
  width:40px; height:40px; background:none; border:none; cursor:pointer; border-radius:var(--r-md);
  transition:var(--t);
}
.ham-btn:hover { background:rgba(37,99,235,.07); }
.ham-line { display:block; width:22px; height:2px; background:var(--ink); border-radius:2px; transition:all .28s var(--ease); transform-origin:center; }
.ham-btn.open .ham-line:nth-child(1) { transform:translateY(7px) rotate(45deg); }
.ham-btn.open .ham-line:nth-child(2) { opacity:0; transform:scaleX(0); }
.ham-btn.open .ham-line:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }

/* Mobile panel */
.mob-overlay {
  display:none; position:fixed; inset:0; background:rgba(10,15,30,.5);
  backdrop-filter:blur(6px); z-index:1038; opacity:0; transition:opacity .3s;
}
.mob-overlay.open { opacity:1; }
.mob-panel {
  position:fixed; top:0; right:0; width:min(360px,90vw); height:100dvh;
  background:#fff; z-index:1039; overflow-y:auto;
  transform:translateX(100%); transition:transform .35s var(--ease);
  box-shadow:-12px 0 48px rgba(10,15,30,.18); display:flex; flex-direction:column;
}
.mob-panel.open { transform:translateX(0); }
.mob-head {
  display:flex; align-items:center; justify-content:space-between;
  padding:16px 20px; border-bottom:1px solid var(--mist); flex-shrink:0;
}
.mob-close {
  width:36px; height:36px; border:none; background:var(--mist); cursor:pointer;
  border-radius:var(--r-md); display:flex; align-items:center; justify-content:center; transition:var(--t);
}
.mob-close:hover { background:var(--rose); color:#fff; }
.mob-body { padding:12px 0; flex:1; }
.mob-link {
  display:flex; align-items:center; gap:10px; padding:12px 22px;
  font-size:.92rem; font-weight:600; color:var(--ink); transition:var(--t);
}
.mob-link i { width:20px; color:var(--cobalt); font-size:.85rem; }
.mob-link:hover { background:rgba(37,99,235,.06); color:var(--cobalt); padding-left:28px; }
.mob-sub-toggle {
  display:flex; align-items:center; justify-content:space-between;
  padding:12px 22px; font-size:.92rem; font-weight:600; color:var(--ink); cursor:pointer; transition:var(--t);
}
.mob-sub-toggle .left { display:flex; align-items:center; gap:10px; }
.mob-sub-toggle .left i { width:20px; color:var(--cobalt); font-size:.85rem; }
.mob-sub-toggle:hover { background:rgba(37,99,235,.06); color:var(--cobalt); }
.mob-sub-toggle .chev { font-size:.65rem; color:var(--slate); transition:transform .3s; }
.mob-sub-toggle.open .chev { transform:rotate(180deg); }
.mob-sub {
  background:rgba(37,99,235,.03); border-top:1px solid rgba(37,99,235,.08); border-bottom:1px solid rgba(37,99,235,.08);
  max-height:0; overflow:hidden; transition:max-height .35s;
}
.mob-sub.open { max-height:600px; }
.mob-sub a {
  display:flex; align-items:center; gap:8px; padding:9px 22px 9px 52px;
  font-size:.83rem; color:var(--slate); transition:var(--t);
}
.mob-sub a i { width:16px; color:var(--cobalt); font-size:.76rem; }
.mob-sub a:hover { color:var(--cobalt); padding-left:58px; }
.mob-hr { border:none; border-top:1px solid var(--mist); margin:8px 20px; }
.mob-footer { padding:16px 20px 28px; border-top:1px solid var(--mist); display:flex; flex-direction:column; gap:10px; }

/* Dark mode for mobile panel */
body.dark .mob-panel, body.dark .mob-head { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .mob-link, body.dark .mob-sub-toggle { color:rgba(255,255,255,.85); }
body.dark .mob-link:hover, body.dark .mob-sub-toggle:hover { background:rgba(37,99,235,.12); color:var(--cobalt-l); }
body.dark .mob-sub { background:rgba(255,255,255,.02); border-color:rgba(255,255,255,.06); }
body.dark .mob-sub a { color:rgba(255,255,255,.55); }
body.dark .mob-sub a:hover { color:var(--cobalt-l); }
body.dark .mob-hr { border-color:rgba(255,255,255,.08); }
body.dark .mob-footer { border-color:rgba(255,255,255,.08); }
body.dark .mob-close { background:rgba(255,255,255,.08); color:rgba(255,255,255,.8); }

/* ══════════════════════════════════════════
   BUTTONS
══════════════════════════════════════════ */
.btn-primary {
  display:inline-flex; align-items:center; gap:6px;
  background:var(--g-cobalt); color:#fff; border:none; cursor:pointer;
  padding:12px 26px; border-radius:var(--r-pill); font-weight:700; font-size:.88rem;
  font-family:var(--font-head); transition:var(--t); box-shadow:var(--sh-cobalt);
  white-space:nowrap;
}
.btn-primary:hover { transform:translateY(-2px); box-shadow:0 14px 40px rgba(37,99,235,.38); }
.btn-primary:active { transform:translateY(0); }

.btn-outline {
  display:inline-flex; align-items:center; gap:6px;
  background:transparent; color:var(--cobalt); border:2px solid var(--cobalt);
  padding:10px 24px; border-radius:var(--r-pill); font-weight:700; font-size:.88rem;
  font-family:var(--font-head); transition:var(--t); cursor:pointer; white-space:nowrap;
}
.btn-outline:hover { background:var(--g-cobalt); color:#fff; transform:translateY(-2px); box-shadow:var(--sh-cobalt); }

.btn-ghost-white {
  display:inline-flex; align-items:center; gap:6px;
  background:rgba(255,255,255,.1); color:#fff; border:1.5px solid rgba(255,255,255,.35);
  padding:11px 24px; border-radius:var(--r-pill); font-weight:700; font-size:.88rem;
  font-family:var(--font-head); transition:var(--t); cursor:pointer; white-space:nowrap;
  backdrop-filter:blur(8px);
}
.btn-ghost-white:hover { background:rgba(255,255,255,.2); border-color:rgba(255,255,255,.6); transform:translateY(-2px); }

.btn-wa {
  display:inline-flex; align-items:center; gap:8px;
  background:linear-gradient(135deg,#25D366,#1aad54); color:#fff; border:none;
  padding:12px 24px; border-radius:var(--r-pill); font-weight:700; font-size:.88rem;
  font-family:var(--font-head); transition:var(--t); cursor:pointer; white-space:nowrap;
  box-shadow:0 6px 20px rgba(37,211,102,.3);
}
.btn-wa:hover { transform:translateY(-2px); box-shadow:0 12px 32px rgba(37,211,102,.45); }

.btn-amber {
  display:inline-flex; align-items:center; gap:6px;
  background:var(--g-amber); color:#fff; border:none; cursor:pointer;
  padding:12px 26px; border-radius:var(--r-pill); font-weight:700; font-size:.88rem;
  font-family:var(--font-head); transition:var(--t); box-shadow:var(--sh-amber);
  white-space:nowrap;
}
.btn-amber:hover { transform:translateY(-2px); box-shadow:0 14px 40px rgba(245,158,11,.4); }

.btn-pdf {
  display:inline-flex; align-items:center; gap:8px;
  background:linear-gradient(135deg,#ef4444,#dc2626); color:#fff; border:none;
  padding:14px 32px; border-radius:var(--r-pill); font-weight:700; font-size:.92rem;
  font-family:var(--font-head); transition:var(--t); cursor:pointer;
  box-shadow:0 6px 24px rgba(239,68,68,.3);
}
.btn-pdf:hover { transform:translateY(-2px); box-shadow:0 12px 36px rgba(239,68,68,.4); }

/* Nav-specific buttons */
.btn-nav-signin {
  display:inline-flex; align-items:center; gap:6px;
  font-size:.82rem; font-weight:700; color:var(--cobalt);
  padding:8px 18px; border:2px solid var(--cobalt); border-radius:var(--r-pill);
  font-family:var(--font-head); transition:var(--t); background:transparent; cursor:pointer;
}
.btn-nav-signin:hover { background:var(--g-cobalt); color:#fff; }

.btn-nav-signup {
  display:inline-flex; align-items:center; gap:6px;
  font-size:.82rem; font-weight:700; color:#fff;
  padding:8px 18px; border:none; border-radius:var(--r-pill);
  font-family:var(--font-head); transition:var(--t); background:var(--g-cobalt); cursor:pointer;
  box-shadow:var(--sh-cobalt);
}
.btn-nav-signup:hover { background:var(--g-amber); box-shadow:var(--sh-amber); transform:translateY(-1px); }

.btn-nav-start {
  display:inline-flex; align-items:center; gap:6px;
  font-size:.82rem; font-weight:700; color:#fff;
  padding:9px 20px; border:none; border-radius:var(--r-pill);
  font-family:var(--font-head); transition:var(--t);
  background:linear-gradient(135deg,var(--amber),var(--amber-d)); cursor:pointer;
  box-shadow:var(--sh-amber);
}
.btn-nav-start:hover { transform:translateY(-1px); box-shadow:0 12px 32px rgba(245,158,11,.4); }

/* ══════════════════════════════════════════
   DARK MODE
══════════════════════════════════════════ */
body.dark { background:var(--ink); color:rgba(255,255,255,.87); }
body.dark .navbar { background:rgba(10,15,30,.97); border-bottom-color:rgba(255,255,255,.06); }
body.dark .navbar.scrolled { background:rgba(10,15,30,.99); }
body.dark .nav-links .nl-a { color:rgba(255,255,255,.65); }
body.dark .nav-links .nl-a:hover, body.dark .nav-links .nl-a.active { color:var(--cobalt-l); background:rgba(37,99,235,.1); }
body.dark .mega-drop { background:var(--ink-2); border-color:rgba(255,255,255,.08); }
body.dark .mega-drop::before { background:var(--ink-2); border-color:rgba(255,255,255,.08); }
body.dark .mega-link { color:rgba(255,255,255,.65); }
body.dark .mega-link:hover { background:rgba(37,99,235,.12); color:var(--cobalt-l); }
body.dark .ham-line { background:rgba(255,255,255,.85); }
body.dark .card-white { background:var(--ink-2) !important; border-color:rgba(255,255,255,.07) !important; }
body.dark .text-dark { color:rgba(255,255,255,.87) !important; }
body.dark .text-muted { color:rgba(255,255,255,.45) !important; }
body.dark .bg-ghost { background:var(--ink-2) !important; }
body.dark .bg-white-section { background:var(--ink-3) !important; }
body.dark .tech-pill { background:var(--ink-2); border-color:rgba(255,255,255,.1); color:rgba(255,255,255,.78); }
body.dark .faq-item { background:var(--ink-2); border-color:rgba(255,255,255,.08); }
body.dark .faq-q { color:rgba(255,255,255,.87); }
body.dark .process-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .newsletter-box { background:var(--ink-2); border-color:rgba(255,255,255,.08); }
body.dark .nl-form-inp { background:var(--ink-3); border-color:rgba(255,255,255,.1); color:#fff; }
body.dark .nl-form-inp::placeholder { color:rgba(255,255,255,.35); }
body.dark .trust-strip { background:var(--ink-2); border-color:rgba(255,255,255,.06); }
body.dark .stat-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .testimonial-card { background:var(--ink-2); border-color:rgba(255,255,255,.08); }
body.dark .pricing-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .pricing-card.featured { background:var(--ink); }
body.dark .portfolio-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .team-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .blog-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .service-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .service-card .svc-overlay { background:rgba(10,15,30,.95); }
body.dark .btn-nav-signin { color:var(--cobalt-l); border-color:var(--cobalt-l); }
body.dark #theme-toggle { background:var(--ink-2); border-color:rgba(255,255,255,.12); }
body.dark #theme-toggle svg { stroke:rgba(255,255,255,.8); }
body.dark #theme-toggle:hover { background:var(--amber); border-color:var(--amber); }
body.dark footer { background:var(--ink-2); }
body.dark .footer-div { border-color:rgba(255,255,255,.08); }

/* ══════════════════════════════════════════
   UTILITIES
══════════════════════════════════════════ */
.container { max-width:1280px; margin:0 auto; padding:0 24px; }
.section-py { padding:80px 0; }
.section-py-sm { padding:56px 0; }
.text-center { text-align:center; }
.text-muted { color:var(--slate); }
.row { display:grid; }
.g-cobalt { background:var(--g-cobalt); -webkit-background-clip:text; background-clip:text; color:transparent; }
.g-amber  { background:var(--g-amber);  -webkit-background-clip:text; background-clip:text; color:transparent; }
.g-violet { background:var(--g-violet); -webkit-background-clip:text; background-clip:text; color:transparent; }

.section-tag {
  display:inline-block; background:rgba(37,99,235,.1); color:var(--cobalt);
  border-radius:var(--r-pill); padding:4px 14px;
  font-size:.68rem; font-weight:800; letter-spacing:1.8px; text-transform:uppercase; margin-bottom:10px;
}
.section-title { font-size:clamp(1.75rem,4.5vw,3.2rem); font-weight:700; margin-bottom:14px; }
.section-sub { color:var(--slate); font-size:clamp(.88rem,2vw,1.05rem); line-height:1.7; max-width:560px; }

/* Float animations */
@keyframes float-a { 0%,100%{transform:translateY(0)}  50%{transform:translateY(-12px)} }
@keyframes float-b { 0%,100%{transform:translateY(0)}  50%{transform:translateY(-16px)} }
@keyframes float-c { 0%,100%{transform:translateY(0)}  50%{transform:translateY(-10px)} }
@keyframes blink    { 0%,100%{opacity:1} 50%{opacity:0} }
@keyframes marquee  { from{transform:translateX(0)} to{transform:translateX(-50%)} }
@keyframes pulse-dot{ 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.3)} }
@keyframes wa-ring  { 0%{inset:-2px;opacity:.7} 100%{inset:-14px;opacity:0} }
@keyframes dot-flash{ 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.4);opacity:.5} }
@keyframes si-dot   { 0%{transform:translateY(0);opacity:1} 60%{transform:translateY(14px);opacity:.2} 61%{transform:translateY(0);opacity:0} 62%{opacity:1} 100%{opacity:1} }

.fa { display:inline-block; } /* ensure icons show */

/* ══════════════════════════════════════════
   FIXED WIDGETS
══════════════════════════════════════════ */
#theme-toggle {
  position:fixed; bottom:24px; left:24px; z-index:10000;
  width:46px; height:46px; background:#fff; border:1.5px solid rgba(10,15,30,.1);
  border-radius:50%; display:flex; align-items:center; justify-content:center;
  cursor:pointer; box-shadow:0 4px 20px rgba(10,15,30,.12); transition:var(--t);
}
#theme-toggle svg { width:18px; height:18px; stroke:var(--slate); stroke-width:1.8; fill:none; stroke-linecap:round; stroke-linejoin:round; display:block; transition:stroke .2s; }
#theme-toggle:hover { background:var(--cobalt); border-color:var(--cobalt); transform:rotate(25deg) scale(1.08); box-shadow:0 8px 28px rgba(37,99,235,.35); }
#theme-toggle:hover svg { stroke:#fff; }

#back-to-top {
  position:fixed; bottom:24px; right:24px; z-index:10000;
  width:46px; height:46px; background:var(--g-cobalt); border:none;
  border-radius:50%; display:flex; align-items:center; justify-content:center;
  cursor:pointer; opacity:0; transform:translateY(16px); pointer-events:none;
  transition:opacity .3s, transform .4s var(--ease-spring), box-shadow .3s;
  box-shadow:var(--sh-cobalt);
}
#back-to-top svg { width:18px; height:18px; stroke:#fff; stroke-width:2.4; fill:none; stroke-linecap:round; stroke-linejoin:round; }
#back-to-top.visible { opacity:1; transform:translateY(0); pointer-events:auto; }
#back-to-top:hover { transform:translateY(-4px) scale(1.08); box-shadow:0 16px 40px rgba(37,99,235,.5); }

/* WhatsApp float */
#wa-float {
  position:fixed; bottom:88px; right:24px; z-index:10001;
  display:flex; align-items:center; gap:10px;
  background:#128C7E; border-radius:var(--r-pill);
  padding:10px 18px 10px 10px; text-decoration:none;
  box-shadow:0 6px 28px rgba(18,140,126,.42);
  transition:transform .35s var(--ease-spring), box-shadow .3s; max-width:220px;
}
#wa-float:hover { transform:translateY(-4px) scale(1.03); box-shadow:0 16px 44px rgba(18,140,126,.58); }
.wa-circle {
  width:38px; height:38px; flex-shrink:0; background:#25D366; border-radius:50%;
  display:flex; align-items:center; justify-content:center; font-size:1.2rem; color:#fff; position:relative;
}
.wa-circle::after {
  content:''; position:absolute; inset:-2px; border-radius:50%;
  border:2px solid #25D366; opacity:0; animation:wa-ring 2.4s ease-out infinite;
}
.wa-online {
  position:absolute; top:1px; right:1px; width:10px; height:10px;
  background:#a8ff78; border:2px solid #128C7E; border-radius:50%; animation:dot-flash 2.5s ease-in-out infinite;
}
.wa-text { display:flex; flex-direction:column; line-height:1.25; overflow:hidden; }
.wa-text .wa-top { font-size:9px; color:rgba(255,255,255,.7); font-weight:600; letter-spacing:.3px; white-space:nowrap; }
.wa-text .wa-main { font-size:13px; color:#fff; font-weight:700; white-space:nowrap; font-family:var(--font-head); }

/* Scroll indicator */
#scroll-ind {
  position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:5px;
  cursor:pointer; z-index:100; opacity:1; transition:opacity .5s, transform .5s;
}
#scroll-ind.hidden { opacity:0; transform:translateX(-50%) translateY(10px); pointer-events:none; }
.si-pill { width:24px; height:40px; border:1.5px solid rgba(255,255,255,.35); border-radius:12px; display:flex; align-items:flex-start; justify-content:center; padding-top:5px; }
.si-dot  { width:4px; height:8px; background:#fff; border-radius:2px; animation:si-dot 1.8s ease-in-out infinite; }
.si-label{ font-size:9px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,.5); }

/* Toast */
#toast {
  position:fixed; bottom:90px; right:24px; background:var(--ink-2); color:#fff;
  border-radius:var(--r-lg); padding:14px 20px; font-size:.85rem;
  display:flex; align-items:center; gap:10px; z-index:10002;
  opacity:0; transform:translateY(10px); transition:var(--t);
  border-left:3px solid var(--emerald); min-width:240px;
}
#toast.show { opacity:1; transform:translateY(0); }

/* Cookie */
#cookie-bar {
  position:fixed; bottom:0; left:0; right:0; background:var(--ink-2); color:rgba(255,255,255,.85);
  padding:14px 24px; display:flex; align-items:center; justify-content:space-between; gap:16px;
  z-index:9998; transform:translateY(100%); transition:transform .4s; border-top:1px solid rgba(255,255,255,.07);
}
#cookie-bar.show { transform:translateY(0); }
#cookie-bar p { font-size:.82rem; margin:0; }
#cookie-accept { background:var(--cobalt); color:#fff; border:none; padding:8px 22px; border-radius:var(--r-pill); font-size:.82rem; cursor:pointer; font-family:var(--font-head); font-weight:700; transition:var(--t); }
#cookie-accept:hover { background:var(--cobalt-d); }

/* ══════════════════════════════════════════
   HERO
══════════════════════════════════════════ */
.hero {
  min-height:100vh; padding-top:var(--nav-h);
  background:var(--g-hero); position:relative; overflow:hidden;
  display:flex; align-items:center;
}
.hero-grid {
  position:absolute; inset:0; pointer-events:none;
  background-image:linear-gradient(rgba(37,99,235,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.07) 1px,transparent 1px);
  background-size:52px 52px;
}
.hero-glow-1 { position:absolute; width:700px; height:700px; border-radius:50%; background:radial-gradient(circle,rgba(37,99,235,.18) 0%,transparent 70%); top:-180px; right:-120px; pointer-events:none; }
.hero-glow-2 { position:absolute; width:500px; height:500px; border-radius:50%; background:radial-gradient(circle,rgba(245,158,11,.12) 0%,transparent 70%); bottom:-80px; left:60px; pointer-events:none; }
.hero-glow-3 { position:absolute; width:400px; height:400px; border-radius:50%; background:radial-gradient(circle,rgba(124,58,237,.1) 0%,transparent 70%); top:50%; left:45%; transform:translate(-50%,-50%); pointer-events:none; }

.hero-inner {
  position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr;
  gap:48px; align-items:center; padding:60px 0;
}
.hero-badge {
  display:inline-flex; align-items:center; gap:8px;
  background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.15);
  border-radius:var(--r-pill); padding:6px 16px; color:rgba(255,255,255,.8);
  font-size:.8rem; font-weight:600; margin-bottom:20px; backdrop-filter:blur(8px);
}
.hero-badge .dot { width:7px; height:7px; border-radius:50%; background:var(--emerald); animation:pulse-dot 2s infinite; }
.hero h1 { font-size:clamp(2rem,5vw,4.8rem); font-weight:700; color:#fff; line-height:1.08; margin-bottom:20px; }
.hero h1 .accent { color:var(--amber); }
.hero-sub { color:rgba(255,255,255,.65); font-size:clamp(.9rem,2vw,1.1rem); line-height:1.75; max-width:480px; margin-bottom:28px; }
.hero-pills { display:flex; gap:12px; flex-wrap:wrap; margin-top:20px; font-size:.8rem; color:rgba(255,255,255,.6); }
.hero-pills span { display:flex; align-items:center; gap:6px; }

/* Code block */
.code-box {
  background:rgba(10,15,30,.88); border:1px solid rgba(37,99,235,.3);
  border-radius:var(--r-xl); padding:24px 28px; font-family:var(--font-mono);
  font-size:.8rem; line-height:1.85; position:relative; backdrop-filter:blur(12px);
  animation:float-a 5s ease-in-out infinite;
}
.code-box::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg,var(--cobalt),var(--amber),var(--violet)); border-radius:var(--r-xl) var(--r-xl) 0 0; }
.code-dots { display:flex; gap:6px; margin-bottom:16px; }
.code-dots span { width:10px; height:10px; border-radius:50%; }
.code-dots span:nth-child(1){background:#ef4444;}
.code-dots span:nth-child(2){background:var(--amber);}
.code-dots span:nth-child(3){background:var(--emerald);}
.kw  { color:#818cf8; } .fn  { color:#34d399; } .str { color:#fb923c; } .cm  { color:#475569; }
.cursor { display:inline-block; width:2px; height:1em; background:var(--cobalt); animation:blink 1s step-end infinite; vertical-align:text-bottom; margin-left:2px; }

.hero-chips { display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; }
.chip {
  padding:7px 16px; border-radius:var(--r-pill); font-size:.76rem; font-weight:700;
  backdrop-filter:blur(8px);
}
.chip-green { background:rgba(16,185,129,.15); border:1px solid rgba(16,185,129,.3); color:#6ee7b7; }
.chip-amber { background:rgba(245,158,11,.15); border:1px solid rgba(245,158,11,.3); color:#fcd34d; }

/* ══════════════════════════════════════════
   MARQUEE
══════════════════════════════════════════ */
.marquee-wrap { background:var(--cobalt); padding:11px 0; overflow:hidden; white-space:nowrap; }
.marquee-track { display:inline-flex; animation:marquee 28s linear infinite; }
.marquee-track:hover { animation-play-state:paused; }
.marquee-item { display:inline-flex; align-items:center; gap:8px; padding:0 28px; color:#fff; font-size:.88rem; font-weight:600; opacity:.92; }
.marquee-sep { opacity:.35; }

/* ══════════════════════════════════════════
   TRUST STRIP
══════════════════════════════════════════ */
.trust-strip {
  background:#fff; border-top:1px solid var(--mist); border-bottom:1px solid var(--mist); padding:18px 0;
}
.trust-inner { display:flex; flex-wrap:wrap; justify-content:center; gap:28px; }
.trust-item { display:flex; align-items:center; gap:8px; font-size:.82rem; font-weight:700; color:var(--ink); }
.trust-item i { font-size:1rem; }

/* ══════════════════════════════════════════
   SERVICES
══════════════════════════════════════════ */
.services-grid {
  display:grid; grid-template-columns:repeat(4,1fr); gap:20px;
}
.service-card {
  background:#fff; border-radius:var(--r-xl); border:1px solid var(--mist);
  overflow:hidden; position:relative; transition:var(--t); cursor:pointer;
  display:block; text-decoration:none; color:inherit;
}
.service-card:hover { transform:translateY(-8px); box-shadow:var(--sh-card-h); border-color:rgba(37,99,235,.2); }
.svc-img-wrap { height:150px; overflow:hidden; position:relative; }
.svc-img { width:100%; height:100%; object-fit:cover; transition:transform .55s; }
.service-card:hover .svc-img { transform:scale(1.08); }
.service-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:3px;
  background:linear-gradient(90deg,var(--cobalt),var(--amber),var(--violet));
  transform:scaleX(0); transform-origin:left; transition:transform .4s; z-index:3;
}
.service-card:hover::before { transform:scaleX(1); }
/* Overlay */
.svc-overlay {
  position:absolute; inset:0; background:rgba(255,255,255,.96);
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:8px; opacity:0; transition:opacity .3s; z-index:2; text-align:center; padding:18px;
  backdrop-filter:blur(6px);
}
.service-card:hover .svc-overlay { opacity:1; }
.svc-ov-icon { width:50px; height:50px; background:var(--g-cobalt); border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.2rem; transform:scale(.8); transition:transform .35s var(--ease-spring) .04s; }
.service-card:hover .svc-ov-icon { transform:scale(1); }
.svc-ov-title { font-family:var(--font-head); font-weight:700; font-size:.9rem; color:var(--cobalt); transform:translateY(6px); transition:transform .3s .06s; }
.svc-ov-sub { font-size:.72rem; color:var(--slate); transform:translateY(6px); transition:transform .3s .1s; }
.service-card:hover .svc-ov-title, .service-card:hover .svc-ov-sub { transform:translateY(0); }
.svc-ov-btn { display:inline-flex; align-items:center; gap:5px; background:var(--g-cobalt); color:#fff; padding:6px 16px; border-radius:var(--r-pill); font-size:.75rem; font-weight:700; transform:translateY(6px); transition:transform .3s .13s; }
.service-card:hover .svc-ov-btn { transform:translateY(0); }
/* Card body */
.svc-icon-wrap {
  position:relative; z-index:2; margin:-24px 0 12px 18px; width:50px; height:50px;
  background:#fff; border-radius:25px; display:flex; align-items:center; justify-content:center;
  box-shadow:0 4px 14px rgba(10,15,30,.1); border:1px solid var(--mist);
}
.svc-body { padding:0 18px 18px; }
.svc-body h3 { font-size:1.05rem; font-weight:700; margin-bottom:6px; }
.svc-body p { font-size:.82rem; color:var(--slate); line-height:1.55; margin-bottom:12px; }
.svc-pill {
  display:inline-flex; align-items:center; gap:4px; font-size:.68rem; font-weight:800;
  color:var(--cobalt); background:rgba(37,99,235,.08); padding:4px 12px; border-radius:var(--r-pill);
  transition:var(--t);
}
.service-card:hover .svc-pill { background:var(--cobalt); color:#fff; }

/* ══════════════════════════════════════════
   STATS
══════════════════════════════════════════ */
.stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
.stat-card {
  background:#fff; border-radius:var(--r-xl); padding:28px 20px; text-align:center;
  border:1px solid var(--mist); transition:var(--t);
}
.stat-card:hover { transform:translateY(-6px); box-shadow:var(--sh-card-h); }
.stat-num { font-family:var(--font-head); font-size:clamp(2rem,4vw,3.2rem); font-weight:800; }
.stat-label { font-size:.82rem; color:var(--slate); margin-top:4px; }

/* ══════════════════════════════════════════
   PROCESS
══════════════════════════════════════════ */
.process-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
.process-card {
  background:#fff; border-radius:var(--r-xl); padding:28px 22px;
  border:1px solid var(--mist); transition:var(--t); position:relative;
}
.process-card:hover { transform:translateY(-6px); box-shadow:var(--sh-card-h); }
.process-num {
  font-family:var(--font-head); font-size:3rem; font-weight:800;
  background:var(--g-cobalt); -webkit-background-clip:text; background-clip:text; color:transparent;
  line-height:1; margin-bottom:12px;
}
.process-card h4 { font-size:1.05rem; font-weight:700; margin-bottom:8px; }
.process-card p { font-size:.83rem; color:var(--slate); line-height:1.6; }
.process-arrow {
  position:absolute; top:50%; right:-14px; transform:translateY(-50%);
  width:28px; height:28px; background:var(--cobalt); border-radius:50%;
  display:flex; align-items:center; justify-content:center; color:#fff; font-size:.7rem; z-index:2;
}

/* ══════════════════════════════════════════
   GRAPHIC DESIGN
══════════════════════════════════════════ */
.graphic-section {
  background:var(--g-dark); position:relative; overflow:hidden;
}
.graphic-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
.graphic-card {
  background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.09);
  border-radius:var(--r-xl); padding:26px 16px; text-align:center; color:#fff;
  transition:var(--t); cursor:pointer;
}
.graphic-card:hover { background:rgba(255,255,255,.1); border-color:rgba(255,255,255,.2); transform:translateY(-6px); }
.graphic-icon { font-size:2rem; margin-bottom:10px; display:block; }
.graphic-card h4 { font-size:.95rem; font-weight:700; margin-bottom:4px; }
.graphic-card p { font-size:.76rem; color:rgba(255,255,255,.55); margin-bottom:10px; }
.graphic-price {
  display:inline-block; background:rgba(245,158,11,.2); color:var(--amber);
  border-radius:var(--r-pill); padding:3px 12px; font-size:.68rem; font-weight:800;
}

/* ══════════════════════════════════════════
   TECH STACK
══════════════════════════════════════════ */
.tech-wrap { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; }
.tech-pill {
  display:inline-flex; align-items:center; gap:8px;
  background:#fff; border:1px solid var(--mist); border-radius:var(--r-md);
  padding:9px 16px; font-size:.83rem; font-weight:700; color:var(--ink);
  transition:var(--t); white-space:nowrap;
}
.tech-pill:hover { border-color:var(--cobalt); color:var(--cobalt); transform:translateY(-3px); box-shadow:0 8px 20px rgba(37,99,235,.12); }

/* ══════════════════════════════════════════
   PORTFOLIO
══════════════════════════════════════════ */
.portfolio-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
.portfolio-card {
  background:#fff; border-radius:var(--r-xl); overflow:hidden;
  border:1px solid var(--mist); transition:var(--t);
}
.portfolio-card:hover { transform:translateY(-8px); box-shadow:var(--sh-card-h); }
.port-img-wrap { position:relative; overflow:hidden; height:200px; }
.port-img { width:100%; height:100%; object-fit:cover; transition:transform .5s; }
.portfolio-card:hover .port-img { transform:scale(1.07); }
.port-overlay {
  position:absolute; inset:0; background:rgba(37,99,235,.82);
  display:flex; align-items:center; justify-content:center;
  opacity:0; transition:opacity .3s;
}
.portfolio-card:hover .port-overlay { opacity:1; }
.port-overlay i { color:#fff; font-size:1.8rem; transform:scale(.8); transition:transform .3s; }
.portfolio-card:hover .port-overlay i { transform:scale(1); }
.port-body { padding:18px; }
.port-tag {
  display:inline-block; font-size:.66rem; font-weight:800; padding:3px 12px;
  border-radius:var(--r-pill); background:rgba(37,99,235,.1); color:var(--cobalt);
  text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;
}
.port-body h4 { font-size:1.05rem; font-weight:700; margin-bottom:6px; }
.port-body .desc { font-size:.83rem; color:var(--slate); line-height:1.55; margin-bottom:10px; }
.port-techs { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px; }
.tech-sm { background:rgba(37,99,235,.09); color:var(--cobalt); padding:3px 10px; border-radius:var(--r-pill); font-size:.67rem; font-weight:700; }
.port-filter-row { display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-bottom:28px; }
.pf-btn {
  padding:7px 20px; border-radius:var(--r-pill); font-size:.8rem; font-weight:700; cursor:pointer;
  border:2px solid var(--cobalt); color:var(--cobalt); background:transparent;
  font-family:var(--font-head); transition:var(--t);
}
.pf-btn.active, .pf-btn:hover { background:var(--g-cobalt); color:#fff; border-color:transparent; }

/* ══════════════════════════════════════════
   TEAM
══════════════════════════════════════════ */
.team-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
.team-card {
  background:#fff; border-radius:var(--r-xl); padding:28px 20px; text-align:center;
  border:1px solid var(--mist); transition:var(--t);
}
.team-card:hover { transform:translateY(-8px); box-shadow:var(--sh-card-h); }
.team-avatar { width:100px; height:100px; border-radius:50%; overflow:hidden; margin:0 auto 14px; background:var(--mist); position:relative; }
.team-avatar img { width:100%; height:100%; object-fit:cover; transition:transform .35s; }
.team-card:hover .team-avatar img { transform:scale(1.08); }
.team-avatar-fb { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:2.5rem; color:var(--cobalt); }
.team-card h5 { font-size:1rem; font-weight:700; margin-bottom:2px; }
.team-role { font-size:.75rem; color:var(--slate); margin-bottom:8px; }
.team-bio { font-size:.8rem; color:var(--slate); line-height:1.55; margin-bottom:12px; }
.team-socials { display:flex; justify-content:center; gap:8px; }
.team-socials a {
  width:30px; height:30px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center;
  background:rgba(37,99,235,.07); color:var(--cobalt); font-size:.85rem; transition:var(--t);
}
.team-socials a:hover { background:var(--cobalt); color:#fff; transform:translateY(-2px); }

/* ══════════════════════════════════════════
   PRICING
══════════════════════════════════════════ */
.pricing-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; align-items:start; }
.pricing-card {
  background:#fff; border-radius:var(--r-xl); padding:28px 22px;
  border:1px solid var(--mist); transition:var(--t); position:relative; display:flex; flex-direction:column;
}
.pricing-card:not(.featured):hover { transform:translateY(-6px); box-shadow:var(--sh-card-h); }
.pricing-card.featured {
  background:var(--ink); color:#fff; border:none;
  box-shadow:0 24px 64px rgba(10,15,30,.35); transform:scale(1.03); z-index:1;
}
