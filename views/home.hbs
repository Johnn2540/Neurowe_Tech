/* PORTFOLIO GRID */
.port-grid{display:grid;grid-template-columns:1fr;gap:20px}
.port-card{display:flex;flex-direction:column;background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);overflow:hidden;transition:var(--t);text-decoration:none;color:inherit}
.port-card:hover{transform:translateY(-6px);box-shadow:var(--sh-lg);border-color:rgba(37,99,235,.15)}
.port-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--primary),var(--blue),var(--accent));transform:scaleX(0);transform-origin:left;transition:transform .38s;z-index:3}
.port-card:hover::before{transform:scaleX(1)}
.port-thumb{position:relative;width:100%;height:190px;overflow:hidden;background:var(--surface);flex-shrink:0}
.port-img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.port-card:hover .port-img{transform:scale(1.06)}
.port-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2.4rem;background:linear-gradient(135deg,var(--blue-pale),rgba(224,92,42,.06));color:var(--slate)}
.port-overlay{position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(6,9,26,.88) 100%);display:flex;align-items:flex-end;padding:16px;opacity:0;transition:opacity .3s}
.port-card:hover .port-overlay{opacity:1}
.port-ov-cat{display:inline-block;background:rgba(37,99,235,.4);color:rgba(147,197,253,.95);border-radius:var(--r-pill);padding:2px 10px;font-size:.64rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;margin-bottom:4px}
.port-ov-name{font-family:var(--font-body);font-size:.95rem;font-weight:700;color:#fff}
.port-body{padding:14px 18px 16px;position:relative}
.port-cat{font-size:.67rem;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.9px;margin-bottom:5px}
.port-name{font-family:var(--font-body);font-size:.95rem;font-weight:700;color:var(--ink);margin-bottom:8px;line-height:1.35}
.port-link{font-size:.78rem;font-weight:700;color:var(--blue);display:inline-flex;align-items:center;gap:5px;transition:gap .18s}
.port-card:hover .port-link{gap:9px}

/* BLOG GRID */
.blog-grid{display:grid;grid-template-columns:1fr;gap:20px}
.blog-card{display:flex;flex-direction:column;background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);overflow:hidden;transition:var(--t);text-decoration:none;color:inherit}
.blog-card:hover{transform:translateY(-6px);box-shadow:var(--sh-lg);border-color:rgba(37,99,235,.15)}
.blog-thumb{width:100%;height:174px;overflow:hidden;background:var(--surface);flex-shrink:0}
.blog-thumb img{width:100%;height:100%;object-fit:cover;transition:transform .45s}
.blog-card:hover .blog-thumb img{transform:scale(1.05)}
.blog-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2.2rem;background:linear-gradient(135deg,var(--blue-pale),rgba(224,92,42,.06));color:var(--slate)}
.blog-body{padding:16px 18px 18px;flex:1;display:flex;flex-direction:column;gap:6px}
.blog-cat{font-size:.67rem;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.9px}
.blog-title{font-family:var(--font-body);font-size:.97rem;font-weight:700;color:var(--ink);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.blog-excerpt{font-size:.8rem;color:var(--slate);line-height:1.65;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.blog-meta{display:flex;align-items:center;justify-content:space-between;font-size:.72rem;color:var(--slate-l);gap:8px}
.blog-meta i{font-size:.64rem}
.blog-read{margin-top:4px;font-size:.79rem;font-weight:700;color:var(--blue);display:inline-flex;align-items:center;gap:5px;transition:gap .18s}
.blog-card:hover .blog-read{gap:9px}
@media(min-width:600px){.blog-grid{grid-template-columns:repeat(2,1fr)}.port-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:992px){.blog-grid{grid-template-columns:repeat(3,1fr)}.port-grid{grid-template-columns:repeat(3,1fr)}}
