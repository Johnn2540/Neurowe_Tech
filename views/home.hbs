<style>
/* ══════════════════════════════════════════
   DESIGN TOKENS
══════════════════════════════════════════ */
:root {
  --ink:        #06080f;
  --ink-2:      #0d1120;
  --ink-3:      #151b30;
  --mid:        #1f2a4a;
  --slate:      #5c6b8a;
  --mist:       #e4e9f4;
  --ghost:      #f5f7fc;
  --white:      #ffffff;

  /* Brand palette — deep navy + electric blue + gold accent */
  --primary:    #1a56e8;
  --primary-d:  #1341c4;
  --primary-l:  #4f7df5;
  --gold:       #e8a020;
  --gold-d:     #c47f10;
  --gold-l:     #f5be55;
  --emerald:    #0dbf7e;
  --rose:       #f03d5f;
  --violet:     #6c3df5;
  --cyan:       #06c0d9;
  --teal:       #00b09c;

  /* Learn button — distinct teal-to-emerald */
  --learn:      #00b09c;
  --learn-d:    #009182;

  --g-primary:  linear-gradient(135deg, #1a56e8 0%, #1341c4 100%);
  --g-gold:     linear-gradient(135deg, #e8a020 0%, #c47f10 100%);
  --g-violet:   linear-gradient(135deg, #6c3df5 0%, #4c22d4 100%);
  --g-hero:     linear-gradient(158deg, #040810 0%, #080f20 45%, #0c1530 100%);
  --g-dark:     linear-gradient(145deg, #06080f 0%, #0d1120 100%);
  --g-learn:    linear-gradient(135deg, #00b09c 0%, #009182 100%);
  --g-teal:     linear-gradient(135deg, #00b09c, #06c0d9);
  --g-mesh:     radial-gradient(ellipse at 20% 50%, rgba(26,86,232,.18) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 20%, rgba(232,160,32,.10) 0%, transparent 55%),
                radial-gradient(ellipse at 60% 80%, rgba(108,61,245,.12) 0%, transparent 50%);

  --r-xl:       20px;
  --r-lg:       14px;
  --r-md:       10px;
  --r-sm:       6px;
  --r-pill:     999px;

  --nav-h:      70px;
  --ease:       cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring:cubic-bezier(0.34, 1.56, 0.64, 1);
  --t:          0.28s var(--ease);

  --font-head:  'Syne', sans-serif;
  --font-body:  'DM Sans', sans-serif;
  --font-mono:  'JetBrains Mono', monospace;

  --sh-primary: 0 8px 28px rgba(26,86,232,.26);
  --sh-gold:    0 8px 28px rgba(232,160,32,.26);
  --sh-learn:   0 8px 28px rgba(0,176,156,.26);
  --sh-card:    0 1px 8px rgba(6,8,15,.06), 0 4px 20px rgba(6,8,15,.06);
  --sh-card-h:  0 12px 44px rgba(6,8,15,.13), 0 4px 12px rgba(6,8,15,.07);
}

/* ══════════════════════════════════════════
   RESET & BASE
══════════════════════════════════════════ */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; -webkit-font-smoothing:antialiased; }
body {
  font-family:var(--font-body);
  background:var(--ghost);
  color:var(--ink);
  overflow-x:hidden;
  font-size:16px;
  line-height:1.6;
}
h1,h2,h3,h4,h5,h6 { font-family:var(--font-head); line-height:1.12; letter-spacing:-.3px; }
a { text-decoration:none; color:inherit; }
img { max-width:100%; display:block; }

::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-track { background:var(--ink-2); }
::-webkit-scrollbar-thumb { background:var(--primary); border-radius:4px; }

/* ══════════════════════════════════════════
   SCROLL PROGRESS
══════════════════════════════════════════ */
#scroll-progress {
  position:fixed; top:0; left:0; height:2px; width:0%;
  background:linear-gradient(90deg, var(--primary), var(--gold), var(--learn));
  z-index:9999; transition:width .1s linear;
  box-shadow:0 0 10px rgba(26,86,232,.5);
}

/* ══════════════════════════════════════════
   NAVBAR
══════════════════════════════════════════ */
.navbar {
  position:fixed; top:0; left:0; right:0; z-index:1040;
  height:var(--nav-h);
  background:rgba(255,255,255,.96);
  backdrop-filter:blur(20px) saturate(1.8);
  border-bottom:1px solid rgba(6,8,15,.07);
  transition:var(--t);
}
.navbar.scrolled {
  background:rgba(255,255,255,.99);
  box-shadow:0 1px 20px rgba(6,8,15,.09);
}
.nav-inner {
  max-width:1300px; margin:0 auto; padding:0 28px;
  height:100%; display:flex; align-items:center; justify-content:space-between; gap:12px;
}
.nav-brand {
  font-family:var(--font-head); font-size:1.28rem; font-weight:800;
  color:var(--ink); flex-shrink:0; letter-spacing:-.5px; display:flex; align-items:center; gap:6px;
}
.nav-brand .brand-dot {
  width:8px; height:8px; background:var(--primary); border-radius:50%; display:inline-block;
  box-shadow:0 0 8px rgba(26,86,232,.6);
}
.nav-brand em { font-style:normal; color:var(--primary); }

.nav-links {
  display:flex; align-items:center; gap:2px; list-style:none; flex:1; justify-content:center;
}
.nav-links .nl-item { position:relative; }
.nav-links .nl-a {
  font-size:.83rem; font-weight:600; color:var(--slate); padding:8px 13px;
  border-radius:var(--r-md); transition:var(--t); white-space:nowrap;
  display:flex; align-items:center; gap:4px; font-family:var(--font-body);
  letter-spacing:.01em;
}
.nav-links .nl-a:hover, .nav-links .nl-a.active { color:var(--primary); background:rgba(26,86,232,.07); }
.nl-a .arrow { font-size:.55rem; transition:transform .25s; }
.nl-item:hover .arrow { transform:rotate(180deg); }

/* Mega dropdown */
.mega-drop {
  position:absolute; top:calc(100% + 10px); left:50%;
  transform:translateX(-50%) translateY(8px);
  min-width:540px; background:#fff; border-radius:var(--r-xl);
  border:1px solid rgba(6,8,15,.07);
  box-shadow:0 20px 60px rgba(6,8,15,.13), 0 4px 16px rgba(6,8,15,.05);
  padding:22px; opacity:0; visibility:hidden; pointer-events:none;
  transition:all .2s var(--ease);
}
.nl-item:hover .mega-drop {
  opacity:1; visibility:visible; pointer-events:auto; transform:translateX(-50%) translateY(0);
}
.mega-drop::before {
  content:''; position:absolute; top:-6px; left:50%;
  width:11px; height:11px; background:#fff;
  border-left:1px solid rgba(6,8,15,.07); border-top:1px solid rgba(6,8,15,.07);
  transform:translateX(-50%) rotate(45deg);
}
.mega-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:0; }
.mega-col-label {
  font-size:.65rem; font-weight:800; letter-spacing:1.8px; text-transform:uppercase;
  color:var(--primary); padding:0 8px 10px; display:block;
}
.mega-link {
  display:flex; align-items:center; gap:8px; padding:8px 10px;
  border-radius:var(--r-md); font-size:.81rem; font-weight:500; color:var(--slate);
  transition:all .16s; font-family:var(--font-body);
}
.mega-link i { width:17px; color:var(--primary); font-size:.78rem; flex-shrink:0; }
.mega-link:hover { background:rgba(26,86,232,.07); color:var(--primary); transform:translateX(2px); }

.nav-cta { display:flex; align-items:center; gap:8px; flex-shrink:0; }

/* Hamburger */
.ham-btn {
  display:none; flex-direction:column; gap:5px; align-items:center; justify-content:center;
  width:40px; height:40px; background:none; border:none; cursor:pointer; border-radius:var(--r-md);
  transition:var(--t);
}
.ham-btn:hover { background:rgba(26,86,232,.07); }
.ham-line { display:block; width:21px; height:1.8px; background:var(--ink); border-radius:2px; transition:all .26s var(--ease); transform-origin:center; }
.ham-btn.open .ham-line:nth-child(1) { transform:translateY(6.8px) rotate(45deg); }
.ham-btn.open .ham-line:nth-child(2) { opacity:0; transform:scaleX(0); }
.ham-btn.open .ham-line:nth-child(3) { transform:translateY(-6.8px) rotate(-45deg); }

/* Mobile panel */
.mob-overlay {
  display:none; position:fixed; inset:0; background:rgba(6,8,15,.55);
  backdrop-filter:blur(6px); z-index:1038; opacity:0; transition:opacity .3s;
}
.mob-overlay.open { opacity:1; }
.mob-panel {
  position:fixed; top:0; right:0; width:min(360px,90vw); height:100dvh;
  background:#fff; z-index:1039; overflow-y:auto;
  transform:translateX(100%); transition:transform .32s var(--ease);
  box-shadow:-12px 0 48px rgba(6,8,15,.18); display:flex; flex-direction:column;
}
.mob-panel.open { transform:translateX(0); }
.mob-head {
  display:flex; align-items:center; justify-content:space-between;
  padding:16px 20px; border-bottom:1px solid var(--mist); flex-shrink:0;
}
.mob-close {
  width:34px; height:34px; border:none; background:var(--mist); cursor:pointer;
  border-radius:var(--r-md); display:flex; align-items:center; justify-content:center;
  transition:var(--t); font-size:.85rem;
}
.mob-close:hover { background:var(--rose); color:#fff; }
.mob-body { padding:10px 0; flex:1; }
.mob-link {
  display:flex; align-items:center; gap:10px; padding:11px 22px;
  font-size:.9rem; font-weight:600; color:var(--ink); transition:var(--t);
  font-family:var(--font-body);
}
.mob-link i { width:19px; color:var(--primary); font-size:.82rem; }
.mob-link:hover { background:rgba(26,86,232,.06); color:var(--primary); padding-left:28px; }
.mob-link.learn-mob { color:var(--learn); }
.mob-link.learn-mob i { color:var(--learn); }
.mob-link.learn-mob:hover { background:rgba(0,176,156,.08); color:var(--learn-d); }
.mob-sub-toggle {
  display:flex; align-items:center; justify-content:space-between;
  padding:11px 22px; font-size:.9rem; font-weight:600; color:var(--ink); cursor:pointer; transition:var(--t);
  font-family:var(--font-body);
}
.mob-sub-toggle .left { display:flex; align-items:center; gap:10px; }
.mob-sub-toggle .left i { width:19px; color:var(--primary); font-size:.82rem; }
.mob-sub-toggle:hover { background:rgba(26,86,232,.06); color:var(--primary); }
.mob-sub-toggle .chev { font-size:.62rem; color:var(--slate); transition:transform .28s; }
.mob-sub-toggle.open .chev { transform:rotate(180deg); }
.mob-sub {
  background:rgba(26,86,232,.03); border-top:1px solid rgba(26,86,232,.07); border-bottom:1px solid rgba(26,86,232,.07);
  max-height:0; overflow:hidden; transition:max-height .32s;
}
.mob-sub.open { max-height:600px; }
.mob-sub a {
  display:flex; align-items:center; gap:8px; padding:9px 22px 9px 50px;
  font-size:.82rem; color:var(--slate); transition:var(--t);
}
.mob-sub a i { width:15px; color:var(--primary); font-size:.74rem; }
.mob-sub a:hover { color:var(--primary); padding-left:56px; }
.mob-hr { border:none; border-top:1px solid var(--mist); margin:8px 20px; }
.mob-footer { padding:16px 20px 28px; border-top:1px solid var(--mist); display:flex; flex-direction:column; gap:9px; }

/* Dark mode mobile */
body.dark .mob-panel, body.dark .mob-head { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .mob-link, body.dark .mob-sub-toggle { color:rgba(255,255,255,.85); }
body.dark .mob-link:hover, body.dark .mob-sub-toggle:hover { background:rgba(26,86,232,.1); color:var(--primary-l); }
body.dark .mob-sub { background:rgba(255,255,255,.02); border-color:rgba(255,255,255,.06); }
body.dark .mob-sub a { color:rgba(255,255,255,.55); }
body.dark .mob-sub a:hover { color:var(--primary-l); }
body.dark .mob-hr { border-color:rgba(255,255,255,.08); }
body.dark .mob-footer { border-color:rgba(255,255,255,.08); }
body.dark .mob-close { background:rgba(255,255,255,.08); color:rgba(255,255,255,.8); }

/* ══════════════════════════════════════════
   BUTTONS
══════════════════════════════════════════ */
.btn-primary {
  display:inline-flex; align-items:center; gap:7px;
  background:var(--g-primary); color:#fff; border:none; cursor:pointer;
  padding:12px 26px; border-radius:var(--r-pill); font-weight:700; font-size:.87rem;
  font-family:var(--font-head); transition:var(--t); box-shadow:var(--sh-primary);
  white-space:nowrap; letter-spacing:.02em;
}
.btn-primary:hover { transform:translateY(-2px); box-shadow:0 14px 38px rgba(26,86,232,.36); }
.btn-primary:active { transform:translateY(0); }

.btn-learn {
  display:inline-flex; align-items:center; gap:7px;
  background:var(--g-learn); color:#fff; border:none; cursor:pointer;
  padding:12px 26px; border-radius:var(--r-pill); font-weight:700; font-size:.87rem;
  font-family:var(--font-head); transition:var(--t); box-shadow:var(--sh-learn);
  white-space:nowrap; letter-spacing:.02em;
}
.btn-learn:hover { transform:translateY(-2px); box-shadow:0 14px 38px rgba(0,176,156,.38); }

.btn-outline {
  display:inline-flex; align-items:center; gap:7px;
  background:transparent; color:var(--primary); border:2px solid var(--primary);
  padding:10px 24px; border-radius:var(--r-pill); font-weight:700; font-size:.87rem;
  font-family:var(--font-head); transition:var(--t); cursor:pointer; white-space:nowrap;
}
.btn-outline:hover { background:var(--g-primary); color:#fff; transform:translateY(-2px); box-shadow:var(--sh-primary); }

.btn-ghost-white {
  display:inline-flex; align-items:center; gap:7px;
  background:rgba(255,255,255,.1); color:#fff; border:1.5px solid rgba(255,255,255,.3);
  padding:11px 24px; border-radius:var(--r-pill); font-weight:700; font-size:.87rem;
  font-family:var(--font-head); transition:var(--t); cursor:pointer; white-space:nowrap;
  backdrop-filter:blur(8px);
}
.btn-ghost-white:hover { background:rgba(255,255,255,.2); border-color:rgba(255,255,255,.55); transform:translateY(-2px); }

.btn-wa {
  display:inline-flex; align-items:center; gap:8px;
  background:linear-gradient(135deg,#25D366,#1aad54); color:#fff; border:none;
  padding:12px 24px; border-radius:var(--r-pill); font-weight:700; font-size:.87rem;
  font-family:var(--font-head); transition:var(--t); cursor:pointer; white-space:nowrap;
  box-shadow:0 6px 18px rgba(37,211,102,.28);
}
.btn-wa:hover { transform:translateY(-2px); box-shadow:0 12px 30px rgba(37,211,102,.42); }

.btn-gold {
  display:inline-flex; align-items:center; gap:7px;
  background:var(--g-gold); color:#fff; border:none; cursor:pointer;
  padding:12px 26px; border-radius:var(--r-pill); font-weight:700; font-size:.87rem;
  font-family:var(--font-head); transition:var(--t); box-shadow:var(--sh-gold);
  white-space:nowrap;
}
.btn-gold:hover { transform:translateY(-2px); box-shadow:0 14px 38px rgba(232,160,32,.38); }

.btn-pdf {
  display:inline-flex; align-items:center; gap:8px;
  background:linear-gradient(135deg,#ef4444,#dc2626); color:#fff; border:none;
  padding:13px 30px; border-radius:var(--r-pill); font-weight:700; font-size:.9rem;
  font-family:var(--font-head); transition:var(--t); cursor:pointer;
  box-shadow:0 6px 22px rgba(239,68,68,.28);
}
.btn-pdf:hover { transform:translateY(-2px); box-shadow:0 12px 34px rgba(239,68,68,.38); }

/* Nav-specific buttons */
.btn-nav-signin {
  display:inline-flex; align-items:center; gap:6px;
  font-size:.8rem; font-weight:700; color:var(--slate);
  padding:7px 16px; border:1.5px solid var(--mist); border-radius:var(--r-pill);
  font-family:var(--font-head); transition:var(--t); background:#fff; cursor:pointer;
}
.btn-nav-signin:hover { color:var(--primary); border-color:var(--primary); }

.btn-nav-learn {
  display:inline-flex; align-items:center; gap:6px;
  font-size:.8rem; font-weight:700; color:var(--learn);
  padding:7px 16px; border:1.5px solid rgba(0,176,156,.35); border-radius:var(--r-pill);
  font-family:var(--font-head); transition:var(--t); background:rgba(0,176,156,.07); cursor:pointer;
}
.btn-nav-learn:hover { background:var(--g-learn); color:#fff; border-color:transparent; box-shadow:var(--sh-learn); }

.btn-nav-start {
  display:inline-flex; align-items:center; gap:6px;
  font-size:.8rem; font-weight:700; color:#fff;
  padding:8px 19px; border:none; border-radius:var(--r-pill);
  font-family:var(--font-head); transition:var(--t);
  background:var(--g-primary); cursor:pointer;
  box-shadow:var(--sh-primary);
}
.btn-nav-start:hover { transform:translateY(-1px); box-shadow:0 12px 30px rgba(26,86,232,.38); }

/* ══════════════════════════════════════════
   DARK MODE
══════════════════════════════════════════ */
body.dark { background:var(--ink); color:rgba(255,255,255,.87); }
body.dark .navbar { background:rgba(6,8,15,.97); border-bottom-color:rgba(255,255,255,.06); }
body.dark .navbar.scrolled { background:rgba(6,8,15,.99); }
body.dark .nav-links .nl-a { color:rgba(255,255,255,.6); }
body.dark .nav-links .nl-a:hover, body.dark .nav-links .nl-a.active { color:var(--primary-l); background:rgba(26,86,232,.1); }
body.dark .mega-drop { background:var(--ink-2); border-color:rgba(255,255,255,.08); }
body.dark .mega-drop::before { background:var(--ink-2); border-color:rgba(255,255,255,.08); }
body.dark .mega-link { color:rgba(255,255,255,.6); }
body.dark .mega-link:hover { background:rgba(26,86,232,.12); color:var(--primary-l); }
body.dark .ham-line { background:rgba(255,255,255,.85); }
body.dark .card-white { background:var(--ink-2) !important; border-color:rgba(255,255,255,.07) !important; }
body.dark .text-dark { color:rgba(255,255,255,.87) !important; }
body.dark .text-muted, body.dark .section-sub { color:rgba(255,255,255,.45) !important; }
body.dark .bg-ghost { background:var(--ink-2) !important; }
body.dark .bg-white-section { background:var(--ink-3) !important; }
body.dark .tech-pill { background:var(--ink-2); border-color:rgba(255,255,255,.09); color:rgba(255,255,255,.78); }
body.dark .faq-item { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .faq-q { color:rgba(255,255,255,.87); }
body.dark .process-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .newsletter-box { background:var(--ink-2); border-color:rgba(255,255,255,.08); }
body.dark .nl-form-inp { background:var(--ink-3); border-color:rgba(255,255,255,.09); color:#fff; }
body.dark .nl-form-inp::placeholder { color:rgba(255,255,255,.3); }
body.dark .trust-strip { background:var(--ink-2); border-color:rgba(255,255,255,.06); }
body.dark .stat-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .testimonial-card { background:var(--ink-2); border-color:rgba(255,255,255,.08); }
body.dark .pricing-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .pricing-card.featured { background:var(--ink); }
body.dark .portfolio-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .team-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .blog-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .service-card { background:var(--ink-2); border-color:rgba(255,255,255,.07); }
body.dark .service-card .svc-overlay { background:rgba(6,8,15,.95); }
body.dark .btn-nav-signin { color:rgba(255,255,255,.6); border-color:rgba(255,255,255,.12); background:transparent; }
body.dark .btn-nav-signin:hover { color:var(--primary-l); border-color:var(--primary-l); }
body.dark .btn-nav-learn { border-color:rgba(0,176,156,.3); }
body.dark #theme-toggle { background:var(--ink-2); border-color:rgba(255,255,255,.1); }
body.dark #theme-toggle svg { stroke:rgba(255,255,255,.8); }
body.dark footer { background:var(--ink-2); }
body.dark .footer-div { border-color:rgba(255,255,255,.08); }
body.dark .newsletter-section { background:linear-gradient(135deg,var(--ink-2),var(--ink-3)); }

/* ══════════════════════════════════════════
   UTILITIES
══════════════════════════════════════════ */
.container { max-width:1300px; margin:0 auto; padding:0 28px; }
.section-py { padding:88px 0; }
.section-py-sm { padding:60px 0; }
.text-center { text-align:center; }
.text-muted { color:var(--slate); }
.row { display:grid; }
.g-primary { background:var(--g-primary); -webkit-background-clip:text; background-clip:text; color:transparent; }
.g-gold     { background:var(--g-gold);    -webkit-background-clip:text; background-clip:text; color:transparent; }
.g-violet   { background:var(--g-violet);  -webkit-background-clip:text; background-clip:text; color:transparent; }
.g-learn-t  { background:var(--g-teal);    -webkit-background-clip:text; background-clip:text; color:transparent; }

.section-tag {
  display:inline-flex; align-items:center; gap:6px;
  background:rgba(26,86,232,.09); color:var(--primary);
  border-radius:var(--r-pill); padding:5px 16px;
  font-size:.67rem; font-weight:800; letter-spacing:2px; text-transform:uppercase; margin-bottom:12px;
  border:1px solid rgba(26,86,232,.14);
}
.section-tag::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--primary); }
.section-title { font-size:clamp(1.85rem,4vw,3.1rem); font-weight:800; margin-bottom:14px; line-height:1.1; }
.section-sub { color:var(--slate); font-size:clamp(.88rem,1.8vw,1.05rem); line-height:1.72; max-width:560px; }

/* Animations */
@keyframes float-a  { 0%,100%{transform:translateY(0)}    50%{transform:translateY(-12px)} }
@keyframes blink     { 0%,100%{opacity:1} 50%{opacity:0} }
@keyframes marquee   { from{transform:translateX(0)} to{transform:translateX(-50%)} }
@keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.4)} }
@keyframes wa-ring   { 0%{inset:-2px;opacity:.7} 100%{inset:-14px;opacity:0} }
@keyframes dot-flash { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.4);opacity:.5} }
@keyframes si-dot    { 0%{transform:translateY(0);opacity:1} 60%{transform:translateY(14px);opacity:.2} 61%{transform:translateY(0);opacity:0} 62%{opacity:1} 100%{opacity:1} }
@keyframes shimmer   { from{background-position:-200% 0} to{background-position:200% 0} }

.fa { display:inline-block; }

/* ══════════════════════════════════════════
   FIXED WIDGETS
══════════════════════════════════════════ */
#theme-toggle {
  position:fixed; bottom:26px; left:26px; z-index:10000;
  width:44px; height:44px; background:#fff; border:1.5px solid rgba(6,8,15,.09);
  border-radius:50%; display:flex; align-items:center; justify-content:center;
  cursor:pointer; box-shadow:0 4px 18px rgba(6,8,15,.1); transition:var(--t);
}
#theme-toggle svg { width:17px; height:17px; stroke:var(--slate); stroke-width:1.8; fill:none; stroke-linecap:round; stroke-linejoin:round; display:block; transition:stroke .2s; }
#theme-toggle:hover { background:var(--primary); border-color:var(--primary); transform:rotate(22deg) scale(1.07); box-shadow:0 8px 26px rgba(26,86,232,.32); }
#theme-toggle:hover svg { stroke:#fff; }

#back-to-top {
  position:fixed; bottom:26px; right:26px; z-index:10000;
  width:44px; height:44px; background:var(--g-primary); border:none;
  border-radius:50%; display:flex; align-items:center; justify-content:center;
  cursor:pointer; opacity:0; transform:translateY(16px); pointer-events:none;
  transition:opacity .3s, transform .4s var(--ease-spring), box-shadow .3s;
  box-shadow:var(--sh-primary);
}
#back-to-top svg { width:17px; height:17px; stroke:#fff; stroke-width:2.4; fill:none; stroke-linecap:round; stroke-linejoin:round; }
#back-to-top.visible { opacity:1; transform:translateY(0); pointer-events:auto; }
#back-to-top:hover { transform:translateY(-4px) scale(1.07); box-shadow:0 16px 38px rgba(26,86,232,.46); }

/* WhatsApp float */
#wa-float {
  position:fixed; bottom:90px; right:26px; z-index:10001;
  display:flex; align-items:center; gap:10px;
  background:#128C7E; border-radius:var(--r-pill);
  padding:10px 17px 10px 10px; text-decoration:none;
  box-shadow:0 6px 26px rgba(18,140,126,.38);
  transition:transform .32s var(--ease-spring), box-shadow .3s; max-width:220px;
}
#wa-float:hover { transform:translateY(-4px) scale(1.02); box-shadow:0 16px 42px rgba(18,140,126,.55); }
.wa-circle {
  width:36px; height:36px; flex-shrink:0; background:#25D366; border-radius:50%;
  display:flex; align-items:center; justify-content:center; font-size:1.15rem; color:#fff; position:relative;
}
.wa-circle::after {
  content:''; position:absolute; inset:-2px; border-radius:50%;
  border:2px solid #25D366; opacity:0; animation:wa-ring 2.4s ease-out infinite;
}
.wa-online {
  position:absolute; top:1px; right:1px; width:9px; height:9px;
  background:#a8ff78; border:2px solid #128C7E; border-radius:50%; animation:dot-flash 2.5s ease-in-out infinite;
}
.wa-text { display:flex; flex-direction:column; line-height:1.25; overflow:hidden; }
.wa-text .wa-top { font-size:9px; color:rgba(255,255,255,.65); font-weight:600; letter-spacing:.3px; white-space:nowrap; }
.wa-text .wa-main { font-size:13px; color:#fff; font-weight:700; white-space:nowrap; font-family:var(--font-head); }

/* Scroll indicator */
#scroll-ind {
  position:absolute; bottom:32px; left:50%; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:5px;
  cursor:pointer; z-index:100; opacity:1; transition:opacity .5s, transform .5s;
}
#scroll-ind.hidden { opacity:0; pointer-events:none; }
.si-pill { width:22px; height:38px; border:1.5px solid rgba(255,255,255,.3); border-radius:11px; display:flex; align-items:flex-start; justify-content:center; padding-top:5px; }
.si-dot  { width:3px; height:7px; background:#fff; border-radius:2px; animation:si-dot 1.8s ease-in-out infinite; }
.si-label{ font-size:8px; font-weight:800; letter-spacing:2.5px; text-transform:uppercase; color:rgba(255,255,255,.45); }

/* Toast */
#toast {
  position:fixed; bottom:92px; right:26px; background:var(--ink-2); color:#fff;
  border-radius:var(--r-lg); padding:13px 18px; font-size:.84rem;
  display:flex; align-items:center; gap:10px; z-index:10002;
  opacity:0; transform:translateY(10px); transition:var(--t);
  border-left:3px solid var(--emerald); min-width:230px;
}
#toast.show { opacity:1; transform:translateY(0); }

/* Cookie */
#cookie-bar {
  position:fixed; bottom:0; left:0; right:0; background:var(--ink-2); color:rgba(255,255,255,.82);
  padding:14px 24px; display:flex; align-items:center; justify-content:space-between; gap:16px;
  z-index:9998; transform:translateY(100%); transition:transform .4s; border-top:1px solid rgba(255,255,255,.07);
}
#cookie-bar.show { transform:translateY(0); }
#cookie-bar p { font-size:.81rem; margin:0; }
#cookie-accept { background:var(--primary); color:#fff; border:none; padding:7px 20px; border-radius:var(--r-pill); font-size:.81rem; cursor:pointer; font-family:var(--font-head); font-weight:700; transition:var(--t); }
#cookie-accept:hover { background:var(--primary-d); }

/* ══════════════════════════════════════════
   HERO
══════════════════════════════════════════ */
.hero {
  min-height:100vh; padding-top:var(--nav-h);
  background:var(--g-hero); position:relative; overflow:hidden;
  display:flex; align-items:center;
}

/* Refined mesh background */
.hero-mesh {
  position:absolute; inset:0; pointer-events:none; overflow:hidden;
}
.hero-mesh::before {
  content:''; position:absolute; inset:0;
  background-image:
    linear-gradient(rgba(26,86,232,.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(26,86,232,.055) 1px, transparent 1px);
  background-size:48px 48px;
}
.hero-glow-1 { position:absolute; width:750px; height:750px; border-radius:50%; background:radial-gradient(circle, rgba(26,86,232,.22) 0%, transparent 70%); top:-200px; right:-100px; pointer-events:none; }
.hero-glow-2 { position:absolute; width:500px; height:500px; border-radius:50%; background:radial-gradient(circle, rgba(232,160,32,.12) 0%, transparent 70%); bottom:-60px; left:40px; pointer-events:none; }
.hero-glow-3 { position:absolute; width:420px; height:420px; border-radius:50%; background:radial-gradient(circle, rgba(108,61,245,.1) 0%, transparent 70%); top:45%; left:42%; transform:translate(-50%,-50%); pointer-events:none; }

/* Subtle noise texture overlay */
.hero-noise {
  position:absolute; inset:0; pointer-events:none; opacity:.03;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  background-size:200px 200px;
}

.hero-inner {
  position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr;
  gap:52px; align-items:center; padding:72px 0 88px;
}
.hero-eyebrow {
  display:inline-flex; align-items:center; gap:8px;
  background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.13);
  border-radius:var(--r-pill); padding:5px 14px; color:rgba(255,255,255,.78);
  font-size:.77rem; font-weight:700; margin-bottom:22px; backdrop-filter:blur(8px);
  letter-spacing:.5px;
}
.hero-eyebrow .dot { width:6px; height:6px; border-radius:50%; background:var(--emerald); animation:pulse-dot 2s infinite; }
.hero h1 { font-size:clamp(2.1rem,5vw,4.6rem); font-weight:800; color:#fff; line-height:1.06; margin-bottom:22px; }
.hero h1 .accent { 
  background:linear-gradient(135deg, var(--gold-l), var(--gold), var(--gold-d));
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.hero-sub { color:rgba(255,255,255,.6); font-size:clamp(.9rem,1.8vw,1.08rem); line-height:1.78; max-width:490px; margin-bottom:30px; }
.hero-actions { display:flex; gap:12px; flex-wrap:wrap; }
.hero-trust { display:flex; gap:20px; flex-wrap:wrap; margin-top:24px; }
.hero-trust-item { display:flex; align-items:center; gap:6px; font-size:.79rem; color:rgba(255,255,255,.55); font-weight:600; }
.hero-trust-item i { color:var(--gold); font-size:.78rem; }

/* Code block */
.code-box {
  background:rgba(6,8,15,.85); border:1px solid rgba(26,86,232,.28);
  border-radius:var(--r-xl); padding:26px 30px; font-family:var(--font-mono);
  font-size:.79rem; line-height:1.88; position:relative; backdrop-filter:blur(16px);
  animation:float-a 5.5s ease-in-out infinite;
}
.code-box::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg, var(--primary), var(--gold), var(--learn)); border-radius:var(--r-xl) var(--r-xl) 0 0; }

/* Subtle inner glow */
.code-box::after {
  content:''; position:absolute; inset:1px; border-radius:calc(var(--r-xl) - 1px);
  background:radial-gradient(ellipse at top left, rgba(26,86,232,.07) 0%, transparent 60%);
  pointer-events:none;
}
.code-dots { display:flex; gap:6px; margin-bottom:18px; }
.code-dots span { width:9px; height:9px; border-radius:50%; }
.code-dots span:nth-child(1){background:#ef4444;}
.code-dots span:nth-child(2){background:var(--gold);}
.code-dots span:nth-child(3){background:var(--emerald);}
.kw  { color:#7c9ef8; } .fn  { color:#4fd1a5; } .str { color:#f5a067; } .cm  { color:#3d5073; }
.cursor { display:inline-block; width:2px; height:.9em; background:var(--primary-l); animation:blink 1s step-end infinite; vertical-align:text-bottom; margin-left:2px; }

.hero-chips { display:flex; gap:10px; margin-top:16px; flex-wrap:wrap; }
.chip {
  padding:7px 16px; border-radius:var(--r-pill); font-size:.75rem; font-weight:700;
  backdrop-filter:blur(8px); font-family:var(--font-body);
}
.chip-green { background:rgba(13,191,126,.14); border:1px solid rgba(13,191,126,.28); color:#4dd4a0; }
.chip-gold  { background:rgba(232,160,32,.14);  border:1px solid rgba(232,160,32,.28);  color:#f0c56e; }

/* ══════════════════════════════════════════
   LEARN BANNER (new section)
══════════════════════════════════════════ */
.learn-banner {
  background:linear-gradient(135deg, #003d37 0%, #004d40 50%, #00695c 100%);
  padding:22px 0; border-bottom:1px solid rgba(0,176,156,.2);
  position:relative; overflow:hidden;
}
.learn-banner::before {
  content:''; position:absolute; inset:0;
  background-image:linear-gradient(rgba(0,176,156,.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,176,156,.06) 1px, transparent 1px);
  background-size:36px 36px;
}
.learn-banner-inner {
  position:relative; z-index:1;
  display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;
}
.learn-banner-text { display:flex; align-items:center; gap:14px; }
.learn-banner-icon {
  width:46px; height:46px; background:rgba(0,176,156,.2); border-radius:var(--r-md);
  display:flex; align-items:center; justify-content:center; color:var(--learn); font-size:1.3rem;
  border:1px solid rgba(0,176,156,.3); flex-shrink:0;
}
.learn-banner-content h4 { font-size:.97rem; font-weight:700; color:#fff; margin-bottom:2px; }
.learn-banner-content p { font-size:.8rem; color:rgba(255,255,255,.55); margin:0; }
.learn-banner-badges { display:flex; gap:8px; flex-wrap:wrap; }
.learn-badge {
  padding:4px 12px; border-radius:var(--r-pill); font-size:.69rem; font-weight:700;
  background:rgba(255,255,255,.08); color:rgba(255,255,255,.7); border:1px solid rgba(255,255,255,.1);
}

/* ══════════════════════════════════════════
   MARQUEE
══════════════════════════════════════════ */
.marquee-wrap { background:var(--primary); padding:11px 0; overflow:hidden; white-space:nowrap; }
.marquee-track { display:inline-flex; animation:marquee 30s linear infinite; }
.marquee-track:hover { animation-play-state:paused; }
.marquee-item { display:inline-flex; align-items:center; gap:8px; padding:0 28px; color:rgba(255,255,255,.9); font-size:.86rem; font-weight:600; }
.marquee-sep { opacity:.3; }

/* ══════════════════════════════════════════
   TRUST STRIP
══════════════════════════════════════════ */
.trust-strip {
  background:#fff; border-top:1px solid var(--mist); border-bottom:1px solid var(--mist); padding:20px 0;
}
.trust-inner { display:flex; flex-wrap:wrap; justify-content:center; gap:32px; }
.trust-item { display:flex; align-items:center; gap:9px; font-size:.81rem; font-weight:700; color:var(--ink); }
.trust-item i { font-size:1rem; }

/* ══════════════════════════════════════════
   SERVICES
══════════════════════════════════════════ */
.services-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
.service-card {
  background:#fff; border-radius:var(--r-xl); border:1px solid var(--mist);
  overflow:hidden; position:relative; transition:var(--t); cursor:pointer;
  display:block; text-decoration:none; color:inherit;
}
.service-card:hover { transform:translateY(-7px); box-shadow:var(--sh-card-h); border-color:rgba(26,86,232,.18); }
.svc-img-wrap { height:148px; overflow:hidden; position:relative; }
.svc-img { width:100%; height:100%; object-fit:cover; transition:transform .5s; }
.service-card:hover .svc-img { transform:scale(1.07); }
.service-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:2.5px;
  background:linear-gradient(90deg, var(--primary), var(--gold), var(--learn));
  transform:scaleX(0); transform-origin:left; transition:transform .38s; z-index:3;
}
.service-card:hover::before { transform:scaleX(1); }
.svc-overlay {
  position:absolute; inset:0; background:rgba(255,255,255,.97);
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:8px; opacity:0; transition:opacity .28s; z-index:2; text-align:center; padding:18px;
  backdrop-filter:blur(6px);
}
.service-card:hover .svc-overlay { opacity:1; }
.svc-ov-icon { width:48px; height:48px; background:var(--g-primary); border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.15rem; transform:scale(.8); transition:transform .32s var(--ease-spring) .04s; }
.service-card:hover .svc-ov-icon { transform:scale(1); }
.svc-ov-title { font-family:var(--font-head); font-weight:700; font-size:.88rem; color:var(--primary); transform:translateY(5px); transition:transform .28s .06s; }
.svc-ov-sub { font-size:.72rem; color:var(--slate); transform:translateY(5px); transition:transform .28s .09s; }
.service-card:hover .svc-ov-title, .service-card:hover .svc-ov-sub { transform:translateY(0); }
.svc-ov-btn { display:inline-flex; align-items:center; gap:5px; background:var(--g-primary); color:#fff; padding:6px 16px; border-radius:var(--r-pill); font-size:.74rem; font-weight:700; transform:translateY(5px); transition:transform .28s .12s; font-family:var(--font-head); }
.service-card:hover .svc-ov-btn { transform:translateY(0); }
.svc-icon-wrap {
  position:relative; z-index:2; margin:-22px 0 12px 18px; width:48px; height:48px;
  background:#fff; border-radius:24px; display:flex; align-items:center; justify-content:center;
  box-shadow:0 4px 12px rgba(6,8,15,.09); border:1px solid var(--mist);
}
.svc-body { padding:0 18px 18px; }
.svc-body h3 { font-size:1rem; font-weight:700; margin-bottom:6px; }
.svc-body p { font-size:.81rem; color:var(--slate); line-height:1.55; margin-bottom:12px; }
.svc-pill {
  display:inline-flex; align-items:center; gap:4px; font-size:.68rem; font-weight:800;
  color:var(--primary); background:rgba(26,86,232,.08); padding:4px 12px; border-radius:var(--r-pill);
  transition:var(--t); font-family:var(--font-head);
}
.service-card:hover .svc-pill { background:var(--primary); color:#fff; }

/* ══════════════════════════════════════════
   STATS
══════════════════════════════════════════ */
.stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
.stat-card {
  background:#fff; border-radius:var(--r-xl); padding:28px 22px; text-align:center;
  border:1px solid var(--mist); transition:var(--t); position:relative; overflow:hidden;
}
.stat-card::after {
  content:''; position:absolute; bottom:0; left:0; right:0; height:2px;
  background:var(--g-primary); transform:scaleX(0); transform-origin:left; transition:transform .35s;
}
.stat-card:hover { transform:translateY(-5px); box-shadow:var(--sh-card-h); }
.stat-card:hover::after { transform:scaleX(1); }
.stat-num { font-family:var(--font-head); font-size:clamp(2rem,4vw,3rem); font-weight:800; }
.stat-label { font-size:.8rem; color:var(--slate); margin-top:5px; font-weight:500; }

/* ══════════════════════════════════════════
   PROCESS
══════════════════════════════════════════ */
.process-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
.process-card {
  background:#fff; border-radius:var(--r-xl); padding:30px 24px;
  border:1px solid var(--mist); transition:var(--t); position:relative;
}
.process-card:hover { transform:translateY(-5px); box-shadow:var(--sh-card-h); }
.process-num {
  font-family:var(--font-head); font-size:2.8rem; font-weight:800;
  background:var(--g-primary); -webkit-background-clip:text; background-clip:text; color:transparent;
  line-height:1; margin-bottom:14px; opacity:.7;
}
.process-card h4 { font-size:1.02rem; font-weight:700; margin-bottom:8px; }
.process-card p { font-size:.82rem; color:var(--slate); line-height:1.62; }
.process-arrow {
  position:absolute; top:50%; right:-13px; transform:translateY(-50%);
  width:26px; height:26px; background:var(--primary); border-radius:50%;
  display:flex; align-items:center; justify-content:center; color:#fff; font-size:.65rem; z-index:2;
  box-shadow:var(--sh-primary);
}

/* ══════════════════════════════════════════
   LEARN SECTION (new)
══════════════════════════════════════════ */
.learn-section {
  background:linear-gradient(158deg, #003d37 0%, #004d40 40%, #005248 100%);
  position:relative; overflow:hidden;
}
.learn-section::before {
  content:''; position:absolute; inset:0;
  background:radial-gradient(ellipse at 70% 50%, rgba(0,176,156,.2) 0%, transparent 60%),
             radial-gradient(ellipse at 20% 80%, rgba(6,192,217,.12) 0%, transparent 50%);
}
.learn-section::after {
  content:''; position:absolute; inset:0;
  background-image:linear-gradient(rgba(0,176,156,.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,176,156,.05) 1px, transparent 1px);
  background-size:44px 44px;
}
.learn-inner { position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; }
.learn-tag { display:inline-flex; align-items:center; gap:6px; background:rgba(0,176,156,.18); color:#5eead4; border-radius:var(--r-pill); padding:5px 14px; font-size:.67rem; font-weight:800; letter-spacing:2px; text-transform:uppercase; margin-bottom:14px; border:1px solid rgba(0,176,156,.25); }
.learn-tag::before { content:''; width:5px; height:5px; border-radius:50%; background:#5eead4; }
.learn-inner h2 { font-size:clamp(1.8rem,3.5vw,2.9rem); font-weight:800; color:#fff; margin-bottom:16px; line-height:1.1; }
.learn-inner h2 span { color:var(--gold-l); }
.learn-inner p { color:rgba(255,255,255,.58); font-size:clamp(.88rem,1.6vw,1rem); line-height:1.75; margin-bottom:28px; max-width:460px; }
.learn-cards { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.learn-card {
  background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1);
  border-radius:var(--r-lg); padding:18px 16px; transition:var(--t); cursor:default;
}
.learn-card:hover { background:rgba(255,255,255,.1); border-color:rgba(0,176,156,.3); transform:translateY(-3px); }
.learn-card-icon { font-size:1.6rem; margin-bottom:8px; display:block; }
.learn-card h5 { font-size:.9rem; font-weight:700; color:#fff; margin-bottom:4px; }
.learn-card p { font-size:.76rem; color:rgba(255,255,255,.5); margin:0; line-height:1.5; }
.learn-pill { display:inline-flex; align-items:center; gap:4px; background:rgba(0,176,156,.15); color:#5eead4; border-radius:var(--r-pill); padding:3px 10px; font-size:.67rem; font-weight:700; margin-top:8px; }
.learn-actions { display:flex; gap:12px; flex-wrap:wrap; align-items:center; }
.learn-meta { display:flex; gap:16px; flex-wrap:wrap; margin-top:14px; }
.learn-meta-item { display:flex; align-items:center; gap:6px; font-size:.78rem; color:rgba(255,255,255,.5); font-weight:600; }
.learn-meta-item i { color:#5eead4; font-size:.76rem; }

/* ══════════════════════════════════════════
   GRAPHIC DESIGN
══════════════════════════════════════════ */
.graphic-section { background:var(--g-dark); position:relative; overflow:hidden; }
.graphic-section::before {
  content:''; position:absolute; inset:0;
  background:radial-gradient(ellipse at 30% 50%, rgba(26,86,232,.1) 0%, transparent 60%);
}
.graphic-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; position:relative; z-index:1; }
.graphic-card {
  background:rgba(255,255,255,.045); border:1px solid rgba(255,255,255,.08);
  border-radius:var(--r-xl); padding:24px 16px; text-align:center; color:#fff;
  transition:var(--t); cursor:pointer;
}
.graphic-card:hover { background:rgba(255,255,255,.09); border-color:rgba(255,255,255,.18); transform:translateY(-5px); }
.graphic-icon { font-size:1.9rem; margin-bottom:10px; display:block; }
.graphic-card h4 { font-size:.93rem; font-weight:700; margin-bottom:4px; }
.graphic-card p { font-size:.75rem; color:rgba(255,255,255,.5); margin-bottom:10px; }
.graphic-price {
  display:inline-block; background:rgba(232,160,32,.18); color:var(--gold-l);
  border-radius:var(--r-pill); padding:3px 12px; font-size:.67rem; font-weight:800;
}

/* ══════════════════════════════════════════
   TECH STACK
══════════════════════════════════════════ */
.tech-wrap { display:flex; flex-wrap:wrap; gap:9px; justify-content:center; }
.tech-pill {
  display:inline-flex; align-items:center; gap:8px;
  background:#fff; border:1px solid var(--mist); border-radius:var(--r-md);
  padding:9px 15px; font-size:.82rem; font-weight:700; color:var(--ink);
  transition:var(--t); white-space:nowrap;
}
.tech-pill:hover { border-color:var(--primary); color:var(--primary); transform:translateY(-2px); box-shadow:0 7px 18px rgba(26,86,232,.11); }

/* ══════════════════════════════════════════
   PORTFOLIO
══════════════════════════════════════════ */
.portfolio-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
.portfolio-card {
  background:#fff; border-radius:var(--r-xl); overflow:hidden;
  border:1px solid var(--mist); transition:var(--t);
}
.portfolio-card:hover { transform:translateY(-7px); box-shadow:var(--sh-card-h); }
.port-img-wrap { position:relative; overflow:hidden; height:196px; }
.port-img { width:100%; height:100%; object-fit:cover; transition:transform .48s; }
.portfolio-card:hover .port-img { transform:scale(1.06); }
.port-overlay {
  position:absolute; inset:0; background:rgba(26,86,232,.8);
  display:flex; align-items:center; justify-content:center;
  opacity:0; transition:opacity .28s;
}
.portfolio-card:hover .port-overlay { opacity:1; }
.port-overlay i { color:#fff; font-size:1.7rem; transform:scale(.8); transition:transform .28s; }
.portfolio-card:hover .port-overlay i { transform:scale(1); }
.port-body { padding:18px; }
.port-tag {
  display:inline-block; font-size:.65rem; font-weight:800; padding:3px 11px;
  border-radius:var(--r-pill); background:rgba(26,86,232,.09); color:var(--primary);
  text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;
}
.port-body h4 { font-size:1.02rem; font-weight:700; margin-bottom:6px; }
.port-body .desc { font-size:.82rem; color:var(--slate); line-height:1.56; margin-bottom:10px; }
.port-techs { display:flex; flex-wrap:wrap; gap:5px; margin-bottom:14px; }
.tech-sm { background:rgba(26,86,232,.08); color:var(--primary); padding:3px 10px; border-radius:var(--r-pill); font-size:.67rem; font-weight:700; }
.port-filter-row { display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-bottom:30px; }
.pf-btn {
  padding:7px 19px; border-radius:var(--r-pill); font-size:.79rem; font-weight:700; cursor:pointer;
  border:2px solid var(--primary); color:var(--primary); background:transparent;
  font-family:var(--font-head); transition:var(--t);
}
.pf-btn.active, .pf-btn:hover { background:var(--g-primary); color:#fff; border-color:transparent; }

/* ══════════════════════════════════════════
   TEAM
══════════════════════════════════════════ */
.team-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
.team-card {
  background:#fff; border-radius:var(--r-xl); padding:28px 20px; text-align:center;
  border:1px solid var(--mist); transition:var(--t);
}
.team-card:hover { transform:translateY(-7px); box-shadow:var(--sh-card-h); }
.team-avatar { width:92px; height:92px; border-radius:50%; overflow:hidden; margin:0 auto 14px; background:var(--mist); position:relative; }
.team-avatar img { width:100%; height:100%; object-fit:cover; transition:transform .32s; }
.team-card:hover .team-avatar img { transform:scale(1.07); }
.team-avatar-fb { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:2.4rem; color:var(--primary); }
.team-card h5 { font-size:.98rem; font-weight:700; margin-bottom:3px; }
.team-role { font-size:.74rem; color:var(--primary); margin-bottom:8px; font-weight:600; }
.team-bio { font-size:.79rem; color:var(--slate); line-height:1.56; margin-bottom:12px; }
.team-socials { display:flex; justify-content:center; gap:7px; }
.team-socials a {
  width:28px; height:28px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center;
  background:rgba(26,86,232,.07); color:var(--primary); font-size:.82rem; transition:var(--t);
}
.team-socials a:hover { background:var(--primary); color:#fff; transform:translateY(-2px); }

/* ══════════════════════════════════════════
   PRICING
══════════════════════════════════════════ */
.pricing-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:15px; align-items:start; }
.pricing-card {
  background:#fff; border-radius:var(--r-xl); padding:28px 22px;
  border:1px solid var(--mist); transition:var(--t); position:relative; display:flex; flex-direction:column;
}
.pricing-card:not(.featured):hover { transform:translateY(-5px); box-shadow:var(--sh-card-h); }
.pricing-card.featured {
  background:var(--ink); color:#fff; border:none;
  box-shadow:0 24px 60px rgba(6,8,15,.32); transform:scale(1.03); z-index:1;
}
.pricing-card.featured:hover { transform:scale(1.03) translateY(-3px); }
.badge-hot {
  position:absolute; top:16px; right:16px; background:var(--gold); color:#fff;
  font-size:.65rem; font-weight:800; padding:3px 11px; border-radius:var(--r-pill);
  letter-spacing:.5px; text-transform:uppercase;
}
.price-tier { font-size:.8rem; color:var(--slate); margin-bottom:6px; font-weight:500; }
.pricing-card.featured .price-tier { color:rgba(255,255,255,.5); }
.price-val { font-family:var(--font-head); font-size:clamp(1.3rem,2.5vw,1.9rem); font-weight:800; margin-bottom:16px; }
.price-list { list-style:none; flex-grow:1; }
.price-list li { padding:7px 0; border-bottom:1px solid rgba(6,8,15,.05); display:flex; align-items:center; gap:8px; font-size:.82rem; }
.pricing-card.featured .price-list li { border-bottom-color:rgba(255,255,255,.07); }
.price-list li .ok { color:var(--emerald); }
.price-list li .no { color:var(--slate); opacity:.55; }

/* ══════════════════════════════════════════
   TESTIMONIALS
══════════════════════════════════════════ */
.testimonial-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
.testimonial-card {
  background:#fff; border-radius:var(--r-xl); padding:28px 24px;
  border:1px solid var(--mist); transition:var(--t); display:flex; flex-direction:column;
}
.testimonial-card:hover { transform:translateY(-5px); box-shadow:var(--sh-card-h); }
.t-stars { color:var(--gold); letter-spacing:2px; margin-bottom:12px; font-size:1rem; }
.t-quote { font-style:italic; color:var(--slate); line-height:1.76; font-size:.88rem; flex-grow:1; margin-bottom:18px; }
.t-author { display:flex; align-items:center; gap:12px; }
.t-avatar { width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.15rem; flex-shrink:0; }
.t-name { font-weight:700; font-size:.87rem; font-family:var(--font-head); }
.t-role { font-size:.74rem; color:var(--slate); }

/* ══════════════════════════════════════════
   BLOG
══════════════════════════════════════════ */
.blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
.blog-card {
  background:#fff; border-radius:var(--r-xl); padding:26px;
  border:1px solid var(--mist); transition:var(--t); display:flex; flex-direction:column;
}
.blog-card:hover { transform:translateY(-5px); box-shadow:var(--sh-card-h); }
.blog-meta { font-size:.72rem; color:var(--slate); margin-bottom:8px; }
.blog-cat {
  display:inline-block; font-size:.65rem; font-weight:800; padding:3px 11px;
  border-radius:var(--r-pill); text-transform:uppercase; letter-spacing:.5px; margin-bottom:12px;
}
.blog-cat.dev { background:rgba(26,86,232,.09); color:var(--primary); }
.blog-cat.ai  { background:rgba(13,191,126,.09); color:var(--emerald); }
.blog-cat.ui  { background:rgba(108,61,245,.09); color:var(--violet); }
.blog-card h4 { font-size:.98rem; font-weight:700; margin-bottom:8px; line-height:1.4; }
.blog-card .desc { font-size:.82rem; color:var(--slate); line-height:1.62; flex-grow:1; margin-bottom:14px; }

/* ══════════════════════════════════════════
   FAQ
══════════════════════════════════════════ */
.faq-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.faq-item {
  background:#fff; border-radius:var(--r-lg); border:1px solid var(--mist);
  overflow:hidden; transition:border-color .25s;
}
.faq-item:hover { border-color:var(--primary); }
.faq-q {
  padding:15px 20px; font-weight:700; font-size:.88rem; cursor:pointer;
  display:flex; justify-content:space-between; align-items:center;
  font-family:var(--font-head); transition:var(--t);
}
.faq-icon { color:var(--primary); font-size:.76rem; transition:transform .28s; flex-shrink:0; margin-left:12px; }
.faq-a {
  padding:0 20px; max-height:0; overflow:hidden; transition:all .3s;
  color:var(--slate); font-size:.85rem; line-height:1.72;
}
.faq-item.open .faq-a { max-height:200px; padding:0 20px 15px; }
.faq-item.open .faq-icon { transform:rotate(45deg); }

/* ══════════════════════════════════════════
   CONTACT
══════════════════════════════════════════ */
.contact-section { background:var(--g-dark); position:relative; overflow:hidden; }
.contact-section::before {
  content:''; position:absolute; inset:0;
  background:radial-gradient(ellipse at 60% 30%, rgba(26,86,232,.1) 0%, transparent 55%);
}
.contact-form-wrap {
  background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.09);
  border-radius:var(--r-xl); padding:clamp(24px,4vw,42px);
  backdrop-filter:blur(12px); transition:border-color .28s; position:relative; z-index:1;
}
.contact-form-wrap:hover { border-color:rgba(255,255,255,.16); }
.f-label { font-size:.79rem; font-weight:600; color:rgba(255,255,255,.7); display:block; margin-bottom:6px; }
.f-input {
  width:100%; background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.13);
  border-radius:var(--r-md); color:#fff; padding:12px 15px; font-size:.86rem;
  font-family:var(--font-body); transition:var(--t); outline:none;
}
.f-input:focus { background:rgba(255,255,255,.1); border-color:var(--primary); box-shadow:0 0 0 3px rgba(26,86,232,.2); }
.f-input::placeholder { color:rgba(255,255,255,.3); }
select.f-input option { background:var(--ink-2); color:#fff; }
.svc-checks { display:flex; gap:7px; flex-wrap:wrap; }
.svc-chk { display:inline-flex; align-items:center; gap:5px; cursor:pointer; }
.svc-chk input { display:none; }
.svc-chk span {
  background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.13);
  color:rgba(255,255,255,.6); border-radius:var(--r-pill); padding:5px 13px;
  font-size:.75rem; font-weight:600; transition:var(--t);
}
.svc-chk input:checked + span { background:var(--primary); border-color:var(--primary); color:#fff; }
.svc-chk:hover span { background:rgba(255,255,255,.12); }
.or-div { text-align:center; position:relative; margin:18px 0; }
.or-div::before, .or-div::after {
  content:''; position:absolute; top:50%; width:calc(50% - 60px); height:1px; background:rgba(255,255,255,.12);
}
.or-div::before { left:0; } .or-div::after { right:0; }
.or-div span { background:rgba(255,255,255,.04); padding:5px 14px; border-radius:var(--r-pill); font-size:.75rem; color:rgba(255,255,255,.4); }
.contact-info-card {
  background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.09);
  border-radius:var(--r-lg); padding:17px 13px; text-align:center; transition:var(--t);
}
.contact-info-card:hover { background:rgba(255,255,255,.08); transform:translateY(-3px); }
.ci-icon {
  width:42px; height:42px; background:rgba(26,86,232,.18); border-radius:50%;
  display:flex; align-items:center; justify-content:center; margin:0 auto 10px;
  color:var(--gold); font-size:1.05rem; transition:var(--t);
}
.contact-info-card:hover .ci-icon { background:var(--g-primary); color:#fff; }
.contact-info-card h6 { color:#fff; font-size:.81rem; font-weight:700; margin-bottom:4px; }
.contact-info-card a, .contact-info-card span { font-size:.77rem; color:rgba(255,255,255,.48); }
.contact-info-card a:hover { color:var(--gold); }

/* ══════════════════════════════════════════
   NEWSLETTER
══════════════════════════════════════════ */
.newsletter-section { background:linear-gradient(135deg, #eef2ff, #ecfdf5); }
.newsletter-box {
  background:#fff; border-radius:var(--r-xl); padding:clamp(28px,4vw,48px) clamp(24px,4vw,44px);
  border:1px solid var(--mist); box-shadow:var(--sh-card); transition:var(--t);
}
.newsletter-box:hover { transform:translateY(-2px); box-shadow:var(--sh-card-h); }
.nl-icon { width:50px; height:50px; background:rgba(26,86,232,.09); border-radius:14px; display:flex; align-items:center; justify-content:center; font-size:1.45rem; color:var(--primary); margin-bottom:14px; }
.nl-form { position:relative; display:flex; align-items:center; }
.nl-form i { position:absolute; left:16px; color:var(--slate); font-size:.9rem; pointer-events:none; }
.nl-form-inp {
  width:100%; padding:13px 145px 13px 42px; border:2px solid var(--mist); border-radius:var(--r-pill);
  font-size:.86rem; font-family:var(--font-body); transition:var(--t); background:#fff; color:var(--ink); outline:none;
}
.nl-form-inp:focus { border-color:var(--primary); box-shadow:0 0 0 3px rgba(26,86,232,.09); }
.nl-submit {
  position:absolute; right:5px; top:50%; transform:translateY(-50%);
  background:var(--g-primary); color:#fff; border:none; padding:7px 20px;
  border-radius:var(--r-pill); font-weight:700; font-size:.79rem; font-family:var(--font-head);
  transition:var(--t); cursor:pointer; white-space:nowrap;
}
.nl-submit:hover { background:var(--g-gold); }
.nl-submit:disabled { opacity:.65; cursor:not-allowed; }

/* ══════════════════════════════════════════
   CTA BAND
══════════════════════════════════════════ */
.cta-section { background:linear-gradient(135deg,var(--gold) 0%,#ea6310 50%,#dc2626 100%); }

/* ══════════════════════════════════════════
   FOOTER
══════════════════════════════════════════ */
footer { background:var(--ink); color:rgba(255,255,255,.55); padding:60px 0 28px; }
footer h5 { color:#fff; margin-bottom:14px; font-size:.88rem; font-family:var(--font-head); font-weight:700; }
footer ul { list-style:none; }
footer ul li { padding:4px 0; font-size:.82rem; }
footer a { color:rgba(255,255,255,.48); transition:color .22s; }
footer a:hover { color:var(--gold); }
.footer-div { border:none; border-top:1px solid rgba(255,255,255,.07); margin:28px 0 22px; }
.footer-bottom { color:rgba(255,255,255,.35); font-size:.77rem; }
.social-btn {
  width:32px; height:32px; border-radius:50%;
  display:inline-flex; align-items:center; justify-content:center;
  background:rgba(255,255,255,.07); color:rgba(255,255,255,.65);
  transition:var(--t); font-size:.83rem;
}
.social-btn:hover { background:var(--primary); color:#fff; transform:translateY(-2px); }
.social-btn.wa:hover { background:linear-gradient(135deg,#25D366,#128C7E); }
.footer-logo { max-width:140px; }

/* ══════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════ */
@media (max-width:1199px) {
  .services-grid { grid-template-columns:repeat(3,1fr); }
  .graphic-grid  { grid-template-columns:repeat(3,1fr); }
  .pricing-grid  { grid-template-columns:repeat(2,1fr); }
}
@media (max-width:991px) {
  .nav-links, .nav-cta { display:none !important; }
  .ham-btn { display:flex !important; }
  .mob-overlay { display:block; }
  .hero-inner { grid-template-columns:1fr; }
  .code-box { display:none; }
  .stats-grid   { grid-template-columns:repeat(2,1fr); }
  .process-grid { grid-template-columns:repeat(2,1fr); }
  .team-grid    { grid-template-columns:repeat(2,1fr); }
  .faq-grid     { grid-template-columns:1fr; }
  .testimonial-grid { grid-template-columns:repeat(2,1fr); }
  .blog-grid    { grid-template-columns:repeat(2,1fr); }
  .process-arrow { display:none; }
  .learn-inner  { grid-template-columns:1fr; }
}
@media (max-width:767px) {
  .services-grid  { grid-template-columns:repeat(2,1fr); }
  .graphic-grid   { grid-template-columns:repeat(2,1fr); }
  .portfolio-grid { grid-template-columns:1fr; }
  .pricing-grid   { grid-template-columns:1fr; }
  .pricing-card.featured { transform:scale(1); }
  .blog-grid { grid-template-columns:1fr; }
  .testimonial-grid { grid-template-columns:1fr; }
  .contact-form-wrap { padding:22px 18px; }
  .hero h1 { font-size:2.2rem; }
  .svc-overlay { display:none; }
  #wa-float { width:50px; height:50px; border-radius:50%; padding:0; justify-content:center; bottom:82px; right:18px; max-width:50px; }
  #wa-float .wa-text { display:none; }
  .wa-circle { width:50px; height:50px; font-size:1.45rem; border-radius:50%; }
  #back-to-top { bottom:18px; right:18px; }
  #theme-toggle { bottom:18px; left:18px; }
  .nl-form { flex-direction:column; }
  .nl-form i { top:17px; }
  .nl-form-inp { padding:12px 15px 12px 42px; border-radius:var(--r-lg); }
  .nl-submit { position:static; transform:none; width:100%; margin-top:8px; padding:10px; border-radius:var(--r-lg); }
  .learn-banner-inner { flex-direction:column; align-items:flex-start; }
  .learn-cards { grid-template-columns:1fr; }
  .hero-actions { flex-direction:column; }
}
@media (max-width:480px) {
  .stats-grid { grid-template-columns:repeat(2,1fr); }
  .team-grid  { grid-template-columns:repeat(2,1fr); }
}

/* Form helpers */
.form-row { display:grid; gap:15px; }
.form-row.cols-2 { grid-template-columns:1fr 1fr; }
@media (max-width:560px) { .form-row.cols-2 { grid-template-columns:1fr; } }
.form-group { display:flex; flex-direction:column; }
.mt-12{margin-top:12px;} .mt-16{margin-top:16px;} .mt-20{margin-top:20px;}
