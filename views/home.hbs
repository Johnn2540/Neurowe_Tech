  border-radius:var(--r-md); color:#fff; padding:12px 16px; font-size:.87rem;
  font-family:var(--font-body); transition:var(--t); outline:none;
}
.f-input:focus { background:rgba(255,255,255,.11); border-color:var(--cobalt); box-shadow:0 0 0 3px rgba(37,99,235,.22); }
.f-input::placeholder { color:rgba(255,255,255,.35); }
select.f-input option { background:var(--ink-2); color:#fff; }
.svc-checks { display:flex; gap:8px; flex-wrap:wrap; }
.svc-chk { display:inline-flex; align-items:center; gap:5px; cursor:pointer; }
.svc-chk input { display:none; }
.svc-chk span {
  background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.15);
  color:rgba(255,255,255,.65); border-radius:var(--r-pill); padding:5px 14px;
  font-size:.76rem; font-weight:600; transition:var(--t);
}
.svc-chk input:checked + span { background:var(--cobalt); border-color:var(--cobalt); color:#fff; }
.svc-chk:hover span { background:rgba(255,255,255,.13); }
.or-div {
  text-align:center; position:relative; margin:18px 0;
}
.or-div::before, .or-div::after {
  content:''; position:absolute; top:50%; width:calc(50% - 70px); height:1px; background:rgba(255,255,255,.15);
}
.or-div::before { left:0; } .or-div::after { right:0; }
.or-div span { background:rgba(255,255,255,.04); padding:5px 14px; border-radius:var(--r-pill); font-size:.76rem; color:rgba(255,255,255,.45); }
.contact-info-card {
  background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1);
  border-radius:var(--r-lg); padding:18px 14px; text-align:center; transition:var(--t);
}
