<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script>
AOS.init({duration:750,once:true,offset:55,easing:'ease-out-cubic'});

/* CUSTOM CURSOR */
(function(){
  var dot=document.getElementById('cursor-dot');
  var ring=document.getElementById('cursor-ring');
  if(!dot||!ring)return;
  var mx=0,my=0,rx=0,ry=0;
  window.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;dot.style.left=mx+'px';dot.style.top=my+'px';},{passive:true});
  function lerpCursor(){rx+=(mx-rx)*.12;ry+=(my-ry)*.12;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(lerpCursor);}
  lerpCursor();
  document.querySelectorAll('a,button,[role="button"]').forEach(function(el){
    el.addEventListener('mouseenter',function(){document.body.classList.add('cursor-hover')});
    el.addEventListener('mouseleave',function(){document.body.classList.remove('cursor-hover')});
  });
})();

/* HERO PARTICLE CANVAS */
(function(){
  var canvas=document.getElementById('hero-canvas');
  if(!canvas)return;
  var ctx=canvas.getContext('2d');
  var particles=[];
  var PARTICLE_COUNT=50;
  function resize(){canvas.width=canvas.offsetWidth;canvas.height=canvas.offsetHeight;}
  resize();
  window.addEventListener('resize',resize,{passive:true});
  function rand(min,max){return Math.random()*(max-min)+min;}
  for(var i=0;i<PARTICLE_COUNT;i++){
    particles.push({x:rand(0,canvas.width),y:rand(0,canvas.height),vx:rand(-.16,.16),vy:rand(-.16,.16),r:rand(1,2.2),alpha:rand(.14,.5),color:Math.random()>.6?'rgba(224,92,42,':'rgba(37,99,235,'});
  }
  function drawParticles(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    particles.forEach(function(p){
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<0)p.x=canvas.width;if(p.x>canvas.width)p.x=0;
      if(p.y<0)p.y=canvas.height;if(p.y>canvas.height)p.y=0;
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle=p.color+p.alpha+')';ctx.fill();
    });
    for(var a=0;a<particles.length;a++){for(var b=a+1;b<particles.length;b++){var dx=particles[a].x-particles[b].x;var dy=particles[a].y-particles[b].y;var dist=Math.sqrt(dx*dx+dy*dy);if(dist<105){ctx.beginPath();ctx.moveTo(particles[a].x,particles[a].y);ctx.lineTo(particles[b].x,particles[b].y);ctx.strokeStyle='rgba(79,120,235,'+(0.05*(1-dist/105))+')';ctx.lineWidth=.6;ctx.stroke();}}}
    requestAnimationFrame(drawParticles);
  }
  drawParticles();
})();

/* TYPEWRITER */
(function(){
  var el=document.getElementById('heroTypewriter');
  if(!el)return;
  var phrases=['Products that actually ship.','MVPs in 6 weeks, guaranteed.','Ideas that scale beyond borders.','Experiences users remember.','Software for the next decade.','Africa\'s future, built today.'];
  var phraseIdx=0,charIdx=0,deleting=false;
  var CURSOR='<span class="tw-cursor"></span>';
  var TYPE_SPEED=52,DELETE_SPEED=28,PAUSE_FULL=2200,PAUSE_EMPTY=420;
  function tick(){
    var phrase=phrases[phraseIdx];
    if(!deleting){charIdx++;el.innerHTML=phrase.slice(0,charIdx)+CURSOR;if(charIdx===phrase.length){deleting=true;setTimeout(tick,PAUSE_FULL);return;}setTimeout(tick,TYPE_SPEED);}
    else{charIdx--;el.innerHTML=phrase.slice(0,charIdx)+CURSOR;if(charIdx===0){deleting=false;phraseIdx=(phraseIdx+1)%phrases.length;setTimeout(tick,PAUSE_EMPTY);return;}setTimeout(tick,DELETE_SPEED);}
  }
  setTimeout(tick,1200);
})();

/* HERO SLIDESHOW */
(function(){
  var SLIDE_DURATION=7000;
  var slides=document.querySelectorAll('.hero-slide');
  var dots=document.querySelectorAll('.slider-dot');
  var wraps=document.querySelectorAll('.slider-dot-wrap');
  var counter=document.getElementById('slideCountCurrent');
  var prevBtn=document.getElementById('slidePrev');
  var nextBtn=document.getElementById('slideNext');
  var current=0,timer=null,total=slides.length;
  if(!total)return;
  function pad(n){return n<10?'0'+n:''+n;}
  function goTo(idx,restart){
    slides[current].classList.remove('active');
    var oldImg=slides[current].querySelector('img');
    if(oldImg){oldImg.style.animation='none';void oldImg.offsetWidth;}
    dots[current].classList.remove('active');
    wraps[current].classList.remove('active');
    current=((idx%total)+total)%total;
    slides[current].classList.add('active');
    var newImg=slides[current].querySelector('img');
    if(newImg){newImg.style.animation='none';void newImg.offsetWidth;newImg.style.animation='slide-ken-burns '+SLIDE_DURATION+'ms ease-in-out forwards';}
    dots[current].classList.add('active');
    wraps[current].classList.add('active');
    wraps[current].querySelectorAll('.slider-dot-ring').forEach(function(r){r.style.animation='none';void r.offsetWidth;r.style.animation='ring-fill '+SLIDE_DURATION+'ms linear forwards';});
    if(counter)counter.textContent=pad(current+1);
    if(restart!==false)startTimer();
  }
  function startTimer(){clearInterval(timer);timer=setInterval(function(){goTo(current+1);},SLIDE_DURATION);}
  goTo(0,true);
  dots.forEach(function(d){d.addEventListener('click',function(){goTo(+d.dataset.i);});});
  if(prevBtn)prevBtn.addEventListener('click',function(){goTo(current-1);});
  if(nextBtn)nextBtn.addEventListener('click',function(){goTo(current+1);});
  var touchStartX=0;
  var heroEl=document.querySelector('.hero');
  if(heroEl){
    heroEl.addEventListener('touchstart',function(e){touchStartX=e.changedTouches[0].clientX;},{passive:true});
    heroEl.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-touchStartX;if(Math.abs(dx)>50)goTo(dx<0?current+1:current-1);},{passive:true});
    heroEl.addEventListener('mouseenter',function(){clearInterval(timer);});
    heroEl.addEventListener('mouseleave',function(){startTimer();});
  }
  document.addEventListener('keydown',function(e){if(e.key==='ArrowLeft')goTo(current-1);if(e.key==='ArrowRight')goTo(current+1);});
})();

/* SCROLL / NAV */
function smoothTo(id){var el=document.querySelector(id);if(!el)return;var off=document.getElementById('mainNav').offsetHeight;window.scrollTo({top:el.getBoundingClientRect().top+window.pageYOffset-off,behavior:'smooth'});}
document.addEventListener('click',function(e){var link=e.target.closest('a[href^="#"]');if(!link)return;var href=link.getAttribute('href');if(!href||href.length<=1)return;e.preventDefault();closeMob();var delay=window.innerWidth<992?310:0;setTimeout(function(){smoothTo(href);},delay);});

var navbar=document.getElementById('mainNav');
var backToTop=document.getElementById('back-to-top');
var scrollPrg=document.getElementById('scroll-progress');
var scrollInd=document.getElementById('scroll-ind');
window.addEventListener('scroll',function(){
  var st=window.pageYOffset;
  var docH=document.documentElement.scrollHeight-window.innerHeight;
  scrollPrg.style.width=(docH>0?(st/docH)*100:0)+'%';
  navbar.classList.toggle('scrolled',st>40);
  backToTop.classList.toggle('visible',st>400);
  if(scrollInd)scrollInd.classList.toggle('hidden',st>100);
  var cur='';
  document.querySelectorAll('section[id]').forEach(function(s){if(st>=s.offsetTop-navbar.offsetHeight-30)cur=s.id;});
  document.querySelectorAll('.nav-links .nl-a').forEach(function(a){a.classList.toggle('active',a.getAttribute('href')==='#'+cur);});
},{passive:true});
if(scrollInd)scrollInd.addEventListener('click',function(){smoothTo('#services');});
backToTop.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});

/* MOBILE NAV */
var mobOverlay=document.getElementById('mobOverlay');
var mobPanel=document.getElementById('mobPanel');
var hamBtn=document.getElementById('hamBtn');
var mobClose=document.getElementById('mobClose');
var mobSvcToggle=document.getElementById('mobSvcToggle');
var mobSvcSub=document.getElementById('mobSvcSub');
function openMob(){mobOverlay.classList.add('open');mobPanel.classList.add('open');hamBtn.classList.add('open');hamBtn.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';mobClose.focus();}
function closeMob(){mobPanel.classList.remove('open');mobOverlay.classList.remove('open');hamBtn.classList.remove('open');hamBtn.setAttribute('aria-expanded','false');document.body.style.overflow='';}
hamBtn.addEventListener('click',openMob);
mobClose.addEventListener('click',closeMob);
mobOverlay.addEventListener('click',closeMob);
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&mobPanel.classList.contains('open'))closeMob();});
mobSvcToggle.addEventListener('click',function(){var isOpen=mobSvcSub.classList.toggle('open');mobSvcToggle.classList.toggle('open',isOpen);mobSvcToggle.setAttribute('aria-expanded',isOpen);});

/* THEME */
var themeBtn=document.getElementById('theme-toggle');
var mobThemeBtn=document.getElementById('mobThemeBtn');
var dark=localStorage.getItem('nw-theme')==='dark'||(!localStorage.getItem('nw-theme')&&window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON='<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN='<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme(){document.body.classList.toggle('dark',dark);themeBtn.innerHTML=dark?SUN:MOON;if(mobThemeBtn)mobThemeBtn.innerHTML=dark?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>';}
applyTheme();
function toggleTheme(){dark=!dark;localStorage.setItem('nw-theme',dark?'dark':'light');applyTheme();}
themeBtn.addEventListener('click',toggleTheme);
if(mobThemeBtn)mobThemeBtn.addEventListener('click',toggleTheme);

/* TOAST / COOKIE */
function showToast(msg,col){var t=document.getElementById('toast');t.style.borderLeftColor=col||'var(--emerald)';document.getElementById('toast-msg').textContent=msg;t.classList.add('show');setTimeout(function(){t.classList.remove('show');},3800);}
var cookieBar=document.getElementById('cookie-bar');
if(!localStorage.getItem('nw-cookie'))setTimeout(function(){cookieBar.classList.add('show');},2600);
document.getElementById('cookie-accept').addEventListener('click',function(){localStorage.setItem('nw-cookie','1');cookieBar.classList.remove('show');});

/* COUNTER */
var cObs=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(!entry.isIntersecting)return;var c=entry.target.querySelector('.counter');if(!c||c.dataset.done)return;c.dataset.done='1';var target=+c.dataset.target,step=target/(1600/16),val=0;(function tick(){val=Math.min(val+step,target);c.textContent=Math.floor(val);if(val<target)requestAnimationFrame(tick);})();});},{threshold:.4});
document.querySelectorAll('.stat-card').forEach(function(el){cObs.observe(el);});

/* PORTFOLIO FILTER */
document.querySelectorAll('.pf-btn').forEach(function(btn){
  btn.addEventListener('click',function(){
    document.querySelectorAll('.pf-btn').forEach(function(b){b.classList.remove('active');});
    btn.classList.add('active');
    var f=btn.dataset.filter;
    document.querySelectorAll('#portfolioGrid [data-cat]').forEach(function(item){item.style.display=(f==='all'||item.dataset.cat===f)?'':'none';});
  });
});

/* FAQ */
document.querySelectorAll('.faq-q').forEach(function(q){
  q.addEventListener('click',function(){
    var item=q.parentElement,isOpen=item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(function(i){i.classList.remove('open');});
    if(!isOpen)item.classList.add('open');
  });
});

/* WA TOOLTIP */
(function(){
  var shown=sessionStorage.getItem('nw-wa-tip');
  if(!shown){setTimeout(function(){var tip=document.getElementById('wa-tooltip');if(tip){tip.classList.add('show');sessionStorage.setItem('nw-wa-tip','1');}},5200);}
  var closeBtn=document.getElementById('waTooltipClose');
  if(closeBtn){closeBtn.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();document.getElementById('wa-tooltip').classList.remove('show');});}
  var badge=document.getElementById('waBadge');
  var floatEl=document.getElementById('wa-float');
  if(floatEl&&badge){floatEl.addEventListener('mouseenter',function(){badge.style.opacity='0';badge.style.transform='scale(0)';});floatEl.addEventListener('click',function(){var tip=document.getElementById('wa-tooltip');if(tip)tip.classList.remove('show');});}
})();

/* NEWSLETTER */
document.getElementById('nlForm').addEventListener('submit',async function(e){
  e.preventDefault();
  var email=document.getElementById('nlEmail').value.trim();
  var consent=document.getElementById('nlConsent').checked;
  var btn=document.getElementById('nlBtn'),msg=document.getElementById('nlMsg');
  if(!email||!/^\S+@\S+\.\S+$/.test(email)){msg.innerHTML='<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Please enter a valid email.</span>';return;}
  if(!consent){msg.innerHTML='<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Please agree to receive emails.</span>';return;}
  var orig=btn.innerHTML;btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Subscribing...';btn.disabled=true;
  try{
    var res=await fetch('/subscribe',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email})});
    var data=await res.json();
    if(data.success){msg.innerHTML='<span style="color:var(--emerald)"><i class="fas fa-check-circle"></i> 🎉 Subscribed!</span>';document.getElementById('nlForm').reset();document.getElementById('nlConsent').checked=true;showToast('Subscribed! Welcome aboard 🎉');}
    else{msg.innerHTML='<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> '+(data.message||'Failed. Please try again.')+'</span>';}
  }catch(err){msg.innerHTML='<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Network error. Please try again.</span>';}
  finally{btn.innerHTML=orig;btn.disabled=false;setTimeout(function(){msg.innerHTML='';},5500);}
});
</script>
