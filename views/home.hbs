.ci-icon{width:40px;height:40px;background:rgba(26,79,214,.16);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 9px;color:var(--orange-l);font-size:.95rem;transition:var(--t)}
.contact-info-card:hover .ci-icon{background:var(--g-blue);color:#fff}
.contact-info-card h6{color:#fff;font-size:.78rem;font-weight:700;margin-bottom:3px;font-family:'Plus Jakarta Sans',sans-serif}
.contact-info-card a,.contact-info-card span{font-size:.73rem;color:rgba(255,255,255,.44);word-break:break-all}
.contact-info-card a:hover{color:var(--orange-l)}

@media(min-width:600px){
  .container{padding:0 28px}
  .services-grid{grid-template-columns:repeat(2,1fr)}
  .graphic-grid{grid-template-columns:repeat(2,1fr)}
  .portfolio-grid{grid-template-columns:repeat(2,1fr)}
  .testimonial-grid{grid-template-columns:repeat(2,1fr)}
  .blog-grid{grid-template-columns:repeat(2,1fr)}
  .process-grid{grid-template-columns:repeat(2,1fr)}
  .faq-grid{grid-template-columns:1fr 1fr}
  .pricing-grid{grid-template-columns:repeat(2,1fr)}
  .grid-3-contact{grid-template-columns:repeat(3,1fr)}
  .hero-actions .btn{flex:initial;min-width:auto}
}
@media(min-width:992px){
  :root{--nav-h:72px}
  .container{padding:0 32px}
  .nav-inner{padding:0 32px}
  .nav-links{display:flex}
  .nav-cta{display:flex}
  .ham-btn{display:none!important}
  .mob-quick{display:none!important}
  .hero-inner{flex-direction:row;align-items:center;gap:56px;padding:80px 0 100px}
  .hero-inner>div:first-child{flex:1}
  .hero-inner>div:last-child{flex:1;flex-shrink:0}
  .hero-actions{flex-wrap:nowrap}
  .hero-actions .btn{flex:initial;padding:13px 26px;font-size:.92rem;min-width:auto;max-width:none}
  .services-grid{grid-template-columns:repeat(4,1fr)}
  .graphic-grid{grid-template-columns:repeat(4,1fr)}
  .portfolio-grid{grid-template-columns:repeat(3,1fr)}
  .testimonial-grid{grid-template-columns:repeat(3,1fr)}
  .blog-grid{grid-template-columns:repeat(3,1fr)}
  .stats-grid{grid-template-columns:repeat(4,1fr)}
  .pricing-grid{grid-template-columns:repeat(4,1fr);align-items:start}
  .pricing-card.featured{transform:scale(1.03);z-index:1}
  .pricing-card.featured:hover{transform:scale(1.03) translateY(-3px)}
  .team-grid{grid-template-columns:repeat(4,1fr)}
  .process-grid{grid-template-columns:repeat(4,1fr)}
  .process-arrow{display:flex;position:absolute;top:50%;right:-14px;transform:translateY(-50%);width:26px;height:26px;background:var(--g-blue);border-radius:50%;align-items:center;justify-content:center;color:#fff;font-size:.62rem;z-index:2;box-shadow:var(--sh-blue)}
  .learn-inner{grid-template-columns:1fr 1fr;gap:60px}
  .nl-grid{grid-template-columns:1fr 1fr;align-items:center}
  .nl-form{flex-wrap:nowrap}
  .nl-form-inp{padding:13px 150px 13px 44px;border-radius:var(--r-pill)}
  .nl-submit{position:absolute;right:5px;top:50%;transform:translateY(-50%)}
}
@media(max-width:991px){
  .svc-overlay{display:none}
  .learn-banner-badges{display:none}
}
@media print{
  .navbar,#wa-float,#wa-tooltip,#theme-toggle,#back-to-top,#scroll-progress,#cookie-bar{display:none!important}
}
</style>
