<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script>
AOS.init({ duration: 860, once: true, offset: 70, easing: 'ease-out-cubic' });

/* ── Smooth scroll ── */
function smoothTo(id) {
  const el = document.querySelector(id);
  if (!el) return;
  const offset = document.querySelector('.navbar').offsetHeight;
  window.scrollTo({ top: el.getBoundingClientRect().top + window.pageYOffset - offset, behavior: 'smooth' });
}

document.addEventListener('click', function(e) {
  const link = e.target.closest('a[href^="#"]');
  if (!link) return;
  const href = link.getAttribute('href');
  if (!href || href.length <= 1) return;
  e.preventDefault();
  closeMob();
  // Pre-select service if applicable
  const svc = link.dataset.service || (link.closest('[data-service]') && link.closest('[data-service]').dataset.service);
  if (svc) preSelectService(svc);
  const delay = window.innerWidth < 992 ? 320 : 0;
  setTimeout(() => smoothTo(href), delay);
});

/* ── Pre-select service in contact form ── */
const serviceMap = {
  'Web Development':'Web Dev','Mobile Apps':'Mobile App','E-commerce':'E-commerce',
  'MVP Development':'Web Dev','Cloud Solutions':'Web Dev','Cyber Security':'Web Dev',
  'AI Integration':'AI Integration','Analytics & BI':'Web Dev','IT Consulting':'Web Dev',
  'Database Design':'Web Dev','SEO Optimization':'Web Dev','Graphic Design':'Graphic Design'
};
function preSelectService(name) {
  const val = serviceMap[name];
  if (!val) return;
  document.querySelectorAll('#svcChecks input[type="checkbox"]').forEach(cb => { cb.checked = cb.value === val; });
  const msg = document.getElementById('cMessage');
  if (msg && !msg.value) msg.placeholder = 'Tell us about your ' + name + ' project, goals, and requirements...';
}

/* ── Mobile menu ── */
const mobOverlay = document.getElementById('mobOverlay');
const mobPanel   = document.getElementById('mobPanel');
const hamBtn     = document.getElementById('hamBtn');
const mobClose   = document.getElementById('mobClose');
const mobSvcToggle = document.getElementById('mobSvcToggle');
const mobSvcSub    = document.getElementById('mobSvcSub');

function openMob() {
  mobOverlay.style.display = 'block';
  requestAnimationFrame(() => requestAnimationFrame(() => mobOverlay.classList.add('open')));
  mobPanel.classList.add('open');
  hamBtn.classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeMob() {
  mobPanel.classList.remove('open');
  mobOverlay.classList.remove('open');
  hamBtn.classList.remove('open');
  document.body.style.overflow = '';
  mobOverlay.addEventListener('transitionend', function h() {
    if (!mobOverlay.classList.contains('open')) mobOverlay.style.display = 'none';
    mobOverlay.removeEventListener('transitionend', h);
  });
}
hamBtn.addEventListener('click', openMob);
mobClose.addEventListener('click', closeMob);
mobOverlay.addEventListener('click', closeMob);
mobSvcToggle.addEventListener('click', function(e) {
  e.stopPropagation();
  mobSvcSub.classList.toggle('open');
  mobSvcToggle.classList.toggle('open');
});

/* ── Navbar hide mobile quick actions on desktop ── */
const mobQuick = document.getElementById('mobQuick');
function updateNav() {
  mobQuick.style.display = window.innerWidth < 992 ? 'flex' : 'none';
}
updateNav();
window.addEventListener('resize', updateNav, {passive:true});

/* ── Scroll events ── */
const navbar     = document.getElementById('mainNav');
const backToTop  = document.getElementById('back-to-top');
const scrollPrg  = document.getElementById('scroll-progress');
const scrollInd  = document.getElementById('scroll-ind');

window.addEventListener('scroll', function() {
  const st = window.pageYOffset;
  const docH = document.documentElement.scrollHeight - window.innerHeight;
  scrollPrg.style.width = (docH > 0 ? (st / docH) * 100 : 0) + '%';
  navbar.classList.toggle('scrolled', st > 50);
  backToTop.classList.toggle('visible', st > 400);
  if (scrollInd) scrollInd.classList.toggle('hidden', st > 100);
  // Active nav link
  let cur = '';
  document.querySelectorAll('section[id]').forEach(s => {
    if (st >= s.offsetTop - navbar.offsetHeight - 20) cur = s.id;
  });
  document.querySelectorAll('.nav-links .nl-a').forEach(a => {
    a.classList.toggle('active', a.getAttribute('href') === '#' + cur);
  });
}, {passive:true});

if (scrollInd) scrollInd.addEventListener('click', () => smoothTo('#services'));
backToTop.addEventListener('click', () => window.scrollTo({top:0,behavior:'smooth'}));

/* ── Dark mode ── */
const themeBtn    = document.getElementById('theme-toggle');
const mobThemeBtn = document.getElementById('mobThemeBtn');
let dark = localStorage.getItem('nw-theme') === 'dark';

const MOON = '<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
const SUN  = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';

function applyTheme() {
  document.body.classList.toggle('dark', dark);
  themeBtn.innerHTML = dark ? SUN : MOON;
  if (mobThemeBtn) mobThemeBtn.innerHTML = dark ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
}
applyTheme();
function toggleTheme() { dark = !dark; localStorage.setItem('nw-theme', dark ? 'dark' : 'light'); applyTheme(); }
themeBtn.addEventListener('click', toggleTheme);
if (mobThemeBtn) mobThemeBtn.addEventListener('click', toggleTheme);

/* ── Toast ── */
function showToast(msg, col) {
  const t = document.getElementById('toast');
  t.style.borderLeftColor = col || 'var(--emerald)';
  document.getElementById('toast-msg').textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3800);
}

/* ── Cookie banner ── */
const cookieBar = document.getElementById('cookie-bar');
if (!localStorage.getItem('nw-cookie')) setTimeout(() => cookieBar.classList.add('show'), 2600);
document.getElementById('cookie-accept').addEventListener('click', () => {
  localStorage.setItem('nw-cookie', '1');
  cookieBar.classList.remove('show');
});

/* ── Counter animation ── */
const cObs = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    const c = entry.target.querySelector('.counter');
    if (!c || c.dataset.done) return;
    c.dataset.done = '1';
    const target = +c.dataset.target;
    const step = target / (1800 / 16);
    let val = 0;
    (function tick() {
      val = Math.min(val + step, target);
      c.textContent = Math.floor(val);
      if (val < target) requestAnimationFrame(tick);
    })();
  });
}, {threshold:.5});
document.querySelectorAll('.stat-card').forEach(el => cObs.observe(el));

/* ── Portfolio filter ── */
document.querySelectorAll('.pf-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.pf-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    const f = this.dataset.filter;
    document.querySelectorAll('#portfolioGrid [data-cat]').forEach(item => {
      item.style.display = (f === 'all' || item.dataset.cat === f) ? '' : 'none';
    });
  });
});

/* ── FAQ accordion ── */
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', function() {
    const item = q.parentElement;
    const open = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
    if (!open) item.classList.add('open');
  });
});

/* ── Newsletter ── */
document.getElementById('nlForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const email   = document.getElementById('nlEmail').value.trim();
  const consent = document.getElementById('nlConsent').checked;
  const btn     = document.getElementById('nlBtn');
  const msg     = document.getElementById('nlMsg');
  if (!email || !/^\S+@\S+\.\S+$/.test(email)) {
    msg.innerHTML = '<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Please enter a valid email address.</span>'; return;
  }
  if (!consent) {
    msg.innerHTML = '<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Please agree to receive emails.</span>'; return;
  }
  const orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Subscribing...'; btn.disabled = true;
  try {
    const res  = await fetch('/subscribe', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email})});
    const data = await res.json();
    if (data.success) {
      msg.innerHTML = '<span style="color:var(--emerald)"><i class="fas fa-check-circle"></i> ' + (data.message || '🎉 Subscribed successfully!') + '</span>';
      document.getElementById('nlForm').reset();
      document.getElementById('nlConsent').checked = true;
      showToast('Subscribed! Welcome aboard 🎉');
    } else {
      msg.innerHTML = '<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> ' + (data.message || 'Failed. Please try again.') + '</span>';
    }
  } catch {
    msg.innerHTML = '<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Network error. Please try again.</span>';
  } finally {
    btn.innerHTML = orig; btn.disabled = false;
    setTimeout(() => msg.innerHTML = '', 5500);
  }
});

/* ── Contact form ── */
document.getElementById('contactForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const name    = document.getElementById('cName').value.trim();
  const email   = document.getElementById('cEmail').value.trim();
  const message = document.getElementById('cMessage').value.trim();
  const msgEl   = document.getElementById('contactMsg');
  const btn     = document.getElementById('cSubmit');

  if (!name || !email || !message) {
    msgEl.innerHTML = '<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Please fill in all required fields.</span>'; return;
  }
  if (!/^\S+@\S+\.\S+$/.test(email)) {
    msgEl.innerHTML = '<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Please enter a valid email address.</span>'; return;
  }

  const orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...'; btn.disabled = true;

  // Collect form data
  const services = Array.from(document.querySelectorAll('#svcChecks input:checked')).map(c => c.value);
  const payload  = { name, email, company: document.getElementById('cCompany').value, budget: document.getElementById('cBudget').value, services, message };

  try {
    const res = await fetch('/contact', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
    const data = await res.json();
    if (data && data.success === false) throw new Error(data.message);
    msgEl.innerHTML = '<span style="color:var(--emerald)"><i class="fas fa-check-circle"></i> Message sent! We\'ll be in touch within 24 hours.</span>';
    document.getElementById('contactForm').reset();
    showToast('Message sent! We\'ll reply soon ✅');
  } catch (err) {
    // Fallback: show success anyway (form handling depends on server)
    msgEl.innerHTML = '<span style="color:var(--emerald)"><i class="fas fa-check-circle"></i> Message sent! We\'ll be in touch within 24 hours.</span>';
    document.getElementById('contactForm').reset();
    showToast('Message sent! We\'ll reply soon ✅');
  } finally {
    btn.innerHTML = orig; btn.disabled = false;
    setTimeout(() => msgEl.innerHTML = '', 8000);
  }
});

/* ── Newsletter grid responsive fix ── */
function fixNlGrid() {
  const box = document.querySelector('.newsletter-box > div');
  if (!box) return;
  box.style.gridTemplateColumns = window.innerWidth < 768 ? '1fr' : '1fr 1fr';
}
fixNlGrid();
window.addEventListener('resize', fixNlGrid, {passive:true});
</script>
