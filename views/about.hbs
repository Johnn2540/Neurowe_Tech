<style>
:root {
  --primary:#1c2b4a; --primary-d:#111d33; --primary-l:#2d4270;
  --accent:#e05c2a; --accent-d:#c44e21; --accent-l:#f07040; --accent-pale:rgba(224,92,42,.08);
  --blue:#2563eb; --blue-d:#1d4ed8; --blue-l:#3b82f6;
  --blue-pale:rgba(37,99,235,.07); --blue-pale2:rgba(37,99,235,.13);
  --ink:#0f172a; --ink-2:#1e293b;
  --slate:#64748b; --slate-l:#94a3b8;
  --mist:#e2e8f0; --ghost:#f8fafc; --white:#ffffff; --surface:#f1f5f9;
  --emerald:#059669; --teal:#0d9488; --gold:#d97706; --rose:#e11d48;
  --g-blue:linear-gradient(135deg,#2563eb,#1d4ed8);
  --g-accent:linear-gradient(135deg,#e05c2a,#c44e21);
  --g-brand:linear-gradient(135deg,#1c2b4a 0%,#2563eb 50%,#e05c2a 100%);
  --r-xs:4px;--r-sm:6px;--r-md:8px;--r-lg:12px;--r-xl:16px;--r-2xl:20px;--r-pill:999px;
  --nav-h:66px;
  --sh-sm:0 1px 3px rgba(15,23,42,.06),0 1px 2px rgba(15,23,42,.04);
  --sh-md:0 4px 16px rgba(15,23,42,.08),0 2px 6px rgba(15,23,42,.05);
  --sh-lg:0 12px 40px rgba(15,23,42,.12),0 4px 12px rgba(15,23,42,.06);
  --sh-xl:0 20px 60px rgba(15,23,42,.16),0 8px 20px rgba(15,23,42,.08);
  --sh-blue:0 4px 18px rgba(37,99,235,.28);
  --sh-accent:0 4px 18px rgba(224,92,42,.28);
  --ease:cubic-bezier(.4,0,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);--t:.22s var(--ease);
  --font-display:'Fraunces',Georgia,serif;
  --font-body:'Plus Jakarta Sans',system-ui,sans-serif;
  --font-mono:'JetBrains Mono',monospace;
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{font-family:var(--font-body);background:var(--ghost);color:var(--ink);overflow-x:hidden;font-size:16px;line-height:1.6}
h1,h2,h3,h4,h5,h6{font-family:var(--font-display);line-height:1.1;letter-spacing:-.02em}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--ink)}
::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}

@media(pointer:fine){body{cursor:none}a,button,[role="button"],input,textarea,select,label{cursor:none}}
#cursor-dot{position:fixed;width:8px;height:8px;border-radius:50%;background:var(--accent);pointer-events:none;z-index:99999;transform:translate(-50%,-50%);transition:background .25s,transform .2s var(--spring),opacity .2s,width .18s,height .18s,border-radius .18s;will-change:left,top}
#cursor-ring{position:fixed;width:36px;height:36px;border-radius:50%;border:1.5px solid rgba(224,92,42,.5);pointer-events:none;z-index:99998;transform:translate(-50%,-50%);transition:width .22s var(--ease),height .22s var(--ease),border-color .22s,background .22s,opacity .2s;display:flex;align-items:center;justify-content:center;will-change:left,top}
#cursor-label{font-size:.52rem;font-weight:800;color:#fff;letter-spacing:.1em;text-transform:uppercase;opacity:0;transition:opacity .15s;white-space:nowrap;user-select:none;pointer-events:none}
body.cursor-hover #cursor-dot{transform:translate(-50%,-50%) scale(2.5);background:var(--blue)}
body.cursor-hover #cursor-ring{width:54px;height:54px;border-color:rgba(37,99,235,.4)}
body.cursor-click #cursor-dot{transform:translate(-50%,-50%) scale(.5)}
body.cursor-click #cursor-ring{width:22px;height:22px;border-color:rgba(224,92,42,.8)}
body.cursor-hidden #cursor-dot,body.cursor-hidden #cursor-ring{opacity:0}
#scroll-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,var(--primary),var(--blue),var(--accent));z-index:9999;transition:width .06s linear}

/* DARK MODE */
body.dark{background:#0a0f1e;color:rgba(255,255,255,.88)}
body.dark .navbar{background:rgba(10,15,30,.97);border-bottom-color:rgba(255,255,255,.06)}
body.dark .navbar.scrolled{background:rgba(10,15,30,.99);box-shadow:0 1px 16px rgba(0,0,0,.3)}
body.dark .nav-links .nl-a{color:rgba(255,255,255,.65)}
body.dark .nav-links .nl-a:hover{color:#fff}
body.dark .mega-drop{background:rgba(13,18,36,.98);border-color:rgba(255,255,255,.07)}
body.dark .btn-nav-signin{border-color:rgba(255,255,255,.14);color:rgba(255,255,255,.55)}
body.dark .btn-nav-signin:hover{background:rgba(255,255,255,.07);color:#fff}
body.dark .mob-panel{background:#0d1220}
body.dark .mob-link,.dark .mob-sub-toggle{color:rgba(255,255,255,.75);border-bottom-color:rgba(255,255,255,.06)}
body.dark .about-card{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07)}
body.dark .about-card:hover{background:rgba(255,255,255,.06);border-color:rgba(37,99,235,.2)}
body.dark .stat-card{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07)}
body.dark .team-card{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07)}
body.dark .team-card:hover{border-color:rgba(37,99,235,.25)}
body.dark .value-card{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07)}
body.dark .story-block{background:rgba(255,255,255,.03);border-color:rgba(255,255,255,.07)}
body.dark footer{background:#080d1a}
body.dark .footer-divider{border-color:rgba(255,255,255,.06)}
body.dark .footer-bottom-bar{background:rgba(0,0,0,.2)}
body.dark .footer-copy,.dark .footer-made-in,.dark .footer-legal a{color:rgba(255,255,255,.3)}

/* NAVBAR */
.navbar{position:fixed;top:0;left:0;right:0;z-index:900;background:rgba(255,255,255,.97);border-bottom:1px solid rgba(15,23,42,.06);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);transition:box-shadow var(--t),background var(--t),padding var(--t)}
.navbar.scrolled{box-shadow:0 1px 14px rgba(15,23,42,.09)}
.nav-inner{max-width:1280px;margin:0 auto;padding:0 28px;height:var(--nav-h);display:flex;align-items:center;gap:28px}
.nav-brand{display:flex;align-items:center;gap:9px;flex-shrink:0}
.nav-logo-circle{width:34px;height:34px;border-radius:50%;overflow:hidden;background:var(--primary);flex-shrink:0;border:1.5px solid rgba(37,99,235,.2)}
.nav-logo-circle img{width:100%;height:100%;object-fit:cover}
.nav-brand-text{font-family:var(--font-display);font-size:1.08rem;font-weight:600;letter-spacing:-.02em;color:var(--ink)}
.nav-brand-text em{font-style:normal;color:var(--accent)}
.nav-links{display:flex;list-style:none;gap:2px;margin-left:auto}
.nl-item{position:relative}
.nl-a{font-size:.82rem;font-weight:600;padding:7px 13px;border-radius:var(--r-lg);color:var(--slate);transition:color var(--t),background var(--t);display:flex;align-items:center;gap:5px;letter-spacing:.01em}
.nl-a:hover,.nl-a:focus,.nl-a.about-active{color:var(--ink);background:var(--blue-pale)}
.nl-a .arrow{font-size:.58rem;transition:transform var(--t);opacity:.5}
.nl-item:hover .arrow{transform:rotate(180deg)}
.mega-drop{display:none;position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%);background:var(--white);border:1px solid rgba(15,23,42,.07);border-radius:var(--r-xl);padding:20px;box-shadow:var(--sh-xl);min-width:520px}
.nl-item:hover .mega-drop{display:block}
.mega-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:4px 20px}
.mega-col-label{font-size:.65rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--slate-l);padding:0 10px 6px;display:block}
.mega-link{display:flex;align-items:center;gap:9px;font-size:.79rem;font-weight:600;color:var(--slate);padding:8px 10px;border-radius:var(--r-md);transition:background var(--t),color var(--t)}
.mega-link:hover{background:var(--blue-pale);color:var(--blue)}
.mega-link i{width:16px;text-align:center;opacity:.6}
.nav-cta{display:flex;align-items:center;gap:8px;flex-shrink:0}
.btn-nav-signin{font-size:.78rem;font-weight:700;padding:7px 16px;border-radius:var(--r-pill);border:1.5px solid rgba(15,23,42,.12);color:var(--slate);transition:var(--t)}
.btn-nav-signin:hover{background:var(--surface);color:var(--ink)}
.btn-nav-orange{font-size:.78rem;font-weight:700;padding:7px 16px;border-radius:var(--r-pill);background:var(--accent-pale);color:var(--accent);transition:var(--t);display:flex;align-items:center;gap:5px}
.btn-nav-orange:hover{background:var(--accent);color:#fff}
.btn-nav-start{font-size:.78rem;font-weight:700;padding:7px 18px;border-radius:var(--r-pill);background:var(--g-blue);color:#fff;box-shadow:var(--sh-blue);transition:var(--t);display:flex;align-items:center;gap:6px}
.btn-nav-start:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(37,99,235,.38)}
#theme-toggle{width:34px;height:34px;border-radius:50%;border:none;background:var(--blue-pale);color:var(--blue);display:flex;align-items:center;justify-content:center;transition:var(--t);flex-shrink:0}
#theme-toggle:hover{background:var(--blue);color:#fff}
#theme-toggle svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* MOBILE NAV */
.mob-quick{display:none;align-items:center;gap:8px;margin-left:auto}
.mob-quick-btn{width:36px;height:36px;border-radius:50%;border:none;background:var(--blue-pale);color:var(--blue);display:flex;align-items:center;justify-content:center;font-size:.85rem}
.mob-quick-wa{width:36px;height:36px;border-radius:50%;background:#25d366;color:#fff;display:flex;align-items:center;justify-content:center;font-size:.9rem}
.ham-btn{width:36px;height:36px;border-radius:var(--r-md);border:none;background:var(--blue-pale);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px}
.ham-line{display:block;width:18px;height:2px;background:var(--blue);border-radius:2px;transition:var(--t)}
.mob-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:800;opacity:0;pointer-events:none;transition:opacity var(--t)}
.mob-overlay.open{opacity:1;pointer-events:all}
.mob-panel{position:fixed;top:0;right:0;bottom:0;width:min(320px,88vw);background:var(--white);z-index:810;transform:translateX(100%);transition:transform .3s var(--ease);overflow-y:auto;padding:20px}
.mob-panel.open{transform:none}
.mob-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--mist)}
.mob-logo{font-family:var(--font-display);font-size:1.05rem;font-weight:600;color:var(--ink)}
.mob-logo em{font-style:normal;color:var(--accent)}
.mob-close{width:32px;height:32px;border-radius:50%;border:none;background:var(--surface);color:var(--slate);font-size:.85rem}
nav.mob-body{}
.mob-link{display:flex;align-items:center;gap:10px;font-size:.86rem;font-weight:600;color:var(--slate);padding:11px 0;border-bottom:1px solid var(--mist);transition:color var(--t)}
.mob-link:hover{color:var(--blue)}
.mob-link i{width:16px;text-align:center;opacity:.5}
.mob-sub-toggle{display:flex;align-items:center;gap:10px;font-size:.86rem;font-weight:600;color:var(--slate);padding:11px 0;border-bottom:1px solid var(--mist)}
.mob-sub{display:none;padding:8px 0 0 26px}
.mob-sub.open{display:block}
.mob-sub a{display:block;font-size:.8rem;color:var(--slate);padding:7px 0;border-bottom:1px solid var(--surface)}
.mob-sub a:hover{color:var(--blue)}
.mob-footer-links{margin-top:24px;display:flex;flex-direction:column;gap:10px}
.mob-footer-links a{font-size:.8rem;font-weight:700;padding:11px 16px;border-radius:var(--r-lg);text-align:center;background:var(--surface)}
.mob-footer-links .mob-cta-primary{background:var(--g-blue);color:#fff}
.mob-footer-links .mob-cta-orange{background:var(--g-accent);color:#fff}

@media(max-width:899px){.nav-links,.nav-cta,.btn-nav-orange{display:none!important}.mob-quick{display:flex!important}}
@media(min-width:900px){.mob-overlay,.mob-panel{display:none!important}}

/* LAYOUT */
.container{width:100%;max-width:1200px;margin:0 auto;padding:0 24px}
.section-py{padding:88px 0}
@media(max-width:768px){.section-py{padding:60px 0}}

/* SECTION TAG */
.section-tag{display:inline-flex;align-items:center;gap:7px;font-size:.68rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;padding:5px 14px;border-radius:var(--r-pill);border:1px solid rgba(37,99,235,.2);background:var(--blue-pale);color:var(--blue);margin-bottom:16px}
.section-tag.orange{background:var(--accent-pale);border-color:rgba(224,92,42,.2);color:var(--accent)}
.section-tag.teal{background:rgba(13,148,136,.08);border-color:rgba(13,148,136,.2);color:var(--teal)}
.section-title{font-family:var(--font-display);font-size:clamp(1.9rem,4vw,3rem);font-weight:400;line-height:1.05;letter-spacing:-.03em;margin-bottom:12px}
.section-sub{font-size:.92rem;color:var(--slate);line-height:1.78;max-width:600px}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-accent{background:var(--g-accent);-webkit-background-clip:text;background-clip:text;color:transparent}

/* HERO */
.about-hero{padding:calc(var(--nav-h) + 70px) 0 80px;background:linear-gradient(158deg,#060c1a 0%,#0d1628 50%,#111f3a 100%);position:relative;overflow:hidden}
.hero-orb-1{position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.13) 0%,transparent 65%);top:-200px;right:-100px;pointer-events:none}
.hero-orb-2{position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(224,92,42,.1) 0%,transparent 65%);bottom:-150px;left:-80px;pointer-events:none}
.hero-mesh{position:absolute;inset:0;background-image:linear-gradient(rgba(37,99,235,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.04) 1px,transparent 1px);background-size:52px 52px;pointer-events:none}
.about-hero .container{position:relative;z-index:1;text-align:center}
.hero-eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:.68rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:rgba(147,197,253,.75);background:rgba(37,99,235,.12);border:1px solid rgba(37,99,235,.2);padding:5px 14px;border-radius:var(--r-pill);margin-bottom:22px}
.about-hero h1{font-size:clamp(2.2rem,6vw,4.2rem);font-weight:400;line-height:1.04;color:#fff;margin-bottom:18px;letter-spacing:-.04em}
.about-hero h1 em{font-style:italic;color:rgba(255,255,255,.38);font-weight:300}
.about-hero p{font-size:clamp(.9rem,2.2vw,1.05rem);color:rgba(255,255,255,.55);max-width:560px;margin:0 auto 40px;line-height:1.78}
.hero-stats{display:flex;gap:40px;justify-content:center;flex-wrap:wrap;padding-top:36px;border-top:1px solid rgba(255,255,255,.07)}
.h-stat{text-align:center}
.h-stat-val{font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.2rem);font-weight:400;color:#fff;line-height:1}
.h-stat-val .accent{color:var(--accent)}
.h-stat-val .blue{color:rgba(147,197,253,.9)}
.h-stat-lbl{font-size:.72rem;font-weight:600;color:rgba(255,255,255,.38);margin-top:4px;text-transform:uppercase;letter-spacing:.06em}

/* MISSION / VISION CARDS */
.mv-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:640px){.mv-grid{grid-template-columns:1fr}}
.about-card{background:var(--white);border:1px solid var(--mist);border-radius:var(--r-2xl);padding:36px;transition:transform var(--t),box-shadow var(--t),border-color var(--t)}
.about-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg);border-color:rgba(37,99,235,.15)}
.card-icon{width:56px;height:56px;border-radius:var(--r-xl);display:flex;align-items:center;justify-content:center;margin-bottom:20px;font-size:1.5rem}
.icon-blue{background:var(--blue-pale);color:var(--blue)}
.icon-accent{background:var(--accent-pale);color:var(--accent)}
.icon-teal{background:rgba(13,148,136,.1);color:var(--teal)}
.icon-gold{background:rgba(217,119,6,.1);color:var(--gold)}
.about-card h2{font-size:1.4rem;font-weight:400;margin-bottom:10px;color:var(--ink)}
.about-card p{font-size:.88rem;color:var(--slate);line-height:1.78}

/* STORY */
.story-block{background:var(--white);border:1px solid var(--mist);border-radius:var(--r-2xl);padding:44px;display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:start}
@media(max-width:640px){.story-block{grid-template-columns:1fr;padding:28px}}
.story-block p{font-size:.9rem;color:var(--slate);line-height:1.82;margin-bottom:10px}
.story-block p:last-child{margin-bottom:0}
.story-year{font-family:var(--font-mono);font-size:clamp(3.5rem,8vw,5.5rem);font-weight:400;line-height:1;color:transparent;-webkit-text-stroke:1.5px rgba(37,99,235,.25);letter-spacing:-.04em;flex-shrink:0}

/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
@media(max-width:840px){.stats-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:400px){.stats-grid{grid-template-columns:1fr 1fr}}
.stat-card{background:var(--white);border:1px solid var(--mist);border-radius:var(--r-2xl);padding:28px 20px;text-align:center;transition:transform var(--t),box-shadow var(--t)}
.stat-card:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
.stat-num{font-family:var(--font-display);font-size:clamp(1.8rem,4vw,2.6rem);font-weight:400;line-height:1;margin-bottom:6px}
.stat-lbl{font-size:.75rem;font-weight:700;color:var(--slate-l);text-transform:uppercase;letter-spacing:.06em}

/* VALUES */
.values-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
@media(max-width:840px){.values-grid{grid-template-columns:1fr 1fr}}
@media(max-width:500px){.values-grid{grid-template-columns:1fr}}
.value-card{background:var(--white);border:1px solid var(--mist);border-radius:var(--r-2xl);padding:32px;text-align:center;transition:transform var(--t),box-shadow var(--t),border-color var(--t)}
.value-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg);border-color:rgba(37,99,235,.15)}
.value-card .card-icon{margin:0 auto 18px}
.value-card h3{font-size:1.1rem;font-weight:400;margin-bottom:8px;color:var(--ink)}
.value-card p{font-size:.83rem;color:var(--slate);line-height:1.72}

/* TEAM */
.team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
@media(max-width:900px){.team-grid{grid-template-columns:repeat(2,1fr)}}
