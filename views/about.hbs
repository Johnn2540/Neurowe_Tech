/* CURSOR */
(function(){var dot=document.getElementById('cursor-dot'),ring=document.getElementById('cursor-ring');if(!dot||!ring)return;var mx=window.innerWidth/2,my=window.innerHeight/2,rx=mx,ry=my;document.addEventListener('mouseleave',function(){document.body.classList.add('cursor-hidden');});document.addEventListener('mouseenter',function(){document.body.classList.remove('cursor-hidden');});document.addEventListener('mousedown',function(){document.body.classList.add('cursor-click');});document.addEventListener('mouseup',function(){document.body.classList.remove('cursor-click');});window.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;dot.style.left=mx+'px';dot.style.top=my+'px';},{passive:true});(function loop(){rx+=(mx-rx)*.13;ry+=(my-ry)*.13;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(loop);})();document.querySelectorAll('a,button,[role="button"]').forEach(function(el){el.addEventListener('mouseenter',function(){document.body.classList.add('cursor-hover');});el.addEventListener('mouseleave',function(){document.body.classList.remove('cursor-hover');});});})();

/* SCROLL / NAV */
var navbar=document.getElementById('mainNav'),backToTop=document.getElementById('back-to-top'),scrollPrg=document.getElementById('scroll-progress');
window.addEventListener('scroll',function(){var st=window.pageYOffset,docH=document.documentElement.scrollHeight-window.innerHeight;scrollPrg.style.width=(docH>0?(st/docH)*100:0)+'%';navbar.classList.toggle('scrolled',st>40);backToTop.classList.toggle('visible',st>400);},{passive:true});
backToTop.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});

/* MOBILE NAV */
var mobOverlay=document.getElementById('mobOverlay'),mobPanel=document.getElementById('mobPanel'),hamBtn=document.getElementById('hamBtn'),mobClose=document.getElementById('mobClose'),mobSvcToggle=document.getElementById('mobSvcToggle'),mobSvcSub=document.getElementById('mobSvcSub');
function openMob(){mobOverlay.classList.add('open');mobPanel.classList.add('open');hamBtn.classList.add('open');hamBtn.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';}
function closeMob(){mobPanel.classList.remove('open');mobOverlay.classList.remove('open');hamBtn.classList.remove('open');hamBtn.setAttribute('aria-expanded','false');document.body.style.overflow='';}
hamBtn.addEventListener('click',openMob);mobClose.addEventListener('click',closeMob);mobOverlay.addEventListener('click',closeMob);
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&mobPanel.classList.contains('open'))closeMob();});
mobSvcToggle.addEventListener('click',function(){var o=mobSvcSub.classList.toggle('open');mobSvcToggle.classList.toggle('open',o);mobSvcToggle.setAttribute('aria-expanded',o);});

/* THEME */
var themeBtn=document.getElementById('theme-toggle'),mobThemeBtn=document.getElementById('mobThemeBtn');
var dark=localStorage.getItem('nw-theme')==='dark'||(!localStorage.getItem('nw-theme')&&window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON='<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN='<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme(){document.body.classList.toggle('dark',dark);themeBtn.innerHTML=dark?SUN:MOON;if(mobThemeBtn)mobThemeBtn.innerHTML=dark?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>';}
applyTheme();
function toggleTheme(){dark=!dark;localStorage.setItem('nw-theme',dark?'dark':'light');applyTheme();}
themeBtn.addEventListener('click',toggleTheme);if(mobThemeBtn)mobThemeBtn.addEventListener('click',toggleTheme);

/* COOKIE */
var cookieBar=document.getElementById('cookie-bar');
if(!localStorage.getItem('nw-cookie'))setTimeout(function(){cookieBar.classList.add('show');},2800);
document.getElementById('cookie-accept').addEventListener('click',function(){localStorage.setItem('nw-cookie','1');cookieBar.classList.remove('show');});

/* WA TOOLTIP */
(function(){var shown=sessionStorage.getItem('nw-wa-tip');if(!shown){setTimeout(function(){var tip=document.getElementById('wa-tooltip');if(tip){tip.classList.add('show');sessionStorage.setItem('nw-wa-tip','1');}},5500);}var closeBtn=document.getElementById('waTooltipClose');if(closeBtn){closeBtn.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();document.getElementById('wa-tooltip').classList.remove('show');});}})();
