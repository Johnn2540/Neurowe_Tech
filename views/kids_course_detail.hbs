<script>
var COURSE_ID = {{course.id}};
var ENROLLED_IDS = {{enrolledChildIds}};
var selectedAv = '🧒';

function toggleMod(el) {
  el.classList.toggle('open');
}
function scrollToChildren() {
  var el = document.getElementById('childrenSection');
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
}
function toggleMini() {
  document.getElementById('miniForm').classList.toggle('vis');
}
function pickAvSm(el) {
  document.querySelectorAll('.av-o').forEach(function(o) { o.classList.remove('on'); });
  el.classList.add('on');
  selectedAv = el.dataset.emoji;
}
function toast(msg, type) {
  var el  = document.getElementById('cd-toast');
  var ico = document.getElementById('cd-ico');
  document.getElementById('cd-msg').textContent = msg;
  el.className = 'show ' + (type === 'error' ? 'tok-e' : 'tok');
  ico.className = type === 'error' ? 'fas fa-times-circle' : 'fas fa-check-circle';
  setTimeout(function() { el.className = ''; }, 3400);
}
function enrollChild(childId) {
  fetch('/api/kids/enroll', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ childId: childId, courseId: COURSE_ID })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.success) {
      toast(d.message || 'Enrolled!');
      if (d.redirect) setTimeout(function() { window.location.href = d.redirect; }, 900);
    } else { toast(d.message || 'Could not enrol', 'error'); }
  }).catch(function() { toast('Something went wrong', 'error'); });
}
function saveChildMini() {
  var name = (document.getElementById('mName').value || '').trim();
  var age  = parseInt(document.getElementById('mAge').value) || null;
  if (!name) { toast("Please enter the child's name", 'error'); return; }
  fetch('/api/kids/children', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name: name, age: age, avatar_emoji: selectedAv })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.success) {
      toast(name + ' added!');
      document.getElementById('mName').value = '';
      document.getElementById('mAge').value  = '';
      document.getElementById('miniForm').classList.remove('vis');
      var c = d.child;
      var rows = document.getElementById('childRows');
      var note = rows.querySelector('.no-children-note');
      if (note) note.remove();
      var div = document.createElement('div');
      div.className = 'child-row'; div.dataset.childId = c.id;
      div.innerHTML = '<span class="cr-av">' + (c.avatar_emoji||'🧒') + '</span>' +
        '<div class="cr-info"><div class="cr-name">' + c.name + (c.age ? ' · age '+c.age : '') + '</div>' +
        '<div class="cr-prog" style="color:#7c3aed">Not enrolled</div></div>' +
        '<div class="cr-action"><button class="cr-enroll-btn" onclick="enrollChild('+c.id+')"><i class="fas fa-plus"></i> Enrol</button></div>';
      rows.appendChild(div);
    } else { toast(d.message || 'Could not add child', 'error'); }
  }).catch(function() { toast('Something went wrong', 'error'); });
}
</script>
</body>
</html>
