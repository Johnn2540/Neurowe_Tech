<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if title}}{{title}}{{else}}NeurowexTech — Web & App Development Kenya{{/if}}</title>
    <meta name="description" content="{{#if metaDescription}}{{metaDescription}}{{else}}NeurowexTech — professional web development, mobile apps, SEO and digital skills training in Kenya and across Africa. Websites from KSh 13,000.{{/if}}">
    {{#if metaKeywords}}<meta name="keywords" content="{{metaKeywords}}">{{else}}<meta name="keywords" content="web development Kenya, mobile app development Nairobi, digital agency Kenya, website design, SEO Kenya, NeurowexTech">{{/if}}
    {{#if noIndex}}<meta name="robots" content="noindex,nofollow">{{else}}<meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1">{{/if}}
    {{#if canonical}}<link rel="canonical" href="{{canonical}}">{{/if}}
    <!-- Open Graph -->
    <meta property="og:title"       content="{{#if ogTitle}}{{ogTitle}}{{else}}{{title}}{{/if}}">
    <meta property="og:description" content="{{#if ogDescription}}{{ogDescription}}{{else}}{{#if metaDescription}}{{metaDescription}}{{else}}NeurowexTech — professional web development, mobile apps and digital solutions in Kenya.{{/if}}{{/if}}">
    <meta property="og:type"        content="{{#if ogType}}{{ogType}}{{else}}website{{/if}}">
    <meta property="og:site_name"   content="NeurowexTech">
    <meta property="og:locale"      content="en_KE">
    <meta property="og:image"       content="{{#if ogImage}}{{ogImage}}{{else}}https://neurowextech.co.ke/images/og-home.jpg{{/if}}">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    {{#if canonical}}<meta property="og:url" content="{{canonical}}">{{/if}}
    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:site"        content="@neurowextech">
    <meta name="twitter:title"       content="{{#if ogTitle}}{{ogTitle}}{{else}}{{title}}{{/if}}">
    <meta name="twitter:description" content="{{#if metaDescription}}{{metaDescription}}{{else}}NeurowexTech — professional web development, mobile apps and digital solutions in Kenya.{{/if}}">
    <meta name="twitter:image"       content="{{#if ogImage}}{{ogImage}}{{else}}https://neurowextech.co.ke/images/og-home.jpg{{/if}}">
    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#1c2b4a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="NeurowexTech">
    <link rel="apple-touch-icon" href="/images/logo.png">
    <!-- Preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/styles/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Organization schema (every page) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://neurowextech.co.ke/#organization",
      "name": "NeurowexTech",
      "url": "https://neurowextech.co.ke",
      "logo": { "@type": "ImageObject", "url": "https://neurowextech.co.ke/images/logo.png" },
      "telephone": "+254769329340",
      "email": "techneurowex@gmail.com",
      "address": { "@type": "PostalAddress", "addressLocality": "Nairobi", "addressCountry": "KE" },
      "sameAs": ["https://twitter.com/neurowextech", "https://linkedin.com/company/neurowextech"],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+254769329340",
        "contactType": "customer service",
        "availableLanguage": "English"
      }
    }
    </script>
</head>
<body>
    {{> header}}

    <main>
        {{{body}}}
    </main>

    {{> footer}}

    <script src="/js/main.js"></script>
    <style>
/* ── Social sidebar ── */
#soc-sidebar{position:fixed;right:0;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:4px;z-index:9000}
/* desktop: expanding tabs flush right */
.ss-link{display:flex;align-items:center;color:#fff;text-decoration:none;border-radius:8px 0 0 8px;overflow:hidden;width:46px;height:48px;transition:width .32s cubic-bezier(.4,0,.2,1);box-shadow:-3px 2px 14px rgba(0,0,0,.28);flex-shrink:0}
.ss-link:hover,.ss-link:focus-visible{width:154px;outline:none}
.ss-icon{min-width:46px;height:48px;display:flex;align-items:center;justify-content:center;font-size:.95rem;order:2;flex-shrink:0;transition:transform .2s}
.ss-link:hover .ss-icon,.ss-link:focus-visible .ss-icon{transform:scale(1.12)}
.ss-label{order:1;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;padding-left:14px;opacity:0;transform:translateX(10px);transition:opacity .2s .08s,transform .2s .08s;flex:1}
.ss-link:hover .ss-label,.ss-link:focus-visible .ss-label{opacity:1;transform:translateX(0)}
.ss-link.fb{background:#1877f2}
.ss-link.yt{background:#ff0000}
.ss-link.li{background:#0a66c2}
.ss-link.ig{background:linear-gradient(160deg,#f77737 0%,#c13584 45%,#405de6 100%)}
/* mobile: compact pills on the left (opposite WhatsApp) */
@media(max-width:768px){
  #soc-sidebar{right:auto;left:0;gap:5px;top:50%;transform:translateY(-50%)}
  .ss-link{width:36px;height:36px;border-radius:0 10px 10px 0;box-shadow:3px 2px 10px rgba(0,0,0,.25)}
  .ss-link:hover,.ss-link:focus-visible{width:36px}
  .ss-label{display:none}
  .ss-icon{min-width:36px;height:36px;font-size:.8rem;order:1}
  .ss-link:hover .ss-icon,.ss-link:focus-visible .ss-icon{transform:scale(1.08)}
}
@media print{#soc-sidebar{display:none}}
</style>
<aside id="soc-sidebar" aria-label="Follow us on social media">
  <a href="https://www.facebook.com/share/1928ETerkE/" target="_blank" rel="noopener noreferrer" class="ss-link fb" aria-label="Follow us on Facebook"><span class="ss-label">Facebook</span><span class="ss-icon"><i class="fab fa-facebook-f"></i></span></a>
  <a href="https://youtube.com/@neurowextech?si=CSiI92E2peTQmngO" target="_blank" rel="noopener noreferrer" class="ss-link yt" aria-label="Subscribe on YouTube"><span class="ss-label">YouTube</span><span class="ss-icon"><i class="fab fa-youtube"></i></span></a>
  <a href="https://www.linkedin.com/in/neurowex-tech-588045312" target="_blank" rel="noopener noreferrer" class="ss-link li" aria-label="Connect on LinkedIn"><span class="ss-label">LinkedIn</span><span class="ss-icon"><i class="fab fa-linkedin-in"></i></span></a>
  <a href="https://www.instagram.com/neorowex_tech_solutions" target="_blank" rel="noopener noreferrer" class="ss-link ig" aria-label="Follow us on Instagram"><span class="ss-label">Instagram</span><span class="ss-icon"><i class="fab fa-instagram"></i></span></a>
</aside>
{{> widget}}
</body>
</html>
