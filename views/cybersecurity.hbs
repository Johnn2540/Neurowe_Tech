function closeMob(){mobPanel.classList.remove('open');mobOverlay.classList.remove('open');hamBtn&&hamBtn.classList.remove('open');document.body.style.overflow='';}
hamBtn&&hamBtn.addEventListener('click',openMob);
mobClose&&mobClose.addEventListener('click',closeMob);
mobOverlay&&mobOverlay.addEventListener('click',closeMob);
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeMob();});
mobSvcToggle&&mobSvcToggle.addEventListener('click',function(){var o=mobSvcSub.classList.toggle('open');mobSvcToggle.classList.toggle('open',o);});
/* THEME */
var themeBtn=document.getElementById('theme-toggle'),mobThemeBtn=document.getElementById('mobThemeBtn');
var dark=localStorage.getItem('nw-theme')==='dark'||(!localStorage.getItem('nw-theme')&&window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON='<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN='<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme(){document.body.classList.toggle('dark',dark);themeBtn.innerHTML=dark?SUN:MOON;if(mobThemeBtn)mobThemeBtn.innerHTML=dark?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>';}
applyTheme();
themeBtn.addEventListener('click',function(){dark=!dark;localStorage.setItem('nw-theme',dark?'dark':'light');applyTheme();});
if(mobThemeBtn)mobThemeBtn.addEventListener('click',function(){dark=!dark;localStorage.setItem('nw-theme',dark?'dark':'light');applyTheme();});
/* COUNTERS */
var cObs=new IntersectionObserver(function(entries){entries.forEach(function(e){if(!e.isIntersecting)return;var c=e.target.querySelector('.counter');if(!c||c.dataset.done)return;c.dataset.done='1';var t=+c.dataset.target,step=t/(1400/16),v=0;(function tick(){v=Math.min(v+step,t);c.textContent=Math.floor(v);if(v<t)requestAnimationFrame(tick);})();});},{threshold:.4});
document.querySelectorAll('.stat-item').forEach(function(el){cObs.observe(el);});
/* FAQ */
document.querySelectorAll('.faq-q').forEach(function(q){q.addEventListener('click',function(){var item=q.parentElement,isOpen=item.classList.contains('open');document.querySelectorAll('.faq-item').forEach(function(i){i.classList.remove('open');});if(!isOpen)item.classList.add('open');});});
</script>
