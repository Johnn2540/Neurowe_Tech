<style>
:root{--primary:#1c2b4a;--primary-d:#111d33;--primary-l:#2d4270;--accent:#e05c2a;--accent-d:#c44e21;--accent-l:#f07040;--accent-pale:rgba(224,92,42,.08);--blue:#2563eb;--blue-d:#1d4ed8;--blue-l:#3b82f6;--blue-pale:rgba(37,99,235,.07);--blue-pale2:rgba(37,99,235,.13);--ink:#0f172a;--ink-2:#1e293b;--slate:#64748b;--slate-l:#94a3b8;--mist:#e2e8f0;--ghost:#f8fafc;--surface:#f1f5f9;--emerald:#059669;--teal:#0d9488;--gold:#d97706;--g-blue:linear-gradient(135deg,#2563eb,#1d4ed8);--g-accent:linear-gradient(135deg,#e05c2a,#c44e21);--g-primary:linear-gradient(135deg,#1c2b4a,#2d4270);--g-brand:linear-gradient(135deg,#1c2b4a 0%,#2563eb 50%,#e05c2a 100%);--r-md:8px;--r-lg:12px;--r-xl:16px;--r-2xl:20px;--r-pill:999px;--nav-h:66px;--sh-sm:0 1px 3px rgba(15,23,42,.06);--sh-md:0 4px 16px rgba(15,23,42,.08),0 2px 6px rgba(15,23,42,.05);--sh-lg:0 12px 40px rgba(15,23,42,.12),0 4px 12px rgba(15,23,42,.06);--sh-xl:0 20px 60px rgba(15,23,42,.16);--sh-blue:0 4px 18px rgba(37,99,235,.28);--sh-accent:0 4px 18px rgba(224,92,42,.28);--ease:cubic-bezier(.4,0,.2,1);--t:.22s var(--ease);--font-display:'Instrument Serif',Georgia,serif;--font-body:'DM Sans',system-ui,sans-serif;--font-mono:'JetBrains Mono',monospace}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:var(--font-body);background:var(--ghost);color:var(--ink);overflow-x:hidden;font-size:16px;line-height:1.6}
h1,h2,h3,h4,h5,h6{font-family:var(--font-display);line-height:1.15;font-weight:400}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:rgba(37,99,235,.3);border-radius:4px}::-webkit-scrollbar-thumb:hover{background:var(--blue)}

/* DARK */
body.dark{background:#0a0f1e;color:rgba(255,255,255,.88)}
body.dark .navbar{background:rgba(10,15,30,.97);border-bottom-color:rgba(255,255,255,.06)}
body.dark .navbar.scrolled{background:rgba(10,15,30,.99);box-shadow:0 1px 16px rgba(0,0,0,.3)}
body.dark .card-white{background:#1a2236!important;border-color:rgba(255,255,255,.07)!important}
body.dark .bg-ghost{background:#111827!important}
body.dark .bg-white-section{background:#0f1726!important}
body.dark .faq-item{background:#1a2236;border-color:rgba(255,255,255,.07)}
body.dark .faq-q{color:rgba(255,255,255,.87)}
body.dark .process-card{background:#1a2236;border-color:rgba(255,255,255,.07)}
body.dark .pricing-card{background:#1a2236;border-color:rgba(255,255,255,.07)}
body.dark .pricing-card.featured{background:#0f1726}
body.dark .tech-pill{background:#1a2236;border-color:rgba(255,255,255,.09);color:rgba(255,255,255,.78)}
body.dark .why-card{background:#1a2236;border-color:rgba(255,255,255,.07)}
body.dark .why-card h3{color:rgba(255,255,255,.9)}
body.dark .portfolio-card{background:#1a2236;border-color:rgba(255,255,255,.07)}
body.dark .nl-form-inp{background:#0f1726;border-color:rgba(255,255,255,.09);color:#fff}
body.dark .nl-form-inp::placeholder{color:rgba(255,255,255,.3)}
body.dark #theme-toggle{background:#1a2236;border-color:rgba(255,255,255,.1)}
body.dark #theme-toggle svg{stroke:rgba(255,255,255,.8)}
body.dark .section-divider{border-color:rgba(255,255,255,.07)}
body.dark .nl-a{color:rgba(255,255,255,.6)}
body.dark .nl-a:hover{color:var(--blue-l);background:rgba(37,99,235,.1)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:#1a2236}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link{color:rgba(255,255,255,.85)}
body.dark .mob-close{background:rgba(255,255,255,.08);color:rgba(255,255,255,.8)}
body.dark .mob-sub a{color:rgba(255,255,255,.55)}
body.dark .mob-hr{border-color:rgba(255,255,255,.08)}
body.dark .mob-footer{border-color:rgba(255,255,255,.08)}
body.dark .mega-drop{background:#1a2236;border-color:rgba(255,255,255,.08)}
body.dark .mega-drop::before{background:#1a2236;border-color:rgba(255,255,255,.08)}
body.dark .mega-link{color:rgba(255,255,255,.6)}
body.dark .btn-nav-signin{color:rgba(255,255,255,.6);border-color:rgba(255,255,255,.12);background:transparent}

/* UTILS */
.container{max-width:1280px;margin:0 auto;padding:0 28px}
.section-py{padding:88px 0}.section-py-sm{padding:56px 0}
.text-center{text-align:center}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-accent{background:var(--g-accent);-webkit-background-clip:text;background-clip:text;color:transparent}
.section-tag{display:inline-flex;align-items:center;gap:6px;background:var(--blue-pale);color:var(--blue);border-radius:var(--r-pill);padding:5px 16px;font-size:.68rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;border:1px solid var(--blue-pale2);font-family:var(--font-body)}
.section-tag.orange{background:var(--accent-pale);color:var(--accent);border-color:rgba(224,92,42,.18)}
.section-tag.dark-tag{background:rgba(255,255,255,.08);color:rgba(255,255,255,.7);border-color:rgba(255,255,255,.14)}
.section-title{font-size:clamp(1.8rem,4.5vw,3rem);font-weight:400;margin-bottom:18px;line-height:1.15}
.section-sub{color:var(--slate);font-size:clamp(.9rem,2vw,1.06rem);line-height:1.78;max-width:600px}
.section-divider{border:none;border-top:1px solid var(--mist);margin:0}

/* ANIMATIONS */
@keyframes float-a{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
@keyframes wa-ring{0%{inset:-2px;opacity:.7}100%{inset:-14px;opacity:0}}
@keyframes bounce-up{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-8px)}}
@keyframes bar-shift{0%{background-position:0%}100%{background-position:200%}}
@keyframes wa-ripple{0%{transform:scale(1);opacity:.65}100%{transform:scale(1.9);opacity:0}}
@keyframes dot-pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.45);opacity:.6}}
@keyframes badge-pop{0%{transform:scale(0)}100%{transform:scale(1)}}
@keyframes hero-in{0%{opacity:0;transform:translateY(24px)}100%{opacity:1;transform:none}}

/* FIXED */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:42px;height:42px;background:#fff;border:1px solid rgba(15,23,42,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:var(--sh-md);transition:var(--t)}
#theme-toggle svg{width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(18deg) scale(1.06)}
#theme-toggle:hover svg{stroke:#fff}
#back-to-top{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);z-index:10000;width:46px;height:46px;background:var(--primary);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .35s,transform .45s cubic-bezier(.34,1.56,.64,1);box-shadow:var(--sh-lg)}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto;animation:bounce-up 2.4s ease-in-out infinite}
#back-to-top svg{width:18px;height:18px;stroke:#fff;stroke-width:2.5;fill:none;stroke-linecap:round;stroke-linejoin:round}
#scroll-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,var(--primary),var(--blue),var(--accent));z-index:9999;transition:width .06s linear}

/* WA */
#wa-float{position:fixed;bottom:88px;right:20px;z-index:10001;text-decoration:none;display:block}
.wa-ring-1,.wa-ring-2{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-ripple 2.8s ease-out infinite;pointer-events:none}
.wa-ring-2{animation-delay:1.15s}
.wa-pill{display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:9px 18px 9px 9px;box-shadow:0 6px 28px rgba(18,140,126,.42);transition:transform .32s cubic-bezier(.34,1.56,.64,1),box-shadow .3s;white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-4px) scale(1.03)}
.wa-icon-circle{width:38px;height:38px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;position:relative}
.wa-status-dot{position:absolute;top:1px;right:1px;width:10px;height:10px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite}
.wa-text-wrap{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.67rem;color:rgba(255,255,255,.65);font-weight:600}
.wa-cta{font-size:.9rem;color:#fff;font-weight:800;font-family:var(--font-body)}
.wa-arrow-icon{color:rgba(255,255,255,.7);font-size:.72rem;margin-left:2px}
.wa-badge{position:absolute;top:-5px;right:-5px;width:19px;height:19px;background:#ef4444;border:2px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.6rem;color:#fff;font-weight:800;animation:badge-pop .55s cubic-bezier(.34,1.56,.64,1) both}

/* NAVBAR */
.navbar{position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);background:rgba(255,255,255,.97);backdrop-filter:blur(20px) saturate(1.6);border-bottom:1px solid rgba(15,23,42,.08);transition:var(--t)}
.navbar.scrolled{background:rgba(255,255,255,.99);box-shadow:0 1px 18px rgba(15,23,42,.08)}
.nav-inner{max-width:1280px;margin:0 auto;padding:0 28px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}
.nav-brand{display:flex;align-items:center;gap:10px;flex-shrink:0;text-decoration:none}
.nav-logo-circle{width:40px;height:40px;border-radius:50%;overflow:hidden;border:2.5px solid var(--accent);flex-shrink:0;box-shadow:0 0 0 3px rgba(224,92,42,.12),0 0 0 5px rgba(37,99,235,.08);transition:var(--t);background:var(--primary)}
.nav-logo-circle img{width:100%;height:100%;object-fit:cover}
.nav-brand-text{font-family:var(--font-display);font-size:1.18rem;font-weight:600;color:var(--primary);letter-spacing:-.3px;line-height:1}
.nav-brand-text em{font-style:normal;color:var(--accent)}
.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-item{position:relative}
.nl-a{font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 12px;border-radius:var(--r-md);transition:var(--t);white-space:nowrap;display:flex;align-items:center;gap:4px}
.nl-a:hover,.nl-a.active{color:var(--primary);background:rgba(15,23,42,.05)}
.nl-a .arrow{font-size:.55rem;transition:transform .25s}
.nl-item:hover .arrow{transform:rotate(180deg)}
.mega-drop{position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%) translateY(8px);min-width:580px;background:#fff;border-radius:var(--r-xl);border:1px solid rgba(15,23,42,.07);box-shadow:var(--sh-xl);padding:24px;opacity:0;visibility:hidden;pointer-events:none;transition:all .18s var(--ease)}
.nl-item:hover .mega-drop{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
.mega-drop::before{content:'';position:absolute;top:-6px;left:50%;width:11px;height:11px;background:#fff;border-left:1px solid rgba(15,23,42,.07);border-top:1px solid rgba(15,23,42,.07);transform:translateX(-50%) rotate(45deg)}
.mega-grid{display:grid;grid-template-columns:1fr 1fr 1fr}
.mega-col-label{font-size:.63rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--blue);padding:0 8px 10px;display:block}
.mega-link{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:var(--r-md);font-size:.82rem;font-weight:500;color:var(--slate);transition:all .14s}
.mega-link i{width:17px;color:var(--blue);font-size:.78rem;flex-shrink:0}
.mega-link:hover{background:var(--blue-pale);color:var(--blue);transform:translateX(2px)}
.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}
.btn-nav-signin{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:var(--slate);padding:7px 14px;border:1.5px solid var(--mist);border-radius:var(--r-md);transition:var(--t);background:#fff;cursor:pointer;font-family:var(--font-body)}
.btn-nav-signin:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-orange{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:var(--accent);padding:7px 14px;border:1.5px solid rgba(224,92,42,.3);border-radius:var(--r-md);transition:var(--t);background:var(--accent-pale);cursor:pointer;font-family:var(--font-body)}
.btn-nav-orange:hover{background:var(--accent);color:#fff;border-color:transparent}
.btn-nav-start{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:#fff;padding:8px 18px;border:none;border-radius:var(--r-md);transition:var(--t);background:linear-gradient(135deg,var(--primary),var(--blue));cursor:pointer;font-family:var(--font-body)}
.btn-nav-start:hover{opacity:.9;transform:translateY(-1px)}
.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:42px;height:42px;background:none;border:none;cursor:pointer;border-radius:var(--r-md);transition:var(--t);flex-shrink:0}
.ham-line{display:block;width:22px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .26s var(--ease);transform-origin:center}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(7px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:38px;height:38px;border-radius:var(--r-md);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.88rem;transition:var(--t);background:var(--blue-pale);color:var(--blue)}
.mob-quick-wa{width:38px;height:38px;border-radius:var(--r-md);background:rgba(37,211,102,.1);color:#25D366;display:flex;align-items:center;justify-content:center;font-size:.88rem;transition:var(--t)}
.mob-overlay{position:fixed;inset:0;background:rgba(10,15,30,.55);backdrop-filter:blur(5px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(360px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-8px 0 40px rgba(10,15,30,.16);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.85rem}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:11px;padding:13px 22px;font-size:.91rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px}
.mob-link i{width:19px;color:var(--blue);font-size:.84rem;flex-shrink:0}
.mob-link:hover{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-sub-toggle{display:flex;align-items:center;justify-content:space-between;padding:13px 22px;font-size:.91rem;font-weight:600;color:var(--ink);cursor:pointer;transition:var(--t);min-height:48px}
.mob-sub-toggle .left{display:flex;align-items:center;gap:11px}
.mob-sub-toggle .left i{width:19px;color:var(--blue);font-size:.84rem}
.mob-sub-toggle:hover{background:var(--blue-pale);color:var(--blue)}
.mob-sub-toggle .chev{font-size:.64rem;color:var(--slate);transition:transform .28s;flex-shrink:0}
.mob-sub-toggle.open .chev{transform:rotate(180deg)}
.mob-sub{background:rgba(37,99,235,.03);border-top:1px solid rgba(37,99,235,.07);border-bottom:1px solid rgba(37,99,235,.07);max-height:0;overflow:hidden;transition:max-height .35s ease}
.mob-sub.open{max-height:700px}
.mob-sub a{display:flex;align-items:center;gap:9px;padding:11px 22px 11px 50px;font-size:.83rem;color:var(--slate);transition:var(--t);min-height:44px}
.mob-sub a i{width:16px;color:var(--blue);font-size:.76rem;flex-shrink:0}
.mob-sub a:hover{color:var(--blue);background:rgba(37,99,235,.05);padding-left:56px}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 20px}
.mob-footer{padding:14px 18px 32px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:10px}

/* BUTTONS */
.btn-primary{display:inline-flex;align-items:center;gap:7px;cursor:pointer;border:none;padding:12px 24px;border-radius:var(--r-md);font-weight:700;font-size:.875rem;transition:var(--t);white-space:nowrap;text-align:center;justify-content:center;font-family:var(--font-body);background:linear-gradient(135deg,var(--primary),var(--primary-l));color:#fff;box-shadow:var(--sh-sm)}
.btn-primary:hover{opacity:.9;transform:translateY(-1px);box-shadow:var(--sh-md)}
