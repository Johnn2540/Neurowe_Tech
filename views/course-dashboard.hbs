<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>{{title}}</title>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #2563eb;
            --accent: #f97316;
            --dark: #050b18;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-700: #334155;
            --white: #ffffff;
            --green: #10b981;
            --grad-primary: linear-gradient(135deg, #2563eb, #1d4ed8);
            --font-sans: 'Inter', sans-serif;
            --font-heading: 'Syne', var(--font-sans);
        }

        body {
            font-family: var(--font-sans);
            background: var(--gray-100);
        }
        body.dark { background: var(--dark); color: var(--gray-200); }
        
        .navbar {
            background: rgba(255,255,255,0.98);
            backdrop-filter: blur(20px);
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--gray-200);
        }
        .navbar-brand {
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: 1.5rem;
            background: var(--grad-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .navbar-brand span { color: var(--accent); }
        
        .course-sidebar {
            background: white;
            border-radius: 16px;
            padding: 20px;
            position: sticky;
            top: 80px;
            border: 1px solid var(--gray-200);
        }
        body.dark .course-sidebar { background: #0d1526; border-color: rgba(255,255,255,0.08); }
        
        .progress-circle {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: conic-gradient(var(--primary) {{progress}}deg, var(--gray-200) {{progress}}deg);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
        }
        .progress-inner {
            width: 80px;
            height: 80px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
        }
        body.dark .progress-inner { background: #0d1526; }
        
        .module-card {
            background: white;
            border-radius: 12px;
            margin-bottom: 16px;
            border: 1px solid var(--gray-200);
            overflow: hidden;
        }
        body.dark .module-card { background: #0d1526; border-color: rgba(255,255,255,0.08); }
        
        .module-header {
            padding: 16px 20px;
            background: var(--gray-100);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
        }
        body.dark .module-header { background: rgba(255,255,255,0.05); }
        
        .lesson-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            border-bottom: 1px solid var(--gray-200);
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .lesson-item:hover { background: rgba(37,99,235,0.05); }
        .lesson-item.completed { background: rgba(16,185,129,0.05); }
        .lesson-icon { width: 32px; color: var(--primary); }
        .lesson-icon.completed { color: var(--green); }
        .lesson-title { flex: 1; font-size: 0.9rem; }
        .lesson-duration { font-size: 0.7rem; color: var(--gray-700); }
        
        .video-container {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
        
        @media (max-width: 768px) {
            .course-sidebar { position: static; margin-bottom: 20px; }
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">Neurowex<span>Tech</span> Learn</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/learn">Explore</a></li>
                <li class="nav-item"><a class="nav-link" href="/my-learning">My Learning</a></li>
            </ul>
            <div class="dropdown">
                <button class="btn btn-primary-custom dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-user me-1"></i> {{userName}}
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/my-learning"><i class="fas fa-book-open me-2"></i> My Learning</a></li>
                    <li><a class="dropdown-item" href="/logout"><i class="fas fa-sign-out-alt me-2"></i> Sign Out</a></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="container py-5" style="margin-top: 60px;">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="course-sidebar">
                <h5 class="text-center mb-3">{{courseTitle}}</h5>
                <div class="progress-circle">
                    <div class="progress-inner">{{progress}}%</div>
                </div>
                <div class="text-center mb-3">
                    <small>{{completedLessons}} of {{totalLessons}} lessons completed</small>
                </div>
                <div class="progress mb-3" style="height: 8px;">
                    <div class="progress-bar bg-primary" style="width: {{progress}}%"></div>
                </div>
                <hr>
                <div class="small">
                    <div class="d-flex justify-content-between mb-2">
                        <span><i class="fas fa-clock me-1"></i> Total time</span>
                        <span>{{totalDuration}}</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fas fa-certificate me-1"></i> Certificate</span>
                        <span>{{#if (eq progress 100)}}✅ Ready{{else}}In progress{{/if}}</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Video Player (shows first incomplete lesson) -->
            <div class="video-container" id="videoContainer">
                <iframe id="videoFrame" src="{{currentVideoUrl}}" frameborder="0" allowfullscreen></iframe>
            </div>
            
            <!-- Current Lesson Info -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <div>
                    <h4 id="currentLessonTitle">{{currentLessonTitle}}</h4>
                    <p class="text-muted" id="currentLessonDescription">{{currentLessonDescription}}</p>
                </div>
                <button class="btn btn-primary-custom" id="markCompleteBtn">
                    <i class="fas fa-check-circle me-2"></i> Mark as Complete
                </button>
            </div>
            
            <!-- Course Modules -->
            <div id="modulesContainer">
                {{#each modules}}
                <div class="module-card">
                    <div class="module-header" data-module="{{@index}}">
                        <span><i class="fas fa-folder-open me-2"></i> {{this.title}}</span>
                        <span>{{this.completedLessons}}/{{this.totalLessons}} completed</span>
                    </div>
                    <div class="module-lessons" style="display: none;">
                        {{#each this.lessons}}
                        <div class="lesson-item {{#if this.completed}}completed{{/if}}" data-lesson-id="{{this.id}}" data-lesson-title="{{this.title}}" data-lesson-description="{{this.description}}" data-video-url="{{this.video_url}}">
                            <div class="lesson-icon {{#if this.completed}}completed{{/if}}">
                                <i class="fas {{#if this.completed}}fa-check-circle{{else}}fa-play-circle{{/if}}"></i>
                            </div>
                            <div class="lesson-title">{{this.title}}</div>
                            <div class="lesson-duration">{{this.duration}}</div>
                            {{#if this.completed}}
                            <i class="fas fa-check-circle text-success"></i>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let currentLessonId = {{currentLessonId}};
    
    // Module accordion
    document.querySelectorAll('.module-header').forEach(header => {
        header.addEventListener('click', () => {
            const lessonsDiv = header.nextElementSibling;
            const isVisible = lessonsDiv.style.display === 'block';
            lessonsDiv.style.display = isVisible ? 'none' : 'block';
        });
    });
    
    // Lesson click handler
    document.querySelectorAll('.lesson-item').forEach(lesson => {
        lesson.addEventListener('click', async () => {
            const lessonId = lesson.dataset.lessonId;
            const title = lesson.dataset.lessonTitle;
            const description = lesson.dataset.lessonDescription;
            const videoUrl = lesson.dataset.videoUrl;
            
            // Update current lesson display
            document.getElementById('currentLessonTitle').textContent = title;
            document.getElementById('currentLessonDescription').textContent = description;
            document.getElementById('videoFrame').src = videoUrl;
            currentLessonId = lessonId;
            
            // Update active state
            document.querySelectorAll('.lesson-item').forEach(l => l.classList.remove('active'));
            lesson.classList.add('active');
        });
    });
    
    // Mark complete button
    document.getElementById('markCompleteBtn').addEventListener('click', async () => {
        const btn = document.getElementById('markCompleteBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Updating...';
        btn.disabled = true;
        
        try {
            const response = await fetch('/api/lesson/complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    lessonId: currentLessonId,
                    courseId: {{courseId}}
                })
            });
            const data = await response.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message);
                btn.innerHTML = '<i class="fas fa-check-circle me-2"></i> Mark as Complete';
                btn.disabled = false;
            }
        } catch (err) {
            alert('Error updating progress. Please try again.');
            btn.innerHTML = '<i class="fas fa-check-circle me-2"></i> Mark as Complete';
            btn.disabled = false;
        }
    });
    
    // Open first module by default
    const firstModule = document.querySelector('.module-header');
    if (firstModule) {
        firstModule.nextElementSibling.style.display = 'block';
    }
    
    // Highlight current lesson
    const currentLesson = document.querySelector(`.lesson-item[data-lesson-id="${currentLessonId}"]`);
    if (currentLesson) {
        currentLesson.classList.add('active');
    }
</script>
</body>
</html>