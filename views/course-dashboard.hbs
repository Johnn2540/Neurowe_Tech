<!DOCTYPE html>
{{!--
  ╔══════════════════════════════════════════════════════════════════════════╗
  ║  course-dashboard.hbs — NeurowexTech Academy Course Player              ║
  ║  Rendered by:  GET /learn/course/:id/dashboard  (server.js)             ║
  ║  Auth:         isAuthenticated required                                  ║
  ║                                                                          ║
  ║  Variables from server.js:                                               ║
  ║  courseId, courseTitle, courseLevel, totalDuration, totalModules         ║
  ║  modules[].{title, completedLessons, totalLessons,                       ║
  ║    lessons[].{id,title,duration,video_url,completed,isCurrent}}          ║
  ║  progress, completedLessons, totalLessons                                ║
  ║  currentLessonId, currentLessonTitle, currentVideoUrl                    ║
  ║  currentModuleTitle, currentLessonCompleted                              ║
  ║  hasPrevLesson, hasNextLesson, enrolledAt                                ║
  ║  GLOBAL: currentYear, isAuthenticated, userName                          ║
  ║                                                                          ║
  ║  POST /api/lesson/complete {lessonId,courseId}                           ║
  ║    → {success, progress, completedLessons, total}                       ║
  ╚══════════════════════════════════════════════════════════════════════════╝
--}}
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="author" content="NeurowexTech" />
  <meta name="geo.region" content="KE-110" />
  <meta name="geo.placename" content="Nairobi, Kenya" />
  <meta name="geo.position" content="-1.2921;36.8219" />
  <meta name="ICBM" content="-1.2921, 36.8219" />
<title>{{courseTitle}} | NeurowexTech Academy</title>
<meta name="robots" content="noindex, nofollow"/>
<!-- Fonts: DM Sans for UI crispness + Instrument Serif for headings -->
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

<style>
/* ══════════════════════════════════════════════════════
   TOKENS
══════════════════════════════════════════════════════ */
:root{
  --c-bg:       #0f0f0f;
  --c-surface:  #1a1a1a;
  --c-surface2: #242424;
  --c-surface3: #2e2e2e;
  --c-border:   rgba(255,255,255,.09);
  --c-border2:  rgba(255,255,255,.15);

  --c-text:     #f1f1f1;
  --c-text2:    rgba(241,241,241,.65);
  --c-text3:    rgba(241,241,241,.38);

  --c-blue:     #6b8cff;
  --c-blue-d:   #4f6fea;
  --c-blue-dim: rgba(107,140,255,.14);
  --c-green:    #5cc678;
  --c-green-dim:rgba(92,198,120,.12);
  --c-orange:   #f97316;
  --c-orange-dim:rgba(249,115,22,.12);
  --c-purple:   #a78bfa;
  --c-yellow:   #fbbf24;

  --c-complete: #5cc678;
  --c-current:  #6b8cff;
  --c-pending:  rgba(241,241,241,.25);

  --g-blue:  linear-gradient(135deg,#6b8cff,#4f6fea);
  --g-green: linear-gradient(135deg,#5cc678,#3daf5e);
  --g-bar:   linear-gradient(90deg,#6b8cff,#a78bfa,#5cc678);

  --nav-h:    56px;
  --sidebar-w:400px;

  --r-sm: 6px;
  --r-md: 10px;
  --r-lg: 14px;
  --r-xl: 18px;

  --ease: cubic-bezier(.4,0,.2,1);
  --spring: cubic-bezier(.34,1.56,.64,1);
  --t: .22s var(--ease);

  --sh-card: 0 2px 12px rgba(0,0,0,.4);
  --sh-pop:  0 8px 32px rgba(0,0,0,.6);
}

/* light mode overrides */
body.light{
  --c-bg:       #f7f8fa;
  --c-surface:  #ffffff;
  --c-surface2: #f0f2f5;
  --c-surface3: #e4e7ec;
  --c-border:   rgba(0,0,0,.08);
  --c-border2:  rgba(0,0,0,.16);
  --c-text:     #111318;
  --c-text2:    rgba(17,19,24,.62);
  --c-text3:    rgba(17,19,24,.38);
  --c-blue:     #2b5fff;
  --c-blue-dim: rgba(43,95,255,.1);
  --c-green:    #16a34a;
  --c-green-dim:rgba(22,163,74,.1);
  --c-blue-d:   #1d4ed8;
}

/* ══════════════════════════════════════════════════════
   RESET & BASE
══════════════════════════════════════════════════════ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{
  font-family:'DM Sans',sans-serif;
  background:var(--c-bg);
  color:var(--c-text);
  overflow-x:hidden;
  line-height:1.6;
  font-size:15px;
}
h1,h2,h3,h4,h5{font-family:'Instrument Serif',serif;line-height:1.15;font-weight:400}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
button,input,select,textarea{font-family:'DM Sans',sans-serif}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--c-surface3);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:var(--c-blue)}

/* ══════════════════════════════════════════════════════
   PROGRESS BAR (top of page)
══════════════════════════════════════════════════════ */
#page-progress{
  position:fixed;top:0;left:0;right:0;height:2px;z-index:9999;
  background:var(--c-surface2);
}
#page-progress-fill{
  height:100%;
  background:var(--g-bar);
  background-size:200%;
  animation:bar-shift 3s linear infinite;
  transition:width .6s var(--ease);
}
@keyframes bar-shift{0%{background-position:0%}100%{background-position:200%}}

/* ══════════════════════════════════════════════════════
   TOPBAR — Udemy-style dark strip
══════════════════════════════════════════════════════ */
.topbar{
  position:fixed;top:0;left:0;right:0;height:var(--nav-h);z-index:1000;
  background:var(--c-surface);
  border-bottom:1px solid var(--c-border);
  display:flex;align-items:center;gap:0;
}
.topbar-left{
  display:flex;align-items:center;gap:12px;
  padding:0 16px;flex-shrink:0;
}
.tb-back{
  width:36px;height:36px;border-radius:var(--r-md);
  background:var(--c-surface2);border:1px solid var(--c-border);
  display:flex;align-items:center;justify-content:center;
  color:var(--c-text2);font-size:.82rem;cursor:pointer;transition:var(--t);
}
.tb-back:hover{background:var(--c-surface3);color:var(--c-text)}
.tb-logo{
  display:flex;align-items:center;gap:8px;
  font-family:'Instrument Serif',serif;font-size:1.1rem;color:var(--c-text);
  letter-spacing:-.02em;
}
.tb-logo-mark{
  width:28px;height:28px;border-radius:7px;
  background:var(--g-blue);
  display:flex;align-items:center;justify-content:center;
  font-size:.78rem;font-weight:700;color:#fff;flex-shrink:0;
  font-family:'DM Sans',sans-serif;
}
.tb-logo em{font-style:italic;color:var(--c-orange)}
.tb-sep{width:1px;height:24px;background:var(--c-border);flex-shrink:0}

/* course title in topbar */
.tb-course-title{
  font-size:.82rem;font-weight:500;color:var(--c-text2);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  flex:1;min-width:0;padding:0 16px;
}

/* topbar progress inline */
.tb-progress-wrap{
  display:flex;align-items:center;gap:9px;padding:0 16px;flex-shrink:0;
}
.tb-prog-label{font-size:.75rem;font-weight:600;color:var(--c-text3);white-space:nowrap}
.tb-prog-bar{
  width:100px;height:5px;background:var(--c-surface3);border-radius:3px;overflow:hidden;
}
.tb-prog-fill{
  height:100%;border-radius:3px;
  background:var(--g-green);
  transition:width .6s var(--ease);
}
.tb-prog-pct{font-size:.75rem;font-weight:700;color:var(--c-green);white-space:nowrap}

/* topbar right actions */
.topbar-right{
  display:flex;align-items:center;gap:6px;padding:0 16px;flex-shrink:0;margin-left:auto;
}
.tb-btn{
  display:inline-flex;align-items:center;gap:6px;
  height:34px;padding:0 12px;border-radius:var(--r-md);
  font-size:.78rem;font-weight:600;cursor:pointer;transition:var(--t);
  background:var(--c-surface2);border:1px solid var(--c-border);
  color:var(--c-text2);white-space:nowrap;
}
.tb-btn:hover{background:var(--c-surface3);color:var(--c-text)}
.tb-btn.primary{
  background:var(--g-blue);color:#fff;border-color:transparent;
  box-shadow:0 2px 12px rgba(107,140,255,.35);
}
.tb-btn.primary:hover{opacity:.9;transform:translateY(-1px)}
.tb-icon-btn{
  width:34px;height:34px;border-radius:var(--r-md);
  background:var(--c-surface2);border:1px solid var(--c-border);
  display:flex;align-items:center;justify-content:center;
  color:var(--c-text2);font-size:.8rem;cursor:pointer;transition:var(--t);
}
.tb-icon-btn:hover{background:var(--c-surface3);color:var(--c-text)}

/* ══════════════════════════════════════════════════════
   LAYOUT — video left, sidebar right (Udemy layout)
══════════════════════════════════════════════════════ */
.player-wrap{
  display:flex;
  margin-top:var(--nav-h);
  min-height:calc(100vh - var(--nav-h));
  align-items:flex-start;
}

/* ── VIDEO COLUMN ── */
.player-main{
  flex:1;min-width:0;
  display:flex;flex-direction:column;
}

/* video wrapper — 16:9 always */
.video-outer{
  width:100%;
  background:#000;
  position:relative;
}
.video-ratio{
  position:relative;padding-bottom:56.25%;height:0;
}
.video-ratio iframe,
.video-ratio video{
  position:absolute;inset:0;width:100%;height:100%;border:none;
}
/* placeholder when no video */
.video-placeholder{
  position:absolute;inset:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:14px;background:var(--c-bg);
}
.video-placeholder .vp-icon{
  width:72px;height:72px;border-radius:50%;
  background:var(--c-surface2);
  display:flex;align-items:center;justify-content:center;
  font-size:1.6rem;color:var(--c-text3);
}
.video-placeholder p{font-size:.88rem;color:var(--c-text3)}

/* ── below video: lesson info + tabs ── */
.lesson-body{padding:28px 32px 48px;max-width:900px;}

/* prev/next row */
.nav-row{
  display:flex;align-items:center;gap:8px;margin-bottom:22px;flex-wrap:wrap;
}
.nav-btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:8px 16px;border-radius:var(--r-md);
  font-size:.82rem;font-weight:600;cursor:pointer;transition:var(--t);
  border:1.5px solid var(--c-border2);background:var(--c-surface2);color:var(--c-text2);
}
.nav-btn:hover:not(:disabled){
  border-color:var(--c-blue);color:var(--c-blue);background:var(--c-blue-dim);
}
.nav-btn:disabled{opacity:.3;cursor:not-allowed}
.nav-row-mid{flex:1}

/* Mark complete */
.btn-mark{
  display:inline-flex;align-items:center;gap:7px;
  padding:9px 20px;border-radius:var(--r-md);
  font-size:.83rem;font-weight:700;cursor:pointer;transition:var(--t);
  border:2px solid var(--c-complete);color:var(--c-complete);
  background:var(--c-green-dim);
}
.btn-mark:hover{background:var(--c-complete);color:#fff;transform:translateY(-1px)}
.btn-mark.done{
  background:var(--c-complete);color:#fff;border-color:var(--c-complete);
  cursor:default;pointer-events:none;
}

/* Lesson title area */
.lesson-header{margin-bottom:20px}
.lesson-module-crumb{
  display:inline-flex;align-items:center;gap:6px;
  font-size:.72rem;font-weight:600;color:var(--c-blue);
  text-transform:uppercase;letter-spacing:1.2px;margin-bottom:8px;
}
.lesson-module-crumb::before{
  content:'';width:12px;height:1.5px;background:var(--c-blue);border-radius:2px;
}
.lesson-title{
  font-family:'Instrument Serif',serif;
  font-size:clamp(1.35rem,3vw,1.75rem);
  color:var(--c-text);margin-bottom:8px;
}
.lesson-meta-row{
  display:flex;flex-wrap:wrap;gap:16px;
  font-size:.77rem;color:var(--c-text3);align-items:center;
}
.lesson-meta-item{display:flex;align-items:center;gap:5px}
.lesson-meta-item i{font-size:.72rem}

/* ── TABS ── */
.tabs-nav{
  display:flex;gap:0;
  border-bottom:1.5px solid var(--c-border);
  margin-bottom:22px;
}
.tab-btn{
  padding:10px 18px;font-size:.83rem;font-weight:600;
  color:var(--c-text3);background:none;border:none;
  border-bottom:2.5px solid transparent;cursor:pointer;
  transition:all .18s;white-space:nowrap;margin-bottom:-1.5px;
}
.tab-btn:hover{color:var(--c-text)}
.tab-btn.active{color:var(--c-blue);border-bottom-color:var(--c-blue)}
.tab-pane{display:none}
.tab-pane.active{display:block}

/* Notes */
.notes-textarea{
  width:100%;min-height:140px;
  background:var(--c-surface);border:1.5px solid var(--c-border);
  border-radius:var(--r-md);padding:14px 16px;
  font-size:.87rem;color:var(--c-text);resize:vertical;outline:none;
  line-height:1.7;transition:border-color .18s;
}
.notes-textarea:focus{border-color:var(--c-blue);box-shadow:0 0 0 3px var(--c-blue-dim)}
.notes-textarea::placeholder{color:var(--c-text3)}
.notes-footer{display:flex;justify-content:space-between;align-items:center;margin-top:10px}
.notes-saved{
  font-size:.74rem;color:var(--c-green);
  display:flex;align-items:center;gap:5px;
  opacity:0;transition:opacity .3s;
}
.notes-saved.show{opacity:1}
.btn-save-notes{
  display:inline-flex;align-items:center;gap:6px;
  padding:7px 16px;border-radius:var(--r-md);
  font-size:.78rem;font-weight:600;cursor:pointer;transition:var(--t);
  background:var(--c-surface2);border:1.5px solid var(--c-border2);color:var(--c-text2);
}
.btn-save-notes:hover{background:var(--c-blue);border-color:var(--c-blue);color:#fff}

/* Resources */
.res-item{
  display:flex;align-items:center;gap:12px;
  padding:12px 14px;border-radius:var(--r-md);
  background:var(--c-surface2);border:1px solid var(--c-border);
  margin-bottom:9px;transition:var(--t);
}
.res-item:hover{border-color:var(--c-blue);background:var(--c-blue-dim)}
.res-icon{
  width:36px;height:36px;border-radius:var(--r-sm);flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:var(--c-surface3);color:var(--c-text2);font-size:.88rem;
}
.res-name{font-size:.84rem;font-weight:600;color:var(--c-text);flex:1}
.res-type{font-size:.68rem;color:var(--c-text3);margin-top:2px}
.tab-empty{
  padding:40px;text-align:center;color:var(--c-text3);
}
.tab-empty i{font-size:2rem;margin-bottom:10px;display:block;opacity:.35}

/* Certificate */
.cert-box{
  background:var(--c-surface);border:1px solid var(--c-border);
  border-radius:var(--r-xl);padding:40px;text-align:center;
  position:relative;overflow:hidden;
}
.cert-box::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 50% 0%,var(--c-blue-dim),transparent 65%);
  pointer-events:none;
}
.cert-trophy{font-size:3.2rem;display:block;margin-bottom:16px;position:relative;z-index:1}
.cert-box h3{
  font-family:'Instrument Serif',serif;font-size:1.5rem;
  color:var(--c-text);margin-bottom:8px;position:relative;z-index:1;
}
.cert-box p{
  font-size:.87rem;color:var(--c-text2);max-width:380px;
  margin:0 auto 22px;line-height:1.7;position:relative;z-index:1;
}
.cert-progress-wrap{max-width:320px;margin:0 auto 22px;position:relative;z-index:1}
.cert-prog-bar{height:8px;background:var(--c-surface3);border-radius:4px;overflow:hidden}
.cert-prog-fill{height:100%;border-radius:4px;background:var(--g-blue);transition:width .8s var(--ease)}
.cert-prog-labels{
  display:flex;justify-content:space-between;
  font-size:.72rem;color:var(--c-text3);margin-top:5px;
}
.btn-cert-dl{
  display:inline-flex;align-items:center;gap:8px;
  padding:11px 26px;border-radius:var(--r-md);
  font-size:.85rem;font-weight:700;cursor:pointer;
  background:var(--g-blue);color:#fff;border:none;
  box-shadow:0 4px 20px rgba(107,140,255,.4);transition:var(--t);
  position:relative;z-index:1;
}
.btn-cert-dl:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(107,140,255,.5)}

/* ══════════════════════════════════════════════════════
   SIDEBAR — right panel, Udemy style
══════════════════════════════════════════════════════ */
.player-sidebar{
  width:var(--sidebar-w);flex-shrink:0;
  height:calc(100vh - var(--nav-h));
  position:sticky;top:var(--nav-h);
  background:var(--c-surface);
  border-left:1px solid var(--c-border);
  display:flex;flex-direction:column;
  overflow:hidden;
}

/* sidebar header */
.sb-header{
  padding:16px 18px;
  border-bottom:1px solid var(--c-border);
  flex-shrink:0;
}
.sb-header-top{
  display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;
}
.sb-title{
  font-size:.72rem;font-weight:700;letter-spacing:1.4px;
  text-transform:uppercase;color:var(--c-text3);
}
.sb-close{
  width:28px;height:28px;border-radius:var(--r-sm);
  background:none;border:none;color:var(--c-text3);
  cursor:pointer;transition:var(--t);display:flex;align-items:center;justify-content:center;
  font-size:.78rem;
}
.sb-close:hover{background:var(--c-surface2);color:var(--c-text)}

/* sidebar progress bar */
.sb-progress{
  display:flex;align-items:center;gap:10px;
}
.sb-prog-bar{
  flex:1;height:6px;background:var(--c-surface3);border-radius:3px;overflow:hidden;
}
.sb-prog-fill{
  height:100%;border-radius:3px;background:var(--g-green);transition:width .8s var(--ease);
}
.sb-prog-pct{
  font-size:.78rem;font-weight:700;color:var(--c-green);white-space:nowrap;flex-shrink:0;
}
.sb-prog-label{font-size:.71rem;color:var(--c-text3);margin-top:5px}

/* module list */
.sb-modules{flex:1;overflow-y:auto;overflow-x:hidden}
.sb-modules::-webkit-scrollbar{width:3px}
.sb-modules::-webkit-scrollbar-thumb{background:var(--c-surface3)}

.sb-module{border-bottom:1px solid var(--c-border)}

.sb-module-btn{
  display:flex;align-items:flex-start;justify-content:space-between;gap:10px;
  padding:14px 18px;cursor:pointer;transition:var(--t);width:100%;
  background:none;border:none;text-align:left;
}
.sb-module-btn:hover{background:var(--c-surface2)}
.sb-module-btn.open{background:var(--c-surface2)}

.sb-module-left{flex:1;min-width:0}
.sb-module-num{
  font-size:.64rem;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;
  color:var(--c-text3);margin-bottom:3px;
}
.sb-module-title{font-size:.84rem;font-weight:600;color:var(--c-text);line-height:1.35;margin-bottom:4px}
.sb-module-meta{font-size:.71rem;color:var(--c-text3);display:flex;align-items:center;gap:8px}
.sb-module-done{
  font-size:.66rem;font-weight:700;padding:2px 7px;border-radius:3px;
  background:var(--c-green-dim);color:var(--c-green);
}
.sb-module-chev{
  color:var(--c-text3);font-size:.62rem;flex-shrink:0;margin-top:2px;
  transition:transform .22s;
}
.sb-module-btn.open .sb-module-chev{transform:rotate(180deg)}

.sb-lessons{display:none}
.sb-lessons.open{display:block}

/* lesson row */
.sb-lesson{
  display:flex;align-items:flex-start;gap:10px;
  padding:10px 18px 10px 32px;
  cursor:pointer;transition:all .16s;
  border-left:3px solid transparent;
  position:relative;
}
.sb-lesson:hover:not(.active){background:var(--c-surface2)}
.sb-lesson.active{
  background:var(--c-blue-dim);
  border-left-color:var(--c-blue);
}
.sb-lesson.completed{background:var(--c-green-dim)}
.sb-lesson.completed.active{background:var(--c-blue-dim);border-left-color:var(--c-blue)}

/* status indicator */
.sb-lesson-status{
  width:20px;height:20px;border-radius:50%;flex-shrink:0;margin-top:1px;
  display:flex;align-items:center;justify-content:center;font-size:.6rem;
  transition:var(--t);
}
.sb-lesson-status.done{background:var(--c-complete);color:#fff}
.sb-lesson-status.current{background:var(--c-blue);color:#fff}
.sb-lesson-status.pending{
  border:1.5px solid var(--c-pending);color:var(--c-text3);background:transparent;
}

.sb-lesson-body{flex:1;min-width:0}
.sb-lesson-title{
  font-size:.82rem;font-weight:500;color:var(--c-text);
  line-height:1.4;margin-bottom:3px;
}
.sb-lesson.active .sb-lesson-title{font-weight:700;color:var(--c-blue)}
.sb-lesson-dur{font-size:.68rem;color:var(--c-text3);display:flex;align-items:center;gap:4px}
.sb-lesson-dur i{font-size:.6rem}

/* ══════════════════════════════════════════════════════
   TOAST
══════════════════════════════════════════════════════ */
#toast{
  position:fixed;bottom:28px;left:50%;
  transform:translateX(-50%) translateY(16px);
  background:var(--c-surface);color:var(--c-text);
  border:1px solid var(--c-border2);border-radius:var(--r-md);
  padding:11px 18px;font-size:.82rem;font-weight:600;
  display:flex;align-items:center;gap:9px;z-index:9999;
  opacity:0;transition:all .24s var(--ease);
  box-shadow:var(--sh-pop);min-width:220px;max-width:420px;
  border-left:3px solid var(--c-green);
}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.error{border-left-color:#ef4444}
#toast i{font-size:.9rem;flex-shrink:0}

/* ══════════════════════════════════════════════════════
   MOBILE SIDEBAR DRAWER
══════════════════════════════════════════════════════ */
.mob-sb-overlay{
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,.65);backdrop-filter:blur(4px);
  z-index:1100;opacity:0;transition:opacity .28s;
}
.mob-sb-overlay.open{opacity:1}
@media(max-width:899px){
  .mob-sb-overlay{display:block;pointer-events:none}
  .mob-sb-overlay.open{pointer-events:auto}
  .player-sidebar{
    position:fixed;top:0;right:0;height:100dvh;z-index:1101;
    transform:translateX(100%);transition:transform .3s var(--ease);
    width:min(var(--sidebar-w),92vw);
  }
  .player-sidebar.mob-open{transform:translateX(0)}
}

/* sidebar toggle button (mobile) */
.mob-sb-toggle{
  display:none;
  position:fixed;bottom:22px;right:18px;z-index:1050;
  width:46px;height:46px;border-radius:50%;
  background:var(--g-blue);color:#fff;
  border:none;cursor:pointer;box-shadow:0 4px 20px rgba(107,140,255,.5);
  align-items:center;justify-content:center;font-size:1rem;
  transition:var(--t);
}
.mob-sb-toggle:hover{transform:scale(1.07)}
@media(max-width:899px){.mob-sb-toggle{display:flex}}

/* ══════════════════════════════════════════════════════
   KEYBOARD SHORTCUT TOOLTIP
══════════════════════════════════════════════════════ */
#kb-tip{
  position:fixed;bottom:28px;right:18px;z-index:900;
  background:var(--c-surface);border:1px solid var(--c-border);
  border-radius:var(--r-md);padding:10px 14px;
  font-size:.72rem;color:var(--c-text3);
  opacity:0;transform:translateY(6px);
  transition:all .3s var(--ease);pointer-events:none;
  line-height:1.8;
}
#kb-tip.show{opacity:1;transform:translateY(0)}
#kb-tip kbd{
  background:var(--c-surface3);border:1px solid var(--c-border2);
  border-radius:3px;padding:1px 5px;font-family:'JetBrains Mono',monospace;
  font-size:.68rem;color:var(--c-text);
}

/* ══════════════════════════════════════════════════════
   CONFETTI BURST (100% complete celebration)
══════════════════════════════════════════════════════ */
.confetti-piece{
  position:fixed;z-index:9998;pointer-events:none;
  width:8px;height:8px;border-radius:2px;opacity:0;
  animation:confetti-fall 1.4s var(--ease) forwards;
}
@keyframes confetti-fall{
  0%{transform:translateY(-20px) rotate(0deg);opacity:1}
  100%{transform:translateY(90vh) rotate(480deg);opacity:0}
}

/* ══════════════════════════════════════════════════════
   UTILITIES
══════════════════════════════════════════════════════ */
.hidden{display:none!important}
@keyframes fade-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.fade-in{animation:fade-in .3s var(--ease) both}

/* ══════════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════════ */
@media(max-width:899px){
  .lesson-body{padding:20px 18px 40px}
  .tb-course-title{display:none}
  .tb-progress-wrap{display:none}
}
@media(max-width:599px){
  :root{--nav-h:52px}
  .lesson-body{padding:16px 14px 32px}
  .lesson-title{font-size:1.2rem}
  .nav-row{gap:6px}
  .tb-btn span{display:none}
  .topbar-left{gap:8px}
}
</style>
</head>
<body>

<!-- ── PAGE PROGRESS BAR (scroll position) ── -->
<div id="page-progress" aria-hidden="true">
  <div id="page-progress-fill" style="width:0%"></div>
</div>

<!-- ── TOAST ── -->
<div id="toast" role="status" aria-live="polite">
  <i class="fas fa-check-circle"></i>
  <span id="toastMsg">Done!</span>
</div>

<!-- ── KEYBOARD SHORTCUT TOOLTIP ── -->
<div id="kb-tip" aria-hidden="true">
  <strong style="display:block;color:var(--c-text);margin-bottom:4px">⌨️ Shortcuts</strong>
  <kbd>→</kbd> Next lesson &nbsp;&nbsp; <kbd>←</kbd> Previous<br>
  <kbd>C</kbd> Mark complete &nbsp;&nbsp; <kbd>N</kbd> Notes<br>
  <kbd>?</kbd> Toggle this tip
</div>

<!-- ── MOBILE SIDEBAR OVERLAY ── -->
<div class="mob-sb-overlay" id="mobSbOverlay" aria-hidden="true"></div>

<!-- ══════════════════════════════════════════════════════
     TOPBAR
══════════════════════════════════════════════════════ -->
<header class="topbar" role="banner">

  <div class="topbar-left">
    <!-- Back to My Learning -->
    <a href="/my-learning" class="tb-back" title="Back to My Learning" aria-label="Back to My Learning">
      <i class="fas fa-arrow-left"></i>
    </a>

    <!-- Brand -->
    <a href="/" class="tb-logo" aria-label="NeurowexTech Home">
      <span class="tb-logo-mark">N</span>Neurowex<em>Tech</em>
    </a>

    <div class="tb-sep" aria-hidden="true"></div>
  </div>

  <!-- Course title (truncated) -->
  <div class="tb-course-title" title="{{courseTitle}}">{{courseTitle}}</div>

  <!-- Inline progress -->
  <div class="tb-progress-wrap">
    <div class="tb-prog-label" id="tbProgLabel">{{completedLessons}}/{{totalLessons}}</div>
    <div class="tb-prog-bar" role="progressbar" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100">
      <div class="tb-prog-fill" id="tbProgFill" style="width:{{progress}}%"></div>
    </div>
    <div class="tb-prog-pct" id="tbProgPct">{{progress}}%</div>
  </div>

  <div class="topbar-right">
    <!-- Theme toggle -->
    <button class="tb-icon-btn" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">
      <i class="fas fa-moon" id="themeIcon"></i>
    </button>

    <!-- Keyboard shortcuts toggle -->
    <button class="tb-icon-btn" id="kbToggleBtn" title="Keyboard shortcuts (?)" aria-label="Keyboard shortcuts">
      <i class="fas fa-keyboard"></i>
    </button>

    <!-- User menu -->
    {{#if isAuthenticated}}
    <div style="position:relative" id="userMenuWrap">
      <button class="tb-btn" id="userMenuBtn" aria-label="User menu" aria-expanded="false">
        <i class="fas fa-user-circle"></i>
        <span>{{userName}}</span>
        <i class="fas fa-chevron-down" style="font-size:.56rem;opacity:.6"></i>
      </button>
      <div id="userMenuDrop" style="
        position:absolute;top:calc(100% + 8px);right:0;min-width:190px;
        background:var(--c-surface);border:1px solid var(--c-border);
        border-radius:var(--r-lg);padding:6px;z-index:200;
        box-shadow:var(--sh-pop);
        opacity:0;visibility:hidden;pointer-events:none;
        transition:all .18s var(--ease);transform:translateY(4px);
      ">
        <a href="/my-learning" style="display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:var(--r-sm);font-size:.81rem;color:var(--c-text2);transition:var(--t);"
           onmouseover="this.style.background='var(--c-surface2)'" onmouseout="this.style.background=''">
          <i class="fas fa-book-open" style="width:15px;color:var(--c-blue);font-size:.78rem"></i> My Learning
        </a>
        <a href="/user_dashboard" style="display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:var(--r-sm);font-size:.81rem;color:var(--c-text2);transition:var(--t);"
           onmouseover="this.style.background='var(--c-surface2)'" onmouseout="this.style.background=''">
          <i class="fas fa-tachometer-alt" style="width:15px;color:var(--c-blue);font-size:.78rem"></i> Dashboard
        </a>
        <hr style="border:none;border-top:1px solid var(--c-border);margin:5px 0"/>
        <a href="/logout" style="display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:var(--r-sm);font-size:.81rem;color:#ef4444;transition:var(--t);"
           onmouseover="this.style.background='var(--c-surface2)'" onmouseout="this.style.background=''">
          <i class="fas fa-sign-out-alt" style="width:15px;font-size:.78rem"></i> Sign Out
        </a>
      </div>
    </div>
    {{else}}
    <a href="/login" class="tb-btn">Sign In</a>
    {{/if}}
  </div>
</header>

<!-- ══════════════════════════════════════════════════════
     PLAYER LAYOUT
══════════════════════════════════════════════════════ -->
<div class="player-wrap">

  <!-- ─── MAIN VIDEO + CONTENT ─────────────────── -->
  <section class="player-main" id="playerMain">

    <!-- Video player -->
    <div class="video-outer">
      <div class="video-ratio" id="videoRatio">
        {{#if currentVideoUrl}}
        <iframe
          id="videoFrame"
          src="{{currentVideoUrl}}"
          allowfullscreen
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          title="{{currentLessonTitle}}">
        </iframe>
        {{else}}
        <div class="video-placeholder" id="videoPlaceholder">
          <div class="vp-icon"><i class="fas fa-play-circle"></i></div>
          <p>Select a lesson from the course contents to begin</p>
        </div>
        {{/if}}
      </div>
    </div>

    <!-- Below-video content -->
    <div class="lesson-body fade-in">

      <!-- Prev / Next + Mark Complete -->
      <div class="nav-row">
        <button class="nav-btn" id="btnPrev" {{#unless hasPrevLesson}}disabled{{/unless}} aria-label="Previous lesson">
          <i class="fas fa-arrow-left"></i> Previous
        </button>
        <button class="nav-btn" id="btnNext" {{#unless hasNextLesson}}disabled{{/unless}} aria-label="Next lesson">
          Next <i class="fas fa-arrow-right"></i>
        </button>
        <span class="nav-row-mid"></span>
        {{#if currentLessonCompleted}}
        <button class="btn-mark done" id="markCompleteBtn" aria-label="Lesson completed">
          <i class="fas fa-check-circle"></i> Completed
        </button>
        {{else}}
        <button class="btn-mark" id="markCompleteBtn" aria-label="Mark lesson as complete">
          <i class="far fa-circle"></i> Mark Complete
        </button>
        {{/if}}
      </div>

      <!-- Lesson title -->
      <div class="lesson-header">
        <div class="lesson-module-crumb" id="lessonModuleCrumb">{{currentModuleTitle}}</div>
        <h1 class="lesson-title" id="lessonTitle">{{currentLessonTitle}}</h1>
        <div class="lesson-meta-row">
          <span class="lesson-meta-item">
            <i class="fas fa-graduation-cap" style="color:var(--c-blue)"></i>
            {{courseLevel}}
          </span>
          <span class="lesson-meta-item">
            <i class="fas fa-clock" style="color:var(--c-text3)"></i>
            {{totalDuration}}
          </span>
          <span class="lesson-meta-item">
            <i class="fas fa-layer-group" style="color:var(--c-text3)"></i>
            {{totalLessons}} lessons
          </span>
        </div>
      </div>

      <!-- Tabs -->
      <div class="tabs-nav" role="tablist">
        <button class="tab-btn active" data-tab="notes" role="tab" aria-selected="true">
          <i class="fas fa-sticky-note" style="font-size:.78rem;margin-right:5px"></i>Notes
        </button>
        <button class="tab-btn" data-tab="resources" role="tab" aria-selected="false">
          <i class="fas fa-paperclip" style="font-size:.78rem;margin-right:5px"></i>Resources
        </button>
        <button class="tab-btn" data-tab="overview" role="tab" aria-selected="false">
          <i class="fas fa-info-circle" style="font-size:.78rem;margin-right:5px"></i>Overview
        </button>
        <button class="tab-btn" data-tab="certificate" role="tab" aria-selected="false">
          <i class="fas fa-certificate" style="font-size:.78rem;margin-right:5px"></i>Certificate
        </button>
      </div>

      <!-- Notes tab -->
      <div class="tab-pane active" id="tab-notes">
        <textarea class="notes-textarea" id="notesArea"
          placeholder="Write notes for this lesson… they're saved automatically per lesson."></textarea>
        <div class="notes-footer">
          <span class="notes-saved" id="notesSavedMsg">
            <i class="fas fa-check-circle" style="color:var(--c-green)"></i> Saved
          </span>
          <button class="btn-save-notes" id="saveNotesBtn">
            <i class="fas fa-save"></i> Save Notes
          </button>
        </div>
      </div>

      <!-- Resources tab -->
      <div class="tab-pane" id="tab-resources">
        {{#if currentLessonResources.length}}
          {{#each currentLessonResources}}
          <a href="{{this.url}}" target="_blank" rel="noopener noreferrer" class="res-item">
            <div class="res-icon">
              <i class="fas {{#if (eq this.type 'pdf')}}fa-file-pdf{{else}}{{#if (eq this.type 'video')}}fa-video{{else}}fa-link{{/if}}{{/if}}"></i>
            </div>
            <div>
              <div class="res-name">{{this.title}}</div>
              <div class="res-type">{{this.type}}</div>
            </div>
            <i class="fas fa-external-link-alt" style="color:var(--c-text3);font-size:.72rem;margin-left:auto;flex-shrink:0"></i>
          </a>
          {{/each}}
        {{else}}
        <div class="tab-empty">
          <i class="fas fa-paperclip"></i>
          No resources attached to this lesson yet.
        </div>
        {{/if}}
      </div>

      <!-- Overview tab -->
      <div class="tab-pane" id="tab-overview">
        <div style="padding:4px 0">
          <h3 style="font-size:1.15rem;color:var(--c-text);margin-bottom:12px">About this course</h3>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:20px">
            <div style="background:var(--c-surface2);border:1px solid var(--c-border);border-radius:var(--r-md);padding:12px 14px">
              <div style="font-size:.68rem;text-transform:uppercase;letter-spacing:1px;color:var(--c-text3);margin-bottom:4px">Level</div>
              <div style="font-size:.88rem;font-weight:600;color:var(--c-text)">{{courseLevel}}</div>
            </div>
            <div style="background:var(--c-surface2);border:1px solid var(--c-border);border-radius:var(--r-md);padding:12px 14px">
              <div style="font-size:.68rem;text-transform:uppercase;letter-spacing:1px;color:var(--c-text3);margin-bottom:4px">Duration</div>
              <div style="font-size:.88rem;font-weight:600;color:var(--c-text)">{{totalDuration}}</div>
            </div>
            <div style="background:var(--c-surface2);border:1px solid var(--c-border);border-radius:var(--r-md);padding:12px 14px">
              <div style="font-size:.68rem;text-transform:uppercase;letter-spacing:1px;color:var(--c-text3);margin-bottom:4px">Modules</div>
              <div style="font-size:.88rem;font-weight:600;color:var(--c-text)">{{totalModules}}</div>
            </div>
            <div style="background:var(--c-surface2);border:1px solid var(--c-border);border-radius:var(--r-md);padding:12px 14px">
              <div style="font-size:.68rem;text-transform:uppercase;letter-spacing:1px;color:var(--c-text3);margin-bottom:4px">Lessons</div>
              <div style="font-size:.88rem;font-weight:600;color:var(--c-text)">{{totalLessons}}</div>
            </div>
          </div>
          <div style="font-size:.84rem;color:var(--c-text2);line-height:1.75">
            Complete all lessons to earn your certificate. Track your progress in the
            course contents panel on the right. You can mark lessons complete as you finish them.
          </div>
        </div>
      </div>

      <!-- Certificate tab -->
      <div class="tab-pane" id="tab-certificate">
        {{#if (eq progress 100)}}
        <div class="cert-box">
          <span class="cert-trophy">🏆</span>
          <h3>Congratulations, {{userName}}!</h3>
          <p>You've successfully completed <strong>{{courseTitle}}</strong>. Your certificate is ready.</p>
          <a href="/api/certificate/{{courseId}}" target="_blank" class="btn-cert-dl">
            <i class="fas fa-download"></i> Download Certificate
          </a>
        </div>
        {{else}}
        <div class="cert-box">
          <span class="cert-trophy">🎯</span>
          <h3>Certificate in Progress</h3>
          <p>Complete all {{totalLessons}} lessons to unlock your certificate. You're <strong>{{progress}}%</strong> there!</p>
          <div class="cert-progress-wrap">
            <div class="cert-prog-bar">
              <div class="cert-prog-fill" id="certProgFill" style="width:{{progress}}%"></div>
            </div>
            <div class="cert-prog-labels">
              <span>{{completedLessons}} completed</span>
              <span>{{totalLessons}} total</span>
            </div>
          </div>
        </div>
        {{/if}}
      </div>

    </div><!-- /lesson-body -->
  </section><!-- /player-main -->

  <!-- ─── SIDEBAR ─────────────────────────── -->
  <aside class="player-sidebar" id="playerSidebar" aria-label="Course contents">

    <div class="sb-header">
      <div class="sb-header-top">
        <div class="sb-title">Course Contents</div>
        <button class="sb-close" id="sbClose" aria-label="Close sidebar">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <!-- sidebar progress -->
      <div class="sb-progress">
        <div class="sb-prog-bar" role="progressbar" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100">
          <div class="sb-prog-fill" id="sbProgFill" style="width:{{progress}}%"></div>
        </div>
        <div class="sb-prog-pct" id="sbProgPct">{{progress}}%</div>
      </div>
      <div class="sb-prog-label" id="sbProgLabel">{{completedLessons}} of {{totalLessons}} lessons completed</div>
    </div>

    <!-- Module / Lesson tree -->
    <div class="sb-modules" id="sbModules">
      {{#each modules}}
      <div class="sb-module" id="sbMod{{@index}}">

        <button class="sb-module-btn {{#if (eq @index 0)}}open{{/if}}"
                data-mod="{{@index}}"
                aria-expanded="{{#if (eq @index 0)}}true{{else}}false{{/if}}">
          <div class="sb-module-left">
            <div class="sb-module-num">Module {{inc @index}}</div>
            <div class="sb-module-title">{{this.title}}</div>
            <div class="sb-module-meta">
              <span>{{this.totalLessons}} lessons</span>
              {{#if this.completedLessons}}
              <span class="sb-module-done">{{this.completedLessons}}/{{this.totalLessons}} done</span>
              {{/if}}
            </div>
          </div>
          <i class="fas fa-chevron-down sb-module-chev"></i>
        </button>

        <div class="sb-lessons {{#if (eq @index 0)}}open{{/if}}" id="sbLessons{{@index}}">
          {{#each this.lessons}}
          <div class="sb-lesson{{#if this.completed}} completed{{/if}}{{#if this.isCurrent}} active{{/if}}"
               data-lesson-id="{{this.id}}"
               data-lesson-title="{{this.title}}"
               data-video-url="{{this.video_url}}"
               data-duration="{{this.duration}}"
               data-module-title="{{../title}}"
               data-completed="{{this.completed}}"
               tabindex="0"
               role="button"
               aria-label="{{this.title}}{{#if this.completed}} — completed{{/if}}{{#if this.isCurrent}} — currently playing{{/if}}">

            <!-- Status icon -->
            <div class="sb-lesson-status {{#if this.completed}}done{{else}}{{#if this.isCurrent}}current{{else}}pending{{/if}}{{/if}}"
                 aria-hidden="true">
              {{#if this.completed}}
                <i class="fas fa-check"></i>
              {{else}}{{#if this.isCurrent}}
                <i class="fas fa-play"></i>
              {{else}}
                <i class="far fa-circle" style="font-size:.5rem"></i>
              {{/if}}{{/if}}
            </div>

            <div class="sb-lesson-body">
              <div class="sb-lesson-title">{{this.title}}</div>
              <div class="sb-lesson-dur">
                <i class="fas fa-clock"></i> {{this.duration}}
              </div>
            </div>
          </div>
          {{/each}}
        </div>

      </div>
      {{/each}}
    </div><!-- /sb-modules -->

  </aside><!-- /player-sidebar -->

</div><!-- /player-wrap -->

<!-- Mobile sidebar toggle button -->
<button class="mob-sb-toggle" id="mobSbToggle" aria-label="Course contents">
  <i class="fas fa-list-ul"></i>
</button>

<!-- ══════════════════════════════════════════════════════
     JAVASCRIPT
══════════════════════════════════════════════════════ -->
<script>
/* ══════════════════════════════════════════════════════════════
   STATE — seeded from Handlebars on first render.
   JS updates STATE as user interacts to avoid full reloads.
═══════════════════════════════════════════════════════════════= */
var STATE = {
  courseId:              {{{json courseId}}},
  currentLessonId:       {{{json currentLessonId}}},
  currentLessonCompleted:{{#if currentLessonCompleted}}true{{else}}false{{/if}},
  progress:              {{progress}},
  completedLessons:      {{completedLessons}},
  totalLessons:          {{totalLessons}},
  /* Flat ordered array of every lesson — powers prev/next navigation */
  allLessons: [
    {{#each modules}}{{#each this.lessons}}
    {
      id:          {{this.id}},
      title:       {{{json this.title}}},
      videoUrl:    {{{json this.video_url}}},
      duration:    {{{json this.duration}}},
      moduleTitle: {{{json ../title}}},
      completed:   {{#if this.completed}}true{{else}}false{{/if}}
    }{{#unless @last}},{{/unless}}
    {{/each}}{{#unless @last}},{{/unless}}{{/each}}
  ]
};

/* ── HELPERS ── */
function el(id){ return document.getElementById(id); }
function qs(sel){ return document.querySelector(sel); }
function qsa(sel){ return document.querySelectorAll(sel); }

/* ══════════════════════════════════════════════════════════════
   THEME TOGGLE — dark (default) ↔ light
═══════════════════════════════════════════════════════════════= */
var isLight = localStorage.getItem('nw-theme') === 'light';
function applyTheme() {
  document.body.classList.toggle('light', isLight);
  var icon = el('themeIcon');
  if(icon) icon.className = isLight ? 'fas fa-moon' : 'fas fa-sun';
}
applyTheme();
el('themeToggle') && el('themeToggle').addEventListener('click', function(){
  isLight = !isLight;
  localStorage.setItem('nw-theme', isLight ? 'light' : 'dark');
  applyTheme();
});

/* ══════════════════════════════════════════════════════════════
   TOAST
═══════════════════════════════════════════════════════════════= */
function showToast(msg, isError) {
  var t = el('toast'), m = el('toastMsg');
  if(!t) return;
  t.className = isError ? 'error show' : 'show';
  t.querySelector('i').className = isError ? 'fas fa-exclamation-circle' : 'fas fa-check-circle';
  t.querySelector('i').style.color = isError ? '#ef4444' : 'var(--c-green)';
  m.textContent = msg;
  clearTimeout(t._timer);
  t._timer = setTimeout(function(){ t.classList.remove('show'); }, 3400);
}

/* ══════════════════════════════════════════════════════════════
   PAGE SCROLL PROGRESS
═══════════════════════════════════════════════════════════════= */
window.addEventListener('scroll', function(){
  var doc = document.documentElement;
  var pct = (doc.scrollTop / (doc.scrollHeight - doc.clientHeight)) * 100 || 0;
  var fill = el('page-progress-fill');
  if(fill) fill.style.width = pct + '%';
}, {passive:true});

/* ══════════════════════════════════════════════════════════════
   MODULE ACCORDION
═══════════════════════════════════════════════════════════════= */
qsa('.sb-module-btn').forEach(function(btn){
  btn.addEventListener('click', function(){
    var mod   = btn.dataset.mod;
    var pane  = el('sbLessons' + mod);
    var isOpen = btn.classList.contains('open');
    btn.classList.toggle('open', !isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
    if(pane) pane.classList.toggle('open', !isOpen);
  });
});

/* ══════════════════════════════════════════════════════════════
   LOAD LESSON — switch video + update UI without page reload
═══════════════════════════════════════════════════════════════= */
function loadLesson(lessonEl) {
  if(!lessonEl) return;

  var id          = lessonEl.dataset.lessonId;
  var title       = lessonEl.dataset.lessonTitle;
  var videoUrl    = lessonEl.dataset.videoUrl;
  var moduleTitle = lessonEl.dataset.moduleTitle;
  var isCompleted = lessonEl.dataset.completed === 'true';

  /* ── update STATE ── */
  STATE.currentLessonId        = id;
  STATE.currentLessonCompleted = isCompleted;

  /* ── swap video ── */
  var ratio = el('videoRatio');
  if(ratio){
    if(videoUrl && videoUrl.trim()){
      /* reuse existing iframe or create one */
      var frame = el('videoFrame');
      if(!frame){
        ratio.innerHTML = '<iframe id="videoFrame" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"></iframe>';
        frame = el('videoFrame');
      }
      frame.src   = videoUrl;
      frame.title = title;
    } else {
      ratio.innerHTML = '<div class="video-placeholder"><div class="vp-icon"><i class="fas fa-play-circle"></i></div><p>No video attached to this lesson</p></div>';
    }
  }

  /* ── update lesson info ── */
  var titleEl = el('lessonTitle');
  var crumb   = el('lessonModuleCrumb');
  if(titleEl) titleEl.textContent = title;
  if(crumb)   crumb.textContent   = moduleTitle;

  /* ── mark complete button ── */
  updateMarkBtn(isCompleted);

  /* ── highlight active lesson in sidebar ── */
  qsa('.sb-lesson').forEach(function(l){ l.classList.remove('active'); });
  lessonEl.classList.add('active');

  /* ── open parent module if collapsed ── */
  var parentPane = lessonEl.closest('.sb-lessons');
  if(parentPane && !parentPane.classList.contains('open')){
    parentPane.classList.add('open');
    var parentBtn = parentPane.previousElementSibling;
    if(parentBtn) parentBtn.classList.add('open');
  }

  /* ── load notes ── */
  loadNotes(id);

  /* ── update prev/next buttons ── */
  updateNavArrows();

  /* ── scroll lesson into view in sidebar ── */
  setTimeout(function(){
    lessonEl.scrollIntoView({behavior:'smooth', block:'nearest'});
  }, 100);
}

/* ── click handler for every lesson row ── */
qsa('.sb-lesson').forEach(function(lesson){
  lesson.addEventListener('click',   function(){ loadLesson(lesson); });
  lesson.addEventListener('keydown', function(e){
    if(e.key==='Enter'||e.key===' '){ e.preventDefault(); loadLesson(lesson); }
  });
});

/* ══════════════════════════════════════════════════════════════
   MARK AS COMPLETE
═══════════════════════════════════════════════════════════════= */
function updateMarkBtn(isCompleted) {
  var btn = el('markCompleteBtn');
  if(!btn) return;
  if(isCompleted){
    btn.className   = 'btn-mark done';
    btn.innerHTML   = '<i class="fas fa-check-circle"></i> Completed';
  } else {
    btn.className   = 'btn-mark';
    btn.innerHTML   = '<i class="far fa-circle"></i> Mark Complete';
  }
}

el('markCompleteBtn') && el('markCompleteBtn').addEventListener('click', async function(){
  if(STATE.currentLessonCompleted) return;

  var btn     = el('markCompleteBtn');
  var orig    = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving…';
  btn.disabled  = true;

  try {
    var res  = await fetch('/api/lesson/complete', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ lessonId: STATE.currentLessonId, courseId: STATE.courseId })
    });
    var data = await res.json();

    if(data.success){
      /* ── update local STATE ── */
      STATE.currentLessonCompleted = true;
      if(data.completedLessons !== undefined) STATE.completedLessons = data.completedLessons;
      else STATE.completedLessons += 1;
      if(data.total !== undefined) STATE.totalLessons = data.total;
      STATE.progress = data.progress !== undefined
        ? Math.round(data.progress)
        : Math.round((STATE.completedLessons / STATE.totalLessons) * 100);

      /* ── mark lesson completed in sidebar ── */
      var lessonEl = qs('.sb-lesson[data-lesson-id="' + STATE.currentLessonId + '"]');
      if(lessonEl){
        lessonEl.classList.add('completed');
        lessonEl.dataset.completed = 'true';
        var statusDot = lessonEl.querySelector('.sb-lesson-status');
        if(statusDot){
          statusDot.className = 'sb-lesson-status done';
          statusDot.innerHTML = '<i class="fas fa-check"></i>';
        }
      }

      /* ── update allLessons state ── */
      STATE.allLessons.forEach(function(l){
        if(String(l.id) === String(STATE.currentLessonId)) l.completed = true;
      });

      /* ── refresh all progress bars ── */
      updateAllProgress(STATE.progress, STATE.completedLessons, STATE.totalLessons);

      updateMarkBtn(true);
      showToast('Lesson marked complete! 🎉');

      /* ── celebrate if course finished ── */
      if(STATE.progress >= 100){
        fireCelebration();
        updateCertTab(true);
      }

      /* ── auto-advance ── */
      var nextIdx = currentLessonIdx() + 1;
      if(nextIdx < STATE.allLessons.length){
        setTimeout(function(){ goToIdx(nextIdx); }, 700);
      }

    } else {
      showToast(data.message || 'Something went wrong.', true);
      btn.innerHTML = orig;
      btn.disabled  = false;
    }
  } catch(err) {
    showToast('Network error — please try again.', true);
    btn.innerHTML = orig;
    btn.disabled  = false;
  }
});

/* ── update all progress indicators ── */
function updateAllProgress(pct, done, total){
  /* topbar */
  var tbFill  = el('tbProgFill');  if(tbFill)  tbFill.style.width  = pct + '%';
  var tbPct   = el('tbProgPct');   if(tbPct)   tbPct.textContent   = pct + '%';
  var tbLabel = el('tbProgLabel'); if(tbLabel) tbLabel.textContent  = done + '/' + total;
  /* sidebar */
  var sbFill  = el('sbProgFill');  if(sbFill)  sbFill.style.width  = pct + '%';
  var sbPct   = el('sbProgPct');   if(sbPct)   sbPct.textContent   = pct + '%';
  var sbLabel = el('sbProgLabel'); if(sbLabel) sbLabel.textContent  = done + ' of ' + total + ' lessons completed';
  /* cert tab fill */
  var certFill = el('certProgFill'); if(certFill) certFill.style.width = pct + '%';
}

/* ══════════════════════════════════════════════════════════════
   PREV / NEXT NAVIGATION
═══════════════════════════════════════════════════════════════= */
function currentLessonIdx(){
  return STATE.allLessons.findIndex(function(l){
    return String(l.id) === String(STATE.currentLessonId);
  });
}

function updateNavArrows(){
  var idx  = currentLessonIdx();
  var prev = el('btnPrev');
  var next = el('btnNext');
  if(prev) prev.disabled = (idx <= 0);
  if(next) next.disabled = (idx < 0 || idx >= STATE.allLessons.length - 1);
}

function goToIdx(idx){
  if(idx < 0 || idx >= STATE.allLessons.length) return;
  var lesson = STATE.allLessons[idx];
  var lessonEl = qs('.sb-lesson[data-lesson-id="' + lesson.id + '"]');
  if(lessonEl) loadLesson(lessonEl);
}

el('btnPrev') && el('btnPrev').addEventListener('click', function(){
  goToIdx(currentLessonIdx() - 1);
});
el('btnNext') && el('btnNext').addEventListener('click', function(){
  goToIdx(currentLessonIdx() + 1);
});

/* ══════════════════════════════════════════════════════════════
   TABS
═══════════════════════════════════════════════════════════════= */
qsa('.tab-btn').forEach(function(btn){
  btn.addEventListener('click', function(){
    var tab = btn.dataset.tab;
    qsa('.tab-btn').forEach(function(b){ b.classList.remove('active'); b.setAttribute('aria-selected','false'); });
    qsa('.tab-pane').forEach(function(p){ p.classList.remove('active'); });
    btn.classList.add('active');
    btn.setAttribute('aria-selected','true');
    var pane = el('tab-' + tab);
    if(pane) pane.classList.add('active');
  });
});

/* ══════════════════════════════════════════════════════════════
   NOTES — per-lesson localStorage
═══════════════════════════════════════════════════════════════= */
function notesKey(id){ return 'nw-notes-' + id; }

function loadNotes(lessonId){
  var area = el('notesArea');
  if(area) area.value = localStorage.getItem(notesKey(lessonId)) || '';
  var msg = el('notesSavedMsg');
  if(msg) msg.classList.remove('show');
}

function saveNotes(){
  var area = el('notesArea');
  if(!area) return;
  localStorage.setItem(notesKey(STATE.currentLessonId), area.value);
  var msg = el('notesSavedMsg');
  if(msg){ msg.classList.add('show'); setTimeout(function(){ msg.classList.remove('show'); }, 2000); }
}

var notesTimer;
el('notesArea') && el('notesArea').addEventListener('input', function(){
  clearTimeout(notesTimer);
  notesTimer = setTimeout(saveNotes, 900);
});
el('saveNotesBtn') && el('saveNotesBtn').addEventListener('click', saveNotes);

/* ══════════════════════════════════════════════════════════════
   CERTIFICATE TAB — dynamically update on 100%
═══════════════════════════════════════════════════════════════= */
function updateCertTab(ready){
  var pane = el('tab-certificate');
  if(!ready || !pane) return;
  pane.innerHTML =
    '<div class="cert-box">'
    + '<span class="cert-trophy">🏆</span>'
    + '<h3>Congratulations!</h3>'
    + '<p>You\'ve completed this course. Your certificate is ready.</p>'
    + '<a href="/api/certificate/' + STATE.courseId + '" target="_blank" class="btn-cert-dl">'
    + '<i class="fas fa-download"></i> Download Certificate</a>'
    + '</div>';
}

/* ══════════════════════════════════════════════════════════════
   CELEBRATION CONFETTI
═══════════════════════════════════════════════════════════════= */
function fireCelebration(){
  var colors = ['#6b8cff','#5cc678','#f97316','#a78bfa','#fbbf24','#ef4444'];
  for(var i = 0; i < 60; i++){
    (function(i){
      setTimeout(function(){
        var p = document.createElement('div');
        p.className = 'confetti-piece';
        p.style.left = (Math.random() * 100) + 'vw';
        p.style.top  = '-10px';
        p.style.background = colors[Math.floor(Math.random() * colors.length)];
        p.style.animationDelay  = (Math.random() * .6) + 's';
        p.style.animationDuration = (1 + Math.random() * .8) + 's';
        p.style.width  = (6 + Math.random() * 8) + 'px';
        p.style.height = (6 + Math.random() * 8) + 'px';
        document.body.appendChild(p);
        setTimeout(function(){ p.remove(); }, 2500);
      }, i * 22);
    })(i);
  }
  showToast('🎉 Course complete! Your certificate is ready.');
}

/* ══════════════════════════════════════════════════════════════
   SIDEBAR TOGGLE (mobile)
═══════════════════════════════════════════════════════════════= */
var sidebar    = el('playerSidebar');
var mobOverlay = el('mobSbOverlay');
var sbClose    = el('sbClose');
var mobToggle  = el('mobSbToggle');

function openSidebar(){
  sidebar && sidebar.classList.add('mob-open');
  mobOverlay && mobOverlay.classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeSidebar(){
  sidebar && sidebar.classList.remove('mob-open');
  mobOverlay && mobOverlay.classList.remove('open');
  document.body.style.overflow = '';
}
mobToggle  && mobToggle.addEventListener('click', openSidebar);
sbClose    && sbClose.addEventListener('click', closeSidebar);
mobOverlay && mobOverlay.addEventListener('click', closeSidebar);

/* ══════════════════════════════════════════════════════════════
   USER MENU DROPDOWN
═══════════════════════════════════════════════════════════════= */
(function(){
  var btn  = el('userMenuBtn');
  var drop = el('userMenuDrop');
  if(!btn || !drop) return;
  btn.addEventListener('click', function(e){
    e.stopPropagation();
    var isOpen = drop.style.opacity === '1';
    drop.style.opacity         = isOpen ? '0' : '1';
    drop.style.visibility      = isOpen ? 'hidden' : 'visible';
    drop.style.pointerEvents   = isOpen ? 'none' : 'auto';
    drop.style.transform       = isOpen ? 'translateY(4px)' : 'translateY(0)';
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
  document.addEventListener('click', function(){
    drop.style.opacity       = '0';
    drop.style.visibility    = 'hidden';
    drop.style.pointerEvents = 'none';
    drop.style.transform     = 'translateY(4px)';
    btn.setAttribute('aria-expanded','false');
  });
})();

/* ══════════════════════════════════════════════════════════════
   KEYBOARD SHORTCUTS
═══════════════════════════════════════════════════════════════= */
var kbTip  = el('kb-tip');
var kbBtn  = el('kbToggleBtn');
var kbShow = false;
function toggleKbTip(){
  kbShow = !kbShow;
  kbTip && kbTip.classList.toggle('show', kbShow);
}
kbBtn && kbBtn.addEventListener('click', toggleKbTip);

document.addEventListener('keydown', function(e){
  /* ignore when typing in textarea/input */
  if(e.target.tagName === 'TEXTAREA' || e.target.tagName === 'INPUT') return;

  if(e.key === 'ArrowRight') goToIdx(currentLessonIdx() + 1);
  if(e.key === 'ArrowLeft')  goToIdx(currentLessonIdx() - 1);
  if(e.key.toLowerCase() === 'c'){
    var btn = el('markCompleteBtn');
    if(btn && !STATE.currentLessonCompleted) btn.click();
  }
  if(e.key.toLowerCase() === 'n'){
    qs('[data-tab="notes"]') && qs('[data-tab="notes"]').click();
    el('notesArea') && el('notesArea').focus();
  }
  if(e.key === '?') toggleKbTip();
  if(e.key === 'Escape') closeSidebar();
});

/* ══════════════════════════════════════════════════════════════
   INIT
═══════════════════════════════════════════════════════════════= */
(function init(){
  /* load notes for the initial lesson */
  loadNotes(STATE.currentLessonId);

  /* scroll active lesson into view */
  var active = qs('.sb-lesson.active');
  if(active) setTimeout(function(){ active.scrollIntoView({behavior:'smooth', block:'nearest'}); }, 400);

  /* show keyboard tip hint after 4s (once per session) */
  if(!sessionStorage.getItem('nw-kb-seen')){
    setTimeout(function(){
      if(kbTip){ kbTip.classList.add('show'); }
      setTimeout(function(){
        if(kbTip) kbTip.classList.remove('show');
        sessionStorage.setItem('nw-kb-seen','1');
      }, 4500);
    }, 4000);
  }
})();
</script>
