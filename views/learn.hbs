/* ═══════════════════════════════════════════════════════════
   DESIGN TOKENS — identical to home.hbs & course-dashboard.hbs
═══════════════════════════════════════════════════════════ */
:root{
  --blue:#1a4fd6; --blue-d:#1340b0; --blue-l:#4a7aee;
  --blue-pale:rgba(26,79,214,.08); --blue-pale2:rgba(26,79,214,.14);
  --orange:#e8620a; --orange-d:#c94f05; --orange-l:#f28840;
  --orange-pale:rgba(232,98,10,.08);
  --black:#050810; --ink:#0c1220; --ink-2:#141c30; --ink-3:#1c2840;
  --slate:#5a6880; --slate-l:#7a8ea8;
  --mist:#e2e8f5; --ghost:#f5f7fd; --white:#fff;
  --emerald:#059669; --teal:#0d9488; --yellow:#f59e0b; --rose:#e11d48;
  --kids-purple:#7c3aed; --kids-pink:#db2777; --kids-amber:#d97706;
  --g-blue:linear-gradient(135deg,#1a4fd6,#1340b0);
  --g-orange:linear-gradient(135deg,#e8620a,#c94f05);
  --g-green:linear-gradient(135deg,#059669,#047857);
  --g-kids:linear-gradient(135deg,#7c3aed,#db2777);
  --g-hero:linear-gradient(168deg,#030610 0%,#07102a 50%,#0b1535 100%);
  --r-xs:4px; --r-sm:8px; --r-md:12px; --r-lg:16px; --r-xl:22px;
  --r-2xl:30px; --r-pill:999px;
  --nav-h:66px;
  --ease:cubic-bezier(.4,0,.2,1);
  --spring:cubic-bezier(.34,1.56,.64,1);
  --t:.24s var(--ease);
  --sh-sm:0 1px 4px rgba(8,12,24,.06),0 4px 12px rgba(8,12,24,.06);
  --sh-md:0 4px 16px rgba(8,12,24,.08),0 12px 36px rgba(8,12,24,.08);
  --sh-lg:0 12px 40px rgba(8,12,24,.12),0 4px 12px rgba(8,12,24,.06);
  --sh-blue:0 8px 28px rgba(26,79,214,.28);
  --sh-orange:0 8px 28px rgba(232,98,10,.26);
}

/* ═══════════════════════════════════════════════════════════
   RESET
═══════════════════════════════════════════════════════════ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{font-family:'DM Sans',sans-serif;background:var(--ghost);color:var(--ink);overflow-x:hidden;font-size:15px;line-height:1.65}
h1,h2,h3,h4,h5{font-family:'Instrument Serif',Georgia,serif;line-height:1.15;font-weight:400}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
button,input,select{font-family:'DM Sans',sans-serif}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(37,99,235,.3);border-radius:4px}::-webkit-scrollbar-thumb:hover{background:var(--blue)}

/* ═══════════════════════════════════════════════════════════
   DARK MODE
═══════════════════════════════════════════════════════════ */
body.dark{background:var(--black);color:rgba(255,255,255,.84)}
body.dark .navbar{background:rgba(8,12,24,.97);border-bottom-color:rgba(255,255,255,.05)}
body.dark .navbar.scrolled{background:rgba(8,12,24,.99)}
body.dark .nl-a{color:rgba(255,255,255,.52)}
body.dark .nl-a:hover,.dark .nl-a.active{color:var(--blue-l);background:rgba(26,79,214,.1)}
body.dark .mega-drop{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-drop::before{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-link{color:rgba(255,255,255,.52)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:var(--ink-2)}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link{color:rgba(255,255,255,.82)}
body.dark .mob-close{background:rgba(255,255,255,.07);color:rgba(255,255,255,.7)}
body.dark .mob-hr{border-color:rgba(255,255,255,.07)}
body.dark .mob-footer{border-color:rgba(255,255,255,.07)}
body.dark .btn-nav-signin{color:rgba(255,255,255,.52);border-color:rgba(255,255,255,.1);background:transparent}
body.dark .nav-search-wrap{background:var(--ink-2);border-color:rgba(255,255,255,.1)}
body.dark .nav-search-wrap input{color:#fff}
body.dark .nav-search-wrap input::placeholder{color:rgba(255,255,255,.28)}
body.dark .user-menu{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .user-menu a{color:rgba(255,255,255,.65)}
body.dark .user-menu-divider{border-color:rgba(255,255,255,.07)}
/* catalog */
body.dark .hero-learn{background:linear-gradient(168deg,#020408 0%,#05091a 50%,#08102a 100%)}
body.dark .filter-sidebar{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .filter-group-title{color:rgba(255,255,255,.38)}
body.dark .filter-check-label{color:rgba(255,255,255,.65)}
body.dark .filter-check-label:hover{color:rgba(255,255,255,.9);background:rgba(255,255,255,.04)}
body.dark .course-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .course-card:hover{border-color:rgba(26,79,214,.3)}
body.dark .cc-title{color:rgba(255,255,255,.88)}
body.dark .cc-desc{color:rgba(255,255,255,.48)}
body.dark .cc-instr{color:rgba(255,255,255,.42)}
body.dark .cc-meta-item{color:rgba(255,255,255,.38)}
body.dark .cc-price-free{color:#34d399}
body.dark .cc-rating-val{color:rgba(255,255,255,.85)}
body.dark .cc-stars-track{color:rgba(255,255,255,.12)}
body.dark .sort-bar{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .sort-label{color:rgba(255,255,255,.38)}
body.dark .sort-btn{background:var(--ink-3);border-color:rgba(255,255,255,.1);color:rgba(255,255,255,.55)}
body.dark .sort-btn.on{background:var(--blue);border-color:var(--blue);color:#fff}
body.dark .results-count{color:rgba(255,255,255,.38)}
body.dark .section-divider{border-color:rgba(255,255,255,.06)}
body.dark .featured-band{background:linear-gradient(135deg,var(--ink-2),var(--ink));border-color:rgba(255,255,255,.07)}
body.dark .search-bar-wrap{background:var(--ink-2);border-color:rgba(255,255,255,.1)}
body.dark .search-bar-wrap input{color:#fff}
body.dark .search-bar-wrap input::placeholder{color:rgba(255,255,255,.3)}
body.dark .kids-band{border-color:rgba(124,58,237,.25)}
body.dark .kids-mini-card{background:rgba(124,58,237,.12);border-color:rgba(124,58,237,.22)}
body.dark .kids-mini-title{color:rgba(255,255,255,.88)}
body.dark .kids-mini-desc{color:rgba(255,255,255,.45)}
body.dark .kids-mini-age{background:rgba(124,58,237,.2);color:#c4b5fd}
body.dark .enroll-modal{background:var(--ink-2)}
body.dark .em-course-name{background:rgba(26,79,214,.15);color:var(--blue-l)}
body.dark .stats-strip-inner .ssi-val{color:#fff}
body.dark .lp-section.alt{background:var(--ink-2)}
body.dark .cta-teach-section{background:var(--black)}
body.dark #theme-toggle-fixed{background:var(--ink-2);border-color:rgba(255,255,255,.1)}
body.dark #theme-toggle-fixed svg{stroke:rgba(255,255,255,.7)}
body.dark .kids-section-head p{color:rgba(255,255,255,.52)}
body.dark .kids-section-wrapper{background:linear-gradient(180deg,#130a2a 0%,#0e0a1c 60%,var(--black) 100%)}
body.dark .no-results{color:rgba(255,255,255,.38)}

/* ═══════════════════════════════════════════════════════════
   SCROLL PROGRESS
═══════════════════════════════════════════════════════════ */
#scroll-progress{
  position:fixed;top:0;left:0;height:2px;width:0%;z-index:9999;
  background:linear-gradient(90deg,var(--blue),var(--orange),var(--kids-purple));
  transition:width .08s linear;
}

/* ═══════════════════════════════════════════════════════════
   NAVBAR — exact match with rest of site
═══════════════════════════════════════════════════════════ */
.navbar{
  position:fixed;top:0;left:0;right:0;z-index:1040;
  height:var(--nav-h);
  background:rgba(255,255,255,.96);
  backdrop-filter:blur(24px) saturate(2);
  border-bottom:1px solid rgba(8,12,24,.06);
  transition:var(--t);
}
.navbar.scrolled{background:rgba(255,255,255,.99);box-shadow:0 2px 24px rgba(8,12,24,.07)}
.nav-inner{max-width:1320px;margin:0 auto;padding:0 24px;height:100%;display:flex;align-items:center;gap:8px}
.nav-brand{font-family:var(--font-display);font-size:1.18rem;font-weight:700;color:var(--ink);flex-shrink:0;letter-spacing:-.04em;display:flex;align-items:center;gap:7px}
.brand-mark{width:30px;height:30px;background:var(--g-blue);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-size:.85rem;font-weight:700;color:#fff;flex-shrink:0}
.nav-brand em{font-style:italic;color:var(--orange)}
.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-item{position:relative}
.nl-a{font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 12px;border-radius:var(--r-sm);transition:var(--t);white-space:nowrap;display:flex;align-items:center;gap:5px}
.nl-a:hover,.nl-a.active{color:var(--blue);background:var(--blue-pale)}
.nl-chev{font-size:.52rem;transition:transform .22s}
.nl-item:hover .nl-chev{transform:rotate(180deg)}
.mega-drop{position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%) translateY(8px);min-width:520px;background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);box-shadow:0 24px 64px rgba(8,12,24,.14);padding:20px;opacity:0;visibility:hidden;pointer-events:none;transition:all .2s var(--ease)}
.nl-item:hover .mega-drop{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
.mega-drop::before{content:'';position:absolute;top:-5px;left:50%;width:10px;height:10px;background:#fff;border-left:1px solid var(--mist);border-top:1px solid var(--mist);transform:translateX(-50%) rotate(45deg)}
.mega-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px}
.mega-col-label{font-size:.61rem;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--blue);padding:0 8px 8px;display:block}
.mega-link{display:flex;align-items:center;gap:7px;padding:7px 10px;border-radius:var(--r-sm);font-size:.79rem;font-weight:500;color:var(--slate);transition:all .14s}
.mega-link i{width:15px;color:var(--blue);font-size:.74rem;flex-shrink:0}
.mega-link:hover{background:var(--blue-pale);color:var(--blue)}
.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}
/* search */
.nav-search-wrap{
  display:flex;align-items:center;gap:7px;
  background:var(--ghost);border:1.5px solid var(--mist);
  border-radius:var(--r-pill);padding:6px 14px 6px 12px;transition:var(--t);
}
.nav-search-wrap:focus-within{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-pale)}
.nav-search-wrap i{color:var(--slate-l);font-size:.78rem;flex-shrink:0}
.nav-search-wrap input{border:none;outline:none;background:transparent;font-size:.81rem;color:var(--ink);width:156px}
.nav-search-wrap input::placeholder{color:var(--slate-l)}
/* user */
.user-drop{position:relative}
.user-btn{display:inline-flex;align-items:center;gap:6px;background:var(--g-blue);color:#fff;border:none;padding:7px 16px;border-radius:var(--r-pill);font-size:.79rem;font-weight:700;cursor:pointer;transition:var(--t)}
.user-btn:hover{transform:translateY(-1px);box-shadow:var(--sh-blue)}
.user-btn .udc{font-size:.5rem;transition:transform .22s}
.user-drop:hover .udc{transform:rotate(180deg)}
.user-menu{position:absolute;top:calc(100% + 10px);right:0;min-width:196px;background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);box-shadow:var(--sh-md);padding:7px;opacity:0;visibility:hidden;pointer-events:none;transition:all .2s var(--ease)}
.user-drop:hover .user-menu{opacity:1;visibility:visible;pointer-events:auto}
.user-menu a{display:flex;align-items:center;gap:9px;padding:9px 12px;border-radius:var(--r-sm);font-size:.8rem;font-weight:600;color:var(--slate);transition:var(--t)}
.user-menu a i{width:14px;color:var(--blue);font-size:.74rem}
.user-menu a:hover{background:var(--blue-pale);color:var(--blue)}
.user-menu-divider{border:none;border-top:1px solid var(--mist);margin:5px 0}
.btn-nav-signin{font-size:.79rem;font-weight:600;color:var(--slate);padding:7px 14px;border:1.5px solid var(--mist);border-radius:var(--r-pill);background:#fff;cursor:pointer;transition:var(--t)}
.btn-nav-signin:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-signup{font-size:.79rem;font-weight:700;color:#fff;padding:8px 18px;border:none;border-radius:var(--r-pill);background:var(--g-blue);cursor:pointer;box-shadow:var(--sh-blue);display:inline-flex;align-items:center;gap:5px;transition:var(--t)}
.btn-nav-signup:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(26,79,214,.38)}
/* hamburger */
.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:44px;height:44px;background:none;border:none;cursor:pointer;border-radius:var(--r-sm);transition:var(--t);flex-shrink:0}
.ham-btn:hover{background:var(--blue-pale)}
.ham-line{display:block;width:20px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .24s var(--ease);transform-origin:center}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:38px;height:38px;border-radius:var(--r-sm);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:var(--t);background:var(--blue-pale);color:var(--blue)}
/* mobile panel */
.mob-overlay{position:fixed;inset:0;background:rgba(8,12,24,.55);backdrop-filter:blur(6px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .28s,visibility .28s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(340px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-12px 0 48px rgba(8,12,24,.18);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.82rem}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:11px;padding:12px 22px;font-size:.88rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px}
.mob-link i{width:18px;color:var(--blue);font-size:.8rem;flex-shrink:0}
.mob-link:hover,.mob-link.cur{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 18px}
.mob-footer{padding:14px 18px 30px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:9px}

/* ═══════════════════════════════════════════════════════════
   BUTTONS
═══════════════════════════════════════════════════════════ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-family:'DM Sans',sans-serif;font-weight:700;font-size:.86rem;border-radius:var(--r-pill);transition:var(--t);cursor:pointer;border:none;white-space:nowrap}
.btn-primary{background:var(--g-blue);color:#fff;padding:11px 24px;box-shadow:var(--sh-blue)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(26,79,214,.36)}
.btn-orange{background:var(--g-orange);color:#fff;padding:11px 22px;box-shadow:var(--sh-orange)}
.btn-orange:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(232,98,10,.36)}
.btn-outline{background:transparent;color:var(--blue);padding:10px 22px;border:1.5px solid var(--blue)}
.btn-outline:hover{background:var(--g-blue);color:#fff;transform:translateY(-2px)}
.btn-ghost-dark{background:rgba(255,255,255,.08);color:#fff;padding:10px 20px;border:1.5px solid rgba(255,255,255,.2);backdrop-filter:blur(8px)}
.btn-ghost-dark:hover{background:rgba(255,255,255,.16);transform:translateY(-2px)}
.btn-sm{padding:7px 16px;font-size:.77rem}
.btn-lg{padding:13px 30px;font-size:.92rem}

/* ═══════════════════════════════════════════════════════════
   FIXED WIDGETS
═══════════════════════════════════════════════════════════ */
#theme-toggle-fixed{position:fixed;bottom:22px;left:22px;z-index:10000;width:44px;height:44px;background:#fff;border:1.5px solid rgba(8,12,24,.08);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 18px rgba(8,12,24,.1);transition:var(--t)}
#theme-toggle-fixed svg{width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
#theme-toggle-fixed:hover{background:var(--blue);border-color:var(--blue);transform:rotate(20deg) scale(1.07)}
#theme-toggle-fixed:hover svg{stroke:#fff}
#back-to-top{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(16px);z-index:10000;width:48px;height:48px;background:var(--g-blue);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .3s,transform .4s var(--spring);box-shadow:var(--sh-blue)}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto}
#back-to-top svg{width:18px;height:18px;stroke:#fff;stroke-width:2.5;fill:none;stroke-linecap:round;stroke-linejoin:round}

/* ── WA float ── */
#wa-float{position:fixed;bottom:86px;right:20px;z-index:10001;text-decoration:none;display:block}
@keyframes wa-ripple{0%{transform:scale(1);opacity:.65}100%{transform:scale(2);opacity:0}}
@keyframes dot-p{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.45);opacity:.5}}
.wa-ring{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-ripple 2.8s ease-out infinite;pointer-events:none}
.wa-ring:nth-child(2){animation-delay:1.2s}
.wa-pill{display:flex;align-items:center;gap:9px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:8px 17px 8px 8px;box-shadow:0 6px 26px rgba(18,140,126,.42);transition:transform .3s var(--spring);white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-3px) scale(1.02)}
.wa-ico{width:36px;height:36px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.15rem;color:#fff;position:relative}
.wa-dot{position:absolute;top:1px;right:1px;width:9px;height:9px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dot-p 2.4s ease-in-out infinite}
.wa-text{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.64rem;color:rgba(255,255,255,.55);font-weight:600}
.wa-cta{font-size:.88rem;color:#fff;font-weight:800;font-family:'Instrument Serif',Georgia,serif}
.wa-arr{color:rgba(255,255,255,.6);font-size:.68rem;margin-left:2px;transition:transform .2s}
#wa-float:hover .wa-arr{transform:translateX(3px)}

/* Toast */
#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-md);padding:11px 17px;font-size:.82rem;display:flex;align-items:center;gap:9px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:210px;max-width:calc(100vw - 40px)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* Cookie */
#cookie-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.8);padding:12px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;z-index:9998;transform:translateY(100%);transition:transform .38s;border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap}
#cookie-bar.show{transform:translateY(0)}
#cookie-bar p{font-size:.77rem;margin:0;flex:1;min-width:180px}
#cookie-accept{background:var(--blue);color:#fff;border:none;padding:7px 18px;border-radius:var(--r-pill);font-size:.79rem;cursor:pointer;font-weight:700;transition:var(--t)}
#cookie-accept:hover{background:var(--blue-d)}

/* ═══════════════════════════════════════════════════════════
   HERO — dark, cinematic, Udemy-inspired
═══════════════════════════════════════════════════════════ */
.hero-learn{
  background:var(--g-hero);
  padding-top:var(--nav-h);
  position:relative;overflow:hidden;
}
.hero-learn::before{
  content:'';position:absolute;inset:0;
  background-image:linear-gradient(rgba(26,79,214,.05) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(26,79,214,.05) 1px,transparent 1px);
  background-size:44px 44px;
}
.hero-orb-1{position:absolute;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,rgba(26,79,214,.2) 0%,transparent 68%);top:-140px;right:-80px;pointer-events:none}
.hero-orb-2{position:absolute;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(13,148,136,.12) 0%,transparent 70%);bottom:-60px;left:-20px;pointer-events:none}

.hero-inner{
  position:relative;z-index:1;padding:56px 0 64px;
  display:grid;grid-template-columns:1fr;gap:36px;
}
.hero-kicker{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);
  border-radius:var(--r-pill);padding:5px 14px;
  color:rgba(255,255,255,.72);font-size:.72rem;font-weight:700;
  margin-bottom:14px;backdrop-filter:blur(8px);align-self:flex-start;
}
.hero-kicker .dot{width:6px;height:6px;border-radius:50%;background:#34d399;animation:dot-p 2s infinite;flex-shrink:0}
.hero-inner h1{font-size:clamp(2rem,6vw,3.6rem);font-weight:700;color:#fff;margin-bottom:12px}
.hero-inner h1 em{font-style:italic;color:var(--orange-l)}
.hero-inner>div>p{color:rgba(255,255,255,.55);font-size:clamp(.9rem,2.5vw,1.04rem);line-height:1.8;max-width:480px;margin-bottom:26px}

/* Inline search bar — Udemy-style in hero */
.hero-search-bar{
  display:flex;align-items:center;
  background:#fff;border-radius:var(--r-pill);
  padding:5px 5px 5px 18px;
  max-width:520px;margin-bottom:24px;
  box-shadow:0 8px 32px rgba(0,0,0,.28);
}
.hero-search-bar i{color:var(--slate);font-size:.88rem;flex-shrink:0;margin-right:8px}
.hero-search-bar input{
  flex:1;border:none;outline:none;font-size:.9rem;
  color:var(--ink);font-family:'DM Sans',sans-serif;
  background:transparent;
}
.hero-search-bar input::placeholder{color:var(--slate-l)}
.hero-search-bar button{
  background:var(--g-blue);color:#fff;border:none;
  padding:9px 22px;border-radius:var(--r-pill);
  font-size:.84rem;font-weight:700;cursor:pointer;transition:var(--t);
  flex-shrink:0;
}
.hero-search-bar button:hover{box-shadow:var(--sh-blue);transform:scale(1.02)}

/* hero stat pills */
.hero-stats-row{display:flex;flex-wrap:wrap;gap:12px 24px;padding-top:20px;border-top:1px solid rgba(255,255,255,.08)}
.hsr-item{display:flex;align-items:center;gap:8px}
.hsr-val{font-family:'Instrument Serif',Georgia,serif;font-size:1.45rem;font-weight:700;color:#fff;line-height:1}
.hsr-label{font-size:.71rem;color:rgba(255,255,255,.48);font-weight:600;text-transform:uppercase;letter-spacing:.6px}
.hsr-div{width:1px;height:32px;background:rgba(255,255,255,.14);align-self:center}

/* Hero preview card */
.hero-preview-card{
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);
  border-radius:var(--r-xl);padding:22px;backdrop-filter:blur(16px);
  display:flex;flex-direction:column;gap:14px;
}
.hpc-label{font-size:.64rem;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:rgba(255,255,255,.38)}
.hpc-badges{display:flex;flex-wrap:wrap;gap:6px}
.hpc-badge{padding:4px 11px;border-radius:var(--r-pill);font-size:.7rem;font-weight:700}
.hpc-badge.pop{background:rgba(13,148,136,.2);color:#34d399;border:1px solid rgba(13,148,136,.25)}
.hpc-badge.new{background:rgba(26,79,214,.2);color:#7ea8f8;border:1px solid rgba(26,79,214,.25)}
.hpc-badge.free{background:rgba(232,98,10,.18);color:var(--orange-l);border:1px solid rgba(232,98,10,.22)}
.hpc-badge.kids{background:rgba(124,58,237,.2);color:#c4b5fd;border:1px solid rgba(124,58,237,.25)}
.hpc-title{font-family:'Instrument Serif',Georgia,serif;font-size:.94rem;font-weight:700;color:#fff}
.hpc-progress-bar{height:4px;background:rgba(255,255,255,.1);border-radius:2px}
.hpc-progress-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--blue),var(--blue-l));width:78%}
.hpc-progress-labels{display:flex;justify-content:space-between;font-size:.67rem;color:rgba(255,255,255,.35);font-weight:600}
.hpc-avatars{display:flex;align-items:center;gap:9px;padding-top:12px;border-top:1px solid rgba(255,255,255,.08)}
.avatar-stack{display:flex}
.av-s{width:26px;height:26px;border-radius:50%;border:2px solid rgba(255,255,255,.2);background:var(--g-blue);display:flex;align-items:center;justify-content:center;font-size:.62rem;font-weight:700;color:#fff;margin-left:-8px}
.av-s:first-child{margin-left:0}
.hpc-avatars p{font-size:.72rem;color:rgba(255,255,255,.48);margin:0}
.hpc-avatars strong{color:rgba(255,255,255,.8)}

/* ═══════════════════════════════════════════════════════════
   MARQUEE
═══════════════════════════════════════════════════════════ */
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.marquee-wrap{background:var(--blue);padding:10px 0;overflow:hidden;white-space:nowrap}
.marquee-track{display:inline-flex;animation:marquee 30s linear infinite}
.marquee-track:hover{animation-play-state:paused}
.marquee-item{display:inline-flex;align-items:center;gap:7px;padding:0 24px;color:rgba(255,255,255,.88);font-size:.8rem;font-weight:600}
.marquee-sep{opacity:.28}

/* ═══════════════════════════════════════════════════════════
   STATS STRIP
═══════════════════════════════════════════════════════════ */
.stats-strip{background:linear-gradient(135deg,var(--blue),var(--blue-d));padding:32px 0}
.stats-strip-inner{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 40px;align-items:center}
.ssi{text-align:center;padding:6px 20px}
.ssi-val{font-family:'Instrument Serif',Georgia,serif;font-size:clamp(1.7rem,4vw,2.4rem);font-weight:700;color:#fff;line-height:1;margin-bottom:4px}
.ssi-label{font-size:.7rem;color:rgba(255,255,255,.6);font-weight:600;text-transform:uppercase;letter-spacing:.8px}
.ssi-div{width:1px;background:rgba(255,255,255,.18);align-self:stretch;margin:4px 0;display:none}

/* ═══════════════════════════════════════════════════════════
   CATALOG LAYOUT — Udemy sidebar + grid
═══════════════════════════════════════════════════════════ */
.catalog-wrap{
  max-width:1320px;margin:0 auto;padding:40px 24px 72px;
  display:grid;grid-template-columns:1fr;gap:28px;
}

/* ── FILTER SIDEBAR ── */
.filter-sidebar{
  background:#fff;border-radius:var(--r-xl);
  border:1px solid var(--mist);padding:20px;
  box-shadow:var(--sh-sm);
  height:fit-content;
  position:sticky;top:calc(var(--nav-h) + 12px);
}
.filter-sidebar-title{
  font-size:.78rem;font-weight:800;letter-spacing:1.2px;
  text-transform:uppercase;color:var(--slate-l);
  margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;
}
.filter-clear{
  font-size:.72rem;font-weight:600;color:var(--blue);
  cursor:pointer;background:none;border:none;transition:var(--t);
}
.filter-clear:hover{color:var(--blue-d)}
.filter-group{margin-bottom:20px}
.filter-group:last-child{margin-bottom:0}
.filter-group-title{
  font-size:.71rem;font-weight:800;text-transform:uppercase;
  letter-spacing:1.1px;color:var(--slate);margin-bottom:10px;
  display:flex;align-items:center;justify-content:space-between;cursor:pointer;
}
.fg-chev{font-size:.6rem;transition:transform .2s;color:var(--slate-l)}
.filter-group.collapsed .fg-chev{transform:rotate(-90deg)}
.filter-group.collapsed .filter-options{display:none}
.filter-options{display:flex;flex-direction:column;gap:4px}
.filter-check-label{
  display:flex;align-items:center;gap:8px;
  font-size:.81rem;color:var(--ink);cursor:pointer;
  padding:5px 8px;border-radius:var(--r-sm);transition:all .14s;
}
.filter-check-label:hover{color:var(--blue);background:var(--blue-pale)}
.filter-check-label input[type=checkbox]{
  width:15px;height:15px;accent-color:var(--blue);cursor:pointer;flex-shrink:0;
}
.filter-count{
  margin-left:auto;font-size:.68rem;color:var(--slate-l);
  background:var(--ghost);padding:1px 7px;border-radius:var(--r-pill);
}

/* ── MAIN CONTENT AREA ── */
.catalog-main{min-width:0}

/* search + sort bar */
.sort-bar{
  background:#fff;border:1px solid var(--mist);border-radius:var(--r-xl);
  padding:14px 18px;margin-bottom:20px;
  display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  box-shadow:var(--sh-sm);
}
.search-bar-wrap{
  display:flex;align-items:center;gap:8px;
  background:var(--ghost);border:1.5px solid var(--mist);
  border-radius:var(--r-pill);padding:8px 14px 8px 12px;
  flex:1;min-width:180px;transition:var(--t);
}
.search-bar-wrap:focus-within{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-pale)}
.search-bar-wrap i{color:var(--slate-l);font-size:.8rem;flex-shrink:0}
.search-bar-wrap input{border:none;outline:none;background:transparent;font-size:.83rem;color:var(--ink);width:100%}
.search-bar-wrap input::placeholder{color:var(--slate-l)}
.sort-label{font-size:.74rem;font-weight:600;color:var(--slate);white-space:nowrap}
.sort-btns{display:flex;gap:5px;flex-wrap:wrap}
.sort-btn{
  padding:6px 13px;border-radius:var(--r-pill);
  font-size:.75rem;font-weight:600;cursor:pointer;
  border:1.5px solid var(--mist);background:#fff;color:var(--slate);
  transition:var(--t);
}
.sort-btn:hover{border-color:var(--blue);color:var(--blue)}
.sort-btn.on{background:var(--g-blue);border-color:transparent;color:#fff;box-shadow:0 4px 14px rgba(26,79,214,.28)}
.results-count{font-size:.74rem;color:var(--slate-l);margin-left:auto;white-space:nowrap}

/* ── SECTION HEADER ── */
.section-kicker{
  display:inline-flex;align-items:center;gap:7px;
  border-radius:var(--r-pill);padding:5px 14px;
  font-size:.67rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;
  margin-bottom:10px;border:1px solid rgba(26,79,214,.15);
  background:var(--blue-pale);color:var(--blue);
}
.section-kicker::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue);flex-shrink:0}
.section-kicker.orange{background:var(--orange-pale);color:var(--orange);border-color:rgba(232,98,10,.15)}
.section-kicker.orange::before{background:var(--orange)}
.section-kicker.kids{background:rgba(124,58,237,.08);color:var(--kids-purple);border-color:rgba(124,58,237,.2)}
.section-kicker.kids::before{background:var(--kids-purple)}
.section-head{margin-bottom:22px}
.section-head h2{font-size:clamp(1.4rem,3.5vw,2rem);font-weight:700;margin-bottom:6px}
.section-head p{color:var(--slate);font-size:.9rem}
.section-divider{border:none;border-top:1px solid var(--mist);margin:36px 0}

/* ── FEATURED BAND ── */
.featured-band{
  background:#fff;border:1px solid var(--mist);border-radius:var(--r-xl);
  padding:22px 24px;margin-bottom:26px;
  display:flex;gap:20px;align-items:center;
  box-shadow:var(--sh-sm);position:relative;overflow:hidden;
}
.featured-band::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--blue),var(--orange));
}
.fb-img{
  width:180px;height:110px;border-radius:var(--r-lg);overflow:hidden;flex-shrink:0;
  background:var(--mist);
}
.fb-img img{width:100%;height:100%;object-fit:cover}
.fb-body{flex:1;min-width:0}
.fb-label{font-size:.64rem;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:var(--orange);margin-bottom:6px}
.fb-title{font-family:'Instrument Serif',Georgia,serif;font-size:1.1rem;font-weight:700;color:var(--ink);margin-bottom:6px;line-height:1.25}
.fb-desc{font-size:.8rem;color:var(--slate);line-height:1.6;margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.fb-meta{display:flex;align-items:center;gap:14px;font-size:.72rem;color:var(--slate)}
.fb-meta .cc-stars-track{font-size:.82rem}
.fb-meta span{display:flex;align-items:center;gap:4px}
.fb-cta{flex-shrink:0}

/* ── COURSE CARDS ── */
.courses-grid{display:grid;grid-template-columns:1fr;gap:18px}

.course-card{
  background:#fff;border-radius:var(--r-xl);
  border:1px solid var(--mist);overflow:hidden;
  display:flex;flex-direction:column;
  transition:var(--t);box-shadow:var(--sh-sm);position:relative;
}
.course-card:hover{transform:translateY(-5px);box-shadow:var(--sh-lg);border-color:rgba(26,79,214,.18)}
.course-card::after{
  content:'';position:absolute;top:0;left:0;right:0;height:2.5px;
  background:linear-gradient(90deg,var(--blue),var(--orange));
  transform:scaleX(0);transform-origin:left;transition:transform .36s;
}
.course-card:hover::after{transform:scaleX(1)}

/* card image */
.cc-img{position:relative;overflow:hidden;height:168px;flex-shrink:0;background:var(--mist)}
.cc-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.course-card:hover .cc-img img{transform:scale(1.06)}
/* hover overlay with quick-enroll */
.cc-hover-overlay{
  position:absolute;inset:0;
  background:rgba(8,12,24,.7);backdrop-filter:blur(2px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
  opacity:0;transition:opacity .24s;
}
.course-card:hover .cc-hover-overlay{opacity:1}
.cc-hover-btn{
  display:inline-flex;align-items:center;gap:6px;
  background:#fff;color:var(--blue);
  padding:9px 20px;border-radius:var(--r-pill);
  font-size:.8rem;font-weight:700;transition:var(--t);
  border:none;cursor:pointer;text-decoration:none;
}
.cc-hover-btn:hover{background:var(--g-blue);color:#fff}
.cc-hover-preview{font-size:.73rem;color:rgba(255,255,255,.6)}

/* badges */
.cc-badges{position:absolute;top:10px;left:10px;display:flex;gap:5px;flex-wrap:wrap}
.cc-badge{display:inline-flex;align-items:center;gap:3px;padding:3px 9px;border-radius:var(--r-pill);font-size:.63rem;font-weight:800;backdrop-filter:blur(8px)}
.cc-badge.free{background:linear-gradient(135deg,var(--emerald),#10b981);color:#fff}
.cc-badge.paid{background:var(--g-orange);color:#fff}
.cc-badge.level{background:rgba(8,12,24,.72);color:#fff;border:1px solid rgba(255,255,255,.18)}
.cc-badge.best{background:var(--g-orange);color:#fff}
.cc-badge.new{background:var(--g-blue);color:#fff}

/* enrolled badge */
.cc-enrolled-badge{position:absolute;top:10px;right:10px;background:var(--g-green);color:#fff;padding:3px 9px;border-radius:var(--r-pill);font-size:.63rem;font-weight:800}

/* card body */
.cc-body{padding:16px 16px 18px;flex:1;display:flex;flex-direction:column}
.cc-cat{font-size:.64rem;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:var(--blue);margin-bottom:5px}
.cc-title{font-family:'Instrument Serif',Georgia,serif;font-size:.95rem;font-weight:700;line-height:1.35;margin-bottom:7px;color:var(--ink);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.cc-desc{font-size:.78rem;color:var(--slate);line-height:1.6;margin-bottom:10px;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.cc-instr{display:flex;align-items:center;gap:6px;margin-bottom:9px}
.cc-av{width:22px;height:22px;border-radius:50%;background:var(--g-blue);display:flex;align-items:center;justify-content:center;font-size:.58rem;font-weight:700;color:#fff;flex-shrink:0}
.cc-instr-name{font-size:.71rem;color:var(--slate);font-weight:600}
/* star row */
.cc-rating{display:flex;align-items:center;gap:5px;margin-bottom:9px}
.cc-stars-track{
  position:relative;display:inline-block;
  color:#d1d5db;font-size:.76rem;letter-spacing:.4px;line-height:1;
  user-select:none;
}
.cc-stars-track::before{
  content:'★★★★★';
  position:absolute;left:0;top:0;
  color:var(--yellow);
  width:var(--star-pct,100%);
  overflow:hidden;white-space:nowrap;
}
.cc-rating-val{font-size:.74rem;font-weight:700;color:var(--ink)}
.cc-rating-count{font-size:.68rem;color:var(--slate-l)}
.cc-rating-new{font-size:.64rem;color:var(--blue);font-weight:700;background:var(--blue-pale);padding:2px 8px;border-radius:var(--r-pill);border:1px solid rgba(26,79,214,.15)}
/* meta row */
.cc-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:13px}
.cc-meta-item{display:flex;align-items:center;gap:4px;font-size:.7rem;color:var(--slate-l)}
.cc-meta-item i{font-size:.65rem}
/* footer */
.cc-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto}
.cc-price-free{font-family:'Instrument Serif',Georgia,serif;font-size:1.05rem;font-weight:700;color:var(--emerald)}
.cc-price-paid{font-family:'Instrument Serif',Georgia,serif;font-size:1.05rem;font-weight:700;color:var(--ink)}
.cc-enroll-btn{
  display:inline-flex;align-items:center;gap:5px;
  background:var(--g-blue);color:#fff;
  padding:7px 15px;border-radius:var(--r-pill);
  font-size:.74rem;font-weight:700;
  border:none;cursor:pointer;transition:var(--t);
  box-shadow:0 4px 14px rgba(26,79,214,.26);
  text-decoration:none;
}
.cc-enroll-btn:hover{transform:translateY(-2px);box-shadow:var(--sh-blue)}
.cc-enroll-btn.locked{background:var(--ghost);color:var(--slate);border:1.5px solid var(--mist);box-shadow:none}
.cc-enroll-btn.locked:hover{background:var(--ink);color:#fff;border-color:transparent;box-shadow:0 4px 14px rgba(8,12,24,.22)}
.cc-enroll-btn.pay{background:linear-gradient(135deg,#0d1e40,#1a4fd6);color:#fff;box-shadow:0 4px 16px rgba(26,79,214,.3)}
.cc-enroll-btn.pay:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(26,79,214,.42)}
.cc-enroll-btn.enrolled{background:var(--g-green);box-shadow:0 4px 14px rgba(5,150,105,.26)}
.cc-enroll-btn.enrolled:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(5,150,105,.36)}

/* no results */
.no-results{padding:48px;text-align:center;color:var(--slate-l)}
.no-results i{font-size:2.4rem;display:block;opacity:.22;margin-bottom:12px}
.no-results p{font-size:.88rem}

/* ═══════════════════════════════════════════════════════════
   KIDS SECTION
═══════════════════════════════════════════════════════════ */
@keyframes float-y{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-10px) rotate(2deg)}}

.kids-section-wrapper{
  background:linear-gradient(180deg,#f0ebff 0%,#fdf4ff 60%,var(--ghost) 100%);
  padding:72px 0 80px;position:relative;overflow:hidden;
}
body.dark .kids-section-wrapper{background:linear-gradient(180deg,#130a2a 0%,#0e0a1c 60%,var(--black) 100%)}
.kids-section-wrapper::before{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(124,58,237,.06) 1px,transparent 1px);background-size:28px 28px}
.kids-blob-1{position:absolute;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,.12) 0%,transparent 70%);top:-80px;right:-80px;pointer-events:none}
.kids-blob-2{position:absolute;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(219,39,119,.08) 0%,transparent 70%);bottom:-40px;left:-40px;pointer-events:none}
.kids-section-head{text-align:center;position:relative;z-index:1;margin-bottom:44px}
.kids-section-kicker{display:inline-flex;align-items:center;gap:8px;background:rgba(124,58,237,.1);border:1px solid rgba(124,58,237,.22);border-radius:var(--r-pill);padding:5px 14px;font-size:.67rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:var(--kids-purple);margin-bottom:14px}
.kids-section-kicker .kd{width:5px;height:5px;border-radius:50%;background:var(--kids-purple);flex-shrink:0;animation:dot-p 2s infinite}
.kids-section-head h2{font-size:clamp(1.8rem,5vw,3rem);font-weight:700;margin-bottom:8px}
.kids-section-head p{color:var(--slate);max-width:520px;margin:0 auto;font-size:clamp(.88rem,2.2vw,1rem);line-height:1.76}
.g-kids{background:var(--g-kids);-webkit-background-clip:text;background-clip:text;color:transparent}

.kids-band{background:linear-gradient(130deg,#0c0a1e 0%,#130e2e 40%,#1a0a2e 100%);border-radius:var(--r-2xl);overflow:hidden;display:grid;grid-template-columns:1fr;position:relative;border:1px solid rgba(124,58,237,.2);box-shadow:0 24px 72px rgba(124,58,237,.18),0 8px 20px rgba(0,0,0,.3)}
.kids-band::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(124,58,237,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(124,58,237,.04) 1px,transparent 1px);background-size:36px 36px}
.kids-band::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--kids-purple),var(--kids-pink),var(--kids-amber))}
.kids-content{position:relative;z-index:2;padding:44px 40px}
.kids-tag{display:inline-flex;align-items:center;gap:7px;background:rgba(124,58,237,.18);border:1px solid rgba(124,58,237,.3);border-radius:var(--r-pill);padding:5px 14px;font-size:.68rem;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:#c4b5fd;margin-bottom:14px}
.kids-content h3{font-size:clamp(1.5rem,4vw,2.2rem);font-weight:700;color:#fff;margin-bottom:10px;line-height:1.15}
.kids-content h3 em{font-style:italic;background:var(--g-kids);-webkit-background-clip:text;background-clip:text;color:transparent}
.kids-content>p{color:rgba(255,255,255,.58);font-size:.9rem;line-height:1.74;max-width:440px;margin-bottom:22px}
.kids-features{list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:22px;max-width:380px}
.kids-features li{display:flex;align-items:center;gap:10px;font-size:.81rem;color:rgba(255,255,255,.7)}
.kids-features li i{width:20px;height:20px;border-radius:50%;background:rgba(124,58,237,.3);color:#c4b5fd;display:flex;align-items:center;justify-content:center;font-size:.62rem;flex-shrink:0}
.kids-badges{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:24px}
.kids-badge{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-pill);padding:4px 12px;font-size:.72rem;font-weight:700;color:rgba(255,255,255,.75)}
.kids-cta-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
.kids-cta-primary{display:inline-flex;align-items:center;gap:7px;background:linear-gradient(135deg,var(--kids-purple),#9d4edd);color:#fff;padding:11px 22px;border-radius:var(--r-pill);font-size:.87rem;font-weight:800;transition:var(--t);box-shadow:0 8px 28px rgba(124,58,237,.32);text-decoration:none}
.kids-cta-primary:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(124,58,237,.44)}
.kids-cta-secondary{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.2);color:rgba(255,255,255,.82);padding:10px 20px;border-radius:var(--r-pill);font-size:.85rem;font-weight:700;transition:var(--t);text-decoration:none;backdrop-filter:blur(8px)}
.kids-cta-secondary:hover{background:rgba(255,255,255,.15);transform:translateY(-2px)}
.kids-trust{display:flex;flex-wrap:wrap;gap:12px}
.kids-trust-item{display:flex;align-items:center;gap:6px;font-size:.75rem;color:rgba(255,255,255,.44)}
.kids-trust-item i{color:#34d399;font-size:.72rem}
.kids-img-panel{position:relative;overflow:hidden;min-height:300px;flex-shrink:0}
.kids-img-panel img{width:100%;height:100%;object-fit:cover;opacity:.8}
.kids-img-panel::before{content:'';position:absolute;inset:0;z-index:1;background:linear-gradient(to right,#130e2e 0%,transparent 40%),linear-gradient(to top,#130e2e 0%,transparent 40%)}
.kids-float-cards{position:absolute;z-index:2;display:flex;flex-direction:column;gap:10px;bottom:20px;right:16px}
.kfc{background:rgba(255,255,255,.12);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.2);border-radius:var(--r-md);padding:10px 14px;display:flex;align-items:center;gap:9px;min-width:170px}
.kfc-icon{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0}
.kfc-icon.green{background:rgba(52,211,153,.2);color:#34d399}
.kfc-icon.purple{background:rgba(196,181,253,.2);color:#c4b5fd}
.kfc-label{font-size:.62rem;color:rgba(255,255,255,.5);font-weight:600;text-transform:uppercase;letter-spacing:.5px}
.kfc-val{font-size:.84rem;font-weight:800;color:#fff}
.kids-emoji-accent{position:absolute;top:20px;left:20px;z-index:3;font-size:2rem;animation:float-y 4s ease-in-out infinite;filter:drop-shadow(0 4px 12px rgba(0,0,0,.4))}
.kids-mini-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;margin-top:32px}
.kids-mini-card{background:rgba(124,58,237,.08);border:1px solid rgba(124,58,237,.16);border-radius:var(--r-lg);padding:16px 14px;display:flex;flex-direction:column;gap:7px;transition:var(--t);cursor:pointer}
.kids-mini-card:hover{transform:translateY(-4px);border-color:rgba(124,58,237,.38);box-shadow:0 12px 36px rgba(124,58,237,.14)}
.kids-mini-icon{font-size:1.55rem;margin-bottom:2px}
.kids-mini-title{font-size:.86rem;font-weight:700;color:var(--ink)}
.kids-mini-desc{font-size:.73rem;color:var(--slate);line-height:1.55}
.kids-mini-age{display:inline-flex;align-items:center;gap:4px;background:rgba(124,58,237,.1);color:var(--kids-purple);border-radius:var(--r-pill);padding:2px 9px;font-size:.64rem;font-weight:800;margin-top:auto;width:fit-content}

/* ═══════════════════════════════════════════════════════════
   ENROLL MODAL (login prompt for unauthenticated users)
═══════════════════════════════════════════════════════════ */
@keyframes modal-in{from{transform:scale(.92) translateY(12px);opacity:0}to{transform:none;opacity:1}}
.enroll-modal-bg{position:fixed;inset:0;background:rgba(8,12,24,.65);backdrop-filter:blur(12px);z-index:3000;display:none;align-items:center;justify-content:center;padding:16px}
.enroll-modal-bg.open{display:flex}
.enroll-modal{background:#fff;border-radius:var(--r-2xl);width:100%;max-width:420px;box-shadow:0 36px 88px rgba(0,0,0,.45);overflow:hidden;animation:modal-in .3s var(--spring) both}
body.dark .enroll-modal{background:var(--ink-2)}
/* dark hero header — matches payment modal premium feel */
.em-top{background:linear-gradient(135deg,#050e20,#0d1e40);padding:32px 28px 26px;text-align:center;position:relative}
.em-top::after{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(26,79,214,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(26,79,214,.04) 1px,transparent 1px);background-size:32px 32px;pointer-events:none}
.em-icon{width:60px;height:60px;background:linear-gradient(135deg,var(--blue),var(--blue-d));border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:1.45rem;color:#fff;box-shadow:0 8px 28px rgba(26,79,214,.4);position:relative;z-index:1}
.em-top h3{font-family:'Instrument Serif',Georgia,serif;font-size:1.4rem;font-weight:700;color:#fff;margin-bottom:6px;position:relative;z-index:1}
.em-top p{font-size:.8rem;color:rgba(255,255,255,.5);margin:0;position:relative;z-index:1;line-height:1.6}
.em-body{padding:22px 24px 26px;display:flex;flex-direction:column;gap:10px}
.em-course-label{font-size:.64rem;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:var(--slate-l);text-align:center;margin-bottom:2px}
.em-course-name{background:var(--blue-pale);border:1px solid rgba(26,79,214,.12);border-radius:var(--r-md);padding:10px 14px;font-size:.82rem;font-weight:600;color:var(--blue);text-align:center;line-height:1.4}
body.dark .em-course-name{background:rgba(26,79,214,.12);color:var(--blue-l)}
.em-divider{display:flex;align-items:center;gap:10px;margin:2px 0}
.em-divider::before,.em-divider::after{content:'';flex:1;height:1px;background:var(--mist)}
body.dark .em-divider::before,body.dark .em-divider::after{background:rgba(255,255,255,.08)}
.em-divider span{font-size:.68rem;color:var(--slate-l);font-weight:600;white-space:nowrap}
.em-btn-primary{display:flex;align-items:center;justify-content:center;gap:8px;background:var(--g-blue);color:#fff;padding:13px;border-radius:var(--r-pill);font-weight:700;font-size:.88rem;text-decoration:none;transition:var(--t);box-shadow:var(--sh-blue);font-family:'DM Sans',sans-serif}
.em-btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(26,79,214,.4)}
.em-btn-secondary{display:flex;align-items:center;justify-content:center;gap:8px;background:transparent;color:var(--slate);padding:12px;border-radius:var(--r-pill);font-weight:600;font-size:.85rem;text-decoration:none;border:1.5px solid var(--mist);transition:var(--t);font-family:'DM Sans',sans-serif}
body.dark .em-btn-secondary{color:rgba(255,255,255,.6);border-color:rgba(255,255,255,.1)}
.em-btn-secondary:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-pale)}
.em-dismiss{background:none;border:none;color:var(--slate-l);font-size:.74rem;cursor:pointer;font-family:'DM Sans',sans-serif;transition:var(--t);text-align:center;padding:4px 8px}
.em-dismiss:hover{color:var(--rose)}

/* ═══════════════════════════════════════════════════════════
   CTA TEACH
═══════════════════════════════════════════════════════════ */
.cta-teach-section{padding:72px 0;background:var(--ghost)}
.cta-teach-box{background:linear-gradient(135deg,var(--blue),var(--blue-d) 45%,#0e2d88);border-radius:var(--r-2xl);padding:52px 40px;text-align:center;position:relative;overflow:hidden}
.cta-teach-box::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:40px 40px}
.cta-teach-box::after{content:'';position:absolute;top:-80px;right:-80px;width:300px;height:300px;background:radial-gradient(circle,rgba(255,255,255,.07) 0%,transparent 70%);border-radius:50%}
.cta-teach-inner{position:relative;z-index:1}
.cta-teach-box h2{font-size:clamp(1.7rem,4.5vw,2.6rem);font-weight:700;color:#fff;margin-bottom:10px}
.cta-teach-box p{color:rgba(255,255,255,.65);font-size:clamp(.88rem,2vw,1rem);line-height:1.76;max-width:500px;margin:0 auto 26px}
.cta-teach-actions{display:flex;gap:11px;justify-content:center;flex-wrap:wrap}
.btn-cta-white{background:#fff;color:var(--blue);font-weight:800;border-radius:var(--r-pill);padding:12px 26px;font-size:.9rem;display:inline-flex;align-items:center;gap:7px;transition:var(--t);box-shadow:0 6px 22px rgba(0,0,0,.15)}
.btn-cta-white:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,0,0,.2)}
.btn-cta-orange{background:var(--g-orange);color:#fff;font-weight:800;border-radius:var(--r-pill);padding:12px 24px;font-size:.9rem;display:inline-flex;align-items:center;gap:7px;transition:var(--t);box-shadow:var(--sh-orange)}
.btn-cta-orange:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(232,98,10,.44)}

/* ═══════════════════════════════════════════════════════════
   FOOTER
═══════════════════════════════════════════════════════════ */
@keyframes bar-shift2{0%{background-position:0%}100%{background-position:200%}}
footer{background:#050810;color:rgba(255,255,255,.48);font-size:.82rem;border-top:1px solid rgba(255,255,255,.05)}
.footer-accent-bar{height:2px;background:linear-gradient(90deg,#1a4fd6,#e8620a,#7c3aed,#1a4fd6);background-size:200% 100%;animation:bar-shift2 6s linear infinite}
.footer-cta-strip{background:linear-gradient(135deg,#0c1630,#101f40);border-bottom:1px solid rgba(255,255,255,.05);padding:28px 0}
.footer-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
.footer-cta-text h4{font-family:'Instrument Serif',Georgia,serif;font-size:clamp(.95rem,2.8vw,1.3rem);font-weight:700;color:#fff;margin-bottom:2px;line-height:1.2}
.footer-cta-text p{font-size:.75rem;color:rgba(255,255,255,.35);margin:0}
.footer-cta-btns{display:flex;gap:9px;flex-wrap:wrap;flex-shrink:0}
.footer-body{padding:48px 0 32px}
.footer-cols{display:grid;grid-template-columns:2fr 1fr 1fr 1.6fr;gap:30px 24px}
.footer-brand-name{font-family:'Instrument Serif',Georgia,serif;font-size:1.1rem;font-weight:700;color:#fff;letter-spacing:-.04em;display:flex;align-items:center;gap:7px;margin-bottom:8px}
.footer-brand-name em{font-style:italic;color:#e8620a}
.footer-bmark{width:26px;height:26px;background:var(--g-blue);border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-size:.78rem;font-weight:700;color:#fff;flex-shrink:0}
.footer-tagline{font-size:.76rem;color:rgba(255,255,255,.32);line-height:1.74;max-width:260px;margin-bottom:14px}
.footer-socials{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.fsoc{width:31px;height:31px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);color:rgba(255,255,255,.46);font-size:.76rem;transition:all .2s;text-decoration:none}
.fsoc:hover{transform:translateY(-2px)}
.fsoc.fb:hover{background:#1877f2;color:#fff}
.fsoc.li:hover{background:#0077b5;color:#fff}
.fsoc.ig:hover{background:linear-gradient(135deg,#fd5949,#d6249f,#285aeb);color:#fff}
.fsoc.yt:hover{background:#ff0000;color:#fff}
.fsoc.wa:hover{background:#25D366;color:#fff}
.footer-col-title{font-size:.61rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:rgba(255,255,255,.25);margin-bottom:12px;display:flex;align-items:center;gap:6px}
.footer-col-title::before{content:'';width:10px;height:1.5px;background:var(--blue);border-radius:2px;flex-shrink:0}
.footer-links{list-style:none;padding:0;margin:0}
.footer-links li{margin-bottom:8px}
.footer-links a{color:rgba(255,255,255,.38);text-decoration:none;font-size:.76rem;transition:color .18s,padding-left .18s;display:inline-flex;align-items:center;gap:5px}
.footer-links a:hover{color:#fff;padding-left:3px}
.footer-links a i{width:12px;font-size:.65rem;opacity:.5}
.footer-links a.acad{color:#5eead4;font-weight:600}
.fci{display:flex;align-items:flex-start;gap:9px;margin-bottom:11px}
.fci-ic{width:27px;height:27px;flex-shrink:0;background:rgba(26,79,214,.12);border-radius:6px;display:flex;align-items:center;justify-content:center;color:var(--blue-l);font-size:.67rem;margin-top:1px}
.fci-label{font-size:.57rem;color:rgba(255,255,255,.2);font-weight:800;letter-spacing:.7px;text-transform:uppercase}
.fci-val{font-size:.76rem;color:rgba(255,255,255,.56)}
.fci-val a{color:rgba(255,255,255,.56);text-decoration:none;transition:color .18s}
.fci-val a:hover{color:var(--orange-l)}
.footer-hours{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.05);border-radius:6px;padding:5px 9px;font-size:.68rem;color:rgba(255,255,255,.34);margin-top:3px}
.hdot{width:6px;height:6px;background:#34d399;border-radius:50%;animation:dot-p 2.4s ease-in-out infinite;flex-shrink:0}
.footer-divider{border:none;border-top:1px solid rgba(255,255,255,.05)}
.footer-bottom{padding:14px 0}
.footer-bottom-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.footer-copy{font-size:.69rem;color:rgba(255,255,255,.2)}
.footer-legal{display:flex;gap:16px;flex-wrap:wrap}
.footer-legal a{font-size:.68rem;color:rgba(255,255,255,.22);text-decoration:none;transition:color .18s}
.footer-legal a:hover{color:rgba(255,255,255,.6)}
.footer-made{font-size:.68rem;color:rgba(255,255,255,.17);display:flex;align-items:center;gap:3px}
.footer-made span{color:var(--orange-l)}

/* ═══════════════════════════════════════════════════════════
   ANIMATIONS & UTILS
═══════════════════════════════════════════════════════════ */
.container{max-width:1320px;margin:0 auto;padding:0 24px}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-orange{background:var(--g-orange);-webkit-background-clip:text;background-clip:text;color:transparent}
@keyframes fade-in-up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.fade-in-up{animation:fade-in-up .4s var(--ease) both}
@keyframes bounce-up{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-8px)}}
#back-to-top.visible{animation:bounce-up 2.4s ease-in-out infinite}

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════════════ */
@media(min-width:600px){
  .container{padding:0 28px}
  .courses-grid{grid-template-columns:repeat(2,1fr)}
  .hero-stats-row{gap:12px 32px}
}
@media(min-width:768px){
  .kids-band{grid-template-columns:1fr 360px}
  .kids-mini-grid{grid-template-columns:repeat(3,1fr)}
