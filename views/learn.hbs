<!-- MAIN CONTENT: FILTER + COURSES -->
<div class="main-wrap" id="courses">
  <div class="container">
    <div class="main-grid">

      <!-- FILTER SIDEBAR -->
      <aside>
        <div class="filter-card">
          <div class="filter-header">
            <h5>Filter by</h5>
            <button class="filter-clear" id="clearFilters">Clear all</button>
          </div>
          <div class="filter-section">
            <div class="filter-section-title">Category</div>
            {{#each categories}}
            <div class="filter-opt">
              <input type="checkbox" id="cat-{{@index}}" value="{{lowercase this.category}}" class="category-filter">
              <label for="cat-{{@index}}">{{this.category}}</label>
              <span class="filter-badge-count">{{this.course_count}}</span>
            </div>
            {{/each}}
          </div>
          <div class="filter-section">
            <div class="filter-section-title">Level</div>
            <div class="filter-opt"><input type="checkbox" id="lv-beg" value="beginner" class="level-filter"><label for="lv-beg">Beginner</label><span class="filter-badge-count">{{beginnerCount}}</span></div>
            <div class="filter-opt"><input type="checkbox" id="lv-int" value="intermediate" class="level-filter"><label for="lv-int">Intermediate</label><span class="filter-badge-count">{{intermediateCount}}</span></div>
            <div class="filter-opt"><input type="checkbox" id="lv-adv" value="advanced" class="level-filter"><label for="lv-adv">Advanced</label><span class="filter-badge-count">{{advancedCount}}</span></div>
          </div>
          <div class="filter-section">
            <div class="filter-section-title">Price</div>
            <div class="filter-opt"><input type="checkbox" id="pr-free" value="free" class="price-filter"><label for="pr-free">Free</label><span class="filter-badge-count">{{freeCoursesCount}}</span></div>
            <div class="filter-opt"><input type="checkbox" id="pr-paid" value="paid" class="price-filter"><label for="pr-paid">Paid</label><span class="filter-badge-count">{{paidCoursesCount}}</span></div>
          </div>
        </div>
      </aside>

      <!-- COURSES COLUMN -->
      <div>
        <div class="courses-header">
          <h4>Courses to get you started</h4>
          <div class="sort-wrap">
            <button class="sort-btn active" id="sortPopular">Most popular</button>
            <button class="sort-btn" id="sortNew">Newest</button>
          </div>
        </div>

        <div class="courses-grid" id="coursesContainer">
          {{#each courses}}
          <div class="course-item"
               data-category="{{lowercase this.category}}"
               data-level="{{this.level}}"
               data-price="{{#if (eq this.price 0)}}free{{else}}paid{{/if}}"
               data-popular="{{this.popular}}"
               data-new="{{this.new}}">
            <div class="course-card">
              <div class="course-img-wrap">
                <img src="{{this.image_url}}" alt="{{this.title}}" class="course-img"
                     onerror="this.src='https://placehold.co/600x360/1a4fd6/white?text={{this.title}}'">
                <div class="course-badges">
                  {{#if (eq this.price 0)}}<span class="c-badge free"><i class="fas fa-gift"></i> Free</span>{{/if}}
                  {{#if this.bestseller}}<span class="c-badge bestseller"><i class="fas fa-fire"></i> Bestseller</span>{{/if}}
                  {{#if this.new}}<span class="c-badge new"><i class="fas fa-sparkles"></i> New</span>{{/if}}
                </div>
              </div>
              <div class="course-body">
                <div class="course-cat">{{this.category}}</div>
                <h3 class="course-title"><a href="/learn/course/{{this.id}}">{{this.title}}</a></h3>
                <p class="course-desc">{{this.description}}</p>
                <div class="course-instructor">
                  <div class="c-avatar">{{this.instructor_initial}}</div>
                  <span class="c-instr-name">{{this.instructor_name}}</span>
                </div>
                <div class="course-rating">
                  <div class="c-stars">{{{starRating this.rating}}}</div>
                  <span class="c-rating-count">({{this.enrolled_count}} enrolled)</span>
                </div>
                <div class="course-meta">
                  <span><i class="far fa-clock"></i> {{this.total_modules}} modules</span>
