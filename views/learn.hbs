<script>
/* ── THEME ── */
var dark = localStorage.getItem('nw-theme')==='dark'||(!localStorage.getItem('nw-theme')&&window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON='<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN='<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';

function applyTheme(){
  document.body.classList.toggle('dark',dark);
  document.getElementById('theme-toggle').innerHTML=dark?SUN:MOON;
  var tn=document.getElementById('theme-toggle-nav');
  var mt=document.getElementById('mobThemeBtn');
  if(tn)tn.innerHTML=dark?'<i class="fas fa-sun" style="font-size:.82rem"></i>':'<i class="fas fa-moon" style="font-size:.82rem"></i>';
  if(mt)mt.innerHTML=dark?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>';
}
applyTheme();
function toggleTheme(){dark=!dark;localStorage.setItem('nw-theme',dark?'dark':'light');applyTheme();}
document.getElementById('theme-toggle').addEventListener('click',toggleTheme);
var ttn=document.getElementById('theme-toggle-nav');if(ttn)ttn.addEventListener('click',toggleTheme);
var mtb=document.getElementById('mobThemeBtn');if(mtb)mtb.addEventListener('click',toggleTheme);

/* ── SCROLL ── */
var navbar=document.getElementById('mainNav');
var btt=document.getElementById('back-to-top');
var sp=document.getElementById('scroll-progress');
window.addEventListener('scroll',function(){
  var s=window.pageYOffset,d=document.documentElement.scrollHeight-window.innerHeight;
  if(sp)sp.style.width=(d>0?s/d*100:0)+'%';
  if(navbar)navbar.classList.toggle('scrolled',s>40);
  if(btt)btt.classList.toggle('visible',s>400);
},{passive:true});
if(btt)btt.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});

/* ── MOBILE NAV ── */
var ov=document.getElementById('mobOverlay'),pan=document.getElementById('mobPanel'),
    ham=document.getElementById('hamBtn'),mc=document.getElementById('mobClose');
function openM(){if(ov)ov.classList.add('open');if(pan)pan.classList.add('open');if(ham){ham.classList.add('open');ham.setAttribute('aria-expanded','true');}document.body.style.overflow='hidden';if(mc)mc.focus();}
function closeM(){if(ov)ov.classList.remove('open');if(pan)pan.classList.remove('open');if(ham){ham.classList.remove('open');ham.setAttribute('aria-expanded','false');}document.body.style.overflow='';}
if(ham)ham.addEventListener('click',openM);
if(mc)mc.addEventListener('click',closeM);
if(ov)ov.addEventListener('click',closeM);
document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeM();closeEnrollModal();}});

/* ── COOKIE ── */
var cb=document.getElementById('cookie-bar');
if(cb&&!localStorage.getItem('nw-cookie'))setTimeout(function(){cb.classList.add('show');},2800);
var ca=document.getElementById('cookie-accept');
if(ca)ca.addEventListener('click',function(){localStorage.setItem('nw-cookie','1');if(cb)cb.classList.remove('show');});

/* ── TOAST ── */
function toast(msg,type){
  var t=document.getElementById('toast');
  if(!t)return;
  document.getElementById('toast-msg').textContent=msg;
  t.style.borderLeftColor=type==='error'?'#ef4444':type==='info'?'#3b82f6':'#34d399';
  t.classList.add('show');
  setTimeout(function(){t.classList.remove('show');},3600);
}

/* ── MODAL ── */
var _pendingUrl='';
function showLoginPrompt(courseName,url){
  _pendingUrl=url||'';
  var el=document.getElementById('modalCourseName');
  if(el)el.textContent=courseName||'this course';
  var modal=document.getElementById('enrollModal');
  if(modal){modal.classList.add('open');document.body.style.overflow='hidden';}
}
function closeEnrollModal(){
  var modal=document.getElementById('enrollModal');
  if(modal){modal.classList.remove('open');document.body.style.overflow='';}
  _pendingUrl='';
}

/* ── LIVE STATS ── */
async function loadLiveStats(){
  try{
    var res=await fetch('/api/dashboard/public-stats').catch(function(){return null;});
    if(!res||!res.ok)return;
    var data=await res.json();
    var stats=data.stats||{};
    function animateNum(el,target){
      if(!el||isNaN(target)||target===0)return;
      var start=0,step=target/60;
      (function tick(){start=Math.min(start+step,target);el.textContent=Math.floor(start);if(start<target)requestAnimationFrame(tick);})();
    }
    if(stats.total_courses)animateNum(document.getElementById('statCourses'),parseInt(stats.total_courses));
    if(stats.total_enrollments)animateNum(document.getElementById('statEnrolled'),parseInt(stats.total_enrollments));
    if(stats.total_instructors)animateNum(document.getElementById('statInstructors'),parseInt(stats.total_instructors));
  }catch(e){}
}

/* ── ENROLL ── */
async function enrollInCourse(courseId,event){
  var btn=event?event.target:window.event.target;
  var originalHtml=btn.innerHTML;
  btn.disabled=true;
  btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Enrolling…';
  try{
    var response=await fetch('/api/enroll',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({courseId:courseId})});
    var data=await response.json();
    if(data.success){
      btn.innerHTML='<i class="fas fa-play-circle"></i> Continue Learning';
      btn.classList.add('enrolled');
      btn.disabled=false;
      btn.onclick=function(){window.location.href='/learn/course/'+courseId+'/dashboard';};
      var card=btn.closest('.fc-card');
      if(card){
        var enrolledSpan=card.querySelector('.fc-meta span:nth-child(2)');
        if(enrolledSpan&&enrolledSpan.innerHTML.includes('enrolled')){
          var match=enrolledSpan.innerHTML.match(/(\d+)/);
          if(match){var nc=parseInt(match[1])+1;enrolledSpan.innerHTML=enrolledSpan.innerHTML.replace(/\d+/,nc);}
        }
      }
      var statEl=document.getElementById('statEnrolled');
      if(statEl){var cur=parseInt(statEl.textContent)||0;statEl.textContent=cur+1;}
      loadLiveStats();
      toast('Successfully enrolled! Redirecting…');
      setTimeout(function(){window.location.href='/learn/course/'+courseId+'/dashboard';},1500);
    }else if(data.alreadyEnrolled){
      btn.innerHTML='<i class="fas fa-play-circle"></i> Continue Learning';
      btn.classList.add('enrolled');
      btn.disabled=false;
      btn.onclick=function(){window.location.href='/learn/course/'+courseId+'/dashboard';};
      toast('You are already enrolled in this course','info');
    }else{
      btn.innerHTML=originalHtml;btn.disabled=false;
      toast(data.message||'Enrollment failed. Please try again.','error');
    }
  }catch(error){
    btn.innerHTML=originalHtml;btn.disabled=false;
    toast('Network error. Please try again.','error');
  }
}

/* ── CHECK ENROLLMENT STATUS ── */
async function checkEnrollmentStatus(){
  if(!document.querySelector('.fc-enroll'))return;
  try{
    var response=await fetch('/api/user/enrollments');
    var data=await response.json();
    if(data.success&&data.enrollments){
      var ids=data.enrollments.map(function(e){return e.course_id;});
      document.querySelectorAll('.fc-enroll').forEach(function(btn){
        var oa=btn.getAttribute('onclick');
        if(oa){var m=oa.match(/enrollInCourse\((\d+)/);if(m){var cid=parseInt(m[1]);if(ids.indexOf(cid)!==-1){btn.innerHTML='<i class="fas fa-play-circle"></i> Continue Learning';btn.classList.add('enrolled');btn.disabled=false;btn.onclick=function(){window.location.href='/learn/course/'+cid+'/dashboard';};}}}}
      );
    }
  }catch(e){}
}

/* ── HERO STATS COUNTER ── */
var counted=false;
var statsObs=new IntersectionObserver(function(entries){
  if(counted)return;
  entries.forEach(function(entry){
    if(!entry.isIntersecting)return;
    counted=true;
    document.querySelectorAll('.h-stat-num').forEach(function(el){
      var raw=el.textContent.replace(/[^0-9]/g,'');
      var target=parseInt(raw,10);
      if(isNaN(target))return;
      var suffix=el.textContent.replace(/[0-9]/g,'').trim();
      var step=target/80,val=0;
      (function tick(){val=Math.min(val+step,target);el.textContent=Math.floor(val)+suffix;if(val<target)requestAnimationFrame(tick);})();
    });
  });
},{threshold:0.4});
var statsSection=document.querySelector('.hero-stats');
if(statsSection)statsObs.observe(statsSection);

/* ── KIDS MINI CARD HOVER — add subtle interactivity ── */
document.querySelectorAll('.kids-mini-card').forEach(function(card){
