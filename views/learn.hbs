<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>NeurowexTech Learn - Practical Skills, Real Results</title>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-light: #3b82f6;
            --secondary: #8b5cf6;
            --accent: #f97316;
            --dark: #050b18;
            --dark-2: #0d1526;
            --dark-3: #111827;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --white: #ffffff;
            --green: #10b981;
            --red: #ef4444;
            --yellow: #f59e0b;
            --grad-primary: linear-gradient(135deg, #2563eb, #1d4ed8);
            --grad-secondary: linear-gradient(135deg, #8b5cf6, #7c3aed);
            --grad-accent: linear-gradient(135deg, #f97316, #ea580c);
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -1px rgb(0 0 0 / 0.06);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -2px rgb(0 0 0 / 0.05);
            --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 10px 10px -5px rgb(0 0 0 / 0.04);
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --font-heading: 'Syne', var(--font-sans);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: var(--font-sans);
            background: var(--gray-50);
            color: var(--gray-700);
            overflow-x: hidden;
        }

        /* Dark Mode */
        body.dark {
            background: var(--dark);
            color: var(--gray-200);
        }
        body.dark .navbar {
            background: rgba(5, 11, 24, 0.98);
            border-bottom-color: rgba(255,255,255,0.06);
        }
        body.dark .navbar-brand {
            background: var(--grad-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        body.dark .nav-link {
            color: rgba(255,255,255,0.8) !important;
        }
        body.dark .nav-link:hover {
            color: var(--accent) !important;
        }
        body.dark .search-bar {
            background: var(--dark-3);
            border-color: rgba(255,255,255,0.1);
            color: white;
        }
        body.dark .search-bar input {
            color: white;
        }
        body.dark .search-bar input::placeholder {
            color: var(--gray-600);
        }
        body.dark .filters-section {
            background: var(--dark-2);
            border-color: rgba(255,255,255,0.08);
        }
        body.dark .filter-option:hover {
            background: rgba(255,255,255,0.05);
        }
        body.dark .course-card {
            background: var(--dark-2);
            border-color: rgba(255,255,255,0.08);
        }
        body.dark .course-title a {
            color: var(--white);
        }
        body.dark .course-title a:hover {
            color: var(--accent);
        }
        body.dark .topic-card {
            background: var(--dark-2);
            border-color: rgba(255,255,255,0.08);
        }
        body.dark .instructor-card {
            background: var(--dark-2);
            border-color: rgba(255,255,255,0.08);
        }
        body.dark footer {
            background: var(--dark-2);
        }
        body.dark .hero-code-preview {
            background: var(--dark-3) !important;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: rgba(255,255,255,0.98);
            backdrop-filter: blur(20px);
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--gray-200);
            transition: all 0.3s ease;
            z-index: 1040;
        }
        .navbar.scrolled {
            box-shadow: var(--shadow-md);
        }
        .navbar-brand {
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: 1.5rem;
            background: var(--grad-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .navbar-brand span {
            color: var(--accent);
            background: none;
            -webkit-background-clip: unset;
            background-clip: unset;
        }
        .nav-link {
            font-weight: 500;
            color: var(--gray-600) !important;
            transition: color 0.2s ease;
        }
        .nav-link:hover {
            color: var(--primary) !important;
        }
        .btn-outline-primary-custom {
            border: 2px solid var(--primary);
            background: transparent;
            color: var(--primary);
            padding: 6px 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-outline-primary-custom:hover {
            background: var(--grad-primary);
            color: white;
            transform: translateY(-2px);
        }
        .btn-primary-custom {
            background: var(--grad-primary);
            color: white;
            border: none;
            padding: 6px 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37,99,235,0.3);
        }
        .search-bar {
            background: var(--gray-100);
            border-radius: 50px;
            padding: 8px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid var(--gray-200);
            transition: all 0.3s ease;
        }
        .search-bar:focus-within {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
        }
        .search-bar input {
            background: none;
            border: none;
            outline: none;
            font-size: 0.85rem;
            width: 200px;
        }
        /* Theme Toggle */
        #theme-toggle-learn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--gray-100);
            border: 1px solid var(--gray-200);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        #theme-toggle-learn:hover {
            background: var(--primary);
            color: white;
        }
        @media (max-width: 768px) {
            .search-bar input { width: 120px; }
        }

        /* ===== HERO SECTION ===== */
        .hero-learn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 60px 0;
            position: relative;
            overflow: hidden;
        }
        body.dark .hero-learn {
            background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 100%);
        }
        .hero-learn::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 60%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
            pointer-events: none;
        }
        .hero-learn h1 {
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 800;
            color: white;
            margin-bottom: 1rem;
        }
        .hero-learn p {
            font-size: 1.1rem;
            color: rgba(255,255,255,0.85);
            max-width: 500px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-top: 30px;
        }
        .stat-card-learn {
            background: rgba(255,255,255,0.12);
            backdrop-filter: blur(10px);
            border-radius: var(--radius-lg);
            padding: 20px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.2);
        }
        .stat-number {
            font-size: 2rem;
            font-weight: 800;
            color: white;
        }
        .stat-label {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.75);
        }
        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
        }

        /* ===== FILTERS ===== */
        .filters-section {
            background: white;
            border-radius: var(--radius-lg);
            padding: 20px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-200);
            position: sticky;
            top: 80px;
        }
        .filter-group {
            margin-bottom: 20px;
        }
        .filter-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--gray-600);
            margin-bottom: 10px;
            display: block;
        }
        .filter-option {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            cursor: pointer;
            border-radius: var(--radius-sm);
            transition: all 0.2s ease;
        }
        .filter-option:hover {
            background: var(--gray-100);
        }
        .filter-option input {
            width: 16px;
            height: 16px;
            cursor: pointer;
        }
        .filter-option label {
            font-size: 0.85rem;
            cursor: pointer;
            margin: 0;
            flex: 1;
        }
        .filter-badge {
            background: var(--gray-100);
            color: var(--gray-600);
            font-size: 0.7rem;
            padding: 2px 8px;
            border-radius: 20px;
        }
        .clear-filters {
            color: var(--primary);
            font-size: 0.8rem;
            cursor: pointer;
            text-decoration: none;
        }
        .clear-filters:hover {
            text-decoration: underline;
        }

        /* ===== COURSE CARD ===== */
        .course-card {
            background: white;
            border-radius: var(--radius-lg);
            overflow: hidden;
            border: 1px solid var(--gray-200);
            transition: all 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: var(--primary-light);
        }
        .course-image {
            height: 180px;
            overflow: hidden;
            position: relative;
        }
        .course-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .course-card:hover .course-image img {
            transform: scale(1.05);
        }
        .course-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: var(--grad-primary);
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 50px;
        }
        .course-badge.free {
            background: var(--grad-accent);
        }
        .course-badge.bestseller {
            background: var(--grad-secondary);
            left: 12px;
            right: auto;
        }
        .course-content {
            padding: 20px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .course-category {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--primary);
            margin-bottom: 8px;
        }
        .course-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 10px;
            line-height: 1.4;
        }
        .course-title a {
            color: var(--gray-800);
            text-decoration: none;
            transition: color 0.2s;
        }
        .course-title a:hover {
            color: var(--primary);
        }
        .course-description {
            font-size: 0.8rem;
            color: var(--gray-600);
            margin-bottom: 15px;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .course-instructor {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }
        .instructor-avatar {
            width: 28px;
            height: 28px;
            background: var(--grad-secondary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            font-weight: 700;
            color: white;
        }
        .instructor-name {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--gray-700);
        }
        .course-rating {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 12px;
        }
        .stars {
            color: var(--yellow);
            font-size: 0.7rem;
            letter-spacing: 1px;
        }
        .rating-count {
            font-size: 0.7rem;
            color: var(--gray-600);
        }
        .course-meta {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
            font-size: 0.7rem;
            color: var(--gray-600);
        }
        .course-meta i {
            width: 16px;
        }
        .course-price {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 15px;
        }
        .btn-view-course {
            background: transparent;
            border: 2px solid var(--primary);
            color: var(--primary);
            padding: 8px 16px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.8rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.3s ease;
            margin-top: auto;
        }
        .btn-view-course:hover {
            background: var(--grad-primary);
            color: white;
            transform: translateY(-2px);
        }

        /* ===== TOPICS SECTION ===== */
        .topic-card {
            background: white;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius-lg);
            padding: 20px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .topic-card:hover {
            transform: translateY(-4px);
            border-color: var(--primary);
            box-shadow: var(--shadow-md);
        }
        .topic-icon {
            width: 60px;
            height: 60px;
            background: var(--gray-100);
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 1.5rem;
        }
        body.dark .topic-icon {
            background: var(--dark-3);
        }
        .topic-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .topic-count {
            font-size: 0.7rem;
            color: var(--gray-600);
        }

        /* ===== INSTRUCTOR CARD ===== */
        .instructor-card {
            background: white;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius-lg);
            padding: 25px;
            text-align: center;
            transition: all 0.3s ease;
        }
        .instructor-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }
        .instructor-avatar-large {
            width: 80px;
            height: 80px;
            background: var(--grad-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 2rem;
            font-weight: 700;
            color: white;
        }
        .instructor-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .instructor-title {
            font-size: 0.75rem;
            color: var(--primary);
            margin-bottom: 10px;
        }
        .instructor-stats {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 15px;
            font-size: 0.7rem;
        }
        .instructor-rating {
            color: var(--yellow);
        }

        /* ===== CTA SECTION ===== */
        .cta-teach {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: var(--radius-xl);
            padding: 50px;
            text-align: center;
            color: white;
        }
        body.dark .cta-teach {
            background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 100%);
        }
        .btn-teach {
            background: white;
            color: var(--primary);
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }
        .btn-teach:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        /* ===== FOOTER ===== */
        footer {
            background: var(--dark);
            color: rgba(255,255,255,0.7);
            padding: 50px 0 30px;
            margin-top: 50px;
        }
        footer h5 {
            color: white;
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 20px;
        }
        footer a {
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            font-size: 0.8rem;
            transition: color 0.2s;
        }
        footer a:hover {
            color: var(--accent);
        }
        footer ul li {
            margin-bottom: 8px;
        }
        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 20px;
            margin-top: 30px;
            font-size: 0.75rem;
        }
        .social-icon {
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        .social-icon:hover {
            background: var(--primary);
            transform: translateY(-3px);
        }

        @media (max-width: 768px) {
            .hero-learn { padding: 40px 0; text-align: center; }
            .filters-section { position: static; margin-bottom: 20px; }
            .cta-teach { padding: 30px 20px; }
        }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">Neurowex<span>Tech</span> Learn</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
