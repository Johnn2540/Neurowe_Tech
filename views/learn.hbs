.pay-modal-bg{position:fixed;inset:0;background:rgba(8,12,24,.7);backdrop-filter:blur(12px);z-index:3100;display:none;align-items:center;justify-content:center;padding:16px}
.pay-modal-bg.open{display:flex}
.pay-modal{background:#fff;border-radius:var(--r-2xl);width:100%;max-width:460px;box-shadow:0 36px 90px rgba(0,0,0,.5);overflow:hidden;animation:modal-in .3s var(--spring) both;max-height:calc(100dvh - 48px);display:flex;flex-direction:column}
body.dark .pay-modal{background:var(--ink-2)}

.pm-header{background:linear-gradient(135deg,#050e20,#0d1e40);padding:26px 24px 22px;position:relative;flex-shrink:0}
.pm-close{position:absolute;top:14px;right:14px;width:32px;height:32px;border:none;background:rgba(255,255,255,.1);border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.65);font-size:.78rem;transition:var(--t)}
.pm-close:hover{background:rgba(255,255,255,.2);color:#fff}
.pm-secure-chip{display:inline-flex;align-items:center;gap:5px;background:rgba(5,150,105,.2);border:1px solid rgba(5,150,105,.3);border-radius:var(--r-pill);padding:3px 11px;font-size:.65rem;font-weight:800;letter-spacing:.8px;text-transform:uppercase;color:#34d399;margin-bottom:10px}
.pm-amount-row{display:flex;align-items:baseline;gap:5px;margin-bottom:5px}
.pm-currency{font-size:1rem;font-weight:700;color:rgba(255,255,255,.5);margin-top:4px}
.pm-amount{font-family:'Instrument Serif',Georgia,serif;font-size:2.6rem;font-weight:700;color:#fff;line-height:1}
.pm-course-name{font-size:.8rem;color:rgba(255,255,255,.45);line-height:1.5;max-width:340px}
.pm-trust-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,.07)}
.pm-trust-item{display:flex;align-items:center;gap:5px;font-size:.67rem;color:rgba(255,255,255,.38);font-weight:600}
.pm-trust-item i{color:#34d399;font-size:.62rem}

.pm-tabs{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--mist);flex-shrink:0}
body.dark .pm-tabs{border-color:rgba(255,255,255,.08)}
.pm-tab{display:flex;align-items:center;justify-content:center;gap:6px;padding:13px 10px;font-size:.8rem;font-weight:700;cursor:pointer;border:none;background:transparent;color:var(--slate);transition:var(--t);border-bottom:2.5px solid transparent;margin-bottom:-1px;font-family:'DM Sans',sans-serif}
body.dark .pm-tab{color:rgba(255,255,255,.4)}
.pm-tab:hover{color:var(--blue);background:var(--blue-pale)}
.pm-tab.active{color:var(--blue);border-bottom-color:var(--blue);background:var(--blue-pale)}
body.dark .pm-tab.active{background:rgba(26,79,214,.12);color:var(--blue-l)}
.pm-tab-wa.active{color:#075E54;border-bottom-color:#25D366;background:rgba(37,211,102,.06)}
body.dark .pm-tab-wa.active{color:#34d399}

.pm-body{padding:22px 24px 26px;overflow-y:auto;flex:1}
.pm-pane{display:none}
.pm-pane.active{display:block}

.pm-err{font-size:.78rem;color:var(--rose);background:rgba(225,29,72,.06);border-radius:var(--r-sm);padding:9px 12px;border-left:3px solid var(--rose);display:none;margin-bottom:14px;line-height:1.5}
.pm-err.show{display:flex;align-items:flex-start;gap:7px}

.pm-info-box{font-size:.81rem;color:var(--ink);line-height:1.64;padding:11px 13px;background:var(--blue-pale);border-radius:var(--r-md);border-left:3px solid var(--blue);margin-bottom:16px}
body.dark .pm-info-box{background:rgba(26,79,214,.12);color:rgba(255,255,255,.7)}
.pm-label{font-size:.74rem;font-weight:800;color:var(--ink);margin-bottom:7px;display:block;letter-spacing:.2px}
body.dark .pm-label{color:rgba(255,255,255,.7)}
.pm-phone-wrap{display:flex;align-items:center;background:var(--ghost);border:1.5px solid var(--mist);border-radius:var(--r-md);overflow:hidden;margin-bottom:14px;transition:var(--t)}
body.dark .pm-phone-wrap{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.1)}
.pm-phone-wrap:focus-within{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-pale)}
.pm-prefix{padding:11px 13px;font-size:.82rem;font-weight:700;color:var(--slate);background:var(--mist);border-right:1.5px solid var(--mist);flex-shrink:0;display:flex;align-items:center;gap:6px}
body.dark .pm-prefix{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.08);color:rgba(255,255,255,.45)}
.pm-phone-wrap input{flex:1;border:none;outline:none;background:transparent;padding:11px 13px;font-size:.92rem;color:var(--ink);font-family:'DM Sans',sans-serif;letter-spacing:.3px}
body.dark .pm-phone-wrap input{color:rgba(255,255,255,.88)}
.pm-phone-wrap input::placeholder{color:var(--slate-l)}
.pm-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:var(--g-blue);color:#fff;padding:13px;border-radius:var(--r-pill);font-size:.9rem;font-weight:700;border:none;cursor:pointer;transition:var(--t);box-shadow:var(--sh-blue);width:100%;font-family:'DM Sans',sans-serif}
.pm-btn:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 14px 32px rgba(26,79,214,.4)}
.pm-btn:disabled{opacity:.55;cursor:not-allowed;transform:none}

/* Waiting / polling */
.pm-waiting{text-align:center;padding:20px 0 10px;display:none}
.pm-waiting.show{display:block}
.pm-phone-ring{width:70px;height:70px;border-radius:50%;background:var(--blue-pale);border:3px solid var(--blue);margin:0 auto 16px;display:flex;align-items:center;justify-content:center;animation:pm-ring 1.8s ease-in-out infinite}
@keyframes pm-ring{0%,100%{transform:scale(1);box-shadow:0 0 0 0 rgba(26,79,214,.35)}70%{transform:scale(1.06);box-shadow:0 0 0 14px rgba(26,79,214,0)}}
.pm-waiting-title{font-size:1.05rem;font-weight:700;color:var(--ink);margin-bottom:5px}
body.dark .pm-waiting-title{color:#fff}
.pm-waiting-sub{font-size:.82rem;color:var(--slate);line-height:1.65;margin-bottom:2px}
.pm-countdown{font-family:'Instrument Serif',serif;font-size:1.6rem;font-weight:700;color:var(--blue);margin:8px 0 4px}
.pm-dots{display:flex;align-items:center;justify-content:center;gap:5px;margin-top:8px}
.pm-dot{width:7px;height:7px;border-radius:50%;background:var(--blue);opacity:.3;animation:pm-dot .9s ease-in-out infinite}
.pm-dot:nth-child(2){animation-delay:.18s}.pm-dot:nth-child(3){animation-delay:.36s}
@keyframes pm-dot{0%,80%,100%{opacity:.3;transform:scale(1)}40%{opacity:1;transform:scale(1.3)}}

/* Success */
.pm-success{text-align:center;padding:18px 0 10px;display:none}
.pm-success.show{display:block}
.pm-success-circle{width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--emerald),#10b981);margin:0 auto 16px;display:flex;align-items:center;justify-content:center;font-size:1.7rem;color:#fff;animation:pm-pop .4s var(--spring)}
@keyframes pm-pop{from{transform:scale(0.6);opacity:0}to{transform:scale(1);opacity:1}}
.pm-success-title{font-family:'Instrument Serif',serif;font-size:1.3rem;font-weight:700;color:var(--ink);margin-bottom:5px}
body.dark .pm-success-title{color:#fff}
.pm-success-sub{font-size:.82rem;color:var(--slate);margin-bottom:14px}
.pm-progress-track{height:5px;background:var(--mist);border-radius:3px;overflow:hidden}
.pm-progress-fill{height:100%;background:var(--g-green);width:0%;transition:width 1.8s linear;border-radius:3px}

/* WhatsApp pane */
.pm-wa-card{background:rgba(37,211,102,.06);border:1px solid rgba(37,211,102,.2);border-radius:var(--r-lg);padding:16px;margin-bottom:16px}
.pm-wa-till{text-align:center;padding:10px;background:rgba(37,211,102,.08);border-radius:var(--r-md);margin-bottom:14px}
.pm-wa-till-label{font-size:.65rem;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:rgba(18,140,126,.8);margin-bottom:3px}
.pm-wa-till-num{font-family:'JetBrains Mono','Courier New',monospace;font-size:1.6rem;font-weight:700;color:#075E54;letter-spacing:2px}
body.dark .pm-wa-till-num{color:#34d399}
.pm-wa-steps{list-style:none;display:flex;flex-direction:column;gap:11px;margin-bottom:16px}
.pm-wa-step{display:flex;gap:11px;align-items:flex-start}
.pm-wa-num{min-width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#128C7E,#075E54);color:#fff;font-size:.7rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.pm-wa-text{font-size:.82rem;color:var(--ink);line-height:1.55}
body.dark .pm-wa-text{color:rgba(255,255,255,.72)}
.pm-wa-text strong{font-weight:700;color:var(--ink)}
body.dark .pm-wa-text strong{color:#fff}
.pm-wa-btn{display:flex;align-items:center;justify-content:center;gap:9px;background:linear-gradient(135deg,#128C7E,#075E54);color:#fff;padding:13px;border-radius:var(--r-pill);font-size:.9rem;font-weight:800;text-decoration:none;transition:var(--t);box-shadow:0 6px 22px rgba(18,140,126,.35);font-family:'DM Sans',sans-serif}
.pm-wa-btn:hover{transform:translateY(-2px);box-shadow:0 12px 34px rgba(18,140,126,.48)}
.pm-wa-note{font-size:.72rem;color:var(--slate-l);text-align:center;margin-top:10px;line-height:1.55}
.pm-wa-notify-btn{width:100%;display:flex;align-items:center;justify-content:center;gap:9px;margin-top:10px;padding:12px;border-radius:var(--r-pill);background:rgba(37,211,102,.1);color:#25d366;border:1.5px solid rgba(37,211,102,.3);font-size:.88rem;font-weight:800;cursor:pointer;transition:var(--t);font-family:'DM Sans',sans-serif}
.pm-wa-notify-btn:hover:not(:disabled){background:rgba(37,211,102,.18);border-color:rgba(37,211,102,.5)}
.pm-wa-notify-btn:disabled{opacity:.55;cursor:not-allowed}
.pm-wa-notify-ok{display:flex;align-items:center;gap:8px;margin-top:10px;padding:11px 14px;border-radius:var(--r-md);background:rgba(37,211,102,.1);border:1px solid rgba(37,211,102,.25);color:#25d366;font-size:.82rem;font-weight:700}
</style>
</head>
