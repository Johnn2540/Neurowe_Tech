          <div class="h-stat"><div class="h-stat-num">{{stats.total_courses}}</div><div class="h-stat-label">Courses</div></div>
          <div class="h-stat"><div class="h-stat-num">{{stats.total_categories}}</div><div class="h-stat-label">Categories</div></div>
          <div class="h-stat"><div class="h-stat-num">{{stats.total_enrollments}}</div><div class="h-stat-label">Enrolled</div></div>
          <div class="h-stat"><div class="h-stat-num">{{stats.total_instructors}}</div><div class="h-stat-label">Instructors</div></div>
        </div>
      </div>
      <div>
        <div class="hero-preview">
          <div class="hero-preview-label">Academy at a glance</div>
          <div class="preview-badges">
            <span class="prev-badge pop"><i class="fas fa-fire"></i> Popular</span>
            <span class="prev-badge new"><i class="fas fa-sparkles"></i> New</span>
            <span class="prev-badge free"><i class="fas fa-gift"></i> Free</span>
          </div>
          <div class="preview-title">Start learning today</div>
          <div class="preview-sub">Join {{stats.total_enrollments}}+ students building real skills</div>
          <div class="progress-bar-wrap"><div class="progress-bar-fill"></div></div>
          <div class="progress-labels"><span>Avg. completion rate</span><span>78%</span></div>
          <div class="preview-students">
            <div class="avatar-stack">
              <div class="avatar-s">J</div>
              <div class="avatar-s">A</div>
              <div class="avatar-s">M</div>
              <div class="avatar-s" style="background:var(--g-orange)">+</div>
            </div>
            <p><strong>{{stats.total_enrollments}}+ learners</strong> already enrolled</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

