<!-- FEATURED COURSE BANNER -->
{{#if featuredCourse}}
<div class="featured-banner">
  <div class="container">
    <div class="featured-inner">
      <div>
        <div class="feat-label"><i class="fas fa-star"></i> Featured Course</div>
