                    <div class="d-flex justify-content-between small text-muted">
                        <span>Completion rate</span>
                        <span>78%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Course Banner -->
<section class="py-4 bg-white border-bottom" style="background: white !important;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-warning mb-2">⭐ Featured Course</span>
                <h3 class="mb-2">Adobe Photoshop Masterclass</h3>
                <p class="text-muted mb-0">Comprehensive Adobe Photoshop Learning Resources. Prepared by NeurowexTech. Master the interface, layers, masking, coloring, and practical graphic design for social media.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <span class="badge bg-success fs-6 me-2">Free</span>
                <a href="#" class="btn-primary-custom">View course <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>
