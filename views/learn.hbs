                    <div class="stat-card-learn">
                        <div class="stat-number">2</div>
                        <div class="stat-label">Instructors</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="hero-code-preview bg-white rounded-4 p-4 shadow-lg" style="background: white;">
