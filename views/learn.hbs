<script>
/* ── THEME ── */
var dark = localStorage.getItem('nw-theme')==='dark' || (!localStorage.getItem('nw-theme') && window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON = '<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN  = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme() {
  document.body.classList.toggle('dark', dark);
  document.getElementById('theme-toggle').innerHTML = dark ? SUN : MOON;
  var tn = document.getElementById('theme-toggle-nav');
  var mt = document.getElementById('mobThemeBtn');
  if (tn) tn.innerHTML = dark ? '<i class="fas fa-sun" style="font-size:.82rem"></i>' : '<i class="fas fa-moon" style="font-size:.82rem"></i>';
  if (mt) mt.innerHTML = dark ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
}
applyTheme();
function toggleTheme() { dark = !dark; localStorage.setItem('nw-theme', dark ? 'dark' : 'light'); applyTheme(); }
document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
var ttn = document.getElementById('theme-toggle-nav'); if (ttn) ttn.addEventListener('click', toggleTheme);
var mtb = document.getElementById('mobThemeBtn');      if (mtb) mtb.addEventListener('click', toggleTheme);

/* ── SCROLL ── */
var navbar = document.getElementById('mainNav');
var btt    = document.getElementById('back-to-top');
var sp     = document.getElementById('scroll-progress');
window.addEventListener('scroll', function() {
  var s = window.pageYOffset, d = document.documentElement.scrollHeight - window.innerHeight;
  sp.style.width = (d > 0 ? s / d * 100 : 0) + '%';
  navbar.classList.toggle('scrolled', s > 40);
  btt.classList.toggle('visible', s > 400);
}, { passive: true });
btt.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });

/* ── MOBILE NAV ── */
var ov = document.getElementById('mobOverlay'), pan = document.getElementById('mobPanel'),
    ham = document.getElementById('hamBtn'),    mc  = document.getElementById('mobClose');
function openM()  { ov.classList.add('open');    pan.classList.add('open');    ham.classList.add('open');    ham.setAttribute('aria-expanded','true');  document.body.style.overflow = 'hidden'; mc.focus(); }
function closeM() { ov.classList.remove('open'); pan.classList.remove('open'); ham.classList.remove('open'); ham.setAttribute('aria-expanded','false'); document.body.style.overflow = ''; }
ham.addEventListener('click', openM); mc.addEventListener('click', closeM); ov.addEventListener('click', closeM);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && pan.classList.contains('open')) closeM(); });

/* ── COOKIE ── */
var cb = document.getElementById('cookie-bar');
if (!localStorage.getItem('nw-cookie')) setTimeout(function() { cb.classList.add('show'); }, 2800);
document.getElementById('cookie-accept').addEventListener('click', function() { localStorage.setItem('nw-cookie','1'); cb.classList.remove('show'); });

/* ── TOAST ── */
function toast(msg) {
  var t = document.getElementById('toast');
  document.getElementById('toast-msg').textContent = msg;
  t.classList.add('show');
  setTimeout(function() { t.classList.remove('show'); }, 3600);
}

/* ── FILTER + SEARCH + SORT ── */
var categoryFilters = document.querySelectorAll('.category-filter');
var levelFilters    = document.querySelectorAll('.level-filter');
var priceFilters    = document.querySelectorAll('.price-filter');
var searchInput     = document.getElementById('searchInput');
var courseItems     = document.querySelectorAll('.course-item');
var noResults       = document.getElementById('noResults');

function filterCourses() {
  var selCat   = Array.from(categoryFilters).filter(function(c) { return c.checked; }).map(function(c) { return c.value; });
  var selLevel = Array.from(levelFilters).filter(function(c)    { return c.checked; }).map(function(c) { return c.value; });
  var selPrice = Array.from(priceFilters).filter(function(c)    { return c.checked; }).map(function(c) { return c.value; });
  var term     = searchInput ? searchInput.value.toLowerCase() : '';
  var visible  = 0;
  courseItems.forEach(function(item) {
    var titleEl = item.querySelector('.course-title a');
    var descEl  = item.querySelector('.course-desc');
    var title   = titleEl ? titleEl.textContent.toLowerCase() : '';
    var desc    = descEl  ? descEl.textContent.toLowerCase()  : '';
    var okCat   = selCat.length   === 0 || selCat.includes(item.dataset.category);
    var okLevel = selLevel.length === 0 || selLevel.includes(item.dataset.level);
    var okPrice = selPrice.length === 0 || selPrice.includes(item.dataset.price);
    var okSearch= term === '' || title.includes(term) || desc.includes(term);
    if (okCat && okLevel && okPrice && okSearch) { item.style.display = ''; visible++; }
    else { item.style.display = 'none'; }
  });
  if (noResults) noResults.style.display = visible > 0 ? 'none' : 'block';
}
categoryFilters.forEach(function(c) { c.addEventListener('change', filterCourses); });
levelFilters.forEach(function(c)    { c.addEventListener('change', filterCourses); });
priceFilters.forEach(function(c)    { c.addEventListener('change', filterCourses); });
if (searchInput) searchInput.addEventListener('input', filterCourses);

function clearAll() {
  categoryFilters.forEach(function(c) { c.checked = false; });
  levelFilters.forEach(function(c)    { c.checked = false; });
  priceFilters.forEach(function(c)    { c.checked = false; });
  if (searchInput) searchInput.value = '';
  filterCourses();
}
var cf1 = document.getElementById('clearFilters');  if (cf1) cf1.addEventListener('click', clearAll);
var cf2 = document.getElementById('clearFilters2'); if (cf2) cf2.addEventListener('click', clearAll);

/* ── SORT ── */
var currentSort = 'popular';
function sortCourses() {
  var container = document.getElementById('coursesContainer');
  var arr = Array.from(courseItems);
  arr.sort(function(a, b) {
    if (currentSort === 'popular') {
      var ap = a.dataset.popular === 'true', bp = b.dataset.popular === 'true';
      if (ap !== bp) return bp - ap;
      var ae = parseInt((a.querySelector('.c-rating-count') || {}).textContent || '0');
      var be = parseInt((b.querySelector('.c-rating-count') || {}).textContent || '0');
      return be - ae;
    } else {
      var an = a.dataset.new === 'true', bn = b.dataset.new === 'true';
      return bn - an;
    }
  });
  arr.forEach(function(item) { container.appendChild(item); });
}
var spop = document.getElementById('sortPopular');
var snew = document.getElementById('sortNew');
if (spop) spop.addEventListener('click', function() { currentSort = 'popular'; spop.classList.add('active'); if (snew) snew.classList.remove('active'); sortCourses(); });
if (snew) snew.addEventListener('click', function() { currentSort = 'new';     snew.classList.add('active'); if (spop) spop.classList.remove('active'); sortCourses(); });

/* ── TOPIC CARD CLICK → FILTER ── */
document.querySelectorAll('.topic-card').forEach(function(card) {
  card.addEventListener('click', function() {
    var cat = this.dataset.category;
    if (!cat) return;
    categoryFilters.forEach(function(cb) { cb.checked = cb.value === cat; });
    filterCourses();
    var anchor = document.getElementById('courses');
    if (anchor) window.scrollTo({ top: anchor.offsetTop - 80, behavior: 'smooth' });
  });
});

/* ── NEWSLETTER ── */
document.getElementById('nlForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  var email   = document.getElementById('nlEmail').value.trim();
  var consent = document.getElementById('nlConsent').checked;
  var btn     = document.getElementById('nlBtn');
  var msg     = document.getElementById('nlMsg');
  if (!email || !/^\S+@\S+\.\S+$/.test(email)) { msg.innerHTML = '<span style="color:var(--rose)"><i class="fas fa-exclamation-circle"></i> Please enter a valid email.</span>'; return; }
  if (!consent) { msg.innerHTML = '<span style="color:var(--rose)"><i class="fas fa-exclamation-circle"></i> Please agree to receive emails.</span>'; return; }
  var orig = btn.innerHTML; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Subscribing…'; btn.disabled = true;
  try {
    var res  = await fetch('/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
    var data = await res.json();
    if (data.success) { msg.innerHTML = '<span style="color:var(--emerald)"><i class="fas fa-check-circle"></i> 🎉 Subscribed!</span>'; document.getElementById('nlForm').reset(); document.getElementById('nlConsent').checked = true; toast('Subscribed! Welcome aboard 🎉'); }
    else { msg.innerHTML = '<span style="color:var(--rose)">' + (data.message || 'Failed. Please try again.') + '</span>'; }
  } catch(err) { msg.innerHTML = '<span style="color:var(--rose)">Network error. Please try again.</span>'; }
  finally { btn.innerHTML = orig; btn.disabled = false; setTimeout(function() { msg.innerHTML = ''; }, 5500); }
});

/* ── FAQ ── */
document.querySelectorAll('.faq-q').forEach(function(q) {
  q.addEventListener('click', function() {
    var item = q.parentElement, open = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(function(i) { i.classList.remove('open'); });
    if (!open) item.classList.add('open');
  });
});

/* ── HERO STATS COUNTER ── */
var counted = false;
var statsObs = new IntersectionObserver(function(entries) {
  if (counted) return;
  entries.forEach(function(entry) {
    if (!entry.isIntersecting) return;
    counted = true;
    document.querySelectorAll('.h-stat-num').forEach(function(el) {
      var raw    = el.textContent.replace(/[^0-9]/g, '');
      var target = parseInt(raw, 10);
      if (isNaN(target)) return;
      var suffix = el.textContent.replace(/[0-9]/g, '').trim();
      var step   = target / 80, val = 0;
      (function tick() {
        val = Math.min(val + step, target);
        el.textContent = Math.floor(val) + suffix;
        if (val < target) requestAnimationFrame(tick);
      })();
    });
  });
}, { threshold: 0.4 });
var statsSection = document.querySelector('.hero-stats');
if (statsSection) statsObs.observe(statsSection);
</script>
