<!-- ══════════════════════════════════════════════════════════
     JAVASCRIPT
══════════════════════════════════════════════════════════ -->
<script>
/* ── THEME — same logic as all other pages ── */
var dark = localStorage.getItem('nw-theme')==='dark' ||
           (!localStorage.getItem('nw-theme') && window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON = '<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN  = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';

function applyTheme() {
  document.body.classList.toggle('dark', dark);
  var tf = document.getElementById('theme-toggle-fixed');
  if(tf) tf.innerHTML = dark ? SUN : MOON;
  var tn = document.getElementById('theme-toggle-nav');
  var mt = document.getElementById('mobThemeBtn');
  if(tn) tn.innerHTML = dark ? '<i class="fas fa-sun" style="font-size:.82rem"></i>' : '<i class="fas fa-moon" style="font-size:.82rem"></i>';
  if(mt) mt.innerHTML = dark ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
}
applyTheme();
function toggleTheme(){ dark = !dark; localStorage.setItem('nw-theme', dark?'dark':'light'); applyTheme(); }
var tf = document.getElementById('theme-toggle-fixed'); if(tf) tf.addEventListener('click', toggleTheme);
var tn = document.getElementById('theme-toggle-nav');   if(tn) tn.addEventListener('click', toggleTheme);
var mt = document.getElementById('mobThemeBtn');        if(mt) mt.addEventListener('click', toggleTheme);

/* ── SCROLL ── */
var navbar = document.getElementById('mainNav');
var btt    = document.getElementById('back-to-top');
var sp     = document.getElementById('scroll-progress');
window.addEventListener('scroll', function(){
  var s = window.pageYOffset, d = document.documentElement.scrollHeight - window.innerHeight;
  if(sp)     sp.style.width = (d > 0 ? s/d*100 : 0) + '%';
  if(navbar) navbar.classList.toggle('scrolled', s > 40);
  if(btt)    btt.classList.toggle('visible', s > 400);
}, {passive:true});
if(btt) btt.addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });

/* ── MOBILE NAV ── */
var ov = document.getElementById('mobOverlay');
var pan = document.getElementById('mobPanel');
var ham = document.getElementById('hamBtn');
var mc  = document.getElementById('mobClose');
function openMob(){ if(ov) ov.classList.add('open'); if(pan) pan.classList.add('open'); if(ham){ ham.classList.add('open'); ham.setAttribute('aria-expanded','true'); } document.body.style.overflow='hidden'; if(mc) mc.focus(); }
function closeMob(){ if(ov) ov.classList.remove('open'); if(pan) pan.classList.remove('open'); if(ham){ ham.classList.remove('open'); ham.setAttribute('aria-expanded','false'); } document.body.style.overflow=''; }
if(ham) ham.addEventListener('click', openMob);
if(mc)  mc.addEventListener('click', closeMob);
if(ov)  ov.addEventListener('click', closeMob);
document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ closeMob(); closeEnrollModal(); } });

/* ── COOKIE ── */
var cb = document.getElementById('cookie-bar');
if(cb && !localStorage.getItem('nw-cookie')) setTimeout(function(){ cb.classList.add('show'); }, 2800);
var ca = document.getElementById('cookie-accept');
if(ca) ca.addEventListener('click', function(){ localStorage.setItem('nw-cookie','1'); if(cb) cb.classList.remove('show'); });

/* ── TOAST ── */
function toast(msg, type) {
  var t = document.getElementById('toast'); if(!t) return;
  document.getElementById('toast-msg').textContent = msg;
  var ico = document.getElementById('toast-ico');
  if(ico) ico.style.color = type==='error' ? '#ef4444' : type==='info' ? '#3b82f6' : '#34d399';
  t.style.borderLeftColor = type==='error' ? '#ef4444' : type==='info' ? '#3b82f6' : '#34d399';
  t.classList.add('show');
  clearTimeout(t._t);
  t._t = setTimeout(function(){ t.classList.remove('show'); }, 3600);
}

/* ── ENROLL MODAL ── */
function showLoginPrompt(courseId, courseName) {
  // Try to get name from card DOM (avoids quoting issues with any title)
  var name = courseName || 'this course';
  var card = document.querySelector('.course-card[data-id="'+courseId+'"]');
  if(card){ var t=card.querySelector('.cc-title'); if(t) name=t.textContent.trim()||name; }
  // Save intent so we can auto-enroll after login
  try{ sessionStorage.setItem('pendingEnroll',JSON.stringify({id:Number(courseId)||0,type:'free'})); }catch(e){}
  var el=document.getElementById('modalCourseName');
  if(el) el.textContent=name;
  // Ensure login link returns to learn page
  var ll=document.getElementById('enrollLoginLink');
  if(ll) ll.href='/login?next=/learn';
  var modal=document.getElementById('enrollModal');
  if(modal){ modal.classList.add('open'); document.body.style.overflow='hidden'; }
}
function closeEnrollModal() {
  var modal=document.getElementById('enrollModal');
  if(modal){ modal.classList.remove('open'); document.body.style.overflow=''; }
  // Clear pending intent if user dismissed the modal without logging in
  try{ sessionStorage.removeItem('pendingEnroll'); }catch(e){}
}
function loginToPay(courseId) {
  // Save paid-course intent and redirect to login with return URL
  try{ sessionStorage.setItem('pendingEnroll',JSON.stringify({id:Number(courseId)||0,type:'pay'})); }catch(e){}
  window.location.href='/login?next=/learn';
}
/* Auto-trigger pending enroll/pay after login redirect */
{{#if isAuthenticated}}
(function(){
  var _p=null;
  try{_p=JSON.parse(sessionStorage.getItem('pendingEnroll'));}catch(e){}
  if(!_p||!_p.id) return;
  sessionStorage.removeItem('pendingEnroll');
  setTimeout(function(){
    var card=document.querySelector('.course-card[data-id="'+_p.id+'"]');
    if(!card) return;
    if(_p.type==='free'){
      var btn=card.querySelector('.cc-enroll-btn:not(.enrolled):not(.locked)');
      if(btn) btn.click();
    } else if(_p.type==='pay'){
      var btn=card.querySelector('.cc-enroll-btn.pay');
      if(btn) btn.click();
    }
  },700);
})();
{{/if}}

/* ── LIVE STATS ── */
async function loadLiveStats() {
  try {
    var res = await fetch('/api/dashboard/public-stats').catch(function(){ return null; });
    if(!res || !res.ok) return;
    var data = await res.json();
    var stats = data.stats || {};
    function animNum(el, target) {
      if(!el || isNaN(target) || target===0) return;
      var start = 0, step = target/60;
      (function tick(){ start = Math.min(start+step, target); el.textContent = Math.floor(start); if(start<target) requestAnimationFrame(tick); })();
    }
    if(stats.total_courses)     { animNum(document.getElementById('statCourses'),   parseInt(stats.total_courses));     animNum(document.getElementById('stripCourses'),  parseInt(stats.total_courses)); }
    if(stats.total_enrollments) { animNum(document.getElementById('statEnrolled'),  parseInt(stats.total_enrollments)); animNum(document.getElementById('stripEnrolled'), parseInt(stats.total_enrollments)); }
    if(stats.total_instructors) { animNum(document.getElementById('statInstructors'),parseInt(stats.total_instructors));animNum(document.getElementById('stripInstructors'),parseInt(stats.total_instructors)); }
  } catch(e) {}
}

/* ── ENROLL ── */
async function enrollInCourse(courseId, event) {
  var btn = event ? event.target : null;
  if(!btn) return;
  /* walk up to button if clicked on icon */
  if(btn.tagName !== 'BUTTON') btn = btn.closest('button');
  var orig = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enrolling…';
  try {
    var response = await fetch('/api/enroll', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({courseId: courseId})
    });
    var data = await response.json();
    if(data.success) {
      btn.innerHTML = '<i class="fas fa-play-circle"></i> Continue';
      btn.classList.add('enrolled');
      btn.disabled = false;
      btn.onclick = function(){ window.location.href = '/learn/course/'+courseId+'/dashboard'; };
      /* update enrolled count in card */
      var card = btn.closest('.course-card');
      if(card) {
        var ci = card.querySelector('.cc-meta-item');
        if(ci && ci.textContent.includes('enrolled')) {
          var m = ci.textContent.match(/(\d+)/);
          if(m) ci.innerHTML = '<i class="fas fa-users"></i> '+(parseInt(m[1])+1)+' enrolled';
        }
        /* add enrolled badge to image */
        var img = card.querySelector('.cc-img');
        if(img && !img.querySelector('.cc-enrolled-badge')) {
          var eb = document.createElement('span');
          eb.className = 'cc-enrolled-badge';
          eb.innerHTML = '<i class="fas fa-check"></i> Enrolled';
          img.appendChild(eb);
        }
      }
      /* update strip counter */
      ['stripEnrolled','statEnrolled'].forEach(function(id){
        var el = document.getElementById(id);
        if(el){ var n = parseInt(el.textContent)||0; el.textContent = n+1; }
      });
      loadLiveStats();
      toast('Enrolled! Redirecting…');
      setTimeout(function(){ window.location.href = '/learn/course/'+courseId+'/dashboard'; }, 1400);
    } else if(data.alreadyEnrolled) {
      btn.innerHTML = '<i class="fas fa-play-circle"></i> Continue';
      btn.classList.add('enrolled');
      btn.disabled = false;
      btn.onclick = function(){ window.location.href = '/learn/course/'+courseId+'/dashboard'; };
      toast('Already enrolled!', 'info');
    } else {
      btn.innerHTML = orig; btn.disabled = false;
      toast(data.message || 'Enrollment failed.', 'error');
    }
  } catch(err) {
    btn.innerHTML = orig; btn.disabled = false;
    toast('Network error. Please try again.', 'error');
  }
}

/* ── CHECK ENROLLMENT STATUS (for locked buttons) ── */
async function checkEnrollments() {
  if(!document.querySelector('.cc-enroll-btn.locked')) return;
  try {
    var res  = await fetch('/api/user/enrollments');
    var data = await res.json();
    if(data.success && data.enrollments) {
      var ids = data.enrollments.map(function(e){ return e.course_id; });
      document.querySelectorAll('.course-card').forEach(function(card){
        var btn = card.querySelector('.cc-enroll-btn');
        var id  = parseInt(card.dataset.id);
        if(btn && ids.indexOf(id) !== -1) {
          btn.innerHTML = '<i class="fas fa-play-circle"></i> Continue';
          btn.classList.remove('locked'); btn.classList.add('enrolled');
          btn.disabled = false;
          btn.onclick  = function(){ window.location.href = '/learn/course/'+id+'/dashboard'; };
        }
      });
    }
  } catch(e) {}
}

/* ── HERO STATS COUNTER ── */
var counted = false;
var obsStats = new IntersectionObserver(function(entries){
  if(counted) return;
  entries.forEach(function(entry){
    if(!entry.isIntersecting) return;
    counted = true;
    document.querySelectorAll('.hsr-val').forEach(function(el){
      var raw = el.textContent.replace(/[^0-9.]/g,'');
      var target = parseFloat(raw);
      if(isNaN(target)) return;
      var step = target/80, val = 0;
      (function tick(){ val = Math.min(val+step, target); el.textContent = Number.isInteger(target) ? Math.floor(val) : val.toFixed(1); if(val<target) requestAnimationFrame(tick); })();
    });
  });
}, {threshold:0.4});
var statsRow = document.querySelector('.hero-stats-row');
if(statsRow) obsStats.observe(statsRow);

/* ══════════════════════════════════════════════════════════
   CATALOG — filter + sort + search
══════════════════════════════════════════════════════════ */
var ALL_CARDS = Array.from(document.querySelectorAll('.course-card'));
var activeCat   = 'all';
var activeLevel = 'all';
var activePrice = 'all';
var activeSort  = 'default';
var searchQuery = '';

function getCardVal(card, attr){ return (card.dataset[attr] || '').toLowerCase().trim(); }

function applyFilters() {
  var q = searchQuery.toLowerCase();
  var visible = 0;

  ALL_CARDS.forEach(function(card){
    var cat   = getCardVal(card,'cat');
    var level = getCardVal(card,'level');
    var price = getCardVal(card,'price');
    var title = (card.querySelector('.cc-title')   ? card.querySelector('.cc-title').textContent   : '').toLowerCase();
    var desc  = (card.querySelector('.cc-desc')    ? card.querySelector('.cc-desc').textContent    : '').toLowerCase();
    var instr = (card.querySelector('.cc-instr-name') ? card.querySelector('.cc-instr-name').textContent : '').toLowerCase();

    var matchCat   = (activeCat   === 'all' || cat   === activeCat.toLowerCase());
    var matchLevel = (activeLevel === 'all' || level === activeLevel.toLowerCase());
    var matchPrice = (activePrice === 'all' || price === activePrice.toLowerCase());
    var matchQ     = (!q || title.includes(q) || desc.includes(q) || instr.includes(q) || cat.includes(q));

    var show = matchCat && matchLevel && matchPrice && matchQ;
    card.style.display = show ? '' : 'none';
    if(show) visible++;
  });

  /* sort visible cards */
  var grid = document.getElementById('coursesGrid');
  if(grid) {
    var shown = ALL_CARDS.filter(function(c){ return c.style.display !== 'none'; });
    shown.sort(function(a, b){
      if(activeSort === 'rating')  return parseFloat(b.dataset.rating||0) - parseFloat(a.dataset.rating||0);
      if(activeSort === 'newest')  return new Date(b.dataset.created||0) - new Date(a.dataset.created||0);
      return 0; /* default — keep original order */
    });
    shown.forEach(function(c){ grid.appendChild(c); });
  }

  var nr  = document.getElementById('noResults');
  var rc  = document.getElementById('resultsCount');
  if(nr)  nr.style.display = (visible === 0 ? '' : 'none');
  if(rc)  rc.textContent = visible + ' course' + (visible !== 1 ? 's' : '');

  /* hide featured band if filtering */
  var fb = document.getElementById('featuredBand');
  if(fb) fb.style.display = (q || activeCat!=='all' || activeLevel!=='all' || activePrice!=='all') ? 'none' : '';
}

/* Filter group toggle (collapse/expand) */
document.querySelectorAll('.filter-group-title').forEach(function(title){
  title.addEventListener('click', function(){
    var group = title.parentElement;
    group.classList.toggle('collapsed');
  });
});

/* Checkbox filters — enforce single-select within each group */
function setupCheckboxGroup(name, setter) {
  document.querySelectorAll('input[name="'+name+'"]').forEach(function(cb){
    cb.addEventListener('change', function(){
      if(cb.value === 'all') {
        /* selecting "all" unchecks others */
        document.querySelectorAll('input[name="'+name+'"]').forEach(function(x){ x.checked = (x.value==='all'); });
        setter('all');
      } else {
        /* selecting specific unchecks "all" */
        var allCb = document.querySelector('input[name="'+name+'"][value="all"]');
        if(allCb) allCb.checked = false;
        setter(cb.checked ? cb.value : 'all');
      }
      applyFilters();
    });
  });
}
setupCheckboxGroup('cat',   function(v){ activeCat   = v; });
setupCheckboxGroup('level', function(v){ activeLevel = v; });
setupCheckboxGroup('price', function(v){ activePrice = v; });

/* Clear all filters */
var clearBtn = document.getElementById('clearFilters');
if(clearBtn) clearBtn.addEventListener('click', function(){
  activeCat = activeLevel = activePrice = 'all';
  searchQuery = '';
  document.querySelectorAll('.filter-check-label input').forEach(function(cb){
    cb.checked = (cb.value === 'all');
  });
  var cs = document.getElementById('catalogSearch'); if(cs) cs.value = '';
  applyFilters();
});

/* Sort buttons */
document.querySelectorAll('.sort-btn').forEach(function(btn){
  btn.addEventListener('click', function(){
    document.querySelectorAll('.sort-btn').forEach(function(b){ b.classList.remove('on'); });
    btn.classList.add('on');
    activeSort = btn.dataset.sort;
    applyFilters();
  });
});

/* Catalog search */
var catalogSearch = document.getElementById('catalogSearch');
var catalogTimer;
if(catalogSearch) {
  catalogSearch.addEventListener('input', function(){
    clearTimeout(catalogTimer);
    catalogTimer = setTimeout(function(){
      searchQuery = catalogSearch.value.trim();
      applyFilters();
    }, 260);
  });
}

/* Hero search form */
var heroSearchForm  = document.getElementById('heroSearchForm');
var heroSearchInput = document.getElementById('heroSearchInput');
if(heroSearchForm) {
  heroSearchForm.addEventListener('submit', function(e){
    e.preventDefault();
    var q = heroSearchInput ? heroSearchInput.value.trim() : '';
    if(q) {
      searchQuery = q;
      if(catalogSearch) catalogSearch.value = q;
      document.getElementById('courses') && document.getElementById('courses').scrollIntoView({behavior:'smooth'});
      applyFilters();
    }
  });
}

/* Nav search */
var navSearchInput = document.getElementById('navSearchInput');
if(navSearchInput) {
  navSearchInput.addEventListener('keydown', function(e){
    if(e.key === 'Enter' && navSearchInput.value.trim()) {
      searchQuery = navSearchInput.value.trim();
      if(catalogSearch) catalogSearch.value = searchQuery;
      document.getElementById('courses') && document.getElementById('courses').scrollIntoView({behavior:'smooth'});
      applyFilters();
    }
  });
}

/* URL search param pre-fill */
(function(){
  var params = new URLSearchParams(window.location.search);
  var q = params.get('q');
  if(q) {
    searchQuery = q;
    if(catalogSearch)    catalogSearch.value    = q;
    if(heroSearchInput)  heroSearchInput.value  = q;
    setTimeout(applyFilters, 100);
  } else {
    applyFilters(); /* set initial results count */
  }
})();

/* ── MOBILE FILTER DRAWER ── */
var filterSidebar = document.getElementById('filterSidebar');
var filterOverlay = document.getElementById('filterOverlay');
var mobFilterBtn  = document.getElementById('mobFilterBtn');

function openFilter(){
  if(filterSidebar) filterSidebar.classList.add('mob-open');
  if(filterOverlay) { filterOverlay.style.display='block'; filterOverlay.classList.add('open'); }
  document.body.style.overflow = 'hidden';
}
function closeFilter(){
  if(filterSidebar) filterSidebar.classList.remove('mob-open');
  if(filterOverlay) { filterOverlay.classList.remove('open'); setTimeout(function(){ filterOverlay.style.display=''; }, 300); }
  document.body.style.overflow = '';
}
if(mobFilterBtn) {
  mobFilterBtn.style.display = 'inline-flex';
  mobFilterBtn.addEventListener('click', openFilter);
}
if(filterOverlay) filterOverlay.addEventListener('click', closeFilter);

/* ── INIT ── */
document.addEventListener('DOMContentLoaded', function(){
  loadLiveStats();
  checkEnrollments();
});

/* ══════════════════════════════════════════════════════════
   PAYMENT MODAL — M-PESA STK Push + WhatsApp
══════════════════════════════════════════════════════════ */
var _pay = { courseId:null, price:null, checkoutId:null, pollT:null, countT:null };

function openPayModal(courseId, title, price) {
  try {
    _pay.courseId = courseId;
    _pay.price    = price;
    var elAmt  = document.getElementById('pmAmount');
    var elName = document.getElementById('pmCourseName');
    var elWaAmt= document.getElementById('waAmount');
    if(elAmt)  elAmt.textContent  = price;
    if(elName) elName.textContent = title;
    if(elWaAmt) elWaAmt.textContent = 'Ksh ' + price;
    var wa = document.getElementById('waPayLink');
    if(wa) {
      try {
        var msg = encodeURIComponent(
          'Hello NeurowexTech!\n\nI have paid *Ksh ' + price +
          '* via M-PESA Buy Goods (Till 4928849) for the course:\n*' + title +
          '*\n\nPlease find my M-PESA confirmation screenshot attached. Kindly activate my access.'
        );
        wa.href = 'https://wa.me/254769329340?text=' + msg;
      } catch(e2) {}
    }
    resetStkState();
    var nb = document.getElementById('waNotifyBtn');
    var ns = document.getElementById('waNotifySuccess');
    if(nb) { nb.disabled = false; nb.innerHTML = '<i class="fas fa-bell"></i> I\'ve Paid — Notify Our Team'; nb.style.display = ''; }
    if(ns) ns.style.display = 'none';
    switchPayTab('stk');
  } catch(err) {
    console.error('[openPayModal] error:', err);
  }
  /* Always open the modal regardless of any error above */
  var modal = document.getElementById('payModal');
  if(modal) { modal.classList.add('open'); document.body.style.overflow = 'hidden'; }
  setTimeout(function(){ var p = document.getElementById('pmPhone'); if(p) p.focus(); }, 300);
}

function closePayModal() {
  var modal = document.getElementById('payModal');
  if(modal) modal.classList.remove('open');
  document.body.style.overflow = '';
  clearInterval(_pay.pollT);
  clearInterval(_pay.countT);
}

function switchPayTab(tab) {
  var ts = document.getElementById('tabStk');  if(ts) ts.classList.toggle('active', tab === 'stk');
  var tw = document.getElementById('tabWa');   if(tw) tw.classList.toggle('active',  tab === 'wa');
  var ps = document.getElementById('paneStk'); if(ps) ps.classList.toggle('active', tab === 'stk');
  var pw = document.getElementById('paneWa');  if(pw) pw.classList.toggle('active',  tab === 'wa');
}

function resetStkState() {
  clearInterval(_pay.pollT);
  clearInterval(_pay.countT);
  _pay.checkoutId = null;
  var si = document.getElementById('stkInput');   if(si) si.style.display = '';
  var sw = document.getElementById('stkWaiting'); if(sw) sw.classList.remove('show');
  var ss = document.getElementById('stkSuccess'); if(ss) ss.classList.remove('show');
  hidePmErr();
  var ph = document.getElementById('pmPhone'); if(ph) ph.value = '';
  var btn = document.getElementById('stkSendBtn');
  if(btn){ btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send M-PESA Request'; }
  var fill = document.getElementById('stkProgressFill'); if(fill) fill.style.width = '0%';
}

function showPmErr(msg) {
  var el = document.getElementById('pmErr');
  var tx = document.getElementById('pmErrText');
  if(tx) tx.textContent = msg;
  if(el) el.classList.add('show');
}
function hidePmErr() {
  var el = document.getElementById('pmErr'); if(el) el.classList.remove('show');
}

async function sendStkPush() {
  var raw = (document.getElementById('pmPhone').value || '').trim().replace(/\s/g,'');
  if(!/^\d{9}$/.test(raw)) {
    showPmErr('Enter a valid 9-digit Safaricom number (e.g. 712 345 678).');
    return;
  }
  hidePmErr();
  var btn = document.getElementById('stkSendBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending request…';
  try {
    var res  = await fetch('/api/mpesa/stk-push', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ courseId: _pay.courseId, phone: '254' + raw })
    });
    var data = await res.json();
    if(data.success) {
      _pay.checkoutId = data.checkoutRequestId;
      showStkWaiting();
    } else if(data.alreadyEnrolled) {
      closePayModal();
      toast('Already enrolled! Redirecting…', 'info');
      setTimeout(function(){ window.location.href = '/learn/course/' + _pay.courseId + '/dashboard'; }, 1200);
    } else {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send M-PESA Request';
      showPmErr(data.message || 'Could not initiate payment. Please try again.');
    }
  } catch(e) {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send M-PESA Request';
    showPmErr('Network error. Please check your connection and try again.');
  }
}

function showStkWaiting() {
  document.getElementById('stkInput').style.display = 'none';
  document.getElementById('stkWaiting').classList.add('show');
  var secs = 120;
  function tick() {
    var m = Math.floor(secs / 60), s = secs % 60;
    var cd = document.getElementById('stkCountdown');
    if(cd) cd.textContent = m + ':' + (s < 10 ? '0' : '') + s;
    if(secs-- <= 0) {
      clearInterval(_pay.countT);
      clearInterval(_pay.pollT);
      document.getElementById('stkWaiting').classList.remove('show');
      document.getElementById('stkInput').style.display = '';
      showPmErr('Payment timed out. Please try again or use WhatsApp.');
      var btn = document.getElementById('stkSendBtn');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send M-PESA Request';
    }
  }
  tick();
  _pay.countT = setInterval(tick, 1000);
  _pay.pollT  = setInterval(pollStkStatus, 4000);
}

async function pollStkStatus() {
  if(!_pay.checkoutId) return;
  try {
    var res  = await fetch('/api/mpesa/status/' + _pay.checkoutId);
    var data = await res.json();
    if(data.status === 'success') {
      clearInterval(_pay.pollT);
      clearInterval(_pay.countT);
      showStkSuccess();
    } else if(data.status === 'failed') {
      clearInterval(_pay.pollT);
      clearInterval(_pay.countT);
      document.getElementById('stkWaiting').classList.remove('show');
      document.getElementById('stkInput').style.display = '';
      showPmErr('Payment was declined or cancelled. Please try again or pay via WhatsApp.');
      var btn = document.getElementById('stkSendBtn');
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send M-PESA Request';
    }
  } catch(e) {}
}

function showStkSuccess() {
  document.getElementById('stkWaiting').classList.remove('show');
  document.getElementById('stkSuccess').classList.add('show');
  setTimeout(function(){
    var fill = document.getElementById('stkProgressFill');
    if(fill) fill.style.width = '100%';
  }, 60);
  toast('Payment confirmed! Welcome aboard.');
  var cid = _pay.courseId;
  document.querySelectorAll('.course-card[data-id="' + cid + '"] .cc-enroll-btn').forEach(function(b){
    b.innerHTML = '<i class="fas fa-play-circle"></i> Continue';
    b.classList.add('enrolled');
    b.onclick = function(){ window.location.href = '/learn/course/' + cid + '/dashboard'; };
  });
  setTimeout(function(){
    closePayModal();
    window.location.href = '/learn/course/' + cid + '/dashboard';
  }, 2200);
}

async function notifyWaPayment() {
  var btn  = document.getElementById('waNotifyBtn');
  var succ = document.getElementById('waNotifySuccess');
  if (!btn) return;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending…';
  try {
    var res  = await fetch('/api/mpesa/whatsapp-notify', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ courseId: _pay.courseId })
    });
    var data = await res.json();
    if (data.success) {
      btn.style.display = 'none';
      if (succ) succ.style.display = 'flex';
    } else if (data.alreadyEnrolled) {
      closePayModal();
      toast('You are already enrolled in this course!', 'info');
      setTimeout(function(){ window.location.href = '/learn/course/' + _pay.courseId + '/dashboard'; }, 1200);
    } else {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-bell"></i> I\'ve Paid — Notify Our Team';
      showPmErr(data.message || 'Could not send notification. Please try again.');
    }
  } catch(e) {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-bell"></i> I\'ve Paid — Notify Our Team';
    showPmErr('Network error. Please try again.');
  }
}

/* Close payment modal on Escape */
document.addEventListener('keydown', function(e){
  if(e.key === 'Escape') closePayModal();
});

/* Phone input — digits only */
document.addEventListener('DOMContentLoaded', function(){
  var ph = document.getElementById('pmPhone');
  if(ph) ph.addEventListener('input', function(){
    this.value = this.value.replace(/\D/g,'').slice(0,9);
  });
});
