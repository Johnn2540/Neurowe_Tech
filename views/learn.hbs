<section class="hero-learn" aria-label="Academy Hero">
  <div class="hero-orb-1" aria-hidden="true"></div>
  <div class="hero-orb-2" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-inner">

      <div>
        <div class="hero-kicker"><span class="dot"></span> NeurowexTech Academy · {{currentYear}}</div>
        <h1>Find <em>Practical Skills</em><br>You Can Use Today</h1>
        <p>Browse hands-on courses built by NeurowexTech instructors. Filter by category, level, and price — then enrol and start learning right away.</p>

        <!-- Udemy-style hero search -->
        <form class="hero-search-bar" id="heroSearchForm" role="search">
          <i class="fas fa-search" aria-hidden="true"></i>
          <input type="text" id="heroSearchInput"
                 placeholder="Search for a course topic, skill, or instructor…"
                 aria-label="Search courses"/>
          <button type="submit">Search</button>
        </form>

        <div class="hero-stats-row">
          <div class="hsr-item">
            <div>
              <div class="hsr-val" id="statCourses">{{stats.total_courses}}</div>
              <div class="hsr-label">Courses</div>
            </div>
          </div>
          <div class="hsr-div"></div>
          <div class="hsr-item">
            <div>
              <div class="hsr-val" id="statEnrolled">{{stats.total_enrollments}}</div>
              <div class="hsr-label">Enrolled</div>
            </div>
          </div>
          <div class="hsr-div"></div>
          <div class="hsr-item">
            <div>
              <div class="hsr-val" id="statInstructors">{{stats.total_instructors}}</div>
              <div class="hsr-label">Instructors</div>
            </div>
          </div>
          <div class="hsr-div"></div>
          <div class="hsr-item">
            <div>
              <div class="hsr-val">4.8★</div>
              <div class="hsr-label">Avg Rating</div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="hero-preview-card">
          <div class="hpc-label">Academy at a glance</div>
          <div class="hpc-badges">
            <span class="hpc-badge pop"><i class="fas fa-fire"></i> Popular</span>
            <span class="hpc-badge new"><i class="fas fa-star"></i> New</span>
            <span class="hpc-badge free"><i class="fas fa-gift"></i> Free</span>
            <span class="hpc-badge kids"><i class="fas fa-child"></i> Kids</span>
          </div>
          <div class="hpc-title">Start learning today — from any device</div>
          <div class="hpc-progress-bar"><div class="hpc-progress-fill"></div></div>
          <div class="hpc-progress-labels"><span>Avg. completion rate</span><span>78%</span></div>
          <div class="hpc-avatars">
            <div class="avatar-stack">
              <div class="av-s">J</div><div class="av-s">A</div>
              <div class="av-s">M</div><div class="av-s" style="background:var(--g-orange)">+</div>
            </div>
            <p><strong>{{stats.total_enrollments}}+ learners</strong> already enrolled</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap" aria-hidden="true">
  <div class="marquee-track">
    <span class="marquee-item">✨ {{stats.total_courses}} Courses <span class="marquee-sep">|</span></span>
    <span class="marquee-item">🚀 {{stats.total_enrollments}}+ Students <span class="marquee-sep">|</span></span>
    <span class="marquee-item">⭐ 4.8/5 Rating <span class="marquee-sep">|</span></span>
    <span class="marquee-item">🎓 Industry Certificates <span class="marquee-sep">|</span></span>
    <span class="marquee-item">📹 Video + Live Sessions <span class="marquee-sep">|</span></span>
    <span class="marquee-item">🧒 Kids Academy Ages 8–17 <span class="marquee-sep">|</span></span>
    <span class="marquee-item">🤝 1-on-1 Mentorship <span class="marquee-sep">|</span></span>
    <span class="marquee-item">✨ {{stats.total_courses}} Courses <span class="marquee-sep">|</span></span>
    <span class="marquee-item">🚀 {{stats.total_enrollments}}+ Students <span class="marquee-sep">|</span></span>
    <span class="marquee-item">⭐ 4.8/5 Rating <span class="marquee-sep">|</span></span>
    <span class="marquee-item">🎓 Industry Certificates <span class="marquee-sep">|</span></span>
    <span class="marquee-item">📹 Video + Live Sessions <span class="marquee-sep">|</span></span>
    <span class="marquee-item">🧒 Kids Academy Ages 8–17 <span class="marquee-sep">|</span></span>
    <span class="marquee-item">🤝 1-on-1 Mentorship <span class="marquee-sep">|</span></span>
  </div>
</div>

<!-- STATS STRIP -->
<div class="stats-strip" aria-label="Platform statistics">
  <div class="container">
    <div class="stats-strip-inner">
      <div class="ssi"><div class="ssi-val" id="stripCourses">{{stats.total_courses}}</div><div class="ssi-label">Courses Available</div></div>
      <div class="ssi-div"></div>
      <div class="ssi"><div class="ssi-val" id="stripEnrolled">{{stats.total_enrollments}}</div><div class="ssi-label">Students Enrolled</div></div>
      <div class="ssi-div"></div>
      <div class="ssi"><div class="ssi-val">4.8★</div><div class="ssi-label">Average Rating</div></div>
      <div class="ssi-div"></div>
      <div class="ssi"><div class="ssi-val" id="stripInstructors">{{stats.total_instructors}}</div><div class="ssi-label">Instructors</div></div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     CATALOG — sidebar filter + course grid (Udemy layout)
══════════════════════════════════════════════════════════ -->
<div class="catalog-wrap" id="courses">

  <!-- ── FILTER SIDEBAR ── -->
  <aside class="filter-sidebar" id="filterSidebar" aria-label="Course filters">
    <div class="filter-sidebar-title">
      Filters
      <button class="filter-clear" id="clearFilters" aria-label="Clear all filters">Clear all</button>
    </div>

    <!-- Category -->
    <div class="filter-group">
      <div class="filter-group-title" data-fg="category">
        Category <i class="fas fa-chevron-down fg-chev"></i>
      </div>
      <div class="filter-options" id="fg-category">
        <label class="filter-check-label">
          <input type="checkbox" name="cat" value="all" checked/> All categories
          <span class="filter-count">{{stats.total_courses}}</span>
        </label>
        {{#each categories}}
        <label class="filter-check-label">
          <input type="checkbox" name="cat" value="{{this.category}}"/> {{this.category}}
          <span class="filter-count">{{this.course_count}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    <!-- Level -->
    <div class="filter-group">
      <div class="filter-group-title" data-fg="level">
        Level <i class="fas fa-chevron-down fg-chev"></i>
      </div>
      <div class="filter-options" id="fg-level">
        <label class="filter-check-label">
          <input type="checkbox" name="level" value="all" checked/> All levels
        </label>
        <label class="filter-check-label">
          <input type="checkbox" name="level" value="Beginner"/> Beginner
          <span class="filter-count">{{beginnerCount}}</span>
        </label>
        <label class="filter-check-label">
          <input type="checkbox" name="level" value="Intermediate"/> Intermediate
          <span class="filter-count">{{intermediateCount}}</span>
        </label>
        <label class="filter-check-label">
          <input type="checkbox" name="level" value="Advanced"/> Advanced
          <span class="filter-count">{{advancedCount}}</span>
        </label>
      </div>
    </div>

    <!-- Price -->
    <div class="filter-group">
      <div class="filter-group-title" data-fg="price">
        Price <i class="fas fa-chevron-down fg-chev"></i>
      </div>
      <div class="filter-options" id="fg-price">
        <label class="filter-check-label">
          <input type="checkbox" name="price" value="all" checked/> All prices
        </label>
        <label class="filter-check-label">
          <input type="checkbox" name="price" value="free"/> Free only
          <span class="filter-count">{{freeCoursesCount}}</span>
        </label>
        <label class="filter-check-label">
          <input type="checkbox" name="price" value="paid"/> Paid only
          <span class="filter-count">{{paidCoursesCount}}</span>
        </label>
      </div>
    </div>
  </aside>

  <!-- ── MAIN CONTENT ── -->
  <div class="catalog-main">

    <!-- Sort + search bar -->
    <div class="sort-bar">
      <div class="search-bar-wrap">
        <i class="fas fa-search"></i>
        <input type="text" id="catalogSearch" placeholder="Search courses…" aria-label="Search courses"/>
      </div>
      <span class="sort-label">Sort:</span>
      <div class="sort-btns" role="group" aria-label="Sort options">
        <button class="sort-btn on" data-sort="default">Featured</button>
        <button class="sort-btn" data-sort="newest">Newest</button>
        <button class="sort-btn" data-sort="rating">Rating</button>
      </div>
      <!-- mobile filter button -->
      <button class="btn btn-outline btn-sm mob-filter-btn" id="mobFilterBtn"
              style="display:none;margin-left:auto">
        <i class="fas fa-sliders-h"></i> Filters
      </button>
      <span class="results-count" id="resultsCount"></span>
    </div>

    <!-- Featured course banner -->
    {{#if featuredCourse}}
    <div class="featured-band" id="featuredBand">
      <div class="fb-img">
        <img src="{{featuredCourse.image_url}}" alt="{{featuredCourse.title}}"
             onerror="this.src='/images/course-placeholder.jpg'"/>
      </div>
      <div class="fb-body">
        <div class="fb-label">⭐ Featured Course</div>
        <div class="fb-title">{{featuredCourse.title}}</div>
        <div class="fb-desc">{{featuredCourse.description}}</div>
        <div class="fb-meta">
          <span class="cc-stars-track" style="--star-pct:{{featuredCourse.star_pct}}%">★★★★★</span>
          <span>{{featuredCourse.rating}}</span>
          {{#if featuredCourse.enrolled_count}}<span><i class="fas fa-users"></i> {{featuredCourse.enrolled_label}} students</span>{{/if}}
          <span><i class="fas fa-signal"></i> {{featuredCourse.level}}</span>
          {{#if featuredCourse.total_lessons}}<span><i class="fas fa-film"></i> {{featuredCourse.total_lessons}} lessons</span>{{/if}}
        </div>
      </div>
      <div class="fb-cta">
        {{#if isAuthenticated}}
          {{#if (contains userEnrollments featuredCourse.id)}}
          <a href="/learn/course/{{featuredCourse.id}}/dashboard" class="btn btn-primary">
            <i class="fas fa-play-circle"></i> Continue
          </a>
          {{else}}
          <button class="btn btn-primary" onclick="enrollInCourse({{featuredCourse.id}}, event)">
            <i class="fas fa-graduation-cap"></i> Enrol Free
          </button>
          {{/if}}
        {{else}}
        <a class="btn btn-primary" href="/login?next=/learn" onclick="try{sessionStorage.setItem('pendingEnroll',JSON.stringify({id:{{featuredCourse.id}},type:'free'}))}catch(e){}">
          <i class="fas fa-graduation-cap"></i> Log In to Enrol Free
        </a>
        {{/if}}
      </div>
    </div>
    {{/if}}

    <!-- All courses grid -->
    <div class="section-head">
      <div class="section-kicker">All Courses</div>
      <h2>Browse <span class="g-blue">Learning Paths</span></h2>
      <p>From free introductions to premium certifications — build skills that employers want.</p>
    </div>

    <div class="courses-grid" id="coursesGrid">
      {{#each freeCourses}}
      <div class="course-card fade-in-up"
           data-id="{{this.id}}"
           data-cat="{{this.category}}"
           data-level="{{this.level}}"
           data-price="free"
           data-rating="{{this.rating}}"
           data-created="{{this.created_at}}">

        <div class="cc-img">
          <img src="{{this.image_url}}" alt="{{this.title}}"
               onerror="this.src='/images/course-placeholder.jpg'" loading="lazy"/>
          <div class="cc-badges">
            <span class="cc-badge free"><i class="fas fa-gift"></i> Free</span>
            <span class="cc-badge level">{{this.level}}</span>
            {{#if this.bestseller}}<span class="cc-badge best"><i class="fas fa-fire"></i> Bestseller</span>{{else}}{{#if this.is_popular}}<span class="cc-badge best"><i class="fas fa-fire"></i> Popular</span>{{else}}{{#unless this.enrolled_count}}<span class="cc-badge new"><i class="fas fa-star"></i> New</span>{{/unless}}{{/if}}{{/if}}
          </div>
          {{#if ../isAuthenticated}}
            {{#if (contains ../userEnrollments this.id)}}
            <span class="cc-enrolled-badge"><i class="fas fa-check"></i> Enrolled</span>
            {{/if}}
          {{/if}}
          <!-- Hover overlay -->
          <div class="cc-hover-overlay" aria-hidden="true">
            {{#if ../isAuthenticated}}
              {{#if (contains ../userEnrollments this.id)}}
              <button class="cc-hover-btn" onclick="window.location.href='/learn/course/{{this.id}}/dashboard'">
                <i class="fas fa-play-circle"></i> Continue Learning
              </button>
              {{else}}
              <button class="cc-hover-btn" onclick="enrollInCourse({{this.id}}, event)">
                <i class="fas fa-graduation-cap"></i> Enrol Free
              </button>
              {{/if}}
            {{else}}
            <a class="cc-hover-btn" href="/login?next=/learn" onclick="try{sessionStorage.setItem('pendingEnroll',JSON.stringify({id:{{this.id}},type:'free'}))}catch(e){}">
              <i class="fas fa-lock"></i> Log In to Enrol
            </a>
            {{/if}}
            <span class="cc-hover-preview"><i class="fas fa-play-circle"></i> Preview available</span>
          </div>
        </div>

        <div class="cc-body">
          <div class="cc-cat">{{this.category}}</div>
          <div class="cc-title">{{this.title}}</div>
          <div class="cc-desc">{{this.description}}</div>
          <div class="cc-instr">
            <div class="cc-av">{{#if this.instructor_name}}{{firstChar this.instructor_name}}{{else}}N{{/if}}</div>
            <span class="cc-instr-name">{{this.instructor_name}}</span>
          </div>
          <div class="cc-rating">
            <span class="cc-stars-track" style="--star-pct:{{this.star_pct}}%">★★★★★</span>
            <span class="cc-rating-val">{{this.rating}}</span>
            {{#if this.enrolled_count}}<span class="cc-rating-count">({{this.enrolled_count}})</span>{{else}}<span class="cc-rating-new">New</span>{{/if}}
          </div>
          <div class="cc-meta">
            {{#if this.enrolled_count}}<span class="cc-meta-item"><i class="fas fa-users"></i> {{this.enrolled_label}} enrolled</span>{{/if}}
            {{#if this.total_lessons}}<span class="cc-meta-item"><i class="fas fa-film"></i> {{this.total_lessons}} lessons</span>{{/if}}
            {{#if this.total_duration}}<span class="cc-meta-item"><i class="fas fa-clock"></i> {{this.total_duration}}</span>{{/if}}
          </div>
          <div class="cc-footer">
            <div class="cc-price-free">Free</div>
            {{#if ../isAuthenticated}}
              {{#if (contains ../userEnrollments this.id)}}
              <button class="cc-enroll-btn enrolled" onclick="window.location.href='/learn/course/{{this.id}}/dashboard'">
                <i class="fas fa-play-circle"></i> Continue
              </button>
              {{else}}
              <button class="cc-enroll-btn" onclick="enrollInCourse({{this.id}}, event)">
                <i class="fas fa-graduation-cap"></i> Enrol Free
              </button>
              {{/if}}
            {{else}}
            <a class="cc-enroll-btn locked" href="/login?next=/learn" onclick="try{sessionStorage.setItem('pendingEnroll',JSON.stringify({id:{{this.id}},type:'free'}))}catch(e){}">
              <i class="fas fa-lock"></i> Log In to Enrol
            </a>
            {{/if}}
          </div>
        </div>
      </div>
      {{/each}}

      {{#each paidCourses}}
      <div class="course-card fade-in-up"
           data-id="{{this.id}}"
           data-cat="{{this.category}}"
           data-level="{{this.level}}"
           data-price="paid"
           data-rating="{{this.rating}}"
           data-created="{{this.created_at}}">

        <div class="cc-img">
          <img src="{{this.image_url}}" alt="{{this.title}}"
               onerror="this.src='/images/course-placeholder.jpg'" loading="lazy"/>
          <div class="cc-badges">
            <span class="cc-badge paid">Ksh {{this.price}}</span>
            <span class="cc-badge level">{{this.level}}</span>
            {{#if this.bestseller}}<span class="cc-badge best"><i class="fas fa-fire"></i> Bestseller</span>{{else}}{{#if this.is_popular}}<span class="cc-badge best"><i class="fas fa-fire"></i> Popular</span>{{else}}{{#unless this.enrolled_count}}<span class="cc-badge new"><i class="fas fa-star"></i> New</span>{{/unless}}{{/if}}{{/if}}
          </div>
          {{#if ../isAuthenticated}}
            {{#if (contains ../userEnrollments this.id)}}
            <span class="cc-enrolled-badge"><i class="fas fa-check"></i> Enrolled</span>
            {{/if}}
          {{/if}}
          <div class="cc-hover-overlay" aria-hidden="true">
            {{#if ../isAuthenticated}}
              {{#if (contains ../userEnrollments this.id)}}
              <button class="cc-hover-btn" onclick="window.location.href='/learn/course/{{this.id}}/dashboard'">
                <i class="fas fa-play-circle"></i> Continue Learning
              </button>
              {{else}}
              <button class="cc-hover-btn" data-cid="{{this.id}}" data-ctitle="{{this.title}}" data-cprice="{{this.price}}" onclick="openPayModal(Number(this.dataset.cid),this.dataset.ctitle,Number(this.dataset.cprice));return false;">
                <i class="fas fa-credit-card"></i> Enrol — Ksh {{this.price}}
              </button>
              {{/if}}
            {{else}}
            <a class="cc-hover-btn" href="/login?next=/learn" onclick="try{sessionStorage.setItem('pendingEnroll',JSON.stringify({id:{{this.id}},type:'pay'}))}catch(e){}">
              <i class="fas fa-lock"></i> Log In to Enrol
            </a>
            {{/if}}
          </div>
        </div>

        <div class="cc-body">
          <div class="cc-cat">{{this.category}}</div>
          <div class="cc-title">{{this.title}}</div>
          <div class="cc-desc">{{truncate this.description 90}}</div>
          <div class="cc-instr">
            <div class="cc-av">{{#if this.instructor_name}}{{firstChar this.instructor_name}}{{else}}N{{/if}}</div>
            <span class="cc-instr-name">{{this.instructor_name}}</span>
          </div>
          <div class="cc-rating">
            <span class="cc-stars-track" style="--star-pct:{{this.star_pct}}%">★★★★★</span>
            <span class="cc-rating-val">{{this.rating}}</span>
            {{#if this.enrolled_count}}<span class="cc-rating-count">({{this.enrolled_count}})</span>{{else}}<span class="cc-rating-new">New</span>{{/if}}
          </div>
          <div class="cc-meta">
            {{#if this.enrolled_count}}<span class="cc-meta-item"><i class="fas fa-users"></i> {{this.enrolled_label}} enrolled</span>{{/if}}
            {{#if this.total_lessons}}<span class="cc-meta-item"><i class="fas fa-film"></i> {{this.total_lessons}} lessons</span>{{/if}}
            {{#if this.total_duration}}<span class="cc-meta-item"><i class="fas fa-clock"></i> {{this.total_duration}}</span>{{/if}}
          </div>
          <div class="cc-footer">
            <div class="cc-price-paid">Ksh {{this.price}}</div>
            {{#if ../isAuthenticated}}
              {{#if (contains ../userEnrollments this.id)}}
              <button class="cc-enroll-btn enrolled" onclick="window.location.href='/learn/course/{{this.id}}/dashboard'">
                <i class="fas fa-play-circle"></i> Continue
              </button>
              {{else}}
              <button class="cc-enroll-btn pay" data-cid="{{this.id}}" data-ctitle="{{this.title}}" data-cprice="{{this.price}}" onclick="openPayModal(Number(this.dataset.cid),this.dataset.ctitle,Number(this.dataset.cprice));return false;">
                <i class="fas fa-bolt"></i> Enrol Now
              </button>
              {{/if}}
            {{else}}
            <a class="cc-enroll-btn locked" href="/login?next=/learn" onclick="try{sessionStorage.setItem('pendingEnroll',JSON.stringify({id:{{this.id}},type:'pay'}))}catch(e){}">
              <i class="fas fa-lock"></i> Log In to Enrol
            </a>
            {{/if}}
          </div>
        </div>
      </div>
      {{/each}}
    </div>

    <!-- No results -->
    <div class="no-results" id="noResults" style="display:none">
      <i class="fas fa-search"></i>
      <p>No courses match your filters. Try adjusting your search or clearing the filters.</p>
    </div>

  </div><!-- /catalog-main -->
</div><!-- /catalog-wrap -->

<hr style="border:none;border-top:1px solid var(--mist);max-width:1320px;margin:0 auto 0;"/>

<!-- ══════════════════════════════════════════════════════════
     KIDS ACADEMY SECTION
══════════════════════════════════════════════════════════ -->
<section class="kids-section-wrapper" id="kids-academy">
  <div class="kids-blob-1" aria-hidden="true"></div>
  <div class="kids-blob-2" aria-hidden="true"></div>
  <div class="container" style="position:relative;z-index:1">
    <div class="kids-section-head">
      <div class="kids-section-kicker"><span class="kd"></span> 🧒 Kids &amp; Teens</div>
      <h2>Young <span class="g-kids">Coder Academy</span></h2>
      <p>Structured pathways designed specifically for learners aged 8–17. Safe, fun, and outcome-focused — where tomorrow's builders start today.</p>
    </div>
    <div class="kids-band">
      <div class="kids-content">
        <div class="kids-tag"><i class="fas fa-child"></i> Kids &amp; Teen Academy</div>
        <h3>Code Your <em>Future</em> —<br>Starting at Age 8</h3>
        <p>From Scratch logic blocks to HTML &amp; CSS website building, our young-learner pathways are structured, safe, and seriously fun. Separate high school labs, certified instructors, and parent progress reports keep families in the loop.</p>
        <ul class="kids-features">
          <li><i class="fas fa-check"></i> Dedicated high school coding labs</li>
          <li><i class="fas fa-check"></i> Certified instructors specialised in young learners</li>
          <li><i class="fas fa-check"></i> Parent progress reports after every module</li>
          <li><i class="fas fa-check"></i> Safe, monitored online environment</li>
          <li><i class="fas fa-check"></i> Industry-recognised certificates on completion</li>
        </ul>
        <div class="kids-badges">
          <span class="kids-badge">🧩 Scratch &amp; Logic Blocks</span>
          <span class="kids-badge">🌐 HTML &amp; CSS Basics</span>
          <span class="kids-badge">🏫 High School Labs</span>
          <span class="kids-badge">👧 Ages 8–17</span>
          <span class="kids-badge">🏆 Certificates</span>
          <span class="kids-badge">📱 Mobile-First Projects</span>
        </div>
        <div class="kids-cta-row">
          <a href="/kids-coding" class="kids-cta-primary"><i class="fas fa-rocket"></i> Explore Kids Academy</a>
          <a href="/contact"     class="kids-cta-secondary"><i class="fas fa-phone-alt"></i> Talk to Us</a>
        </div>
        <div class="kids-trust">
          <span class="kids-trust-item"><i class="fas fa-check-circle"></i> Safe online environment</span>
          <span class="kids-trust-item"><i class="fas fa-check-circle"></i> Parent progress reports</span>
          <span class="kids-trust-item"><i class="fas fa-check-circle"></i> Certified instructors</span>
        </div>
      </div>
      <div class="kids-img-panel">
        <div class="kids-emoji-accent">🚀</div>
        <img src="/images/course-kids.jpg" alt="Kids Coding Bootcamp"
             onerror="this.style.display='none';this.parentElement.style.background='linear-gradient(135deg,#2d1b69,#1a0a2e)'"/>
