<!DOCTYPE html>
{{!--
  instructor_dashboard.hbs — Instructor Hub
  Rendered by: GET /instructor/dashboard
  Variables: title, courses[], totalCourses, totalEnrolled, isAdminUser
  courses[]: id, title, category, level, published, image_url, price,
             enrolled_count, created_at, slug, description
--}}
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{{title}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
:root{
  --bg:#0f0f0f; --surface:#1a1a1a; --surface2:#242424; --surface3:#2e2e2e;
  --border:rgba(255,255,255,.09); --border2:rgba(255,255,255,.15);
  --text:#f1f1f1; --text2:rgba(241,241,241,.65); --text3:rgba(241,241,241,.38);
  --blue:#6b8cff; --blue-d:#4f6fea; --blue-dim:rgba(107,140,255,.14);
  --green:#5cc678; --green-dim:rgba(92,198,120,.12);
  --orange:#f97316; --orange-dim:rgba(249,115,22,.12);
  --red:#ef4444; --purple:#a78bfa; --yellow:#fbbf24;
  --g-blue:linear-gradient(135deg,#6b8cff,#4f6fea);
  --g-green:linear-gradient(135deg,#5cc678,#3daf5e);
  --g-bar:linear-gradient(90deg,#6b8cff,#a78bfa,#5cc678);
  --nav-h:56px; --r-sm:6px; --r-md:10px; --r-lg:14px; --r-xl:18px;
  --ease:cubic-bezier(.4,0,.2,1); --t:.22s var(--ease);
  --sh-card:0 2px 12px rgba(0,0,0,.4); --sh-pop:0 8px 32px rgba(0,0,0,.6);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{-webkit-font-smoothing:antialiased;color-scheme:dark}
body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
a{text-decoration:none;color:inherit}
button{font-family:inherit;cursor:pointer}

/* ── TOP NAV ── */
.topnav{position:sticky;top:0;z-index:100;height:var(--nav-h);background:rgba(15,15,15,.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 24px;gap:16px}
.nav-brand{display:flex;align-items:center;gap:10px;font-size:.9rem;font-weight:600;color:var(--text)}
.nav-logo{width:32px;height:32px;border-radius:8px;background:var(--g-blue);display:flex;align-items:center;justify-content:center;font-family:'Instrument Serif',serif;font-size:1rem;color:#fff;flex-shrink:0}
.nav-sep{width:1px;height:20px;background:var(--border2);margin:0 4px}
.nav-title{font-size:.85rem;color:var(--text2);font-weight:500}
.nav-spacer{flex:1}
.nav-badge{display:flex;align-items:center;gap:6px;padding:5px 12px;border-radius:999px;background:var(--surface2);border:1px solid var(--border);font-size:.75rem;font-weight:600;color:var(--text2)}
.nav-badge i{color:var(--purple);font-size:.7rem}
.nav-home{display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:var(--r-md);border:1px solid var(--border);background:transparent;color:var(--text2);font-size:.8rem;font-weight:600;transition:var(--t)}
.nav-home:hover{background:var(--surface2);color:var(--text)}

/* ── LAYOUT ── */
.hub-wrap{max-width:1200px;margin:0 auto;padding:40px 24px 80px}

/* ── HEADER ── */
.hub-header{margin-bottom:32px}
.hub-greeting{font-family:'Instrument Serif',serif;font-size:clamp(1.6rem,3vw,2.2rem);font-weight:400;color:var(--text);margin-bottom:6px}
.hub-greeting span{font-style:italic;background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.hub-sub{color:var(--text2);font-size:.9rem}

/* ── STATS BAR ── */
.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:36px}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:18px 20px;display:flex;align-items:center;gap:14px}
.stat-icon{width:40px;height:40px;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0}
.stat-icon.blue{background:var(--blue-dim);color:var(--blue)}
.stat-icon.green{background:var(--green-dim);color:var(--green)}
.stat-icon.orange{background:var(--orange-dim);color:var(--orange)}
.stat-val{font-size:1.5rem;font-weight:700;color:var(--text);line-height:1}
.stat-lbl{font-size:.73rem;color:var(--text3);text-transform:uppercase;letter-spacing:.7px;font-weight:600;margin-top:3px}

/* ── SECTION HEADER ── */
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px}
.section-title{font-size:1rem;font-weight:700;color:var(--text);display:flex;align-items:center;gap:8px}
.section-title i{color:var(--blue);font-size:.9rem}
.count-chip{background:var(--blue-dim);color:var(--blue);border-radius:999px;padding:2px 10px;font-size:.72rem;font-weight:700}

/* ── COURSE GRID ── */
.course-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px}

/* ── COURSE CARD ── */
.course-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-xl);overflow:hidden;transition:border-color var(--t),box-shadow var(--t);display:flex;flex-direction:column}
.course-card:hover{border-color:var(--border2);box-shadow:var(--sh-pop)}
.card-thumb{position:relative;width:100%;padding-top:52%;overflow:hidden;background:var(--surface2);flex-shrink:0}
.card-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .35s var(--ease)}
.course-card:hover .card-thumb img{transform:scale(1.03)}
.card-thumb-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:2.5rem;opacity:.2}
.card-status{position:absolute;top:10px;right:10px;padding:3px 10px;border-radius:999px;font-size:.68rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;backdrop-filter:blur(8px)}
.card-status.published{background:rgba(92,198,120,.25);color:#86efac;border:1px solid rgba(92,198,120,.3)}
.card-status.draft{background:rgba(249,115,22,.2);color:#fdba74;border:1px solid rgba(249,115,22,.25)}
.card-body{padding:18px 18px 14px;flex:1;display:flex;flex-direction:column;gap:10px}
.card-cat{font-size:.7rem;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.8px}
.card-title{font-size:.95rem;font-weight:700;color:var(--text);line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-meta{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.card-meta-item{display:flex;align-items:center;gap:5px;font-size:.75rem;color:var(--text2)}
.card-meta-item i{font-size:.68rem;color:var(--text3)}
.card-footer{padding:14px 18px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.card-enrolled{display:flex;align-items:center;gap:6px;font-size:.78rem;color:var(--text2)}
.card-enrolled i{color:var(--green);font-size:.72rem}
.btn-manage{display:inline-flex;align-items:center;gap:6px;padding:7px 16px;border-radius:var(--r-md);background:var(--g-blue);border:none;color:#fff;font-size:.8rem;font-weight:700;transition:opacity var(--t),transform var(--t)}
.btn-manage:hover{opacity:.88;transform:translateY(-1px)}
.btn-manage i{font-size:.72rem}

/* ── EMPTY STATE ── */
.empty-state{text-align:center;padding:80px 24px;border:1px dashed var(--border2);border-radius:var(--r-xl);background:var(--surface)}
.empty-icon{width:72px;height:72px;border-radius:50%;background:var(--blue-dim);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:1.8rem;color:var(--blue)}
.empty-title{font-size:1.1rem;font-weight:700;color:var(--text);margin-bottom:8px}
.empty-sub{font-size:.88rem;color:var(--text2);max-width:340px;margin:0 auto;line-height:1.65}

/* ── LEVEL BADGE ── */
.level-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:4px;font-size:.67rem;font-weight:700;text-transform:capitalize}
.level-badge.beginner{background:rgba(92,198,120,.15);color:var(--green)}
.level-badge.intermediate{background:rgba(251,191,36,.12);color:var(--yellow)}
.level-badge.advanced{background:rgba(239,68,68,.12);color:#f87171}
.level-badge.all{background:var(--blue-dim);color:var(--blue)}

/* ── RESPONSIVE ── */
@media(max-width:640px){
  .hub-wrap{padding:24px 16px 60px}
  .stats-row{grid-template-columns:1fr 1fr}
  .course-grid{grid-template-columns:1fr}
  .topnav{padding:0 16px}
}
@media(max-width:400px){
  .stats-row{grid-template-columns:1fr}
}
</style>
</head>
<body>

<!-- ── TOP NAV ── -->
<nav class="topnav">
  <a href="/instructor/dashboard" class="nav-brand">
    <div class="nav-logo">N</div>
    <span>NeurowexTech</span>
  </a>
  <div class="nav-sep"></div>
  <span class="nav-title">Instructor Hub</span>
  <div class="nav-spacer"></div>
  <div class="nav-badge"><i class="fas fa-chalkboard-teacher"></i> {{userName}}</div>
  {{#if isAdminUser}}
  <a href="/admin_dashboard" class="nav-home"><i class="fas fa-shield-halved"></i> Admin</a>
  {{/if}}
  <a href="/" class="nav-home"><i class="fas fa-house"></i> Home</a>
</nav>

<!-- ── MAIN ── -->
<main class="hub-wrap">

  <!-- Header -->
  <div class="hub-header">
    <h1 class="hub-greeting">Your <span>Courses</span></h1>
    <p class="hub-sub">Manage and build your assigned courses below.</p>
  </div>

  <!-- Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon blue"><i class="fas fa-book-open"></i></div>
      <div>
        <div class="stat-val">{{totalCourses}}</div>
        <div class="stat-lbl">Courses</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon green"><i class="fas fa-users"></i></div>
      <div>
        <div class="stat-val">{{totalEnrolled}}</div>
        <div class="stat-lbl">Total enrolled</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon orange"><i class="fas fa-circle-check"></i></div>
      <div>
        <div class="stat-val" id="pubCount">—</div>
        <div class="stat-lbl">Published</div>
      </div>
    </div>
  </div>

  <!-- Course grid -->
  <div class="section-head">
    <div class="section-title">
      <i class="fas fa-layer-group"></i>
      Assigned Courses
      <span class="count-chip">{{totalCourses}}</span>
    </div>
  </div>

  {{#if courses.length}}
  <div class="course-grid" id="courseGrid">
    {{#each courses}}
    <div class="course-card">
      <div class="card-thumb">
        {{#if image_url}}
        <img src="{{image_url}}" alt="{{title}}" loading="lazy"/>
        {{else}}
        <div class="card-thumb-placeholder"><i class="fas fa-photo-film"></i></div>
        {{/if}}
        <span class="card-status {{#if published}}published{{else}}draft{{/if}}">
          {{#if published}}Published{{else}}Draft{{/if}}
        </span>
      </div>
      <div class="card-body">
        <div class="card-cat">{{category}}</div>
        <div class="card-title">{{title}}</div>
        <div class="card-meta">
          <span class="card-meta-item">
            <i class="fas fa-signal"></i>
            <span class="level-badge {{level}}">{{level}}</span>
          </span>
          {{#if price}}
          <span class="card-meta-item"><i class="fas fa-tag"></i> ${{price}}</span>
          {{else}}
          <span class="card-meta-item"><i class="fas fa-tag"></i> Free</span>
          {{/if}}
        </div>
      </div>
      <div class="card-footer">
        <div class="card-enrolled">
          <i class="fas fa-user-graduate"></i>
          {{enrolled_count}} enrolled
        </div>
        <a href="/instructor/course/{{this.id}}" class="btn-manage">
          <i class="fas fa-pen-to-square"></i> Manage
        </a>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="empty-state">
    <div class="empty-icon"><i class="fas fa-book-open"></i></div>
    <div class="empty-title">No courses assigned yet</div>
    <p class="empty-sub">Ask an admin to assign you to a course, or create one from the admin panel.</p>
  </div>
  {{/if}}

</main>

<script>
(function(){
  var courses = [
    {{#each courses}}
    { published: {{published}} }{{#unless @last}},{{/unless}}
    {{/each}}
  ];
  var pubCount = courses.filter(function(c){ return c.published; }).length;
  var el = document.getElementById('pubCount');
  if(el) el.textContent = pubCount;
})();
</script>
<style>
/* ── Social sidebar ── */
#soc-sidebar{position:fixed;right:0;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:4px;z-index:9000}
/* desktop: expanding tabs flush right */
.ss-link{display:flex;align-items:center;color:#fff;text-decoration:none;border-radius:8px 0 0 8px;overflow:hidden;width:46px;height:48px;transition:width .32s cubic-bezier(.4,0,.2,1);box-shadow:-3px 2px 14px rgba(0,0,0,.28);flex-shrink:0}
.ss-link:hover,.ss-link:focus-visible{width:154px;outline:none}
.ss-icon{min-width:46px;height:48px;display:flex;align-items:center;justify-content:center;font-size:.95rem;order:2;flex-shrink:0;transition:transform .2s}
.ss-link:hover .ss-icon,.ss-link:focus-visible .ss-icon{transform:scale(1.12)}
.ss-label{order:1;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;padding-left:14px;opacity:0;transform:translateX(10px);transition:opacity .2s .08s,transform .2s .08s;flex:1}
.ss-link:hover .ss-label,.ss-link:focus-visible .ss-label{opacity:1;transform:translateX(0)}
.ss-link.fb{background:#1877f2}
.ss-link.yt{background:#ff0000}
.ss-link.li{background:#0a66c2}
.ss-link.ig{background:linear-gradient(160deg,#f77737 0%,#c13584 45%,#405de6 100%)}
/* mobile: compact pills on the left (opposite WhatsApp) */
@media(max-width:768px){
  #soc-sidebar{right:auto;left:0;gap:5px;top:50%;transform:translateY(-50%)}
  .ss-link{width:36px;height:36px;border-radius:0 10px 10px 0;box-shadow:3px 2px 10px rgba(0,0,0,.25)}
  .ss-link:hover,.ss-link:focus-visible{width:36px}
  .ss-label{display:none}
  .ss-icon{min-width:36px;height:36px;font-size:.8rem;order:1}
  .ss-link:hover .ss-icon,.ss-link:focus-visible .ss-icon{transform:scale(1.08)}
}
@media print{#soc-sidebar{display:none}}
</style>
<aside id="soc-sidebar" aria-label="Follow us on social media">
  <a href="https://www.facebook.com/share/1928ETerkE/" target="_blank" rel="noopener noreferrer" class="ss-link fb" aria-label="Follow us on Facebook"><span class="ss-label">Facebook</span><span class="ss-icon"><i class="fab fa-facebook-f"></i></span></a>
  <a href="https://youtube.com/@neurowextech?si=CSiI92E2peTQmngO" target="_blank" rel="noopener noreferrer" class="ss-link yt" aria-label="Subscribe on YouTube"><span class="ss-label">YouTube</span><span class="ss-icon"><i class="fab fa-youtube"></i></span></a>
  <a href="https://www.linkedin.com/in/neurowex-tech-588045312" target="_blank" rel="noopener noreferrer" class="ss-link li" aria-label="Connect on LinkedIn"><span class="ss-label">LinkedIn</span><span class="ss-icon"><i class="fab fa-linkedin-in"></i></span></a>
  <a href="https://www.instagram.com/neorowex_tech_solutions" target="_blank" rel="noopener noreferrer" class="ss-link ig" aria-label="Follow us on Instagram"><span class="ss-label">Instagram</span><span class="ss-icon"><i class="fab fa-instagram"></i></span></a>
</aside>
{{> widget}}
</body>
</html>
