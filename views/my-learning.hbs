<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>{{title}}</title>
    <meta name="robots" content="noindex, nofollow"/>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #2563eb;
            --accent: #f97316;
            --dark: #050b18;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-700: #334155;
            --white: #ffffff;
            --green: #10b981;
            --grad-primary: linear-gradient(135deg, #2563eb, #1d4ed8);
            --font-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
            --font-heading: 'Fraunces', Georgia, serif;
        }

        body {
            font-family: var(--font-sans);
            background: var(--gray-100);
        }
        body.dark { background: var(--dark); color: var(--gray-200); }
        
        .navbar {
            background: rgba(255,255,255,0.98);
            backdrop-filter: blur(20px);
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--gray-200);
        }
        .navbar-brand {
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: 1.5rem;
            background: var(--grad-primary);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .navbar-brand span { color: var(--accent); }
        
        .dashboard-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 60px 0 40px;
            color: white;
        }
        body.dark .dashboard-header {
            background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 100%);
        }
        
        .stats-card {
            background: rgba(255,255,255,0.12);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.2);
        }
        
        .course-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid var(--gray-200);
            transition: all 0.3s ease;
            height: 100%;
        }
        body.dark .course-card { background: #0d1526; border-color: rgba(255,255,255,0.08); }
        .course-card:hover { transform: translateY(-4px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
        
        .course-image {
            height: 160px;
            overflow: hidden;
        }
        .course-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .course-content { padding: 20px; }
        .course-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 10px; }
        .progress-label { font-size: 0.7rem; color: var(--gray-700); margin-bottom: 5px; }
        .continue-btn {
            background: var(--grad-primary);
            color: white;
            border: none;
            padding: 10px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.8rem;
            text-decoration: none;
            display: block;
            text-align: center;
            transition: all 0.3s ease;
        }
        .continue-btn:hover { transform: translateY(-2px); color: white; }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }
        
        @media (max-width: 768px) {
            .dashboard-header { padding: 40px 0 30px; }
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="/">Neurowex<span>Tech</span> Learn</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/learn">Explore</a></li>
                <li class="nav-item"><a class="nav-link" href="/my-learning" class="active">My Learning</a></li>
            </ul>
            <div class="dropdown">
                <button class="btn btn-primary-custom dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-user me-1"></i> {{userName}}
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/user_dashboard"><i class="fas fa-tachometer-alt me-2"></i> Dashboard</a></li>
                    <li><a class="dropdown-item" href="/logout"><i class="fas fa-sign-out-alt me-2"></i> Sign Out</a></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<!-- Dashboard Header -->
<section class="dashboard-header" style="margin-top: 60px;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="fw-bold mb-2">My Learning</h1>
                <p class="mb-0 opacity-75">Continue your learning journey and track your progress</p>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="stats-card">
                    <div class="stat-number fs-2 fw-bold">{{stats.totalEnrolled}}</div>
                    <div class="stat-label">Courses Enrolled</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <div class="stat-number fs-2 fw-bold">{{stats.averageProgress}}%</div>
                    <div class="stat-label">Average Progress</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <div class="stat-number fs-2 fw-bold">{{stats.lessonsCompleted}}</div>
                    <div class="stat-label">Lessons Completed</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <div class="stat-number fs-2 fw-bold">{{stats.certificatesEarned}}</div>
                    <div class="stat-label">Certificates Earned</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- My Courses -->
<div class="container py-5">
    <h3 class="fw-bold mb-4">My Courses</h3>
    
    {{#if enrollments.length}}
    <div class="row g-4">
        {{#each enrollments}}
        <div class="col-md-6 col-lg-4">
            <div class="course-card">
                <div class="course-image">
                    <img src="{{this.image_url}}" alt="{{this.title}}" onerror="this.src='https://placehold.co/600x400/2563eb/white?text=Course'">
                </div>
                <div class="course-content">
                    <div class="course-category text-primary small text-uppercase fw-bold mb-2">{{this.category}}</div>
                    <h4 class="course-title">{{this.title}}</h4>
                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span><i class="fas fa-book-open me-1"></i> {{this.total_lessons}} lessons</span>
                        <span><i class="fas fa-user me-1"></i> {{this.instructor_name}}</span>
                    </div>
                    <div class="progress-label">{{this.completed_lessons}}/{{this.total_lessons}} completed ({{this.progress}}%)</div>
                    <div class="progress mb-3" style="height: 6px;">
                        <div class="progress-bar bg-primary" style="width: {{this.progress}}%"></div>
                    </div>
                    <a href="/learn/course/{{this.course_id}}/dashboard" class="continue-btn">
                        {{#if (eq this.progress 100)}}
                            <i class="fas fa-redo-alt me-2"></i> Review Course
                        {{else}}
                            <i class="fas fa-play-circle me-2"></i> Continue Learning
                        {{/if}}
                    </a>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="empty-state">
        <i class="fas fa-book-open fa-4x text-muted mb-3"></i>
        <h4>No courses yet</h4>
        <p class="text-muted">You haven't enrolled in any courses yet. Start learning today!</p>
        <a href="/learn" class="btn btn-primary-custom">Browse Courses</a>
    </div>
    {{/if}}
</div>

<!-- Recommended Courses -->
<section class="py-5 bg-light">
    <div class="container">
        <h3 class="fw-bold mb-4">Recommended for you</h3>
        <div class="row g-4">
            {{#each recommendedCourses}}
            <div class="col-md-6 col-lg-3">
                <div class="course-card">
                    <div class="course-image">
                        <img src="{{this.image_url}}" alt="{{this.title}}" style="width:100%; height:140px; object-fit:cover;">
                    </div>
                    <div class="course-content">
                        <div class="course-category text-primary small text-uppercase">{{this.category}}</div>
                        <h4 class="course-title" style="font-size: 0.95rem;">{{this.title}}</h4>
                        <div class="d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-star text-warning"></i> {{this.rating}}</span>
                            <a href="/learn/course/{{this.id}}" class="btn btn-sm btn-outline-primary">View</a>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Dark mode
    let dark = localStorage.getItem('theme') === 'dark';
    function applyTheme() { document.body.classList.toggle('dark', dark); }
    applyTheme();
</script>
<style>
#soc-sidebar{position:fixed;right:0;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;z-index:9000;border-radius:6px 0 0 6px;overflow:hidden;box-shadow:-2px 0 16px rgba(0,0,0,.2)}
.ss-link{width:42px;height:42px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.88rem;text-decoration:none;transition:width .2s,opacity .15s}
.ss-link:hover{width:52px;opacity:.9}
.ss-link.fb{background:#1877f2}
.ss-link.yt{background:#ff0000}
.ss-link.li{background:#0077b5}
.ss-link.ig{background:linear-gradient(180deg,#f58529,#dd2a7b,#8134af,#515bd4)}
@media(max-width:640px){#soc-sidebar{display:none}}
@media print{#soc-sidebar{display:none}}
</style>
<aside id="soc-sidebar" aria-label="Follow us on social media">
  <a href="https://www.facebook.com/share/1928ETerkE/" target="_blank" rel="noopener noreferrer" class="ss-link fb" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
  <a href="https://youtube.com/@neurowextech?si=CSiI92E2peTQmngO" target="_blank" rel="noopener noreferrer" class="ss-link yt" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
  <a href="https://www.linkedin.com/in/neurowex-tech-588045312" target="_blank" rel="noopener noreferrer" class="ss-link li" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
  <a href="https://www.instagram.com/neorowex_tech_solutions" target="_blank" rel="noopener noreferrer" class="ss-link ig" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
</aside>
{{> widget}}
</body>
</html>