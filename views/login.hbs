<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,400&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
:root{--primary:#1c2b4a;--accent:#e05c2a;--blue:#2563eb;--blue-pale:rgba(37,99,235,.07);--mist:#e2e8f0;--ghost:#f8fafc;--ink:#0f172a;--slate:#64748b;--emerald:#059669;--gold:#d97706;--rose:#e11d48;--font-body:'Plus Jakarta Sans',system-ui,sans-serif;--font-display:'Fraunces',Georgia,serif;--r-md:8px;--r-lg:12px;--sh-blue:0 4px 18px rgba(37,99,235,.28);--t:.22s cubic-bezier(.4,0,.2,1)}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{-webkit-font-smoothing:antialiased}
body{font-family:var(--font-body);background:var(--ghost);color:var(--ink);min-height:100vh}
a{text-decoration:none;color:inherit}
.auth-wrap{display:grid;grid-template-columns:1fr;min-height:100vh}
@media(min-width:900px){.auth-wrap{grid-template-columns:1fr 1fr}}
/* LEFT */
.auth-left{display:none;background:linear-gradient(158deg,#060c1a 0%,#0c1628 45%,#111f3a 100%);position:relative;overflow:hidden;flex-direction:column;justify-content:space-between;padding:48px}
@media(min-width:900px){.auth-left{display:flex}}
.auth-left::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(37,99,235,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.04) 1px,transparent 1px);background-size:52px 52px}
.al-orb{position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.14) 0%,transparent 65%);top:-120px;left:-80px}
.al-orb2{position:absolute;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle,rgba(224,92,42,.1) 0%,transparent 65%);bottom:-100px;right:-60px}
.al-brand{display:flex;align-items:center;gap:10px;margin-bottom:48px;position:relative;z-index:1}
.al-logo{width:44px;height:44px;border-radius:50%;border:2.5px solid var(--accent);background:#fff;overflow:hidden;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 3px rgba(224,92,42,.15)}
.al-logo img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block}
.al-brand-name{font-family:var(--font-display);font-size:1.2rem;font-weight:600;color:#fff}
.al-brand-name em{font-style:normal;color:var(--accent)}
.al-content{position:relative;z-index:1;flex:1;display:flex;flex-direction:column;justify-content:center}
.al-headline{font-family:var(--font-display);font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:400;color:#fff;line-height:1.1;margin-bottom:16px}
.al-headline span{font-style:italic;background:linear-gradient(135deg,rgba(248,200,130,.95),rgba(224,92,42,.9));-webkit-background-clip:text;background-clip:text;color:transparent}
.al-sub{color:rgba(255,255,255,.5);font-size:.95rem;line-height:1.75;max-width:360px;margin-bottom:40px}
.al-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:32px}
.al-stat{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px 12px;text-align:center}
.al-stat-val{font-size:1.35rem;font-weight:700;color:#fff;margin-bottom:4px}
.al-stat-val.blue{color:rgba(147,197,253,1)}
.al-stat-val.orange{color:rgba(251,146,60,.95)}
.al-stat-lbl{font-size:.62rem;color:rgba(255,255,255,.38);text-transform:uppercase;letter-spacing:1px;font-weight:600}
.al-quote-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:20px;position:relative;z-index:1}
.al-quote{font-style:italic;color:rgba(255,255,255,.7);font-size:.88rem;line-height:1.7;margin-bottom:14px}
.al-author{display:flex;align-items:center;gap:10px}
.al-avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--blue));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:.85rem;flex-shrink:0}
.al-name{font-size:.83rem;font-weight:700;color:#fff}
.al-role{font-size:.7rem;color:rgba(255,255,255,.4)}
.al-stars{margin-left:auto;color:var(--gold);font-size:.8rem}
/* RIGHT */
.auth-right{background:#fff;display:flex;align-items:center;justify-content:center;padding:40px 24px;min-height:100vh}
.auth-card{width:100%;max-width:420px}
.logo-top{display:flex;flex-direction:column;align-items:center;margin-bottom:28px}
.logo-circle{width:84px;height:84px;border-radius:50%;border:3px solid var(--accent);background:#fff;overflow:hidden;box-shadow:0 6px 28px rgba(28,43,74,.14),0 0 0 6px rgba(224,92,42,.09);display:flex;align-items:center;justify-content:center}
.logo-circle img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block}
.logo-top-name{font-family:var(--font-display);font-size:1.05rem;color:var(--primary);margin-top:10px;font-weight:600}
.logo-top-name em{font-style:normal;color:var(--accent)}
.back-link{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;color:var(--slate);margin-bottom:28px;transition:color .18s}
.back-link:hover{color:var(--blue)}
h1{font-family:var(--font-display);font-size:clamp(1.6rem,4vw,2rem);font-weight:400;color:var(--primary);margin-bottom:6px}
.sub{color:var(--slate);font-size:.9rem;margin-bottom:28px}
.sub a{color:var(--blue);font-weight:600}
.sub a:hover{text-decoration:underline}
/* ALERT */
.alert{padding:12px 14px;border-radius:var(--r-md);font-size:.83rem;margin-bottom:16px;display:none;align-items:flex-start;gap:9px}
.alert.show{display:flex}
.alert-error{background:rgba(225,29,72,.07);border:1px solid rgba(225,29,72,.2);color:#be123c}
.alert-success{background:rgba(5,150,105,.07);border:1px solid rgba(5,150,105,.2);color:#065f46}
/* GOOGLE */
.btn-google{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:11px 20px;border:1.5px solid var(--mist);border-radius:var(--r-md);background:#fff;color:var(--ink);font-family:var(--font-body);font-size:.88rem;font-weight:600;cursor:pointer;transition:var(--t);margin-bottom:20px}
.btn-google:hover{border-color:#4285f4;box-shadow:0 2px 12px rgba(66,133,244,.15)}
.btn-google svg{width:20px;height:20px;flex-shrink:0}
.divider{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--mist)}
.divider span{font-size:.75rem;color:var(--slate);font-weight:600;text-transform:uppercase;letter-spacing:.8px;white-space:nowrap}
/* FORM */
.form-group{margin-bottom:16px}
.form-label{display:block;font-size:.8rem;font-weight:700;color:var(--ink);margin-bottom:6px}
.input-wrap{position:relative}
.form-input{width:100%;padding:11px 14px 11px 40px;border:1.5px solid var(--mist);border-radius:var(--r-md);font-size:.9rem;font-family:var(--font-body);color:var(--ink);background:#fff;transition:var(--t);outline:none}
.form-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.08)}
.input-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--slate);font-size:.82rem;pointer-events:none}
.input-action{position:absolute;right:13px;top:50%;transform:translateY(-50%);color:var(--slate);cursor:pointer;background:none;border:none;font-size:.82rem}
.field-err{font-size:.73rem;color:var(--rose);margin-top:4px;display:none;align-items:center;gap:4px}
.field-err.show{display:flex}
.forgot-row{display:flex;align-items:center;justify-content:space-between;margin-top:-4px;margin-bottom:16px}
.remember-label{display:flex;align-items:center;gap:7px;font-size:.78rem;color:var(--slate);cursor:pointer;user-select:none}
.remember-cb{width:15px;height:15px;accent-color:var(--blue);cursor:pointer}
.forgot-link{font-size:.78rem;color:var(--blue);font-weight:600}
.forgot-link:hover{text-decoration:underline}
/* SUBMIT */
.btn-submit{width:100%;padding:13px;border:none;border-radius:var(--r-md);background:linear-gradient(135deg,var(--primary),var(--blue));color:#fff;font-family:var(--font-body);font-size:.95rem;font-weight:700;cursor:pointer;transition:var(--t);display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:var(--sh-blue);margin-top:4px}
.btn-submit:hover{opacity:.92;transform:translateY(-1px)}
.btn-submit:disabled{opacity:.65;cursor:not-allowed;transform:none}
.spinner{display:none;width:16px;height:16px;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
.btn-submit.loading .spinner{display:block}
.btn-submit.loading .btn-text{display:none}
@keyframes spin{to{transform:rotate(360deg)}}
.terms-note{font-size:.72rem;color:var(--slate);text-align:center;margin-top:16px;line-height:1.6}
.terms-note a{color:var(--blue)}
.trust-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:20px;padding-top:20px;border-top:1px solid var(--mist)}
.trust-badge{display:flex;align-items:center;gap:5px;font-size:.7rem;font-weight:600;color:var(--slate)}
</style>
</head>
<body>
<div class="auth-wrap">
  <!-- LEFT PANEL -->
  <div class="auth-left">
    <div class="al-orb"></div><div class="al-orb2"></div>
    <div class="al-brand">
      <div class="al-logo"><img src="/images/logo.png" alt="NeurowexTech"/></div>
      <div class="al-brand-name">Neurowex<em>Tech</em></div>
    </div>
    <div class="al-content">
      <h2 class="al-headline">Welcome back to<br><span>NeurowexTech</span></h2>
      <p class="al-sub">Kenya's leading digital agency — web development, AI solutions, graphic design, and digital skills training all in one place.</p>
      <div class="al-stats">
        <div class="al-stat"><div class="al-stat-val blue">500+</div><div class="al-stat-lbl">Projects</div></div>
        <div class="al-stat"><div class="al-stat-val orange">4.9★</div><div class="al-stat-lbl">Rating</div></div>
        <div class="al-stat"><div class="al-stat-val blue">20+</div><div class="al-stat-lbl">Countries</div></div>
      </div>
      <div class="al-quote-card">
        <p class="al-quote">"NeurowexTech delivered our MVP in 5 weeks. Incredibly responsive, talented, and genuinely invested in our success."</p>
        <div class="al-author">
          <div class="al-avatar">J</div>
          <div><div class="al-name">John Smith</div><div class="al-role">CEO, TechStartup Inc.</div></div>
          <div class="al-stars">★★★★★</div>
        </div>
      </div>
    </div>
  </div>
  <!-- RIGHT PANEL -->
  <div class="auth-right">
    <div class="auth-card">
      <div class="logo-top">
        <div class="logo-circle"><img src="/images/logo.png" alt="NeurowexTech"/></div>
        <span class="logo-top-name">Neurowex<em>Tech</em></span>
      </div>
      <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> Back to home</a>
      <h1>Welcome back</h1>
      <p class="sub">Don't have an account? <a href="/sign_up">Create one free</a></p>
      <div class="alert alert-error" id="alertBox"><i class="fas fa-exclamation-circle"></i><span id="alertMsg"></span></div>
      <button class="btn-google" id="googleBtn" type="button">
        <svg viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Continue with Google
      </button>
      <div class="divider"><span>or sign in with email</span></div>
      <form id="loginForm" novalidate>
        <div class="form-group">
          <label class="form-label" for="email">Email address</label>
          <div class="input-wrap">
            <i class="fas fa-envelope input-icon"></i>
            <input type="email" id="email" class="form-input" placeholder="you@example.com" autocomplete="email" required/>
          </div>
          <div class="field-err" id="emailErr"><i class="fas fa-circle-exclamation"></i><span></span></div>
        </div>
        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <div class="input-wrap">
            <i class="fas fa-lock input-icon"></i>
            <input type="password" id="password" class="form-input" placeholder="Your password" autocomplete="current-password" required/>
            <button type="button" class="input-action" id="togglePwd"><i class="fas fa-eye"></i></button>
          </div>
          <div class="field-err" id="pwdErr"><i class="fas fa-circle-exclamation"></i><span></span></div>
        </div>
        <div class="forgot-row">
          <label class="remember-label">
            <input type="checkbox" id="rememberMe" class="remember-cb"/>
            <span>Remember me</span>
          </label>
          <a href="/forgot-password" class="forgot-link">Forgot password?</a>
        </div>
        <button type="submit" class="btn-submit" id="submitBtn">
          <span class="btn-text"><i class="fas fa-arrow-right-to-bracket"></i> Sign In</span>
          <span class="spinner"></span>
        </button>
      </form>
      <div class="terms-note">By signing in you agree to our <a href="/terms-of-service">Terms</a> and <a href="/privacy-policy">Privacy Policy</a>.</div>
      <div class="trust-row">
        <div class="trust-badge"><i class="fas fa-shield-check" style="color:var(--emerald)"></i> Secure</div>
        <div class="trust-badge"><i class="fas fa-lock" style="color:var(--blue)"></i> Encrypted</div>
        <div class="trust-badge"><i class="fas fa-user-shield" style="color:var(--accent)"></i> Private</div>
      </div>
    </div>
  </div>
</div>
<script>
function showAlert(msg,type){var b=document.getElementById('alertBox');b.className='alert show alert-'+type;document.getElementById('alertMsg').textContent=msg;b.querySelector('i').className=type==='success'?'fas fa-circle-check':'fas fa-exclamation-circle';}
function hideAlert(){document.getElementById('alertBox').classList.remove('show');}
function fieldErr(id,msg){var e=document.getElementById(id);if(msg){e.classList.add('show');e.querySelector('span').textContent=msg;}else{e.classList.remove('show');}}
function setLoading(on){var b=document.getElementById('submitBtn');b.classList.toggle('loading',on);b.disabled=on;}
document.getElementById('togglePwd').addEventListener('click',function(){var i=document.getElementById('password'),ic=this.querySelector('i');i.type=i.type==='password'?'text':'password';ic.className=i.type==='password'?'fas fa-eye':'fas fa-eye-slash';});
document.getElementById('loginForm').addEventListener('submit',async function(e){
  e.preventDefault();hideAlert();fieldErr('emailErr','');fieldErr('pwdErr','');
  var email=document.getElementById('email').value.trim(),password=document.getElementById('password').value,valid=true;
  if(!email||!/^\S+@\S+\.\S+$/.test(email)){fieldErr('emailErr','Please enter a valid email.');valid=false;}
  if(!password){fieldErr('pwdErr','Please enter your password.');valid=false;}
  if(!valid)return;
  setLoading(true);
  try{
    var rememberMe=document.getElementById('rememberMe').checked;
    var res=await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password,rememberMe})});
    var data=await res.json();
    if(res.ok&&data.success){showAlert('Signed in! Redirecting…','success');setTimeout(()=>{window.location.href=data.redirect||(data.role==='admin'?'/admin_dashboard':'/user_dashboard');},800);}
    else{showAlert(data.message||'Invalid email or password.','error');}
  }catch(err){showAlert('Network error. Please try again.','error');}
  finally{setLoading(false);}
});
var GID='{{googleClientId}}';
document.getElementById('googleBtn').addEventListener('click',function(){
  if(!GID||GID===''){showAlert('Google Sign-In is not configured.','error');return;}
  if(typeof google==='undefined'){showAlert('Google Sign-In failed to load. Please refresh.','error');return;}
  google.accounts.id.initialize({client_id:GID,callback:handleGoogle,auto_select:false});
  google.accounts.id.prompt();
});
async function handleGoogle(response){
  setLoading(true);
  try{
    var res=await fetch('/api/auth/google',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({credential:response.credential})});
    var data=await res.json();
    if(res.ok&&data.success){window.location.href=data.redirect||'/user_dashboard';}
    else{showAlert(data.message||'Google Sign-In failed.','error');}
  }catch(err){showAlert('Google Sign-In error. Please try again.','error');}
  finally{setLoading(false);}
}
</script>
{{#if googleClientId}}<script src="https://accounts.google.com/gsi/client" async defer></script>{{/if}}
<style>
/* ── Social sidebar ── */
#soc-sidebar{position:fixed;right:0;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:4px;z-index:9000}
/* desktop: expanding tabs flush right */
.ss-link{display:flex;align-items:center;color:#fff;text-decoration:none;border-radius:8px 0 0 8px;overflow:hidden;width:46px;height:48px;transition:width .32s cubic-bezier(.4,0,.2,1);box-shadow:-3px 2px 14px rgba(0,0,0,.28);flex-shrink:0}
.ss-link:hover,.ss-link:focus-visible{width:154px;outline:none}
.ss-icon{min-width:46px;height:48px;display:flex;align-items:center;justify-content:center;font-size:.95rem;order:2;flex-shrink:0;transition:transform .2s}
.ss-link:hover .ss-icon,.ss-link:focus-visible .ss-icon{transform:scale(1.12)}
.ss-label{order:1;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;padding-left:14px;opacity:0;transform:translateX(10px);transition:opacity .2s .08s,transform .2s .08s;flex:1}
.ss-link:hover .ss-label,.ss-link:focus-visible .ss-label{opacity:1;transform:translateX(0)}
.ss-link.fb{background:#1877f2}
.ss-link.yt{background:#ff0000}
.ss-link.li{background:#0a66c2}
.ss-link.ig{background:linear-gradient(160deg,#f77737 0%,#c13584 45%,#405de6 100%)}
/* mobile: compact pills on the left (opposite WhatsApp) */
@media(max-width:768px){
  #soc-sidebar{right:auto;left:0;gap:5px;top:50%;transform:translateY(-50%)}
  .ss-link{width:36px;height:36px;border-radius:0 10px 10px 0;box-shadow:3px 2px 10px rgba(0,0,0,.25)}
  .ss-link:hover,.ss-link:focus-visible{width:36px}
  .ss-label{display:none}
  .ss-icon{min-width:36px;height:36px;font-size:.8rem;order:1}
  .ss-link:hover .ss-icon,.ss-link:focus-visible .ss-icon{transform:scale(1.08)}
}
@media print{#soc-sidebar{display:none}}
</style>
