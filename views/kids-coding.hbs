  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<style>
/* ── DESIGN TOKENS ── */
:root{
  --blue:#1a4fd6;--blue-d:#1340b0;--blue-l:#4a7aee;
  --blue-pale:rgba(26,79,214,.08);--blue-pale2:rgba(26,79,214,.14);
  --orange:#e8620a;--orange-d:#c94f05;--orange-l:#f28840;
  --orange-pale:rgba(232,98,10,.08);
  --black:#050810;--ink:#0c1220;--ink-2:#141c30;--ink-3:#1c2840;
  --slate:#5a6880;--slate-l:#7a8ea8;
  --mist:#e2e8f5;--ghost:#f5f7fd;--white:#ffffff;
  --emerald:#059669;--teal:#0d9488;--yellow:#f59e0b;--rose:#e11d48;
  --kids-green:#10b981;--kids-purple:#8b5cf6;--kids-pink:#ec4899;--kids-cyan:#06b6d4;
  --g-blue:linear-gradient(135deg,#1a4fd6,#1340b0);
  --g-orange:linear-gradient(135deg,#e8620a,#c94f05);
  --g-hero:linear-gradient(168deg,#030610 0%,#07102a 50%,#0b1535 100%);
  --g-kids:linear-gradient(135deg,#1a4fd6 0%,#8b5cf6 50%,#ec4899 100%);
  --g-kids-warm:linear-gradient(135deg,#e8620a,#f59e0b,#10b981);
  --r-xs:6px;--r-sm:10px;--r-md:14px;--r-lg:18px;--r-xl:24px;--r-2xl:32px;--r-pill:999px;
  --nav-h:68px;
  --ease:cubic-bezier(.4,0,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);--t:.26s var(--ease);
  --sh-sm:0 1px 4px rgba(8,12,24,.06),0 4px 12px rgba(8,12,24,.06);
  --sh-md:0 4px 16px rgba(8,12,24,.08),0 12px 36px rgba(8,12,24,.08);
  --sh-lg:0 12px 40px rgba(8,12,24,.12),0 4px 12px rgba(8,12,24,.06);
  --sh-blue:0 8px 28px rgba(26,79,214,.28);
  --sh-orange:0 8px 28px rgba(232,98,10,.26);
  --sh-purple:0 8px 28px rgba(139,92,246,.3);
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--ghost);color:var(--ink);overflow-x:hidden;line-height:1.65}
h1,h2,h3,h4,h5{font-family:'Fraunces',serif;line-height:1.1;letter-spacing:-.02em}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
button,input,select,textarea{font-family:'Plus Jakarta Sans',sans-serif}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:var(--ink)}::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}

#scroll-progress{position:fixed;top:0;left:0;height:2px;width:0%;background:var(--g-kids);z-index:9999;transition:width .08s linear}

/* ── NAVBAR ── */
.navbar{position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);background:rgba(255,255,255,.95);backdrop-filter:blur(24px) saturate(2);border-bottom:1px solid rgba(8,12,24,.06);transition:var(--t)}
.navbar.scrolled{background:rgba(255,255,255,.98);box-shadow:0 2px 24px rgba(8,12,24,.07)}
.nav-inner{max-width:1320px;margin:0 auto;padding:0 24px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}
.nav-brand{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:700;color:var(--ink);flex-shrink:0;letter-spacing:-.04em;display:flex;align-items:center;gap:7px}
.brand-mark{width:30px;height:30px;background:var(--g-blue);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:.85rem;color:#fff;flex-shrink:0}
.nav-brand em{font-style:italic;color:var(--orange)}
.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-item{position:relative}
.nl-a{font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 12px;border-radius:var(--r-sm);transition:var(--t);white-space:nowrap;display:flex;align-items:center;gap:5px}
.nl-a:hover,.nl-a.active{color:var(--blue);background:var(--blue-pale)}
.nl-a .chev{font-size:.52rem;transition:transform .22s}
.nl-item:hover .chev{transform:rotate(180deg)}
.mega-drop{position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%) translateY(8px);min-width:540px;background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);box-shadow:0 24px 64px rgba(8,12,24,.14);padding:22px;opacity:0;visibility:hidden;pointer-events:none;transition:all .2s var(--ease)}
.nl-item:hover .mega-drop{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
.mega-drop::before{content:'';position:absolute;top:-5px;left:50%;width:10px;height:10px;background:#fff;border-left:1px solid var(--mist);border-top:1px solid var(--mist);transform:translateX(-50%) rotate(45deg)}
.mega-grid{display:grid;grid-template-columns:1fr 1fr 1fr}
.mega-col-label{font-size:.61rem;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--blue);padding:0 8px 8px;display:block}
.mega-link{display:flex;align-items:center;gap:7px;padding:7px 10px;border-radius:var(--r-sm);font-size:.79rem;font-weight:500;color:var(--slate);transition:all .14s}
.mega-link i{width:15px;color:var(--blue);font-size:.74rem;flex-shrink:0}
.mega-link:hover{background:var(--blue-pale);color:var(--blue);transform:translateX(2px)}
.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}
.user-drop{position:relative}
.user-btn{display:inline-flex;align-items:center;gap:6px;background:var(--g-blue);color:#fff;border:none;padding:7px 16px;border-radius:var(--r-pill);font-size:.79rem;font-weight:700;cursor:pointer;transition:var(--t);font-family:'Plus Jakarta Sans',sans-serif}
.user-btn:hover{transform:translateY(-1px);box-shadow:var(--sh-blue)}
.user-btn .chev-u{font-size:.5rem;transition:transform .22s}
.user-drop:hover .chev-u{transform:rotate(180deg)}
.user-menu{position:absolute;top:calc(100% + 10px);right:0;min-width:200px;background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);box-shadow:var(--sh-md);padding:8px;opacity:0;visibility:hidden;pointer-events:none;transition:all .2s var(--ease)}
.user-drop:hover .user-menu{opacity:1;visibility:visible;pointer-events:auto}
.user-menu a{display:flex;align-items:center;gap:9px;padding:9px 12px;border-radius:var(--r-sm);font-size:.81rem;font-weight:600;color:var(--slate);transition:var(--t)}
.user-menu a i{width:15px;color:var(--blue);font-size:.75rem}
.user-menu a:hover{background:var(--blue-pale);color:var(--blue)}
.user-menu-divider{border:none;border-top:1px solid var(--mist);margin:5px 0}
.btn-nav-signin{font-size:.79rem;font-weight:600;color:var(--slate);padding:7px 15px;border:1.5px solid var(--mist);border-radius:var(--r-pill);background:#fff;cursor:pointer;transition:var(--t)}
.btn-nav-signin:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-signup{font-size:.79rem;font-weight:700;color:#fff;padding:8px 19px;border:none;border-radius:var(--r-pill);background:var(--g-blue);cursor:pointer;box-shadow:var(--sh-blue);display:inline-flex;align-items:center;gap:5px;transition:var(--t)}
.btn-nav-signup:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(26,79,214,.38)}
.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:44px;height:44px;background:none;border:none;cursor:pointer;border-radius:var(--r-sm);transition:var(--t);flex-shrink:0}
.ham-btn:hover{background:var(--blue-pale)}
.ham-line{display:block;width:20px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .24s var(--ease);transform-origin:center}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:38px;height:38px;border-radius:var(--r-sm);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:var(--t);background:var(--blue-pale);color:var(--blue)}
.mob-overlay{position:fixed;inset:0;background:rgba(8,12,24,.55);backdrop-filter:blur(6px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .28s,visibility .28s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(340px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-12px 0 48px rgba(8,12,24,.18);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.82rem}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:11px;padding:12px 22px;font-size:.88rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px}
.mob-link i{width:18px;color:var(--blue);font-size:.8rem;flex-shrink:0}
.mob-link:hover,.mob-link.cur{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 18px}
.mob-footer{padding:14px 18px 30px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:9px}

/* ── DARK MODE ── */
body.dark{background:var(--black);color:rgba(255,255,255,.84)}
body.dark .navbar{background:rgba(8,12,24,.97);border-bottom-color:rgba(255,255,255,.05)}
body.dark .navbar.scrolled{background:rgba(8,12,24,.99)}
body.dark .nl-a{color:rgba(255,255,255,.52)}
body.dark .nl-a:hover{color:var(--blue-l);background:rgba(26,79,214,.1)}
body.dark .mega-drop{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-drop::before{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-link{color:rgba(255,255,255,.52)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:var(--ink-2)}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link{color:rgba(255,255,255,.82)}
body.dark .mob-close{background:rgba(255,255,255,.07);color:rgba(255,255,255,.7)}
body.dark .mob-hr{border-color:rgba(255,255,255,.07)}
body.dark .mob-footer{border-color:rgba(255,255,255,.07)}
body.dark .btn-nav-signin{color:rgba(255,255,255,.52);border-color:rgba(255,255,255,.1);background:transparent}
body.dark #theme-toggle{background:var(--ink-2);border-color:rgba(255,255,255,.09)}
body.dark #theme-toggle svg{stroke:rgba(255,255,255,.72)}
body.dark .user-menu{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .user-menu a{color:rgba(255,255,255,.65)}
body.dark .user-menu-divider{border-color:rgba(255,255,255,.07)}

/* ── UTILITIES ── */
.container{max-width:1320px;margin:0 auto;padding:0 24px}
.section-py{padding:80px 0}
.section-py-sm{padding:56px 0}
.text-center{text-align:center}
.text-muted{color:var(--slate)}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-orange{background:var(--g-orange);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-kids{background:var(--g-kids);-webkit-background-clip:text;background-clip:text;color:transparent}
.section-kicker{display:inline-flex;align-items:center;gap:7px;border-radius:var(--r-pill);padding:5px 14px;font-size:.67rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;margin-bottom:14px;border:1px solid rgba(26,79,214,.15);background:var(--blue-pale);color:var(--blue)}
.section-kicker::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue);flex-shrink:0}
.section-kicker.orange{background:var(--orange-pale);color:var(--orange);border-color:rgba(232,98,10,.15)}
.section-kicker.orange::before{background:var(--orange)}
.section-kicker.purple{background:rgba(139,92,246,.08);color:var(--kids-purple);border-color:rgba(139,92,246,.2)}
.section-kicker.purple::before{background:var(--kids-purple)}
.section-kicker.green{background:rgba(16,185,129,.08);color:var(--kids-green);border-color:rgba(16,185,129,.2)}
.section-kicker.green::before{background:var(--kids-green)}
.section-title{font-size:clamp(1.75rem,5vw,3rem);font-weight:700;margin-bottom:14px}
.section-body{color:var(--slate);font-size:clamp(.9rem,2.5vw,1.04rem);line-height:1.78;max-width:540px}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.86rem;border-radius:var(--r-pill);transition:var(--t);cursor:pointer;border:none;letter-spacing:.01em;white-space:nowrap}
.btn-primary{background:var(--g-blue);color:#fff;padding:12px 26px;box-shadow:var(--sh-blue)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(26,79,214,.36)}
.btn-orange{background:var(--g-orange);color:#fff;padding:12px 26px;box-shadow:var(--sh-orange)}
.btn-orange:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(232,98,10,.36)}
.btn-purple{background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff;padding:12px 26px;box-shadow:var(--sh-purple)}
.btn-purple:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(139,92,246,.4)}
.btn-outline{background:transparent;color:var(--blue);padding:10px 22px;border:1.5px solid var(--blue)}
.btn-outline:hover{background:var(--g-blue);color:#fff;transform:translateY(-2px)}
.btn-ghost{background:rgba(255,255,255,.1);color:#fff;padding:11px 22px;border:1.5px solid rgba(255,255,255,.25);backdrop-filter:blur(8px)}
.btn-ghost:hover{background:rgba(255,255,255,.18);transform:translateY(-2px)}
.btn-sm{padding:8px 18px;font-size:.78rem}
.btn-lg{padding:14px 32px;font-size:.95rem}

/* ── ANIMATIONS ── */
@keyframes float-bob{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-12px) rotate(2deg)}}
@keyframes float-bob2{0%,100%{transform:translateY(0) rotate(3deg)}50%{transform:translateY(-10px) rotate(-1deg)}}
@keyframes spin-slow{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@keyframes dot-p{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.45);opacity:.5}}
@keyframes wa-ripple{0%{transform:scale(1);opacity:.65}100%{transform:scale(2);opacity:0}}
@keyframes bounce-up{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-8px)}}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes fade-up{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes bar-shift{0%{background-position:0%}100%{background-position:200%}}
@keyframes twinkle{0%,100%{opacity:.3;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}
@keyframes path-dash{from{stroke-dashoffset:600}to{stroke-dashoffset:0}}

/* ── FIXED WIDGETS ── */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:44px;height:44px;background:#fff;border:1.5px solid rgba(8,12,24,.08);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 18px rgba(8,12,24,.1);transition:var(--t)}
#theme-toggle svg{width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(20deg) scale(1.07)}
#theme-toggle:hover svg{stroke:#fff}
#back-to-top{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(16px);z-index:10000;width:48px;height:48px;background:var(--g-blue);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .3s,transform .4s var(--spring);box-shadow:var(--sh-blue)}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto;animation:bounce-up 2.4s ease-in-out infinite}
#back-to-top:hover{animation-play-state:paused}
#back-to-top svg{width:18px;height:18px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
#wa-float{position:fixed;bottom:86px;right:20px;z-index:10001;text-decoration:none;display:block}
.wa-ring{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-ripple 2.8s ease-out infinite;pointer-events:none}
.wa-ring:nth-child(2){animation-delay:1.2s}
.wa-pill{display:flex;align-items:center;gap:9px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:8px 17px 8px 8px;box-shadow:0 6px 26px rgba(18,140,126,.42);transition:transform .3s var(--spring),box-shadow .28s;white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-3px) scale(1.02)}
.wa-ico{width:36px;height:36px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.15rem;color:#fff;position:relative}
.wa-dot{position:absolute;top:1px;right:1px;width:9px;height:9px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dot-p 2.4s ease-in-out infinite}
.wa-text{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.64rem;color:rgba(255,255,255,.55);font-weight:600}
.wa-cta{font-size:.88rem;color:#fff;font-weight:800;font-family:'Fraunces',serif}
.wa-arr{color:rgba(255,255,255,.6);font-size:.68rem;margin-left:2px;transition:transform .2s}
#wa-float:hover .wa-arr{transform:translateX(3px)}
#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-md);padding:11px 17px;font-size:.82rem;display:flex;align-items:center;gap:8px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:210px;max-width:calc(100vw - 40px)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#cookie-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.8);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;z-index:9998;transform:translateY(100%);transition:transform .38s;border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap}
#cookie-bar.show{transform:translateY(0)}
#cookie-bar p{font-size:.77rem;margin:0;flex:1;min-width:180px}
#cookie-accept{background:var(--blue);color:#fff;border:none;padding:7px 18px;border-radius:var(--r-pill);font-size:.79rem;cursor:pointer;font-weight:700;transition:var(--t)}
#cookie-accept:hover{background:var(--blue-d)}
@media(max-width:767px){
  #wa-float{bottom:74px;right:14px}
  .wa-text,.wa-arr{display:none}
  .wa-pill{padding:0;width:52px;height:52px;border-radius:50%;justify-content:center}
  .wa-ico{width:52px;height:52px;font-size:1.4rem}
  #theme-toggle{bottom:14px;left:14px;width:40px;height:40px}
  #back-to-top{bottom:12px;width:46px;height:46px}
}

/* ════════════════════════════════
   HERO
════════════════════════════════ */
.hero-kids{background:var(--g-hero);padding-top:var(--nav-h);position:relative;overflow:hidden;min-height:calc(100svh - var(--nav-h));display:flex;align-items:center}
.hero-kids::before{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(139,92,246,.12) 1px,transparent 1px);background-size:32px 32px}

/* Floating emoji deco */
.hero-deco{position:absolute;font-size:2rem;pointer-events:none;user-select:none;line-height:1}
.deco-1{top:12%;right:8%;animation:float-bob  5s ease-in-out infinite}
.deco-2{top:28%;right:18%;animation:float-bob2 7s ease-in-out infinite;font-size:1.5rem}
.deco-3{bottom:22%;right:6%;animation:float-bob  6s ease-in-out infinite 1s}
.deco-4{bottom:35%;right:22%;animation:float-bob2 4.5s ease-in-out infinite .5s;font-size:1.4rem}
.deco-5{top:60%;right:32%;animation:float-bob  8s ease-in-out infinite 2s;font-size:1.1rem}
.orb-kids-1{position:absolute;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(139,92,246,.18) 0%,transparent 70%);top:-80px;right:-60px;pointer-events:none}
.orb-kids-2{position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(236,72,153,.12) 0%,transparent 70%);bottom:-40px;left:5%;pointer-events:none}
.orb-kids-3{position:absolute;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(6,182,212,.1) 0%,transparent 70%);top:40%;left:42%;pointer-events:none}

.hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr;gap:40px;padding:64px 0 72px;align-items:center}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:var(--r-pill);padding:6px 15px;color:rgba(255,255,255,.78);font-size:.73rem;font-weight:700;margin-bottom:14px;backdrop-filter:blur(8px)}
.hero-badge .dot{width:7px;height:7px;border-radius:50%;background:#34d399;animation:dot-p 2s infinite;flex-shrink:0}
.hero-inner h1{font-size:clamp(2.2rem,6.5vw,4.2rem);font-weight:700;color:#fff;margin-bottom:12px;line-height:1.05}
.hero-inner h1 em{font-style:italic;background:var(--g-kids);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-inner p{color:rgba(255,255,255,.58);font-size:clamp(.9rem,2.4vw,1.06rem);line-height:1.78;max-width:490px;margin-bottom:28px}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:36px}

/* hero age badge strip */
.age-strip{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:32px}
.age-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.14);border-radius:var(--r-pill);padding:5px 14px;font-size:.74rem;font-weight:700;color:rgba(255,255,255,.78);backdrop-filter:blur(8px)}
.age-chip.g{border-color:rgba(16,185,129,.4);background:rgba(16,185,129,.12);color:#34d399}
.age-chip.p{border-color:rgba(139,92,246,.4);background:rgba(139,92,246,.12);color:#c4b5fd}
.age-chip.b{border-color:rgba(26,79,214,.4);background:rgba(26,79,214,.14);color:#93c5fd}
.age-chip.o{border-color:rgba(232,98,10,.4);background:rgba(232,98,10,.12);color:var(--orange-l)}

/* hero stat cards */
.hero-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.h-stat{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:var(--r-lg);padding:18px 16px;text-align:center;backdrop-filter:blur(8px);transition:var(--t)}
.h-stat:hover{background:rgba(255,255,255,.11);border-color:rgba(255,255,255,.18)}
.h-stat-num{font-family:'Fraunces',serif;font-size:clamp(1.6rem,5vw,2.2rem);font-weight:700;color:#fff;line-height:1}
.h-stat-label{font-size:.72rem;color:rgba(255,255,255,.52);margin-top:5px;font-weight:600}

/* hero right side — visual */
.hero-visual{display:flex;flex-direction:column;gap:14px}
.code-window{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-xl);overflow:hidden;backdrop-filter:blur(16px)}
.code-win-bar{display:flex;align-items:center;gap:7px;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,.07)}
.code-dot{width:11px;height:11px;border-radius:50%;flex-shrink:0}
.code-dot.r{background:#ff5f57}
.code-dot.y{background:#febc2e}
.code-dot.g{background:#28c840}
.code-title{font-size:.72rem;color:rgba(255,255,255,.38);font-weight:600;margin-left:4px}
.code-body{padding:16px 18px;font-family:'Courier New',monospace;font-size:.78rem;line-height:1.9}
.code-line{display:flex;gap:12px}
.code-ln{color:rgba(255,255,255,.2);width:14px;flex-shrink:0;text-align:right;font-size:.68rem;margin-top:1px}
.code-c{color:rgba(255,255,255,.72)}
.kw{color:#c084fc}.fn{color:#7dd3fc}.str{color:#86efac}.tag{color:#f97316}.attr{color:#7dd3fc}.val{color:#86efac}.cm{color:rgba(255,255,255,.28)}

.progress-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.prog-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:var(--r-lg);padding:14px;backdrop-filter:blur(8px)}
.prog-label{font-size:.7rem;color:rgba(255,255,255,.48);font-weight:600;margin-bottom:7px;display:flex;align-items:center;gap:5px}
.prog-label i{font-size:.65rem}
.prog-bar{height:6px;background:rgba(255,255,255,.1);border-radius:3px;overflow:hidden}
.prog-fill{height:100%;border-radius:3px;transition:width 1.4s cubic-bezier(.34,1.2,.64,1)}
.prog-fill.scratch{background:linear-gradient(90deg,#f59e0b,#f97316);width:90%}
.prog-fill.html{background:linear-gradient(90deg,#3b82f6,#8b5cf6);width:72%}
.prog-fill.css{background:linear-gradient(90deg,#ec4899,#f43f5e);width:60%}
.prog-fill.js{background:linear-gradient(90deg,#10b981,#06b6d4);width:38%}
.prog-pct{font-size:.68rem;color:rgba(255,255,255,.55);margin-top:4px;font-weight:700}

/* ════════════════════════════════
   MARQUEE
════════════════════════════════ */
.marquee-wrap{background:var(--g-kids);padding:11px 0;overflow:hidden;white-space:nowrap}
.marquee-track{display:inline-flex;animation:marquee 28s linear infinite}
.marquee-track:hover{animation-play-state:paused}
.marquee-item{display:inline-flex;align-items:center;gap:7px;padding:0 24px;color:rgba(255,255,255,.9);font-size:.81rem;font-weight:700}
.marquee-sep{opacity:.32}

/* ════════════════════════════════
   PATHWAYS (CURRICULUM TRACKS)
════════════════════════════════ */
.pathway-grid{display:grid;grid-template-columns:1fr;gap:24px}
@media(min-width:640px){.pathway-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.pathway-grid{grid-template-columns:repeat(4,1fr)}}

.pathway-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);padding:26px 22px;transition:var(--t);box-shadow:var(--sh-sm);position:relative;overflow:hidden;display:flex;flex-direction:column}
body.dark .pathway-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.pathway-card:hover{transform:translateY(-6px);box-shadow:var(--sh-lg)}
.pathway-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:var(--r-xl) var(--r-xl) 0 0}
.pathway-card.scratch::before{background:linear-gradient(90deg,#f59e0b,#f97316)}
.pathway-card.html::before{background:linear-gradient(90deg,#3b82f6,#8b5cf6)}
.pathway-card.css::before{background:linear-gradient(90deg,#ec4899,#f43f5e)}
.pathway-card.js::before{background:linear-gradient(90deg,#10b981,#06b6d4)}
.pc-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.55rem;margin-bottom:16px;flex-shrink:0;transition:var(--t)}
.pathway-card:hover .pc-icon{transform:scale(1.08) rotate(-4deg)}
.pc-icon.scratch{background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.22)}
.pc-icon.html{background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.2)}
.pc-icon.css{background:rgba(236,72,153,.1);border:1px solid rgba(236,72,153,.2)}
.pc-icon.js{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.2)}
.pc-age{display:inline-flex;align-items:center;gap:4px;font-size:.64rem;font-weight:800;letter-spacing:.6px;padding:3px 9px;border-radius:var(--r-pill);margin-bottom:10px}
.pc-age.scratch{background:rgba(245,158,11,.1);color:#d97706}
.pc-age.html{background:rgba(59,130,246,.1);color:#2563eb}
.pc-age.css{background:rgba(236,72,153,.1);color:#db2777}
.pc-age.js{background:rgba(16,185,129,.1);color:#059669}
body.dark .pc-age.scratch{background:rgba(245,158,11,.15);color:#fbbf24}
body.dark .pc-age.html{background:rgba(59,130,246,.15);color:#93c5fd}
body.dark .pc-age.css{background:rgba(236,72,153,.15);color:#f9a8d4}
body.dark .pc-age.js{background:rgba(16,185,129,.15);color:#6ee7b7}
.pc-title{font-size:1.05rem;font-weight:700;margin-bottom:6px;font-family:'Fraunces',serif;color:var(--ink)}
body.dark .pc-title{color:rgba(255,255,255,.9)}
.pc-desc{font-size:.8rem;color:var(--slate);line-height:1.62;flex:1;margin-bottom:14px}
body.dark .pc-desc{color:rgba(255,255,255,.48)}
.pc-lessons{display:flex;align-items:center;gap:5px;font-size:.72rem;color:var(--slate-l);font-weight:600;margin-bottom:16px}
.pc-lessons i{font-size:.68rem}
.pc-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:var(--r-pill);font-size:.77rem;font-weight:700;transition:var(--t);text-decoration:none;border:none;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;margin-top:auto}
.pc-btn.scratch{background:rgba(245,158,11,.12);color:#d97706;border:1.5px solid rgba(245,158,11,.25)}
.pc-btn.scratch:hover{background:linear-gradient(135deg,#f59e0b,#f97316);color:#fff;border-color:transparent;box-shadow:0 8px 22px rgba(245,158,11,.35)}
.pc-btn.html{background:rgba(59,130,246,.1);color:#2563eb;border:1.5px solid rgba(59,130,246,.2)}
.pc-btn.html:hover{background:linear-gradient(135deg,#3b82f6,#8b5cf6);color:#fff;border-color:transparent;box-shadow:var(--sh-blue)}
.pc-btn.css{background:rgba(236,72,153,.1);color:#db2777;border:1.5px solid rgba(236,72,153,.2)}
.pc-btn.css:hover{background:linear-gradient(135deg,#ec4899,#f43f5e);color:#fff;border-color:transparent;box-shadow:0 8px 22px rgba(236,72,153,.35)}
.pc-btn.js{background:rgba(16,185,129,.1);color:#059669;border:1.5px solid rgba(16,185,129,.2)}
.pc-btn.js:hover{background:linear-gradient(135deg,#10b981,#06b6d4);color:#fff;border-color:transparent;box-shadow:0 8px 22px rgba(16,185,129,.3)}

/* ════════════════════════════════
   HS LABS (ISOLATED HIGH SCHOOL)
════════════════════════════════ */
.hs-section{background:linear-gradient(135deg,#0c1630,#101f40);position:relative;overflow:hidden;padding:72px 0}
.hs-section::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:48px 48px}
.hs-orb{position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(139,92,246,.14) 0%,transparent 70%);top:-100px;right:-60px;pointer-events:none}
.hs-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr;gap:40px;align-items:center}
.hs-kicker{display:inline-flex;align-items:center;gap:7px;background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.28);border-radius:var(--r-pill);padding:5px 14px;font-size:.67rem;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:#c4b5fd;margin-bottom:14px}
.hs-inner h2{font-size:clamp(1.7rem,4.5vw,2.9rem);font-weight:700;color:#fff;margin-bottom:12px}
.hs-inner p{color:rgba(255,255,255,.58);font-size:clamp(.88rem,2.2vw,1rem);line-height:1.78;margin-bottom:28px;max-width:480px}
.hs-features{display:flex;flex-direction:column;gap:12px;margin-bottom:32px}
.hs-feat{display:flex;align-items:flex-start;gap:12px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:var(--r-lg);padding:14px 16px}
.hs-feat-icon{width:36px;height:36px;flex-shrink:0;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.95rem}
.hs-feat-icon.p{background:rgba(139,92,246,.2);color:#c4b5fd}
.hs-feat-icon.b{background:rgba(26,79,214,.2);color:#93c5fd}
.hs-feat-icon.g{background:rgba(16,185,129,.2);color:#6ee7b7}
.hs-feat-title{font-size:.84rem;font-weight:700;color:rgba(255,255,255,.88);margin-bottom:2px}
.hs-feat-desc{font-size:.75rem;color:rgba(255,255,255,.45);line-height:1.5}

/* HS laptop visual */
.hs-visual{display:flex;justify-content:center}
.laptop-frame{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-xl);overflow:hidden;width:100%;max-width:460px;backdrop-filter:blur(16px)}
.laptop-bar{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.08)}
.laptop-dots{display:flex;gap:6px}
.laptop-dot{width:10px;height:10px;border-radius:50%}
.laptop-dot.r{background:#ff5f57}
.laptop-dot.y{background:#febc2e}
.laptop-dot.g{background:#28c840}
.laptop-title{font-size:.7rem;color:rgba(255,255,255,.35);font-weight:600}
.laptop-tab{font-size:.67rem;background:rgba(139,92,246,.2);color:#c4b5fd;padding:3px 9px;border-radius:4px;font-weight:700}
.laptop-content{padding:20px}
.lab-project{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-lg);padding:14px 16px;margin-bottom:10px}
.lab-project:last-child{margin-bottom:0}
.lab-proj-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.lab-proj-name{font-size:.78rem;font-weight:700;color:rgba(255,255,255,.82)}
.lab-proj-status{font-size:.62rem;font-weight:800;padding:2px 8px;border-radius:var(--r-pill)}
.lab-proj-status.done{background:rgba(16,185,129,.2);color:#6ee7b7}
.lab-proj-status.wip{background:rgba(245,158,11,.2);color:#fbbf24}
.lab-proj-status.new{background:rgba(139,92,246,.2);color:#c4b5fd}
.lab-proj-bar{height:4px;background:rgba(255,255,255,.08);border-radius:2px;margin-bottom:5px}
.lab-proj-fill{height:100%;border-radius:2px}
.lab-proj-fill.done{background:linear-gradient(90deg,#10b981,#06b6d4);width:100%}
.lab-proj-fill.wip{background:linear-gradient(90deg,#f59e0b,#f97316);width:60%}
.lab-proj-fill.new{background:linear-gradient(90deg,#8b5cf6,#ec4899);width:15%}
.lab-proj-meta{font-size:.67rem;color:rgba(255,255,255,.35);display:flex;justify-content:space-between}

/* ════════════════════════════════
   WHY KIDS LOVE IT — BENEFITS
════════════════════════════════ */
.benefits-grid{display:grid;grid-template-columns:1fr;gap:20px}
@media(min-width:640px){.benefits-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.benefits-grid{grid-template-columns:repeat(3,1fr)}}

.benefit-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);padding:28px 24px;transition:var(--t);box-shadow:var(--sh-sm)}
body.dark .benefit-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.benefit-card:hover{transform:translateY(-5px);box-shadow:var(--sh-lg)}
.bc-ico{width:54px;height:54px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.55rem;margin-bottom:16px;transition:var(--t)}
.benefit-card:hover .bc-ico{transform:scale(1.1) rotate(-5deg)}
.bc-ico.a{background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.2)}
.bc-ico.b{background:rgba(6,182,212,.1);border:1px solid rgba(6,182,212,.2)}
.bc-ico.c{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.2)}
.bc-ico.d{background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.2)}
.bc-ico.e{background:rgba(236,72,153,.1);border:1px solid rgba(236,72,153,.2)}
.bc-ico.f{background:rgba(26,79,214,.1);border:1px solid rgba(26,79,214,.2)}
.bc-title{font-size:.96rem;font-weight:700;margin-bottom:6px;font-family:'Fraunces',serif;color:var(--ink)}
body.dark .bc-title{color:rgba(255,255,255,.9)}
.bc-desc{font-size:.8rem;color:var(--slate);line-height:1.66}
body.dark .bc-desc{color:rgba(255,255,255,.48)}

/* ════════════════════════════════
   LEARNING STEPS / HOW IT WORKS
════════════════════════════════ */
.steps-wrap{position:relative;display:grid;grid-template-columns:1fr;gap:20px}
@media(min-width:768px){.steps-wrap{grid-template-columns:repeat(4,1fr)}}
@media(min-width:768px){
  .steps-wrap::before{content:'';position:absolute;top:36px;left:calc(12.5% + 20px);right:calc(12.5% + 20px);height:2px;background:linear-gradient(90deg,var(--blue),var(--kids-purple),var(--kids-pink));opacity:.3;border-radius:2px}
}
.step-item{display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 8px;position:relative}
.step-num{width:72px;height:72px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-size:1.5rem;font-weight:700;color:#fff;margin-bottom:16px;position:relative;flex-shrink:0}
.step-num.s1{background:linear-gradient(135deg,#f59e0b,#f97316);box-shadow:0 8px 24px rgba(245,158,11,.35)}
.step-num.s2{background:linear-gradient(135deg,#3b82f6,#8b5cf6);box-shadow:var(--sh-blue)}
.step-num.s3{background:linear-gradient(135deg,#ec4899,#f43f5e);box-shadow:0 8px 24px rgba(236,72,153,.35)}
.step-num.s4{background:linear-gradient(135deg,#10b981,#06b6d4);box-shadow:0 8px 24px rgba(16,185,129,.3)}
.step-title{font-size:.95rem;font-weight:700;margin-bottom:6px;font-family:'Fraunces',serif;color:var(--ink)}
body.dark .step-title{color:rgba(255,255,255,.9)}
.step-desc{font-size:.78rem;color:var(--slate);line-height:1.6}
body.dark .step-desc{color:rgba(255,255,255,.48)}

/* ════════════════════════════════
   PARENT TESTIMONIALS
════════════════════════════════ */
.testimonials-grid{display:grid;grid-template-columns:1fr;gap:18px}
@media(min-width:640px){.testimonials-grid{grid-template-columns:repeat(3,1fr)}}
.t-card{background:#fff;border-radius:var(--r-xl);padding:26px 22px;border:1px solid var(--mist);transition:var(--t);display:flex;flex-direction:column;box-shadow:var(--sh-sm);position:relative;overflow:hidden}
body.dark .t-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.t-card::before{content:'"';position:absolute;top:-8px;left:16px;font-family:'Fraunces',serif;font-size:7rem;color:var(--blue-pale);line-height:1;pointer-events:none}
.t-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.t-stars{color:var(--yellow);letter-spacing:1px;margin-bottom:10px;font-size:.9rem}
.t-quote{font-style:italic;color:var(--slate);line-height:1.78;font-size:.83rem;flex-grow:1;margin-bottom:16px;position:relative;z-index:1}
body.dark .t-quote{color:rgba(255,255,255,.5)}
.t-author{display:flex;align-items:center;gap:11px}
.t-ava{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.t-name{font-weight:700;font-size:.84rem;font-family:'Fraunces',serif;color:var(--ink)}
body.dark .t-name{color:rgba(255,255,255,.88)}
.t-role{font-size:.69rem;color:var(--slate)}

/* ════════════════════════════════
   FAQ
════════════════════════════════ */
.faq-grid{display:grid;grid-template-columns:1fr;gap:9px}
@media(min-width:640px){.faq-grid{grid-template-columns:1fr 1fr}}
.faq-item{background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);overflow:hidden;transition:border-color .22s;box-shadow:var(--sh-sm)}
body.dark .faq-item{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.faq-item:hover{border-color:var(--kids-purple)}
.faq-item.open{border-color:var(--kids-purple)}
.faq-q{padding:15px 18px;font-weight:700;font-size:.84rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'Plus Jakarta Sans',sans-serif;min-height:52px;gap:12px;color:var(--ink)}
body.dark .faq-q{color:rgba(255,255,255,.85)}
.faq-icon{width:20px;height:20px;flex-shrink:0;background:rgba(139,92,246,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--kids-purple);font-size:.62rem;transition:transform .24s,background .22s}
.faq-item.open .faq-icon{transform:rotate(45deg);background:var(--kids-purple);color:#fff}
.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;color:var(--slate);font-size:.81rem;line-height:1.76}
body.dark .faq-a{color:rgba(255,255,255,.48)}
.faq-item.open .faq-a{max-height:200px;padding:0 18px 14px}

/* ════════════════════════════════
   ENROL CTA BAND
════════════════════════════════ */
.enrol-band{background:var(--g-kids);position:relative;overflow:hidden;padding:72px 0}
.enrol-band::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:36px 36px}
.enrol-band::after{content:'';position:absolute;top:-80px;right:-60px;width:360px;height:360px;border-radius:50%;background:rgba(255,255,255,.08);pointer-events:none}
.enrol-inner{position:relative;z-index:1;text-align:center}
.enrol-band h2{font-size:clamp(1.8rem,5vw,3rem);font-weight:700;color:#fff;margin-bottom:12px}
.enrol-band h2 em{font-style:italic;color:#fde68a}
.enrol-band p{color:rgba(255,255,255,.68);font-size:clamp(.9rem,2vw,1.06rem);line-height:1.76;max-width:480px;margin:0 auto 30px}
.enrol-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.btn-enrol-white{background:#fff;color:var(--blue);font-weight:800;border-radius:var(--r-pill);padding:14px 30px;font-size:.92rem;font-family:'Plus Jakarta Sans',sans-serif;display:inline-flex;align-items:center;gap:8px;transition:var(--t);box-shadow:0 6px 22px rgba(0,0,0,.18);cursor:pointer;border:none;text-decoration:none}
.btn-enrol-white:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(0,0,0,.25)}
.btn-enrol-ghost{background:rgba(255,255,255,.12);color:#fff;font-weight:700;border-radius:var(--r-pill);padding:13px 26px;font-size:.9rem;font-family:'Plus Jakarta Sans',sans-serif;display:inline-flex;align-items:center;gap:7px;transition:var(--t);border:1.5px solid rgba(255,255,255,.3);backdrop-filter:blur(8px);text-decoration:none}
.btn-enrol-ghost:hover{background:rgba(255,255,255,.2);transform:translateY(-2px)}
.trust-badges{display:flex;justify-content:center;flex-wrap:wrap;gap:14px;margin-top:28px}
.trust-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:var(--r-pill);padding:5px 14px;font-size:.73rem;font-weight:700;color:rgba(255,255,255,.82)}

/* ════════════════════════════════
   NEWSLETTER
════════════════════════════════ */
.newsletter-section{background:linear-gradient(135deg,#edf1ff,#ecfdf5)}
.newsletter-box{background:#fff;border-radius:var(--r-2xl);padding:36px 28px;border:1px solid var(--mist);box-shadow:var(--sh-md)}
body.dark .newsletter-box{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.nl-icon{width:48px;height:48px;background:rgba(139,92,246,.1);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;font-size:1.35rem;color:var(--kids-purple);margin-bottom:13px}
.nl-grid{display:grid;grid-template-columns:1fr;gap:26px}
@media(min-width:992px){.nl-grid{grid-template-columns:1fr 1fr;align-items:center}}
.nl-form{position:relative;display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.nl-form-inp{flex:1;min-width:0;padding:12px 16px 12px 42px;border:1.5px solid var(--mist);border-radius:var(--r-pill);font-size:15px;font-family:'Plus Jakarta Sans',sans-serif;transition:var(--t);background:#fff;color:var(--ink);outline:none}
body.dark .nl-form-inp{background:var(--ink-3);border-color:rgba(255,255,255,.1);color:#fff}
.nl-form-inp:focus{border-color:var(--kids-purple);box-shadow:0 0 0 3px rgba(139,92,246,.1)}
.nl-form .nl-ico{position:absolute;left:15px;color:var(--slate-l);font-size:.86rem;pointer-events:none;top:50%;transform:translateY(-50%)}
.nl-submit{background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff;border:none;padding:12px 20px;border-radius:var(--r-pill);font-weight:700;font-size:.82rem;font-family:'Plus Jakarta Sans',sans-serif;transition:var(--t);cursor:pointer;white-space:nowrap;flex-shrink:0}
.nl-submit:hover{background:linear-gradient(135deg,#ec4899,#db2777)}
@media(min-width:992px){
  .nl-form{flex-wrap:nowrap}
  .nl-form-inp{padding:12px 150px 12px 42px}
  .nl-submit{position:absolute;right:5px;top:50%;transform:translateY(-50%)}
}

/* ════════════════════════════════
   FOOTER
════════════════════════════════ */
@keyframes bar-shift2{0%{background-position:0%}100%{background-position:200%}}
footer{background:#050810;color:rgba(255,255,255,.48);font-size:.82rem;border-top:1px solid rgba(255,255,255,.05)}
.footer-accent-bar{height:2px;background:var(--g-kids);background-size:200% 100%;animation:bar-shift2 6s linear infinite}
.footer-cta-strip{background:linear-gradient(135deg,#0c1630,#101f40);border-bottom:1px solid rgba(255,255,255,.05);padding:30px 0}
.footer-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
.footer-cta-text h4{font-family:'Fraunces',serif;font-size:clamp(.98rem,2.8vw,1.35rem);font-weight:700;color:#fff;margin-bottom:3px;line-height:1.2}
.footer-cta-text p{font-size:.76rem;color:rgba(255,255,255,.36);margin:0}
.footer-cta-btns{display:flex;gap:9px;flex-wrap:wrap;flex-shrink:0}
.footer-body{padding:52px 0 36px}
.footer-cols{display:grid;grid-template-columns:2fr 1fr 1fr 1.6fr;gap:34px 28px}
.footer-brand-name{font-family:'Fraunces',serif;font-size:1.14rem;font-weight:700;color:#fff;letter-spacing:-.04em;display:flex;align-items:center;gap:7px;margin-bottom:9px}
.footer-brand-name em{font-style:italic;color:#e8620a}
.footer-bmark{width:27px;height:27px;background:var(--g-blue);border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:.8rem;color:#fff;flex-shrink:0}
.footer-tagline{font-size:.77rem;color:rgba(255,255,255,.34);line-height:1.74;max-width:270px;margin-bottom:16px}
.footer-socials{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px}
.fsoc{width:32px;height:32px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);color:rgba(255,255,255,.48);font-size:.78rem;transition:all .2s;text-decoration:none}
.fsoc:hover{transform:translateY(-2px)}
.fsoc.fb:hover{background:#1877f2;color:#fff}
.fsoc.li:hover{background:#0077b5;color:#fff}
.fsoc.ig:hover{background:linear-gradient(135deg,#fd5949,#d6249f,#285aeb);color:#fff}
.fsoc.yt:hover{background:#ff0000;color:#fff}
.fsoc.wa:hover{background:#25D366;color:#fff}
.footer-col-title{font-size:.62rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:rgba(255,255,255,.26);margin-bottom:14px;display:flex;align-items:center;gap:6px}
.footer-col-title::before{content:'';width:10px;height:1.5px;background:var(--kids-purple);border-radius:2px;flex-shrink:0}
.footer-links{list-style:none;padding:0;margin:0}
.footer-links li{margin-bottom:9px}
.footer-links a{color:rgba(255,255,255,.4);text-decoration:none;font-size:.77rem;transition:color .18s,padding-left .18s;display:inline-flex;align-items:center;gap:5px}
.footer-links a:hover{color:#fff;padding-left:3px}
.footer-links a i{width:12px;font-size:.66rem;opacity:.5}
.footer-links a.acad{color:#5eead4;font-weight:600}
.fci{display:flex;align-items:flex-start;gap:9px;margin-bottom:12px}
.fci-ic{width:28px;height:28px;flex-shrink:0;background:rgba(139,92,246,.12);border-radius:7px;display:flex;align-items:center;justify-content:center;color:#c4b5fd;font-size:.68rem;margin-top:1px}
.fci-label{font-size:.58rem;color:rgba(255,255,255,.22);font-weight:800;letter-spacing:.7px;text-transform:uppercase}
.fci-val{font-size:.77rem;color:rgba(255,255,255,.58)}
.fci-val a{color:rgba(255,255,255,.58);text-decoration:none;transition:color .18s}
.fci-val a:hover{color:var(--orange-l)}
.footer-hours{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.05);border-radius:7px;padding:6px 10px;font-size:.69rem;color:rgba(255,255,255,.36);margin-top:3px}
.hdot{width:6px;height:6px;background:#34d399;border-radius:50%;animation:dot-p 2.4s ease-in-out infinite;flex-shrink:0}
.footer-divider{border:none;border-top:1px solid rgba(255,255,255,.05)}
.footer-bottom{padding:16px 0}
.footer-bottom-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.footer-copy{font-size:.7rem;color:rgba(255,255,255,.2)}
.footer-legal{display:flex;gap:18px;flex-wrap:wrap}
.footer-legal a{font-size:.69rem;color:rgba(255,255,255,.24);text-decoration:none;transition:color .18s}
.footer-legal a:hover{color:rgba(255,255,255,.6)}
.footer-made{font-size:.69rem;color:rgba(255,255,255,.18);display:flex;align-items:center;gap:3px}
.footer-made span{color:var(--orange-l)}

