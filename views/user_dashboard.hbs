<script>
// ── SCROLL PROGRESS ──────────────────────────────────────────
const scrollPrg = document.getElementById('scroll-progress');
const btt       = document.getElementById('back-to-top');
window.addEventListener('scroll', function() {
  const st = window.pageYOffset;
  const dh = document.documentElement.scrollHeight - window.innerHeight;
  if(scrollPrg) scrollPrg.style.width = (dh > 0 ? (st/dh)*100 : 0) + '%';
  if(btt) btt.classList.toggle('visible', st > 400);
}, {passive: true});
btt && btt.addEventListener('click', () => window.scrollTo({top: 0, behavior: 'smooth'}));

// ── THEME ────────────────────────────────────────────────────
const themeBtn = document.getElementById('theme-toggle');
let dark = localStorage.getItem('nw-theme') === 'dark' ||
           (!localStorage.getItem('nw-theme') && window.matchMedia('(prefers-color-scheme:dark)').matches);
const MOON = '<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
const SUN  = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme() {
  document.body.classList.toggle('dark', dark);
  themeBtn.innerHTML = dark ? SUN : MOON;
}
applyTheme();
themeBtn && themeBtn.addEventListener('click', () => { dark = !dark; localStorage.setItem('nw-theme', dark ? 'dark' : 'light'); applyTheme(); });

// ── COOKIE ───────────────────────────────────────────────────
const cookieBar = document.getElementById('cookie-bar');
if(!localStorage.getItem('nw-cookie')) setTimeout(() => cookieBar && cookieBar.classList.add('show'), 2600);
const cookieAcceptBtn = document.getElementById('cookie-accept');
if(cookieAcceptBtn) {
  cookieAcceptBtn.addEventListener('click', function() { 
    localStorage.setItem('nw-cookie', '1'); 
    if(cookieBar) cookieBar.classList.remove('show'); 
  });
}

// ── TOAST ────────────────────────────────────────────────────
function showToast(msg, type) {
  const t = document.getElementById('toast');
  if(!t) return;
  t.style.borderLeftColor = type === 'error' ? '#ef4444' : 'var(--emerald)';
  const toastMsg = document.getElementById('toast-msg');
  if(toastMsg) toastMsg.textContent = msg;
  t.classList.add('show');
  setTimeout(function() { t.classList.remove('show'); }, 3800);
}

// ── SIDEBAR ──────────────────────────────────────────────────
const sidebar = document.getElementById('dbSidebar');
const mainEl  = document.getElementById('dbMain');
const mobOverlay = document.getElementById('sbMobOverlay');
const tbToggle   = document.getElementById('tbToggle');

function isMobile() { return window.innerWidth < 992; }

if(tbToggle) {
  tbToggle.addEventListener('click', function() {
    if(isMobile()) {
      sidebar.classList.toggle('mob-open');
      mobOverlay.classList.toggle('open');
      document.body.style.overflow = sidebar.classList.contains('mob-open') ? 'hidden' : '';
    } else {
      sidebar.classList.toggle('collapsed');
      mainEl.classList.toggle('wide');
    }
  });
}
if(mobOverlay) {
  mobOverlay.addEventListener('click', function() {
    sidebar.classList.remove('mob-open');
    mobOverlay.classList.remove('open');
    document.body.style.overflow = '';
  });
}

// ── PAGE NAVIGATION ──────────────────────────────────────────
const pageLabels = { dashboard:'Dashboard', projects:'My Projects', courses:'My Courses', activities:'Activity Log', profile:'Edit Profile', settings:'Settings' };
function navigateTo(page) {
  document.querySelectorAll('.db-page').forEach(function(p) { p.style.display = 'none'; });
  const target = document.getElementById('page-' + page);
  if(target) target.style.display = 'block';
  document.querySelectorAll('.sb-link[data-page]').forEach(function(l) {
    l.classList.toggle('active', l.dataset.page === page);
  });
  const label = document.getElementById('tbPageLabel');
  if(label) label.textContent = pageLabels[page] || page;
  if(page === 'projects') loadUserProjects();
  if(page === 'courses') loadUserCourses();
  if(page === 'activities') loadUserActivities();
  if(isMobile()) { 
    sidebar.classList.remove('mob-open'); 
    mobOverlay.classList.remove('open'); 
    document.body.style.overflow = ''; 
  }
  window.scrollTo({top: 0, behavior: 'smooth'});
}
document.querySelectorAll('.sb-link[data-page]').forEach(function(link) {
  link.addEventListener('click', function(e) { 
    e.preventDefault(); 
    navigateTo(link.dataset.page); 
  });
});

// ── MODAL ────────────────────────────────────────────────────
function openModal(id) { 
  const modal = document.getElementById(id);
  if(modal) modal.classList.add('open'); 
  document.body.style.overflow = 'hidden'; 
}
function closeModal(id) { 
  const modal = document.getElementById(id);
  if(modal) modal.classList.remove('open'); 
  document.body.style.overflow = ''; 
}
document.querySelectorAll('.nw-modal-backdrop').forEach(function(bd) {
  bd.addEventListener('click', function(e) { 
    if(e.target === bd) closeModal(bd.id); 
  });
});
document.addEventListener('keydown', function(e) { 
  if(e.key === 'Escape') {
    document.querySelectorAll('.nw-modal-backdrop.open').forEach(function(bd) {
      closeModal(bd.id);
    });
  }
});

// ── CHART ────────────────────────────────────────────────────
const chartCtx = document.getElementById('activityChart');
if(chartCtx && typeof Chart !== 'undefined') {
  new Chart(chartCtx, {
    type: 'line',
    data: {
      labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
      datasets: [{
        label: 'Projects',
        data: [2, 4, 3, 5, 7, 9],
        borderColor: '#1a56e8',
        backgroundColor: 'rgba(26,86,232,0.1)',
        tension: 0.4,
        fill: true,
        pointBackgroundColor: '#1a56e8',
        pointRadius: 4
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
        x: { grid: { display: false } }
      }
    }
  });
}

// ── LOAD USER DATA ───────────────────────────────────────────
async function loadUserStats() {
  try {
    const res = await fetch('/api/user/stats');
    const d = await res.json();
    if(d.success) {
      const totalEl = document.getElementById('totalProjects');
      const completedEl = document.getElementById('completedProjects');
      const activeEl = document.getElementById('activeProjects');
      const enrollEl = document.getElementById('totalEnrollments');
      const badge = document.getElementById('projBadge');
      const cb = document.getElementById('coursesBadge');
      const ce = document.getElementById('c-totalEnrolled');
      const ca = document.getElementById('c-activeEnrolled');
      const cp = document.getElementById('c-avgProgress');
      
      if(totalEl) totalEl.textContent = d.totalProjects || 0;
      if(completedEl) completedEl.textContent = d.completedProjects || 0;
      if(activeEl) activeEl.textContent = d.activeProjects || 0;
      if(enrollEl) enrollEl.textContent = d.totalEnrollments || 0;
      if(badge) badge.textContent = d.totalProjects || 0;
      if(cb) cb.textContent = d.totalEnrollments || 0;
      if(ce) ce.textContent = d.totalEnrollments || 0;
      if(ca) ca.textContent = d.activeEnrollments || 0;
      if(cp) cp.textContent = (d.avgProgress || 0) + '%';
    }
  } catch(e) { console.error(e); }
}

async function loadUserCourses() {
  try {
    const res = await fetch('/api/user/enrollments');
    const d = await res.json();
    const grid = document.getElementById('coursesGrid');
    const noMsg = document.getElementById('noCoursesMsg');
    if(!grid) return;

    const enrollments = d.enrollments || [];

    if(!enrollments.length) {
      grid.innerHTML = '';
      if(noMsg) noMsg.style.display = 'block';
      return;
    }
    if(noMsg) noMsg.style.display = 'none';

    grid.innerHTML = enrollments.map(function(e) {
      const progress = parseInt(e.progress) || 0;
      const category = e.category || 'Course';
      const status = e.status || 'active';
      const statusCol = status === 'active' ? '#34d399' : '#93c5fd';
      const statusBg = status === 'active' ? 'rgba(13,191,126,0.2)' : 'rgba(26,86,232,0.2)';
      const statusBdr = status === 'active' ? 'rgba(13,191,126,0.3)' : 'rgba(26,86,232,0.3)';
      const enrolled = new Date(e.enrolled_at).toLocaleDateString('en-KE', {month:'short', day:'numeric', year:'numeric'});
      const imgHtml = e.image_url 
        ? '<img src="' + e.image_url + '" alt="' + e.title + '" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0">' 
        : '<span style="position:relative;z-index:1;font-size:2.4rem">🎓</span>';

      return `
        <div class="db-card" style="padding:0;overflow:hidden;border-radius:var(--r-xl);transition:transform .22s,box-shadow .22s" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 12px 40px rgba(8,12,24,.14)'" onmouseleave="this.style.transform='';this.style.boxShadow=''">
          <div style="height:130px;background:linear-gradient(135deg,#0f1628,#1c2840);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center">
            ${imgHtml}
            <span style="position:absolute;top:8px;left:10px;background:rgba(8,12,24,.72);border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:3px 10px;font-size:.62rem;font-weight:800;color:rgba(255,255,255,.7);backdrop-filter:blur(6px)">${category}</span>
            <span style="position:absolute;top:8px;right:10px;background:${statusBg};border:1px solid ${statusBdr};border-radius:999px;padding:3px 10px;font-size:.62rem;font-weight:800;color:${statusCol}">${status}</span>
          </div>
          <div style="padding:16px">
            <div style="font-weight:700;font-size:.92rem;margin-bottom:4px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;line-height:1.3">${e.title}</div>
            <div style="font-size:.74rem;color:var(--slate);margin-bottom:12px">${e.instructor_name || 'NeurowexTech'} · ${e.level || 'Beginner'}</div>
            <div style="background:var(--mist);border-radius:999px;height:6px;margin-bottom:6px;overflow:hidden">
              <div style="height:100%;background:linear-gradient(90deg,var(--blue),var(--teal));border-radius:999px;width:${progress}%;transition:width .6s"></div>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:.7rem;color:var(--slate);margin-bottom:14px">
              <span>${progress}% complete</span>
              <span>Enrolled ${enrolled}</span>
            </div>
            <a href="/learn/course/${e.course_id}/dashboard" style="display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--blue),#1341c4);color:#fff;padding:8px 16px;border-radius:999px;font-size:.78rem;font-weight:700;text-decoration:none;transition:all .2s">
              <i class="fas fa-play-circle"></i> Continue Learning
            </a>
          </div>
        </div>`;
    }).join('');

    const total = enrollments.length;
    const active = enrollments.filter(function(e) { return e.status === 'active'; }).length;
    const avg = total ? Math.round(enrollments.reduce(function(s, e) { return s + (parseInt(e.progress) || 0); }, 0) / total) : 0;
    
    const ce2 = document.getElementById('c-totalEnrolled');
    const ca2 = document.getElementById('c-activeEnrolled');
    const cp2 = document.getElementById('c-avgProgress');
    if(ce2) ce2.textContent = total;
    if(ca2) ca2.textContent = active;
    if(cp2) cp2.textContent = avg + '%';

  } catch(e) { console.error('loadUserCourses:', e); }
}

async function loadUserProjects() {
  try {
    const res = await fetch('/api/user/projects');
    const d = await res.json();
    const grid = document.getElementById('projectsGrid');
    if(!grid) return;
    if(d.projects && d.projects.length) {
      grid.innerHTML = d.projects.map(function(p) {
        const statusClass = p.status === 'Completed' ? 'st-completed' : (p.status === 'In Progress' ? 'st-inprogress' : 'st-planning');
        return `
        <div class="proj-card">
          <div class="proj-img"><img src="/images/${p.image || 'web_development.jpg'}" alt="${p.name}" loading="lazy"></div>
          <div class="proj-body">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:6px;">
              <div class="proj-title">${p.name}</div>
              <span class="st-pill ${statusClass}">${p.status || 'Planning'}</span>
            </div>
            <p class="proj-desc">${p.description || 'No description provided.'}</p>
            <div class="proj-prog"><div class="proj-prog-fill" style="width:${p.progress || 0}%"></div></div>
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:.72rem;color:var(--slate);margin-bottom:12px;">
              <span>Progress</span><span>${p.progress || 0}%</span>
            </div>
            <button class="btn-outline" style="width:100%;justify-content:center;padding:8px;font-size:.8rem;" onclick="viewProjectDetails(${p.id})">View Details <i class="fas fa-arrow-right"></i></button>
          </div>
        </div>`;
      }).join('');
    } else {
      grid.innerHTML = '<div class="db-empty" style="grid-column:1/-1"><i class="fas fa-folder-open"></i><h6>No projects yet</h6><p>Click "Request Project" to get started.</p></div>';
    }
  } catch(e) { console.error(e); }
}

async function loadUserActivities() {
  try {
    const res = await fetch('/api/user/activities');
    const d = await res.json();
    const body = document.getElementById('activitiesBody');
    if(!body) return;
    if(d.activities && d.activities.length) {
      body.innerHTML = d.activities.map(function(a) {
        const type = (a.type || 'system').toLowerCase();
        const typeClass = type === 'enrollment' ? 'st-completed' : type === 'login' ? 'st-inprogress' : 'st-planning';
        const typeLabel = type.charAt(0).toUpperCase() + type.slice(1);
        return `
        <tr>
          <td>${new Date(a.created_at).toLocaleDateString('en-KE')}</td>
          <td>${a.activity || '—'}</td>
          <td><span class="st-pill ${typeClass}">${typeLabel}</span></td>
        </tr>`;
      }).join('');
    } else {
      body.innerHTML = '<tr><td colspan="3" style="text-align:center;padding:28px;color:var(--slate)">No activity yet.</td></tr>';
    }
  } catch(e) { console.error(e); }
}

async function loadFeaturedProjects() {
  try {
    const res = await fetch('/api/user/projects');
    const d = await res.json();
    const grid = document.getElementById('featuredProjectsGrid');
    if(!grid) return;
    if(d.projects && d.projects.length) {
      grid.innerHTML = '<div style="display:grid;gap:12px;">' + d.projects.slice(0,3).map(function(p) {
        const statusCol = p.status === 'Completed' ? 'var(--emerald)' : p.status === 'In Progress' ? 'var(--blue)' : 'var(--orange)';
        return `
        <div style="display:flex;align-items:center;gap:12px;background:var(--ghost);border-radius:var(--r-md);padding:10px 12px;" class="proj-row">
          <div style="width:46px;height:46px;border-radius:10px;flex-shrink:0;background:var(--blue-pale);display:flex;align-items:center;justify-content:center;font-size:1.3rem;">📁</div>
          <div style="flex:1;min-width:0;">
            <div style="font-size:.83rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${p.name}</div>
            <div style="font-size:.7rem;color:${statusCol};font-weight:600;">${p.status || 'Planning'}</div>
          </div>
          <button onclick="viewProjectDetails(${p.id})" class="btn-outline" style="padding:5px 12px;font-size:.7rem;white-space:nowrap;flex-shrink:0;">View</button>
        </div>`;
      }).join('') + '</div>';
    } else {
      grid.innerHTML = '<div class="db-empty"><i class="fas fa-folder-open"></i><p>No projects yet.</p></div>';
    }
  } catch(e) { console.error(e); }
}

async function loadRecentActivity() {
  try {
    const res = await fetch('/api/user/recent-activity');
    const d = await res.json();
    const timeline = document.getElementById('activityTimeline');
    if(!timeline) return;
    if(d.activities && d.activities.length) {
      timeline.innerHTML = d.activities.map(function(a) {
        const type = (a.type || 'system').toLowerCase();
        const dotColor = type === 'login' ? 'var(--emerald)' : type === 'enrollment' ? 'var(--orange)' : 'var(--blue)';
        const when = new Date(a.created_at).toLocaleString('en-KE', {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
        return `
        <div class="tl-item">
          <div class="tl-dot" style="background:${dotColor}"></div>
          <div><div class="tl-title">${a.activity || 'Activity'}</div><div class="tl-meta">${type} · ${when}</div></div>
        </div>`;
      }).join('');
    } else {
      timeline.innerHTML = '<div class="db-empty"><i class="fas fa-stream"></i><p>No recent activity</p></div>';
    }
  } catch(e) { console.error(e); }
}

// ── INIT ─────────────────────────────────────────────────────
loadUserStats();
loadFeaturedProjects();
loadRecentActivity();

// ── ACTIONS ──────────────────────────────────────────────────
function updateProfile() {
  const name = document.getElementById('modalName').value.trim();
  const email = document.getElementById('modalEmail').value.trim();
  if(!name || !email) { showToast('Please fill in all fields', 'error'); return; }
  fetch('/api/user/profile', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name: name, email: email })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if(d.success) { 
      showToast('Profile updated!', 'success'); 
      closeModal('profileModal'); 
      setTimeout(function() { location.reload(); }, 1500); 
    } else { 
      showToast(d.message || 'Update failed', 'error'); 
    }
  }).catch(function() { showToast('Network error', 'error'); });
}

function submitProjectRequest() {
  const name = document.getElementById('projectName').value.trim();
  const type = document.getElementById('projectType').value;
  const desc = document.getElementById('projectDesc').value.trim();
  const budget = document.getElementById('projectBudget').value;
  if(!name || !desc) { showToast('Please fill in all required fields', 'error'); return; }
  fetch('/api/user/request-project', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name: name, type: type, description: desc, budget: budget })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if(d.success) { 
      showToast('Project request submitted! 🎉', 'success'); 
      closeModal('requestModal'); 
      setTimeout(function() { location.reload(); }, 1500); 
    } else { 
      showToast(d.message || 'Submission failed', 'error'); 
    }
  }).catch(function() { showToast('Network error', 'error'); });
}

const profileForm = document.getElementById('profileForm');
if(profileForm) {
  profileForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = e.submitter; 
    if(btn) { btn.textContent = 'Saving…'; btn.disabled = true; }
    const name = document.getElementById('profileName')?.value.trim() || '';
    const email = document.getElementById('profileEmail')?.value.trim() || '';
    const bio = document.getElementById('profileBio')?.value.trim() || '';
    const r = await fetch('/api/user/profile', { 
      method: 'PUT', 
      headers: { 'Content-Type': 'application/json' }, 
      body: JSON.stringify({ name: name, email: email, bio: bio }) 
    });
    const d = await r.json();
    showToast(d.message || (d.success ? 'Saved!' : 'Error'), d.success ? 'success' : 'error');
    if(btn) { btn.textContent = 'Save Changes'; btn.disabled = false; }
    if(d.success) setTimeout(function() { location.reload(); }, 1500);
  });
}

const settingsForm = document.getElementById('settingsForm');
if(settingsForm) {
  settingsForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const np = document.getElementById('newPassword')?.value || '';
    const cp = document.getElementById('confirmNewPassword')?.value || '';
    if(np !== cp) { showToast('Passwords do not match', 'error'); return; }
    const r = await fetch('/api/user/change-password', { 
      method: 'POST', 
      headers: { 'Content-Type': 'application/json' }, 
      body: JSON.stringify({ 
        currentPassword: document.getElementById('currentPassword')?.value || '', 
        newPassword: np 
      }) 
    });
    const d = await r.json();
    showToast(d.message || (d.success ? 'Password changed!' : 'Error'), d.success ? 'success' : 'error');
    if(d.success && settingsForm) settingsForm.reset();
  });
}

const saveNotifications = document.getElementById('saveNotifications');
if(saveNotifications) {
  saveNotifications.addEventListener('click', function() {
    showToast('Preferences saved!', 'success');
  });
}

function viewProjectDetails(id) { 
  window.location.href = '/portfolio/' + id; 
}

// Responsive 2-col grid
function fixGrids() {
  document.querySelectorAll('.db-2col').forEach(function(g) {
    g.style.gridTemplateColumns = window.innerWidth < 768 ? '1fr' : '1fr 1fr';
  });
}
fixGrids();
window.addEventListener('resize', fixGrids);
