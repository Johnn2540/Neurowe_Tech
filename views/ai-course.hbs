   FOOTER
════════════════════════════════ */
footer{background:#020a08;color:rgba(255,255,255,.48);font-size:.82rem;border-top:1px solid rgba(255,255,255,.04)}
.footer-accent-bar{height:2px;background:var(--g-ai);background-size:200% 100%;animation:bar-shift2 6s linear infinite}
@keyframes bar-shift2{0%{background-position:0%}100%{background-position:200%}}
.footer-cta-strip{background:linear-gradient(135deg,#041818,#061024);border-bottom:1px solid rgba(255,255,255,.04);padding:30px 0}
