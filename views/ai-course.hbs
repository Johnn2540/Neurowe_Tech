.footer-cta-text h4{font-family:'Fraunces',serif;font-size:clamp(.98rem,2.8vw,1.35rem);font-weight:700;color:#fff;margin-bottom:3px;line-height:1.2}
.footer-cta-text p{font-size:.76rem;color:rgba(255,255,255,.32);margin:0}
.footer-cta-btns{display:flex;gap:9px;flex-wrap:wrap;flex-shrink:0}
.footer-body{padding:52px 0 36px}
.footer-cols{display:grid;grid-template-columns:2fr 1fr 1fr 1.6fr;gap:34px 28px}
.footer-brand-name{font-family:'Fraunces',serif;font-size:1.14rem;font-weight:700;color:#fff;letter-spacing:-.04em;display:flex;align-items:center;gap:7px;margin-bottom:9px}
.footer-brand-name em{font-style:italic;color:#e8620a}
.footer-bmark{width:27px;height:27px;background:var(--g-blue);border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:.8rem;color:#fff;flex-shrink:0}
.footer-tagline{font-size:.77rem;color:rgba(255,255,255,.3);line-height:1.74;max-width:270px;margin-bottom:16px}
.footer-socials{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px}
.fsoc{width:32px;height:32px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.05);color:rgba(255,255,255,.42);font-size:.78rem;transition:all .2s;text-decoration:none}
.fsoc:hover{transform:translateY(-2px)}
.fsoc.fb:hover{background:#1877f2;color:#fff}
.fsoc.li:hover{background:#0077b5;color:#fff}
.fsoc.ig:hover{background:linear-gradient(135deg,#fd5949,#d6249f,#285aeb);color:#fff}
.fsoc.yt:hover{background:#ff0000;color:#fff}
.fsoc.wa:hover{background:#25D366;color:#fff}
.footer-col-title{font-size:.62rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:rgba(255,255,255,.22);margin-bottom:14px;display:flex;align-items:center;gap:6px}
.footer-col-title::before{content:'';width:10px;height:1.5px;background:var(--ai-1);border-radius:2px;flex-shrink:0}
.footer-links{list-style:none;padding:0;margin:0}
.footer-links li{margin-bottom:9px}
.footer-links a{color:rgba(255,255,255,.36);text-decoration:none;font-size:.77rem;transition:color .18s,padding-left .18s;display:inline-flex;align-items:center;gap:5px}
.footer-links a:hover{color:#fff;padding-left:3px}
.footer-links a i{width:12px;font-size:.66rem;opacity:.4}
.footer-links a.acad{color:#5eead4;font-weight:600}
.fci{display:flex;align-items:flex-start;gap:9px;margin-bottom:12px}
.fci-ic{width:28px;height:28px;flex-shrink:0;background:rgba(13,148,136,.1);border-radius:7px;display:flex;align-items:center;justify-content:center;color:#5eead4;font-size:.68rem;margin-top:1px}
.fci-label{font-size:.58rem;color:rgba(255,255,255,.2);font-weight:800;letter-spacing:.7px;text-transform:uppercase}
.fci-val{font-size:.77rem;color:rgba(255,255,255,.52)}
.fci-val a{color:rgba(255,255,255,.52);text-decoration:none;transition:color .18s}
.fci-val a:hover{color:#5eead4}
.footer-hours{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.04);border-radius:7px;padding:6px 10px;font-size:.69rem;color:rgba(255,255,255,.3);margin-top:3px}
.hdot{width:6px;height:6px;background:#34d399;border-radius:50%;animation:dot-p 2.4s ease-in-out infinite;flex-shrink:0}
.footer-divider{border:none;border-top:1px solid rgba(255,255,255,.04)}
.footer-bottom{padding:16px 0}
.footer-bottom-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.footer-copy{font-size:.7rem;color:rgba(255,255,255,.18)}
.footer-legal{display:flex;gap:18px;flex-wrap:wrap}
.footer-legal a{font-size:.69rem;color:rgba(255,255,255,.2);text-decoration:none;transition:color .18s}
.footer-legal a:hover{color:rgba(255,255,255,.6)}
.footer-made{font-size:.69rem;color:rgba(255,255,255,.15);display:flex;align-items:center;gap:3px}
.footer-made span{color:var(--orange-l)}

