          <a class="share-btn wa" href="https://wa.me/?text={{post.title}}%20https://neurowextech.co.ke/blog/{{post.slug}}" target="_blank" rel="noopener" title="WhatsApp"><i class="fab fa-whatsapp"></i></a>
          <button class="share-btn copy" onclick="copyLink()" title="Copy link"><i class="fas fa-link"></i></button>
        </div>
      </div>

      <!-- Author card -->
      <div class="author-card" data-aos="fade-up">
        <div class="author-av-lg">{{truncate (default post.author "N") 1}}</div>
        <div>
          <h5>{{default post.author "NeurowexTech Team"}}</h5>
          <div class="role">Writer · NeurowexTech</div>
          <p>Building and shipping digital products from Nairobi. We write about web development, AI integrations, UI/UX design and growing tech businesses in Kenya and beyond.</p>
        </div>
      </div>

      <!-- Related posts -->
      {{#if relatedPosts}}
      <div style="margin-top:48px;" data-aos="fade-up">
        <div style="margin-bottom:22px;">
          <div class="section-tag">More Articles</div>
          <h3 class="section-title" style="font-size:1.5rem;">You Might Also <span class="g-blue">Like</span></h3>
        </div>
        <div class="related-grid">
          {{#each relatedPosts}}
