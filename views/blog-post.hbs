<!-- POST HERO -->
<section class="post-hero">
  <div class="ph-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="post-hero-inner" data-aos="fade-up">

      <!-- Breadcrumb -->
      <nav class="post-breadcrumb" aria-label="Breadcrumb">
        <a href="/"><i class="fas fa-home"></i> Home</a>
        <i class="fas fa-chevron-right"></i>
        <a href="/blog">Blog</a>
        <i class="fas fa-chevron-right"></i>
        <span>{{truncate post.title 50}}</span>
      </nav>

      <!-- Category -->
      <div class="post-cat-badge {{#if (eq post.category 'Development')}}dev{{else if (eq post.category 'AI & Machine Learning')}}ai{{else if (eq post.category 'UI/UX Design')}}ui{{else}}gen{{/if}}">
        {{post.category}}
      </div>

      <!-- Title -->
      <h1>{{post.title}}</h1>

      <!-- Meta row -->
      <div class="post-meta-row">
        <div class="pm-author">
          <div class="pm-av">{{truncate (default post.author "N") 1}}</div>
          <div>
            <div class="pm-author-name">{{default post.author "NeurowexTech"}}</div>
            <div style="font-size:.68rem;color:rgba(255,255,255,.38)">Author</div>
          </div>
        </div>
        <span class="pm-sep">·</span>
        <div class="pm-item"><i class="fas fa-calendar-alt"></i> {{shortDate post.created_at}}</div>
        {{#if post.read_time}}
        <span class="pm-sep">·</span>
        <div class="pm-item"><i class="fas fa-clock"></i> {{post.read_time}} min read</div>
        {{/if}}
        {{#if post.external_url}}
        <span class="pm-sep">·</span>
        <div class="pm-item" style="color:rgba(255,255,255,.55);">
          <i class="{{#if post.is_video}}fab fa-youtube{{else}}fas fa-external-link-alt{{/if}}"></i>
          {{#if post.is_video}}Video{{else}}External Link{{/if}}
        </div>
        {{/if}}
      </div>

      <!-- Share -->
      <div class="post-share-row">
        <span class="share-label">Share</span>
        <a class="share-btn fb" href="https://www.facebook.com/sharer/sharer.php?u=https://neurowextech.co.ke/blog/{{post.slug}}" target="_blank" rel="noopener" title="Share on Facebook"><i class="fab fa-facebook-f"></i></a>
        <a class="share-btn li" href="https://www.linkedin.com/sharing/share-offsite/?url=https://neurowextech.co.ke/blog/{{post.slug}}" target="_blank" rel="noopener" title="Share on LinkedIn"><i class="fab fa-linkedin-in"></i></a>
        <a class="share-btn wa" href="https://wa.me/?text={{post.title}}%20https://neurowextech.co.ke/blog/{{post.slug}}" target="_blank" rel="noopener" title="Share on WhatsApp"><i class="fab fa-whatsapp"></i></a>
        <button class="share-btn copy" id="copyLinkBtn" title="Copy link"><i class="fas fa-link"></i></button>
      </div>

      <!-- Hero Image -->
      {{#if post.image_url}}
      <div class="post-hero-img-wrap">
        <img src="{{post.image_url}}" alt="{{post.title}}" loading="eager" />
      </div>
      {{/if}}
    </div>
  </div>
</section>

<!-- MAIN CONTENT -->
<div class="container">
  <div class="post-layout">

    <!-- ARTICLE -->
    <article>

      <!-- External video CTA -->
      {{#if post.external_url}}
      <a href="{{post.external_url}}" target="_blank" rel="noopener noreferrer" class="post-video-cta" data-aos="fade-up">
        <div class="pvc-icon">
          <i class="{{#if post.is_video}}fab fa-youtube{{else}}fas fa-external-link-alt{{/if}}"></i>
        </div>
        <div class="pvc-text">
          <div class="pvc-label">{{#if post.is_video}}Watch on YouTube{{else}}Read Full Article{{/if}}</div>
          <div class="pvc-title">{{post.title}}</div>
        </div>
        <i class="fas fa-arrow-right" style="margin-left:auto;color:var(--slate)"></i>
      </a>
      {{/if}}

      <!-- Post content -->
      <div class="post-body" id="postBody" data-aos="fade-up">
        {{#if post.content}}
          {{{post.content}}}
        {{else if post.excerpt}}
          <p>{{post.excerpt}}</p>
          {{#if post.external_url}}
          <p>Continue reading the full article or watching the video using the link above.</p>
          {{else}}
          <p style="color:var(--slate);font-style:italic;">Full article content coming soon.</p>
          {{/if}}
        {{else}}
          <p style="color:var(--slate);font-style:italic;">Content will appear here.</p>
        {{/if}}
      </div>

      <!-- Tags -->
      {{#if post.tags}}
      <div class="post-tags">
        <span style="font-size:.76rem;font-weight:700;color:var(--slate);"><i class="fas fa-tag" style="margin-right:4px"></i></span>
        {{#each post.tags}}
        <a href="/blog?tag={{this}}" class="post-tag">{{this}}</a>
        {{/each}}
      </div>
      {{else}}
      <div class="post-tags">
        <span style="font-size:.76rem;font-weight:700;color:var(--slate);"><i class="fas fa-tag" style="margin-right:4px"></i></span>
        <a href="/blog" class="post-tag">{{post.category}}</a>
