/* SIDEBAR */
.sidebar{display:flex;flex-direction:column;gap:20px}
.side-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);padding:22px;box-shadow:var(--sh-sm)}
.side-card-title{font-size:.64rem;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--blue);margin-bottom:16px;display:flex;align-items:center;gap:7px}
.side-card-title::before{content:'';width:11px;height:2px;background:var(--blue);border-radius:2px;flex-shrink:0}
.info-row{display:flex;align-items:flex-start;gap:12px;padding:11px 0;border-bottom:1px solid var(--mist)}
.info-row:last-child{border-bottom:none;padding-bottom:0}
.ir-icon{width:34px;height:34px;flex-shrink:0;background:var(--blue-pale);border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:.78rem;margin-top:1px}
.ir-label{font-size:.62rem;color:var(--slate-l);font-weight:700;letter-spacing:.7px;text-transform:uppercase;margin-bottom:2px}
.ir-val{font-size:.82rem;font-weight:600;color:var(--ink)}
body.dark .ir-val{color:rgba(255,255,255,.76)}
.ir-val a{color:inherit;transition:color .2s}
.ir-val a:hover{color:var(--orange)}
.avail-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(5,150,105,.1);border:1px solid rgba(5,150,105,.2);border-radius:var(--r-pill);padding:4px 11px;font-size:.68rem;font-weight:700;color:#10b981;margin-bottom:14px}
.avail-dot{width:6px;height:6px;border-radius:50%;background:#34d399;animation:dp 2.4s ease-in-out infinite;flex-shrink:0}
.avail-rows{display:flex;flex-direction:column;gap:8px}
.avail-row{display:flex;align-items:center;justify-content:space-between;background:var(--ghost);border:1px solid var(--mist);border-radius:var(--r-sm);padding:9px 13px}
.slot-day{font-size:.78rem;font-weight:700;color:var(--ink)}
.slot-time{font-size:.72rem;color:var(--slate)}
.slot-badge{font-size:.62rem;font-weight:800;padding:2px 9px;border-radius:var(--r-pill);letter-spacing:.3px}
.badge-open{background:rgba(5,150,105,.12);color:#059669;border:1px solid rgba(5,150,105,.2)}
.badge-ltd{background:var(--orange-pale);color:var(--orange);border:1px solid rgba(232,98,10,.2)}
.why-item{display:flex;align-items:flex-start;gap:11px;padding:10px 0;border-bottom:1px solid var(--mist)}
.why-item:last-child{border-bottom:none;padding-bottom:0}
.why-icon{width:30px;height:30px;flex-shrink:0;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.74rem}
.why-icon.g{background:rgba(5,150,105,.1);color:var(--emerald)}
.why-icon.b{background:var(--blue-pale);color:var(--blue)}
.why-icon.o{background:var(--orange-pale);color:var(--orange)}
.why-icon.t{background:rgba(13,148,136,.1);color:var(--teal)}
.why-title{font-size:.82rem;font-weight:700;margin-bottom:2px}
.why-sub{font-size:.74rem;color:var(--slate);line-height:1.55}
.socials{display:flex;gap:8px;flex-wrap:wrap}
.soc{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:var(--blue-pale);color:var(--blue);font-size:.84rem;transition:var(--t)}
.soc:hover{transform:translateY(-3px)}
.soc.tw:hover{background:#1da1f2;color:#fff}
.soc.li:hover{background:#0077b5;color:#fff}
.soc.gh:hover{background:#333;color:#fff}
.soc.ig:hover{background:linear-gradient(135deg,#fd5949,#d6249f,#285aeb);color:#fff}
.soc.wa:hover{background:#25D366;color:#fff}

/* FAQ */
.faq-section{padding:64px 0;background:#fff}
body.dark .faq-section{background:var(--ink-2)}
.faq-head{text-align:center;margin-bottom:40px}
.faq-kicker{display:inline-flex;align-items:center;gap:6px;background:var(--blue-pale);color:var(--blue);border-radius:var(--r-pill);padding:4px 13px;font-size:.65rem;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;margin-bottom:10px;border:1px solid rgba(26,79,214,.12)}
.faq-kicker::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue)}
.faq-head h2{font-size:clamp(1.5rem,4vw,2.2rem);font-weight:700;margin-bottom:8px}
.faq-head p{font-size:.87rem;color:var(--slate);max-width:420px;margin:0 auto}
.faq-list{display:grid;grid-template-columns:1fr;gap:9px;max-width:820px;margin:0 auto}
.faq-item{background:var(--ghost);border-radius:var(--r-lg);border:1px solid var(--mist);overflow:hidden;transition:border-color .22s}
.faq-item:hover{border-color:var(--blue)}
.faq-item.open{border-color:var(--blue-l)}
.faq-q{padding:15px 18px;font-weight:700;font-size:.85rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'Plus Jakarta Sans',sans-serif;min-height:52px;gap:12px}
.faq-icon{width:20px;height:20px;flex-shrink:0;background:var(--blue-pale);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:.62rem;transition:transform .24s,background .22s}
.faq-item.open .faq-icon{transform:rotate(45deg);background:var(--blue);color:#fff}
.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;color:var(--slate);font-size:.82rem;line-height:1.76}
.faq-item.open .faq-a{max-height:180px;padding:0 18px 14px}

/* FOOTER */
@keyframes bar-shift{0%{background-position:0%}100%{background-position:200%}}
