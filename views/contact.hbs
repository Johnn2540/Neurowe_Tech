/* FORM */
.form-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);box-shadow:var(--sh-md);overflow:hidden}
.form-top{padding:28px 32px 22px;border-bottom:1px solid var(--mist);position:relative}
.form-top::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--orange))}
.form-top h2{font-size:1.35rem;font-weight:700;margin-bottom:4px}
.form-top p{font-size:.81rem;color:var(--slate);line-height:1.6}
.form-body{padding:28px 32px 32px}
.f-label{font-size:.77rem;font-weight:700;color:var(--slate);display:block;margin-bottom:6px}
.f-label .req{color:var(--rose)}
.field-wrap{position:relative}
.field-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--slate-l);font-size:.8rem;pointer-events:none;transition:color .2s}
.field-wrap:focus-within .field-icon{color:var(--blue)}
.f-input{width:100%;background:var(--ghost);border:1.5px solid var(--mist);border-radius:var(--r-md);color:var(--ink);padding:11px 14px;font-size:15px;font-family:'Plus Jakarta Sans',sans-serif;transition:var(--t);outline:none;-webkit-appearance:none}
.f-input.has-icon{padding-left:38px}
.f-input:focus{background:#fff;border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,79,214,.08)}
.f-input.error{border-color:var(--rose);box-shadow:0 0 0 3px rgba(225,29,72,.08)}
.f-input::placeholder{color:var(--slate-l)}
.f-error{font-size:.7rem;color:var(--rose);margin-top:4px;display:none;align-items:center;gap:4px}
.f-input.error~.f-error{display:flex}
.row2{display:grid;grid-template-columns:1fr;gap:16px}
.fg{display:flex;flex-direction:column;gap:0}
.mt14{margin-top:14px}.mt20{margin-top:20px}
.svc-wrap{display:flex;flex-wrap:wrap;gap:7px;align-items:center}
.svc-chk{display:none}
.svc-tag{display:inline-flex;align-items:center;gap:5px;background:#fff;border:1.5px solid var(--mist);color:var(--slate);border-radius:var(--r-pill);padding:6px 13px;font-size:.76rem;font-weight:600;transition:var(--t);cursor:pointer;user-select:none}
.svc-tag i{font-size:.7rem}
.svc-tag:hover{border-color:var(--blue);color:var(--blue)}
.svc-chk:checked+.svc-tag{background:var(--g-blue);border-color:transparent;color:#fff;box-shadow:var(--sh-blue)}
.svc-custom-inp{background:#fff;border:1.5px dashed var(--mist);color:var(--slate);border-radius:var(--r-pill);padding:6px 14px;font-size:.76rem;font-weight:600;width:160px;outline:none;transition:var(--t);font-family:inherit}
.svc-custom-inp:focus{border-color:var(--blue);border-style:solid}
.svc-custom-inp::placeholder{color:var(--mist);font-weight:500}
body.dark .svc-custom-inp{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.15);color:rgba(255,255,255,.7)}
body.dark .svc-custom-inp:focus{border-color:var(--blue)}
.textarea-wrap{position:relative}
.char-ct{position:absolute;bottom:9px;right:11px;font-size:.63rem;color:var(--slate-l);pointer-events:none}
.nda-row{display:flex;align-items:flex-start;gap:9px;background:var(--blue-pale);border:1px solid rgba(26,79,214,.14);border-radius:var(--r-md);padding:13px 14px;margin-top:20px;cursor:pointer}
.nda-row input[type="checkbox"]{width:16px;height:16px;flex-shrink:0;margin-top:1px;accent-color:var(--blue);cursor:pointer}
.nda-row label{font-size:.78rem;color:var(--slate);line-height:1.58;cursor:pointer}
.nda-row label strong{color:var(--ink)}
.or-div{display:flex;align-items:center;gap:12px;margin:20px 0;font-size:.73rem;color:var(--slate-l);font-weight:600}
.or-div::before,.or-div::after{content:'';flex:1;height:1px;background:var(--mist)}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.87rem;border-radius:var(--r-pill);transition:var(--t);cursor:pointer;border:none;letter-spacing:.01em;white-space:nowrap}
.btn-primary{background:var(--g-blue);color:#fff;padding:12px 26px;box-shadow:var(--sh-blue)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(26,79,214,.36)}
.btn-primary:disabled{opacity:.6;cursor:not-allowed;transform:none}
.btn-orange{background:var(--g-orange);color:#fff;padding:12px 24px;box-shadow:var(--sh-orange)}
.btn-orange:hover{transform:translateY(-2px)}
.btn-outline{background:transparent;color:var(--blue);padding:10px 22px;border:1.5px solid var(--blue)}
.btn-outline:hover{background:var(--g-blue);color:#fff;transform:translateY(-2px)}
.btn-wa-full{display:flex;align-items:center;justify-content:center;gap:9px;background:linear-gradient(135deg,#128C7E,#075E54);color:#fff;padding:12px 22px;border-radius:var(--r-pill);font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.87rem;box-shadow:0 6px 18px rgba(18,140,126,.3);transition:var(--t)}
.btn-wa-full:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(18,140,126,.44)}
.btn-submit{width:100%;padding:13px;font-size:.9rem;border-radius:var(--r-lg);position:relative}
@keyframes spin{to{transform:rotate(360deg)}}
.spinner{display:none;width:17px;height:17px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
.btn-submit.loading .btn-txt{display:none}
.btn-submit.loading .spinner{display:block}

/* Error banner */
.form-err-banner{display:none;background:rgba(225,29,72,.06);border:1px solid rgba(225,29,72,.18);border-radius:var(--r-md);padding:11px 14px;margin-bottom:16px;font-size:.8rem;color:var(--rose);align-items:center;gap:8px}
.form-err-banner.show{display:flex}

/* SUCCESS */
@keyframes scale-in{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
@keyframes check-draw{to{stroke-dashoffset:0}}
.form-success{display:none;padding:48px 32px;text-align:center;animation:scale-in .45s cubic-bezier(.34,1.56,.64,1) both}
.success-circle{width:68px;height:68px;background:linear-gradient(135deg,var(--emerald),#10b981);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;box-shadow:0 8px 28px rgba(5,150,105,.28)}
.success-circle svg{width:34px;height:34px}
.check-path{stroke-dasharray:34;stroke-dashoffset:34;animation:check-draw .5s .28s ease forwards}
.form-success h3{font-size:1.4rem;font-weight:700;margin-bottom:8px}
.form-success p{font-size:.84rem;color:var(--slate);line-height:1.72;max-width:360px;margin:0 auto 22px}
.success-facts{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;margin-bottom:22px}
.sf{display:flex;align-items:center;gap:5px;font-size:.74rem;color:var(--slate);font-weight:600}
