<script>
/* ── THEME ── */
var dark = localStorage.getItem('nw-theme') === 'dark' ||
  (!localStorage.getItem('nw-theme') && window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON = '<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN  = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme() {
  document.body.classList.toggle('dark', dark);
  document.getElementById('theme-toggle').innerHTML = dark ? SUN : MOON;
  var m = document.getElementById('mobThemeBtn');
  if (m) m.innerHTML = dark ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
}
applyTheme();
function toggleTheme() { dark = !dark; localStorage.setItem('nw-theme', dark ? 'dark' : 'light'); applyTheme(); }
document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
var mtb = document.getElementById('mobThemeBtn'); if (mtb) mtb.addEventListener('click', toggleTheme);

/* ── SCROLL ── */
var navbar = document.getElementById('mainNav'),
    sp     = document.getElementById('scroll-progress'),
    btt    = document.getElementById('back-to-top');
window.addEventListener('scroll', function() {
  var s = window.pageYOffset, d = document.documentElement.scrollHeight - window.innerHeight;
  sp.style.width = (d > 0 ? s / d * 100 : 0) + '%';
  navbar.classList.toggle('scrolled', s > 40);
  btt.classList.toggle('visible', s > 400);
}, { passive: true });
btt.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });

/* ── MOBILE NAV ── */
var ov = document.getElementById('mobOverlay'),
    panel = document.getElementById('mobPanel'),
    ham = document.getElementById('hamBtn'),
    mc  = document.getElementById('mobClose'),
    mst = document.getElementById('mobSvcToggle'),
    mss = document.getElementById('mobSvcSub');
function openM() { ov.classList.add('open'); panel.classList.add('open'); ham.classList.add('open'); ham.setAttribute('aria-expanded','true'); document.body.style.overflow = 'hidden'; mc.focus(); }
function closeM() { panel.classList.remove('open'); ov.classList.remove('open'); ham.classList.remove('open'); ham.setAttribute('aria-expanded','false'); document.body.style.overflow = ''; }
ham.addEventListener('click', openM); mc.addEventListener('click', closeM); ov.addEventListener('click', closeM);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && panel.classList.contains('open')) closeM(); });
mst.addEventListener('click', function() { var o = mss.classList.toggle('open'); mst.classList.toggle('open', o); mst.setAttribute('aria-expanded', o); });

/* ── COOKIE ── */
var cb = document.getElementById('cookie-bar');
if (!localStorage.getItem('nw-cookie')) setTimeout(function() { cb.classList.add('show'); }, 2800);
document.getElementById('cookie-accept').addEventListener('click', function() { localStorage.setItem('nw-cookie','1'); cb.classList.remove('show'); });

/* ── TOAST ── */
function toast(msg, isErr) {
  var t = document.getElementById('toast');
  var icon = document.getElementById('toastIcon');
  document.getElementById('toast-msg').textContent = msg;
  if (isErr) {
    t.classList.add('err');
    icon.className = 'fas fa-exclamation-circle';
    icon.style.color = '#f87171';
  } else {
    t.classList.remove('err');
    icon.className = 'fas fa-check-circle';
    icon.style.color = '#34d399';
  }
  t.classList.add('show');
  setTimeout(function() { t.classList.remove('show'); t.classList.remove('err'); }, 4200);
}

/* ── URL param pre-select ── */
(function() {
  var p = new URLSearchParams(window.location.search), svc = p.get('service');
  if (!svc) return;
  var v = svc.toLowerCase().replace(/\+/g, ' ');
  var matched = false;
  document.querySelectorAll('.svc-chk').forEach(function(c) {
    if (c.value.toLowerCase() === v) { c.checked = true; matched = true; }
  });
  if (!matched) {
    var customInp = document.getElementById('svcCustom');
    if (customInp) customInp.value = svc.replace(/\+/g, ' ');
  }
})();

/* ── CHAR COUNT ── */
var msgEl = document.getElementById('cMessage');
if (msgEl) {
  document.getElementById('charNum').textContent = msgEl.value.length;
  msgEl.addEventListener('input', function() { document.getElementById('charNum').textContent = this.value.length; });
}

/* ── FORM SUBMIT ── */
document.getElementById('contactForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  var n   = document.getElementById('cName');
  var em  = document.getElementById('cEmail');
  var msg = document.getElementById('cMessage');
  var ok  = true;

  // Clear previous errors
  [n, em, msg].forEach(function(f) { f.classList.remove('error'); });
  document.getElementById('msgErr').style.display = 'none';

  // Validate
  if (!n.value.trim() || n.value.trim().length < 2) { n.classList.add('error'); ok = false; }
  if (!em.value.trim() || !/^\S+@\S+\.\S+$/.test(em.value.trim())) { em.classList.add('error'); ok = false; }
  if (msg.value.trim().length < 10) {
    msg.classList.add('error');
    document.getElementById('msgErr').style.display = 'flex';
    ok = false;
  }

  if (!ok) {
    // Scroll to first error
    var firstErr = document.querySelector('.f-input.error');
    if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }

  var btn = document.getElementById('cSubmit');
  btn.classList.add('loading');
  btn.disabled = true;

  // Collect services (checkboxes + custom freetext)
  var services = Array.from(document.querySelectorAll('.svc-chk:checked')).map(function(c) { return c.value; });
  var customSvc = document.getElementById('svcCustom').value.trim();
  if (customSvc) services.push(customSvc);

  // Append timeline + NDA into the message body so server stores them
  // (server extracts: name, email, phone, project_type, budget, message, company, services)
  var baseMsg  = msg.value.trim();
  var timeline = document.getElementById('cTimeline').value;
  var ndaChecked = document.getElementById('cNDA').checked;
  var extras = [];
  if (timeline)   extras.push('Timeline: ' + timeline);
  if (ndaChecked) extras.push('NDA requested: Yes');
  var fullMessage = extras.length ? baseMsg + '\n\n[' + extras.join(' | ') + ']' : baseMsg;

  var payload = {
    name:    n.value.trim(),
    email:   em.value.trim(),
    phone:   document.getElementById('cPhone').value.trim(),
    company: document.getElementById('cCompany').value.trim(),
    services: services,           // server resolves to project_type
    budget:  document.getElementById('cBudget').value,
    message: fullMessage
  };

  try {
    var res  = await fetch('/contact', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload)
    });

    var data;
    try { data = await res.json(); } catch(_) { data = {}; }

    btn.classList.remove('loading');
    btn.disabled = false;

    if (!res.ok || data.success === false) {
      var errMsg = data.message || 'Something went wrong. Please try again or reach us on WhatsApp.';
      toast(errMsg, true);
      return;
    }

    // SUCCESS
    document.getElementById('contactForm').style.display = 'none';
    var succ = document.getElementById('formSuccess');
    succ.style.display = 'block';
    succ.scrollIntoView({ behavior: 'smooth', block: 'center' });
    toast("Message sent! We'll reply within 24 hrs ✅");

  } catch (err) {
    btn.classList.remove('loading');
    btn.disabled = false;
    toast('Network error — please check your connection or reach us on WhatsApp.', true);
    console.error('Contact form error:', err);
  }
});

/* ── FAQ ── */
document.querySelectorAll('.faq-q').forEach(function(q) {
  q.addEventListener('click', function() {
    var item = q.parentElement, wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(function(i) { i.classList.remove('open'); });
    if (!wasOpen) item.classList.add('open');
  });
});

/* ── Show success if server rendered with ?success ── */
if (window._formSuccess) {
  document.getElementById('contactForm').style.display = 'none';
  document.getElementById('formSuccess').style.display = 'block';
}
</script>
