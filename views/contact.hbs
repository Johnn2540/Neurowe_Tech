<style>
:root {
  --blue:      #1a4fd6;
  --blue-d:    #1340b0;
  --blue-l:    #4a7aee;
  --blue-pale: rgba(26,79,214,.08);
  --orange:    #e8620a;
  --orange-l:  #f28840;
  --orange-pale:rgba(232,98,10,.08);
  --ink:       #0c1220;
  --ink-2:     #141c30;
  --slate:     #5a6880;
  --slate-l:   #7a8ea8;
  --mist:      #e2e8f5;
  --ghost:     #f5f7fd;
  --emerald:   #059669;
  --teal:      #0d9488;
  --rose:      #e11d48;
  --g-blue:    linear-gradient(135deg,#1a4fd6,#1340b0);
  --g-orange:  linear-gradient(135deg,#e8620a,#c94f05);
  --g-hero:    linear-gradient(168deg,#030610 0%,#07102a 50%,#0b1535 100%);
  --nav-h:     68px;
  --r-sm:10px;--r-md:14px;--r-lg:18px;--r-xl:24px;--r-pill:999px;
  --ease:cubic-bezier(.4,0,.2,1);--t:.24s var(--ease);
  --sh-sm:0 2px 8px rgba(8,12,24,.06),0 6px 20px rgba(8,12,24,.06);
  --sh-md:0 4px 16px rgba(8,12,24,.08),0 14px 40px rgba(8,12,24,.09);
  --sh-blue:0 8px 28px rgba(26,79,214,.26);
  --sh-orange:0 8px 28px rgba(232,98,10,.24);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--ghost);color:var(--ink);overflow-x:hidden;line-height:1.65}
h1,h2,h3,h4{font-family:'Fraunces',serif;line-height:1.1;letter-spacing:-.02em}
a{text-decoration:none;color:inherit}
button,input,textarea,select{font-family:'Plus Jakarta Sans',sans-serif}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:var(--ink)}::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}
#scroll-progress{position:fixed;top:0;left:0;height:2px;width:0%;background:linear-gradient(90deg,var(--blue),var(--orange));z-index:9999;transition:width .08s linear}

/* ── NAVBAR ── */
.navbar{position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);background:rgba(255,255,255,.96);backdrop-filter:blur(24px) saturate(2);border-bottom:1px solid rgba(8,12,24,.06);transition:var(--t)}
.navbar.scrolled{box-shadow:0 2px 24px rgba(8,12,24,.07)}
.nav-inner{max-width:1320px;margin:0 auto;padding:0 24px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}
.nav-brand{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:7px;flex-shrink:0;letter-spacing:-.04em}
.brand-mark{width:30px;height:30px;background:var(--g-blue);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:.85rem;color:#fff;flex-shrink:0}
.nav-brand em{font-style:italic;color:var(--orange)}
.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-a{font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 12px;border-radius:var(--r-sm);transition:var(--t);display:inline-flex;align-items:center;gap:5px}
.nl-a:hover,.nl-a.active{color:var(--blue);background:var(--blue-pale)}
.nl-item{position:relative}
.nl-a .chev{font-size:.52rem;transition:transform .22s}
.nl-item:hover .chev{transform:rotate(180deg)}
.mega-drop{position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%) translateY(8px);min-width:540px;background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);box-shadow:0 24px 64px rgba(8,12,24,.14);padding:22px;opacity:0;visibility:hidden;pointer-events:none;transition:all .2s var(--ease)}
.nl-item:hover .mega-drop{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
.mega-drop::before{content:'';position:absolute;top:-5px;left:50%;width:10px;height:10px;background:#fff;border-left:1px solid var(--mist);border-top:1px solid var(--mist);transform:translateX(-50%) rotate(45deg)}
.mega-grid{display:grid;grid-template-columns:1fr 1fr 1fr}
.mega-col-label{font-size:.61rem;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--blue);padding:0 8px 8px;display:block}
.mega-link{display:flex;align-items:center;gap:7px;padding:7px 10px;border-radius:var(--r-sm);font-size:.79rem;font-weight:500;color:var(--slate);transition:all .14s}
.mega-link i{width:15px;color:var(--blue);font-size:.74rem;flex-shrink:0}
.mega-link:hover{background:var(--blue-pale);color:var(--blue);transform:translateX(2px)}
.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}
.btn-nav-signin{font-size:.79rem;font-weight:600;color:var(--slate);padding:7px 15px;border:1.5px solid var(--mist);border-radius:var(--r-pill);background:#fff;cursor:pointer;transition:var(--t)}
.btn-nav-signin:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-orange{font-size:.79rem;font-weight:700;color:var(--orange);padding:7px 15px;border:1.5px solid rgba(232,98,10,.28);border-radius:var(--r-pill);background:var(--orange-pale);cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:var(--t)}
.btn-nav-orange:hover{background:var(--g-orange);color:#fff;border-color:transparent}
.btn-nav-start{font-size:.79rem;font-weight:700;color:#fff;padding:8px 19px;border:none;border-radius:var(--r-pill);background:var(--g-blue);cursor:pointer;box-shadow:var(--sh-blue);display:inline-flex;align-items:center;gap:5px;transition:var(--t)}
.btn-nav-start:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(26,79,214,.36)}
.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:44px;height:44px;background:none;border:none;cursor:pointer;border-radius:var(--r-sm);transition:var(--t);flex-shrink:0}
.ham-btn:hover{background:var(--blue-pale)}
.ham-line{display:block;width:20px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .24s var(--ease);transform-origin:center}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:38px;height:38px;border-radius:var(--r-sm);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:var(--t);background:var(--blue-pale);color:var(--blue)}
.mob-quick-wa{width:38px;height:38px;border-radius:var(--r-sm);background:rgba(37,211,102,.1);color:#25D366;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:var(--t)}
.mob-overlay{position:fixed;inset:0;background:rgba(8,12,24,.55);backdrop-filter:blur(6px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .28s,visibility .28s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(340px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-12px 0 48px rgba(8,12,24,.18);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.82rem;flex-shrink:0}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:11px;padding:12px 22px;font-size:.88rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px}
.mob-link i{width:18px;color:var(--blue);font-size:.8rem;flex-shrink:0}
.mob-link:hover,.mob-link.cur{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-sub-toggle{display:flex;align-items:center;justify-content:space-between;padding:12px 22px;font-size:.88rem;font-weight:600;color:var(--ink);cursor:pointer;transition:var(--t);min-height:48px}
.mob-sub-toggle .left{display:flex;align-items:center;gap:11px}
.mob-sub-toggle .left i{width:18px;color:var(--blue);font-size:.8rem}
.mob-sub-toggle:hover{background:var(--blue-pale);color:var(--blue)}
.mob-sub-toggle .ci{font-size:.58rem;color:var(--slate);transition:transform .24s}
.mob-sub-toggle.open .ci{transform:rotate(180deg)}
.mob-sub{background:rgba(26,79,214,.03);border-top:1px solid var(--blue-pale);border-bottom:1px solid var(--blue-pale);max-height:0;overflow:hidden;transition:max-height .32s ease}
.mob-sub.open{max-height:600px}
.mob-sub a{display:flex;align-items:center;gap:8px;padding:10px 22px 10px 50px;font-size:.8rem;color:var(--slate);transition:var(--t);min-height:42px}
.mob-sub a i{width:15px;color:var(--blue);font-size:.72rem}
.mob-sub a:hover{color:var(--blue);background:rgba(26,79,214,.05)}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 18px}
.mob-footer{padding:14px 18px 30px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:9px}

/* DARK */
body.dark{background:#050810;color:rgba(255,255,255,.84)}
body.dark .navbar{background:rgba(8,12,24,.97);border-bottom-color:rgba(255,255,255,.05)}
body.dark .nl-a{color:rgba(255,255,255,.52)}
body.dark .nl-a:hover{color:var(--blue-l);background:rgba(26,79,214,.1)}
body.dark .mega-drop{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-drop::before{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-link{color:rgba(255,255,255,.52)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:var(--ink-2)}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link{color:rgba(255,255,255,.82)}
body.dark .mob-close{background:rgba(255,255,255,.07);color:rgba(255,255,255,.7)}
body.dark .mob-hr{border-color:rgba(255,255,255,.07)}
body.dark .mob-footer{border-color:rgba(255,255,255,.07)}
body.dark .btn-nav-signin{color:rgba(255,255,255,.52);border-color:rgba(255,255,255,.1);background:transparent}
body.dark #theme-toggle{background:var(--ink-2);border-color:rgba(255,255,255,.09)}
body.dark #theme-toggle svg{stroke:rgba(255,255,255,.72)}
body.dark .form-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .form-top{border-color:rgba(255,255,255,.07)}
body.dark .f-label{color:rgba(255,255,255,.6)}
body.dark .f-input{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:rgba(255,255,255,.85)}
body.dark .f-input::placeholder{color:rgba(255,255,255,.26)}
body.dark .f-input:focus{background:rgba(255,255,255,.08);border-color:var(--blue-l)}
body.dark select.f-input option{background:var(--ink-2)}
body.dark .svc-tag{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:rgba(255,255,255,.52)}
body.dark .info-row{border-color:rgba(255,255,255,.06)}
body.dark .side-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .avail-row{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07)}
body.dark .slot-day{color:rgba(255,255,255,.62)}
body.dark .slot-time{color:rgba(255,255,255,.36)}
body.dark .faq-item{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .faq-q{color:rgba(255,255,255,.84)}
body.dark .or-div::before,body.dark .or-div::after{background:rgba(255,255,255,.07)}

/* UTILS */
.container{max-width:1200px;margin:0 auto;padding:0 24px}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}

/* FIXED WIDGETS */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:44px;height:44px;background:#fff;border:1.5px solid rgba(8,12,24,.08);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 18px rgba(8,12,24,.1);transition:var(--t)}
#theme-toggle svg{width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;transition:stroke .2s}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(20deg) scale(1.07)}
#theme-toggle:hover svg{stroke:#fff}
#back-to-top{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(16px);z-index:10000;width:48px;height:48px;background:var(--g-blue);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .3s,transform .4s cubic-bezier(.34,1.56,.64,1);box-shadow:var(--sh-blue)}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto}
#back-to-top svg{width:18px;height:18px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
#wa-float{position:fixed;bottom:86px;right:20px;z-index:10001;text-decoration:none;display:block}
.wa-ring{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-r 2.8s ease-out infinite;pointer-events:none}
.wa-ring:nth-child(2){animation-delay:1.2s}
@keyframes wa-r{0%{transform:scale(1);opacity:.6}100%{transform:scale(1.95);opacity:0}}
.wa-pill{display:flex;align-items:center;gap:9px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:8px 17px 8px 8px;box-shadow:0 6px 26px rgba(18,140,126,.42);transition:transform .3s cubic-bezier(.34,1.56,.64,1),box-shadow .28s;white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-3px) scale(1.02);box-shadow:0 14px 38px rgba(18,140,126,.54)}
.wa-ico{width:36px;height:36px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.15rem;color:#fff;position:relative}
.wa-dot{position:absolute;top:1px;right:1px;width:9px;height:9px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dp 2.4s ease-in-out infinite}
@keyframes dp{0%,100%{transform:scale(1)}50%{transform:scale(1.45);opacity:.5}}
.wa-text{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.64rem;color:rgba(255,255,255,.55);font-weight:600}
.wa-cta{font-size:.88rem;color:#fff;font-weight:800;font-family:'Fraunces',serif}
.wa-arr{color:rgba(255,255,255,.6);font-size:.68rem;margin-left:2px;transition:transform .2s}
#wa-float:hover .wa-arr{transform:translateX(3px)}
@media(max-width:767px){
  #wa-float{bottom:74px;right:14px}
  .wa-text,.wa-arr{display:none}
  .wa-pill{padding:0;width:52px;height:52px;border-radius:50%;justify-content:center}
  .wa-ico{width:52px;height:52px;font-size:1.4rem}
  #theme-toggle{bottom:14px;left:14px;width:40px;height:40px}
  #back-to-top{bottom:12px;width:46px;height:46px}
}
#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-md);padding:11px 17px;font-size:.82rem;display:flex;align-items:center;gap:8px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:210px;max-width:calc(100vw - 40px)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.err{border-left-color:#ef4444}
#cookie-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.8);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;z-index:9998;transform:translateY(100%);transition:transform .38s;border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap}
#cookie-bar.show{transform:translateY(0)}
#cookie-bar p{font-size:.77rem;margin:0;flex:1;min-width:180px}
#cookie-accept{background:var(--blue);color:#fff;border:none;padding:7px 18px;border-radius:var(--r-pill);font-size:.79rem;cursor:pointer;font-weight:700;transition:var(--t)}
#cookie-accept:hover{background:var(--blue-d)}

/* HERO */
.page-hero{background:var(--g-hero);padding-top:var(--nav-h);position:relative;overflow:hidden}
.page-hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(26,79,214,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(26,79,214,.04) 1px,transparent 1px);background-size:44px 44px}
.orb{position:absolute;border-radius:50%;pointer-events:none}
.orb-1{width:480px;height:480px;background:radial-gradient(circle,rgba(26,79,214,.18) 0%,transparent 68%);top:-140px;right:-80px}
.orb-2{width:320px;height:320px;background:radial-gradient(circle,rgba(232,98,10,.1) 0%,transparent 70%);bottom:-60px;left:-20px}
.page-hero-inner{position:relative;z-index:1;padding:64px 0 56px;max-width:600px}
.breadcrumb{display:inline-flex;align-items:center;gap:7px;font-size:.72rem;color:rgba(255,255,255,.36);font-weight:600;margin-bottom:18px}
.breadcrumb a{color:rgba(255,255,255,.36);transition:color .2s}
.breadcrumb a:hover{color:rgba(255,255,255,.65)}
.breadcrumb .sep{opacity:.3}
.page-hero-inner h1{font-size:clamp(2rem,5.5vw,3.4rem);font-weight:700;color:#fff;margin-bottom:12px}
.page-hero-inner h1 em{font-style:italic;color:var(--orange-l)}
.page-hero-inner p{font-size:clamp(.88rem,2.5vw,1rem);color:rgba(255,255,255,.5);line-height:1.78;max-width:460px;margin-bottom:26px}
.hero-pills{display:flex;flex-wrap:wrap;gap:9px}
.hero-pill{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:var(--r-pill);padding:6px 14px;font-size:.75rem;font-weight:600;color:rgba(255,255,255,.72);backdrop-filter:blur(6px)}
