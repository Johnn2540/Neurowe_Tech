                <div class="toggle-label">Published</div>
                <div class="toggle-desc">Make this course publicly visible and enrollable</div>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="stPublished" {{#if (eq courseStatus 'published')}}checked{{/if}}/>
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="toggle-row">
              <div>
                <div class="toggle-label">Allow Free Preview</div>
                <div class="toggle-desc">Let visitors watch lessons marked as Free Preview</div>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="stAllowFreePreview" checked/>
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="toggle-row">
              <div>
                <div class="toggle-label">Certificate on Completion</div>
                <div class="toggle-desc">Award a certificate when students complete 100%</div>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="stCertificate" checked/>
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <div style="border-bottom:1px solid var(--c-border);padding-bottom:20px;margin-bottom:20px">
            <h3 style="font-size:.9rem;font-weight:600;margin-bottom:14px;color:var(--c-text2)">Pricing</h3>
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label">Price (USD)</label>
                <input type="number" class="form-input" id="stPrice" min="0" step="0.01" placeholder="0.00" style="max-width:160px"/>
