<!-- ══════════════════════════════════════════════════════
     JAVASCRIPT
══════════════════════════════════════════════════════ -->
<script>
/* ── STATE seeded from Handlebars ── */
var STATE = {
  courseId:     {{{json courseId}}},
  courseStatus: {{{json courseStatus}}},
  modules: [
    {{#each modules}}
    {
      id:    {{this.id}},
      title: {{{json this.title}}},
      order: {{@index}},
      lessons: [
        {{#each this.lessons}}
        {
          id:          {{this.id}},
          title:       {{{json this.title}}},
          videoUrl:    {{{json this.video_url}}},
          duration:    {{{json this.duration}}},
          isPublished: {{#if this.isPublished}}true{{else}}false{{/if}},
          isFree:      {{#if this.isFree}}true{{else}}false{{/if}},
          order:       {{@index}}
        }{{#unless @last}},{{/unless}}
        {{/each}}
      ]
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ]
};

/* ── HELPERS ── */
function el(id){ return document.getElementById(id); }
function qs(sel){ return document.querySelector(sel); }
function qsa(sel){ return document.querySelectorAll(sel); }

/* ══════════════════════════════════════════════════════════════
   THEME
═══════════════════════════════════════════════════════════════= */
var isLight = localStorage.getItem('nw-theme') === 'light';
function applyTheme(){
  document.body.classList.toggle('light', isLight);
  var ic = el('themeIcon');
  if(ic) ic.className = isLight ? 'fas fa-moon' : 'fas fa-sun';
}
applyTheme();
el('themeToggle') && el('themeToggle').addEventListener('click', function(){
  isLight = !isLight;
  localStorage.setItem('nw-theme', isLight ? 'light' : 'dark');
  applyTheme();
});

/* ══════════════════════════════════════════════════════════════
   TOAST
═══════════════════════════════════════════════════════════════= */
function showToast(msg, isError){
  var t = el('toast'), m = el('toastMsg');
  if(!t) return;
  t.className = isError ? 'error show' : 'show';
  t.querySelector('i').className = isError ? 'fas fa-exclamation-circle' : 'fas fa-check-circle';
  t.querySelector('i').style.color = isError ? 'var(--c-red)' : 'var(--c-green)';
  m.textContent = msg;
  clearTimeout(t._timer);
  t._timer = setTimeout(function(){ t.classList.remove('show'); }, 3400);
}

/* ══════════════════════════════════════════════════════════════
   API WRAPPER
═══════════════════════════════════════════════════════════════= */
async function api(endpoint, body){
  try {
    var res = await fetch(endpoint, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(body)
    });
    return await res.json();
  } catch(e){
    return { success: false, message: 'Network error.' };
  }
}

/* ══════════════════════════════════════════════════════════════
   SECTION / TAB NAVIGATION
═══════════════════════════════════════════════════════════════= */
function switchSection(name){
  qsa('.page-section').forEach(function(s){ s.classList.remove('active'); });
  qsa('.page-tab').forEach(function(b){ b.classList.remove('active'); b.setAttribute('aria-selected','false'); });
  qsa('.nav-item').forEach(function(n){ n.classList.remove('active'); });

  var sec = el('section-' + name);
  if(sec) sec.classList.add('active');

  qsa('.page-tab[data-section="' + name + '"]').forEach(function(b){
    b.classList.add('active'); b.setAttribute('aria-selected','true');
  });
  qsa('.nav-item[data-section="' + name + '"]').forEach(function(n){ n.classList.add('active'); });

  /* show/hide add lesson button in header (only on curriculum) */
  var addBtn = el('headerAddLesson');
  if(addBtn) addBtn.style.display = (name === 'curriculum') ? 'inline-flex' : 'none';
}

qsa('.page-tab, .nav-item').forEach(function(el){
  el.addEventListener('click', function(){
    var sec = el.dataset.section;
    if(sec) switchSection(sec);
  });
});

/* ══════════════════════════════════════════════════════════════
   MODULE ACCORDION COLLAPSE
═══════════════════════════════════════════════════════════════= */
document.addEventListener('click', function(e){
  var header = e.target.closest('.mod-header');
  if(!header) return;
  /* ignore clicks on inputs / action buttons */
  if(e.target.closest('.mod-title-input') ||
     e.target.closest('.mod-actions') ||
     e.target.closest('.mod-action-btn')) return;

  var modId    = header.dataset.modId;
  var pane     = el('lessonList' + modId);
  var chev     = header.querySelector('.mod-chev');
  var isOpen   = pane && pane.classList.contains('open');
  if(pane) pane.classList.toggle('open', !isOpen);
  if(chev) chev.classList.toggle('open', !isOpen);
});

/* ══════════════════════════════════════════════════════════════
   MODULE CRUD
═══════════════════════════════════════════════════════════════= */
function renderModuleBlock(mod){
  var div = document.createElement('div');
  div.className = 'mod-block';
  div.dataset.moduleId = mod.id;
  div.id = 'modBlock' + mod.id;
  div.innerHTML = `
    <div class="mod-header" data-mod-id="${mod.id}">
      <i class="fas fa-grip-vertical mod-drag" title="Drag to reorder"></i>
      <div class="mod-index">Module</div>
      <input class="mod-title-input" value="${escHtml(mod.title)}" placeholder="Module title…" data-mod-id="${mod.id}" aria-label="Module title"/>
      <div class="mod-actions">
        <button class="mod-action-btn save-mod-btn" data-mod-id="${mod.id}" title="Save title"><i class="fas fa-save"></i></button>
        <button class="mod-action-btn add-lesson-icon-btn" data-mod-id="${mod.id}" title="Add lesson"><i class="fas fa-plus"></i></button>
        <button class="mod-action-btn del delete-mod-btn" data-mod-id="${mod.id}" title="Delete module"><i class="fas fa-trash"></i></button>
        <i class="fas fa-chevron-down mod-chev open" aria-hidden="true"></i>
      </div>
    </div>
    <div class="sb-lessons open" id="lessonList${mod.id}">
      <div class="lesson-list" id="lessonListInner${mod.id}">
        <button class="add-lesson-btn add-lesson-row-btn" data-mod-id="${mod.id}">
          <i class="fas fa-plus"></i> Add Lesson
        </button>
      </div>
    </div>
  `;
  return div;
}

async function createModule(){
  var title = prompt('New module title:');
  if(!title || !title.trim()) return;
  var data = await api('/api/instructor/module/create', { courseId: STATE.courseId, title: title.trim() });
  if(data.success && data.module){
    STATE.modules.push({ id: data.module.id, title: data.module.title, lessons: [] });
    var list = el('moduleList');
    if(list){
      /* insert before the add-button (which is outside #moduleList) */
      list.appendChild(renderModuleBlock(data.module));
    }
    updateModuleNumbers();
    showToast('Module created!');
  } else {
    showToast(data.message || 'Failed to create module.', true);
  }
}

el('addModuleBtn')       && el('addModuleBtn').addEventListener('click', createModule);
el('addModuleBtnBottom') && el('addModuleBtnBottom').addEventListener('click', createModule);
el('navAddModule')       && el('navAddModule').addEventListener('click', function(){ switchSection('curriculum'); createModule(); });
el('headerAddLesson')    && el('headerAddLesson').addEventListener('click', function(){
  openDrawer(null, null); /* no module pre-selected */
});

/* save module title */
document.addEventListener('click', async function(e){
  var btn = e.target.closest('.save-mod-btn');
  if(!btn) return;
  var modId = btn.dataset.modId;
  var input = document.querySelector('.mod-title-input[data-mod-id="' + modId + '"]');
  if(!input) return;
  var title = input.value.trim();
  if(!title){ showToast('Title cannot be empty.', true); return; }
  var orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner spinner"></i>';
  var data = await api('/api/instructor/module/update', { moduleId: modId, title: title });
  btn.innerHTML = orig;
  if(data.success){ showToast('Module saved!'); } else { showToast(data.message || 'Failed.', true); }
});

/* add lesson from icon button in module header */
document.addEventListener('click', function(e){
  var btn = e.target.closest('.add-lesson-icon-btn');
  if(!btn) return;
  openDrawer(null, btn.dataset.modId);
});

/* delete module */
document.addEventListener('click', function(e){
  var btn = e.target.closest('.mod-action-btn.del:not(.delete-lesson-btn)') ||
            e.target.closest('.delete-mod-btn');
  if(!btn) return;
  var modId = btn.dataset.modId;
  openConfirm(
    'Delete module?',
    'All lessons inside this module will also be deleted. This cannot be undone.',
    async function(){
      var data = await api('/api/instructor/module/delete', { moduleId: modId });
      if(data.success){
        var block = el('modBlock' + modId);
        if(block) block.remove();
        STATE.modules = STATE.modules.filter(function(m){ return String(m.id) !== String(modId); });
        updateModuleNumbers();
        showToast('Module deleted.');
      } else {
        showToast(data.message || 'Failed.', true);
      }
    }
  );
});

function updateModuleNumbers(){
  var blocks = qsa('.mod-block');
  blocks.forEach(function(b, i){
    var idx = b.querySelector('.mod-index');
    if(idx) idx.textContent = 'Module ' + (i + 1);
  });
  var cnt = el('statModules');
  if(cnt) cnt.textContent = blocks.length;
}

/* ══════════════════════════════════════════════════════════════
   LESSON DRAWER OPEN/CLOSE
═══════════════════════════════════════════════════════════════= */
var _drawerCallback = null;

function openDrawer(lessonData, moduleId){
  var isEdit = !!lessonData;
  el('drawerTitle').textContent  = isEdit ? 'Edit Lesson' : 'Add Lesson';
  el('drawerLessonId').value     = isEdit ? lessonData.id : '';
  el('drawerModuleId').value     = moduleId || '';
  el('dlTitle').value            = isEdit ? lessonData.title : '';
  el('dlVideoUrl').value         = isEdit ? (lessonData.videoUrl || '') : '';
  el('dlDuration').value         = isEdit ? (lessonData.duration || '') : '';
  el('dlPublished').checked      = isEdit ? lessonData.isPublished : true;
  el('dlFree').checked           = isEdit ? lessonData.isFree : false;
  el('dlDesc').value             = '';
  updateVideoPreview(el('dlVideoUrl').value);
  el('lessonDrawer').classList.add('open');
  el('drawerOverlay').classList.add('open');
  el('dlTitle').focus();
}

function closeDrawer(){
  el('lessonDrawer').classList.remove('open');
  el('drawerOverlay').classList.remove('open');
}

el('drawerClose')  && el('drawerClose').addEventListener('click', closeDrawer);
el('drawerCancel') && el('drawerCancel').addEventListener('click', closeDrawer);
el('drawerOverlay')&& el('drawerOverlay').addEventListener('click', closeDrawer);

/* video URL live preview */
el('dlVideoUrl') && el('dlVideoUrl').addEventListener('input', function(){
  updateVideoPreview(this.value);
});
function updateVideoPreview(url){
  var strip = el('videoPreviewStrip');
  var vpUrl = el('vpUrl');
  if(!strip) return;
  if(url && url.trim()){
    strip.style.display = 'flex';
    if(vpUrl) vpUrl.textContent = url;
  } else {
    strip.style.display = 'none';
  }
}

/* ══════════════════════════════════════════════════════════════
   DRAWER SAVE (create or update lesson)
═══════════════════════════════════════════════════════════════= */
el('drawerSave') && el('drawerSave').addEventListener('click', async function(){
  var title     = el('dlTitle').value.trim();
  var videoUrl  = el('dlVideoUrl').value.trim();
  var duration  = el('dlDuration').value.trim();
  var published = el('dlPublished').checked;
  var free      = el('dlFree').checked;
  var lessonId  = el('drawerLessonId').value;
  var moduleId  = el('drawerModuleId').value;

  if(!title){ showToast('Lesson title is required.', true); el('dlTitle').focus(); return; }

  var btn = el('drawerSave');
  var orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner spinner"></i> <span>Saving…</span>';
  btn.disabled = true;

  var isEdit = !!lessonId;
  var endpoint = isEdit ? '/api/instructor/lesson/update' : '/api/instructor/lesson/create';
  var payload  = isEdit
    ? { lessonId, title, videoUrl, duration, isPublished: published, isFree: free }
    : { moduleId, title, videoUrl, duration, isPublished: published, isFree: free };

  var data = await api(endpoint, payload);
  btn.innerHTML = orig;
  btn.disabled = false;

  if(data.success){
    closeDrawer();
    showToast(isEdit ? 'Lesson updated!' : 'Lesson added!');

    if(isEdit){
      /* update UI in-place */
      var item = el('lessonItem' + lessonId);
      if(item){
        item.querySelector('.lesson-name').textContent = title;
        item.querySelector('.lesson-dur').textContent  = duration;
        var dot = item.querySelector('.lesson-status-dot:first-of-type');
        if(dot){
          dot.className = 'lesson-status-dot ' + (published ? 'pub' : 'draft');
          dot.innerHTML = '<i class="fas ' + (published ? 'fa-check' : 'fa-pen') + '"></i>';
        }
        /* update data attrs on edit btn */
        var editBtn = item.querySelector('.edit-lesson-btn');
        if(editBtn){
          editBtn.dataset.title      = title;
          editBtn.dataset.videoUrl   = videoUrl;
          editBtn.dataset.duration   = duration;
          editBtn.dataset.published  = published;
          editBtn.dataset.free       = free;
        }
      }
    } else if(data.lesson){
      /* inject new lesson row into correct module */
      insertLessonRow(data.lesson, moduleId);
      updateLessonCount();
    }
  } else {
    showToast(data.message || 'Failed to save lesson.', true);
  }
});

function insertLessonRow(lesson, moduleId){
  var inner = el('lessonListInner' + moduleId);
  if(!inner) return;
  var addBtn = inner.querySelector('.add-lesson-row-btn');
  var div = document.createElement('div');
  div.className = 'lesson-item';
  div.dataset.lessonId = lesson.id;
  div.dataset.modId    = moduleId;
  div.id = 'lessonItem' + lesson.id;
  div.innerHTML = `
    <i class="fas fa-grip-vertical lesson-drag" title="Drag to reorder"></i>
    <div class="lesson-status-dot ${lesson.isPublished ? 'pub' : 'draft'}" title="${lesson.isPublished ? 'Published' : 'Draft'}">
      <i class="fas ${lesson.isPublished ? 'fa-check' : 'fa-pen'}"></i>
    </div>
    <div class="lesson-name" title="${escHtml(lesson.title)}">${escHtml(lesson.title)}</div>
    <div class="lesson-dur">${escHtml(lesson.duration || '')}</div>
    <div class="lesson-act">
      <button class="lesson-act-btn edit-lesson-btn"
              data-lesson-id="${lesson.id}"
              data-mod-id="${moduleId}"
              data-title="${escHtml(lesson.title)}"
              data-video-url="${escHtml(lesson.videoUrl || '')}"
              data-duration="${escHtml(lesson.duration || '')}"
              data-published="${lesson.isPublished}"
              data-free="${lesson.isFree || false}"
              title="Edit lesson"><i class="fas fa-edit"></i></button>
      <button class="lesson-act-btn del delete-lesson-btn"
              data-lesson-id="${lesson.id}"
              data-title="${escHtml(lesson.title)}"
              title="Delete lesson"><i class="fas fa-trash"></i></button>
    </div>
  `;
  if(addBtn) inner.insertBefore(div, addBtn);
  else inner.appendChild(div);
}

function updateLessonCount(){
  var cnt = el('statLessons');
  if(cnt) cnt.textContent = qsa('.lesson-item').length;
}

/* ── open edit drawer from lesson row ── */
document.addEventListener('click', function(e){
  var btn = e.target.closest('.edit-lesson-btn');
  if(!btn) return;
  openDrawer({
    id:          btn.dataset.lessonId,
    title:       btn.dataset.title,
    videoUrl:    btn.dataset.videoUrl,
    duration:    btn.dataset.duration,
    isPublished: btn.dataset.published === 'true',
    isFree:      btn.dataset.free === 'true'
  }, btn.dataset.modId);
});

/* ── open add lesson from row button ── */
document.addEventListener('click', function(e){
  var btn = e.target.closest('.add-lesson-row-btn');
  if(!btn) return;
  openDrawer(null, btn.dataset.modId);
});

/* ══════════════════════════════════════════════════════════════
   DELETE LESSON
═══════════════════════════════════════════════════════════════= */
document.addEventListener('click', function(e){
  var btn = e.target.closest('.delete-lesson-btn');
  if(!btn) return;
  var lessonId = btn.dataset.lessonId;
  var title    = btn.dataset.title;
  openConfirm(
    'Delete "' + title + '"?',
    'This lesson will be permanently removed.',
    async function(){
      var data = await api('/api/instructor/lesson/delete', { lessonId: lessonId });
      if(data.success){
        var item = el('lessonItem' + lessonId);
        if(item) item.remove();
        updateLessonCount();
        showToast('Lesson deleted.');
      } else {
        showToast(data.message || 'Failed.', true);
      }
    }
  );
});

/* ══════════════════════════════════════════════════════════════
   CONFIRM MODAL
═══════════════════════════════════════════════════════════════= */
var _onConfirm = null;
function openConfirm(heading, text, onOk){
  el('confirmHeading').textContent = heading;
  el('confirmText').textContent    = text;
  _onConfirm = onOk;
  el('confirmModal').classList.add('open');
}
function closeConfirm(){
  el('confirmModal').classList.remove('open');
  _onConfirm = null;
}
el('confirmCancel') && el('confirmCancel').addEventListener('click', closeConfirm);
el('confirmModal')  && el('confirmModal').addEventListener('click', function(e){
  if(e.target === el('confirmModal')) closeConfirm();
});
el('confirmOk') && el('confirmOk').addEventListener('click', async function(){
  var btn  = el('confirmOk');
  var orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner spinner"></i> Deleting…';
  btn.disabled = true;
  if(_onConfirm) await _onConfirm();
  btn.innerHTML = orig;
  btn.disabled = false;
  closeConfirm();
});

/* ══════════════════════════════════════════════════════════════
   SAVE COURSE DETAILS
═══════════════════════════════════════════════════════════════= */
el('saveCourseDetails') && el('saveCourseDetails').addEventListener('click', async function(){
  var btn  = el('saveCourseDetails');
  var orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner spinner"></i> Saving…';
  btn.disabled = true;

  var data = await api('/api/instructor/course/update', {
    courseId:    STATE.courseId,
    title:       el('cdTitle').value.trim(),
    description: el('cdDescription').value.trim(),
    level:       el('cdLevel').value,
    slug:        el('cdSlug').value.trim()
  });

  btn.innerHTML = orig;
  btn.disabled  = false;
  if(data.success){ showToast('Course details saved!'); }
  else { showToast(data.message || 'Failed to save.', true); }
});

/* ══════════════════════════════════════════════════════════════
   SAVE SETTINGS
═══════════════════════════════════════════════════════════════= */
el('saveSettings') && el('saveSettings').addEventListener('click', async function(){
  var btn  = el('saveSettings');
  var orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner spinner"></i> Saving…';
  btn.disabled  = true;

  var data = await api('/api/instructor/course/update', {
    courseId:        STATE.courseId,
    status:          el('stPublished').checked ? 'published' : 'draft',
    allowFreePreview:el('stAllowFreePreview').checked,
    certificate:     el('stCertificate').checked,
    price:           parseFloat(el('stPrice').value) || 0,
    salePrice:       parseFloat(el('stSalePrice').value) || 0
  });

  btn.innerHTML = orig;
  btn.disabled  = false;

  if(data.success){
    var newStatus = el('stPublished').checked ? 'published' : 'draft';
    STATE.courseStatus = newStatus;
    /* sync publish button in topbar */
    var pubBtn = el('publishToggleBtn');
    if(pubBtn){
      pubBtn.innerHTML = newStatus === 'published'
        ? '<i class="fas fa-toggle-on"></i> <span>Published</span>'
        : '<i class="fas fa-toggle-off"></i> <span>Publish</span>';
    }
    /* sync pill */
    var pill = el('statusPill');
    if(pill){ pill.className = 'status-pill ' + newStatus; pill.textContent = newStatus; }
    showToast('Settings saved!');
  } else {
    showToast(data.message || 'Failed.', true);
  }
});

/* ── Topbar quick publish toggle ── */
el('publishToggleBtn') && el('publishToggleBtn').addEventListener('click', function(){
  var btn = el('stPublished');
  if(btn){ btn.checked = !btn.checked; }
  switchSection('settings');
  setTimeout(function(){ el('saveSettings') && el('saveSettings').click(); }, 80);
});

/* ── Delete course ── */
el('deleteCourseBtn') && el('deleteCourseBtn').addEventListener('click', function(){
  openConfirm(
    'Delete this entire course?',
    'ALL modules, lessons, and enrollment data will be permanently removed. Type your course title to confirm in the next step.',
    async function(){
      var data = await api('/api/instructor/course/delete', { courseId: STATE.courseId });
      if(data.success){
        showToast('Course deleted. Redirecting…');
        setTimeout(function(){ window.location.href = '/instructor/dashboard'; }, 1400);
      } else {
        showToast(data.message || 'Failed.', true);
      }
    }
  );
});

/* ══════════════════════════════════════════════════════════════
   THUMBNAIL UPLOAD PREVIEW
═══════════════════════════════════════════════════════════════= */
(function(){
  var zone  = el('thumbUploadZone');
  var input = el('thumbFileInput');
  var prev  = el('thumbPreview');
  if(!zone || !input || !prev) return;

  input.addEventListener('change', function(){
    var file = this.files[0];
    if(!file) return;
    var reader = new FileReader();
    reader.onload = function(e){
      prev.src   = e.target.result;
      prev.style.display = 'block';
      zone.querySelector('.img-upload-icon') && (zone.querySelector('.img-upload-icon').style.display = 'none');
      zone.querySelector('.img-upload-text') && (zone.querySelector('.img-upload-text').style.display = 'none');
    };
    reader.readAsDataURL(file);
  });

  zone.addEventListener('dragover', function(e){ e.preventDefault(); zone.classList.add('drag'); });
  zone.addEventListener('dragleave', function(){ zone.classList.remove('drag'); });
  zone.addEventListener('drop', function(e){
    e.preventDefault(); zone.classList.remove('drag');
    var file = e.dataTransfer.files[0];
    if(file && file.type.startsWith('image/')){
      input.files = e.dataTransfer.files;
      input.dispatchEvent(new Event('change'));
    }
  });
})();

/* ══════════════════════════════════════════════════════════════
   STUDENT SEARCH FILTER
═══════════════════════════════════════════════════════════════= */
el('studentSearch') && el('studentSearch').addEventListener('input', function(){
  var q = this.value.toLowerCase();
  qsa('#studentsTableBody tr[data-student]').forEach(function(tr){
    tr.style.display = tr.dataset.student.toLowerCase().includes(q) ? '' : 'none';
  });
});

/* ══════════════════════════════════════════════════════════════
   USER MENU DROPDOWN
═══════════════════════════════════════════════════════════════= */
(function(){
  var btn  = el('userMenuBtn');
  var drop = el('userMenuDrop');
  if(!btn || !drop) return;
  btn.addEventListener('click', function(e){
    e.stopPropagation();
    var isOpen = drop.style.opacity === '1';
    drop.style.opacity = isOpen ? '0' : '1';
    drop.style.visibility    = isOpen ? 'hidden' : 'visible';
    drop.style.pointerEvents = isOpen ? 'none' : 'auto';
    drop.style.transform     = isOpen ? 'translateY(4px)' : 'translateY(0)';
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
  document.addEventListener('click', function(){
    drop.style.opacity = '0'; drop.style.visibility = 'hidden';
    drop.style.pointerEvents = 'none'; drop.style.transform = 'translateY(4px)';
    btn.setAttribute('aria-expanded','false');
  });
})();

/* ══════════════════════════════════════════════════════════════
   KEYBOARD SHORTCUTS
═══════════════════════════════════════════════════════════════= */
document.addEventListener('keydown', function(e){
  if(e.target.tagName === 'TEXTAREA' || e.target.tagName === 'INPUT') return;
  if(e.key === 'Escape'){
    closeDrawer();
    closeConfirm();
  }
});

/* ══════════════════════════════════════════════════════════════
   UTILITY — HTML escape
═══════════════════════════════════════════════════════════════= */
function escHtml(str){
  if(!str) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ══════════════════════════════════════════════════════════════
   INIT
═══════════════════════════════════════════════════════════════= */
(function init(){
  updateModuleNumbers();
  updateLessonCount();
})();
</script>
{{> widget}}
</body>
</html>
