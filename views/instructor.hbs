          <div>
            <h3 style="font-size:.9rem;font-weight:600;margin-bottom:14px;color:var(--c-text2);color:var(--c-red)">Danger Zone</h3>
            <div style="background:var(--c-red-dim);border:1px solid rgba(239,68,68,.2);border-radius:var(--r-lg);padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
              <div>
                <div style="font-size:.85rem;font-weight:600;color:var(--c-text)">Delete this course</div>
                <div style="font-size:.76rem;color:var(--c-text3);margin-top:2px">Permanently remove this course and all its content. Cannot be undone.</div>
              </div>
              <button class="tb-btn" id="deleteCourseBtn" style="background:var(--c-red);color:#fff;border-color:var(--c-red);flex-shrink:0">
                <i class="fas fa-trash-alt"></i> Delete Course
              </button>
