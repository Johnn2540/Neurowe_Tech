<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <meta name="description" content="Share your expertise on NeurowexTech Academy. Teach thousands of learners across Kenya and beyond — set your own schedule, earn on your terms." />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<style>
/* ─── DESIGN TOKENS — identical to learn.hbs / contact.hbs ─── */
:root {
  --blue:       #1a4fd6;
  --blue-d:     #1340b0;
  --blue-l:     #4a7aee;
  --blue-pale:  rgba(26,79,214,.08);
  --blue-pale2: rgba(26,79,214,.14);
  --orange:     #e8620a;
  --orange-d:   #c94f05;
  --orange-l:   #f28840;
  --orange-pale:rgba(232,98,10,.08);
  --black:      #050810;
  --ink:        #0c1220;
  --ink-2:      #141c30;
  --ink-3:      #1c2840;
  --slate:      #5a6880;
  --slate-l:    #7a8ea8;
  --mist:       #e2e8f5;
  --ghost:      #f5f7fd;
  --emerald:    #059669;
  --teal:       #0d9488;
  --yellow:     #f59e0b;
  --rose:       #e11d48;
  --g-blue:     linear-gradient(135deg,#1a4fd6,#1340b0);
  --g-orange:   linear-gradient(135deg,#e8620a,#c94f05);
  --g-hero:     linear-gradient(168deg,#030610 0%,#07102a 50%,#0b1535 100%);
  --nav-h:      68px;
  --r-sm:10px;--r-md:14px;--r-lg:18px;--r-xl:24px;--r-2xl:32px;--r-pill:999px;
  --ease:cubic-bezier(.4,0,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);--t:.26s var(--ease);
  --sh-sm:0 1px 4px rgba(8,12,24,.06),0 4px 12px rgba(8,12,24,.06);
  --sh-md:0 4px 16px rgba(8,12,24,.08),0 12px 36px rgba(8,12,24,.08);
  --sh-lg:0 12px 40px rgba(8,12,24,.12),0 4px 12px rgba(8,12,24,.06);
  --sh-blue:0 8px 28px rgba(26,79,214,.28);
  --sh-orange:0 8px 28px rgba(232,98,10,.26);
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--ghost);color:var(--ink);overflow-x:hidden;line-height:1.65}
h1,h2,h3,h4,h5{font-family:'Fraunces',serif;line-height:1.1;letter-spacing:-.02em}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
button,input,textarea,select{font-family:'Plus Jakarta Sans',sans-serif}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:var(--ink)}::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}

/* SCROLL PROGRESS */
#scroll-progress{position:fixed;top:0;left:0;height:2px;width:0%;background:linear-gradient(90deg,var(--blue),var(--orange));z-index:9999;transition:width .08s linear}

/* ─── NAVBAR ─── */
.navbar{position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);background:rgba(255,255,255,.96);backdrop-filter:blur(24px) saturate(2);border-bottom:1px solid rgba(8,12,24,.06);transition:var(--t)}
.navbar.scrolled{box-shadow:0 2px 24px rgba(8,12,24,.07)}
.nav-inner{max-width:1320px;margin:0 auto;padding:0 24px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}
.nav-brand{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:7px;flex-shrink:0;letter-spacing:-.04em}
.brand-mark{width:30px;height:30px;background:var(--g-blue);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:.85rem;color:#fff;flex-shrink:0}
.nav-brand em{font-style:italic;color:var(--orange)}
.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-a{font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 12px;border-radius:var(--r-sm);transition:var(--t);display:inline-flex;align-items:center;gap:5px}
.nl-a:hover,.nl-a.active{color:var(--blue);background:var(--blue-pale)}
.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}
.btn-nav-signin{font-size:.79rem;font-weight:600;color:var(--slate);padding:7px 15px;border:1.5px solid var(--mist);border-radius:var(--r-pill);background:#fff;cursor:pointer;transition:var(--t)}
.btn-nav-signin:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-start{font-size:.79rem;font-weight:700;color:#fff;padding:8px 19px;border:none;border-radius:var(--r-pill);background:var(--g-blue);cursor:pointer;box-shadow:var(--sh-blue);display:inline-flex;align-items:center;gap:5px;transition:var(--t)}
.btn-nav-start:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(26,79,214,.36)}
.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:44px;height:44px;background:none;border:none;cursor:pointer;border-radius:var(--r-sm);transition:var(--t);flex-shrink:0}
.ham-btn:hover{background:var(--blue-pale)}
.ham-line{display:block;width:20px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .24s var(--ease);transform-origin:center}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:38px;height:38px;border-radius:var(--r-sm);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:var(--t);background:var(--blue-pale);color:var(--blue)}
.mob-overlay{position:fixed;inset:0;background:rgba(8,12,24,.55);backdrop-filter:blur(6px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .28s,visibility .28s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(340px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-12px 0 48px rgba(8,12,24,.18);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.82rem}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:11px;padding:12px 22px;font-size:.88rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px}
.mob-link i{width:18px;color:var(--blue);font-size:.8rem;flex-shrink:0}
.mob-link:hover,.mob-link.cur{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 18px}
.mob-footer{padding:14px 18px 30px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:9px}

/* DARK */
body.dark{background:var(--black);color:rgba(255,255,255,.84)}
body.dark .navbar{background:rgba(8,12,24,.97);border-bottom-color:rgba(255,255,255,.05)}
body.dark .navbar.scrolled{background:rgba(8,12,24,.99)}
body.dark .nl-a{color:rgba(255,255,255,.52)}
body.dark .nl-a:hover{color:var(--blue-l);background:rgba(26,79,214,.1)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:var(--ink-2)}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link{color:rgba(255,255,255,.82)}
body.dark .mob-close{background:rgba(255,255,255,.07);color:rgba(255,255,255,.7)}
body.dark .mob-hr{border-color:rgba(255,255,255,.07)}
body.dark .mob-footer{border-color:rgba(255,255,255,.07)}
body.dark .btn-nav-signin{color:rgba(255,255,255,.52);border-color:rgba(255,255,255,.1);background:transparent}
body.dark #theme-toggle{background:var(--ink-2);border-color:rgba(255,255,255,.09)}
body.dark #theme-toggle svg{stroke:rgba(255,255,255,.72)}
body.dark .card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .f-input{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:rgba(255,255,255,.85)}
body.dark .f-input::placeholder{color:rgba(255,255,255,.26)}
body.dark .f-input:focus{background:rgba(255,255,255,.08);border-color:var(--blue-l)}
body.dark select.f-input option{background:var(--ink-2)}
body.dark .faq-item{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .faq-q{color:rgba(255,255,255,.85)}
body.dark .step-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .benefit-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .stat-strip{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .calc-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .or-div::before,body.dark .or-div::after{background:rgba(255,255,255,.07)}

/* UTILS */
.container{max-width:1200px;margin:0 auto;padding:0 24px}
.section-py{padding:80px 0}
.section-py-sm{padding:56px 0}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-orange{background:var(--g-orange);-webkit-background-clip:text;background-clip:text;color:transparent}
.text-center{text-align:center}
.section-kicker{display:inline-flex;align-items:center;gap:6px;border-radius:var(--r-pill);padding:5px 14px;font-size:.67rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;margin-bottom:14px;border:1px solid rgba(26,79,214,.15);background:var(--blue-pale);color:var(--blue)}
.section-kicker::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue);flex-shrink:0}
.section-kicker.orange{background:var(--orange-pale);color:var(--orange);border-color:rgba(232,98,10,.15)}
.section-kicker.orange::before{background:var(--orange)}
.section-kicker.teal{background:rgba(13,148,136,.08);color:var(--teal);border-color:rgba(13,148,136,.15)}
.section-kicker.teal::before{background:var(--teal)}

/* FIXED WIDGETS */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:44px;height:44px;background:#fff;border:1.5px solid rgba(8,12,24,.08);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 18px rgba(8,12,24,.1);transition:var(--t)}
#theme-toggle svg{width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(20deg) scale(1.07)}
#theme-toggle:hover svg{stroke:#fff}
#back-to-top{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(16px);z-index:10000;width:48px;height:48px;background:var(--g-blue);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .3s,transform .4s var(--spring);box-shadow:var(--sh-blue)}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto}
#back-to-top svg{width:18px;height:18px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
#wa-float{position:fixed;bottom:86px;right:20px;z-index:10001;text-decoration:none;display:block}
.wa-ring{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-r 2.8s ease-out infinite;pointer-events:none}
.wa-ring:nth-child(2){animation-delay:1.2s}
@keyframes wa-r{0%{transform:scale(1);opacity:.6}100%{transform:scale(1.95);opacity:0}}
.wa-pill{display:flex;align-items:center;gap:9px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:8px 17px 8px 8px;box-shadow:0 6px 26px rgba(18,140,126,.42);transition:transform .3s var(--spring),box-shadow .28s;white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-3px) scale(1.02)}
.wa-ico{width:36px;height:36px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.15rem;color:#fff;position:relative}
.wa-dot{position:absolute;top:1px;right:1px;width:9px;height:9px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dp 2.4s ease-in-out infinite}
@keyframes dp{0%,100%{transform:scale(1)}50%{transform:scale(1.45);opacity:.5}}
.wa-text{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.64rem;color:rgba(255,255,255,.55);font-weight:600}
.wa-cta{font-size:.88rem;color:#fff;font-weight:800;font-family:'Fraunces',serif}
.wa-arr{color:rgba(255,255,255,.6);font-size:.68rem;margin-left:2px;transition:transform .2s}
#wa-float:hover .wa-arr{transform:translateX(3px)}
@media(max-width:767px){
  #wa-float{bottom:74px;right:14px}
  .wa-text,.wa-arr{display:none}
  .wa-pill{padding:0;width:52px;height:52px;border-radius:50%;justify-content:center}
  .wa-ico{width:52px;height:52px;font-size:1.4rem}
  #theme-toggle{bottom:14px;left:14px;width:40px;height:40px}
  #back-to-top{bottom:12px;width:46px;height:46px}
}
#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-md);padding:11px 17px;font-size:.82rem;display:flex;align-items:center;gap:8px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:210px;max-width:calc(100vw - 40px)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.err{border-left-color:#ef4444}
#cookie-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.8);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;z-index:9998;transform:translateY(100%);transition:transform .38s;border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap}
#cookie-bar.show{transform:translateY(0)}
#cookie-bar p{font-size:.77rem;margin:0;flex:1;min-width:180px}
#cookie-accept{background:var(--blue);color:#fff;border:none;padding:7px 18px;border-radius:var(--r-pill);font-size:.79rem;cursor:pointer;font-weight:700;transition:var(--t)}

/* ─── HERO ─── */
.page-hero{background:var(--g-hero);padding-top:var(--nav-h);position:relative;overflow:hidden}
.page-hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(26,79,214,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(26,79,214,.05) 1px,transparent 1px);background-size:44px 44px}
.hero-orb{position:absolute;border-radius:50%;pointer-events:none}
.hero-orb-1{width:560px;height:560px;background:radial-gradient(circle,rgba(26,79,214,.2) 0%,transparent 68%);top:-160px;right:-100px}
.hero-orb-2{width:340px;height:340px;background:radial-gradient(circle,rgba(232,98,10,.12) 0%,transparent 70%);bottom:-80px;left:-30px}
.hero-inner{position:relative;z-index:1;padding:72px 0 80px;display:grid;grid-template-columns:1fr;gap:48px}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-pill);padding:6px 15px;color:rgba(255,255,255,.75);font-size:.73rem;font-weight:700;margin-bottom:18px;backdrop-filter:blur(8px)}
.hero-badge .dot{width:6px;height:6px;border-radius:50%;background:#34d399;animation:dp 2s infinite;flex-shrink:0}
.hero-inner h1{font-size:clamp(2.2rem,6vw,4rem);font-weight:700;color:#fff;margin-bottom:16px;line-height:1.06}
.hero-inner h1 em{font-style:italic;color:var(--orange-l)}
.hero-inner p{color:rgba(255,255,255,.55);font-size:clamp(.9rem,2.5vw,1.06rem);line-height:1.78;max-width:520px;margin-bottom:32px}
.hero-pills{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:32px}
.hero-pill{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.11);border-radius:var(--r-pill);padding:6px 14px;font-size:.75rem;font-weight:600;color:rgba(255,255,255,.72);backdrop-filter:blur(6px)}
.hero-pill i{font-size:.72rem}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap}

/* hero stat cards */
.hero-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.h-stat{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:var(--r-lg);padding:20px 16px;text-align:center;backdrop-filter:blur(8px)}
.h-stat-num{font-family:'Fraunces',serif;font-size:clamp(1.7rem,5vw,2.4rem);font-weight:700;color:#fff;line-height:1;margin-bottom:5px}
.h-stat-label{font-size:.72rem;color:rgba(255,255,255,.5);font-weight:600}

/* ─── BUTTONS ─── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.87rem;border-radius:var(--r-pill);transition:var(--t);cursor:pointer;border:none;letter-spacing:.01em;white-space:nowrap}
.btn-primary{background:var(--g-blue);color:#fff;padding:13px 28px;box-shadow:var(--sh-blue)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(26,79,214,.38)}
.btn-primary:disabled{opacity:.6;cursor:not-allowed;transform:none}
.btn-orange{background:var(--g-orange);color:#fff;padding:13px 28px;box-shadow:var(--sh-orange)}
.btn-orange:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(232,98,10,.38)}
.btn-outline{background:transparent;color:var(--blue);padding:11px 24px;border:1.5px solid var(--blue)}
.btn-outline:hover{background:var(--g-blue);color:#fff;transform:translateY(-2px)}
.btn-ghost{background:rgba(255,255,255,.1);color:#fff;padding:12px 24px;border:1.5px solid rgba(255,255,255,.25);backdrop-filter:blur(8px)}
.btn-ghost:hover{background:rgba(255,255,255,.18);transform:translateY(-2px)}
.btn-lg{padding:15px 34px;font-size:.95rem}

/* ─── STAT STRIP ─── */
.stat-strip{background:#fff;border-top:1px solid var(--mist);border-bottom:1px solid var(--mist);padding:22px 0}
.stat-strip-inner{display:flex;flex-wrap:wrap;justify-content:center;gap:16px 40px}
.ss-item{display:flex;align-items:center;gap:9px}
.ss-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.88rem;flex-shrink:0}
.ss-icon.b{background:var(--blue-pale);color:var(--blue)}
.ss-icon.o{background:var(--orange-pale);color:var(--orange)}
.ss-icon.g{background:rgba(5,150,105,.1);color:var(--emerald)}
.ss-icon.t{background:rgba(13,148,136,.08);color:var(--teal)}
.ss-val{font-family:'Fraunces',serif;font-size:1.22rem;font-weight:700;color:var(--ink);line-height:1}
.ss-label{font-size:.7rem;color:var(--slate);font-weight:600}

/* ─── BENEFITS ─── */
.benefits-grid{display:grid;grid-template-columns:1fr;gap:18px}
.benefit-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);padding:26px 22px;transition:var(--t);box-shadow:var(--sh-sm);position:relative;overflow:hidden}
.benefit-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2.5px;transform:scaleX(0);transform-origin:left;transition:transform .36s}
.benefit-card:hover::before{transform:scaleX(1)}
.benefit-card.c-b::before{background:linear-gradient(90deg,var(--blue),var(--blue-l))}
.benefit-card.c-o::before{background:var(--g-orange)}
.benefit-card.c-g::before{background:linear-gradient(90deg,var(--emerald),#34d399)}
.benefit-card.c-t::before{background:linear-gradient(90deg,var(--teal),#5eead4)}
.benefit-card.c-p::before{background:linear-gradient(90deg,#8b5cf6,#c084fc)}
.benefit-card.c-y::before{background:linear-gradient(90deg,var(--yellow),#fcd34d)}
.benefit-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.benefit-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;margin-bottom:14px;flex-shrink:0}
.c-b .benefit-icon{background:var(--blue-pale);color:var(--blue)}
.c-o .benefit-icon{background:var(--orange-pale);color:var(--orange)}
.c-g .benefit-icon{background:rgba(5,150,105,.1);color:var(--emerald)}
.c-t .benefit-icon{background:rgba(13,148,136,.08);color:var(--teal)}
.c-p .benefit-icon{background:rgba(139,92,246,.1);color:#8b5cf6}
.c-y .benefit-icon{background:rgba(245,158,11,.1);color:var(--yellow)}
.benefit-card h4{font-size:1rem;font-weight:700;margin-bottom:7px;font-family:'Plus Jakarta Sans',sans-serif}
.benefit-card p{font-size:.81rem;color:var(--slate);line-height:1.66}

/* ─── HOW IT WORKS ─── */
.steps-wrap{display:grid;grid-template-columns:1fr;gap:0}
.step-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);padding:28px 24px;box-shadow:var(--sh-sm);position:relative;display:flex;gap:20px;align-items:flex-start}
.step-card + .step-card{margin-top:14px}
.step-num{width:44px;height:44px;min-width:44px;border-radius:50%;background:var(--g-blue);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:1.1rem;color:#fff;box-shadow:var(--sh-blue);flex-shrink:0}
.step-num.o{background:var(--g-orange);box-shadow:var(--sh-orange)}
.step-num.g{background:linear-gradient(135deg,var(--emerald),#10b981);box-shadow:0 6px 18px rgba(5,150,105,.28)}
.step-card h4{font-size:1.02rem;font-weight:700;margin-bottom:6px;font-family:'Plus Jakarta Sans',sans-serif}
.step-card p{font-size:.81rem;color:var(--slate);line-height:1.66}

/* ─── EARNINGS CALCULATOR ─── */
.calc-card{background:#fff;border-radius:var(--r-2xl);border:1px solid var(--mist);box-shadow:var(--sh-md);overflow:hidden}
.calc-top{background:linear-gradient(135deg,var(--blue),var(--blue-d));padding:28px 32px;position:relative;overflow:hidden}
.calc-top::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:32px 32px}
.calc-top h3{position:relative;z-index:1;font-size:1.25rem;font-weight:700;color:#fff;margin-bottom:4px}
.calc-top p{position:relative;z-index:1;font-size:.81rem;color:rgba(255,255,255,.6)}
.calc-body{padding:28px 32px;display:grid;grid-template-columns:1fr;gap:20px}
.calc-label{font-size:.75rem;font-weight:700;color:var(--slate);text-transform:uppercase;letter-spacing:.6px;display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.calc-label span{font-size:.88rem;font-weight:800;color:var(--blue);text-transform:none;letter-spacing:0}
.calc-range{-webkit-appearance:none;appearance:none;width:100%;height:5px;border-radius:3px;background:var(--mist);outline:none;cursor:pointer}
.calc-range::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--blue);cursor:pointer;box-shadow:0 2px 8px rgba(26,79,214,.3)}
.calc-range::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:var(--blue);cursor:pointer;border:none}
.calc-results{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;background:var(--ghost);border-radius:var(--r-lg);padding:20px}
.calc-result-item{text-align:center}
.calc-result-val{font-family:'Fraunces',serif;font-size:1.45rem;font-weight:700;color:var(--emerald);margin-bottom:3px}
.calc-result-label{font-size:.7rem;color:var(--slate);font-weight:600}
.calc-note{font-size:.71rem;color:var(--slate-l);text-align:center;margin-top:4px}

/* ─── APPLICATION FORM ─── */
.form-section{background:linear-gradient(135deg,#edf1ff,#f0fdf4);padding:80px 0}
body.dark .form-section{background:linear-gradient(135deg,var(--ink),var(--ink-2))}
.form-card{background:#fff;border-radius:var(--r-2xl);border:1px solid var(--mist);box-shadow:var(--sh-md);overflow:hidden;max-width:720px;margin:0 auto}
.form-top{padding:32px 36px 24px;border-bottom:1px solid var(--mist);position:relative}
.form-top::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--orange))}
.form-top h2{font-size:1.45rem;font-weight:700;margin-bottom:5px}
.form-top p{font-size:.82rem;color:var(--slate);line-height:1.6}
.form-body{padding:32px 36px 36px}
.f-label{font-size:.77rem;font-weight:700;color:var(--slate);display:block;margin-bottom:6px}
.f-label .req{color:var(--rose)}
.field-wrap{position:relative}
.field-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--slate-l);font-size:.8rem;pointer-events:none;transition:color .2s}
.field-wrap:focus-within .field-icon{color:var(--blue)}
.textarea-wrap .field-icon{top:14px;transform:none}
.f-input{width:100%;background:var(--ghost);border:1.5px solid var(--mist);border-radius:var(--r-md);color:var(--ink);padding:11px 14px;font-size:15px;transition:var(--t);outline:none;-webkit-appearance:none}
.f-input.has-icon{padding-left:38px}
.f-input:focus{background:#fff;border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,79,214,.08)}
.f-input.error{border-color:var(--rose);box-shadow:0 0 0 3px rgba(225,29,72,.08)}
.f-input::placeholder{color:var(--slate-l)}
textarea.f-input{resize:vertical;min-height:110px}
select.f-input{cursor:pointer}
.f-error{font-size:.7rem;color:var(--rose);margin-top:4px;display:none;align-items:center;gap:4px}
.f-input.error~.f-error{display:flex}
.row2{display:grid;grid-template-columns:1fr;gap:16px}
.fg{display:flex;flex-direction:column;gap:0}
.mt16{margin-top:16px}
.mt24{margin-top:24px}

/* checkboxes for expertise areas */
.expertise-wrap{display:flex;flex-wrap:wrap;gap:7px}
.exp-chk{display:none}
.exp-tag{display:inline-flex;align-items:center;gap:5px;background:#fff;border:1.5px solid var(--mist);color:var(--slate);border-radius:var(--r-pill);padding:6px 13px;font-size:.76rem;font-weight:600;transition:var(--t);cursor:pointer;user-select:none}
.exp-tag i{font-size:.7rem}
.exp-tag:hover{border-color:var(--blue);color:var(--blue)}
.exp-chk:checked+.exp-tag{background:var(--g-blue);border-color:transparent;color:#fff;box-shadow:var(--sh-blue)}

/* agreement */
.agree-row{display:flex;align-items:flex-start;gap:9px;background:var(--blue-pale);border:1px solid rgba(26,79,214,.14);border-radius:var(--r-md);padding:13px 14px;margin-top:20px;cursor:pointer}
.agree-row input[type="checkbox"]{width:16px;height:16px;flex-shrink:0;margin-top:1px;accent-color:var(--blue);cursor:pointer}
.agree-row label{font-size:.78rem;color:var(--slate);line-height:1.58;cursor:pointer}
.agree-row label strong{color:var(--ink)}

@keyframes spin{to{transform:rotate(360deg)}}
.spinner{display:none;width:17px;height:17px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
.btn-submit{width:100%;padding:14px;font-size:.92rem;border-radius:var(--r-lg);margin-top:24px}
.btn-submit.loading .btn-txt{display:none}
.btn-submit.loading .spinner{display:block}

/* success */
@keyframes scale-in{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
@keyframes check-draw{to{stroke-dashoffset:0}}
.form-success{display:none;padding:52px 36px;text-align:center;animation:scale-in .45s cubic-bezier(.34,1.56,.64,1) both}
.success-circle{width:72px;height:72px;background:linear-gradient(135deg,var(--emerald),#10b981);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;box-shadow:0 8px 28px rgba(5,150,105,.28)}
.success-circle svg{width:36px;height:36px}
.check-path{stroke-dasharray:34;stroke-dashoffset:34;animation:check-draw .5s .28s ease forwards}
.form-success h3{font-size:1.5rem;font-weight:700;margin-bottom:8px}
.form-success p{font-size:.85rem;color:var(--slate);line-height:1.72;max-width:380px;margin:0 auto 24px}

/* ─── INSTRUCTOR TESTIMONIALS ─── */
.instructor-quotes{display:grid;grid-template-columns:1fr;gap:16px}
.iq-card{background:#fff;border-radius:var(--r-xl);padding:26px 22px;border:1px solid var(--mist);box-shadow:var(--sh-sm);transition:var(--t);position:relative;overflow:hidden}
.iq-card::before{content:'"';position:absolute;top:-10px;left:16px;font-family:'Fraunces',serif;font-size:7rem;color:var(--blue-pale);line-height:1;pointer-events:none}
.iq-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.iq-stars{color:var(--yellow);letter-spacing:1px;margin-bottom:10px;font-size:.9rem}
.iq-quote{font-style:italic;color:var(--slate);line-height:1.78;font-size:.84rem;margin-bottom:16px;position:relative;z-index:1}
.iq-author{display:flex;align-items:center;gap:11px}
.iq-ava{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;background:var(--g-blue);font-weight:700;color:#fff}
.iq-name{font-weight:700;font-size:.84rem;font-family:'Fraunces',serif}
.iq-role{font-size:.7rem;color:var(--slate)}
.iq-earnings{display:inline-flex;align-items:center;gap:5px;background:rgba(5,150,105,.09);color:var(--emerald);border:1px solid rgba(5,150,105,.2);border-radius:var(--r-pill);padding:3px 10px;font-size:.68rem;font-weight:800;margin-top:8px}

/* ─── FAQ ─── */
.faq-item{background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);overflow:hidden;transition:border-color .22s;box-shadow:var(--sh-sm)}
.faq-item:hover{border-color:var(--blue)}
.faq-item.open{border-color:var(--blue-l)}
.faq-q{padding:15px 18px;font-weight:700;font-size:.86rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'Plus Jakarta Sans',sans-serif;min-height:52px;gap:12px}
.faq-icon{width:20px;height:20px;flex-shrink:0;background:var(--blue-pale);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:.62rem;transition:transform .24s,background .22s}
.faq-item.open .faq-icon{transform:rotate(45deg);background:var(--blue);color:#fff}
.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;color:var(--slate);font-size:.82rem;line-height:1.76}
.faq-item.open .faq-a{max-height:220px;padding:0 18px 15px}

/* ─── FOOTER ─── */
@keyframes bar-shift{0%{background-position:0%}100%{background-position:200%}}
@keyframes dot-p{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.45);opacity:.5}}
footer{background:#050810;color:rgba(255,255,255,.48);font-size:.82rem;border-top:1px solid rgba(255,255,255,.05)}
.footer-bar{height:2px;background:linear-gradient(90deg,#1a4fd6,#e8620a,#1a4fd6);background-size:200% 100%;animation:bar-shift 6s linear infinite}
.footer-cta-strip{background:linear-gradient(135deg,#0c1630,#101f40);border-bottom:1px solid rgba(255,255,255,.05);padding:30px 0}
.footer-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
.footer-cta-text h4{font-family:'Fraunces',serif;font-size:clamp(.98rem,2.8vw,1.35rem);font-weight:700;color:#fff;margin-bottom:3px;line-height:1.2}
.footer-cta-text p{font-size:.76rem;color:rgba(255,255,255,.36);margin:0}
.footer-cta-btns{display:flex;gap:9px;flex-wrap:wrap;flex-shrink:0}
.footer-body{padding:52px 0 36px}
.footer-cols{display:grid;grid-template-columns:2fr 1fr 1fr 1.6fr;gap:34px 28px}
.footer-brand-name{font-family:'Fraunces',serif;font-size:1.14rem;font-weight:700;color:#fff;letter-spacing:-.04em;display:flex;align-items:center;gap:7px;margin-bottom:9px}
.footer-brand-name em{font-style:italic;color:#e8620a}
.footer-bmark{width:27px;height:27px;background:var(--g-blue);border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:.8rem;color:#fff;flex-shrink:0}
.footer-tagline{font-size:.77rem;color:rgba(255,255,255,.34);line-height:1.74;max-width:270px;margin-bottom:16px}
.footer-socials{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px}
.fsoc{width:32px;height:32px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);color:rgba(255,255,255,.48);font-size:.78rem;transition:all .2s;text-decoration:none}
.fsoc:hover{transform:translateY(-2px)}
.fsoc.tw:hover{background:#1da1f2;color:#fff}
.fsoc.li:hover{background:#0077b5;color:#fff}
.fsoc.gh:hover{background:#fff;color:#111}
.fsoc.ig:hover{background:linear-gradient(135deg,#fd5949,#d6249f,#285aeb);color:#fff}
.fsoc.yt:hover{background:#ff0000;color:#fff}
.fsoc.wa:hover{background:#25D366;color:#fff}
.footer-col-title{font-size:.62rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:rgba(255,255,255,.26);margin-bottom:14px;display:flex;align-items:center;gap:6px}
.footer-col-title::before{content:'';width:10px;height:1.5px;background:var(--blue);border-radius:2px;flex-shrink:0}
.footer-links{list-style:none;padding:0;margin:0}
.footer-links li{margin-bottom:9px}
.footer-links a{color:rgba(255,255,255,.4);text-decoration:none;font-size:.77rem;transition:color .18s,padding-left .18s;display:inline-flex;align-items:center;gap:5px}
.footer-links a:hover{color:#fff;padding-left:3px}
.footer-links a i{width:12px;font-size:.66rem;opacity:.5}
.footer-links a.acad{color:#5eead4;font-weight:600}
.fci{display:flex;align-items:flex-start;gap:9px;margin-bottom:12px}
.fci-ic{width:28px;height:28px;flex-shrink:0;background:rgba(26,79,214,.12);border-radius:7px;display:flex;align-items:center;justify-content:center;color:var(--blue-l);font-size:.68rem;margin-top:1px}
.fci-label{font-size:.58rem;color:rgba(255,255,255,.22);font-weight:800;letter-spacing:.7px;text-transform:uppercase}
.fci-val{font-size:.77rem;color:rgba(255,255,255,.58)}
.fci-val a{color:rgba(255,255,255,.58);text-decoration:none;transition:color .18s}
.fci-val a:hover{color:var(--orange-l)}
.footer-hours{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.05);border-radius:7px;padding:6px 10px;font-size:.69rem;color:rgba(255,255,255,.36);margin-top:3px}
.hdot{width:6px;height:6px;background:#34d399;border-radius:50%;animation:dot-p 2.4s ease-in-out infinite;flex-shrink:0}
.footer-divider{border:none;border-top:1px solid rgba(255,255,255,.05)}
.footer-bottom{padding:16px 0}
.footer-bottom-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.footer-copy{font-size:.7rem;color:rgba(255,255,255,.2)}
.footer-legal{display:flex;gap:18px;flex-wrap:wrap}
.footer-legal a{font-size:.69rem;color:rgba(255,255,255,.24);text-decoration:none;transition:color .18s}
.footer-legal a:hover{color:rgba(255,255,255,.6)}
.footer-made{font-size:.69rem;color:rgba(255,255,255,.18);display:flex;align-items:center;gap:3px}
.footer-made span{color:var(--orange-l)}

/* RESPONSIVE */
@media(min-width:600px){
  .container{padding:0 28px}
  .row2{grid-template-columns:1fr 1fr}
  .hero-stats{grid-template-columns:repeat(4,1fr)}
  .benefits-grid{grid-template-columns:repeat(2,1fr)}
  .instructor-quotes{grid-template-columns:repeat(2,1fr)}
}
@media(min-width:992px){
  :root{--nav-h:72px}
  .container{padding:0 32px}
  .nav-inner{padding:0 32px}
  .nav-links{display:flex}
  .nav-cta{display:flex}
  .ham-btn{display:none!important}
  .mob-quick{display:none!important}
  .hero-inner{grid-template-columns:1fr 420px;gap:60px;align-items:center}
  .benefits-grid{grid-template-columns:repeat(3,1fr)}
  .instructor-quotes{grid-template-columns:repeat(3,1fr)}
  .calc-body{grid-template-columns:1fr 1fr;gap:28px;align-items:start}
}
@media(max-width:539px){
  .footer-cols{grid-template-columns:1fr 1fr;gap:22px 14px}
  .footer-col-brand,.footer-col-contact{grid-column:1/-1}
  .footer-cta-inner{flex-direction:column;align-items:flex-start}
  .footer-cta-btns{width:100%}
  .footer-cta-btns a{flex:1;justify-content:center}
  .footer-bottom-inner{flex-direction:column;align-items:center;text-align:center;gap:8px}
  .footer-legal{justify-content:center;gap:10px}
  .form-top,.form-body{padding-left:18px;padding-right:18px}
}
@media(max-width:1023px){
  .footer-cols{grid-template-columns:1fr 1fr;gap:26px 22px}
  .footer-col-brand{grid-column:1/-1}
}
@media print{.navbar,#wa-float,#theme-toggle,#back-to-top,#scroll-progress,#cookie-bar{display:none!important}}
</style>
