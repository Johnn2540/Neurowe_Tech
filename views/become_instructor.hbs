<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}} | Teach on NeurowexTech Academy</title>
  <meta name="description" content="Share your expertise. Earn up to 70% revenue share. Reach thousands of learners across Kenya and beyond — apply to become an instructor today." />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<style>
:root {
  --blue:#1a4fd6;--blue-d:#1340b0;--blue-l:#4a7aee;
  --blue-pale:rgba(26,79,214,.08);--blue-pale2:rgba(26,79,214,.14);
  --orange:#e8620a;--orange-d:#c94f05;--orange-l:#f28840;
  --orange-pale:rgba(232,98,10,.08);
  --black:#050810;--ink:#0c1220;--ink-2:#141c30;--ink-3:#1c2840;
  --slate:#5a6880;--slate-l:#7a8ea8;
  --mist:#e2e8f5;--ghost:#f5f7fd;--white:#fff;
  --emerald:#059669;--teal:#0d9488;--yellow:#f59e0b;--rose:#e11d48;
  --g-blue:linear-gradient(135deg,#1a4fd6,#1340b0);
  --g-orange:linear-gradient(135deg,#e8620a,#c94f05);
  --g-hero:linear-gradient(168deg,#030610 0%,#07102a 50%,#0b1535 100%);
  --nav-h:68px;
  --r-sm:10px;--r-md:14px;--r-lg:18px;--r-xl:24px;--r-2xl:32px;--r-pill:999px;
  --ease:cubic-bezier(.4,0,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);--t:.24s var(--ease);
  --sh-sm:0 1px 4px rgba(8,12,24,.06),0 4px 12px rgba(8,12,24,.06);
  --sh-md:0 4px 16px rgba(8,12,24,.08),0 12px 36px rgba(8,12,24,.08);
  --sh-lg:0 12px 40px rgba(8,12,24,.12),0 4px 12px rgba(8,12,24,.06);
  --sh-blue:0 8px 28px rgba(26,79,214,.28);
  --sh-orange:0 8px 28px rgba(232,98,10,.26);
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--ghost);color:var(--ink);overflow-x:hidden;line-height:1.65;font-size:16px}
h1,h2,h3,h4,h5{font-family:'Fraunces',serif;line-height:1.1;letter-spacing:-.02em}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
button,input,textarea,select{font-family:'Plus Jakarta Sans',sans-serif}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--ink)}
::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}

/* SCROLL PROGRESS */
#scroll-progress{position:fixed;top:0;left:0;height:2px;width:0%;background:linear-gradient(90deg,var(--blue),var(--orange));z-index:9999;transition:width .08s linear}

/* ── NAVBAR ── */
.navbar{position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);background:rgba(255,255,255,.97);backdrop-filter:blur(24px) saturate(2);border-bottom:1px solid rgba(8,12,24,.06);transition:var(--t)}
.navbar.scrolled{box-shadow:0 2px 20px rgba(8,12,24,.07)}
.nav-inner{max-width:1280px;margin:0 auto;padding:0 24px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}
.nav-brand{font-family:'Fraunces',serif;font-size:1.18rem;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:7px;flex-shrink:0;letter-spacing:-.04em}
.brand-mark{width:30px;height:30px;background:var(--g-blue);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:.85rem;color:#fff;flex-shrink:0}
.nav-brand em{font-style:italic;color:var(--orange)}
.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-a{font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 12px;border-radius:var(--r-sm);transition:var(--t);display:inline-flex;align-items:center;gap:5px}
.nl-a:hover,.nl-a.active{color:var(--blue);background:var(--blue-pale)}
.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}
.btn-nav-ghost{font-size:.79rem;font-weight:600;color:var(--slate);padding:7px 15px;border:1.5px solid var(--mist);border-radius:var(--r-pill);background:#fff;cursor:pointer;transition:var(--t);display:inline-flex;align-items:center;gap:5px}
.btn-nav-ghost:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-cta{font-size:.79rem;font-weight:700;color:#fff;padding:8px 20px;border:none;border-radius:var(--r-pill);background:var(--g-orange);cursor:pointer;box-shadow:var(--sh-orange);display:inline-flex;align-items:center;gap:5px;transition:var(--t)}
.btn-nav-cta:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(232,98,10,.38)}
.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:44px;height:44px;background:none;border:none;cursor:pointer;border-radius:var(--r-sm);transition:var(--t);flex-shrink:0}
.ham-btn:hover{background:var(--blue-pale)}
.ham-line{display:block;width:20px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .24s var(--ease);transform-origin:center}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:38px;height:38px;border-radius:var(--r-sm);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:var(--t);background:var(--blue-pale);color:var(--blue)}

/* Mobile panel */
.mob-overlay{position:fixed;inset:0;background:rgba(8,12,24,.55);backdrop-filter:blur(6px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .28s,visibility .28s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(340px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-12px 0 48px rgba(8,12,24,.18);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.82rem}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:11px;padding:12px 22px;font-size:.88rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px}
.mob-link i{width:18px;color:var(--blue);font-size:.8rem;flex-shrink:0}
.mob-link:hover,.mob-link.cur{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 18px}
.mob-footer{padding:14px 18px 30px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:9px}

/* DARK MODE */
body.dark{background:var(--black);color:rgba(255,255,255,.84)}
body.dark .navbar{background:rgba(8,12,24,.97);border-bottom-color:rgba(255,255,255,.05)}
body.dark .nl-a{color:rgba(255,255,255,.52)}
body.dark .nl-a:hover{color:var(--blue-l);background:rgba(26,79,214,.1)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:var(--ink-2)}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link{color:rgba(255,255,255,.82)}
body.dark .mob-close{background:rgba(255,255,255,.07);color:rgba(255,255,255,.7)}
body.dark .mob-hr{border-color:rgba(255,255,255,.07)}
body.dark .mob-footer{border-color:rgba(255,255,255,.07)}
body.dark .btn-nav-ghost{color:rgba(255,255,255,.52);border-color:rgba(255,255,255,.1);background:transparent}
body.dark #theme-toggle{background:var(--ink-2);border-color:rgba(255,255,255,.09)}
body.dark #theme-toggle svg{stroke:rgba(255,255,255,.72)}
body.dark .benefit-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .step-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .calc-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .calc-results{background:var(--ink-3)}
body.dark .calc-range{background:var(--ink-3)}
body.dark .faq-item{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .faq-q{color:rgba(255,255,255,.85)}
body.dark .form-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .form-top{border-bottom-color:rgba(255,255,255,.07)}
body.dark .f-input{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:rgba(255,255,255,.85)}
body.dark .f-input::placeholder{color:rgba(255,255,255,.26)}
body.dark .f-input:focus{background:rgba(255,255,255,.08);border-color:var(--blue-l)}
body.dark select.f-input option{background:var(--ink-2)}
body.dark .exp-tag{background:var(--ink-3);border-color:rgba(255,255,255,.1);color:rgba(255,255,255,.6)}
body.dark .agree-row{background:rgba(26,79,214,.1);border-color:rgba(26,79,214,.2)}
body.dark .agree-row label{color:rgba(255,255,255,.6)}
body.dark .agree-row label strong{color:rgba(255,255,255,.85)}
body.dark .form-section{background:var(--ink)}
body.dark .stat-strip{background:var(--ink-2);border-color:rgba(255,255,255,.06)}

/* UTILS */
.container{max-width:1240px;margin:0 auto;padding:0 24px}
.container-sm{max-width:860px;margin:0 auto;padding:0 24px}
.section-py{padding:80px 0}
.section-py-sm{padding:56px 0}
.text-center{text-align:center}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-orange{background:var(--g-orange);-webkit-background-clip:text;background-clip:text;color:transparent}
.kicker{display:inline-flex;align-items:center;gap:6px;border-radius:var(--r-pill);padding:5px 14px;font-size:.67rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;margin-bottom:14px;border:1px solid rgba(26,79,214,.15);background:var(--blue-pale);color:var(--blue)}
.kicker::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue);flex-shrink:0}
.kicker.orange{background:var(--orange-pale);color:var(--orange);border-color:rgba(232,98,10,.15)}
.kicker.orange::before{background:var(--orange)}
.kicker.teal{background:rgba(13,148,136,.08);color:var(--teal);border-color:rgba(13,148,136,.15)}
.kicker.teal::before{background:var(--teal)}

/* FIXED */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:44px;height:44px;background:#fff;border:1.5px solid rgba(8,12,24,.08);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 18px rgba(8,12,24,.1);transition:var(--t)}
#theme-toggle svg{width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(20deg) scale(1.07)}
#theme-toggle:hover svg{stroke:#fff}
#back-to-top{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(16px);z-index:10000;width:48px;height:48px;background:var(--g-blue);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .3s,transform .4s var(--spring);box-shadow:var(--sh-blue)}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto}
#back-to-top svg{width:18px;height:18px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
#wa-float{position:fixed;bottom:86px;right:20px;z-index:10001;text-decoration:none;display:block}
.wa-ring{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-r 2.8s ease-out infinite;pointer-events:none}
.wa-ring:nth-child(2){animation-delay:1.2s}
@keyframes wa-r{0%{transform:scale(1);opacity:.6}100%{transform:scale(1.95);opacity:0}}
.wa-pill{display:flex;align-items:center;gap:9px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:8px 17px 8px 8px;box-shadow:0 6px 26px rgba(18,140,126,.42);transition:transform .3s var(--spring);white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-3px) scale(1.02)}
.wa-ico{width:36px;height:36px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.15rem;color:#fff;position:relative}
.wa-dot{position:absolute;top:1px;right:1px;width:9px;height:9px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dp 2.4s ease-in-out infinite}
@keyframes dp{0%,100%{transform:scale(1)}50%{transform:scale(1.45);opacity:.5}}
.wa-text{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.64rem;color:rgba(255,255,255,.55);font-weight:600}
.wa-cta{font-size:.88rem;color:#fff;font-weight:800;font-family:'Fraunces',serif}
.wa-arr{color:rgba(255,255,255,.6);font-size:.68rem;margin-left:2px;transition:transform .2s}
#wa-float:hover .wa-arr{transform:translateX(3px)}
#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-md);padding:11px 17px;font-size:.82rem;display:flex;align-items:center;gap:8px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:210px;max-width:calc(100vw - 40px)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.err{border-left-color:#ef4444}
#cookie-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.8);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;z-index:9998;transform:translateY(100%);transition:transform .38s;border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap}
#cookie-bar.show{transform:translateY(0)}
#cookie-bar p{font-size:.77rem;margin:0;flex:1;min-width:180px}
#cookie-accept{background:var(--blue);color:#fff;border:none;padding:7px 18px;border-radius:var(--r-pill);font-size:.79rem;cursor:pointer;font-weight:700;transition:var(--t)}
#cookie-accept:hover{background:var(--blue-d)}

@media(max-width:767px){
  #wa-float{bottom:74px;right:14px}
  .wa-text,.wa-arr{display:none}
  .wa-pill{padding:0;width:52px;height:52px;border-radius:50%;justify-content:center}
  .wa-ico{width:52px;height:52px;font-size:1.4rem}
  #theme-toggle{bottom:14px;left:14px;width:40px;height:40px}
  #back-to-top{bottom:12px;width:46px;height:46px}
}

/* ── BTNs ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.87rem;border-radius:var(--r-pill);transition:var(--t);cursor:pointer;border:none;letter-spacing:.01em;white-space:nowrap}
.btn-primary{background:var(--g-blue);color:#fff;padding:13px 28px;box-shadow:var(--sh-blue)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(26,79,214,.38)}
.btn-orange{background:var(--g-orange);color:#fff;padding:13px 28px;box-shadow:var(--sh-orange)}
.btn-orange:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(232,98,10,.38)}
.btn-outline{background:transparent;color:var(--blue);padding:11px 24px;border:1.5px solid var(--blue)}
.btn-outline:hover{background:var(--g-blue);color:#fff;transform:translateY(-2px)}
.btn-ghost-dark{background:rgba(255,255,255,.08);color:#fff;padding:12px 24px;border:1.5px solid rgba(255,255,255,.2);backdrop-filter:blur(8px);display:inline-flex;align-items:center;gap:7px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.87rem;border-radius:var(--r-pill);transition:var(--t);cursor:pointer}
.btn-ghost-dark:hover{background:rgba(255,255,255,.14);transform:translateY(-2px)}
.btn-lg{padding:15px 34px;font-size:.95rem}
.btn-xl{padding:16px 40px;font-size:1rem}

/* ══════════════════════════
   HERO — SPLIT LAYOUT
══════════════════════════ */
.hero{background:var(--g-hero);padding-top:var(--nav-h);position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(26,79,214,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(26,79,214,.05) 1px,transparent 1px);background-size:44px 44px;pointer-events:none}
.hero-orb-1{position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(26,79,214,.18) 0%,transparent 68%);top:-160px;right:-100px;pointer-events:none}
.hero-orb-2{position:absolute;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle,rgba(232,98,10,.1) 0%,transparent 70%);bottom:-80px;left:-40px;pointer-events:none}
.hero-inner{position:relative;z-index:1;padding:72px 0 80px;display:grid;grid-template-columns:1fr;gap:48px;align-items:center}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-pill);padding:6px 15px;color:rgba(255,255,255,.75);font-size:.73rem;font-weight:700;margin-bottom:20px;backdrop-filter:blur(8px);align-self:flex-start}
.hero-badge .dot{width:6px;height:6px;border-radius:50%;background:#34d399;animation:dp 2s infinite;flex-shrink:0}
.hero h1{font-size:clamp(2.2rem,5.5vw,3.8rem);font-weight:700;color:#fff;margin-bottom:16px;line-height:1.05}
.hero h1 em{font-style:italic;color:var(--orange-l)}
.hero-sub{color:rgba(255,255,255,.55);font-size:clamp(.9rem,2.5vw,1.06rem);line-height:1.78;max-width:500px;margin-bottom:32px}
.hero-checklist{display:grid;gap:10px;margin-bottom:34px}
.hero-check-item{display:flex;align-items:center;gap:10px;font-size:.88rem;font-weight:600;color:rgba(255,255,255,.75)}
.hci-icon{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.65rem;flex-shrink:0}
.hci-icon.g{background:rgba(5,150,105,.25);color:#34d399}
.hci-icon.b{background:rgba(26,79,214,.25);color:#7ea8f8}
.hci-icon.o{background:rgba(232,98,10,.22);color:var(--orange-l)}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap}

/* Trust row */
.hero-trust{display:flex;flex-wrap:wrap;gap:18px;margin-top:28px;padding-top:24px;border-top:1px solid rgba(255,255,255,.08)}
.ht-item{display:flex;align-items:center;gap:6px;font-size:.75rem;font-weight:600;color:rgba(255,255,255,.5)}
.ht-item i{font-size:.72rem}

/* Right card */
.hero-card{background:rgba(255,255,255,.06);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,.1);border-radius:var(--r-2xl);padding:28px 26px;position:relative;overflow:hidden}
.hero-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--orange))}
.hc-title{font-size:.65rem;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:rgba(255,255,255,.38);margin-bottom:18px}
.hc-stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px}
.hc-stat{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);border-radius:var(--r-lg);padding:16px 14px;text-align:center}
.hc-stat-val{font-family:'Fraunces',serif;font-size:1.7rem;font-weight:700;color:#fff;line-height:1;margin-bottom:4px}
.hc-stat-lbl{font-size:.67rem;font-weight:600;color:rgba(255,255,255,.42);text-transform:uppercase;letter-spacing:.8px}
.hc-divider{border:none;border-top:1px solid rgba(255,255,255,.08);margin:18px 0}
.hc-instructor-list{display:flex;flex-direction:column;gap:10px}
.hci-row{display:flex;align-items:center;gap:10px}
.hci-ava{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:.84rem;color:#fff;flex-shrink:0}
.hci-info{flex:1;min-width:0}
.hci-name{font-size:.8rem;font-weight:700;color:rgba(255,255,255,.88);line-height:1;margin-bottom:2px}
.hci-role{font-size:.68rem;color:rgba(255,255,255,.38)}
.hci-earn{font-size:.74rem;font-weight:700;color:#34d399;white-space:nowrap}

/* ══════════════════════════
   STAT STRIP
══════════════════════════ */
.stat-strip{background:#fff;border-top:1px solid var(--mist);border-bottom:1px solid var(--mist);padding:22px 0}
.stat-strip-inner{display:flex;flex-wrap:wrap;justify-content:center;gap:14px 36px}
.ss-item{display:flex;align-items:center;gap:10px}
.ss-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0}
.ss-icon.b{background:var(--blue-pale);color:var(--blue)}
.ss-icon.o{background:var(--orange-pale);color:var(--orange)}
.ss-icon.g{background:rgba(5,150,105,.1);color:var(--emerald)}
.ss-icon.t{background:rgba(13,148,136,.08);color:var(--teal)}
