/* Agreement */
.agree-row{display:flex;align-items:flex-start;gap:10px;background:var(--blue-pale);border:1px solid rgba(26,79,214,.14);border-radius:var(--r-md);padding:14px;margin-top:22px;cursor:pointer}
.agree-row input[type="checkbox"]{width:16px;height:16px;flex-shrink:0;margin-top:2px;accent-color:var(--blue);cursor:pointer}
.agree-row label{font-size:.78rem;color:var(--slate);line-height:1.58;cursor:pointer}
.agree-row label strong{color:var(--ink)}

/* Submit btn */
@keyframes spin{to{transform:rotate(360deg)}}
.spinner{display:none;width:17px;height:17px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
#iSubmit{width:100%;padding:15px;font-size:.94rem;border-radius:var(--r-lg);margin-top:26px;background:var(--g-orange);box-shadow:var(--sh-orange);display:flex;align-items:center;justify-content:center;gap:8px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#fff;border:none;cursor:pointer;transition:var(--t)}
#iSubmit:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(232,98,10,.4)}
#iSubmit:disabled{opacity:.65;cursor:not-allowed;transform:none}
#iSubmit.loading .btn-txt{display:none}
#iSubmit.loading .spinner{display:block}

/* Success */
@keyframes scale-in{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
@keyframes check-draw{to{stroke-dashoffset:0}}
.form-success{display:none;padding:56px 36px;text-align:center;animation:scale-in .45s cubic-bezier(.34,1.56,.64,1) both}
.success-circle{width:76px;height:76px;background:linear-gradient(135deg,var(--emerald),#10b981);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 22px;box-shadow:0 8px 28px rgba(5,150,105,.28)}
.success-circle svg{width:38px;height:38px}
.check-path{stroke-dasharray:34;stroke-dashoffset:34;animation:check-draw .5s .28s ease forwards}
.form-success h3{font-size:1.6rem;font-weight:700;margin-bottom:10px}
.form-success p{font-size:.86rem;color:var(--slate);line-height:1.72;max-width:380px;margin:0 auto 26px}

/* ══════════════════════════
   FAQ
══════════════════════════ */
.faq-item{background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);overflow:hidden;transition:border-color .22s;box-shadow:var(--sh-sm)}
.faq-item:hover{border-color:var(--blue)}
.faq-item.open{border-color:var(--blue-l)}
.faq-q{padding:15px 18px;font-weight:700;font-size:.86rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'Plus Jakarta Sans',sans-serif;min-height:52px;gap:12px}
.faq-icon{width:20px;height:20px;flex-shrink:0;background:var(--blue-pale);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:.62rem;transition:transform .24s,background .22s}
.faq-item.open .faq-icon{transform:rotate(45deg);background:var(--blue);color:#fff}
