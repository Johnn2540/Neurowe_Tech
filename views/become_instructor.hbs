.ss-label{font-size:.69rem;color:var(--slate);font-weight:600}

/* ══════════════════════════
   BENEFITS
══════════════════════════ */
.benefits-grid{display:grid;grid-template-columns:1fr;gap:16px}
.benefit-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);padding:24px 20px;transition:var(--t);box-shadow:var(--sh-sm);position:relative;overflow:hidden}
.benefit-card::after{content:'';position:absolute;top:0;left:0;right:0;height:2.5px;transform:scaleX(0);transform-origin:left;transition:transform .34s}
.benefit-card:hover::after{transform:scaleX(1)}
.bc-b::after{background:var(--g-blue)}
.bc-o::after{background:var(--g-orange)}
.bc-g::after{background:linear-gradient(90deg,var(--emerald),#34d399)}
.bc-t::after{background:linear-gradient(90deg,var(--teal),#5eead4)}
.bc-p::after{background:linear-gradient(90deg,#8b5cf6,#c084fc)}
.bc-y::after{background:linear-gradient(90deg,var(--yellow),#fcd34d)}
.benefit-card:hover{transform:translateY(-3px);box-shadow:var(--sh-lg)}
.b-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.05rem;margin-bottom:13px}
.bc-b .b-icon{background:var(--blue-pale);color:var(--blue)}
.bc-o .b-icon{background:var(--orange-pale);color:var(--orange)}
.bc-g .b-icon{background:rgba(5,150,105,.1);color:var(--emerald)}
.bc-t .b-icon{background:rgba(13,148,136,.08);color:var(--teal)}
.bc-p .b-icon{background:rgba(139,92,246,.1);color:#8b5cf6}
.bc-y .b-icon{background:rgba(245,158,11,.1);color:var(--yellow)}
.benefit-card h4{font-size:.96rem;font-weight:700;margin-bottom:6px;font-family:'Plus Jakarta Sans',sans-serif}
.benefit-card p{font-size:.8rem;color:var(--slate);line-height:1.65}

/* ══════════════════════════
   HOW IT WORKS — Timeline
══════════════════════════ */
.timeline{display:flex;flex-direction:column;gap:0;position:relative}
.timeline::before{content:'';position:absolute;left:21px;top:44px;bottom:44px;width:2px;background:linear-gradient(180deg,var(--blue),var(--orange),#8b5cf6,var(--emerald));border-radius:2px;opacity:.25}
.tl-step{display:flex;gap:20px;align-items:flex-start;padding:20px 0}
.tl-num{width:44px;height:44px;min-width:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:700;font-size:1rem;color:#fff;flex-shrink:0;position:relative;z-index:1}
.tl-n1{background:var(--g-blue);box-shadow:var(--sh-blue)}
.tl-n2{background:var(--g-orange);box-shadow:var(--sh-orange)}
.tl-n3{background:linear-gradient(135deg,var(--emerald),#10b981);box-shadow:0 6px 18px rgba(5,150,105,.28)}
.tl-n4{background:linear-gradient(135deg,#8b5cf6,#6d28d9);box-shadow:0 6px 18px rgba(139,92,246,.28)}
.tl-content{flex:1;padding-top:10px}
.tl-label{font-size:.62rem;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--slate-l);margin-bottom:5px}
.tl-content h4{font-size:1.02rem;font-weight:700;margin-bottom:6px;font-family:'Plus Jakarta Sans',sans-serif;color:var(--ink)}
.tl-content p{font-size:.8rem;color:var(--slate);line-height:1.66}
body.dark .tl-content h4{color:rgba(255,255,255,.88)}

/* ══════════════════════════
   EARNINGS CALCULATOR
══════════════════════════ */
.calc-card{background:#fff;border-radius:var(--r-2xl);border:1px solid var(--mist);box-shadow:var(--sh-md);overflow:hidden;max-width:800px;margin:0 auto}
.calc-head{background:linear-gradient(135deg,var(--blue),var(--blue-d));padding:26px 32px;position:relative;overflow:hidden}
.calc-head::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:32px 32px}
.calc-head h3{position:relative;z-index:1;font-size:1.2rem;font-weight:700;color:#fff;margin-bottom:3px}
.calc-head p{position:relative;z-index:1;font-size:.79rem;color:rgba(255,255,255,.55)}
.calc-body{padding:28px 32px}
.calc-sliders{display:flex;flex-direction:column;gap:20px}
.calc-lbl{font-size:.74rem;font-weight:700;color:var(--slate);text-transform:uppercase;letter-spacing:.6px;display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.calc-lbl span{font-size:.9rem;font-weight:800;color:var(--blue);text-transform:none;letter-spacing:0}
.calc-range{-webkit-appearance:none;appearance:none;width:100%;height:5px;border-radius:3px;background:var(--mist);outline:none;cursor:pointer}
.calc-range::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--blue);cursor:pointer;box-shadow:0 2px 8px rgba(26,79,214,.3)}
.calc-range::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:var(--blue);cursor:pointer;border:none}
.calc-results-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;background:var(--ghost);border-radius:var(--r-lg);padding:22px;margin-top:24px}
.cr-item{text-align:center}
.cr-val{font-family:'Fraunces',serif;font-size:1.5rem;font-weight:700;color:var(--emerald);line-height:1;margin-bottom:4px}
.cr-lbl{font-size:.69rem;color:var(--slate);font-weight:600}
.calc-note{font-size:.7rem;color:var(--slate-l);text-align:center;margin-top:12px;line-height:1.6}

/* ══════════════════════════
   APPLICATION FORM — Hero-quality
══════════════════════════ */
.form-section{background:linear-gradient(158deg,#f0f4ff 0%,#f5fff8 100%);padding:80px 0}
body.dark .form-section{background:linear-gradient(158deg,var(--ink),var(--ink-2))}
.form-wrap{max-width:740px;margin:0 auto}
