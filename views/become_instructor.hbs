.field-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--slate-l);font-size:.8rem;pointer-events:none;transition:color .2s}
.field-wrap:focus-within .field-icon{color:var(--blue)}
.textarea-wrap .field-icon{top:13px;transform:none}
.f-input{width:100%;background:var(--ghost);border:1.5px solid var(--mist);border-radius:var(--r-md);color:var(--ink);padding:11px 14px;font-size:15px;transition:var(--t);outline:none;-webkit-appearance:none;line-height:1.5}
.f-input.has-icon{padding-left:38px}
