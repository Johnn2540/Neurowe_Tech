.f-input.error{border-color:var(--rose);box-shadow:0 0 0 3px rgba(225,29,72,.07)}
.f-input::placeholder{color:var(--slate-l)}
textarea.f-input{resize:vertical;min-height:110px}
select.f-input{cursor:pointer}
.f-error{font-size:.7rem;color:var(--rose);margin-top:5px;display:none;align-items:center;gap:4px}
.f-input.error~.f-error{display:flex}
.fg{display:flex;flex-direction:column;gap:0}
.row2{display:grid;grid-template-columns:1fr;gap:16px}
.mt16{margin-top:16px}
.mt24{margin-top:24px}

/* Section divider inside form */
.form-divider{margin:26px 0 22px;display:flex;align-items:center;gap:12px}
.form-divider-line{flex:1;height:1px;background:var(--mist)}
.form-divider-lbl{font-size:.65rem;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--slate-l);white-space:nowrap}
body.dark .form-divider-line{background:rgba(255,255,255,.08)}

/* Expertise chips */
.expertise-wrap{display:flex;flex-wrap:wrap;gap:7px}
.exp-chk{display:none}
.exp-tag{display:inline-flex;align-items:center;gap:5px;background:#fff;border:1.5px solid var(--mist);color:var(--slate);border-radius:var(--r-pill);padding:6px 14px;font-size:.76rem;font-weight:600;transition:var(--t);cursor:pointer;user-select:none;line-height:1}
