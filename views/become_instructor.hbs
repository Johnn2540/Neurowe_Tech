<section class="form-section" id="apply">
  <div class="container">
    <div class="text-center" style="margin-bottom:44px">
      <div class="kicker">Apply Now</div>
      <h2 style="font-size:clamp(1.8rem,5vw,2.8rem);font-weight:700;margin-bottom:10px">Ready to start <span class="g-blue">teaching?</span></h2>
      <p style="color:var(--slate);font-size:.94rem;max-width:440px;margin:0 auto;line-height:1.76">Fill in the form and our Academy team will respond within 48 hours.</p>
    </div>

    <div class="form-wrap">
      <div class="form-card">
        <div class="form-top">
          <div class="form-top-bar"></div>
          <h2>Instructor Application</h2>
          <p>All fields marked <span style="color:var(--rose)">*</span> are required. We review every application personally.</p>
          <div class="form-top-meta">
            <span class="ftm-item"><i class="fas fa-clock"></i> Takes ~5 minutes</span>
            <span class="ftm-item"><i class="fas fa-check-circle"></i> Response within 48 hrs</span>
            <span class="ftm-item"><i class="fas fa-lock"></i> Info kept confidential</span>
          </div>
        </div>

        <div class="form-body">
          <form id="instructorForm" novalidate>

            <!-- ── Personal Info ── -->
            <div class="form-divider"><div class="form-divider-line"></div><div class="form-divider-lbl">Personal Info</div><div class="form-divider-line"></div></div>

            <div class="row2">
              <div class="fg">
                <label class="f-label" for="iName">Full Name <span class="req">*</span></label>
                <div class="field-wrap">
                  <i class="fas fa-user field-icon"></i>
                  <input type="text" id="iName" class="f-input has-icon" placeholder="Jane Wanjiku" required autocomplete="name">
                </div>
                <span class="f-error"><i class="fas fa-exclamation-circle"></i> Please enter your full name.</span>
              </div>
              <div class="fg">
                <label class="f-label" for="iEmail">Email Address <span class="req">*</span></label>
                <div class="field-wrap">
                  <i class="fas fa-envelope field-icon"></i>
                  <input type="email" id="iEmail" class="f-input has-icon" placeholder="jane@example.com" required autocomplete="email">
                </div>
                <span class="f-error"><i class="fas fa-exclamation-circle"></i> Enter a valid email address.</span>
              </div>
            </div>

            <div class="row2 mt16">
              <div class="fg">
                <label class="f-label" for="iPhone">Phone / WhatsApp <span class="req">*</span></label>
                <div class="field-wrap">
                  <i class="fas fa-phone field-icon"></i>
                  <input type="tel" id="iPhone" class="f-input has-icon" placeholder="+254 700 000 000" required autocomplete="tel">
                </div>
                <span class="f-error"><i class="fas fa-exclamation-circle"></i> Phone number required.</span>
              </div>
              <div class="fg">
                <label class="f-label" for="iLinkedIn">LinkedIn / Portfolio URL</label>
                <div class="field-wrap">
                  <i class="fas fa-link field-icon"></i>
                  <input type="url" id="iLinkedIn" class="f-input has-icon" placeholder="https://linkedin.com/in/…">
                </div>
              </div>
            </div>

            <!-- ── Course Info ── -->
            <div class="form-divider" style="margin-top:28px"><div class="form-divider-line"></div><div class="form-divider-lbl">Course Info</div><div class="form-divider-line"></div></div>

            <div class="row2">
              <div class="fg">
                <label class="f-label" for="iExperience">Years of Experience <span class="req">*</span></label>
                <div class="field-wrap">
                  <i class="fas fa-briefcase field-icon"></i>
                  <select id="iExperience" class="f-input has-icon" required>
                    <option value="">Select years…</option>
                    <option value="1-2">1 – 2 years</option>
                    <option value="3-5">3 – 5 years</option>
                    <option value="5-10">5 – 10 years</option>
                    <option value="10+">10+ years</option>
                  </select>
                </div>
                <span class="f-error"><i class="fas fa-exclamation-circle"></i> Please select your experience.</span>
              </div>
              <div class="fg">
                <label class="f-label" for="iCourseTitle">Proposed Course Title <span class="req">*</span></label>
                <div class="field-wrap">
                  <i class="fas fa-graduation-cap field-icon"></i>
                  <input type="text" id="iCourseTitle" class="f-input has-icon" placeholder="e.g. React for Beginners" required>
                </div>
                <span class="f-error"><i class="fas fa-exclamation-circle"></i> Please enter a course title idea.</span>
              </div>
            </div>

            <div class="fg mt16">
              <label class="f-label">Area of Expertise <span class="req">*</span></label>
              <div class="expertise-wrap" id="expertiseWrap">
                <input type="checkbox" class="exp-chk" id="ex1" value="Web Development"><label class="exp-tag" for="ex1"><i class="fas fa-laptop-code"></i> Web Development</label>
                <input type="checkbox" class="exp-chk" id="ex2" value="Mobile Apps"><label class="exp-tag" for="ex2"><i class="fas fa-mobile-alt"></i> Mobile Apps</label>
                <input type="checkbox" class="exp-chk" id="ex3" value="UI/UX Design"><label class="exp-tag" for="ex3"><i class="fas fa-pen-nib"></i> UI/UX Design</label>
                <input type="checkbox" class="exp-chk" id="ex4" value="AI & Machine Learning"><label class="exp-tag" for="ex4"><i class="fas fa-robot"></i> AI & ML</label>
                <input type="checkbox" class="exp-chk" id="ex5" value="Data Science"><label class="exp-tag" for="ex5"><i class="fas fa-chart-line"></i> Data Science</label>
                <input type="checkbox" class="exp-chk" id="ex6" value="Cloud & DevOps"><label class="exp-tag" for="ex6"><i class="fas fa-cloud-upload-alt"></i> Cloud & DevOps</label>
                <input type="checkbox" class="exp-chk" id="ex7" value="Cyber Security"><label class="exp-tag" for="ex7"><i class="fas fa-shield-alt"></i> Cyber Security</label>
                <input type="checkbox" class="exp-chk" id="ex8" value="Graphic Design"><label class="exp-tag" for="ex8"><i class="fas fa-palette"></i> Graphic Design</label>
                <input type="checkbox" class="exp-chk" id="ex9" value="Business & Entrepreneurship"><label class="exp-tag" for="ex9"><i class="fas fa-briefcase"></i> Business</label>
                <input type="checkbox" class="exp-chk" id="ex10" value="Digital Marketing"><label class="exp-tag" for="ex10"><i class="fas fa-megaphone"></i> Digital Marketing</label>
              </div>
