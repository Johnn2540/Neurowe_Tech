<script>
/* ── THEME ── */
var dark = localStorage.getItem('nw-theme') === 'dark' ||
  (!localStorage.getItem('nw-theme') && window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON = '<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN  = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme() {
  document.body.classList.toggle('dark', dark);
  document.getElementById('theme-toggle').innerHTML = dark ? SUN : MOON;
  var mt = document.getElementById('mobThemeBtn');
  if (mt) mt.innerHTML = dark ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
}
applyTheme();
function toggleTheme() { dark = !dark; localStorage.setItem('nw-theme', dark ? 'dark' : 'light'); applyTheme(); }
document.getElementById('theme-toggle').addEventListener('click', toggleTheme);
var mtb = document.getElementById('mobThemeBtn'); if (mtb) mtb.addEventListener('click', toggleTheme);

/* ── SCROLL ── */
var navbar = document.getElementById('mainNav'),
    btt    = document.getElementById('back-to-top'),
    sp     = document.getElementById('scroll-progress');
window.addEventListener('scroll', function() {
  var s = window.pageYOffset, d = document.documentElement.scrollHeight - window.innerHeight;
  sp.style.width = (d > 0 ? s / d * 100 : 0) + '%';
  navbar.classList.toggle('scrolled', s > 40);
  btt.classList.toggle('visible', s > 400);
}, { passive: true });
btt.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });

/* ── MOBILE NAV ── */
var ov = document.getElementById('mobOverlay'),
    panel = document.getElementById('mobPanel'),
    ham   = document.getElementById('hamBtn'),
    mc    = document.getElementById('mobClose');
function openM()  { ov.classList.add('open');    panel.classList.add('open');    ham.classList.add('open');    ham.setAttribute('aria-expanded','true');  document.body.style.overflow = 'hidden'; mc.focus(); }
function closeM() { ov.classList.remove('open'); panel.classList.remove('open'); ham.classList.remove('open'); ham.setAttribute('aria-expanded','false'); document.body.style.overflow = ''; }
ham.addEventListener('click', openM); mc.addEventListener('click', closeM); ov.addEventListener('click', closeM);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && panel.classList.contains('open')) closeM(); });

/* ── COOKIE ── */
var cb = document.getElementById('cookie-bar');
if (!localStorage.getItem('nw-cookie')) setTimeout(function() { cb.classList.add('show'); }, 2800);
document.getElementById('cookie-accept').addEventListener('click', function() { localStorage.setItem('nw-cookie','1'); cb.classList.remove('show'); });

/* ── TOAST ── */
function toast(msg, isErr) {
  var t    = document.getElementById('toast');
  var icon = document.getElementById('toastIcon');
  document.getElementById('toast-msg').textContent = msg;
  if (isErr) { t.classList.add('err'); icon.className = 'fas fa-exclamation-circle'; icon.style.color = '#f87171'; }
  else       { t.classList.remove('err'); icon.className = 'fas fa-check-circle'; icon.style.color = '#34d399'; }
  t.classList.add('show');
  setTimeout(function() { t.classList.remove('show'); t.classList.remove('err'); }, 4200);
}

/* ── EARNINGS CALCULATOR ── */
function fmtKshs(n) {
  if (n >= 1000000) return 'Kshs ' + (n / 1000000).toFixed(1) + 'M';
  if (n >= 1000)    return 'Kshs ' + Math.round(n / 1000) + 'K';
  return 'Kshs ' + n.toLocaleString();
}
function updateCalc() {
  var students = parseInt(document.getElementById('studentsRange').value);
  var price    = parseInt(document.getElementById('priceRange').value);
  var courses  = parseInt(document.getElementById('coursesRange').value);
  document.getElementById('studentsVal').textContent = students;
  document.getElementById('priceVal').textContent    = price.toLocaleString();
  document.getElementById('coursesVal').textContent  = courses;
  var perCourseMonthly  = students * price * 0.70;
  var totalMonthly      = perCourseMonthly * courses;
  var totalAnnual       = totalMonthly * 12;
  var totalStudents     = students * courses;
  document.getElementById('monthlyEarnings').textContent = fmtKshs(totalMonthly);
  document.getElementById('annualEarnings').textContent  = fmtKshs(totalAnnual);
  document.getElementById('perCourse').textContent       = fmtKshs(perCourseMonthly);
  document.getElementById('totalStudents').textContent   = totalStudents.toLocaleString();
}
['studentsRange','priceRange','coursesRange'].forEach(function(id) {
  var el = document.getElementById(id);
  if (el) el.addEventListener('input', updateCalc);
});
updateCalc();

/* ── BIO CHAR COUNT ── */
var bioEl = document.getElementById('iBio');
if (bioEl) {
  bioEl.addEventListener('input', function() {
    document.getElementById('bioCharNum').textContent = this.value.length;
  });
}

/* ── FORM SUBMIT ── */
document.getElementById('instructorForm').addEventListener('submit', async function(e) {
  e.preventDefault();

  var name       = document.getElementById('iName');
  var email      = document.getElementById('iEmail');
  var phone      = document.getElementById('iPhone');
  var experience = document.getElementById('iExperience');
  var courseTitle= document.getElementById('iCourseTitle');
  var bio        = document.getElementById('iBio');
  var agree      = document.getElementById('iAgree');

  // Clear errors
  [name, email, phone, experience, courseTitle, bio].forEach(function(f) { f.classList.remove('error'); });
  document.getElementById('expertiseErr').style.display = 'none';
  document.getElementById('bioErr').style.display = 'none';

  var ok = true;

  if (!name.value.trim() || name.value.trim().length < 2)     { name.classList.add('error');       ok = false; }
  if (!email.value.trim() || !/^\S+@\S+\.\S+$/.test(email.value.trim())) { email.classList.add('error'); ok = false; }
  if (!phone.value.trim())                                      { phone.classList.add('error');      ok = false; }
  if (!experience.value)                                        { experience.classList.add('error'); ok = false; }
  if (!courseTitle.value.trim())                                { courseTitle.classList.add('error');ok = false; }
  if (bio.value.trim().length < 30)                             { bio.classList.add('error'); document.getElementById('bioErr').style.display = 'flex'; ok = false; }

  var expertise = Array.from(document.querySelectorAll('.exp-chk:checked')).map(function(c) { return c.value; });
  if (expertise.length === 0) {
    document.getElementById('expertiseErr').style.display = 'flex';
    ok = false;
  }

  if (!agree.checked) {
    toast('Please agree to the Instructor Terms to continue.', true);
    ok = false;
  }

  if (!ok) {
    var firstErr = document.querySelector('.f-input.error');
    if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }

  var btn = document.getElementById('iSubmit');
  btn.classList.add('loading');
  btn.disabled = true;

  // Build message that goes into the contacts table
  var teaching = document.getElementById('iTeaching').value.trim();
  var linkedin  = document.getElementById('iLinkedIn').value.trim();
  var fullMessage = [
    '=== INSTRUCTOR APPLICATION ===',
    'Proposed Course: ' + courseTitle.value.trim(),
    'Expertise: ' + expertise.join(', '),
    'Experience: ' + experience.value,
    '',
    'Bio / Course Description:',
    bio.value.trim(),
    teaching ? ('\nPrevious Teaching:\n' + teaching) : '',
    linkedin  ? ('\nLinkedIn/Portfolio: ' + linkedin)  : '',
  ].filter(Boolean).join('\n');

  var payload = {
    name:         name.value.trim(),
    email:        email.value.trim(),
    phone:        phone.value.trim(),
    services:     ['Instructor Application'],   // maps to project_type
    budget:       'N/A',
    message:      fullMessage,
  };

  try {
    var res  = await fetch('/contact', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload),
    });
    var data;
    try { data = await res.json(); } catch(_) { data = {}; }

    btn.classList.remove('loading');
    btn.disabled = false;

    if (!res.ok || data.success === false) {
      toast(data.message || 'Something went wrong. Please try again.', true);
      return;
    }

    // Show success
    document.getElementById('instructorForm').style.display = 'none';
    var succ = document.getElementById('formSuccess');
    succ.style.display = 'block';
    succ.scrollIntoView({ behavior: 'smooth', block: 'center' });
    toast('Application sent! We\'ll be in touch within 48 hrs ✅');

  } catch (err) {
    btn.classList.remove('loading');
    btn.disabled = false;
    toast('Network error — please check your connection or reach us on WhatsApp.', true);
    console.error('Instructor form error:', err);
  }
});

/* ── FAQ ── */
document.querySelectorAll('.faq-q').forEach(function(q) {
  q.addEventListener('click', function() {
    var item = q.parentElement, wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(function(i) { i.classList.remove('open'); });
    if (!wasOpen) item.classList.add('open');
  });
});
</script>
