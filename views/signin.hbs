<script src="https://accounts.google.com/gsi/client" async defer></script>
<script>
// ── THEME ────────────────────────────────────────────────────
const themeBtn = document.getElementById('theme-toggle');
let dark = localStorage.getItem('nw-theme') === 'dark' ||
           (!localStorage.getItem('nw-theme') && window.matchMedia('(prefers-color-scheme:dark)').matches);
const MOON = '<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
const SUN  = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/></svg>';
function applyTheme() {
  document.body.classList.toggle('dark', dark);
  themeBtn.innerHTML = dark ? SUN : MOON;
}
applyTheme();
themeBtn.addEventListener('click', () => {
  dark = !dark;
  localStorage.setItem('nw-theme', dark ? 'dark' : 'light');
  applyTheme();
});

// ── ALERT ────────────────────────────────────────────────────
function showAlert(msg, type) {
  const icons = { success: 'fas fa-check-circle', error: 'fas fa-exclamation-circle', info: 'fas fa-info-circle' };
  const alertDiv = document.getElementById('alertMsg');
  if (alertDiv) {
    alertDiv.innerHTML = `<div class="auth-alert ${type}"><i class="${icons[type] || icons.info}"></i>${msg}</div>`;
  }
  if (type !== 'success') {
    setTimeout(() => {
      const el = document.querySelector('.auth-alert');
      if (el) el.remove();
    }, 5000);
  }
}

// ── PASSWORD TOGGLE ──────────────────────────────────────────
const pwInput  = document.getElementById('password');
const pwToggle = document.getElementById('pwToggle');
if (pwToggle && pwInput) {
  pwToggle.addEventListener('click', () => {
    const show = pwInput.type === 'password';
    pwInput.type = show ? 'text' : 'password';
    const icon = pwToggle.querySelector('i');
    if (icon) icon.className = show ? 'fas fa-eye' : 'fas fa-eye-slash';
  });
}

// ── REMEMBER ME ──────────────────────────────────────────────
const remembered = localStorage.getItem('nw-remembered-email');
if (remembered) {
  const emailInput = document.getElementById('email');
  if (emailInput) emailInput.value = remembered;
  const rememberCheck = document.getElementById('rememberMe');
  if (rememberCheck) rememberCheck.checked = true;
}

// ── SIGN IN FORM ─────────────────────────────────────────────
const signinForm = document.getElementById('signinForm');
if (signinForm) {
  signinForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailEl  = document.getElementById('email');
    const email    = emailEl ? emailEl.value.trim() : '';
    const password = document.getElementById('password') ? document.getElementById('password').value : '';
    const remember = document.getElementById('rememberMe') ? document.getElementById('rememberMe').checked : false;
    const btn      = document.getElementById('submitBtn');

    if (!email || !password) {
      showAlert('Please enter your email and password.', 'error');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showAlert('Please enter a valid email address.', 'error');
      if (emailEl) emailEl.classList.add('has-error');
      return;
    }
    if (emailEl) emailEl.classList.remove('has-error');

    const originalBtnText = btn ? btn.innerHTML : '';
    if (btn) {
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Signing in…';
      btn.disabled = true;
    }

    try {
      const response = await fetch('/api/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, rememberMe: remember })
      });
      
      const data = await response.json();

      if (data.success) {
        if (remember) {
          localStorage.setItem('nw-remembered-email', email);
        } else {
          localStorage.removeItem('nw-remembered-email');
        }

        showAlert(data.message || 'Login successful! Redirecting...', 'success');
        
        // ✅ IMPORTANT: Use the redirect URL from the server
        // The server already determines if user is admin or regular user
        const redirectUrl = data.redirect;
        
        console.log('Redirecting to:', redirectUrl); // For debugging
        
        setTimeout(() => {
          window.location.href = redirectUrl;
        }, 1000);
        
      } else {
        showAlert(data.message || 'Invalid email or password.', 'error');
        if (btn) {
          btn.innerHTML = originalBtnText;
          btn.disabled = false;
        }
        const passwordField = document.getElementById('password');
        if (passwordField) passwordField.value = '';
      }
      
    } catch (error) {
      console.error('Login error:', error);
      showAlert('Network error. Please try again.', 'error');
      if (btn) {
        btn.innerHTML = originalBtnText;
        btn.disabled = false;
      }
    }
  });
}

// ── GOOGLE SIGN IN ───────────────────────────────────────────
const GOOGLE_CLIENT_ID = '{{googleClientId}}';
const googleBtn = document.getElementById('googleBtn');

if (GOOGLE_CLIENT_ID && GOOGLE_CLIENT_ID !== '' && GOOGLE_CLIENT_ID !== '{{googleClientId}}') {
  const initGoogleSignIn = () => {
    if (typeof google !== 'undefined' && google.accounts && google.accounts.id) {
      google.accounts.id.initialize({
        client_id: GOOGLE_CLIENT_ID,
        callback: async (response) => {
          if (googleBtn) {
            googleBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Signing in…';
            googleBtn.disabled = true;
          }
          
          try {
            const res = await fetch('/api/auth/google', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ idToken: response.credential })
            });
            
            const data = await res.json();
            
            if (data.success) {
              showAlert(data.message || 'Google sign-in successful!', 'success');
              
              // ✅ IMPORTANT: Use the redirect URL from the server
              const redirectUrl = data.redirect;
              
              console.log('Google redirecting to:', redirectUrl); // For debugging
              
              setTimeout(() => {
                window.location.href = redirectUrl;
              }, 1000);
            } else {
              showAlert(data.message || 'Google sign-in failed. Please try again.', 'error');
              if (googleBtn) {
                googleBtn.disabled = false;
                googleBtn.innerHTML = googleBtnHTML();
              }
            }
          } catch (error) {
            console.error('Google auth error:', error);
            showAlert('Authentication failed. Please try again.', 'error');
            if (googleBtn) {
              googleBtn.disabled = false;
              googleBtn.innerHTML = googleBtnHTML();
            }
          }
        },
        cancel_on_tap_outside: false
      });
      
      if (googleBtn) {
        googleBtn.disabled = false;
        googleBtn.onclick = () => {
          google.accounts.id.prompt();
        };
      }
    } else {
      console.warn('Google Sign-In not loaded yet, retrying...');
      setTimeout(initGoogleSignIn, 500);
    }
  };
  
  window.addEventListener('load', initGoogleSignIn);
  
} else {
  if (googleBtn) {
    googleBtn.disabled = true;
    googleBtn.style.opacity = '0.6';
    googleBtn.title = 'Google Sign-In not configured';
    googleBtn.addEventListener('click', () => {
      showAlert('Google Sign-In is not configured. Please use email/password.', 'info');
    });
  }
}

function googleBtnHTML() {
  return `<svg viewBox="0 0 48 48" style="width:18px;height:18px">
    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
