/* ═══════════════════════════════════════════════
   LOGIN PAGE — ADDITIONAL STYLES
═══════════════════════════════════════════════ */

/* full-page layout */
body {
  min-height: 100svh;
  background: var(--g-hero);
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}

/* animated mesh background (reuse hero pattern) */
.auth-bg {
  position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden;
}
.auth-bg::before {
  content: '';
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(26,86,232,.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(26,86,232,.055) 1px, transparent 1px);
  background-size: 40px 40px;
}
.auth-glow-1 {
  position: absolute; width: 600px; height: 600px; border-radius: 50%;
  background: radial-gradient(circle, rgba(26,86,232,.22) 0%, transparent 70%);
  top: -180px; right: -80px;
}
.auth-glow-2 {
  position: absolute; width: 380px; height: 380px; border-radius: 50%;
  background: radial-gradient(circle, rgba(240,112,32,.14) 0%, transparent 70%);
  bottom: -60px; left: 0;
}

/* back link */
.auth-back {
  position: fixed; top: 22px; left: 22px; z-index: 100;
}
.auth-back a {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18);
  backdrop-filter: blur(12px); color: #fff;
  padding: 9px 18px; border-radius: var(--r-pill);
  font-size: .82rem; font-weight: 700; font-family: 'Syne', sans-serif;
  transition: var(--t); text-decoration: none;
}
.auth-back a:hover {
  background: #fff; color: var(--blue);
  transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.18);
}

/* scroll progress (reused) */
#scroll-progress { display: none; } /* hidden on auth pages */

/* centred wrapper */
.auth-wrap {
  flex: 1; display: flex; align-items: center; justify-content: center;
  padding: 96px 16px 40px; position: relative; z-index: 1;
}

/* card */
.auth-card {
  background: #fff; border-radius: var(--r-xl);
  box-shadow: 0 28px 72px rgba(8,12,24,.32), 0 4px 16px rgba(8,12,24,.12);
  width: 100%; max-width: 460px;
  overflow: hidden;
  animation: auth-in .5s var(--spring) both;
}
@keyframes auth-in {
  from { opacity: 0; transform: translateY(24px) scale(.97); }
  to   { opacity: 1; transform: none; }
}
body.dark .auth-card { background: var(--ink-2); }

/* card header */
.auth-head {
  background: var(--g-hero);
  padding: 36px 32px 28px;
  text-align: center; position: relative; overflow: hidden;
}
.auth-head::before {
  content: '';
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(26,86,232,.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(26,86,232,.07) 1px, transparent 1px);
  background-size: 32px 32px;
}
.auth-head-brand {
  display: inline-flex; align-items: center; gap: 7px;
  font-family: 'Syne', sans-serif; font-size: 1.18rem; font-weight: 800;
  color: #fff; margin-bottom: 16px; text-decoration: none;
  position: relative;
}
.auth-head-brand em { font-style: normal; color: var(--orange-l); }
.auth-head h1 {
  font-size: 1.65rem; font-weight: 800; color: #fff;
  margin-bottom: 7px; position: relative;
}
.auth-head p {
  color: rgba(255,255,255,.6); font-size: .87rem; position: relative;
}

/* card body */
.auth-body { padding: 32px; }
@media(max-width:480px) {
  .auth-head { padding: 26px 20px 22px; }
  .auth-body { padding: 22px 18px; }
}

/* alert */
.auth-alert {
  display: flex; align-items: flex-start; gap: 10px;
  border-radius: var(--r-md); padding: 11px 14px;
  font-size: .83rem; margin-bottom: 18px;
  border-left: 3px solid; animation: auth-in .25s both;
}
.auth-alert.success { background: rgba(13,191,126,.09); border-color: var(--emerald); color: #065f46; }
.auth-alert.error   { background: rgba(239,68,68,.08);  border-color: #ef4444;        color: #991b1b; }
.auth-alert.info    { background: var(--blue-pale);      border-color: var(--blue);    color: var(--blue-d); }
body.dark .auth-alert.success { color: #6ee7b7; }
body.dark .auth-alert.error   { color: #fca5a5; }
body.dark .auth-alert.info    { color: var(--blue-l); }

/* form fields */
.auth-field { margin-bottom: 20px; }
.auth-label {
  font-size: .75rem; font-weight: 800; text-transform: uppercase;
  letter-spacing: .7px; color: var(--slate); display: block; margin-bottom: 7px;
}
body.dark .auth-label { color: rgba(255,255,255,.45); }
.auth-input-wrap { position: relative; }
.auth-input-icon {
  position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
  color: var(--slate); font-size: .88rem; pointer-events: none; z-index: 1;
}
.auth-input {
  width: 100%; padding: 12px 44px; border: 2px solid var(--mist);
  border-radius: var(--r-md); font-size: .9rem; font-family: 'DM Sans', sans-serif;
  background: var(--ghost); color: var(--ink); outline: none; transition: var(--t);
}
.auth-input:focus {
  background: #fff; border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(26,86,232,.12);
}
.auth-input.has-error { border-color: #ef4444; }
.auth-input::placeholder { color: var(--slate); opacity: .7; }
body.dark .auth-input {
  background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.1);
  color: rgba(255,255,255,.87);
}
body.dark .auth-input:focus {
  background: rgba(255,255,255,.08);
}
.auth-pw-toggle {
  position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
  color: var(--slate); cursor: pointer; font-size: .88rem; z-index: 2;
  transition: color .2s; padding: 4px;
}
.auth-pw-toggle:hover { color: var(--blue); }
.auth-hint {
  font-size: .73rem; color: var(--slate); margin-top: 6px;
  display: flex; align-items: center; gap: 5px;
}

/* row helpers */
.auth-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; margin-bottom: 20px; flex-wrap: wrap;
}
.auth-check {
  display: flex; align-items: center; gap: 8px;
  font-size: .83rem; color: var(--slate); cursor: pointer;
}
.auth-check input { width: 15px; height: 15px; accent-color: var(--blue); cursor: pointer; }
.auth-forgot { font-size: .8rem; color: var(--blue); font-weight: 600; text-decoration: none; }
.auth-forgot:hover { text-decoration: underline; }

/* divider */
.auth-divider {
  display: flex; align-items: center; gap: 14px; margin: 22px 0;
}
.auth-divider::before, .auth-divider::after {
  content: ''; flex: 1; height: 1px; background: var(--mist);
}
body.dark .auth-divider::before, body.dark .auth-divider::after {
  background: rgba(255,255,255,.08);
}
.auth-divider span { font-size: .74rem; color: var(--slate); white-space: nowrap; }

/* google button */
.btn-google {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  width: 100%; padding: 11px 20px;
  background: #fff; border: 2px solid var(--mist); border-radius: var(--r-pill);
  font-size: .88rem; font-weight: 700; color: var(--ink);
  font-family: 'Syne', sans-serif; cursor: pointer; transition: var(--t);
}
.btn-google:hover:not(:disabled) {
  border-color: rgba(26,86,232,.3);
  box-shadow: 0 4px 16px rgba(8,12,24,.1); transform: translateY(-2px);
}
.btn-google:disabled { opacity: .55; cursor: not-allowed; }
.btn-google svg { width: 18px; height: 18px; flex-shrink: 0; }
body.dark .btn-google {
  background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.1); color: rgba(255,255,255,.8);
}

/* footer link */
.auth-footer-link {
  text-align: center; margin-top: 20px; padding-top: 18px;
  border-top: 1px solid var(--mist);
  font-size: .84rem; color: var(--slate);
}
body.dark .auth-footer-link { border-color: rgba(255,255,255,.08); }
.auth-footer-link a { color: var(--blue); font-weight: 700; text-decoration: none; }
.auth-footer-link a:hover { text-decoration: underline; }

/* theme toggle on this page */
#theme-toggle {
  bottom: 22px; left: 22px;
}

/* trust pills row */
.auth-trust {
  display: flex; justify-content: center; gap: 14px;
  flex-wrap: wrap; margin-top: 14px; position: relative;
}
.auth-trust-item {
  display: flex; align-items: center; gap: 5px;
  font-size: .68rem; color: rgba(255,255,255,.5); font-weight: 600;
}
.auth-trust-item i { color: var(--orange-l); font-size: .7rem; }
</style>
</head>
