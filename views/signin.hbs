<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In | NeurowexTech</title>
  <meta name="description" content="Sign in to your NeurowexTech account." />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<style>

:root {
  --blue:      #1a56e8;
  --blue-d:    #1341c4;
  --blue-l:    #4f7df5;
  --blue-pale: rgba(26,86,232,.09);
  --orange:    #f07020;
  --orange-d:  #d45c10;
  --orange-l:  #f5a060;
  --orange-pale:rgba(240,112,32,.09);
  --black:     #080c18;
  --ink:       #0f1628;
  --ink-2:     #18213a;
  --slate:     #5c6b8a;
  --mist:      #e4e9f4;
  --ghost:     #f6f8fd;
  --white:     #ffffff;
  --emerald:   #0dbf7e;
  --teal:      #00b09c;
  --g-blue:    linear-gradient(135deg,#1a56e8 0%,#1341c4 100%);
  --g-orange:  linear-gradient(135deg,#f07020 0%,#d45c10 100%);
  --g-hero:    linear-gradient(158deg,#040810 0%,#080f20 45%,#0c1830 100%);
  --g-dark:    linear-gradient(145deg,#080c18 0%,#0f1628 100%);
  --r-xl:      20px;
  --r-lg:      14px;
  --r-md:      10px;
  --r-pill:    999px;
  --nav-h:     64px;
  --ease:      cubic-bezier(.4,0,.2,1);
  --spring:    cubic-bezier(.34,1.56,.64,1);
  --t:         .28s var(--ease);
  --sh-blue:   0 8px 28px rgba(26,86,232,.26);
  --sh-orange: 0 8px 28px rgba(240,112,32,.26);
  --sh-card:   0 1px 8px rgba(8,12,24,.06),0 4px 20px rgba(8,12,24,.06);
  --sh-card-h: 0 12px 44px rgba(8,12,24,.13),0 4px 12px rgba(8,12,24,.07);
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:'DM Sans',sans-serif;background:var(--ghost);color:var(--ink);overflow-x:hidden;font-size:16px;line-height:1.6}
h1,h2,h3,h4,h5,h6{font-family:'Syne',sans-serif;line-height:1.12;letter-spacing:-.3px}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--ink)}
::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}

/* SCROLL PROGRESS */
#scroll-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,var(--blue),var(--orange));z-index:9999;transition:width .1s linear}

/* NAVBAR */
.navbar{position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);background:rgba(255,255,255,.96);backdrop-filter:blur(20px) saturate(1.8);border-bottom:1px solid rgba(8,12,24,.07);transition:var(--t)}
.navbar.scrolled{background:rgba(255,255,255,.99);box-shadow:0 1px 20px rgba(8,12,24,.09)}
.nav-inner{max-width:1300px;margin:0 auto;padding:0 16px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}
.nav-brand{font-family:'Syne',sans-serif;font-size:1.18rem;font-weight:800;color:var(--ink);flex-shrink:0;letter-spacing:-.5px;display:flex;align-items:center;gap:6px}
.brand-dot{width:8px;height:8px;background:var(--blue);border-radius:50%;display:inline-block;flex-shrink:0;box-shadow:0 0 8px rgba(26,86,232,.6)}
.nav-brand em{font-style:normal;color:var(--orange)}
.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-item{position:relative}
.nl-a{font-size:.83rem;font-weight:600;color:var(--slate);padding:8px 11px;border-radius:var(--r-md);transition:var(--t);white-space:nowrap;display:flex;align-items:center;gap:4px;font-family:'DM Sans',sans-serif;letter-spacing:.01em}
.nl-a:hover,.nl-a.active{color:var(--blue);background:var(--blue-pale)}
.nl-a .arrow{font-size:.55rem;transition:transform .25s}
.nl-item:hover .arrow{transform:rotate(180deg)}

/* Mega dropdown */
.mega-drop{position:absolute;top:calc(100% + 10px);left:50%;transform:translateX(-50%) translateY(8px);min-width:540px;background:#fff;border-radius:var(--r-xl);border:1px solid rgba(8,12,24,.07);box-shadow:0 20px 60px rgba(8,12,24,.13);padding:22px;opacity:0;visibility:hidden;pointer-events:none;transition:all .2s var(--ease)}
.nl-item:hover .mega-drop{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
.mega-drop::before{content:'';position:absolute;top:-6px;left:50%;width:11px;height:11px;background:#fff;border-left:1px solid rgba(8,12,24,.07);border-top:1px solid rgba(8,12,24,.07);transform:translateX(-50%) rotate(45deg)}
.mega-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0}
.mega-col-label{font-size:.65rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;color:var(--blue);padding:0 8px 10px;display:block}
.mega-link{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:var(--r-md);font-size:.81rem;font-weight:500;color:var(--slate);transition:all .16s}
.mega-link i{width:17px;color:var(--blue);font-size:.78rem;flex-shrink:0}
.mega-link:hover{background:var(--blue-pale);color:var(--blue);transform:translateX(2px)}
.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}

/* HAMBURGER */
.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:44px;height:44px;background:none;border:none;cursor:pointer;border-radius:var(--r-md);transition:var(--t);flex-shrink:0;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
.ham-btn:hover,.ham-btn:focus{background:var(--blue-pale);outline:none}
.ham-line{display:block;width:22px;height:2px;background:var(--ink);border-radius:2px;transition:all .26s var(--ease);transform-origin:center;pointer-events:none}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(7px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:40px;height:40px;border-radius:var(--r-md);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.9rem;transition:var(--t);-webkit-tap-highlight-color:transparent;touch-action:manipulation;background:var(--blue-pale);color:var(--blue)}
.mob-quick-btn:hover{background:rgba(26,86,232,.16)}
.mob-quick-wa{width:40px;height:40px;border-radius:var(--r-md);background:rgba(37,211,102,.12);color:#25D366;display:flex;align-items:center;justify-content:center;font-size:.9rem;transition:var(--t);-webkit-tap-highlight-color:transparent}
.mob-quick-wa:hover{background:rgba(37,211,102,.22)}

/* Mobile overlay + panel */
.mob-overlay{position:fixed;inset:0;background:rgba(8,12,24,.55);backdrop-filter:blur(6px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(360px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;overflow-x:hidden;transform:translateX(100%);transition:transform .32s var(--ease);box-shadow:-12px 0 48px rgba(8,12,24,.18);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:38px;height:38px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.88rem;flex-shrink:0;-webkit-tap-highlight-color:transparent}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:11px;padding:13px 22px;font-size:.91rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px;-webkit-tap-highlight-color:transparent}
.mob-link i{width:19px;color:var(--blue);font-size:.84rem;flex-shrink:0}
.mob-link:hover{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-sub-toggle{display:flex;align-items:center;justify-content:space-between;padding:13px 22px;font-size:.91rem;font-weight:600;color:var(--ink);cursor:pointer;transition:var(--t);min-height:48px;-webkit-tap-highlight-color:transparent}
.mob-sub-toggle .left{display:flex;align-items:center;gap:11px}
.mob-sub-toggle .left i{width:19px;color:var(--blue);font-size:.84rem}
.mob-sub-toggle:hover{background:var(--blue-pale);color:var(--blue)}
.mob-sub-toggle .chev{font-size:.64rem;color:var(--slate);transition:transform .28s;flex-shrink:0}
.mob-sub-toggle.open .chev{transform:rotate(180deg)}
.mob-sub{background:rgba(26,86,232,.03);border-top:1px solid rgba(26,86,232,.07);border-bottom:1px solid rgba(26,86,232,.07);max-height:0;overflow:hidden;transition:max-height .35s ease}
.mob-sub.open{max-height:700px}
.mob-sub a{display:flex;align-items:center;gap:9px;padding:11px 22px 11px 50px;font-size:.83rem;color:var(--slate);transition:var(--t);min-height:44px;-webkit-tap-highlight-color:transparent}
.mob-sub a i{width:16px;color:var(--blue);font-size:.76rem;flex-shrink:0}
.mob-sub a:hover{color:var(--blue);background:rgba(26,86,232,.05);padding-left:56px}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 20px}
.mob-footer{padding:14px 18px 32px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:10px}

/* BUTTONS */
.btn-primary{display:inline-flex;align-items:center;gap:7px;background:var(--g-blue);color:#fff;border:none;cursor:pointer;padding:12px 26px;border-radius:var(--r-pill);font-weight:700;font-size:.87rem;font-family:'Syne',sans-serif;transition:var(--t);box-shadow:var(--sh-blue);white-space:nowrap;letter-spacing:.02em;touch-action:manipulation;-webkit-tap-highlight-color:transparent;text-align:center;justify-content:center}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 38px rgba(26,86,232,.36)}
.btn-orange{display:inline-flex;align-items:center;gap:7px;background:var(--g-orange);color:#fff;border:none;cursor:pointer;padding:12px 26px;border-radius:var(--r-pill);font-weight:700;font-size:.87rem;font-family:'Syne',sans-serif;transition:var(--t);box-shadow:var(--sh-orange);white-space:nowrap;letter-spacing:.02em;touch-action:manipulation;-webkit-tap-highlight-color:transparent;text-align:center;justify-content:center}
.btn-orange:hover{transform:translateY(-2px);box-shadow:0 14px 38px rgba(240,112,32,.38)}
.btn-outline{display:inline-flex;align-items:center;gap:7px;background:transparent;color:var(--blue);border:2px solid var(--blue);padding:10px 24px;border-radius:var(--r-pill);font-weight:700;font-size:.87rem;font-family:'Syne',sans-serif;transition:var(--t);cursor:pointer;white-space:nowrap;touch-action:manipulation;text-align:center;justify-content:center}
.btn-outline:hover{background:var(--g-blue);color:#fff;transform:translateY(-2px);box-shadow:var(--sh-blue)}
.btn-ghost-white{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.3);padding:11px 24px;border-radius:var(--r-pill);font-weight:700;font-size:.87rem;font-family:'Syne',sans-serif;transition:var(--t);cursor:pointer;white-space:nowrap;backdrop-filter:blur(8px);touch-action:manipulation;text-align:center;justify-content:center}
.btn-ghost-white:hover{background:rgba(255,255,255,.2);border-color:rgba(255,255,255,.55);transform:translateY(-2px)}
.btn-wa{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#25D366,#1aad54);color:#fff;border:none;padding:12px 24px;border-radius:var(--r-pill);font-weight:700;font-size:.87rem;font-family:'Syne',sans-serif;transition:var(--t);cursor:pointer;white-space:nowrap;box-shadow:0 6px 18px rgba(37,211,102,.28);touch-action:manipulation;text-align:center;justify-content:center}
.btn-wa:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(37,211,102,.42)}
.btn-nav-signin{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:var(--slate);padding:7px 16px;border:1.5px solid var(--mist);border-radius:var(--r-pill);font-family:'Syne',sans-serif;transition:var(--t);background:#fff;cursor:pointer;white-space:nowrap}
.btn-nav-signin:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-orange{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:var(--orange);padding:7px 16px;border:1.5px solid rgba(240,112,32,.35);border-radius:var(--r-pill);font-family:'Syne',sans-serif;transition:var(--t);background:var(--orange-pale);cursor:pointer;white-space:nowrap}
.btn-nav-orange:hover{background:var(--g-orange);color:#fff;border-color:transparent;box-shadow:var(--sh-orange)}
.btn-nav-start{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;font-weight:700;color:#fff;padding:8px 19px;border:none;border-radius:var(--r-pill);font-family:'Syne',sans-serif;transition:var(--t);background:var(--g-blue);cursor:pointer;box-shadow:var(--sh-blue);white-space:nowrap}
.btn-nav-start:hover{transform:translateY(-1px);box-shadow:0 12px 30px rgba(26,86,232,.38)}
.btn-pdf{display:inline-flex;align-items:center;gap:8px;background:var(--g-orange);color:#fff;border:none;padding:13px 30px;border-radius:var(--r-pill);font-weight:700;font-size:.9rem;font-family:'Syne',sans-serif;transition:var(--t);cursor:pointer;box-shadow:var(--sh-orange);touch-action:manipulation}
.btn-pdf:hover{transform:translateY(-2px);box-shadow:0 12px 34px rgba(240,112,32,.38)}

/* DARK MODE */
body.dark{background:var(--black);color:rgba(255,255,255,.87)}
body.dark .navbar{background:rgba(8,12,24,.97);border-bottom-color:rgba(255,255,255,.06)}
body.dark .navbar.scrolled{background:rgba(8,12,24,.99)}
body.dark .nl-a{color:rgba(255,255,255,.6)}
body.dark .nl-a:hover,.body.dark .nl-a.active{color:var(--blue-l);background:rgba(26,86,232,.1)}
body.dark .mega-drop{background:var(--ink-2);border-color:rgba(255,255,255,.08)}
body.dark .mega-drop::before{background:var(--ink-2);border-color:rgba(255,255,255,.08)}
body.dark .mega-link{color:rgba(255,255,255,.6)}
body.dark .mega-link:hover{background:rgba(26,86,232,.12);color:var(--blue-l)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:var(--ink-2)}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link,.mob-sub-toggle{color:rgba(255,255,255,.85)}
body.dark .mob-close{background:rgba(255,255,255,.08);color:rgba(255,255,255,.8)}
body.dark .mob-sub a{color:rgba(255,255,255,.55)}
body.dark .mob-hr{border-color:rgba(255,255,255,.08)}
body.dark .mob-footer{border-color:rgba(255,255,255,.08)}
body.dark .card-white{background:var(--ink-2)!important;border-color:rgba(255,255,255,.07)!important}
body.dark .text-muted,.body.dark .section-sub{color:rgba(255,255,255,.45)!important}
body.dark .bg-ghost{background:var(--ink-2)!important}
body.dark .bg-white-section{background:var(--ink)!important}
body.dark .tech-pill{background:var(--ink-2);border-color:rgba(255,255,255,.09);color:rgba(255,255,255,.78)}
body.dark .faq-item{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .faq-q{color:rgba(255,255,255,.87)}
body.dark .process-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .stat-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .testimonial-card{background:var(--ink-2);border-color:rgba(255,255,255,.08)}
body.dark .pricing-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .pricing-card.featured{background:var(--ink)}
body.dark .portfolio-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .team-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .blog-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .service-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .trust-strip{background:var(--ink-2);border-color:rgba(255,255,255,.06)}
body.dark .newsletter-box{background:var(--ink-2);border-color:rgba(255,255,255,.08)}
body.dark .nl-form-inp{background:var(--ink);border-color:rgba(255,255,255,.09);color:#fff}
body.dark .nl-form-inp::placeholder{color:rgba(255,255,255,.3)}
body.dark .btn-nav-signin{color:rgba(255,255,255,.6);border-color:rgba(255,255,255,.12);background:transparent}
body.dark .newsletter-section{background:linear-gradient(135deg,var(--ink-2),var(--ink))}
body.dark #theme-toggle{background:var(--ink-2);border-color:rgba(255,255,255,.1)}
body.dark #theme-toggle svg{stroke:rgba(255,255,255,.8)}

/* UTILITIES */
.container{max-width:1300px;margin:0 auto;padding:0 16px}
.section-py{padding:72px 0}
.section-py-sm{padding:52px 0}
.text-center{text-align:center}
.text-muted{color:var(--slate)}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-orange{background:var(--g-orange);-webkit-background-clip:text;background-clip:text;color:transparent}
.section-tag{display:inline-flex;align-items:center;gap:6px;background:var(--blue-pale);color:var(--blue);border-radius:var(--r-pill);padding:5px 16px;font-size:.67rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;border:1px solid rgba(26,86,232,.14)}
.section-tag::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue)}
.section-tag.orange{background:var(--orange-pale);color:var(--orange);border-color:rgba(240,112,32,.14)}
.section-tag.orange::before{background:var(--orange)}
.section-title{font-size:clamp(1.7rem,5vw,3.1rem);font-weight:800;margin-bottom:14px;line-height:1.1}
.section-sub{color:var(--slate);font-size:clamp(.88rem,2vw,1.05rem);line-height:1.72;max-width:560px}

/* Animations */
@keyframes float-a{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
@keyframes wa-ring{0%{inset:-2px;opacity:.7}100%{inset:-14px;opacity:0}}
@keyframes dot-flash{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.4);opacity:.5}}
@keyframes si-dot{0%{transform:translateY(0);opacity:1}60%{transform:translateY(14px);opacity:.2}61%{transform:translateY(0);opacity:0}62%{opacity:1}100%{opacity:1}}
@keyframes bounce-up{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-8px)}}

/* FIXED WIDGETS */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:44px;height:44px;background:#fff;border:1.5px solid rgba(8,12,24,.09);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 18px rgba(8,12,24,.1);transition:var(--t);touch-action:manipulation;-webkit-tap-highlight-color:transparent}
#theme-toggle svg{width:17px;height:17px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;display:block;transition:stroke .2s}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(22deg) scale(1.07);box-shadow:0 8px 26px rgba(26,86,232,.32)}
#theme-toggle:hover svg{stroke:#fff}

/* BACK-TO-TOP */
#back-to-top{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);z-index:10000;width:52px;height:52px;background:var(--g-blue);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .35s,transform .45s var(--spring),box-shadow .3s;box-shadow:var(--sh-blue),0 0 0 0 rgba(26,86,232,.3);touch-action:manipulation;-webkit-tap-highlight-color:transparent}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto;animation:bounce-up 2.4s ease-in-out infinite}
#back-to-top:hover{box-shadow:var(--sh-blue),0 0 0 8px rgba(26,86,232,.15);animation-play-state:paused}
#back-to-top svg{width:20px;height:20px;stroke:#fff;stroke-width:2.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
#back-to-top .btt-ring{position:absolute;inset:0;border-radius:50%;border:2px solid rgba(26,86,232,.4);animation:wa-ring 2.4s ease-out infinite}

/* ─── WHATSAPP FLOAT ─────────────────────────────── */
#wa-tooltip{position:fixed;bottom:160px;right:22px;z-index:10002;background:#fff;color:#111;border-radius:14px 14px 4px 14px;padding:11px 32px 11px 13px;box-shadow:0 8px 32px rgba(0,0,0,.18);font-size:.78rem;font-weight:600;font-family:'DM Sans',sans-serif;max-width:215px;line-height:1.45;opacity:0;pointer-events:none;transform:translateY(8px) scale(.94);transition:opacity .28s,transform .3s cubic-bezier(.34,1.56,.64,1);border:1px solid rgba(37,211,102,.2)}
#wa-tooltip.show{opacity:1;pointer-events:auto;transform:translateY(0) scale(1)}
#wa-tooltip strong{color:#128C7E;display:block;margin-bottom:2px;font-size:.8rem}
#wa-tooltip .tt-close{position:absolute;top:7px;right:9px;font-size:.65rem;color:#999;cursor:pointer;background:none;border:none;line-height:1;padding:2px;transition:color .2s}
#wa-tooltip .tt-close:hover{color:#ef4444}
/* Arrow on tooltip */
#wa-tooltip::after{content:'';position:absolute;bottom:-8px;right:18px;width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:8px solid #fff;filter:drop-shadow(0 2px 4px rgba(0,0,0,.08))}

#wa-float{position:fixed;bottom:88px;right:20px;z-index:10001;cursor:pointer;text-decoration:none;display:block}
.wa-ring-1,.wa-ring-2{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-ripple 2.8s ease-out infinite;pointer-events:none}
.wa-ring-2{animation-delay:1.15s}
@keyframes wa-ripple{0%{transform:scale(1);opacity:.65}100%{transform:scale(1.9);opacity:0}}
.wa-pill{display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#128C7E 0%,#075E54 100%);border-radius:999px;padding:9px 18px 9px 9px;box-shadow:0 6px 28px rgba(18,140,126,.42),0 2px 8px rgba(0,0,0,.12);transition:transform .32s cubic-bezier(.34,1.56,.64,1),box-shadow .3s;position:relative;overflow:visible;white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-4px) scale(1.03);box-shadow:0 16px 40px rgba(18,140,126,.55),0 4px 12px rgba(0,0,0,.14)}
.wa-icon-circle{width:38px;height:38px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;position:relative;transition:transform .3s}
#wa-float:hover .wa-icon-circle{transform:rotate(-10deg) scale(1.08)}
.wa-status-dot{position:absolute;top:1px;right:1px;width:10px;height:10px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite}
@keyframes dot-pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.45);opacity:.6}}
.wa-text-wrap{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.67rem;color:rgba(255,255,255,.65);letter-spacing:.3px;font-weight:600}
.wa-cta{font-size:.9rem;color:#fff;font-weight:800;font-family:'Syne',sans-serif;letter-spacing:-.2px}
.wa-arrow-icon{color:rgba(255,255,255,.7);font-size:.72rem;margin-left:2px;transition:transform .24s}
#wa-float:hover .wa-arrow-icon{transform:translateX(3px)}
.wa-badge{position:absolute;top:-5px;right:-5px;width:19px;height:19px;background:#ef4444;border:2px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.6rem;color:#fff;font-weight:800;transition:opacity .3s,transform .3s;animation:badge-pop .55s cubic-bezier(.34,1.56,.64,1) both}
@keyframes badge-pop{0%{transform:scale(0)}100%{transform:scale(1)}}

/* Mobile: collapse to round */
@media(max-width:767px){
  #wa-float{bottom:78px;right:16px}
  .wa-text-wrap{display:none}
  .wa-arrow-icon{display:none}
  .wa-pill{padding:0;width:56px;height:56px;border-radius:50%;justify-content:center}
  .wa-icon-circle{width:56px;height:56px;font-size:1.5rem}
  #wa-tooltip{bottom:144px;right:12px;max-width:185px}
  .wa-ring-1,.wa-ring-2{border-radius:50%}
  #theme-toggle{bottom:14px;left:14px}
  #back-to-top{bottom:14px;width:48px;height:48px}
}
@media(min-width:768px) and (max-width:991px){
  #wa-float{bottom:88px;right:18px}
  .wa-pill{padding:8px 15px 8px 8px}
  .wa-cta{font-size:.83rem}
}

/* SCROLL INDICATOR */
#scroll-ind{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer;z-index:100;opacity:1;transition:opacity .5s}
#scroll-ind.hidden{opacity:0;pointer-events:none}
.si-pill{width:22px;height:38px;border:1.5px solid rgba(255,255,255,.3);border-radius:11px;display:flex;align-items:flex-start;justify-content:center;padding-top:5px}
.si-dot{width:3px;height:7px;background:#fff;border-radius:2px;animation:si-dot 1.8s ease-in-out infinite}
.si-label{font-size:8px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:rgba(255,255,255,.45)}

/* TOAST */
#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-lg);padding:13px 18px;font-size:.84rem;display:flex;align-items:center;gap:10px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:220px;max-width:calc(100vw - 44px);white-space:nowrap}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* COOKIE */
#cookie-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.82);padding:12px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;z-index:9998;transform:translateY(100%);transition:transform .4s;border-top:1px solid rgba(255,255,255,.07);flex-wrap:wrap}
#cookie-bar.show{transform:translateY(0)}
#cookie-bar p{font-size:.79rem;margin:0;flex:1;min-width:200px}
#cookie-accept{background:var(--blue);color:#fff;border:none;padding:8px 20px;border-radius:var(--r-pill);font-size:.81rem;cursor:pointer;font-family:'Syne',sans-serif;font-weight:700;transition:var(--t);flex-shrink:0}
#cookie-accept:hover{background:var(--blue-d)}

/* HERO */
.hero{min-height:100svh;padding-top:var(--nav-h);background:var(--g-hero);position:relative;overflow:hidden;display:flex;align-items:center}
.hero-mesh{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.hero-mesh::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(26,86,232,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(26,86,232,.055) 1px,transparent 1px);background-size:40px 40px}
.hero-glow-1{position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(26,86,232,.22) 0%,transparent 70%);top:-180px;right:-80px;pointer-events:none}
.hero-glow-2{position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(240,112,32,.14) 0%,transparent 70%);bottom:-40px;left:20px;pointer-events:none}
.hero-glow-3{position:absolute;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(240,112,32,.08) 0%,transparent 70%);top:45%;left:42%;transform:translate(-50%,-50%);pointer-events:none}
.hero-noise{position:absolute;inset:0;pointer-events:none;opacity:.03;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");background-size:200px 200px}
.hero-inner{position:relative;z-index:1;display:flex;flex-direction:column;gap:32px;padding:52px 0 80px;width:100%}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);border-radius:var(--r-pill);padding:5px 14px;color:rgba(255,255,255,.78);font-size:.75rem;font-weight:700;margin-bottom:16px;backdrop-filter:blur(8px);letter-spacing:.5px;align-self:flex-start}
.hero-eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--emerald);animation:pulse-dot 2s infinite;flex-shrink:0}
.hero h1{font-size:clamp(2rem,8vw,4.6rem);font-weight:800;color:#fff;line-height:1.06;margin-bottom:18px}
.hero h1 .accent{background:linear-gradient(135deg,var(--orange-l),var(--orange),var(--orange-d));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-sub{color:rgba(255,255,255,.6);font-size:clamp(.9rem,3vw,1.08rem);line-height:1.78;margin-bottom:28px}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap}
.hero-actions .btn-primary,.hero-actions .btn-orange,.hero-actions .btn-wa{padding:13px 22px;font-size:.9rem;flex:1;min-width:140px;max-width:240px}
.hero-trust{display:flex;gap:16px;flex-wrap:wrap;margin-top:20px}
.hero-trust-item{display:flex;align-items:center;gap:6px;font-size:.77rem;color:rgba(255,255,255,.55);font-weight:600}
.hero-trust-item i{color:var(--orange);font-size:.78rem}
.code-box{background:rgba(8,12,24,.85);border:1px solid rgba(26,86,232,.28);border-radius:var(--r-xl);padding:24px 28px;font-family:'JetBrains Mono',monospace;font-size:.77rem;line-height:1.88;position:relative;backdrop-filter:blur(16px);animation:float-a 5.5s ease-in-out infinite}
.code-box::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--blue),var(--orange));border-radius:var(--r-xl) var(--r-xl) 0 0}
.code-dots{display:flex;gap:6px;margin-bottom:16px}
.code-dots span{width:9px;height:9px;border-radius:50%}
.code-dots span:nth-child(1){background:#ef4444}
.code-dots span:nth-child(2){background:var(--orange)}
.code-dots span:nth-child(3){background:var(--emerald)}
.kw{color:#7c9ef8}.fn{color:#4fd1a5}.str{color:var(--orange-l)}.cm{color:#3d5073}
.cursor{display:inline-block;width:2px;height:.9em;background:var(--blue-l);animation:blink 1s step-end infinite;vertical-align:text-bottom;margin-left:2px}
.hero-chips{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap}
.chip{padding:7px 14px;border-radius:var(--r-pill);font-size:.73rem;font-weight:700}
.chip-blue{background:rgba(26,86,232,.14);border:1px solid rgba(26,86,232,.28);color:#7eaaff}
.chip-orange{background:rgba(240,112,32,.14);border:1px solid rgba(240,112,32,.28);color:var(--orange-l)}

/* LEARN BANNER */
.learn-banner{background:linear-gradient(135deg,#003d37 0%,#004d40 50%,#00695c 100%);padding:20px 0;border-bottom:1px solid rgba(0,176,156,.2);position:relative;overflow:hidden}
.learn-banner::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(0,176,156,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(0,176,156,.06) 1px,transparent 1px);background-size:36px 36px}
.learn-banner-inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.learn-banner-icon{width:44px;height:44px;background:rgba(0,176,156,.2);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;color:var(--teal);font-size:1.2rem;border:1px solid rgba(0,176,156,.3);flex-shrink:0}
.learn-banner-text{display:flex;align-items:center;gap:12px;flex:1;min-width:0}
.learn-banner-content h4{font-size:.92rem;font-weight:700;color:#fff;margin-bottom:2px}
.learn-banner-content p{font-size:.77rem;color:rgba(255,255,255,.55);margin:0}
.learn-banner-badges{display:flex;gap:7px;flex-wrap:wrap}
.learn-badge{padding:4px 11px;border-radius:var(--r-pill);font-size:.67rem;font-weight:700;background:rgba(255,255,255,.08);color:rgba(255,255,255,.7);border:1px solid rgba(255,255,255,.1)}

/* MARQUEE */
.marquee-wrap{background:var(--blue);padding:10px 0;overflow:hidden;white-space:nowrap}
.marquee-track{display:inline-flex;animation:marquee 30s linear infinite}
.marquee-track:hover{animation-play-state:paused}
.marquee-item{display:inline-flex;align-items:center;gap:8px;padding:0 26px;color:rgba(255,255,255,.9);font-size:.84rem;font-weight:600}
.marquee-sep{opacity:.3}

/* TRUST STRIP */
.trust-strip{background:#fff;border-top:1px solid var(--mist);border-bottom:1px solid var(--mist);padding:18px 0;overflow-x:auto}
.trust-inner{display:flex;flex-wrap:wrap;justify-content:center;gap:20px 28px}
.trust-item{display:flex;align-items:center;gap:8px;font-size:.79rem;font-weight:700;color:var(--ink);white-space:nowrap}
.trust-item i{font-size:.95rem}

/* SERVICES */
.services-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.service-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);overflow:hidden;position:relative;transition:var(--t);cursor:pointer;display:block;text-decoration:none;color:inherit}
.service-card:hover{transform:translateY(-5px);box-shadow:var(--sh-card-h);border-color:rgba(26,86,232,.18)}
.service-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2.5px;background:linear-gradient(90deg,var(--blue),var(--orange));transform:scaleX(0);transform-origin:left;transition:transform .38s;z-index:3}
.service-card:hover::before{transform:scaleX(1)}
.svc-img-wrap{height:130px;overflow:hidden;position:relative}
.svc-img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.service-card:hover .svc-img{transform:scale(1.07)}
.svc-overlay{position:absolute;inset:0;background:rgba(255,255,255,.97);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;opacity:0;transition:opacity .28s;z-index:2;text-align:center;padding:16px;backdrop-filter:blur(6px)}
.service-card:hover .svc-overlay{opacity:1}
.svc-ov-icon{width:46px;height:46px;background:var(--g-blue);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.1rem;transform:scale(.8);transition:transform .32s var(--spring) .04s}
.service-card:hover .svc-ov-icon{transform:scale(1)}
.svc-ov-title{font-family:'Syne',sans-serif;font-weight:700;font-size:.86rem;color:var(--blue);transform:translateY(5px);transition:transform .28s .06s}
.svc-ov-sub{font-size:.7rem;color:var(--slate);transform:translateY(5px);transition:transform .28s .09s}
.service-card:hover .svc-ov-title,.service-card:hover .svc-ov-sub{transform:translateY(0)}
.svc-ov-btn{display:inline-flex;align-items:center;gap:5px;background:var(--g-blue);color:#fff;padding:6px 14px;border-radius:var(--r-pill);font-size:.72rem;font-weight:700;transform:translateY(5px);transition:transform .28s .12s;font-family:'Syne',sans-serif}
.service-card:hover .svc-ov-btn{transform:translateY(0)}
.svc-icon-wrap{position:relative;z-index:2;margin:-20px 0 10px 16px;width:44px;height:44px;background:#fff;border-radius:22px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(8,12,24,.09);border:1px solid var(--mist)}
.svc-body{padding:0 16px 16px}
.svc-body h3{font-size:.95rem;font-weight:700;margin-bottom:5px}
.svc-body p{font-size:.79rem;color:var(--slate);line-height:1.55;margin-bottom:10px}
.svc-pill{display:inline-flex;align-items:center;gap:4px;font-size:.67rem;font-weight:800;color:var(--blue);background:var(--blue-pale);padding:4px 11px;border-radius:var(--r-pill);transition:var(--t);font-family:'Syne',sans-serif}
.service-card:hover .svc-pill{background:var(--blue);color:#fff}

/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.stat-card{background:#fff;border-radius:var(--r-xl);padding:24px 18px;text-align:center;border:1px solid var(--mist);transition:var(--t);position:relative;overflow:hidden}
.stat-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--g-blue);transform:scaleX(0);transform-origin:left;transition:transform .35s}
.stat-card:hover{transform:translateY(-4px);box-shadow:var(--sh-card-h)}
.stat-card:hover::after{transform:scaleX(1)}
.stat-num{font-family:'Syne',sans-serif;font-size:clamp(1.8rem,6vw,3rem);font-weight:800}
.stat-label{font-size:.79rem;color:var(--slate);margin-top:5px;font-weight:500}

/* PROCESS */
.process-grid{display:grid;grid-template-columns:1fr;gap:14px}
.process-card{background:#fff;border-radius:var(--r-xl);padding:26px 22px;border:1px solid var(--mist);transition:var(--t);position:relative}
.process-card:hover{transform:translateY(-4px);box-shadow:var(--sh-card-h)}
.process-num{font-family:'Syne',sans-serif;font-size:2.4rem;font-weight:800;background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1;margin-bottom:12px;opacity:.7}
.process-card h4{font-size:1rem;font-weight:700;margin-bottom:7px}
.process-card p{font-size:.82rem;color:var(--slate);line-height:1.62}
.process-arrow{display:none}

/* LEARN SECTION */
.learn-section{background:linear-gradient(158deg,#003d37 0%,#004d40 40%,#005248 100%);position:relative;overflow:hidden}
.learn-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 70% 50%,rgba(0,176,156,.2) 0%,transparent 60%),radial-gradient(ellipse at 20% 80%,rgba(240,112,32,.08) 0%,transparent 50%)}
.learn-section::after{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(0,176,156,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,176,156,.05) 1px,transparent 1px);background-size:44px 44px}
.learn-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr;gap:40px}
.learn-tag{display:inline-flex;align-items:center;gap:6px;background:rgba(0,176,156,.18);color:#5eead4;border-radius:var(--r-pill);padding:5px 14px;font-size:.67rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px;border:1px solid rgba(0,176,156,.25)}
.learn-tag::before{content:'';width:5px;height:5px;border-radius:50%;background:#5eead4}
.learn-inner h2{font-size:clamp(1.7rem,5vw,2.9rem);font-weight:800;color:#fff;margin-bottom:14px;line-height:1.1}
.learn-inner h2 span{color:var(--orange-l)}
.learn-inner p{color:rgba(255,255,255,.58);font-size:clamp(.88rem,2.5vw,1rem);line-height:1.75;margin-bottom:24px}
.learn-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.learn-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:var(--r-lg);padding:16px 14px;transition:var(--t)}
.learn-card:hover{background:rgba(255,255,255,.1);border-color:rgba(0,176,156,.3);transform:translateY(-3px)}
.learn-card-icon{font-size:1.5rem;margin-bottom:7px;display:block}
.learn-card h5{font-size:.87rem;font-weight:700;color:#fff;margin-bottom:3px}
.learn-card p{font-size:.74rem;color:rgba(255,255,255,.5);margin:0;line-height:1.5}
.learn-pill{display:inline-flex;align-items:center;gap:4px;background:rgba(0,176,156,.15);color:#5eead4;border-radius:var(--r-pill);padding:3px 10px;font-size:.65rem;font-weight:700;margin-top:7px}
.learn-actions{display:flex;gap:11px;flex-wrap:wrap}
.learn-meta{display:flex;gap:14px;flex-wrap:wrap;margin-top:12px}
.learn-meta-item{display:flex;align-items:center;gap:6px;font-size:.76rem;color:rgba(255,255,255,.5);font-weight:600}
.learn-meta-item i{color:#5eead4;font-size:.74rem}

/* GRAPHIC DESIGN */
.graphic-section{background:var(--g-dark);position:relative;overflow:hidden}
.graphic-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 50%,rgba(26,86,232,.1) 0%,transparent 60%),radial-gradient(ellipse at 80% 80%,rgba(240,112,32,.08) 0%,transparent 50%)}
.graphic-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;position:relative;z-index:1}
.graphic-card{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);border-radius:var(--r-xl);padding:20px 14px;text-align:center;color:#fff;transition:var(--t);cursor:pointer}
.graphic-card:hover{background:rgba(255,255,255,.09);border-color:rgba(240,112,32,.3);transform:translateY(-4px)}
.graphic-icon{font-size:1.7rem;margin-bottom:9px;display:block}
.graphic-card h4{font-size:.89rem;font-weight:700;margin-bottom:4px}
.graphic-card p{font-size:.73rem;color:rgba(255,255,255,.5);margin-bottom:9px}
.graphic-price{display:inline-block;background:rgba(240,112,32,.18);color:var(--orange-l);border-radius:var(--r-pill);padding:3px 11px;font-size:.66rem;font-weight:800}

/* TECH STACK */
.tech-wrap{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.tech-pill{display:inline-flex;align-items:center;gap:7px;background:#fff;border:1px solid var(--mist);border-radius:var(--r-md);padding:8px 13px;font-size:.8rem;font-weight:700;color:var(--ink);transition:var(--t);white-space:nowrap}
.tech-pill:hover{border-color:var(--blue);color:var(--blue);transform:translateY(-2px);box-shadow:0 7px 18px rgba(26,86,232,.11)}

/* PORTFOLIO */
.portfolio-grid{display:grid;grid-template-columns:1fr;gap:18px}
.portfolio-card{background:#fff;border-radius:var(--r-xl);overflow:hidden;border:1px solid var(--mist);transition:var(--t)}
.portfolio-card:hover{transform:translateY(-5px);box-shadow:var(--sh-card-h)}
.port-img-wrap{position:relative;overflow:hidden;height:180px}
.port-img{width:100%;height:100%;object-fit:cover;transition:transform .48s}
.portfolio-card:hover .port-img{transform:scale(1.06)}
.port-overlay{position:absolute;inset:0;background:rgba(26,86,232,.8);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .28s}
.portfolio-card:hover .port-overlay{opacity:1}
.port-overlay i{color:#fff;font-size:1.6rem;transform:scale(.8);transition:transform .28s}
.portfolio-card:hover .port-overlay i{transform:scale(1)}
.port-body{padding:16px}
.port-tag{display:inline-block;font-size:.65rem;font-weight:800;padding:3px 11px;border-radius:var(--r-pill);background:var(--blue-pale);color:var(--blue);text-transform:uppercase;letter-spacing:1px;margin-bottom:7px}
.port-body h4{font-size:1rem;font-weight:700;margin-bottom:5px}
.port-body .desc{font-size:.81rem;color:var(--slate);line-height:1.56;margin-bottom:9px}
.port-techs{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px}
.tech-sm{background:var(--blue-pale);color:var(--blue);padding:3px 9px;border-radius:var(--r-pill);font-size:.67rem;font-weight:700}
.port-filter-row{display:flex;gap:7px;flex-wrap:wrap;justify-content:center;margin-bottom:26px;overflow-x:auto;padding-bottom:4px}
.pf-btn{padding:7px 16px;border-radius:var(--r-pill);font-size:.78rem;font-weight:700;cursor:pointer;border:2px solid var(--blue);color:var(--blue);background:transparent;font-family:'Syne',sans-serif;transition:var(--t);white-space:nowrap;touch-action:manipulation}
.pf-btn.active,.pf-btn:hover{background:var(--g-blue);color:#fff;border-color:transparent}

/* TEAM */
.team-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.team-card{background:#fff;border-radius:var(--r-xl);padding:24px 16px;text-align:center;border:1px solid var(--mist);transition:var(--t)}
.team-card:hover{transform:translateY(-5px);box-shadow:var(--sh-card-h)}
.team-avatar{width:80px;height:80px;border-radius:50%;overflow:hidden;margin:0 auto 12px;background:var(--mist);position:relative}
.team-avatar img{width:100%;height:100%;object-fit:cover;transition:transform .32s}
.team-card:hover .team-avatar img{transform:scale(1.07)}
.team-avatar-fb{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:2.2rem;color:var(--blue)}
.team-card h5{font-size:.94rem;font-weight:700;margin-bottom:3px}
.team-role{font-size:.72rem;color:var(--orange);margin-bottom:7px;font-weight:600}
.team-bio{font-size:.77rem;color:var(--slate);line-height:1.56;margin-bottom:11px}
.team-socials{display:flex;justify-content:center;gap:7px}
.team-socials a{width:30px;height:30px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:var(--blue-pale);color:var(--blue);font-size:.8rem;transition:var(--t);touch-action:manipulation}
.team-socials a:hover{background:var(--blue);color:#fff;transform:translateY(-2px)}

/* PRICING */
.pricing-grid{display:grid;grid-template-columns:1fr;gap:14px}
.pricing-card{background:#fff;border-radius:var(--r-xl);padding:26px 20px;border:1px solid var(--mist);transition:var(--t);position:relative;display:flex;flex-direction:column}
.pricing-card:not(.featured):hover{transform:translateY(-4px);box-shadow:var(--sh-card-h)}
.pricing-card.featured{background:var(--ink);color:#fff;border:none;box-shadow:0 20px 52px rgba(8,12,24,.28)}
.badge-hot{position:absolute;top:14px;right:14px;background:var(--orange);color:#fff;font-size:.64rem;font-weight:800;padding:3px 10px;border-radius:var(--r-pill);letter-spacing:.5px;text-transform:uppercase}
.price-tier{font-size:.78rem;color:var(--slate);margin-bottom:5px;font-weight:500}
.pricing-card.featured .price-tier{color:rgba(255,255,255,.5)}
.price-val{font-family:'Syne',sans-serif;font-size:clamp(1.3rem,4vw,1.9rem);font-weight:800;margin-bottom:14px}
.price-list{list-style:none;flex-grow:1}
.price-list li{padding:6px 0;border-bottom:1px solid rgba(8,12,24,.05);display:flex;align-items:center;gap:8px;font-size:.81rem}
.pricing-card.featured .price-list li{border-bottom-color:rgba(255,255,255,.07)}
.price-list li .ok{color:var(--emerald)}
.price-list li .no{color:var(--slate);opacity:.55}

/* TESTIMONIALS */
.testimonial-grid{display:grid;grid-template-columns:1fr;gap:14px}
.testimonial-card{background:#fff;border-radius:var(--r-xl);padding:24px 20px;border:1px solid var(--mist);transition:var(--t);display:flex;flex-direction:column}
.testimonial-card:hover{transform:translateY(-4px);box-shadow:var(--sh-card-h)}
.t-stars{color:var(--orange);letter-spacing:2px;margin-bottom:11px;font-size:.95rem}
.t-quote{font-style:italic;color:var(--slate);line-height:1.76;font-size:.86rem;flex-grow:1;margin-bottom:16px}
.t-author{display:flex;align-items:center;gap:12px}
.t-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.t-name{font-weight:700;font-size:.85rem;font-family:'Syne',sans-serif}
.t-role{font-size:.72rem;color:var(--slate)}

/* BLOG */
.blog-grid{display:grid;grid-template-columns:1fr;gap:18px}
.blog-card{background:#fff;border-radius:var(--r-xl);padding:22px;border:1px solid var(--mist);transition:var(--t);display:flex;flex-direction:column}
.blog-card:hover{transform:translateY(-4px);box-shadow:var(--sh-card-h)}
.blog-meta{font-size:.71rem;color:var(--slate);margin-bottom:7px}
.blog-cat{display:inline-block;font-size:.64rem;font-weight:800;padding:3px 11px;border-radius:var(--r-pill);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}
.blog-cat.dev{background:var(--blue-pale);color:var(--blue)}
.blog-cat.ai{background:rgba(13,191,126,.09);color:var(--emerald)}
.blog-cat.ui{background:var(--orange-pale);color:var(--orange)}
.blog-card h4{font-size:.96rem;font-weight:700;margin-bottom:7px;line-height:1.4}
.blog-card .desc{font-size:.81rem;color:var(--slate);line-height:1.62;flex-grow:1;margin-bottom:13px}

/* FAQ */
.faq-grid{display:grid;grid-template-columns:1fr;gap:9px}
.faq-item{background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);overflow:hidden;transition:border-color .25s}
.faq-item:hover{border-color:var(--blue)}
.faq-q{padding:14px 18px;font-weight:700;font-size:.86rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'Syne',sans-serif;transition:var(--t);min-height:52px;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.faq-icon{color:var(--blue);font-size:.76rem;transition:transform .28s;flex-shrink:0;margin-left:12px}
.faq-a{padding:0 18px;max-height:0;overflow:hidden;transition:all .3s;color:var(--slate);font-size:.84rem;line-height:1.72}
.faq-item.open .faq-a{max-height:220px;padding:0 18px 14px}
.faq-item.open .faq-icon{transform:rotate(45deg)}

/* CONTACT */
.contact-section{background:var(--g-dark);position:relative;overflow:hidden}
.contact-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 60% 30%,rgba(26,86,232,.1) 0%,transparent 55%),radial-gradient(ellipse at 20% 80%,rgba(240,112,32,.06) 0%,transparent 50%)}
.contact-form-wrap{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:var(--r-xl);padding:24px 18px;backdrop-filter:blur(12px);transition:border-color .28s;position:relative;z-index:1}
.contact-form-wrap:hover{border-color:rgba(255,255,255,.16)}
.f-label{font-size:.78rem;font-weight:600;color:rgba(255,255,255,.7);display:block;margin-bottom:6px}
.f-input{width:100%;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);border-radius:var(--r-md);color:#fff;padding:12px 14px;font-size:16px;font-family:'DM Sans',sans-serif;transition:var(--t);outline:none}
.f-input:focus{background:rgba(255,255,255,.1);border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,86,232,.2)}
.f-input::placeholder{color:rgba(255,255,255,.3)}
select.f-input option{background:var(--ink-2);color:#fff}
.svc-checks{display:flex;gap:7px;flex-wrap:wrap}
.svc-chk{display:inline-flex;align-items:center;gap:5px;cursor:pointer}
.svc-chk input{display:none}
.svc-chk span{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.13);color:rgba(255,255,255,.6);border-radius:var(--r-pill);padding:6px 13px;font-size:.74rem;font-weight:600;transition:var(--t);cursor:pointer;touch-action:manipulation;min-height:34px;display:flex;align-items:center}
.svc-chk input:checked+span{background:var(--blue);border-color:var(--blue);color:#fff}
.svc-chk:hover span{background:rgba(255,255,255,.12)}
.or-div{text-align:center;position:relative;margin:16px 0}
.or-div::before,.or-div::after{content:'';position:absolute;top:50%;width:calc(50% - 55px);height:1px;background:rgba(255,255,255,.12)}
.or-div::before{left:0}.or-div::after{right:0}
.or-div span{background:rgba(255,255,255,.04);padding:5px 12px;border-radius:var(--r-pill);font-size:.74rem;color:rgba(255,255,255,.4)}
.contact-info-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:var(--r-lg);padding:15px 12px;text-align:center;transition:var(--t)}
.contact-info-card:hover{background:rgba(255,255,255,.08);transform:translateY(-3px)}
.ci-icon{width:40px;height:40px;background:rgba(26,86,232,.18);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 9px;color:var(--orange);font-size:1rem;transition:var(--t)}
.contact-info-card:hover .ci-icon{background:var(--g-blue);color:#fff}
.contact-info-card h6{color:#fff;font-size:.79rem;font-weight:700;margin-bottom:3px}
.contact-info-card a,.contact-info-card span{font-size:.74rem;color:rgba(255,255,255,.48);word-break:break-all}
.contact-info-card a:hover{color:var(--orange)}

/* NEWSLETTER */
.newsletter-section{background:linear-gradient(135deg,#eef2ff,#ecfdf5)}
.newsletter-box{background:#fff;border-radius:var(--r-xl);padding:28px 20px;border:1px solid var(--mist);box-shadow:var(--sh-card);transition:var(--t)}
.newsletter-box:hover{transform:translateY(-2px);box-shadow:var(--sh-card-h)}
.nl-icon{width:48px;height:48px;background:var(--blue-pale);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.35rem;color:var(--blue);margin-bottom:12px}
.nl-form{position:relative;display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.nl-form-inp{flex:1;min-width:0;padding:13px 14px 13px 42px;border:2px solid var(--mist);border-radius:var(--r-pill);font-size:16px;font-family:'DM Sans',sans-serif;transition:var(--t);background:#fff;color:var(--ink);outline:none}
.nl-form-inp:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,86,232,.09)}
.nl-form i{position:absolute;left:15px;color:var(--slate);font-size:.88rem;pointer-events:none;top:50%;transform:translateY(-50%)}
.nl-submit{background:var(--g-blue);color:#fff;border:none;padding:12px 20px;border-radius:var(--r-pill);font-weight:700;font-size:.82rem;font-family:'Syne',sans-serif;transition:var(--t);cursor:pointer;white-space:nowrap;flex-shrink:0;touch-action:manipulation}
.nl-submit:hover{background:var(--g-orange)}
.nl-submit:disabled{opacity:.65;cursor:not-allowed}

/* CTA BAND */
.cta-section{background:linear-gradient(135deg,var(--blue) 0%,var(--blue-d) 40%,#1a3aa8 100%)}
.cta-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.cta-btn-white{background:#fff;color:var(--blue);font-weight:800;border-radius:var(--r-pill);padding:13px 26px;font-size:.9rem;font-family:'Syne',sans-serif;display:inline-flex;align-items:center;gap:7px;transition:var(--t);box-shadow:0 6px 22px rgba(0,0,0,.14);touch-action:manipulation}
.cta-btn-white:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,0,0,.22)}
.cta-btn-orange{background:var(--g-orange);color:#fff;font-weight:800;border-radius:var(--r-pill);padding:13px 24px;font-size:.9rem;font-family:'Syne',sans-serif;display:inline-flex;align-items:center;gap:7px;transition:var(--t);box-shadow:var(--sh-orange);touch-action:manipulation}
.cta-btn-orange:hover{transform:translateY(-2px);box-shadow:0 12px 34px rgba(240,112,32,.42)}

/* ─── FOOTER — PROFESSIONAL & RESPONSIVE ─────────────── */
footer{background:#070c1a;color:rgba(255,255,255,.52);padding:0;font-size:.82rem;border-top:1px solid rgba(255,255,255,.06)}

.footer-accent-bar{height:3px;background:linear-gradient(90deg,#1a56e8,#f07020,#1a56e8);background-size:200% 100%;animation:bar-shift 6s linear infinite}
@keyframes bar-shift{0%{background-position:0% 0%}100%{background-position:200% 0%}}

.footer-cta-strip{background:linear-gradient(135deg,#0d1936 0%,#101f3a 100%);border-bottom:1px solid rgba(255,255,255,.06);padding:30px 0}
.footer-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.footer-cta-text h4{font-family:'Syne',sans-serif;font-size:clamp(1rem,3vw,1.4rem);font-weight:800;color:#fff;margin-bottom:3px;line-height:1.2}
.footer-cta-text p{font-size:.78rem;color:rgba(255,255,255,.42);margin:0}
.footer-cta-actions{display:flex;gap:10px;flex-wrap:wrap;flex-shrink:0}

.footer-body{padding:52px 0 36px}

.footer-cols{display:grid;grid-template-columns:2fr 1fr 1fr 1.6fr;gap:36px 28px}

.footer-brand-name{font-family:'Syne',sans-serif;font-size:1.15rem;font-weight:800;color:#fff;letter-spacing:-.4px;display:flex;align-items:center;gap:7px;margin-bottom:10px}
.footer-brand-name em{font-style:normal;color:#f07020}
.footer-brand-dot{width:8px;height:8px;background:#1a56e8;border-radius:50%;box-shadow:0 0 8px rgba(26,86,232,.6);flex-shrink:0}
.footer-tagline{font-size:.79rem;color:rgba(255,255,255,.4);line-height:1.72;max-width:280px;margin-bottom:18px}

.footer-socials{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.fsoc{width:34px;height:34px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.07);color:rgba(255,255,255,.55);font-size:.82rem;transition:all .22s;text-decoration:none}
.fsoc:hover{transform:translateY(-3px)}
.fsoc.tw:hover{background:#1da1f2;color:#fff}
.fsoc.li:hover{background:#0077b5;color:#fff}
.fsoc.gh:hover{background:#fff;color:#111}
.fsoc.ig:hover{background:linear-gradient(135deg,#fd5949,#d6249f,#285aeb);color:#fff}
.fsoc.yt:hover{background:#ff0000;color:#fff}
.fsoc.wa:hover{background:#25D366;color:#fff}

.footer-col-title{font-family:'Syne',sans-serif;font-size:.68rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.32);margin-bottom:16px;display:flex;align-items:center;gap:7px}
.footer-col-title::before{content:'';display:inline-block;width:12px;height:2px;background:#1a56e8;border-radius:2px;flex-shrink:0}
.footer-links{list-style:none;padding:0;margin:0}
.footer-links li{margin-bottom:9px}
.footer-links a{color:rgba(255,255,255,.46);text-decoration:none;font-size:.79rem;transition:color .2s,padding-left .2s;display:inline-flex;align-items:center;gap:6px}
.footer-links a:hover{color:#fff;padding-left:3px}
.footer-links a i{width:14px;font-size:.7rem;flex-shrink:0;opacity:.55}
.footer-links a.academy-link{color:#5eead4;font-weight:600}
.footer-links a.academy-link:hover{color:#fff}

.footer-contact-item{display:flex;align-items:flex-start;gap:10px;margin-bottom:13px}
.fci-icon{width:30px;height:30px;flex-shrink:0;background:rgba(26,86,232,.12);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#1a56e8;font-size:.73rem;margin-top:1px}
.fci-text{display:flex;flex-direction:column;gap:2px}
.fci-label{font-size:.62rem;color:rgba(255,255,255,.28);font-weight:700;letter-spacing:.6px;text-transform:uppercase}
.fci-val{font-size:.79rem;color:rgba(255,255,255,.68)}
.fci-val a{color:rgba(255,255,255,.68);text-decoration:none;transition:color .2s}
.fci-val a:hover{color:#f07020}

.footer-hours{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:7px 11px;font-size:.72rem;color:rgba(255,255,255,.42);margin-top:4px}
.hours-dot{width:6px;height:6px;background:#0dbf7e;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite;flex-shrink:0}

.footer-divider{border:none;border-top:1px solid rgba(255,255,255,.07);margin:0}

.footer-bottom-bar{padding:18px 0}
.footer-bottom-inner{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.footer-copy{font-size:.74rem;color:rgba(255,255,255,.26)}
.footer-legal{display:flex;gap:20px;flex-wrap:wrap}
.footer-legal a{font-size:.72rem;color:rgba(255,255,255,.28);text-decoration:none;transition:color .2s}
.footer-legal a:hover{color:rgba(255,255,255,.65)}
.footer-made-in{font-size:.72rem;color:rgba(255,255,255,.2);display:flex;align-items:center;gap:4px}
.footer-made-in span{color:#f07020}

/* Footer responsive breakpoints */
@media(max-width:1023px){
  .footer-cols{grid-template-columns:1fr 1fr;gap:28px 24px}
  .footer-col-brand{grid-column:1 / -1}
}
@media(max-width:539px){
  .footer-cols{grid-template-columns:1fr 1fr;gap:22px 14px}
  .footer-col-brand{grid-column:1 / -1}
  .footer-col-contact{grid-column:1 / -1}
  .footer-cta-inner{flex-direction:column;align-items:flex-start}
  .footer-cta-actions{width:100%}
  .footer-cta-actions a{flex:1;justify-content:center}
  .footer-bottom-inner{flex-direction:column;align-items:center;text-align:center;gap:10px}
  .footer-legal{justify-content:center;gap:12px}
  .footer-cta-strip{padding:22px 0}
}

body.dark footer{background:#050810}
body.dark .footer-cta-strip{background:linear-gradient(135deg,#090e1f,#0d1530)}

/* FORM HELPERS */
.form-row{display:grid;gap:12px}
.form-row.cols-2{grid-template-columns:1fr}
.form-group{display:flex;flex-direction:column}
.mt-12{margin-top:12px}.mt-16{margin-top:16px}.mt-20{margin-top:20px}
.mt-24{margin-top:24px}.mt-32{margin-top:32px}.mt-40{margin-top:40px}
.mb-0{margin-bottom:0}.mb-8{margin-bottom:8px}
.flex{display:flex}.flex-wrap{flex-wrap:wrap}.gap-8{gap:8px}.gap-12{gap:12px}.gap-16{gap:16px}
.items-center{align-items:center}.justify-center{justify-content:center}.justify-between{justify-content:space-between}
.grid-contact-info{display:grid;grid-template-columns:1fr;gap:10px}
.nl-grid{display:grid;grid-template-columns:1fr;gap:24px}

/* TABLET 600px+ */
@media(min-width:600px){
  .container{padding:0 24px}
  .services-grid{grid-template-columns:repeat(2,1fr)}
  .graphic-grid{grid-template-columns:repeat(2,1fr)}
  .portfolio-grid{grid-template-columns:repeat(2,1fr)}
  .testimonial-grid{grid-template-columns:repeat(2,1fr)}
  .blog-grid{grid-template-columns:repeat(2,1fr)}
  .process-grid{grid-template-columns:repeat(2,1fr)}
  .faq-grid{grid-template-columns:1fr 1fr}
  .grid-contact-info{grid-template-columns:repeat(3,1fr)}
  .form-row.cols-2{grid-template-columns:1fr 1fr}
  .pricing-grid{grid-template-columns:repeat(2,1fr)}
  .hero-actions .btn-primary,.hero-actions .btn-orange,.hero-actions .btn-wa{flex:initial;min-width:auto}
}

/* DESKTOP 992px+ */
@media(min-width:992px){
  :root{--nav-h:70px}
  .container{padding:0 28px}
  .nav-inner{padding:0 28px}
  .nav-links{display:flex}
  .nav-cta{display:flex}
  .ham-btn{display:none!important}
  .mob-quick{display:none!important}
  .hero-inner{flex-direction:row;align-items:center;gap:52px;padding:72px 0 88px}
  .hero-inner>div:first-child{flex:1}
  .hero-inner>div:last-child{flex:1;flex-shrink:0}
  .hero h1{font-size:clamp(2.5rem,4.5vw,4.6rem)}
  .hero-actions{flex-wrap:nowrap}
  .hero-actions .btn-primary,.hero-actions .btn-orange,.hero-actions .btn-wa{flex:initial;padding:13px 24px;font-size:.93rem;min-width:auto;max-width:none}
  .services-grid{grid-template-columns:repeat(4,1fr)}
  .graphic-grid{grid-template-columns:repeat(4,1fr)}
  .portfolio-grid{grid-template-columns:repeat(3,1fr)}
  .testimonial-grid{grid-template-columns:repeat(3,1fr)}
  .blog-grid{grid-template-columns:repeat(3,1fr)}
