let allUsers=[];
async function loadUsers(){const d=await api('/api/admin/users');allUsers=d?.users||[];renderUsers(allUsers);}
function renderUsers(arr){
  const tb=document.getElementById('usersBody');if(!tb)return;
  const rolePill=r=>r==='admin'?'pill-o':r==='instructor'?'pill-t':'pill-b';
  tb.innerHTML=arr.length
    ?arr.map(u=>`<tr><td class="td-name">${esc(u.username)}</td><td><a href="mailto:${esc(u.email)}" style="color:var(--blue-l)">${esc(u.email)}</a></td><td><span class="pill ${rolePill(u.role)}">${esc(u.role)}</span></td><td><span class="pill ${u.is_active?'pill-g':'pill-dim'}">${u.is_active?'Active':'Inactive'}</span></td><td>${fmt(u.created_at)}</td><td>${u.last_login?fmt(u.last_login):'<span style="color:rgba(255,255,255,.2)">Never</span>'}</td><td><button class="act-btn act-role" onclick="toggleRole(${u.id},'${u.role}')" title="Toggle admin role"><i class="fas fa-shield-halved"></i></button><button class="act-btn act-orange" onclick="promoteUserById(${u.id},'${esc(u.username)}')" title="Make instructor"><i class="fas fa-chalkboard-teacher"></i></button><button class="act-btn act-del" onclick="deleteUser(${u.id})" title="Delete"><i class="fas fa-trash"></i></button></td></tr>`)
    .join('')
    :`<tr><td colspan="7"><div class="adm-empty"><i class="fas fa-users"></i><p>No users found</p></div></td></tr>`;
}
function filterUsers(q){renderUsers(allUsers.filter(u=>u.username.toLowerCase().includes(q.toLowerCase())||u.email.toLowerCase().includes(q.toLowerCase())));}
async function createUser(){
  const name=document.getElementById('newUserName').value.trim(),email=document.getElementById('newUserEmail').value.trim(),pwd=document.getElementById('newUserPassword').value;
  if(!name||!email||!pwd)return toast('Please fill all fields','error');
  const r=await api('/api/signup',{method:'POST',body:JSON.stringify({fullname:name,email,password:pwd})});
  if(r?.success){toast('User created!');closeModal('modal-add-user');['newUserName','newUserEmail','newUserPassword'].forEach(id=>document.getElementById(id).value='');loadUsers();loadDashboard();}
}
async function deleteUser(id){if(!confirm('Delete this user? This cannot be undone.'))return;const r=await api(`/api/admin/delete-user/${id}`,{method:'DELETE'});if(r?.success){toast('User deleted');loadUsers();loadDashboard();}}
async function toggleRole(id,role){const ep=role==='admin'?'/api/admin/remove-admin':'/api/admin/make-admin';const r=await api(ep,{method:'POST',body:JSON.stringify({userId:id})});if(r?.success){toast('Role updated');loadUsers();}}

/* Quick promote from user table */
async function promoteUserById(id,name){
  if(!confirm(`Promote "${name}" to instructor?`))return;
  const r=await api('/api/admin/make-instructor',{method:'POST',body:JSON.stringify({userId:id})});
  if(r?.success){toast(`${name} is now an instructor! 🎓`);_courseCache=null;loadUsers();loadInstructors();}
}

/* ────────────────────────────────────
   CONTACTS
──────────────────────────────────── */
async function loadContacts(){
  const d=await api('/api/contacts');const arr=d?.contacts||[];const unread=d?.unread||0;
  const badge=document.getElementById('contactCountBadge');
  if(badge){badge.textContent=unread>0?`${unread} unread / ${arr.length} total`:`${arr.length} messages`;badge.className=unread>0?'pill pill-o':'pill pill-g';}
  const tb=document.getElementById('contactsBody');if(!tb)return;
  if(!arr.length){tb.innerHTML=`<tr><td colspan="8"><div class="adm-empty"><i class="fas fa-inbox"></i><h6>No messages yet</h6><p>Messages submitted via the contact form appear here.</p></div></td></tr>`;return;}
  tb.innerHTML=arr.map(c=>{
    const isNew=c.status==='new'||!c.status,rowStyle=isNew?'background:rgba(26,86,232,.04)':'';
    const statusPill=c.status==='replied'?'<span class="pill pill-g">Replied</span>':c.status==='read'?'<span class="pill pill-b">Read</span>':'<span class="pill pill-o">● New</span>';
    return`<tr style="${rowStyle}"><td class="td-name">${isNew?'<i class="fas fa-circle" style="color:var(--orange);font-size:.45rem;vertical-align:middle;margin-right:5px"></i>':''}${esc(c.name)}</td><td><a href="mailto:${esc(c.email)}" style="color:var(--blue-l)">${esc(c.email)}</a>${c.phone?`<br><span style="font-size:.7rem;color:rgba(255,255,255,.3)">${esc(c.phone)}</span>`:''}</td><td>${c.project_type?`<span class="pill pill-b">${esc(c.project_type)}</span>`:'—'}</td><td>${c.budget?`<span style="font-size:.75rem">${esc(c.budget)}</span>`:'—'}</td><td style="max-width:200px"><div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:rgba(255,255,255,.5);font-size:.75rem" title="${esc(c.message||'')}">${esc(c.message||'')}</div></td><td style="white-space:nowrap">${fmt(c.created_at)}</td><td>${statusPill}</td><td style="white-space:nowrap"><a href="mailto:${esc(c.email)}?subject=Re: ${esc(c.project_type||'Your Enquiry')}&body=Hi ${esc(c.name)},%0A%0A" class="act-btn act-view" title="Reply" onclick="markReplied(${c.id})"><i class="fas fa-reply"></i></a>${isNew?`<button class="act-btn act-edit" onclick="markRead(${c.id})" title="Mark read"><i class="fas fa-check"></i></button>`:''}<button class="act-btn act-del" onclick="deleteContact(${c.id})"><i class="fas fa-trash"></i></button></td></tr>`;
  }).join('');
}
async function markRead(id){const r=await api(`/api/contacts/${id}/read`,{method:'PATCH'});if(r?.success){toast('Marked as read','info');loadContacts();loadDashboard();}}
async function markReplied(id){await api(`/api/contacts/${id}/replied`,{method:'PATCH'});loadContacts();}
async function deleteContact(id){if(!confirm('Delete this message?'))return;const r=await api(`/api/contacts/${id}`,{method:'DELETE'});if(r?.success){toast('Message deleted');loadContacts();loadDashboard();}}

