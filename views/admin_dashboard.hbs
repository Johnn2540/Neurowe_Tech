<script>
/* ────────────────────────────────────
   THEME
──────────────────────────────────── */
const themeBtn=document.getElementById('themeToggleAdm');
let dark=localStorage.getItem('nw-theme')!=='light';
const MOON='<svg viewBox="0 0 24 24" style="width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
const SUN='<svg viewBox="0 0 24 24" style="width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme(){document.body.classList.toggle('dark',dark);themeBtn.innerHTML=dark?SUN:MOON}
applyTheme();
themeBtn.addEventListener('click',()=>{dark=!dark;localStorage.setItem('nw-theme',dark?'dark':'light');applyTheme()});

window.addEventListener('scroll',()=>{
  const el=document.getElementById('scroll-progress');
  const p=(window.pageYOffset/(document.documentElement.scrollHeight-window.innerHeight))*100;
  if(el)el.style.width=p+'%';
},{passive:true});

/* ────────────────────────────────────
   TOAST
──────────────────────────────────── */
function toast(msg,type='success'){
  const icons={success:'fas fa-check-circle',error:'fas fa-exclamation-circle',info:'fas fa-info-circle'};
  const cols={success:'var(--emerald)',error:'#f87171',info:'var(--blue-l)'};
  const el=document.createElement('div');
  el.className='adm-toast '+type;
  el.innerHTML=`<i class="${icons[type]}" style="color:${cols[type]};flex-shrink:0"></i>${msg}`;
  document.getElementById('adm-toast-container').appendChild(el);
  setTimeout(()=>el.remove(),3800);
}

/* ────────────────────────────────────
   API
──────────────────────────────────── */
async function api(url,opts={}){
  try{
    const r=await fetch(url,{headers:{'Content-Type':'application/json'},...opts});
    const d=await r.json();
    if(!r.ok)throw new Error(d.message||'Request failed');
    return d;
  }catch(e){toast(e.message,'error');return null;}
}

/* ────────────────────────────────────
   HELPERS
──────────────────────────────────── */
function fmt(d){if(!d)return '—';return new Date(d).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});}
function esc(s){if(!s)return '';return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function setEl(id,v){const el=document.getElementById(id);if(el)el.textContent=v;}

/* ────────────────────────────────────
   MODALS
──────────────────────────────────── */
function openModal(id){document.getElementById(id)?.classList.add('open');document.body.style.overflow='hidden';}
function closeModal(id){document.getElementById(id)?.classList.remove('open');document.body.style.overflow='';}
document.querySelectorAll('.adm-modal-backdrop').forEach(b=>{
  b.addEventListener('click',e=>{if(e.target===b)closeModal(b.id);});
});
document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.adm-modal-backdrop.open').forEach(b=>closeModal(b.id));});

/* ────────────────────────────────────
   SIDEBAR
──────────────────────────────────── */
const sidebar=document.getElementById('admSidebar'),mainEl=document.getElementById('admMain'),topbarEl=document.getElementById('admTopbar'),mobOv=document.getElementById('admMobOverlay'),tbToggle=document.getElementById('tbToggle');
function isMob(){return window.innerWidth<992;}
tbToggle.addEventListener('click',()=>{
  if(isMob()){sidebar.classList.toggle('mob-open');mobOv.classList.toggle('open');document.body.style.overflow=sidebar.classList.contains('mob-open')?'hidden':'';}
  else{sidebar.classList.toggle('col');mainEl.classList.toggle('col');topbarEl.classList.toggle('col');}
});
mobOv.addEventListener('click',()=>{sidebar.classList.remove('mob-open');mobOv.classList.remove('open');document.body.style.overflow='';});

/* ────────────────────────────────────
   NAVIGATION
──────────────────────────────────── */
const PAGE_META={
  dashboard:['Dashboard','Live platform overview'],
  analytics:['Analytics','Traffic & growth insights'],
  users:['Users','Manage accounts and roles'],
  contacts:['Messages','Leads and enquiries'],
  subscribers:['Subscribers','Newsletter list'],
  projects:['Portfolio','Showcase projects'],
  services:['Services','Manage offerings'],
  blog:['Blog','Content management'],
  testimonials:['Testimonials','Client reviews'],
  team:['Team','Manage team profiles'],
  faqs:['FAQs','Frequently asked questions'],
  pricing:['Pricing','Pricing plans'],
  courses:['Courses','Academy course catalogue'],
  enrollments:['Enrollments','Course enrollments'],
  instructors:['Instructors','Manage the teaching team'],
  'instructor-apps':['Instructor Applications','Review & approve applications'],
  settings:['Settings','Platform configuration'],
};
const LOADERS={
  analytics:loadAnalytics,
  users:loadUsers,contacts:loadContacts,subscribers:loadSubscribers,
  projects:loadProjects,services:loadServices,blog:loadBlog,
  testimonials:loadTestimonials,team:loadTeam,faqs:loadFAQs,
  pricing:loadPricing,courses:loadCourses,enrollments:loadEnrollments,
  instructors:loadInstructors,'instructor-apps':loadInstructorApps,
};

function switchPage(page){
  document.querySelectorAll('.adm-page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.adm-nav-item[data-page]').forEach(n=>n.classList.remove('active'));
  document.getElementById('page-'+page)?.classList.add('active');
  document.querySelector(`.adm-nav-item[data-page="${page}"]`)?.classList.add('active');
  const[title,sub]=PAGE_META[page]||[page,''];
  setEl('tbTitle',title);setEl('tbSub',sub);
  if(LOADERS[page])LOADERS[page]();
  if(isMob()){sidebar.classList.remove('mob-open');mobOv.classList.remove('open');document.body.style.overflow='';}
  window.scrollTo({top:0,behavior:'smooth'});
}
document.querySelectorAll('.adm-nav-item[data-page]').forEach(el=>{
  el.addEventListener('click',()=>switchPage(el.dataset.page));
});

/* ────────────────────────────────────
   DASHBOARD
──────────────────────────────────── */
async function loadDashboard(){
  const[statsD,cD,uD,sD]=await Promise.all([
    api('/api/admin/dashboard-stats'),api('/api/contacts'),
    api('/api/admin/users'),api('/api/admin/subscribers'),
  ]);
  const stats=statsD?.stats||{},contacts=cD?.contacts||[],users=uD?.users||[],subs=sD?.subscribers||[],unread=cD?.unread||0;
  setEl('sUsers',stats.total_users??users.length);setEl('sProjects',stats.total_projects??'—');
  setEl('sContacts',stats.total_contacts??contacts.length);setEl('sSubscribers',stats.total_subscribers??subs.length);
  setEl('sbUserCount',stats.total_users??users.length);setEl('sbContactCount',stats.total_contacts??contacts.length);
  setEl('cfgUserCount',stats.total_users??'—');setEl('cfgProjectCount',stats.total_projects??'—');
  setEl('cfgCourseCount',stats.total_courses??'—');setEl('cfgInstructorCount',stats.total_instructors??'—');
  setEl('aUsers',stats.total_users??users.length);
  if(unread>0){const b=document.getElementById('sbContactCount');if(b){b.textContent=unread+' new';b.style.background='var(--orange)';}}
  const uname=document.getElementById('sbUserName')?.textContent?.trim()||'A';
  const init=uname.charAt(0).toUpperCase();setEl('sbUserAv',init);setEl('tbUserAv',init);
  const statusPill=c=>c.status==='replied'?'<span class="pill pill-g">Replied</span>':c.status==='read'?'<span class="pill pill-b">Read</span>':'<span class="pill pill-o">New</span>';
  const dcb=document.getElementById('dashContactsBody');
  if(dcb)dcb.innerHTML=contacts.slice(0,5).length
    ?contacts.slice(0,5).map(c=>`<tr style="${c.is_unread?'background:rgba(26,86,232,.05)':''}"><td class="td-name">${esc(c.name)}</td><td>${c.project_type?`<span class="pill pill-b">${esc(c.project_type)}</span>`:'—'}</td><td>${fmt(c.created_at)}</td><td>${statusPill(c)}</td></tr>`).join('')
    :`<tr><td colspan="4"><div class="adm-empty"><i class="fas fa-inbox"></i><p>No messages yet</p></div></td></tr>`;
  const acts=[
    ...contacts.slice(0,4).map(c=>({type:'msg',label:`New message from <strong>${esc(c.name)}</strong>${c.project_type?' — '+esc(c.project_type):''}`,date:c.created_at})),
    ...users.slice(0,3).map(u=>({type:'user',label:`User registered: <strong>${esc(u.username)}</strong>`,date:u.created_at})),
    ...subs.slice(0,3).map(s=>({type:'sub',label:`Newsletter: ${esc(s.email)}`,date:s.subscribed_at})),
  ].sort((a,b)=>new Date(b.date)-new Date(a.date)).slice(0,7);
  const iconMap={msg:'fa-envelope msg',user:'fa-user-plus user',sub:'fa-at sub'};
  const feed=document.getElementById('activityFeed');
  if(feed)feed.innerHTML=acts.length
    ?acts.map(a=>{const[icon,cls]=(iconMap[a.type]||'fa-bell msg').split(' ');return`<div class="act-feed-item"><div class="act-dot-icon ${cls}"><i class="fas ${icon}"></i></div><div><p>${a.label}</p><time>${fmt(a.date)}</time></div></div>`;}).join('')
    :`<div class="adm-empty"><i class="fas fa-clock-rotate-left"></i><p>No activity yet</p></div>`;
  updateCharts(parseInt(stats.total_users)||users.length,parseInt(stats.total_subscribers)||subs.length);
}

/* ────────────────────────────────────
   ANALYTICS
──────────────────────────────────── */
let analyticsChart=null;
async function loadAnalytics(){
  const d=await api('/api/admin/analytics');
  if(!d?.success)return;
  const s=d.stats||{};
  const newTag=n=>n?`+${n} this month`:'';
  setEl('aUsers',    s.total_users       ??'—'); setEl('aUsersNew',   newTag(s.new_users_month));
  setEl('aEnrolls',  s.total_enrollments ??'—'); setEl('aEnrollsNew', newTag(s.new_enrollments_month));
  setEl('aSubs',     s.total_subscribers ??'—'); setEl('aSubsNew',    newTag(s.new_subscribers_month));
  setEl('aContacts', s.total_contacts    ??'—'); setEl('aContactsNew',newTag(s.new_contacts_month));

  /* Chart */
  const weekly=d.weekly||[];
  const labels=weekly.map(w=>w.week);
  const uData=weekly.map(w=>parseInt(w.users)||0);
  const eData=weekly.map(w=>parseInt(w.enrollments)||0);
  const sData=weekly.map(w=>parseInt(w.subscribers)||0);
  const ac=document.getElementById('analyticsChart');
  if(ac){
    if(analyticsChart){analyticsChart.destroy();analyticsChart=null;}
    analyticsChart=new Chart(ac,{type:'bar',data:{
      labels,
      datasets:[
        {label:'New Users',data:uData,backgroundColor:'rgba(107,140,255,.7)',borderRadius:4,borderSkipped:false},
        {label:'Enrollments',data:eData,backgroundColor:'rgba(92,198,120,.7)',borderRadius:4,borderSkipped:false},
        {label:'Subscribers',data:sData,backgroundColor:'rgba(249,115,22,.6)',borderRadius:4,borderSkipped:false},
      ]
    },options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{labels:{color:'rgba(255,255,255,.5)',font:{size:11}}}},scales:{x:{ticks:{color:'rgba(255,255,255,.28)'},grid:{color:'rgba(255,255,255,.04)'}},y:{ticks:{color:'rgba(255,255,255,.28)',stepSize:1},grid:{color:'rgba(255,255,255,.04)'},beginAtZero:true}}}});
  }

  /* Top courses list */
  const cl=document.getElementById('topCoursesList');
  if(cl){
    const courses=d.topCourses||[];
    const max=parseInt(courses[0]?.enrolled_count)||1;
    cl.innerHTML=courses.length
      ?courses.map((c,i)=>`<div style="padding:10px 16px;border-bottom:1px solid rgba(255,255,255,.05)">
          <div style="display:flex;justify-content:space-between;margin-bottom:5px">
            <span style="font-size:.82rem;color:rgba(255,255,255,.8);font-weight:600">${i+1}. ${esc(c.title)}</span>
            <span style="font-size:.78rem;color:rgba(255,255,255,.4)">${c.enrolled_count} enrolled</span>
          </div>
          <div style="height:4px;border-radius:2px;background:rgba(255,255,255,.06)">
            <div style="height:100%;border-radius:2px;background:linear-gradient(90deg,#6b8cff,#5cc678);width:${Math.round((parseInt(c.enrolled_count)||0)/max*100)}%"></div>
          </div>
        </div>`).join('')
      :`<div class="adm-empty" style="padding:32px"><i class="fas fa-book-open"></i><p>No published courses yet</p></div>`;
  }
}

/* ────────────────────────────────────
   CHARTS
──────────────────────────────────── */
let growthChart,donutChart;
const cOpts={plugins:{legend:{labels:{color:'rgba(255,255,255,.45)',font:{size:11}}}},scales:{x:{ticks:{color:'rgba(255,255,255,.28)'},grid:{color:'rgba(255,255,255,.04)'}},y:{ticks:{color:'rgba(255,255,255,.28)'},grid:{color:'rgba(255,255,255,.04)'}}}};
function initCharts(){
  const gc=document.getElementById('growthChart');
  if(gc)growthChart=new Chart(gc,{type:'line',data:{labels:['Jan','Feb','Mar','Apr','May','Jun'],datasets:[{label:'Users',data:[0,0,0,0,0,0],borderColor:'#1a56e8',backgroundColor:'rgba(26,86,232,.08)',tension:.4,fill:true,pointBackgroundColor:'#1a56e8',pointRadius:4},{label:'Subscribers',data:[0,0,0,0,0,0],borderColor:'#f07020',backgroundColor:'rgba(240,112,32,.06)',tension:.4,fill:true,pointBackgroundColor:'#f07020',pointRadius:4}]},options:{...cOpts,responsive:true,maintainAspectRatio:true}});
  const dc=document.getElementById('donutChart');
  if(dc)donutChart=new Chart(dc,{type:'doughnut',data:{labels:['Direct','WhatsApp','Organic','Referral'],datasets:[{data:[38,28,22,12],backgroundColor:['#1a56e8','#25D366','#0dbf7e','#f07020'],borderWidth:0,hoverOffset:6}]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{position:'bottom',labels:{color:'rgba(255,255,255,.45)',font:{size:11},padding:12}}},cutout:'72%'}});
}
function updateCharts(u,s){
  if(!growthChart)return;
  const curve=(n,steps)=>Array.from({length:steps},(_,i)=>Math.max(0,Math.round(n*(0.4+(i/(steps-1))*0.6))));
  growthChart.data.datasets[0].data=curve(u,6);growthChart.data.datasets[1].data=curve(s,6);growthChart.update();
}

