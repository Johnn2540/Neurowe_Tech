let allCourses=[];
async function loadCourses(){
  const d=await api('/api/learn/courses');allCourses=d?.courses||[];
  setEl('sCourses',allCourses.length);
  setEl('sEnrollments',allCourses.reduce((a,c)=>a+(parseInt(c.enrolled_count)||0),0));
  setEl('sFreeCourses',allCourses.filter(c=>parseFloat(c.price)===0).length);
  setEl('cfgCourseCount',allCourses.length);
  renderCourses(allCourses);
}
function renderCourses(arr){
  const tb=document.getElementById('coursesBody');if(!tb)return;
  tb.innerHTML=arr.length?arr.map(c=>`<tr><td><div class="course-row-name"><img class="course-thumb" src="${esc(c.image_url||'/images/course-placeholder.jpg')}" onerror="this.src='https://placehold.co/84x60/1a56e8/white?text=N'" alt="${esc(c.title)}" loading="lazy"><span class="td-name">${esc(c.title)}</span></div></td><td><span class="pill pill-t">${esc(c.category||'General')}</span></td><td><span class="pill pill-b">${esc(c.level||'Beginner')}</span></td><td>${parseFloat(c.price)===0?'<span class="pill pill-g">Free</span>':'<span class="pill pill-o">Ksh '+esc(c.price)+'</span>'}</td><td><span style="font-weight:700;color:rgba(255,255,255,.8)">${c.enrolled_count||0}</span></td><td><span class="pill ${c.published?'pill-g':'pill-dim'}">${c.published?'● Live':'Draft'}</span></td><td style="white-space:nowrap"><button class="act-btn act-edit" title="Edit" onclick="openCourseModal(${JSON.stringify({id:c.id,title:c.title,description:c.description||'',category:c.category||'',level:c.level||'',total_duration:c.total_duration||'',price:c.price||0,instructor_name:c.instructor_name||'',image_url:c.image_url||'',published:!!c.published,bestseller:!!c.bestseller,featured:!!c.featured}).replace(/"/g,'&quot;')})"><i class="fas fa-pen"></i></button><a href="/instructor/course/${c.id}" target="_blank" class="act-btn act-view" title="Open instructor view"><i class="fas fa-external-link-alt"></i></a><button class="act-btn act-del" title="Delete" onclick="deleteCourse(${c.id},'${esc(c.title).replace(/'/g,"\\'")}')"><i class="fas fa-trash"></i></button></td></tr>`).join(''):`<tr><td colspan="7"><div class="adm-empty"><i class="fas fa-graduation-cap"></i><p>No courses yet</p></div></td></tr>`;
}
function filterCourses(q){const lq=q.toLowerCase();renderCourses(allCourses.filter(c=>c.title.toLowerCase().includes(lq)||(c.category||'').toLowerCase().includes(lq)||(c.instructor_name||'').toLowerCase().includes(lq)));}

/* ────────────────────────────────────
   COURSE MODAL
──────────────────────────────────── */
var _cmStep=1,_cmEditId=null,_cmUploadedPublicId=null;
function openCourseModal(editData){
  _cmStep=1;_cmEditId=editData?editData.id:null;
  document.getElementById('courseTitleInp').value=editData?.title||'';
  document.getElementById('courseDesc').value=editData?.description||'';
  document.getElementById('courseDuration').value=editData?.total_duration||'';
  document.getElementById('courseInstructor').value=editData?.instructor_name||'';
  document.getElementById('coursePrice').value=editData?.price??0;
  document.getElementById('courseImageUrl').value=editData?.image_url||'';
  document.getElementById('courseImageUrlDirect').value=editData?.image_url||'';
  document.getElementById('coursePublished').checked=editData?!!editData.published:true;
  document.getElementById('courseBestseller').checked=editData?!!editData.bestseller:false;
  document.getElementById('courseFeatured').checked=editData?!!editData.featured:false;
  if(editData?.category)document.getElementById('courseCat').value=editData.category;
  if(editData?.level)document.getElementById('courseLevel').value=editData.level;
  const isFree=!editData||parseFloat(editData.price)===0;
  document.querySelectorAll('.cm-price-tag').forEach(t=>t.classList.remove('active'));
  document.querySelector(`.cm-price-tag[data-val="${isFree?'0':''}"]`)?.classList.add('active');
  document.getElementById('coursePrice').classList.toggle('hidden',isFree);
  cmResetImage();if(editData?.image_url)cmShowPreview(editData.image_url);
  document.getElementById('courseModalTitle').textContent=editData?'Edit Course':'Add New Course';
  document.getElementById('cmSaveLbl').textContent=editData?'Save Changes':'Publish Course';
  _cmUploadedPublicId=null;cmGoTo(1);openModal('modal-add-course');
}
function closeCourseModal(){closeModal('modal-add-course');_cmEditId=null;_cmStep=1;}
function cmGoTo(step){
  _cmStep=step;
  document.querySelectorAll('.cm-step').forEach(el=>{const s=parseInt(el.dataset.step);el.classList.remove('active','done');if(s===step)el.classList.add('active');else if(s<step)el.classList.add('done');});
  document.querySelectorAll('.cm-panel').forEach(el=>el.classList.remove('active'));
  document.getElementById('cm-panel-'+step)?.classList.add('active');
  const back=document.getElementById('cmBtnBack'),next=document.getElementById('cmBtnNext'),save=document.getElementById('cmBtnSave');
  back.style.display=step>1?'':'none';next.style.display=step<3?'':'none';save.style.display=step===3?'':'none';
  if(step===3)cmSyncSummary();
  document.querySelector('.course-modal-body')?.scrollTo(0,0);
}
function cmStep(dir){
  if(dir>0&&_cmStep===1){const t=document.getElementById('courseTitleInp').value.trim();if(!t){document.getElementById('courseTitleInp').focus();toast('Please enter a course title','error');return;}}
  const next=_cmStep+dir;if(next>=1&&next<=3)cmGoTo(next);
}
function cmSyncSummary(){
  const title=document.getElementById('courseTitleInp').value.trim()||'—',cat=document.getElementById('courseCat').value||'—',level=document.getElementById('courseLevel').value||'—',price=parseFloat(document.getElementById('coursePrice').value)||0,dur=document.getElementById('courseDuration').value.trim()||'—',instr=document.getElementById('courseInstructor').value.trim()||'Admin',pub=document.getElementById('coursePublished').checked,bs=document.getElementById('courseBestseller').checked,feat=document.getElementById('courseFeatured').checked;
  const badges=[pub?'Published':'Draft',bs?'Bestseller':'',feat?'Featured':''].filter(Boolean).join(' · ');
  setEl('sumTitle',title);setEl('sumCat',cat);setEl('sumLevel',level);setEl('sumPrice',price===0?'Free':'Ksh '+price.toLocaleString());setEl('sumDuration',dur);setEl('sumInstructor',instr);setEl('sumStatus',badges);
}
function setCoursePrice(val,btn){document.querySelectorAll('.cm-price-tag').forEach(t=>t.classList.remove('active'));btn.classList.add('active');const inp=document.getElementById('coursePrice');if(val===0){inp.value=0;inp.classList.add('hidden');}else{inp.value='';inp.classList.remove('hidden');setTimeout(()=>inp.focus(),80);}}
function syncImageUrlFromInput(val){document.getElementById('courseImageUrl').value=val;if(val)cmShowPreview(val);else cmResetImage();}
async function handleCourseImageUpload(input){
  const file=input.files[0];if(!file)return;
  if(file.size>20*1024*1024){toast('Image must be under 20 MB','error');return;}
  const idle=document.getElementById('cmUploadIdle'),prog=document.getElementById('cmUploadProgress'),prev=document.getElementById('cmUploadPreview');
  idle.style.display='none';prog.style.display='flex';prev.style.display='none';
  try{
    const fd=new FormData();fd.append('image',file);
    const res=await fetch('/api/upload/course-image',{method:'POST',body:fd});
    const data=await res.json();
    if(data.success){document.getElementById('courseImageUrl').value=data.imageUrl;document.getElementById('courseImageUrlDirect').value=data.imageUrl;_cmUploadedPublicId=data.publicId;cmShowPreview(data.imageUrl);toast('Image uploaded ✓');}
    else throw new Error(data.message||'Upload failed');
  }catch(e){toast(e.message,'error');idle.style.display='flex';}
  finally{prog.style.display='none';input.value='';}
}
function cmShowPreview(url){document.getElementById('cmUploadIdle').style.display='none';document.getElementById('cmUploadProgress').style.display='none';document.getElementById('cmPreviewImg').src=url;document.getElementById('cmUploadPreview').style.display='block';}
function cmResetImage(){document.getElementById('cmUploadIdle').style.display='flex';document.getElementById('cmUploadProgress').style.display='none';document.getElementById('cmUploadPreview').style.display='none';document.getElementById('courseImageUrl').value='';document.getElementById('courseImageUrlDirect').value='';}
async function removeCourseImg(){if(_cmUploadedPublicId){await fetch('/api/upload/delete',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({publicId:_cmUploadedPublicId})}).catch(()=>{});_cmUploadedPublicId=null;}cmResetImage();}
async function createCourse(){
  const title=document.getElementById('courseTitleInp').value.trim();if(!title){toast('Course title required','error');cmGoTo(1);return;}
  const btn=document.getElementById('cmBtnSave'),orig=btn.innerHTML;btn.disabled=true;btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Saving…';
  const payload={title,description:document.getElementById('courseDesc').value.trim(),category:document.getElementById('courseCat').value,level:document.getElementById('courseLevel').value,total_duration:document.getElementById('courseDuration').value.trim(),price:parseFloat(document.getElementById('coursePrice').value)||0,instructor_name:document.getElementById('courseInstructor').value.trim(),image_url:document.getElementById('courseImageUrl').value.trim()||'/images/course-placeholder.jpg',published:document.getElementById('coursePublished').checked,bestseller:document.getElementById('courseBestseller').checked,featured:document.getElementById('courseFeatured').checked};
  const url=_cmEditId?`/api/learn/courses/${_cmEditId}`:'/api/learn/courses',method=_cmEditId?'PUT':'POST';
  const r=await api(url,{method,body:JSON.stringify(payload)});
  btn.disabled=false;btn.innerHTML=orig;
  if(r?.success){toast(_cmEditId?'Course updated!':'Course published! 🎓');closeCourseModal();loadCourses();}
}
async function deleteCourse(id,title){if(!confirm(`Delete "${title||'this course'}"? Enrollments will also be removed.`))return;const r=await api(`/api/learn/courses/${id}`,{method:'DELETE'});if(r?.success){toast('Course deleted');loadCourses();}}

/* ────────────────────────────────────
   ENROLLMENTS
──────────────────────────────────── */
async function loadEnrollments(){
  const d=await api('/api/learn/enrollments');const arr=d?.enrollments||[];
  const tb=document.getElementById('enrollmentsBody');if(!tb)return;
  tb.innerHTML=arr.length?arr.map(e=>`<tr><td class="td-name">${esc(e.username||'—')}</td><td><a href="mailto:${esc(e.email)}" style="color:var(--blue-l)">${esc(e.email||'—')}</a></td><td>${esc(e.course_title||'—')}</td><td>${fmt(e.enrolled_at||e.created_at)}</td><td><div style="display:flex;align-items:center;gap:8px"><div style="flex:1;height:5px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden;min-width:60px"><div style="width:${e.progress||0}%;height:100%;background:var(--g-blue);border-radius:99px"></div></div><span style="font-size:.72rem;color:rgba(255,255,255,.4)">${e.progress||0}%</span></div></td><td><button class="act-btn act-del" onclick="deleteEnrollment(${e.id})"><i class="fas fa-trash"></i></button></td></tr>`).join(''):`<tr><td colspan="6"><div class="adm-empty"><i class="fas fa-user-graduate"></i><p>No enrollments yet</p></div></td></tr>`;
}
async function deleteEnrollment(id){if(!confirm('Remove enrollment?'))return;const r=await api(`/api/learn/enrollments/${id}`,{method:'DELETE'});if(r?.success){toast('Removed');loadEnrollments();}}

/* ════════════════════════════════════
   INSTRUCTOR MANAGEMENT (full)
════════════════════════════════════ */
var _allInstructorUsers=[];
var _allInstructorApps=[];
var _allRegularUsers=[];
var _promoteSelectedId=null;
var _promoteSelectedName='';
var _activeAppTab='pending';
var _courseCache=null;

/* ── Active instructors page ── */
async function loadInstructors(){
  const[instrD,appsD]=await Promise.all([api('/api/admin/instructors'),api('/api/contacts')]);
  _allInstructorUsers=instrD?.instructors||[];
  const allApps=(appsD?.contacts||[]).filter(c=>c.project_type&&c.project_type.toLowerCase().includes('instructor'));
  _allInstructorApps=allApps;
  const pending=allApps.filter(c=>c.status==='new'||!c.status).length;
  setEl('iStatCount',_allInstructorUsers.length);
  setEl('iStatAppsCount',pending);
  const totalAssigned=_allInstructorUsers.reduce((acc,i)=>acc+(i.course_count||0),0);
  setEl('iStatAssigned',totalAssigned);
  /* sidebar badges */
  const sb=document.getElementById('sbInstructorCount');if(sb)sb.textContent=_allInstructorUsers.length;
  const ab=document.getElementById('sbAppCount');
  if(ab){ab.textContent=pending>0?pending:'';ab.style.display=pending>0?'':'none';ab.style.background='var(--orange)';}
  renderInstructorCards(_allInstructorUsers);
}

function renderInstructorCards(arr){
  const grid=document.getElementById('instrCardsGrid');if(!grid)return;
  if(!arr.length){
    grid.innerHTML=`<div class="adm-empty" style="grid-column:1/-1"><i class="fas fa-chalkboard-teacher"></i><h6>No instructors yet</h6><p>Click "Promote User" to grant instructor access to a registered user.</p></div>`;
    return;
  }
  grid.innerHTML=arr.map((instr,idx)=>{
    const init=(instr.username||instr.name||'I').charAt(0).toUpperCase();
    const courses=instr.courses||[];
    const courseTags=courses.length
      ?courses.map(c=>`<span class="instr-course-tag"><i class="fas fa-graduation-cap" style="font-size:.55rem;flex-shrink:0"></i><span>${esc(c.title||c.name)}</span><button class="instr-tag-del" onclick="unassignCourse(${instr.id},${c.id},'${esc(c.title||c.name)}',this)" title="Remove"><i class="fas fa-times"></i></button></span>`).join('')
      :`<div class="instr-no-courses"><i class="fas fa-info-circle" style="margin-right:4px;opacity:.5"></i>No courses assigned yet</div>`;
    return`<div class="instr-card" id="instrCard${instr.id}" style="animation-delay:${idx*0.06}s">
      <div class="instr-card-stripe"></div>
      <div class="instr-card-body">
        <div class="instr-card-head">
          <div class="instr-avatar">${init}</div>
          <div class="instr-info">
            <div class="instr-name">${esc(instr.username||instr.name)}</div>
            <div class="instr-email">${esc(instr.email)}</div>
            <div class="instr-since">Instructor since ${fmt(instr.created_at)}</div>
          </div>
          <span class="pill pill-o" style="flex-shrink:0">Instructor</span>
        </div>
        <div>
          <div class="instr-courses-label">Assigned Courses (${courses.length})</div>
          <div class="instr-courses-wrap" id="instrCourses${instr.id}">${courseTags}</div>
        </div>
        <div>
          <div class="instr-courses-label">Assign Course</div>
          <div class="instr-assign-row">
            <select class="adm-input" id="instrSel${instr.id}"><option value="">— pick a course —</option></select>
            <button class="btn-adm o" onclick="assignCourse(${instr.id})"><i class="fas fa-plus"></i></button>
          </div>
        </div>
      </div>
      <div class="instr-card-foot">
        <button class="btn-adm ghost sm" onclick="openInstrDetail(${instr.id})"><i class="fas fa-eye"></i> Details</button>
        <a href="/instructor/course/${courses[0]?.id||''}" target="_blank" class="btn-adm ghost sm" ${!courses.length?'style="opacity:.4;pointer-events:none"':''}><i class="fas fa-external-link-alt"></i> Dashboard</a>
        <button class="btn-adm danger sm" onclick="demoteInstructor(${instr.id},'${esc(instr.username||instr.name)}')"><i class="fas fa-user-minus"></i> Remove</button>
      </div>
    </div>`;
  }).join('');
  populateAssignSelects();
}

function filterInstructorCards(q){
  const lo=q.toLowerCase();
  renderInstructorCards(_allInstructorUsers.filter(i=>(i.username||i.name||'').toLowerCase().includes(lo)||(i.email||'').toLowerCase().includes(lo)));
}

async function populateAssignSelects(){
  if(!_courseCache){const d=await api('/api/learn/courses');_courseCache=d?.courses||[];}
  _allInstructorUsers.forEach(instr=>{
    const sel=document.getElementById('instrSel'+instr.id);if(!sel)return;
    const assigned=new Set((instr.courses||[]).map(c=>String(c.id)));
    sel.innerHTML='<option value="">— pick a course —</option>'+(_courseCache||[]).filter(c=>!assigned.has(String(c.id))).map(c=>`<option value="${c.id}">${esc(c.title)}</option>`).join('');
  });
}

async function assignCourse(instrId){
  const sel=document.getElementById('instrSel'+instrId);
  const courseId=sel?.value;if(!courseId){toast('Please select a course','error');return;}
  const r=await api('/api/admin/assign-course',{method:'POST',body:JSON.stringify({instructorId:instrId,courseId})});
  if(r?.success){toast('Course assigned!');_courseCache=null;loadInstructors();}
}

async function unassignCourse(instrId,courseId,courseTitle,btn){
  if(!confirm(`Remove "${courseTitle}" from this instructor?`))return;
  btn.innerHTML='<i class="fas fa-spinner fa-spin"></i>';
  const r=await api('/api/admin/assign-course',{method:'DELETE',body:JSON.stringify({instructorId:instrId,courseId})});
  if(r?.success){toast('Course unassigned');_courseCache=null;loadInstructors();}
  else btn.innerHTML='<i class="fas fa-times"></i>';
}

async function demoteInstructor(id,name){
  if(!confirm(`Remove instructor role from "${name}"? They will revert to a regular user.`))return;
  const r=await api('/api/admin/remove-instructor',{method:'POST',body:JSON.stringify({userId:id})});
  if(r?.success){toast(`${name} is no longer an instructor`);closeModal('modal-instructor-detail');loadInstructors();}
}

function openInstrDetail(instrId){
  const instr=_allInstructorUsers.find(i=>i.id===instrId);if(!instr)return;
  const courses=instr.courses||[];
  const body=document.getElementById('instrDetailBody');if(!body)return;
  body.innerHTML=`
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:4px">
      <div><label class="adm-label">Name</label><div style="font-size:.92rem;font-weight:800;color:#fff">${esc(instr.username||instr.name)}</div></div>
      <div><label class="adm-label">Role</label><span class="pill pill-o">Instructor</span></div>
      <div><label class="adm-label">Email</label><a href="mailto:${esc(instr.email)}" style="color:var(--blue-l);font-size:.84rem">${esc(instr.email)}</a></div>
      <div><label class="adm-label">Joined</label><div style="font-size:.82rem;color:rgba(255,255,255,.5)">${fmt(instr.created_at)}</div></div>
    </div>
    <div>
      <label class="adm-label">Assigned Courses (${courses.length})</label>
      <div class="instr-courses-wrap" style="min-height:52px">${courses.length?courses.map(c=>`<span class="instr-course-tag"><i class="fas fa-graduation-cap" style="font-size:.55rem"></i><span>${esc(c.title||c.name)}</span></span>`).join(''):'<div class="instr-no-courses">No courses assigned yet.</div>'}</div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <a href="mailto:${esc(instr.email)}" class="btn-adm ghost sm"><i class="fas fa-envelope"></i> Send Email</a>
      <a href="/instructor/dashboard" target="_blank" class="btn-adm ghost sm"><i class="fas fa-external-link-alt"></i> Instructor Hub</a>
    </div>`;
  document.getElementById('instrDemoteBtn').onclick=()=>demoteInstructor(instrId,instr.username||instr.name);
  openModal('modal-instructor-detail');
}

/* ── Promote modal ── */
async function openPromoteModal(){
  _promoteSelectedId=null;_promoteSelectedName='';
  document.getElementById('promoteConfirmBtn').disabled=true;
  document.getElementById('promoteSelectedBox').style.display='none';
  document.getElementById('promoteSearch').value='';
  const d=await api('/api/admin/users');const all=d?.users||[];
  const instrIds=new Set(_allInstructorUsers.map(i=>String(i.id)));
  _allRegularUsers=all.filter(u=>u.role!=='admin'&&!instrIds.has(String(u.id)));
  renderPromoteList(_allRegularUsers);
  openModal('modal-promote-instructor');
}

function renderPromoteList(arr){
  const list=document.getElementById('promoteUserList');if(!list)return;
  if(!arr.length){list.innerHTML=`<div class="adm-empty" style="padding:20px"><i class="fas fa-users"></i><p>No eligible users found</p></div>`;return;}
  list.innerHTML=arr.map(u=>`
    <div class="promote-user-item" data-id="${u.id}" onclick="selectPromoteUser(${u.id},'${esc(u.username)}','${esc(u.email)}',this)">
      <div class="promote-user-av">${(u.username||'U').charAt(0).toUpperCase()}</div>
      <div style="flex:1;min-width:0">
        <div style="font-size:.84rem;font-weight:700;color:rgba(255,255,255,.85)">${esc(u.username)}</div>
        <div style="font-size:.71rem;color:rgba(255,255,255,.35)">${esc(u.email)}</div>
      </div>
      <span class="pill pill-dim" style="font-size:.62rem">${esc(u.role||'user')}</span>
    </div>`).join('');
}

function filterPromoteList(q){
  const lo=q.toLowerCase();
  renderPromoteList(_allRegularUsers.filter(u=>(u.username||'').toLowerCase().includes(lo)||(u.email||'').toLowerCase().includes(lo)));
}

function selectPromoteUser(id,name,email,el){
  document.querySelectorAll('.promote-user-item').forEach(i=>i.classList.remove('selected'));
  el.classList.add('selected');
  _promoteSelectedId=id;_promoteSelectedName=name;
  document.getElementById('promoteSelectedBox').style.display='flex';
  document.getElementById('promoteSelectedName').textContent=`${name} (${email})`;
  document.getElementById('promoteConfirmBtn').disabled=false;
}

async function confirmPromote(){
  if(!_promoteSelectedId)return;
  const btn=document.getElementById('promoteConfirmBtn'),orig=btn.innerHTML;
  btn.disabled=true;btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Promoting…';
  const r=await api('/api/admin/make-instructor',{method:'POST',body:JSON.stringify({userId:_promoteSelectedId})});
  btn.innerHTML=orig;
  if(r?.success){toast(`${_promoteSelectedName} is now an instructor! 🎓`);closeModal('modal-promote-instructor');_courseCache=null;loadInstructors();}
  else btn.disabled=false;
}

/* ── Applications page ── */
function switchAppTab(tab){
  _activeAppTab=tab;
  document.querySelectorAll('.instr-page-tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.instr-tab-pane').forEach(p=>p.classList.remove('active'));
  document.querySelector(`[data-apptab="${tab}"]`)?.classList.add('active');
  document.getElementById('apptab-'+tab)?.classList.add('active');
}

async function loadInstructorApps(){
  const d=await api('/api/contacts');
  const all=(d?.contacts||[]).filter(c=>c.project_type&&c.project_type.toLowerCase().includes('instructor'));
  _allInstructorApps=all;
  const pending=all.filter(c=>c.status==='new'||!c.status);
  const approved=all.filter(c=>c.status==='replied');
  /* badges */
  const badge=document.getElementById('appCountBadge');
  if(badge){badge.textContent=`${pending.length} pending / ${all.length} total`;badge.className=pending.length>0?'pill pill-o':'pill pill-g';}
  const tb=document.getElementById('tabPendingCount');if(tb)tb.textContent=pending.length;
  const sb=document.getElementById('sbAppCount');
  if(sb){sb.textContent=pending.length>0?pending.length:'';sb.style.display=pending.length>0?'':'none';}
  renderAppTable('appPendingBody',pending,['pending']);
  renderAppTable('appAllBody',all,['all']);
  renderAppTable('appApprovedBody',approved,['approved']);
}

function parseAppMsg(msg){
  msg=msg||'';
  const get=k=>{const m=msg.match(new RegExp(k+':\\s*(.+)','i'));return m?m[1].trim():'—';};
  return{expertise:get('Expertise'),proposedCourse:get('Proposed Course'),experience:get('Experience')};
}

function renderAppTable(tbodyId,arr,modes){
  const tb=document.getElementById(tbodyId);if(!tb)return;
  const colCount=modes.includes('approved')?5:7;
  if(!arr.length){tb.innerHTML=`<tr><td colspan="${colCount}"><div class="adm-empty"><i class="fas fa-inbox"></i><p>No applications in this category</p></div></td></tr>`;return;}
  const sPill=c=>c.status==='replied'?'<span class="pill pill-g">Approved</span>':c.status==='read'?'<span class="pill pill-b">Reviewed</span>':'<span class="pill pill-o">● Pending</span>';
  tb.innerHTML=arr.map(c=>{
    const p=parseAppMsg(c.message);const isPending=!c.status||c.status==='new';
    if(modes.includes('approved')){
      return`<tr><td class="td-name">${esc(c.name)}</td><td><a href="mailto:${esc(c.email)}" style="color:var(--blue-l)">${esc(c.email)}</a></td><td style="font-size:.76rem;color:rgba(255,255,255,.6)">${esc(p.proposedCourse)}</td><td>${fmt(c.created_at)}</td><td style="white-space:nowrap"><button class="act-btn act-view" onclick="viewAppDetail(${c.id})" title="View"><i class="fas fa-eye"></i></button><button class="act-btn act-orange" onclick="quickPromoteFromApp(${c.id},'${esc(c.name)}')" title="Promote to Instructor"><i class="fas fa-user-shield"></i></button><button class="act-btn act-del" onclick="deleteApp(${c.id})"><i class="fas fa-trash"></i></button></td></tr>`;
    }
    const rowStyle=isPending?'background:rgba(240,112,32,.03)':'';
    const acts=`<td style="white-space:nowrap"><button class="act-btn act-view" onclick="viewAppDetail(${c.id})" title="View"><i class="fas fa-eye"></i></button><a class="act-btn act-edit" href="mailto:${esc(c.email)}?subject=Your Instructor Application" onclick="markAppReplied(${c.id})" title="Reply"><i class="fas fa-reply"></i></a>${isPending?`<button class="act-btn" style="background:rgba(13,191,126,.12);color:var(--emerald)" onclick="approveApp(${c.id})" title="Approve"><i class="fas fa-check"></i></button>`:''}<button class="act-btn act-del" onclick="deleteApp(${c.id})"><i class="fas fa-trash"></i></button></td>`;
    const statusCol=modes.includes('all')?`<td>${sPill(c)}</td>`:'';
    return`<tr style="${rowStyle}"><td class="td-name">${isPending?'<i class="fas fa-circle" style="color:var(--orange);font-size:.42rem;vertical-align:middle;margin-right:5px"></i>':''}${esc(c.name)}</td><td><a href="mailto:${esc(c.email)}" style="color:var(--blue-l)">${esc(c.email)}</a>${c.phone?`<br><span style="font-size:.68rem;color:rgba(255,255,255,.3)">${esc(c.phone)}</span>`:''}</td><td style="font-size:.73rem;color:rgba(255,255,255,.55);max-width:130px">${esc(p.expertise)}</td><td style="font-size:.76rem;font-weight:600;max-width:160px">${esc(p.proposedCourse)}</td><td style="white-space:nowrap">${fmt(c.created_at)}</td>${statusCol}${acts}</tr>`;
  }).join('');
}

function filterApps(q){const lo=q.toLowerCase();renderAppTable('appAllBody',_allInstructorApps.filter(c=>c.name.toLowerCase().includes(lo)||c.email.toLowerCase().includes(lo)),['all']);}

function viewAppDetail(id){
  const c=_allInstructorApps.find(x=>x.id===id);if(!c)return;
  const p=parseAppMsg(c.message);
  const body=document.getElementById('appDetailBody');if(!body)return;
  body.innerHTML=`
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
      <div><label class="adm-label">Applicant</label><div style="font-size:.92rem;font-weight:800;color:#fff">${esc(c.name)}</div></div>
      <div><label class="adm-label">Status</label><div style="margin-top:2px">${c.status==='replied'?'<span class="pill pill-g">Approved</span>':c.status==='read'?'<span class="pill pill-b">Reviewed</span>':'<span class="pill pill-o">Pending</span>'}</div></div>
      <div><label class="adm-label">Email</label><a href="mailto:${esc(c.email)}" style="color:var(--blue-l);font-size:.84rem">${esc(c.email)}</a></div>
      <div><label class="adm-label">Phone</label><div style="font-size:.84rem;color:rgba(255,255,255,.55)">${esc(c.phone||'—')}</div></div>
      <div><label class="adm-label">Expertise</label><div style="font-size:.84rem;color:rgba(255,255,255,.7)">${esc(p.expertise)}</div></div>
      <div><label class="adm-label">Proposed Course</label><div style="font-size:.84rem;font-weight:700;color:#fff">${esc(p.proposedCourse)}</div></div>
      <div><label class="adm-label">Experience</label><span class="pill pill-b" style="font-size:.68rem">${esc(p.experience)}</span></div>
      <div><label class="adm-label">Applied</label><div style="font-size:.8rem;color:rgba(255,255,255,.4)">${fmt(c.created_at)}</div></div>
    </div>
    <div>
      <label class="adm-label">Full Application</label>
      <div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-lg);padding:14px;font-size:.79rem;color:rgba(255,255,255,.6);line-height:1.78;white-space:pre-wrap;max-height:220px;overflow-y:auto">${esc(c.message||'—')}</div>
    </div>`;
  document.getElementById('appReplyBtn').onclick=()=>{window.open(`mailto:${c.email}?subject=Your NeurowexTech Instructor Application&body=Hi ${c.name},%0A%0A`);markAppReplied(c.id);closeModal('modal-app-detail');};
  document.getElementById('appApproveBtn').onclick=()=>{approveApp(c.id);closeModal('modal-app-detail');};
  document.getElementById('appPromoteFromDetailBtn').onclick=()=>{closeModal('modal-app-detail');openPromoteModal();setTimeout(()=>{const si=document.getElementById('promoteSearch');if(si){si.value=c.name;filterPromoteList(c.name);}},200);};
  openModal('modal-app-detail');
}

async function quickPromoteFromApp(appId,name){
  const d=await api('/api/admin/users');const all=d?.users||[];
  const match=all.find(u=>u.username.toLowerCase()===name.toLowerCase());
  if(!match){toast(`No registered user found matching "${name}". Ask them to sign up first.`,'error');return;}
  if(!confirm(`Promote "${match.username}" to instructor?`))return;
  const r=await api('/api/admin/make-instructor',{method:'POST',body:JSON.stringify({userId:match.id})});
  if(r?.success){toast(`${match.username} is now an instructor! 🎓`);_courseCache=null;loadInstructors();loadInstructorApps();}
}

async function approveApp(id){const r=await api(`/api/contacts/${id}/replied`,{method:'PATCH'});if(r?.success){toast('Application approved ✓');loadInstructorApps();}}
async function markAppReplied(id){await api(`/api/contacts/${id}/replied`,{method:'PATCH'});loadInstructorApps();}
async function deleteApp(id){if(!confirm('Delete this instructor application?'))return;const r=await api(`/api/contacts/${id}`,{method:'DELETE'});if(r?.success){toast('Application deleted');loadInstructorApps();}}

/* ────────────────────────────────────
   SETTINGS
──────────────────────────────────── */
async function saveSettings(){
  const r=await api('/api/admin/settings',{method:'PUT',body:JSON.stringify({site_name:document.getElementById('cfgSiteName').value,contact_email:document.getElementById('cfgEmail').value,whatsapp_number:document.getElementById('cfgWA').value,location:document.getElementById('cfgLocation').value,tagline:document.getElementById('cfgTagline').value})});
  if(r?.success)toast('Settings saved!');
}

/* ────────────────────────────────────
   REFRESH BUTTON
──────────────────────────────────── */
document.getElementById('refreshBtn').addEventListener('click',async()=>{
  const btn=document.getElementById('refreshBtn');
  btn.innerHTML='<i class="fas fa-spinner fa-spin"></i>';
  await loadDashboard();
  btn.innerHTML='<i class="fas fa-arrows-rotate"></i>';
  toast('Data refreshed','info');
});

/* ────────────────────────────────────
   INIT
──────────────────────────────────── */
window.addEventListener('DOMContentLoaded',()=>{
  initCharts();
  loadDashboard();
  loadInstructors();
  loadInstructorApps();
  setInterval(loadDashboard,30000);
});
</script>
