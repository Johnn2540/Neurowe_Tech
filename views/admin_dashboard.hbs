     SCRIPTS
══════════════════════════════════════ -->
<script>
/* ── THEME ── */
const themeBtn = document.getElementById('themeToggleAdm');
let dark = localStorage.getItem('nw-theme') !== 'light';
const MOON_SVG = '<svg viewBox="0 0 24 24" style="width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
const SUN_SVG  = '<svg viewBox="0 0 24 24" style="width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme() { document.body.classList.toggle('dark', dark); themeBtn.innerHTML = dark ? SUN_SVG : MOON_SVG; }
applyTheme();
themeBtn.addEventListener('click', () => { dark=!dark; localStorage.setItem('nw-theme', dark?'dark':'light'); applyTheme(); });

/* ── SCROLL PROGRESS ── */
window.addEventListener('scroll', () => {
  const el = document.getElementById('scroll-progress');
  const p = (window.pageYOffset / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
  if(el) el.style.width = p + '%';
}, {passive:true});

/* ── TOAST ── */
function toast(msg, type='success') {
  const icons = { success:'fas fa-check-circle', error:'fas fa-exclamation-circle', info:'fas fa-info-circle' };
  const cols  = { success:'var(--emerald)', error:'#f87171', info:'var(--blue-l)' };
  const el = document.createElement('div');
  el.className = 'adm-toast ' + type;
  el.innerHTML = `<i class="${icons[type]}" style="color:${cols[type]};flex-shrink:0"></i>${msg}`;
  document.getElementById('adm-toast-container').appendChild(el);
  setTimeout(() => el.remove(), 3800);
}

/* ── API FETCH ── */
async function api(url, opts={}) {
  try {
    const r = await fetch(url, { headers:{'Content-Type':'application/json'}, ...opts });
    const d = await r.json();
    if(!r.ok) throw new Error(d.message || 'Request failed');
    return d;
  } catch(e) { toast(e.message, 'error'); return null; }
}

/* ── HELPERS ── */
function fmt(d) { if(!d) return '—'; return new Date(d).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}); }
function esc(s) { if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function setEl(id, v) { const el=document.getElementById(id); if(el) el.textContent=v; }

/* ── MODAL ── */
function openModal(id)  { document.getElementById(id)?.classList.add('open'); document.body.style.overflow='hidden'; }
function closeModal(id) { document.getElementById(id)?.classList.remove('open'); document.body.style.overflow=''; }
document.querySelectorAll('.adm-modal-backdrop').forEach(b => {
  b.addEventListener('click', e => { if(e.target===b) closeModal(b.id); });
});
document.addEventListener('keydown', e => { if(e.key==='Escape') document.querySelectorAll('.adm-modal-backdrop.open').forEach(b=>closeModal(b.id)); });

/* ── SIDEBAR ── */
const sidebar  = document.getElementById('admSidebar');
const mainEl   = document.getElementById('admMain');
const topbarEl = document.getElementById('admTopbar');
const mobOv    = document.getElementById('admMobOverlay');
const tbToggle = document.getElementById('tbToggle');
function isMob() { return window.innerWidth < 992; }
tbToggle.addEventListener('click', () => {
  if(isMob()) { sidebar.classList.toggle('mob-open'); mobOv.classList.toggle('open'); document.body.style.overflow = sidebar.classList.contains('mob-open')?'hidden':''; }
  else { sidebar.classList.toggle('col'); mainEl.classList.toggle('col'); topbarEl.classList.toggle('col'); }
});
mobOv.addEventListener('click', () => { sidebar.classList.remove('mob-open'); mobOv.classList.remove('open'); document.body.style.overflow=''; });

/* ── PAGE NAVIGATION ── */
const PAGE_META = {
  dashboard:   ['Dashboard',   'Live platform overview'],
  analytics:   ['Analytics',   'Traffic & growth insights'],
  users:       ['Users',       'Manage accounts and roles'],
  contacts:    ['Messages',    'Leads and enquiries'],
  subscribers: ['Subscribers', 'Newsletter list'],
  projects:    ['Portfolio',   'Showcase projects'],
  services:    ['Services',    'Manage offerings'],
  blog:        ['Blog',        'Content management'],
  testimonials:['Testimonials','Client reviews'],
  team:        ['Team',        'Manage team profiles'],
  faqs:        ['FAQs',        'Frequently asked questions'],
  pricing:     ['Pricing',     'Pricing plans'],
  courses:     ['Courses',     'Academy course catalogue'],
  enrollments: ['Enrollments', 'Course enrollments'],
  settings:    ['Settings',    'Platform configuration'],
};
const LOADERS = {
  users: loadUsers, contacts: loadContacts, subscribers: loadSubscribers,
  projects: loadProjects, services: loadServices, blog: loadBlog,
  testimonials: loadTestimonials, team: loadTeam,
  faqs: loadFAQs, pricing: loadPricing,
  courses: loadCourses, enrollments: loadEnrollments,
};

function switchPage(page) {
  document.querySelectorAll('.adm-page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.adm-nav-item[data-page]').forEach(n=>n.classList.remove('active'));
  const pg = document.getElementById('page-'+page);
  if(pg) pg.classList.add('active');
  const nav = document.querySelector(`.adm-nav-item[data-page="${page}"]`);
  if(nav) nav.classList.add('active');
  const [title, sub] = PAGE_META[page] || [page,''];
  setEl('tbTitle', title); setEl('tbSub', sub);
  if(LOADERS[page]) LOADERS[page]();
  if(isMob()) { sidebar.classList.remove('mob-open'); mobOv.classList.remove('open'); document.body.style.overflow=''; }
  window.scrollTo({top:0,behavior:'smooth'});
}
document.querySelectorAll('.adm-nav-item[data-page]').forEach(el=>{
  el.addEventListener('click',()=>switchPage(el.dataset.page));
});

/* ══ DASHBOARD ══ */
async function loadDashboard() {
  const [uD, pD, cD, sD] = await Promise.all([
    api('/api/admin/users'), api('/api/projects'), api('/api/contacts'), api('/api/subscribers')
  ]);
  const u=uD?.users?.length||0, p=pD?.projects?.length||0, c=cD?.contacts?.length||0, s=sD?.subscribers?.length||0;
  setEl('sUsers',u); setEl('sProjects',p); setEl('sContacts',c); setEl('sSubscribers',s);
  setEl('sbUserCount',u); setEl('sbContactCount',c);
  setEl('cfgUserCount',u); setEl('cfgProjectCount',p);
  setEl('aUsers',u);

  // Sidebar user initials
  const uname = document.getElementById('sbUserName')?.textContent || 'A';
  const init = uname.charAt(0).toUpperCase();
  setEl('sbUserAv', init); setEl('tbUserAv', init);

  // Recent contacts table
  const recent=(cD?.contacts||[]).slice(0,5);
  const dcb=document.getElementById('dashContactsBody');
  if(dcb) dcb.innerHTML = recent.length
    ? recent.map(c=>`<tr><td class="td-name">${esc(c.name)}</td><td><span class="pill pill-b">${esc(c.project_type||'General')}</span></td><td>${fmt(c.created_at)}</td><td><span class="pill pill-o">New</span></td></tr>`).join('')
    : `<tr><td colspan="4"><div class="adm-empty"><i class="fas fa-inbox"></i><p>No messages yet</p></div></td></tr>`;

  // Activity feed
  const acts=[];
  (cD?.contacts||[]).slice(0,3).forEach(c=>acts.push({type:'msg', label:`New message from <strong>${esc(c.name)}</strong>`, date:c.created_at}));
  (uD?.users||[]).slice(0,2).forEach(u=>acts.push({type:'user', label:`User registered: <strong>${esc(u.username)}</strong>`, date:u.created_at}));
  (sD?.subscribers||[]).slice(0,2).forEach(s=>acts.push({type:'sub', label:`Newsletter: ${esc(s.email)}`, date:s.subscribed_at}));
  acts.sort((a,b)=>new Date(b.date)-new Date(a.date));
  const iconMap={msg:'fa-envelope msg',user:'fa-user-plus user',sub:'fa-at sub',proj:'fa-folder proj'};
  const feed=document.getElementById('activityFeed');
  if(feed) feed.innerHTML = acts.slice(0,6).map(a=>`
    <div class="act-feed-item">
      <div class="act-dot-icon ${iconMap[a.type]?.split(' ')[1]||'msg'}"><i class="fas ${iconMap[a.type]?.split(' ')[0]||'fa-bell'}"></i></div>
      <div><p>${a.label}</p><time>${fmt(a.date)}</time></div>
    </div>`).join('') || `<div class="adm-empty"><i class="fas fa-clock-rotate-left"></i><p>No activity yet</p></div>`;

  updateCharts(u,s);
}

/* ══ CHARTS ══ */
let growthChart, donutChart, visitorChart;
const chartOpts = {
  plugins:{legend:{labels:{color:'rgba(255,255,255,.45)',font:{size:11}}}},
  scales:{
    x:{ticks:{color:'rgba(255,255,255,.28)'},grid:{color:'rgba(255,255,255,.04)'}},
    y:{ticks:{color:'rgba(255,255,255,.28)'},grid:{color:'rgba(255,255,255,.04)'}}
  }
};
function initCharts() {
  const gc=document.getElementById('growthChart');
  if(gc) growthChart=new Chart(gc,{type:'line',data:{labels:['Jan','Feb','Mar','Apr','May','Jun'],datasets:[
    {label:'Users',data:[0,0,0,0,0,0],borderColor:'#1a56e8',backgroundColor:'rgba(26,86,232,.08)',tension:.4,fill:true,pointBackgroundColor:'#1a56e8',pointRadius:4},
    {label:'Subscribers',data:[0,0,0,0,0,0],borderColor:'#f07020',backgroundColor:'rgba(240,112,32,.06)',tension:.4,fill:true,pointBackgroundColor:'#f07020',pointRadius:4}
  ]},options:{...chartOpts,responsive:true,maintainAspectRatio:true}});

  const dc=document.getElementById('donutChart');
  if(dc) donutChart=new Chart(dc,{type:'doughnut',data:{labels:['Direct','WhatsApp','Organic','Referral'],datasets:[{data:[38,28,22,12],backgroundColor:['#1a56e8','#25D366','#0dbf7e','#f07020'],borderWidth:0,hoverOffset:6}]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{position:'bottom',labels:{color:'rgba(255,255,255,.45)',font:{size:11},padding:12}}},cutout:'72%'}});

  const vc=document.getElementById('visitorChart');
  if(vc) visitorChart=new Chart(vc,{type:'bar',data:{labels:['Week 1','Week 2','Week 3','Week 4'],datasets:[{label:'Page Views',data:[620,890,780,1020],backgroundColor:'rgba(26,86,232,.65)',borderRadius:6,borderSkipped:false}]},options:{...chartOpts,responsive:true}});

  const cl=document.getElementById('countryList');
  if(cl) cl.innerHTML=[{f:'🇰🇪',n:'Kenya',p:42},{f:'🇺🇸',n:'United States',p:24},{f:'🇬🇧',n:'United Kingdom',p:12},{f:'🇳🇬',n:'Nigeria',p:10},{f:'🇿🇦',n:'South Africa',p:8}].map(c=>`
    <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.05)">
      <span style="font-size:1.2rem">${c.f}</span>
      <span style="flex:1;font-size:.82rem;color:rgba(255,255,255,.7)">${c.n}</span>
      <div class="country-bar" style="width:80px"><div class="country-fill" style="width:${c.p}%"></div></div>
      <span style="font-size:.73rem;color:rgba(255,255,255,.35);width:28px;text-align:right">${c.p}%</span>
    </div>`).join('');
}
function updateCharts(u,s) {
  if(!growthChart) return;
  growthChart.data.datasets[0].data=[Math.max(0,u-14),Math.max(0,u-10),Math.max(0,u-7),Math.max(0,u-4),Math.max(0,u-1),u];
  growthChart.data.datasets[1].data=[Math.max(0,s-40),Math.max(0,s-28),Math.max(0,s-16),Math.max(0,s-9),Math.max(0,s-3),s];
  growthChart.update();
}

/* ══ USERS ══ */
let allUsers=[];
async function loadUsers() {
  const d=await api('/api/admin/users'); allUsers=d?.users||[]; renderUsers(allUsers);
}
function renderUsers(arr) {
  const tb=document.getElementById('usersBody');
  if(!tb) return;
  tb.innerHTML=arr.length?arr.map(u=>`<tr>
    <td class="td-name">${esc(u.username)}</td>
    <td><a href="mailto:${esc(u.email)}" style="color:var(--blue-l)">${esc(u.email)}</a></td>
    <td><span class="pill ${u.role==='admin'?'pill-o':'pill-b'}">${esc(u.role)}</span></td>
    <td><span class="pill ${u.is_active?'pill-g':'pill-dim'}">${u.is_active?'Active':'Inactive'}</span></td>
    <td>${fmt(u.created_at)}</td>
    <td>${u.last_login?fmt(u.last_login):'<span style="color:rgba(255,255,255,.2)">Never</span>'}</td>
    <td>
      <button class="act-btn act-role" onclick="toggleRole(${u.id},'${u.role}')" title="Toggle role"><i class="fas fa-shield-halved"></i></button>
      <button class="act-btn act-del"  onclick="deleteUser(${u.id})" title="Delete"><i class="fas fa-trash"></i></button>
    </td>
  </tr>`).join('') : `<tr><td colspan="7"><div class="adm-empty"><i class="fas fa-users"></i><p>No users found</p></div></td></tr>`;
}
function filterUsers(q) { renderUsers(allUsers.filter(u=>u.username.toLowerCase().includes(q.toLowerCase())||u.email.toLowerCase().includes(q.toLowerCase()))); }
async function createUser() {
  const name=document.getElementById('newUserName').value.trim(), email=document.getElementById('newUserEmail').value.trim(), pwd=document.getElementById('newUserPassword').value;
  if(!name||!email||!pwd) return toast('Please fill all fields','error');
  const r=await api('/api/signup',{method:'POST',body:JSON.stringify({fullname:name,email,password:pwd})});
  if(r?.success){toast('User created!');closeModal('modal-add-user');['newUserName','newUserEmail','newUserPassword'].forEach(id=>document.getElementById(id).value='');loadUsers();loadDashboard();}
}
async function deleteUser(id) {
  if(!confirm('Delete this user? This cannot be undone.')) return;
  const r=await api(`/api/admin/delete-user/${id}`,{method:'DELETE'});
  if(r?.success){toast('User deleted');loadUsers();loadDashboard();}
}
async function toggleRole(id,role) {
  const ep=role==='admin'?'/api/admin/remove-admin':'/api/admin/make-admin';
  const r=await api(ep,{method:'POST',body:JSON.stringify({userId:id})});
  if(r?.success){toast('Role updated');loadUsers();}
}

/* ══ CONTACTS ══ */
async function loadContacts() {
  const d=await api('/api/contacts'); const arr=d?.contacts||[];
  setEl('contactCountBadge', arr.length+' messages');
  const tb=document.getElementById('contactsBody');
  if(!tb) return;
  tb.innerHTML=arr.length?arr.map(c=>`<tr>
    <td class="td-name">${esc(c.name)}</td>
    <td><a href="mailto:${esc(c.email)}" style="color:var(--blue-l)">${esc(c.email)}</a></td>
    <td>${c.project_type?`<span class="pill pill-b">${esc(c.project_type)}</span>`:'—'}</td>
    <td>${c.budget?esc(c.budget):'—'}</td>
    <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(c.message||'')}</td>
    <td>${fmt(c.created_at)}</td>
    <td>
      <a href="mailto:${esc(c.email)}" class="act-btn act-view" title="Reply"><i class="fas fa-reply"></i></a>
      <button class="act-btn act-del" onclick="deleteContact(${c.id})" title="Delete"><i class="fas fa-trash"></i></button>
    </td>
  </tr>`).join('') : `<tr><td colspan="7"><div class="adm-empty"><i class="fas fa-inbox"></i><p>No messages yet</p></div></td></tr>`;
}
async function deleteContact(id) {
  if(!confirm('Delete this message?')) return;
  const r=await api(`/api/contacts/${id}`,{method:'DELETE'});
  if(r?.success){toast('Message deleted');loadContacts();loadDashboard();}
}

/* ══ SUBSCRIBERS ══ */
async function loadSubscribers() {
  const d=await api('/api/subscribers'); const arr=d?.subscribers||[];
  setEl('subCountBadge', arr.length+' subscribers');
  const tb=document.getElementById('subsBody');
  if(!tb) return;
  tb.innerHTML=arr.length?arr.map((s,i)=>`<tr>
    <td style="color:rgba(255,255,255,.3)">${i+1}</td>
    <td class="td-name">${esc(s.email)}</td>
    <td>${fmt(s.subscribed_at)}</td>
    <td><button class="act-btn act-del" onclick="deleteSub(${s.id})"><i class="fas fa-trash"></i></button></td>
  </tr>`).join('') : `<tr><td colspan="4"><div class="adm-empty"><i class="fas fa-at"></i><p>No subscribers yet</p></div></td></tr>`;
}
async function deleteSub(id) {
  if(!confirm('Remove subscriber?')) return;
  const r=await api(`/api/subscribers/${id}`,{method:'DELETE'});
  if(r?.success){toast('Removed');loadSubscribers();loadDashboard();}
}

/* ══ PROJECTS ══ */
async function loadProjects() {
  const d=await api('/api/projects'); const arr=d?.projects||[];
  const tb=document.getElementById('projectsBody');
  if(!tb) return;
  tb.innerHTML=arr.length?arr.map(p=>`<tr>
    <td class="td-name">${esc(p.name)}</td>
    <td><span class="pill pill-b">${esc(p.category||'Web')}</span></td>
    <td>${esc(p.year||'—')}</td>
    <td style="font-size:.72rem;color:rgba(255,255,255,.4)">${esc(p.tech_stack||'—')}</td>
    <td><span class="pill ${p.featured?'pill-g':'pill-dim'}">${p.featured?'Yes':'No'}</span></td>
    <td>${p.client_url?`<a href="${esc(p.client_url)}" target="_blank" class="pill pill-b">Visit ↗</a>`:'—'}</td>
    <td><button class="act-btn act-del" onclick="deleteProject(${p.id})"><i class="fas fa-trash"></i></button></td>
  </tr>`).join('') : `<tr><td colspan="7"><div class="adm-empty"><i class="fas fa-briefcase"></i><p>No projects yet</p></div></td></tr>`;
}
async function createProject() {
  const name=document.getElementById('projName').value.trim();
  if(!name) return toast('Project name required','error');
  const r=await api('/api/projects',{method:'POST',body:JSON.stringify({name,description:document.getElementById('projDesc').value,category:document.getElementById('projCategory').value,year:parseInt(document.getElementById('projYear').value)||2025,client_url:document.getElementById('projUrl').value,tech_stack:document.getElementById('projTech').value,featured:document.getElementById('projFeatured').checked})});
  if(r?.success){toast('Project added!');closeModal('modal-add-project');document.getElementById('projName').value='';loadProjects();loadDashboard();}
}
async function deleteProject(id) {
  if(!confirm('Delete project?')) return;
  const r=await api(`/api/projects/${id}`,{method:'DELETE'});
  if(r?.success){toast('Deleted');loadProjects();loadDashboard();}
}

/* ══ SERVICES ══ */
async function loadServices() {
  const d=await api('/api/services'); const arr=d?.services||[];
