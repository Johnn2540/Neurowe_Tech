  ║  Rendered by: GET /admin_dashboard  (isAuthenticated + isAdmin)         ║
  ║  GLOBAL: userName, stats.total_users, stats.total_projects,             ║
  ║          stats.total_instructors                                         ║
  ╚══════════════════════════════════════════════════════════════════════════╝
--}}
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Admin Panel | NeurowexTech</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300;1,9..144,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
/* ══════════════════════════════════════════
   TOKENS
══════════════════════════════════════════ */
:root{
  --blue:       #1a56e8;
  --blue-d:     #1341c4;
  --blue-l:     #4f7df5;
  --blue-pale:  rgba(26,86,232,.09);
  --orange:     #f07020;
  --orange-d:   #d45c10;
  --orange-l:   #f5a060;
  --orange-pale:rgba(240,112,32,.09);
  --black:      #080c18;
  --ink:        #0f1628;
  --ink-2:      #18213a;
  --slate:      #5c6b8a;
  --mist:       #e4e9f4;
  --ghost:      #f6f8fd;
  --white:      #ffffff;
  --emerald:    #0dbf7e;
  --teal:       #00b09c;
  --g-blue:     linear-gradient(135deg,#1a56e8 0%,#1341c4 100%);
  --g-orange:   linear-gradient(135deg,#f07020 0%,#d45c10 100%);
  --r-xl:       20px;
  --r-lg:       14px;
  --r-md:       10px;
  --r-pill:     999px;
  --nav-h:      64px;
  --ease:       cubic-bezier(.4,0,.2,1);
  --spring:     cubic-bezier(.34,1.56,.64,1);
  --t:          .28s var(--ease);
  --sh-blue:    0 8px 28px rgba(26,86,232,.26);
  --sh-orange:  0 8px 28px rgba(240,112,32,.26);
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{
  font-family:'Plus Jakarta Sans',system-ui,sans-serif;
  background:var(--black);color:rgba(255,255,255,.78);
  overflow-x:hidden;font-size:14px;line-height:1.6;
}
body.dark{background:#030609}
h1,h2,h3,h4,h5,h6{font-family:'Fraunces',Georgia,serif;line-height:1.12;letter-spacing:-.3px}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:var(--ink)}
::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:var(--blue-l)}

/* ── SCROLL PROGRESS ── */
#scroll-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,var(--blue),var(--orange));z-index:9999;transition:width .1s linear}

/* ── ANIMATIONS ── */
@keyframes adm-modal-in{from{transform:scale(.94) translateY(8px);opacity:0}to{transform:none;opacity:1}}
@keyframes toast-in{from{transform:translateX(16px);opacity:0}to{transform:none;opacity:1}}
@keyframes pg-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
@keyframes cm-in{from{opacity:0;transform:translateX(10px)}to{opacity:1;transform:none}}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes instr-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* ── UTILITIES ── */
.section-tag{display:inline-flex;align-items:center;gap:6px;background:var(--blue-pale);color:var(--blue);border-radius:var(--r-pill);padding:5px 16px;font-size:.67rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;border:1px solid rgba(26,86,232,.14)}
.section-tag::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue)}
.section-tag.orange{background:var(--orange-pale);color:var(--orange);border-color:rgba(240,112,32,.14)}
.section-tag.orange::before{background:var(--orange)}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-orange{background:var(--g-orange);-webkit-background-clip:text;background-clip:text;color:transparent}

/* ══════════════════════════════════════════
   SIDEBAR
══════════════════════════════════════════ */
.adm-sidebar{
  position:fixed;left:0;top:0;height:100vh;height:100dvh;width:268px;
  background:var(--ink);border-right:1px solid rgba(255,255,255,.06);
  display:flex;flex-direction:column;z-index:1050;
  transition:width .3s var(--ease);overflow-x:hidden;
}
.adm-sidebar.col{width:68px}
body.dark .adm-sidebar{background:#070d1a}
.adm-brand{display:flex;align-items:center;gap:10px;padding:0 18px;height:64px;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,.06);overflow:hidden}
.adm-brand-mark{width:34px;height:34px;min-width:34px;border-radius:10px;background:var(--g-blue);display:flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:800;font-size:.95rem;color:#fff}
.adm-brand-text{overflow:hidden;white-space:nowrap}
.adm-brand-text strong{display:block;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:.92rem;font-weight:800;color:#fff;line-height:1.1}
.adm-brand-text span{font-size:.58rem;color:var(--orange-l);font-weight:700;text-transform:uppercase;letter-spacing:1.5px}
.adm-sidebar.col .adm-brand-text{opacity:0;width:0}
.adm-user-card{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.06);flex-shrink:0;overflow:hidden}
.adm-user-av{width:36px;height:36px;min-width:36px;border-radius:50%;background:var(--g-blue);display:flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:800;font-size:.85rem;color:#fff}
.adm-user-name{font-size:.82rem;font-weight:700;color:#fff;white-space:nowrap}
.adm-user-role{font-size:.62rem;color:var(--orange-l);font-weight:700;text-transform:uppercase;letter-spacing:1px;white-space:nowrap}
.adm-sidebar.col .adm-user-card>div:last-child{display:none}
.adm-nav{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding:10px 0}
.adm-nav::-webkit-scrollbar{width:0}
.adm-sec-label{padding:14px 20px 4px;font-size:.58rem;font-weight:800;text-transform:uppercase;letter-spacing:2px;color:rgba(255,255,255,.22);white-space:nowrap}
.adm-sidebar.col .adm-sec-label{opacity:0}
.adm-nav-item{margin:2px 8px}
.adm-nav-link{
  display:flex;align-items:center;gap:11px;padding:9px 12px;border-radius:var(--r-md);
  color:rgba(255,255,255,.48);text-decoration:none;transition:var(--t);cursor:pointer;
  border:1px solid transparent;white-space:nowrap;position:relative;-webkit-tap-highlight-color:transparent;
}
.adm-nav-link:hover{background:rgba(255,255,255,.05);color:rgba(255,255,255,.8)}
.adm-nav-item.active .adm-nav-link{background:rgba(26,86,232,.18);border-color:rgba(26,86,232,.22);color:var(--blue-l)}
.adm-nav-item.active .adm-nav-link::before{content:'';position:absolute;left:0;top:22%;bottom:22%;width:3px;background:var(--blue);border-radius:0 3px 3px 0}
.adm-nav-icon{width:18px;min-width:18px;text-align:center;font-size:.88rem;flex-shrink:0}
.adm-nav-label{font-size:.83rem;font-weight:600;transition:var(--t)}
.adm-sidebar.col .adm-nav-label{opacity:0;width:0;overflow:hidden}
.adm-nav-badge{margin-left:auto;background:#ef4444;color:#fff;font-size:.6rem;font-weight:800;border-radius:99px;padding:1px 7px;min-width:18px;text-align:center;flex-shrink:0}
.adm-sidebar.col .adm-nav-badge{display:none}
.adm-sidebar.col .adm-nav-link::after{
  content:attr(data-label);position:absolute;left:calc(68px - 4px);
  background:var(--ink-2);color:rgba(255,255,255,.85);font-size:.76rem;font-weight:600;
  padding:6px 12px;border-radius:var(--r-md);border:1px solid rgba(255,255,255,.1);
  white-space:nowrap;pointer-events:none;opacity:0;transform:translateX(-4px);
  transition:opacity .18s,transform .18s;z-index:200;
}
.adm-sidebar.col .adm-nav-link:hover::after{opacity:1;transform:translateX(0)}
.adm-nav-div{border:none;border-top:1px solid rgba(255,255,255,.06);margin:8px 12px}
.adm-sidebar-foot{padding:10px 8px;border-top:1px solid rgba(255,255,255,.08);flex-shrink:0;background:inherit}

/* ══════════════════════════════════════════
   TOPBAR
══════════════════════════════════════════ */
.adm-topbar{
  position:fixed;top:0;left:268px;right:0;height:64px;
  background:var(--ink);border-bottom:1px solid rgba(255,255,255,.06);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 22px;z-index:1000;transition:left .3s var(--ease);
}
.adm-topbar.col{left:68px}
body.dark .adm-topbar{background:#070d1a}
.tb-l{display:flex;align-items:center;gap:12px}
.tb-toggle{
  width:36px;height:36px;border-radius:var(--r-md);
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
  color:rgba(255,255,255,.5);cursor:pointer;display:flex;align-items:center;
  justify-content:center;transition:var(--t);font-size:.88rem;
}
.tb-toggle:hover{background:var(--blue-pale);color:var(--blue-l);border-color:rgba(26,86,232,.3)}
.tb-page-title{font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:.97rem;font-weight:700;color:#fff}
.tb-page-sub{font-size:.68rem;color:rgba(255,255,255,.32);margin-top:1px}
.tb-r{display:flex;align-items:center;gap:8px}
.tb-btn{
  width:36px;height:36px;border-radius:var(--r-md);
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
  color:rgba(255,255,255,.48);cursor:pointer;display:flex;align-items:center;
  justify-content:center;transition:var(--t);text-decoration:none;font-size:.85rem;
}
.tb-btn:hover{border-color:rgba(255,255,255,.16);color:rgba(255,255,255,.85)}
.tb-btn.wa:hover{background:rgba(37,211,102,.1);color:#25D366;border-color:rgba(37,211,102,.25)}
.tb-btn.refresh:hover{background:var(--blue-pale);color:var(--blue-l)}
.tb-user-chip{
  display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
  border-radius:var(--r-pill);padding:5px 13px 5px 5px;cursor:pointer;transition:var(--t);
}
.tb-user-chip:hover{border-color:rgba(255,255,255,.15)}
.tb-chip-av{width:26px;height:26px;border-radius:50%;background:var(--g-blue);display:flex;align-items:center;justify-content:center;font-size:.68rem;font-weight:800;color:#fff}
.tb-chip-name{font-size:.78rem;font-weight:700;color:rgba(255,255,255,.85);font-family:'Plus Jakarta Sans',system-ui,sans-serif}

/* ══════════════════════════════════════════
   MAIN / PAGES
══════════════════════════════════════════ */
.adm-main{margin-left:268px;padding-top:64px;min-height:100vh;transition:margin-left .3s var(--ease)}
.adm-main.col{margin-left:68px}
.adm-page{padding:26px;display:none;animation:pg-in .28s var(--ease)}
.adm-page.active{display:block}
.pg-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:26px;gap:14px;flex-wrap:wrap}
.pg-head h2{font-size:clamp(1.3rem,3vw,1.7rem);font-weight:800;color:#fff;line-height:1.1}
.pg-head .sub{color:rgba(255,255,255,.35);font-size:.8rem;margin-top:4px}

/* ══════════════════════════════════════════
   STAT CARDS
══════════════════════════════════════════ */
.adm-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px}
@media(max-width:1100px){.adm-stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:540px){.adm-stats{grid-template-columns:1fr}}
.adm-stat{
  background:var(--ink-2);border:1px solid rgba(255,255,255,.06);
  border-radius:var(--r-xl);padding:20px 18px;position:relative;overflow:hidden;transition:var(--t);
}
.adm-stat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;border-radius:var(--r-xl) var(--r-xl) 0 0}
.adm-stat.c-b::before{background:linear-gradient(90deg,var(--blue),var(--blue-l))}
.adm-stat.c-o::before{background:var(--g-orange)}
.adm-stat.c-g::before{background:linear-gradient(90deg,var(--emerald),#34d399)}
.adm-stat.c-p::before{background:linear-gradient(90deg,#8b5cf6,#c084fc)}
.adm-stat.c-t::before{background:linear-gradient(90deg,var(--teal),#5eead4)}
.adm-stat.c-r::before{background:linear-gradient(90deg,#ef4444,#f87171)}
.adm-stat:hover{transform:translateY(-3px);box-shadow:0 14px 36px rgba(0,0,0,.3)}
.adm-stat-icon{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.05rem;margin-bottom:13px}
.c-b .adm-stat-icon{background:rgba(26,86,232,.15);color:var(--blue-l)}
.c-o .adm-stat-icon{background:var(--orange-pale);color:var(--orange-l)}
.c-g .adm-stat-icon{background:rgba(13,191,126,.12);color:var(--emerald)}
.c-p .adm-stat-icon{background:rgba(139,92,246,.12);color:#c084fc}
.c-t .adm-stat-icon{background:rgba(0,176,156,.12);color:#5eead4}
.c-r .adm-stat-icon{background:rgba(239,68,68,.1);color:#f87171}
.adm-stat-val{font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:2rem;font-weight:800;color:#fff;line-height:1;margin-bottom:4px}
.adm-stat-label{font-size:.72rem;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:.6px;font-weight:600}
.adm-stat-sub{font-size:.72rem;color:rgba(92,198,120,.8);font-weight:600;margin-top:2px}
.adm-stat-trend{position:absolute;top:18px;right:16px;font-size:.66rem;font-weight:700;padding:3px 8px;border-radius:99px}
.trend-live{background:rgba(26,86,232,.2);color:var(--blue-l)}
.trend-up{background:rgba(13,191,126,.15);color:var(--emerald)}
.trend-new{background:var(--orange-pale);color:var(--orange-l)}

/* ══════════════════════════════════════════
   PANELS
══════════════════════════════════════════ */
.panel{background:var(--ink-2);border:1px solid rgba(255,255,255,.06);border-radius:var(--r-xl);overflow:hidden;transition:var(--t)}
.panel-head{padding:16px 20px;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.panel-title{font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:.9rem;font-weight:700;color:#fff;display:flex;align-items:center;gap:8px}
.panel-title i{color:var(--blue-l);font-size:.84rem}
.panel-body{padding:18px 20px}
.grid-2-1{display:grid;grid-template-columns:2fr 1fr;gap:18px}
.grid-1-1{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media(max-width:1024px){.grid-2-1,.grid-1-1{grid-template-columns:1fr}}
@media(max-width:900px){.grid-3{grid-template-columns:1fr 1fr}}
@media(max-width:540px){.grid-3{grid-template-columns:1fr}}

/* ══════════════════════════════════════════
   TABLE
══════════════════════════════════════════ */
.adm-table{width:100%;border-collapse:collapse}
.adm-table thead th{padding:10px 14px;font-size:.64rem;font-weight:800;text-transform:uppercase;letter-spacing:1.2px;color:rgba(255,255,255,.28);background:rgba(255,255,255,.02);border-bottom:1px solid rgba(255,255,255,.06);white-space:nowrap}
.adm-table tbody td{padding:12px 14px;font-size:.8rem;color:rgba(255,255,255,.55);border-bottom:1px solid rgba(255,255,255,.04);vertical-align:middle}
.adm-table tbody tr:last-child td{border-bottom:none}
.adm-table tbody tr:hover td{background:rgba(255,255,255,.02)}
.td-name{color:rgba(255,255,255,.87)!important;font-weight:600}

/* ══════════════════════════════════════════
   PILLS
══════════════════════════════════════════ */
.pill{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:99px;font-size:.65rem;font-weight:800;white-space:nowrap;text-transform:uppercase;letter-spacing:.3px}
.pill-b{background:rgba(26,86,232,.18);color:var(--blue-l)}
.pill-o{background:var(--orange-pale);color:var(--orange-l)}
.pill-g{background:rgba(13,191,126,.12);color:var(--emerald)}
.pill-p{background:rgba(139,92,246,.12);color:#c084fc}
.pill-r{background:rgba(239,68,68,.1);color:#f87171}
.pill-t{background:rgba(0,176,156,.12);color:#5eead4}
.pill-dim{background:rgba(255,255,255,.07);color:rgba(255,255,255,.38)}

/* ══════════════════════════════════════════
   ACTION BUTTONS
══════════════════════════════════════════ */
.act-btn{width:28px;height:28px;border-radius:8px;border:none;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:.72rem;transition:var(--t);margin:0 2px}
.act-edit{background:rgba(26,86,232,.15);color:var(--blue-l)}
.act-edit:hover{background:var(--blue);color:#fff}
.act-del{background:rgba(239,68,68,.1);color:#f87171}
.act-del:hover{background:#ef4444;color:#fff}
.act-view{background:rgba(13,191,126,.1);color:var(--emerald)}
.act-view:hover{background:var(--emerald);color:#fff}
.act-role{background:rgba(139,92,246,.12);color:#c084fc}
.act-role:hover{background:#8b5cf6;color:#fff}
.act-orange{background:var(--orange-pale);color:var(--orange-l)}
.act-orange:hover{background:var(--orange);color:#fff}

/* ══════════════════════════════════════════
   ADMIN BUTTONS
══════════════════════════════════════════ */
.btn-adm{display:inline-flex;align-items:center;gap:7px;background:var(--g-blue);color:#fff;border:none;padding:9px 18px;border-radius:var(--r-pill);font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:700;font-size:.8rem;cursor:pointer;transition:var(--t);white-space:nowrap;text-decoration:none}
.btn-adm:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(26,86,232,.35);color:#fff}
.btn-adm.o{background:var(--g-orange)}
.btn-adm.o:hover{box-shadow:0 8px 24px rgba(240,112,32,.35)}
.btn-adm.ghost{background:rgba(255,255,255,.05);color:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.1)}
.btn-adm.ghost:hover{border-color:rgba(255,255,255,.22);color:rgba(255,255,255,.9);box-shadow:none;transform:none}
.btn-adm.danger{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.2)}
.btn-adm.danger:hover{background:#ef4444;color:#fff;box-shadow:0 6px 18px rgba(239,68,68,.3)}
.btn-adm.sm{padding:7px 14px;font-size:.74rem}

/* ══════════════════════════════════════════
   SEARCH
══════════════════════════════════════════ */
.adm-search{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:var(--r-pill);padding:7px 14px}
.adm-search i{color:rgba(255,255,255,.3);font-size:.8rem}
.adm-search input{background:none;border:none;outline:none;color:rgba(255,255,255,.8);font-size:.82rem;font-family:'Plus Jakarta Sans',system-ui,sans-serif;width:170px}
.adm-search input::placeholder{color:rgba(255,255,255,.28)}

/* ══════════════════════════════════════════
   FORM CONTROLS
══════════════════════════════════════════ */
.adm-label{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.7px;color:rgba(255,255,255,.38);display:block;margin-bottom:6px}
.adm-input{width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:var(--r-md);color:rgba(255,255,255,.85);padding:10px 13px;font-size:.84rem;font-family:'Plus Jakarta Sans',system-ui,sans-serif;transition:var(--t);outline:none}
.adm-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,86,232,.15);background:rgba(255,255,255,.07)}
.adm-input::placeholder{color:rgba(255,255,255,.22)}
.adm-input option{background:var(--ink-2)}
select.adm-input{cursor:pointer}
textarea.adm-input{resize:vertical}
.adm-toggle{position:relative;display:inline-block;width:38px;height:21px;flex-shrink:0}
.adm-toggle input{display:none}
.adm-track{position:absolute;inset:0;border-radius:99px;background:rgba(255,255,255,.12);cursor:pointer;transition:var(--t)}
.adm-track::after{content:'';position:absolute;top:3px;left:3px;width:15px;height:15px;border-radius:50%;background:rgba(255,255,255,.6);transition:var(--t)}
.adm-toggle input:checked+.adm-track{background:var(--blue)}
.adm-toggle input:checked+.adm-track::after{transform:translateX(17px);background:#fff}

/* ══════════════════════════════════════════
   MODAL
══════════════════════════════════════════ */
.adm-modal-backdrop{position:fixed;inset:0;background:rgba(8,12,24,.7);backdrop-filter:blur(8px);z-index:2000;display:none;align-items:center;justify-content:center;padding:16px}
.adm-modal-backdrop.open{display:flex}
.adm-modal{background:var(--ink-2);border:1px solid rgba(255,255,255,.1);border-radius:var(--r-xl);width:100%;max-width:500px;box-shadow:0 28px 72px rgba(0,0,0,.5);animation:adm-modal-in .28s var(--spring) both;overflow:hidden}
.adm-modal.wide{max-width:680px}
.adm-modal.tall{max-height:90dvh;display:flex;flex-direction:column}
.adm-modal-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid rgba(255,255,255,.07);flex-shrink:0}
.adm-modal-head h5{font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:.95rem;font-weight:800;color:#fff;margin:0;display:flex;align-items:center;gap:8px}
.adm-modal-close{width:32px;height:32px;border:none;background:rgba(255,255,255,.07);border-radius:var(--r-md);cursor:pointer;color:rgba(255,255,255,.6);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.8rem}
.adm-modal-close:hover{background:#ef4444;color:#fff}
.adm-modal-body{padding:22px;display:flex;flex-direction:column;gap:14px;overflow-y:auto}
.adm-modal-foot{padding:14px 22px;border-top:1px solid rgba(255,255,255,.07);display:flex;justify-content:flex-end;gap:9px;flex-shrink:0}

/* ══════════════════════════════════════════
   MOBILE OVERLAY
══════════════════════════════════════════ */
.adm-mob-overlay{position:fixed;inset:0;background:rgba(8,12,24,.6);backdrop-filter:blur(5px);z-index:1049;opacity:0;visibility:hidden;transition:opacity .3s}
.adm-mob-overlay.open{opacity:1;visibility:visible}
.tb-signout-mob{display:none}
@media(max-width:991px){
  .adm-sidebar{transform:translateX(-100%);width:268px!important}
  .adm-sidebar.mob-open{transform:translateX(0)}
  .adm-topbar,.adm-main{left:0!important;margin-left:0!important}
  .adm-page{padding:14px}
  .pg-head h2{font-size:1.25rem}
  .tb-signout-mob{display:flex}
}

/* ══════════════════════════════════════════
   DASHBOARD SPECIFICS
══════════════════════════════════════════ */
.wa-banner{background:linear-gradient(135deg,rgba(37,211,102,.07),rgba(18,140,126,.06));border:1px solid rgba(37,211,102,.16);border-radius:var(--r-xl);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px;flex-wrap:wrap}
.wa-banner-l{display:flex;align-items:center;gap:10px;font-size:.82rem;color:#6ee7b7;font-weight:600}
.wa-pulse{width:8px;height:8px;border-radius:50%;background:#25D366;flex-shrink:0;animation:pulse-dot 2s infinite}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.quick-btn{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-md);padding:12px;cursor:pointer;transition:var(--t);text-align:left}
.quick-btn:hover{border-color:rgba(26,86,232,.35);background:rgba(26,86,232,.08);transform:translateY(-2px)}
.quick-btn-icon{width:30px;height:30px;border-radius:8px;background:rgba(26,86,232,.15);color:var(--blue-l);display:flex;align-items:center;justify-content:center;font-size:.8rem;flex-shrink:0}
.quick-btn span{font-size:.77rem;font-weight:700;color:rgba(255,255,255,.7)}
.act-feed-item{display:flex;align-items:flex-start;gap:11px;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.04)}
.act-feed-item:last-child{border-bottom:none}
.act-dot-icon{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.76rem;flex-shrink:0}
.act-dot-icon.msg{background:rgba(26,86,232,.15);color:var(--blue-l)}
.act-dot-icon.user{background:rgba(13,191,126,.12);color:var(--emerald)}
.act-dot-icon.sub{background:rgba(139,92,246,.12);color:#c084fc}
.act-feed-item p{font-size:.79rem;color:rgba(255,255,255,.65);margin:0}
.act-feed-item time{font-size:.68rem;color:rgba(255,255,255,.28)}
.country-bar{height:5px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden}
.country-fill{height:100%;background:var(--g-blue);border-radius:99px}

/* ══════════════════════════════════════════
   SETTINGS
══════════════════════════════════════════ */
.setting-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.05);flex-wrap:wrap}
.setting-row:last-child{border-bottom:none}
.setting-info p{font-size:.83rem;font-weight:600;color:rgba(255,255,255,.78);margin:0}
.setting-info span{font-size:.72rem;color:rgba(255,255,255,.3)}
.setting-section-title{font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;color:rgba(255,255,255,.28);margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,.06)}

/* ══════════════════════════════════════════
   EMPTY STATE
══════════════════════════════════════════ */
.adm-empty{padding:36px;text-align:center}
.adm-empty i{font-size:2.4rem;color:rgba(255,255,255,.15);margin-bottom:10px;display:block}
.adm-empty h6{font-size:.9rem;font-weight:700;color:rgba(255,255,255,.45);margin-bottom:5px}
.adm-empty p{font-size:.78rem;color:rgba(255,255,255,.25)}

/* ══════════════════════════════════════════
   COURSE MODAL — 3-Step
══════════════════════════════════════════ */
.course-modal{max-width:640px;width:calc(100vw - 32px);max-height:92dvh;display:flex;flex-direction:column}
.course-modal-body{flex:1;overflow-y:auto;overflow-x:hidden;padding:20px 22px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent}
.course-modal-body::-webkit-scrollbar{width:4px}
.course-modal-body::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:4px}
.cm-steps{display:flex;align-items:center;margin-bottom:24px;gap:0}
.cm-step{display:flex;align-items:center;gap:7px;flex-shrink:0}
.cm-step-num{width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,.1);color:rgba(255,255,255,.4);font-size:.72rem;font-weight:800;display:flex;align-items:center;justify-content:center;transition:var(--t);border:1.5px solid rgba(255,255,255,.12)}
.cm-step-label{font-size:.74rem;font-weight:700;color:rgba(255,255,255,.3);transition:var(--t)}
.cm-step.active .cm-step-num{background:var(--blue);color:#fff;border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,86,232,.2)}
.cm-step.done .cm-step-num{background:var(--emerald);color:#fff;border-color:var(--emerald)}
.cm-step.active .cm-step-label,.cm-step.done .cm-step-label{color:rgba(255,255,255,.8)}
.cm-step-line{flex:1;height:1.5px;background:rgba(255,255,255,.1);margin:0 8px;min-width:20px}
.cm-panel{display:none;flex-direction:column;gap:14px;animation:cm-in .22s ease}
.cm-panel.active{display:flex}
.cm-field{display:flex;flex-direction:column;gap:5px}
.cm-req{color:#f87171}
.cm-hint{font-size:.7rem;color:rgba(255,255,255,.28);margin:0}
.cm-big-input{font-size:.92rem!important;padding:12px 14px!important}
.cm-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:479px){.cm-grid-2{grid-template-columns:1fr}}
.cm-price-wrap{display:flex;gap:8px}
.cm-price-tag{flex:1;padding:9px 14px;border-radius:var(--r-md);font-size:.8rem;font-weight:700;cursor:pointer;border:1.5px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:rgba(255,255,255,.5);font-family:'Plus Jakarta Sans',system-ui,sans-serif;transition:var(--t);display:flex;align-items:center;justify-content:center;gap:6px}
.cm-price-tag.active{background:rgba(26,86,232,.18);border-color:var(--blue);color:var(--blue-l)}
.cm-price-tag:hover:not(.active){border-color:rgba(255,255,255,.22);color:rgba(255,255,255,.7)}
.cm-price-inp{transition:opacity .2s}
.cm-price-inp.hidden{opacity:.3;pointer-events:none}
.cm-upload-zone{border:2px dashed rgba(255,255,255,.16);border-radius:var(--r-lg);min-height:120px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:border-color .22s,background .22s;position:relative;overflow:hidden}
.cm-upload-zone:hover{border-color:var(--blue);background:rgba(26,86,232,.06)}
.cm-upload-idle{display:flex;flex-direction:column;align-items:center;gap:7px;padding:24px;text-align:center;pointer-events:none}
.cm-upload-idle i{font-size:1.8rem;color:rgba(255,255,255,.25)}
.cm-upload-idle span:first-of-type{font-size:.84rem;font-weight:700;color:rgba(255,255,255,.55)}
.cm-upload-sub{font-size:.7rem;color:rgba(255,255,255,.28)}
.cm-upload-progress{display:flex;align-items:center;gap:9px;font-size:.82rem;color:var(--blue-l)}
.cm-upload-preview{width:100%;height:140px;position:relative}
.cm-upload-preview img{width:100%;height:100%;object-fit:cover;border-radius:calc(var(--r-lg) - 2px)}
.cm-remove-img{position:absolute;top:8px;right:8px;width:28px;height:28px;background:rgba(0,0,0,.6);border:none;border-radius:50%;color:#fff;cursor:pointer;font-size:.78rem;display:flex;align-items:center;justify-content:center;transition:var(--t)}
.cm-remove-img:hover{background:#ef4444}
.cm-toggles-grid{display:flex;flex-direction:column;gap:0;border:1px solid rgba(255,255,255,.07);border-radius:var(--r-lg);overflow:hidden}
.cm-toggle-row{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;gap:16px;cursor:pointer;transition:background .18s;border-bottom:1px solid rgba(255,255,255,.05)}
.cm-toggle-row:last-child{border-bottom:none}
.cm-toggle-row:hover{background:rgba(255,255,255,.03)}
.cm-toggle-info{flex:1}
.cm-toggle-title{font-size:.84rem;font-weight:700;color:rgba(255,255,255,.8);display:block}
.cm-toggle-sub{font-size:.72rem;color:rgba(255,255,255,.3);margin-top:2px;display:block}
.cm-summary{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:var(--r-lg);overflow:hidden;margin-top:6px}
.cm-summary-title{padding:10px 14px;font-size:.72rem;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:rgba(255,255,255,.3);border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:7px}
.cm-summary-title i{color:var(--blue-l)}
.cm-sum-row{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:9px 14px;border-bottom:1px solid rgba(255,255,255,.04);font-size:.8rem}
.cm-sum-row:last-child{border-bottom:none}
.cm-sum-row span{color:rgba(255,255,255,.35);flex-shrink:0}
.cm-sum-row strong{color:rgba(255,255,255,.78);text-align:right;word-break:break-word}
.cm-foot{display:flex;align-items:center;gap:8px;flex-wrap:nowrap}
@media(max-width:640px){
  .course-modal{width:100%;max-width:100%;max-height:100dvh;border-radius:var(--r-xl) var(--r-xl) 0 0;margin:auto 0 0;align-self:flex-end}
  .adm-modal-backdrop{align-items:flex-end}
}
@media(max-width:400px){.cm-step-label{display:none}.course-modal-body{padding:16px}}
.course-thumb{width:42px;height:30px;object-fit:cover;border-radius:6px;background:var(--ink-2);flex-shrink:0}
.course-row-name{display:flex;align-items:center;gap:9px}

/* ══════════════════════════════════════════
   INSTRUCTOR CARDS  (new)
══════════════════════════════════════════ */
.instr-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(290px,1fr));
  gap:16px;padding:18px;
}
@media(max-width:640px){.instr-grid{grid-template-columns:1fr;padding:12px}}
.instr-card{
  background:var(--ink-2);border:1px solid rgba(255,255,255,.07);
  border-radius:var(--r-xl);padding:0;
  display:flex;flex-direction:column;
  position:relative;overflow:hidden;transition:var(--t);
  animation:instr-in .3s var(--ease) both;
}
.instr-card:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(0,0,0,.35);border-color:rgba(240,112,32,.2)}
.instr-card-stripe{height:3px;background:linear-gradient(90deg,var(--orange),#f5a060)}
.instr-card-body{padding:18px 18px 14px;flex:1;display:flex;flex-direction:column;gap:14px}
.instr-card-head{display:flex;align-items:flex-start;gap:12px}
.instr-avatar{
  width:44px;height:44px;min-width:44px;border-radius:50%;
  background:linear-gradient(135deg,var(--orange),var(--orange-d));
  display:flex;align-items:center;justify-content:center;
  font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:800;font-size:1.1rem;color:#fff;
}
.instr-info{flex:1;min-width:0}
.instr-name{font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:.88rem;font-weight:800;color:#fff;line-height:1.2;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.instr-email{font-size:.71rem;color:rgba(255,255,255,.35);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.instr-since{font-size:.64rem;color:rgba(255,255,255,.22);margin-top:2px}

/* Course assignment area */
.instr-courses-label{font-size:.62rem;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,.28);margin-bottom:6px}
.instr-courses-wrap{
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);
  border-radius:var(--r-md);padding:10px 11px;min-height:46px;display:flex;flex-wrap:wrap;gap:4px;align-items:flex-start;
}
.instr-course-tag{
  display:inline-flex;align-items:center;gap:5px;
  background:rgba(0,176,156,.12);color:#5eead4;
  border:1px solid rgba(0,176,156,.2);border-radius:var(--r-pill);
  font-size:.68rem;font-weight:700;padding:3px 8px;
  max-width:100%;
}
.instr-course-tag span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:150px}
.instr-tag-del{
  width:14px;height:14px;border-radius:50%;
  background:rgba(255,255,255,.1);border:none;color:rgba(255,255,255,.4);
  cursor:pointer;display:inline-flex;align-items:center;justify-content:center;
  font-size:.5rem;transition:var(--t);flex-shrink:0;
}
.instr-tag-del:hover{background:#ef4444;color:#fff}
.instr-no-courses{font-size:.73rem;color:rgba(255,255,255,.22);font-style:italic;padding:4px 0}

/* Assign select row */
.instr-assign-row{display:flex;gap:6px;align-items:center}
.instr-assign-row select{flex:1;font-size:.79rem;padding:7px 10px;height:34px}
.instr-assign-row .btn-adm{height:34px;padding:0 12px;font-size:.74rem;border-radius:var(--r-md)}

/* Card footer */
.instr-card-foot{
  display:flex;gap:6px;padding:11px 18px 14px;flex-wrap:wrap;
  border-top:1px solid rgba(255,255,255,.05);
}

/* ══════════════════════════════════════════
   APPLICATIONS PAGE — tabs
══════════════════════════════════════════ */
.instr-page-tabs{
  display:flex;gap:0;
  border-bottom:1.5px solid rgba(255,255,255,.07);
  margin-bottom:20px;
}
.instr-page-tab{
  padding:10px 18px;font-size:.82rem;font-weight:700;
  color:rgba(255,255,255,.35);background:none;border:none;
  border-bottom:2.5px solid transparent;cursor:pointer;
  transition:all .18s;white-space:nowrap;margin-bottom:-1.5px;
  font-family:'Plus Jakarta Sans',system-ui,sans-serif;display:flex;align-items:center;gap:7px;
}
.instr-page-tab:hover{color:rgba(255,255,255,.7)}
.instr-page-tab.active{color:var(--orange-l);border-bottom-color:var(--orange)}
.instr-tab-pane{display:none}
.instr-tab-pane.active{display:block}

/* ══════════════════════════════════════════
   PROMOTE MODAL USER LIST
══════════════════════════════════════════ */
.promote-search-wrap{
  display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
  border-radius:var(--r-md);padding:8px 12px;margin-bottom:10px;
}
.promote-search-wrap i{color:rgba(255,255,255,.3);font-size:.8rem}
.promote-search-wrap input{background:none;border:none;outline:none;color:rgba(255,255,255,.8);font-size:.84rem;font-family:'Plus Jakarta Sans',system-ui,sans-serif;flex:1}
.promote-user-list{max-height:280px;overflow-y:auto;display:flex;flex-direction:column;gap:5px;padding-right:2px}
.promote-user-list::-webkit-scrollbar{width:3px}
.promote-user-list::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:3px}
.promote-user-item{
  display:flex;align-items:center;gap:10px;padding:10px 12px;
  border-radius:var(--r-md);border:1.5px solid rgba(255,255,255,.07);
  background:rgba(255,255,255,.03);cursor:pointer;transition:var(--t);
}
.promote-user-item:hover,.promote-user-item.selected{border-color:var(--orange);background:var(--orange-pale)}
.promote-user-av{width:32px;height:32px;border-radius:50%;flex-shrink:0;background:var(--g-blue);display:flex;align-items:center;justify-content:center;font-size:.76rem;font-weight:800;color:#fff}
.promote-selected-box{
  background:rgba(240,112,32,.08);border:1px solid rgba(240,112,32,.22);
  border-radius:var(--r-md);padding:10px 13px;font-size:.82rem;color:var(--orange-l);
  display:flex;align-items:center;gap:8px;margin-top:10px;
}

/* ══════════════════════════════════════════
   TOAST
══════════════════════════════════════════ */
#adm-toast-container{position:fixed;bottom:22px;right:22px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none}
.adm-toast{background:var(--ink-2);border:1px solid rgba(255,255,255,.1);border-radius:var(--r-md);padding:11px 16px;color:rgba(255,255,255,.82);font-size:.8rem;font-weight:600;display:flex;align-items:center;gap:9px;animation:toast-in .28s var(--spring) both;min-width:220px;max-width:300px;pointer-events:auto}
.adm-toast.success{border-left:3px solid var(--emerald)}
.adm-toast.error{border-left:3px solid #ef4444}
.adm-toast.info{border-left:3px solid var(--blue-l)}

/* ══════════════════════════════════════════
   MISC RESPONSIVE
══════════════════════════════════════════ */
@media(max-width:599px){
  .adm-stats{grid-template-columns:repeat(2,1fr)}
  .adm-page{padding:12px}
}
</style>
</head>
<body>

<div id="scroll-progress" aria-hidden="true"></div>
<div id="adm-toast-container" aria-live="polite"></div>
<div class="adm-mob-overlay" id="admMobOverlay"></div>

<!-- ══════════════════════════════════════
     SIDEBAR
══════════════════════════════════════ -->
<aside class="adm-sidebar" id="admSidebar" aria-label="Admin navigation">
  <div class="adm-brand">
    <div class="adm-brand-mark">N</div>
    <div class="adm-brand-text">
      <strong>NeurowexTech</strong>
      <span>Admin Panel</span>
    </div>
  </div>
  <div class="adm-user-card">
    <div class="adm-user-av" id="sbUserAv">A</div>
    <div>
      <div class="adm-user-name" id="sbUserName">{{userName}}</div>
      <div class="adm-user-role">Administrator</div>
    </div>
  </div>

  <nav class="adm-nav">
    <!-- Overview -->
    <div class="adm-sec-label">Overview</div>
    <div class="adm-nav-item active" data-page="dashboard">
      <a class="adm-nav-link" data-label="Dashboard"><div class="adm-nav-icon"><i class="fas fa-chart-pie"></i></div><span class="adm-nav-label">Dashboard</span></a>
    </div>
    <div class="adm-nav-item" data-page="analytics">
      <a class="adm-nav-link" data-label="Analytics"><div class="adm-nav-icon"><i class="fas fa-chart-line"></i></div><span class="adm-nav-label">Analytics</span></a>
    </div>

    <!-- Users & CRM -->
    <div class="adm-sec-label">Users & CRM</div>
    <div class="adm-nav-item" data-page="users">
      <a class="adm-nav-link" data-label="Users"><div class="adm-nav-icon"><i class="fas fa-users"></i></div><span class="adm-nav-label">Users</span><span class="adm-nav-badge" id="sbUserCount">{{stats.total_users}}</span></a>
    </div>
    <div class="adm-nav-item" data-page="contacts">
      <a class="adm-nav-link" data-label="Messages"><div class="adm-nav-icon"><i class="fas fa-inbox"></i></div><span class="adm-nav-label">Messages</span><span class="adm-nav-badge" id="sbContactCount">{{stats.total_contacts}}</span></a>
