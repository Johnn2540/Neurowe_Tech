/* ═══════════════════════════════════════
   COURSES
═══════════════════════════════════════ */
let allCourses = [];
async function loadCourses() {
  const d = await api('/api/learn/courses');
  allCourses = d?.courses || [];
  const totalEnrolled = allCourses.reduce((acc, c) => acc + parseInt(c.enrolled_count || 0), 0);
  const freeCount     = allCourses.filter(c => parseFloat(c.price) === 0).length;
  setEl('sCourses',       allCourses.length);
  setEl('sTotalEnrolled', totalEnrolled);
  setEl('sFreeCourses',   freeCount);
  setEl('cfgCourseCount', allCourses.length);
  renderCourses(allCourses);
}
function renderCourses(arr) {
  const tb = document.getElementById('coursesBody');
  if (!tb) return;
  tb.innerHTML = arr.length
    ? arr.map(c => `<tr>
        <td class="td-name" style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(c.title)}</td>
        <td><span class="pill pill-t">${esc(c.category || 'General')}</span></td>
        <td><span class="pill pill-b">${esc(c.level || 'Beginner')}</span></td>
        <td>${parseFloat(c.price) === 0 ? '<span class="pill pill-g">Free</span>' : 'Kshs ' + esc(c.price)}</td>
        <td>${c.enrolled_count || 0}</td>
        <td><span class="pill ${c.published ? 'pill-g' : 'pill-dim'}">${c.published ? 'Live' : 'Draft'}</span></td>
        <td><button class="act-btn act-del" onclick="deleteCourse(${c.id})"><i class="fas fa-trash"></i></button></td>
      </tr>`).join('')
    : `<tr><td colspan="7"><div class="adm-empty"><i class="fas fa-graduation-cap"></i><h6>No courses yet</h6></div></td></tr>`;
}
function filterCourses(q) {
  renderCourses(allCourses.filter(c => c.title.toLowerCase().includes(q.toLowerCase())));
}
async function createCourse() {
  const title = document.getElementById('courseTitleInp').value.trim();
  if (!title) return toast('Course title required', 'error');
  const r = await api('/api/learn/courses', { method: 'POST', body: JSON.stringify({
    title,
    description:     document.getElementById('courseDesc').value,
    category:        document.getElementById('courseCat').value,
    level:           document.getElementById('courseLevel').value,
    total_duration:  document.getElementById('courseDuration').value,
    price:           parseInt(document.getElementById('coursePrice').value) || 0,
    instructor_name: document.getElementById('courseInstructor').value,
    image_url:       document.getElementById('courseImageUrl').value,
    published:       document.getElementById('coursePublished').checked,
    bestseller:      document.getElementById('courseBestseller').checked,
  })});
  if (r?.success) { toast('Course added!'); closeModal('modal-add-course'); loadCourses(); }
}
async function deleteCourse(id) {
  if (!confirm('Delete this course? All enrollments will also be removed.')) return;
  const r = await api(`/api/learn/courses/${id}`, { method: 'DELETE' });
  if (r?.success) { toast('Deleted'); loadCourses(); }
}

