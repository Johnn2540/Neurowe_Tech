<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel | NeurowexTech</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
/* ─────────────────────────────────────────────────────────────
   DESIGN TOKENS — identical to home.hbs
───────────────────────────────────────────────────────────── */
:root {
  --blue:       #1a56e8;
  --blue-d:     #1341c4;
  --blue-l:     #4f7df5;
  --blue-pale:  rgba(26,86,232,.09);
  --orange:     #f07020;
  --orange-d:   #d45c10;
  --orange-l:   #f5a060;
  --orange-pale:rgba(240,112,32,.09);
  --black:      #080c18;
  --ink:        #0f1628;
  --ink-2:      #18213a;
  --slate:      #5c6b8a;
  --mist:       #e4e9f4;
  --ghost:      #f6f8fd;
  --white:      #ffffff;
  --emerald:    #0dbf7e;
  --teal:       #00b09c;
  --g-blue:     linear-gradient(135deg,#1a56e8 0%,#1341c4 100%);
  --g-orange:   linear-gradient(135deg,#f07020 0%,#d45c10 100%);
  --g-hero:     linear-gradient(158deg,#040810 0%,#080f20 45%,#0c1830 100%);
  --g-dark:     linear-gradient(145deg,#080c18 0%,#0f1628 100%);
  --r-xl:       20px;
  --r-lg:       14px;
  --r-md:       10px;
  --r-pill:     999px;
  --ease:       cubic-bezier(.4,0,.2,1);
  --spring:     cubic-bezier(.34,1.56,.64,1);
  --t:          .28s var(--ease);
  --sh-blue:    0 8px 28px rgba(26,86,232,.26);
  --sh-orange:  0 8px 28px rgba(240,112,32,.26);
  --sh-card:    0 1px 8px rgba(8,12,24,.06),0 4px 20px rgba(8,12,24,.06);
  --sh-card-h:  0 12px 44px rgba(8,12,24,.13),0 4px 12px rgba(8,12,24,.07);
  --nav-h:      64px;
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:'DM Sans',sans-serif;background:#0a0f1e;color:rgba(255,255,255,.78);overflow-x:hidden;font-size:14px;line-height:1.6}
h1,h2,h3,h4,h5,h6{font-family:'Syne',sans-serif;line-height:1.12;letter-spacing:-.3px}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:var(--ink)}
::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}

/* scroll progress */
#scroll-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,var(--blue),var(--orange));z-index:9999;transition:width .1s linear}

/* ─────────────────────────────────────────────────────────────
   SIDEBAR
───────────────────────────────────────────────────────────── */
.adm-sidebar{
  position:fixed;left:0;top:0;height:100vh;width:262px;
  background:var(--ink);border-right:1px solid rgba(255,255,255,.06);
  display:flex;flex-direction:column;z-index:1050;
  transition:width .3s var(--ease),transform .32s var(--ease);overflow:hidden;
}
.adm-sidebar.col{width:64px;}
body.dark .adm-sidebar{background:#070d1a;}

/* brand row */
.adm-brand{
  display:flex;align-items:center;gap:10px;
  padding:0 16px;height:64px;flex-shrink:0;
  border-bottom:1px solid rgba(255,255,255,.06);overflow:hidden;
}
.adm-brand-mark{
  width:34px;height:34px;min-width:34px;border-radius:10px;
  background:var(--g-blue);display:flex;align-items:center;justify-content:center;
  font-family:'Syne',sans-serif;font-weight:800;font-size:.92rem;color:#fff;flex-shrink:0;
}
.adm-brand-text{overflow:hidden;white-space:nowrap;}
.adm-brand-text strong{display:block;font-family:'Syne',sans-serif;font-size:.9rem;font-weight:800;color:#fff;line-height:1.1;}
.adm-brand-text span{font-size:.56rem;color:var(--orange-l);font-weight:700;text-transform:uppercase;letter-spacing:1.5px;}
.adm-sidebar.col .adm-brand-text{opacity:0;width:0;}

/* user card */
.adm-user-card{
  display:flex;align-items:center;gap:10px;
  padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.06);
  flex-shrink:0;overflow:hidden;
}
.adm-user-av{
  width:34px;height:34px;min-width:34px;border-radius:50%;
  background:var(--g-blue);display:flex;align-items:center;justify-content:center;
  font-family:'Syne',sans-serif;font-weight:800;font-size:.82rem;color:#fff;flex-shrink:0;
}
.adm-user-name{font-size:.8rem;font-weight:700;color:#fff;white-space:nowrap;}
.adm-user-role{font-size:.6rem;color:var(--orange-l);font-weight:700;text-transform:uppercase;letter-spacing:1px;white-space:nowrap;}
.adm-sidebar.col .adm-user-card>div:last-child{display:none;}

/* nav */
.adm-nav{flex:1;overflow-y:auto;overflow-x:hidden;padding:8px 0;}
.adm-nav::-webkit-scrollbar{width:0;}
.adm-sec-label{
  padding:12px 18px 3px;font-size:.57rem;font-weight:800;
  text-transform:uppercase;letter-spacing:2px;color:rgba(255,255,255,.2);white-space:nowrap;
}
.adm-sidebar.col .adm-sec-label{opacity:0;}
.adm-nav-item{margin:1px 7px;}
.adm-nav-link{
  display:flex;align-items:center;gap:10px;
  padding:8px 10px;border-radius:var(--r-md);
  color:rgba(255,255,255,.45);text-decoration:none;
  transition:var(--t);cursor:pointer;
  border:1px solid transparent;white-space:nowrap;
  position:relative;-webkit-tap-highlight-color:transparent;
}
.adm-nav-link:hover{background:rgba(255,255,255,.05);color:rgba(255,255,255,.78);}
.adm-nav-item.active .adm-nav-link{
  background:rgba(26,86,232,.16);border-color:rgba(26,86,232,.22);color:var(--blue-l);
}
.adm-nav-item.active .adm-nav-link::before{
  content:'';position:absolute;left:0;top:25%;bottom:25%;
  width:3px;background:var(--blue);border-radius:0 3px 3px 0;
}
.adm-nav-icon{width:17px;min-width:17px;text-align:center;font-size:.85rem;flex-shrink:0;}
.adm-nav-label{font-size:.81rem;font-weight:600;transition:var(--t);}
.adm-sidebar.col .adm-nav-label{opacity:0;width:0;overflow:hidden;}
.adm-nav-badge{
  margin-left:auto;background:var(--orange);color:#fff;
  font-size:.58rem;font-weight:800;border-radius:99px;
  padding:1px 7px;min-width:18px;text-align:center;flex-shrink:0;
}
.adm-sidebar.col .adm-nav-badge{display:none;}

/* collapsed tooltip */
.adm-sidebar.col .adm-nav-link::after{
  content:attr(data-label);
  position:absolute;left:calc(64px - 3px);
  background:var(--ink-2);color:rgba(255,255,255,.85);
  font-size:.74rem;font-weight:600;
  padding:6px 12px;border-radius:var(--r-md);
  border:1px solid rgba(255,255,255,.1);
  white-space:nowrap;pointer-events:none;
  opacity:0;transform:translateX(-4px);
  transition:opacity .18s,transform .18s;z-index:200;
}
.adm-sidebar.col .adm-nav-link:hover::after{opacity:1;transform:translateX(0);}
.adm-nav-div{border:none;border-top:1px solid rgba(255,255,255,.05);margin:6px 10px;}

/* sidebar footer */
.adm-sidebar-foot{padding:8px 7px;border-top:1px solid rgba(255,255,255,.06);flex-shrink:0;}

/* ─────────────────────────────────────────────────────────────
   TOPBAR
───────────────────────────────────────────────────────────── */
.adm-topbar{
  position:fixed;top:0;left:262px;right:0;height:64px;
  background:var(--ink);border-bottom:1px solid rgba(255,255,255,.06);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 20px;z-index:1000;transition:left .3s var(--ease);
}
.adm-topbar.col{left:64px;}
body.dark .adm-topbar{background:#070d1a;}
.tb-l{display:flex;align-items:center;gap:11px;}
.tb-toggle{
  width:34px;height:34px;border-radius:var(--r-md);
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
  color:rgba(255,255,255,.5);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:var(--t);font-size:.85rem;
}
.tb-toggle:hover{background:var(--blue-pale);color:var(--blue-l);border-color:rgba(26,86,232,.3);}
.tb-page-title{font-family:'Syne',sans-serif;font-size:.94rem;font-weight:700;color:#fff;}
.tb-page-sub{font-size:.66rem;color:rgba(255,255,255,.3);margin-top:1px;}
.tb-r{display:flex;align-items:center;gap:7px;}
.tb-btn{
  width:34px;height:34px;border-radius:var(--r-md);
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
  color:rgba(255,255,255,.45);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:var(--t);text-decoration:none;font-size:.82rem;position:relative;
}
.tb-btn:hover{border-color:rgba(255,255,255,.16);color:rgba(255,255,255,.85);}
.tb-btn.wa:hover{background:rgba(37,211,102,.1);color:#25D366;border-color:rgba(37,211,102,.25);}
.tb-btn.refresh:hover{background:var(--blue-pale);color:var(--blue-l);}
.tb-btn.home-link{background:var(--g-blue);color:#fff;border:none;font-size:.78rem;width:auto;padding:0 12px;gap:6px;display:flex;}
.tb-btn.home-link:hover{box-shadow:var(--sh-blue);transform:translateY(-1px);}
.tb-user-chip{
  display:flex;align-items:center;gap:7px;
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
  border-radius:var(--r-pill);padding:4px 12px 4px 4px;cursor:pointer;transition:var(--t);
}
.tb-user-chip:hover{border-color:rgba(255,255,255,.15);}
.tb-chip-av{
  width:26px;height:26px;border-radius:50%;background:var(--g-blue);
  display:flex;align-items:center;justify-content:center;
  font-size:.65rem;font-weight:800;color:#fff;
}
.tb-chip-name{font-size:.76rem;font-weight:700;color:rgba(255,255,255,.82);font-family:'Syne',sans-serif;}

/* ─────────────────────────────────────────────────────────────
   MAIN AREA
───────────────────────────────────────────────────────────── */
.adm-main{margin-left:262px;padding-top:64px;min-height:100vh;transition:margin-left .3s var(--ease);}
.adm-main.col{margin-left:64px;}
.adm-page{padding:22px;display:none;animation:pg-in .26s var(--ease);}
.adm-page.active{display:block;}
@keyframes pg-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}

/* page header */
.pg-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px;gap:12px;flex-wrap:wrap;}
.pg-head h2{font-size:clamp(1.25rem,3vw,1.6rem);font-weight:800;color:#fff;line-height:1.1;}
.pg-head .sub{color:rgba(255,255,255,.32);font-size:.77rem;margin-top:3px;}

/* ── SECTION TAG — matches home.hbs ── */
.section-tag{
  display:inline-flex;align-items:center;gap:6px;
  background:var(--blue-pale);color:var(--blue);border-radius:var(--r-pill);
  padding:4px 14px;font-size:.64rem;font-weight:800;letter-spacing:2px;
  text-transform:uppercase;margin-bottom:10px;border:1px solid rgba(26,86,232,.14);
}
.section-tag::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue);}
.section-tag.orange{background:var(--orange-pale);color:var(--orange);border-color:rgba(240,112,32,.14);}
.section-tag.orange::before{background:var(--orange);}

/* gradient text */
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent;}
.g-orange{background:var(--g-orange);-webkit-background-clip:text;background-clip:text;color:transparent;}

/* ── STAT CARDS — orange accent top bar matches home stats ── */
.adm-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px;}
@media(max-width:1100px){.adm-stats{grid-template-columns:repeat(2,1fr);}}
@media(max-width:540px){.adm-stats{grid-template-columns:1fr;}}

.adm-stat{
  background:var(--ink-2);border:1px solid rgba(255,255,255,.06);
  border-radius:var(--r-xl);padding:18px 16px;
  position:relative;overflow:hidden;transition:var(--t);
}
/* colored top bar — same pattern as home.hbs stat-card bottom bar */
.adm-stat::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2.5px;
  border-radius:var(--r-xl) var(--r-xl) 0 0;
}
.adm-stat.c-b::before{background:linear-gradient(90deg,var(--blue),var(--blue-l));}
.adm-stat.c-o::before{background:var(--g-orange);}
.adm-stat.c-g::before{background:linear-gradient(90deg,var(--emerald),#34d399);}
.adm-stat.c-p::before{background:linear-gradient(90deg,#8b5cf6,#c084fc);}
.adm-stat.c-t::before{background:linear-gradient(90deg,var(--teal),#5eead4);}
.adm-stat.c-r::before{background:linear-gradient(90deg,#ef4444,#f87171);}
.adm-stat:hover{transform:translateY(-3px);box-shadow:0 14px 36px rgba(0,0,0,.32);}
.adm-stat-icon{
  width:38px;height:38px;border-radius:11px;
  display:flex;align-items:center;justify-content:center;font-size:1rem;margin-bottom:11px;
}
.c-b .adm-stat-icon{background:rgba(26,86,232,.15);color:var(--blue-l);}
.c-o .adm-stat-icon{background:var(--orange-pale);color:var(--orange-l);}
.c-g .adm-stat-icon{background:rgba(13,191,126,.12);color:var(--emerald);}
.c-p .adm-stat-icon{background:rgba(139,92,246,.12);color:#c084fc;}
.c-t .adm-stat-icon{background:rgba(0,176,156,.12);color:#5eead4;}
.c-r .adm-stat-icon{background:rgba(239,68,68,.1);color:#f87171;}
.adm-stat-val{font-family:'Syne',sans-serif;font-size:1.85rem;font-weight:800;color:#fff;line-height:1;margin-bottom:4px;}
.adm-stat-label{font-size:.69rem;color:rgba(255,255,255,.32);text-transform:uppercase;letter-spacing:.6px;font-weight:600;}
.adm-stat-trend{
  position:absolute;top:16px;right:14px;
  font-size:.63rem;font-weight:700;padding:2px 8px;border-radius:99px;
}
.trend-live{background:rgba(26,86,232,.2);color:var(--blue-l);}
.trend-up{background:rgba(13,191,126,.15);color:var(--emerald);}
.trend-new{background:var(--orange-pale);color:var(--orange-l);}

/* ── PANEL ── */
.panel{
  background:var(--ink-2);border:1px solid rgba(255,255,255,.06);
  border-radius:var(--r-xl);overflow:hidden;
}
.panel-head{
  padding:14px 18px;border-bottom:1px solid rgba(255,255,255,.06);
  display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;
}
.panel-title{
  font-family:'Syne',sans-serif;font-size:.87rem;font-weight:700;color:#fff;
  display:flex;align-items:center;gap:7px;
}
/* orange accent on panel title icon matches home orange accents */
.panel-title i{color:var(--orange-l);font-size:.82rem;}
.panel-body{padding:16px 18px;}

/* ── GRID ── */
.grid-2-1{display:grid;grid-template-columns:2fr 1fr;gap:16px;}
.grid-1-1{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
@media(max-width:1024px){.grid-2-1,.grid-1-1{grid-template-columns:1fr;}}
@media(max-width:900px){.grid-3{grid-template-columns:1fr 1fr;}}
@media(max-width:540px){.grid-3{grid-template-columns:1fr;}}

/* ── TABLE ── */
.adm-table{width:100%;border-collapse:collapse;}
.adm-table thead th{
  padding:9px 13px;font-size:.62rem;font-weight:800;
  text-transform:uppercase;letter-spacing:1.2px;
  color:rgba(255,255,255,.25);background:rgba(255,255,255,.02);
  border-bottom:1px solid rgba(255,255,255,.05);white-space:nowrap;
}
.adm-table tbody td{
  padding:11px 13px;font-size:.78rem;color:rgba(255,255,255,.52);
  border-bottom:1px solid rgba(255,255,255,.03);vertical-align:middle;
}
.adm-table tbody tr:last-child td{border-bottom:none;}
.adm-table tbody tr:hover td{background:rgba(255,255,255,.02);}
.td-name{color:rgba(255,255,255,.85)!important;font-weight:600;}

/* ── PILLS ── */
.pill{
  display:inline-flex;align-items:center;gap:4px;
  padding:2px 9px;border-radius:99px;
  font-size:.63rem;font-weight:800;white-space:nowrap;
  text-transform:uppercase;letter-spacing:.3px;
}
.pill-b{background:rgba(26,86,232,.18);color:var(--blue-l);}
.pill-o{background:var(--orange-pale);color:var(--orange-l);}
.pill-g{background:rgba(13,191,126,.12);color:var(--emerald);}
.pill-p{background:rgba(139,92,246,.12);color:#c084fc;}
.pill-r{background:rgba(239,68,68,.1);color:#f87171;}
.pill-t{background:rgba(0,176,156,.12);color:#5eead4;}
.pill-dim{background:rgba(255,255,255,.07);color:rgba(255,255,255,.35);}

/* ── ACTION BUTTONS ── */
.act-btn{
  width:27px;height:27px;border-radius:8px;border:none;
  display:inline-flex;align-items:center;justify-content:center;
  cursor:pointer;font-size:.7rem;transition:var(--t);margin:0 2px;
}
.act-edit{background:rgba(26,86,232,.14);color:var(--blue-l);}
.act-edit:hover{background:var(--blue);color:#fff;}
.act-del{background:rgba(239,68,68,.1);color:#f87171;}
.act-del:hover{background:#ef4444;color:#fff;}
.act-view{background:rgba(13,191,126,.1);color:var(--emerald);}
.act-view:hover{background:var(--emerald);color:#fff;}
.act-role{background:rgba(139,92,246,.12);color:#c084fc;}
.act-role:hover{background:#8b5cf6;color:#fff;}

/* ── ADMIN BUTTONS — mirror home.hbs btn-primary/btn-orange ── */
.btn-adm{
  display:inline-flex;align-items:center;gap:7px;
  background:var(--g-blue);color:#fff;border:none;
  padding:8px 17px;border-radius:var(--r-pill);
  font-family:'Syne',sans-serif;font-weight:700;font-size:.78rem;
  cursor:pointer;transition:var(--t);white-space:nowrap;text-decoration:none;
  letter-spacing:.02em;
}
.btn-adm:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(26,86,232,.35);color:#fff;}
.btn-adm.o{background:var(--g-orange);}
.btn-adm.o:hover{box-shadow:0 8px 24px rgba(240,112,32,.35);}
.btn-adm.ghost{background:rgba(255,255,255,.05);color:rgba(255,255,255,.58);border:1px solid rgba(255,255,255,.1);}
.btn-adm.ghost:hover{border-color:rgba(255,255,255,.22);color:rgba(255,255,255,.88);box-shadow:none;transform:none;}
.btn-adm.danger{background:rgba(239,68,68,.14);color:#f87171;border:1px solid rgba(239,68,68,.18);}
.btn-adm.danger:hover{background:#ef4444;color:#fff;box-shadow:0 6px 18px rgba(239,68,68,.28);}

/* ── SEARCH ── */
.adm-search{
  display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
  border-radius:var(--r-pill);padding:6px 13px;
}
.adm-search i{color:rgba(255,255,255,.28);font-size:.78rem;}
.adm-search input{
  background:none;border:none;outline:none;
  color:rgba(255,255,255,.78);font-size:.8rem;
  font-family:'DM Sans',sans-serif;width:160px;
}
.adm-search input::placeholder{color:rgba(255,255,255,.25);}

/* ── FORM CONTROLS ── */
.adm-label{font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.7px;color:rgba(255,255,255,.35);display:block;margin-bottom:5px;}
.adm-input{
  width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);
  border-radius:var(--r-md);color:rgba(255,255,255,.82);
  padding:10px 12px;font-size:.82rem;font-family:'DM Sans',sans-serif;
  transition:var(--t);outline:none;
}
.adm-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,86,232,.14);background:rgba(255,255,255,.07);}
.adm-input::placeholder{color:rgba(255,255,255,.2);}
.adm-input option{background:var(--ink-2);}
select.adm-input{cursor:pointer;}
textarea.adm-input{resize:vertical;}

/* ── TOGGLE ── */
.adm-toggle{position:relative;display:inline-block;width:38px;height:21px;flex-shrink:0;}
.adm-toggle input{display:none;}
.adm-track{position:absolute;inset:0;border-radius:99px;background:rgba(255,255,255,.12);cursor:pointer;transition:var(--t);}
.adm-track::after{content:'';position:absolute;top:3px;left:3px;width:15px;height:15px;border-radius:50%;background:rgba(255,255,255,.55);transition:var(--t);}
.adm-toggle input:checked+.adm-track{background:var(--blue);}
.adm-toggle input:checked+.adm-track::after{transform:translateX(17px);background:#fff;}

/* ── MODAL ── */
.adm-modal-backdrop{
  position:fixed;inset:0;background:rgba(8,12,24,.68);
  backdrop-filter:blur(8px);z-index:2000;
  display:none;align-items:center;justify-content:center;padding:16px;
}
.adm-modal-backdrop.open{display:flex;}
.adm-modal{
  background:var(--ink-2);border:1px solid rgba(255,255,255,.1);
  border-radius:var(--r-xl);width:100%;max-width:480px;
  box-shadow:0 28px 72px rgba(0,0,0,.55);
  animation:adm-modal-in .26s var(--spring) both;overflow:hidden;
}
.adm-modal.wide{max-width:660px;}
@keyframes adm-modal-in{from{transform:scale(.94) translateY(8px);opacity:0}to{transform:none;opacity:1}}
.adm-modal-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 20px;border-bottom:1px solid rgba(255,255,255,.07);
  /* orange accent top bar on modal — matches home cards */
  position:relative;
}
.adm-modal-head::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--blue),var(--orange));
}
.adm-modal-head h5{font-family:'Syne',sans-serif;font-size:.92rem;font-weight:800;color:#fff;margin:0;display:flex;align-items:center;gap:8px;}
.adm-modal-close{
  width:30px;height:30px;border:none;background:rgba(255,255,255,.07);
  border-radius:var(--r-md);cursor:pointer;color:rgba(255,255,255,.55);
  display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.78rem;
}
.adm-modal-close:hover{background:#ef4444;color:#fff;}
.adm-modal-body{padding:20px;display:flex;flex-direction:column;gap:13px;}
.adm-modal-foot{padding:13px 20px;border-top:1px solid rgba(255,255,255,.07);display:flex;justify-content:flex-end;gap:8px;}

/* ── MOBILE overlay ── */
.adm-mob-overlay{
  position:fixed;inset:0;background:rgba(8,12,24,.6);
  backdrop-filter:blur(5px);z-index:1049;
  opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s;
}
.adm-mob-overlay.open{opacity:1;visibility:visible;}
@media(max-width:991px){
  .adm-sidebar{transform:translateX(-100%);width:262px!important;}
  .adm-sidebar.mob-open{transform:translateX(0);}
  .adm-topbar,.adm-main{left:0!important;margin-left:0!important;}
  .adm-page{padding:14px;}
  .pg-head h2{font-size:1.2rem;}
  .adm-stats{grid-template-columns:1fr 1fr;}
}

/* ── WA BANNER — matches site's teal learn section ── */
.wa-banner{
  background:linear-gradient(135deg,rgba(37,211,102,.06),rgba(18,140,126,.05));
  border:1px solid rgba(37,211,102,.15);
  border-radius:var(--r-xl);padding:12px 16px;
  display:flex;align-items:center;justify-content:space-between;
  gap:10px;margin-bottom:20px;flex-wrap:wrap;
}
.wa-banner-l{display:flex;align-items:center;gap:9px;font-size:.8rem;color:#6ee7b7;font-weight:600;}
.wa-pulse{width:8px;height:8px;border-radius:50%;background:#25D366;flex-shrink:0;animation:pulse-dot 2s infinite;}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}

/* ── QUICK ACTIONS ── */
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;}
.quick-btn{
  display:flex;align-items:center;gap:9px;
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);
  border-radius:var(--r-md);padding:10px;cursor:pointer;transition:var(--t);text-align:left;
}
.quick-btn:hover{border-color:rgba(26,86,232,.35);background:rgba(26,86,232,.07);transform:translateY(-2px);}
.quick-btn-icon{
  width:28px;height:28px;border-radius:8px;
  background:rgba(26,86,232,.14);color:var(--blue-l);
  display:flex;align-items:center;justify-content:center;font-size:.78rem;flex-shrink:0;
}
.quick-btn span{font-size:.74rem;font-weight:700;color:rgba(255,255,255,.65);}

/* ── ACTIVITY FEED ── */
.act-feed-item{
  display:flex;align-items:flex-start;gap:10px;
  padding:10px 0;border-bottom:1px solid rgba(255,255,255,.04);
}
.act-feed-item:last-child{border-bottom:none;}
.act-dot-icon{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.74rem;flex-shrink:0;}
.act-dot-icon.msg{background:rgba(26,86,232,.14);color:var(--blue-l);}
.act-dot-icon.user{background:rgba(13,191,126,.12);color:var(--emerald);}
.act-dot-icon.sub{background:rgba(139,92,246,.12);color:#c084fc;}
.act-dot-icon.proj{background:var(--orange-pale);color:var(--orange-l);}
.act-feed-item p{font-size:.76rem;color:rgba(255,255,255,.62);margin:0;}
.act-feed-item time{font-size:.66rem;color:rgba(255,255,255,.26);}

/* ── TOAST ── */
#adm-toast-container{
  position:fixed;bottom:20px;right:20px;z-index:9999;
  display:flex;flex-direction:column;gap:7px;pointer-events:none;
}
.adm-toast{
  background:var(--ink-2);border:1px solid rgba(255,255,255,.1);
  border-radius:var(--r-md);padding:10px 15px;
  color:rgba(255,255,255,.82);font-size:.78rem;font-weight:600;
  display:flex;align-items:center;gap:8px;
  animation:toast-in .26s var(--spring) both;
  min-width:210px;max-width:290px;pointer-events:auto;
}
.adm-toast.success{border-left:3px solid var(--emerald);}
.adm-toast.error{border-left:3px solid #ef4444;}
.adm-toast.info{border-left:3px solid var(--blue-l);}
@keyframes toast-in{from{transform:translateX(14px);opacity:0}to{transform:none;opacity:1}}

/* ── SETTINGS ── */
.setting-row{
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.05);flex-wrap:wrap;
}
.setting-row:last-child{border-bottom:none;}
.setting-info p{font-size:.81rem;font-weight:600;color:rgba(255,255,255,.75);margin:0;}
.setting-info span{font-size:.7rem;color:rgba(255,255,255,.28);}
.setting-section-title{
  font-size:.65rem;font-weight:800;text-transform:uppercase;
  letter-spacing:1.5px;color:rgba(255,255,255,.25);
  margin-bottom:11px;padding-bottom:7px;
  border-bottom:1px solid rgba(255,255,255,.06);
}

/* ── EMPTY STATE ── */
.adm-empty{padding:32px;text-align:center;}
.adm-empty i{font-size:2.2rem;color:rgba(255,255,255,.12);margin-bottom:9px;display:block;}
.adm-empty h6{font-size:.87rem;font-weight:700;color:rgba(255,255,255,.38);margin-bottom:4px;}
.adm-empty p{font-size:.75rem;color:rgba(255,255,255,.22);}

/* ── COUNTRY BAR ── */
.country-bar{height:5px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden;}
.country-fill{height:100%;background:var(--g-blue);border-radius:99px;}

/* ─── FOOTER ─── (imported from home.hbs, dark version) */
footer{background:#070c1a;color:rgba(255,255,255,.52);padding:0;font-size:.82rem;border-top:1px solid rgba(255,255,255,.06);}
.footer-accent-bar{height:3px;background:linear-gradient(90deg,#1a56e8,#f07020,#1a56e8);background-size:200% 100%;animation:bar-shift 6s linear infinite;}
@keyframes bar-shift{0%{background-position:0% 0%}100%{background-position:200% 0%}}
.footer-cta-strip{background:linear-gradient(135deg,#0d1936 0%,#101f3a 100%);border-bottom:1px solid rgba(255,255,255,.06);padding:28px 0;}
.footer-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;}
.footer-cta-text h4{font-family:'Syne',sans-serif;font-size:clamp(.95rem,2.5vw,1.3rem);font-weight:800;color:#fff;margin-bottom:2px;line-height:1.2;}
.footer-cta-text p{font-size:.76rem;color:rgba(255,255,255,.4);margin:0;}
.footer-cta-actions{display:flex;gap:9px;flex-wrap:wrap;flex-shrink:0;}
.footer-body{padding:44px 0 32px;}
.footer-cols{display:grid;grid-template-columns:2fr 1fr 1fr 1.6fr;gap:32px 26px;}
.footer-brand-name{font-family:'Syne',sans-serif;font-size:1.1rem;font-weight:800;color:#fff;letter-spacing:-.4px;display:flex;align-items:center;gap:6px;margin-bottom:9px;}
.footer-brand-name em{font-style:normal;color:#f07020;}
.footer-brand-dot{width:8px;height:8px;background:#1a56e8;border-radius:50%;box-shadow:0 0 8px rgba(26,86,232,.6);flex-shrink:0;}
.footer-tagline{font-size:.77rem;color:rgba(255,255,255,.38);line-height:1.72;max-width:270px;margin-bottom:16px;}
.footer-socials{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px;}
.fsoc{width:32px;height:32px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.07);color:rgba(255,255,255,.52);font-size:.8rem;transition:all .22s;text-decoration:none;}
.fsoc:hover{transform:translateY(-3px);}
.fsoc.tw:hover{background:#1da1f2;color:#fff;}
.fsoc.li:hover{background:#0077b5;color:#fff;}
.fsoc.gh:hover{background:#fff;color:#111;}
.fsoc.ig:hover{background:linear-gradient(135deg,#fd5949,#d6249f,#285aeb);color:#fff;}
.fsoc.yt:hover{background:#ff0000;color:#fff;}
.fsoc.wa:hover{background:#25D366;color:#fff;}
.footer-col-title{font-family:'Syne',sans-serif;font-size:.66rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:14px;display:flex;align-items:center;gap:7px;}
.footer-col-title::before{content:'';display:inline-block;width:12px;height:2px;background:#1a56e8;border-radius:2px;flex-shrink:0;}
.footer-links{list-style:none;padding:0;margin:0;}
.footer-links li{margin-bottom:8px;}
.footer-links a{color:rgba(255,255,255,.44);text-decoration:none;font-size:.77rem;transition:color .2s,padding-left .2s;display:inline-flex;align-items:center;gap:5px;}
.footer-links a:hover{color:#fff;padding-left:3px;}
.footer-links a i{width:13px;font-size:.68rem;flex-shrink:0;opacity:.52;}
.footer-contact-item{display:flex;align-items:flex-start;gap:9px;margin-bottom:12px;}
.fci-icon{width:28px;height:28px;flex-shrink:0;background:rgba(26,86,232,.12);border-radius:7px;display:flex;align-items:center;justify-content:center;color:#1a56e8;font-size:.72rem;margin-top:1px;}
.fci-text{display:flex;flex-direction:column;gap:1px;}
.fci-label{font-size:.6rem;color:rgba(255,255,255,.26);font-weight:700;letter-spacing:.6px;text-transform:uppercase;}
.fci-val{font-size:.77rem;color:rgba(255,255,255,.64);}
.fci-val a{color:rgba(255,255,255,.64);text-decoration:none;transition:color .2s;}
.fci-val a:hover{color:#f07020;}
.footer-hours{display:inline-flex;align-items:center;gap:5px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:7px;padding:6px 10px;font-size:.7rem;color:rgba(255,255,255,.4);margin-top:3px;}
.hours-dot{width:6px;height:6px;background:#0dbf7e;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite;flex-shrink:0;}
@keyframes dot-pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.45);opacity:.6}}
.footer-divider{border:none;border-top:1px solid rgba(255,255,255,.07);margin:0;}
.footer-bottom-bar{padding:16px 0;}
.footer-bottom-inner{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.footer-copy{font-size:.72rem;color:rgba(255,255,255,.24);}
.footer-legal{display:flex;gap:18px;flex-wrap:wrap;}
.footer-legal a{font-size:.7rem;color:rgba(255,255,255,.26);text-decoration:none;transition:color .2s;}
.footer-legal a:hover{color:rgba(255,255,255,.62);}
.footer-made-in{font-size:.7rem;color:rgba(255,255,255,.18);display:flex;align-items:center;gap:4px;}
.footer-made-in span{color:#f07020;}
@media(max-width:1023px){.footer-cols{grid-template-columns:1fr 1fr;gap:24px 20px;}.footer-col-brand{grid-column:1/-1;}}
@media(max-width:539px){
  .footer-cols{grid-template-columns:1fr 1fr;gap:18px 12px;}
  .footer-col-brand,.footer-col-contact{grid-column:1/-1;}
  .footer-cta-inner{flex-direction:column;align-items:flex-start;}
  .footer-cta-actions{width:100%;}
  .footer-cta-actions a{flex:1;justify-content:center;}
  .footer-bottom-inner{flex-direction:column;align-items:center;text-align:center;gap:8px;}
  .footer-legal{justify-content:center;gap:10px;}
}

/* ── WA FLOAT ── */
#wa-tooltip{position:fixed;bottom:160px;right:22px;z-index:10002;background:#fff;color:#111;border-radius:14px 14px 4px 14px;padding:11px 32px 11px 13px;box-shadow:0 8px 32px rgba(0,0,0,.18);font-size:.78rem;font-weight:600;font-family:'DM Sans',sans-serif;max-width:215px;line-height:1.45;opacity:0;pointer-events:none;transform:translateY(8px) scale(.94);transition:opacity .28s,transform .3s cubic-bezier(.34,1.56,.64,1);border:1px solid rgba(37,211,102,.2);}
#wa-tooltip.show{opacity:1;pointer-events:auto;transform:translateY(0) scale(1);}
#wa-tooltip strong{color:#128C7E;display:block;margin-bottom:2px;font-size:.8rem;}
#wa-tooltip .tt-close{position:absolute;top:7px;right:9px;font-size:.65rem;color:#999;cursor:pointer;background:none;border:none;line-height:1;padding:2px;transition:color .2s;}
#wa-tooltip .tt-close:hover{color:#ef4444;}
#wa-tooltip::after{content:'';position:absolute;bottom:-8px;right:18px;width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:8px solid #fff;filter:drop-shadow(0 2px 4px rgba(0,0,0,.08));}
#wa-float{position:fixed;bottom:88px;right:20px;z-index:10001;cursor:pointer;text-decoration:none;display:block;}
.wa-ring-1,.wa-ring-2{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-ripple 2.8s ease-out infinite;pointer-events:none;}
.wa-ring-2{animation-delay:1.15s;}
@keyframes wa-ripple{0%{transform:scale(1);opacity:.65}100%{transform:scale(1.9);opacity:0}}
.wa-pill{display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#128C7E 0%,#075E54 100%);border-radius:999px;padding:9px 18px 9px 9px;box-shadow:0 6px 28px rgba(18,140,126,.42),0 2px 8px rgba(0,0,0,.12);transition:transform .32s cubic-bezier(.34,1.56,.64,1),box-shadow .3s;position:relative;overflow:visible;white-space:nowrap;}
#wa-float:hover .wa-pill{transform:translateY(-4px) scale(1.03);box-shadow:0 16px 40px rgba(18,140,126,.55),0 4px 12px rgba(0,0,0,.14);}
.wa-icon-circle{width:38px;height:38px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff;position:relative;transition:transform .3s;}
#wa-float:hover .wa-icon-circle{transform:rotate(-10deg) scale(1.08);}
.wa-status-dot{position:absolute;top:1px;right:1px;width:10px;height:10px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dot-pulse 2.4s ease-in-out infinite;}
.wa-text-wrap{display:flex;flex-direction:column;gap:1px;}
.wa-label{font-size:.67rem;color:rgba(255,255,255,.65);letter-spacing:.3px;font-weight:600;}
.wa-cta{font-size:.9rem;color:#fff;font-weight:800;font-family:'Syne',sans-serif;letter-spacing:-.2px;}
.wa-arrow-icon{color:rgba(255,255,255,.7);font-size:.72rem;margin-left:2px;transition:transform .24s;}
#wa-float:hover .wa-arrow-icon{transform:translateX(3px);}
.wa-badge{position:absolute;top:-5px;right:-5px;width:19px;height:19px;background:#ef4444;border:2px solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.6rem;color:#fff;font-weight:800;}
@media(max-width:767px){
  #wa-float{bottom:78px;right:16px;}
  .wa-text-wrap,.wa-arrow-icon{display:none;}
  .wa-pill{padding:0;width:56px;height:56px;border-radius:50%;justify-content:center;}
  .wa-icon-circle{width:56px;height:56px;font-size:1.5rem;}
  #wa-tooltip{bottom:144px;right:12px;max-width:185px;}
  .wa-ring-1,.wa-ring-2{border-radius:50%;}
}

/* ── THEME TOGGLE ── */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:44px;height:44px;background:var(--ink-2);border:1.5px solid rgba(255,255,255,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 18px rgba(0,0,0,.2);transition:var(--t);}
#theme-toggle svg{width:17px;height:17px;stroke:rgba(255,255,255,.6);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(22deg) scale(1.07);}
#theme-toggle:hover svg{stroke:#fff;}

/* dark mode tweaks */
body.dark{background:#030609;}
body.dark .adm-sidebar,body.dark .adm-topbar{background:#070d1a;}
body.dark .panel,body.dark .adm-stat{background:#0c1220;}

.container{max-width:1300px;margin:0 auto;padding:0 28px;}
@media(max-width:768px){.container{padding:0 16px;}}
</style>
</head>
