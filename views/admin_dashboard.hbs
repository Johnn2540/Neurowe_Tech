   ENROLLMENTS
═══════════════════════════════════════ */
async function loadEnrollments() {
  const d = await api('/api/learn/enrollments');
  const arr = d?.enrollments || [];
  setEl('enrollCountBadge', arr.length + ' enrollments');
  const tb = document.getElementById('enrollmentsBody');
  if (!tb) return;
  tb.innerHTML = arr.length
    ? arr.map(e => `<tr>
        <td class="td-name">${esc(e.username || '—')}</td>
        <td><a href="mailto:${esc(e.email)}" style="color:var(--blue-l)">${esc(e.email || '—')}</a></td>
        <td style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(e.course_title || '—')}</td>
        <td>${fmt(e.enrolled_at)}</td>
        <td>
          <div style="display:flex;align-items:center;gap:7px;">
            <div style="flex:1;height:5px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden;min-width:55px">
              <div style="width:${e.progress || 0}%;height:100%;background:var(--g-blue);border-radius:99px"></div>
            </div>
            <span style="font-size:.7rem;color:rgba(255,255,255,.35);width:30px">${e.progress || 0}%</span>
          </div>
        </td>
        <td><span class="pill ${e.status === 'completed' ? 'pill-g' : e.status === 'active' ? 'pill-b' : 'pill-dim'}">${esc(e.status || 'active')}</span></td>
        <td><button class="act-btn act-del" onclick="deleteEnrollment(${e.id})"><i class="fas fa-trash"></i></button></td>
      </tr>`).join('')
    : `<tr><td colspan="7"><div class="adm-empty"><i class="fas fa-user-graduate"></i><h6>No enrollments yet</h6></div></td></tr>`;
}
async function deleteEnrollment(id) {
  if (!confirm('Remove this enrollment?')) return;
  const r = await api(`/api/learn/enrollments/${id}`, { method: 'DELETE' });
  if (r?.success) { toast('Enrollment removed'); loadEnrollments(); }
}

/* ═══════════════════════════════════════
   SETTINGS — fetch current values from DB
═══════════════════════════════════════ */
async function loadSettings() {
  const d = await api('/api/settings');
  const s = d?.settings || {};
  const set = (id, val) => { const el = document.getElementById(id); if (el && val !== undefined && val !== null) el.value = val; };
  set('cfgSiteName', s.site_name);
  set('cfgEmail',    s.contact_email);
  set('cfgWA',       s.whatsapp_number);
  set('cfgLocation', s.location);
  set('cfgTagline',  s.tagline);
  if (s.maintenance_mode !== undefined) {
    const el = document.getElementById('cfgMaintenance');
    if (el) el.checked = !!s.maintenance_mode;
  }
}
async function saveSettings() {
  const r = await api('/api/settings', { method: 'PUT', body: JSON.stringify({
    site_name:       document.getElementById('cfgSiteName').value,
    contact_email:   document.getElementById('cfgEmail').value,
    whatsapp_number: document.getElementById('cfgWA').value,
    location:        document.getElementById('cfgLocation').value,
    tagline:         document.getElementById('cfgTagline').value,
  })});
  if (r?.success) toast('Settings saved!');
}

/* ─────────────────── WA FLOAT ─────────────────── */
(function () {
  const tooltip = document.getElementById('wa-tooltip');
  const ttClose = document.getElementById('waTooltipClose');
  const wa      = document.getElementById('wa-float');
  if (tooltip && !sessionStorage.getItem('nw-wa-tt')) {
    setTimeout(() => tooltip.classList.add('show'), 6000);
  }
  if (ttClose && tooltip) {
    ttClose.addEventListener('click', e => {
      e.preventDefault(); e.stopPropagation();
      tooltip.classList.remove('show');
      sessionStorage.setItem('nw-wa-tt', '1');
    });
  }
  if (wa && tooltip) wa.addEventListener('click', () => sessionStorage.setItem('nw-wa-tt', '1'));
})();

/* ─────────────────── REFRESH BUTTON ─────────────────── */
document.getElementById('refreshBtn').addEventListener('click', async () => {
  const btn = document.getElementById('refreshBtn');
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
  btn.disabled  = true;
  await loadDashboard();
  btn.innerHTML = '<i class="fas fa-arrows-rotate"></i>';
  btn.disabled  = false;
  toast('Data refreshed', 'info');
});

/* ─────────────────── INIT ─────────────────── */
window.addEventListener('DOMContentLoaded', () => {
  initCharts();
  loadDashboard();
  loadSettings(); // pre-fill settings form
  // Auto-refresh dashboard every 30s
  setInterval(loadDashboard, 30000);
});
</script>
