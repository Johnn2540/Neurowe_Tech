    <div class="adm-nav-item" data-page="testimonials">
      <a class="adm-nav-link" data-label="Testimonials">
        <div class="adm-nav-icon"><i class="fas fa-star"></i></div>
        <span class="adm-nav-label">Testimonials</span>
      </a>
    </div>
    <div class="adm-nav-item" data-page="team">
      <a class="adm-nav-link" data-label="Team">
        <div class="adm-nav-icon"><i class="fas fa-id-badge"></i></div>
        <span class="adm-nav-label">Team</span>
      </a>
    </div>
    <div class="adm-nav-item" data-page="faqs">
      <a class="adm-nav-link" data-label="FAQs">
        <div class="adm-nav-icon"><i class="fas fa-question-circle"></i></div>
        <span class="adm-nav-label">FAQs</span>
      </a>
    </div>
    <div class="adm-nav-item" data-page="pricing">
      <a class="adm-nav-link" data-label="Pricing">
        <div class="adm-nav-icon"><i class="fas fa-tags"></i></div>
        <span class="adm-nav-label">Pricing</span>
