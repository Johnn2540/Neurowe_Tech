async function loadEnrollments() {
  const d=await api('/api/learn/enrollments'); const arr=d?.enrollments||[];
  const tb=document.getElementById('enrollmentsBody');
  if(!tb) return;
  tb.innerHTML=arr.length?arr.map(e=>`<tr>
    <td class="td-name">${esc(e.username||e.student_name||'—')}</td>
    <td><a href="mailto:${esc(e.email)}" style="color:var(--blue-l)">${esc(e.email||'—')}</a></td>
    <td>${esc(e.course_title||'—')}</td>
    <td>${fmt(e.enrolled_at||e.created_at)}</td>
    <td>
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="flex:1;height:5px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden;min-width:60px">
          <div style="width:${e.progress||0}%;height:100%;background:var(--g-blue);border-radius:99px"></div>
        </div>
        <span style="font-size:.72rem;color:rgba(255,255,255,.4)">${e.progress||0}%</span>
      </div>
    </td>
