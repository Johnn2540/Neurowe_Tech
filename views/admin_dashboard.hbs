     SCRIPTS
════════════════════════════════════ -->
<script>
/* ─────────────────── THEME ─────────────────── */
const themeBtn = document.getElementById('themeToggleAdm');
let dark = localStorage.getItem('nw-theme') !== 'light';
const MOON = '<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
const SUN  = '<svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme() { document.body.classList.toggle('dark', dark); themeBtn.innerHTML = dark ? SUN : MOON; }
applyTheme();
themeBtn.addEventListener('click', () => { dark = !dark; localStorage.setItem('nw-theme', dark ? 'dark' : 'light'); applyTheme(); });

/* footer year */
document.getElementById('footerYear').textContent = new Date().getFullYear();

/* scroll progress */
window.addEventListener('scroll', () => {
  const el = document.getElementById('scroll-progress');
  const p = (window.pageYOffset / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
  if (el) el.style.width = p + '%';
}, { passive: true });

/* ─────────────────── TOAST ─────────────────── */
function toast(msg, type = 'success') {
  const icons = { success: 'fas fa-check-circle', error: 'fas fa-exclamation-circle', info: 'fas fa-info-circle' };
  const cols  = { success: 'var(--emerald)', error: '#f87171', info: 'var(--blue-l)' };
  const el = document.createElement('div');
  el.className = 'adm-toast ' + type;
  el.innerHTML = `<i class="${icons[type]}" style="color:${cols[type]};flex-shrink:0"></i>${msg}`;
  document.getElementById('adm-toast-container').appendChild(el);
  setTimeout(() => el.remove(), 3800);
}

/* ─────────────────── API FETCH ─────────────────── */
async function api(url, opts = {}) {
  try {
    const r = await fetch(url, { headers: { 'Content-Type': 'application/json' }, ...opts });
    const d = await r.json();
    if (!r.ok) throw new Error(d.message || `Error ${r.status}`);
    return d;
  } catch (e) {
    console.error('API error:', url, e.message);
    toast(e.message, 'error');
    return null;
  }
}

/* ─────────────────── HELPERS ─────────────────── */
function fmt(d) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
function esc(s) {
  if (s === null || s === undefined) return '';
  return String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function setEl(id, v) { const el = document.getElementById(id); if (el) el.textContent = v; }

/* ─────────────────── MODAL ─────────────────── */
function openModal(id)  { const m = document.getElementById(id); if (m) { m.classList.add('open'); document.body.style.overflow = 'hidden'; } }
function closeModal(id) { const m = document.getElementById(id); if (m) { m.classList.remove('open'); document.body.style.overflow = ''; } }
document.querySelectorAll('.adm-modal-backdrop').forEach(b => {
  b.addEventListener('click', e => { if (e.target === b) closeModal(b.id); });
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') document.querySelectorAll('.adm-modal-backdrop.open').forEach(b => closeModal(b.id));
});

/* ─────────────────── SIDEBAR ─────────────────── */
const sidebar  = document.getElementById('admSidebar');
const mainEl   = document.getElementById('admMain');
const topbarEl = document.getElementById('admTopbar');
const mobOv    = document.getElementById('admMobOverlay');
const tbToggle = document.getElementById('tbToggle');
const tbLogout = document.getElementById('tbLogoutBtn');

function isMob() { return window.innerWidth < 992; }

// Show/hide topbar logout button on mobile
function updateMobileLogout() {
  if (tbLogout) tbLogout.style.display = isMob() ? 'flex' : 'none';
}
updateMobileLogout();
window.addEventListener('resize', updateMobileLogout);

tbToggle.addEventListener('click', () => {
  if (isMob()) {
    sidebar.classList.toggle('mob-open');
    mobOv.classList.toggle('open');
    document.body.style.overflow = sidebar.classList.contains('mob-open') ? 'hidden' : '';
  } else {
    sidebar.classList.toggle('col');
    mainEl.classList.toggle('col');
    topbarEl.classList.toggle('col');
  }
});
mobOv.addEventListener('click', () => {
  sidebar.classList.remove('mob-open');
  mobOv.classList.remove('open');
  document.body.style.overflow = '';
});

/* ─────────────────── PAGE NAVIGATION ─────────────────── */
const PAGE_META = {
  dashboard:    ['Dashboard',    'Live platform overview'],
  analytics:    ['Analytics',    'Traffic & growth insights'],
  users:        ['Users',        'Manage accounts and roles'],
  contacts:     ['Messages',     'Leads and enquiries'],
  subscribers:  ['Subscribers',  'Newsletter list'],
  projects:     ['Portfolio',    'Showcase projects'],
  services:     ['Services',     'Manage offerings'],
  blog:         ['Blog',         'Content management'],
  testimonials: ['Testimonials', 'Client reviews'],
  team:         ['Team',         'Manage team profiles'],
  faqs:         ['FAQs',         'Frequently asked questions'],
  pricing:      ['Pricing',      'Pricing plans'],
  courses:      ['Courses',      'Academy course catalogue'],
  enrollments:  ['Enrollments',  'Course enrollments'],
  settings:     ['Settings',     'Platform configuration'],
};
const LOADERS = {
  users: loadUsers, contacts: loadContacts, subscribers: loadSubscribers,
  projects: loadProjects, services: loadServices, blog: loadBlog,
  testimonials: loadTestimonials, team: loadTeam,
  faqs: loadFAQs, pricing: loadPricing,
  courses: loadCourses, enrollments: loadEnrollments,
};

function switchPage(page) {
  document.querySelectorAll('.adm-page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.adm-nav-item[data-page]').forEach(n => n.classList.remove('active'));
  const pg  = document.getElementById('page-' + page);
  const nav = document.querySelector(`.adm-nav-item[data-page="${page}"]`);
  if (pg)  pg.classList.add('active');
  if (nav) nav.classList.add('active');
  const [title, sub] = PAGE_META[page] || [page, ''];
  setEl('tbTitle', title); setEl('tbSub', sub);
  if (LOADERS[page]) LOADERS[page]();
  if (isMob()) { sidebar.classList.remove('mob-open'); mobOv.classList.remove('open'); document.body.style.overflow = ''; }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
document.querySelectorAll('.adm-nav-item[data-page]').forEach(el => {
  el.addEventListener('click', () => switchPage(el.dataset.page));
});

/* ═══════════════════════════════════════
   DASHBOARD — fetches all data fresh from DB
═══════════════════════════════════════ */
async function loadDashboard() {
  // Fetch all 4 in parallel for speed
  const [statsD, contactsD, usersD, subsD] = await Promise.all([
    api('/api/dashboard/stats'),
    api('/api/contacts'),
    api('/api/admin/users'),
    api('/api/subscribers'),
  ]);

  const stats = statsD?.stats || {};
  const users = usersD?.users || [];
  const contacts = contactsD?.contacts || [];
  const subs = subsD?.subscribers || [];

  // Update stat cards
  setEl('sUsers',       stats.total_users       ?? users.length);
  setEl('sProjects',    stats.total_projects     ?? '—');
  setEl('sContacts',    stats.total_contacts     ?? contacts.length);
  setEl('sSubscribers', stats.total_subscribers  ?? subs.length);
  setEl('sbUserCount',  stats.total_users        ?? users.length);
  setEl('sbContactCount', stats.total_contacts   ?? contacts.length);
  setEl('aUsers',       stats.total_users        ?? users.length);
  setEl('cfgUserCount', stats.total_users        ?? '—');
  setEl('cfgProjectCount', stats.total_projects  ?? '—');
  setEl('cfgContactCount', stats.total_contacts  ?? '—');
  setEl('cfgCourseCount', stats.total_courses    ?? '—');

  // Sidebar user initials from HBS-rendered name
  const uname = document.getElementById('sbUserName')?.textContent || 'A';
  const init  = uname.trim().charAt(0).toUpperCase();
  setEl('sbUserAv', init); setEl('tbUserAv', init);

  // Recent contacts in dashboard table
  const dcb = document.getElementById('dashContactsBody');
  if (dcb) {
    const recent = contacts.slice(0, 5);
    dcb.innerHTML = recent.length
      ? recent.map(c => `<tr>
          <td class="td-name">${esc(c.name)}</td>
          <td>${c.project_type ? `<span class="pill pill-b">${esc(c.project_type)}</span>` : '—'}</td>
          <td>${fmt(c.created_at)}</td>
          <td><a href="mailto:${esc(c.email)}" class="act-btn act-view" title="Reply"><i class="fas fa-reply"></i></a></td>
        </tr>`).join('')
      : `<tr><td colspan="4"><div class="adm-empty"><i class="fas fa-inbox"></i><p>No messages yet</p></div></td></tr>`;
  }

  // Activity feed — merge contacts, users, subscribers sorted by date
  const acts = [
    ...contacts.slice(0, 4).map(c => ({ type: 'msg',  label: `New message from <strong>${esc(c.name)}</strong>`, date: c.created_at })),
    ...users.slice(0, 3).map(u => ({ type: 'user', label: `User registered: <strong>${esc(u.username)}</strong>`, date: u.created_at })),
    ...subs.slice(0, 3).map(s => ({ type: 'sub',  label: `Newsletter: ${esc(s.email)}`, date: s.subscribed_at })),
  ].sort((a, b) => new Date(b.date) - new Date(a.date)).slice(0, 7);

  const feed = document.getElementById('activityFeed');
  if (feed) {
    feed.innerHTML = acts.length
      ? acts.map(a => {
          const iconMap = { msg: 'fa-envelope msg', user: 'fa-user-plus user', sub: 'fa-at sub', proj: 'fa-folder proj' };
          const [icon, cls] = (iconMap[a.type] || 'fa-bell msg').split(' ');
          return `<div class="act-feed-item">
            <div class="act-dot-icon ${cls||'msg'}"><i class="fas ${icon}"></i></div>
            <div><p>${a.label}</p><time>${fmt(a.date)}</time></div>
          </div>`;
        }).join('')
      : `<div class="adm-empty"><i class="fas fa-clock-rotate-left"></i><p>No activity yet</p></div>`;
  }

  updateCharts(parseInt(stats.total_users) || users.length, subs.length);
}

/* ═══════════════════════════════════════
   CHARTS
═══════════════════════════════════════ */
let growthChart, donutChart, visitorChart;
const cOpts = {
  responsive: true, maintainAspectRatio: true,
  plugins: { legend: { labels: { color: 'rgba(255,255,255,.42)', font: { size: 11 } } } },
  scales: {
    x: { ticks: { color: 'rgba(255,255,255,.26)' }, grid: { color: 'rgba(255,255,255,.04)' } },
    y: { ticks: { color: 'rgba(255,255,255,.26)' }, grid: { color: 'rgba(255,255,255,.04)' } },
  }
};
function initCharts() {
  const gc = document.getElementById('growthChart');
  if (gc) growthChart = new Chart(gc, {
    type: 'line',
    data: {
      labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
      datasets: [
        { label: 'Users',       data: [0,0,0,0,0,0], borderColor: '#1a56e8', backgroundColor: 'rgba(26,86,232,.08)', tension: .4, fill: true, pointBackgroundColor: '#1a56e8', pointRadius: 4 },
        { label: 'Subscribers', data: [0,0,0,0,0,0], borderColor: '#f07020', backgroundColor: 'rgba(240,112,32,.06)', tension: .4, fill: true, pointBackgroundColor: '#f07020', pointRadius: 4 },
      ]
    },
    options: cOpts
  });

  const dc = document.getElementById('donutChart');
  if (dc) donutChart = new Chart(dc, {
    type: 'doughnut',
    data: {
      labels: ['Direct', 'WhatsApp', 'Organic', 'Referral'],
      datasets: [{ data: [38, 28, 22, 12], backgroundColor: ['#1a56e8', '#25D366', '#0dbf7e', '#f07020'], borderWidth: 0, hoverOffset: 6 }]
    },
    options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { color: 'rgba(255,255,255,.42)', font: { size: 11 }, padding: 10 } } }, cutout: '70%' }
  });

  const vc = document.getElementById('visitorChart');
  if (vc) visitorChart = new Chart(vc, {
    type: 'bar',
    data: {
      labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
      datasets: [{ label: 'Page Views', data: [620, 890, 780, 1020], backgroundColor: 'rgba(26,86,232,.65)', borderRadius: 6, borderSkipped: false }]
    },
    options: cOpts
  });

  const cl = document.getElementById('countryList');
  if (cl) cl.innerHTML = [
    { f: '🇰🇪', n: 'Kenya',         p: 42 },
    { f: '🇺🇸', n: 'United States', p: 24 },
    { f: '🇬🇧', n: 'United Kingdom',p: 12 },
    { f: '🇳🇬', n: 'Nigeria',       p: 10 },
    { f: '🇿🇦', n: 'South Africa',  p:  8 },
  ].map(c => `
    <div style="display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.04)">
      <span style="font-size:1.2rem">${c.f}</span>
      <span style="flex:1;font-size:.8rem;color:rgba(255,255,255,.65)">${c.n}</span>
      <div class="country-bar" style="width:80px"><div class="country-fill" style="width:${c.p}%"></div></div>
      <span style="font-size:.7rem;color:rgba(255,255,255,.3);width:28px;text-align:right">${c.p}%</span>
    </div>`).join('');
}

function updateCharts(u, s) {
  if (!growthChart) return;
  const g = (base, i) => Math.max(0, Math.round(base * (0.55 + i * 0.09)));
  growthChart.data.datasets[0].data = [0,1,2,3,4,5].map(i => g(u, i));
  growthChart.data.datasets[1].data = [0,1,2,3,4,5].map(i => g(s, i));
  growthChart.update();
}

/* ═══════════════════════════════════════
   USERS — fetch from /api/admin/users
═══════════════════════════════════════ */
let allUsers = [];
async function loadUsers() {
  const d = await api('/api/admin/users');
  allUsers = d?.users || [];
  renderUsers(allUsers);
}
function renderUsers(arr) {
  const tb = document.getElementById('usersBody');
  if (!tb) return;
  tb.innerHTML = arr.length
    ? arr.map(u => `<tr>
        <td class="td-name">${esc(u.username)}</td>
        <td><a href="mailto:${esc(u.email)}" style="color:var(--blue-l)">${esc(u.email)}</a>${u.google_id ? ' <span class="pill pill-t" style="margin-left:4px">Google</span>' : ''}</td>
        <td><span class="pill ${u.role === 'admin' ? 'pill-o' : 'pill-b'}">${esc(u.role)}</span></td>
        <td><span class="pill ${u.is_active ? 'pill-g' : 'pill-dim'}">${u.is_active ? 'Active' : 'Inactive'}</span></td>
        <td>${fmt(u.created_at)}</td>
        <td>${u.last_login ? fmt(u.last_login) : '<span style="color:rgba(255,255,255,.2)">Never</span>'}</td>
        <td>
          <button class="act-btn act-role" onclick="toggleRole(${u.id},'${u.role}')" title="Toggle role"><i class="fas fa-shield-halved"></i></button>
          <button class="act-btn act-del"  onclick="deleteUser(${u.id})"             title="Delete user"><i class="fas fa-trash"></i></button>
        </td>
      </tr>`).join('')
    : `<tr><td colspan="7"><div class="adm-empty"><i class="fas fa-users"></i><h6>No users found</h6></div></td></tr>`;
}
function filterUsers(q) {
  const s = q.toLowerCase();
  renderUsers(allUsers.filter(u => u.username.toLowerCase().includes(s) || u.email.toLowerCase().includes(s)));
}
async function createUser() {
  const name = document.getElementById('newUserName').value.trim();
  const email = document.getElementById('newUserEmail').value.trim();
  const pwd  = document.getElementById('newUserPassword').value;
  if (!name || !email || !pwd) return toast('Please fill all fields', 'error');
  if (pwd.length < 6) return toast('Password must be at least 6 characters', 'error');
  const r = await api('/api/signup', { method: 'POST', body: JSON.stringify({ fullname: name, email, password: pwd }) });
  if (r?.success) {
    toast('User created!');
    closeModal('modal-add-user');
    ['newUserName', 'newUserEmail', 'newUserPassword'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
    loadUsers();
    loadDashboard();
  }
}
async function deleteUser(id) {
  if (!confirm('Delete this user permanently?')) return;
  const r = await api(`/api/admin/delete-user/${id}`, { method: 'DELETE' });
  if (r?.success) { toast('User deleted'); loadUsers(); loadDashboard(); }
}
async function toggleRole(id, role) {
  const ep = role === 'admin' ? '/api/admin/remove-admin' : '/api/admin/make-admin';
  const r  = await api(ep, { method: 'POST', body: JSON.stringify({ userId: id }) });
  if (r?.success) { toast('Role updated'); loadUsers(); }
}

