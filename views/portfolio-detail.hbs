<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script>
AOS.init({duration:720,once:true,offset:50,easing:'ease-out-cubic'});

/* CURSOR */
(function(){var dot=document.getElementById('cursor-dot'),ring=document.getElementById('cursor-ring');if(!dot||!ring)return;var mx=window.innerWidth/2,my=window.innerHeight/2,rx=mx,ry=my;document.addEventListener('mouseleave',function(){document.body.classList.add('cursor-hidden');});document.addEventListener('mouseenter',function(){document.body.classList.remove('cursor-hidden');});document.addEventListener('mousedown',function(){document.body.classList.add('cursor-click');});document.addEventListener('mouseup',function(){document.body.classList.remove('cursor-click');});window.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;dot.style.left=mx+'px';dot.style.top=my+'px';},{passive:true});(function loop(){rx+=(mx-rx)*.13;ry+=(my-ry)*.13;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(loop);})();document.querySelectorAll('a,button,[role="button"]').forEach(function(el){el.addEventListener('mouseenter',function(){document.body.classList.add('cursor-hover');});el.addEventListener('mouseleave',function(){document.body.classList.remove('cursor-hover');});});})();

/* SCROLL */
var navbar=document.getElementById('mainNav'),btt=document.getElementById('back-to-top'),sp=document.getElementById('scroll-progress');
window.addEventListener('scroll',function(){var st=window.pageYOffset,dh=document.documentElement.scrollHeight-window.innerHeight;sp.style.width=(dh>0?(st/dh)*100:0)+'%';navbar.classList.toggle('scrolled',st>40);btt.classList.toggle('visible',st>400);},{passive:true});
btt.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});

/* MOBILE NAV */
var mo=document.getElementById('mobOverlay'),mp=document.getElementById('mobPanel'),hb=document.getElementById('hamBtn'),mc=document.getElementById('mobClose'),st2=document.getElementById('mobSvcToggle'),ss=document.getElementById('mobSvcSub');
function openM(){mo.classList.add('open');mp.classList.add('open');hb.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';}
function closeM(){mp.classList.remove('open');mo.classList.remove('open');hb.setAttribute('aria-expanded','false');document.body.style.overflow='';}
hb.addEventListener('click',openM);mc.addEventListener('click',closeM);mo.addEventListener('click',closeM);
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&mp.classList.contains('open'))closeM();});
st2.addEventListener('click',function(){var o=ss.classList.toggle('open');st2.setAttribute('aria-expanded',o);});

/* THEME */
var tb=document.getElementById('theme-toggle'),mtb=document.getElementById('mobThemeBtn');
var dark=localStorage.getItem('nw-theme')==='dark'||(!localStorage.getItem('nw-theme')&&window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON='<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN='<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyT(){document.body.classList.toggle('dark',dark);tb.innerHTML=dark?SUN:MOON;if(mtb)mtb.innerHTML=dark?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>';}
applyT();
function toggleT(){dark=!dark;localStorage.setItem('nw-theme',dark?'dark':'light');applyT();}
tb.addEventListener('click',toggleT);if(mtb)mtb.addEventListener('click',toggleT);
</script>
