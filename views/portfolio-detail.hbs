<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <meta name="description" content="{{#if project.description}}{{project.description}}{{else}}View project details for {{project.name}} by NeurowexTech.{{/if}}" />
  <link rel="canonical" href="https://neurowextech.co.ke/portfolio/{{project.id}}" />
  <meta property="og:title"       content="{{project.name}} – NeurowexTech" />
  <meta property="og:description" content="{{#if project.description}}{{project.description}}{{else}}View this project by NeurowexTech.{{/if}}" />
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="NeurowexTech" />
  {{#if project.image_url}}<meta property="og:image" content="{{project.image_url}}" />{{/if}}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300;1,9..144,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
<style>
:root {
  --primary:#1c2b4a; --primary-d:#111d33;
  --accent:#e05c2a; --accent-d:#c44e21; --accent-pale:rgba(224,92,42,.08);
  --blue:#2563eb; --blue-d:#1d4ed8; --blue-l:#3b82f6;
  --blue-pale:rgba(37,99,235,.07); --blue-pale2:rgba(37,99,235,.13);
  --ink:#0f172a; --ink-2:#1e293b;
  --slate:#64748b; --slate-l:#94a3b8;
  --mist:#e2e8f0; --ghost:#f8fafc; --white:#ffffff; --surface:#f1f5f9;
  --emerald:#059669; --teal:#0d9488;
  --g-blue:linear-gradient(135deg,#2563eb,#1d4ed8);
  --g-accent:linear-gradient(135deg,#e05c2a,#c44e21);
  --r-xs:4px;--r-sm:6px;--r-md:8px;--r-lg:12px;--r-xl:16px;--r-2xl:20px;--r-pill:999px;
  --nav-h:66px;
  --sh-sm:0 1px 3px rgba(15,23,42,.06),0 1px 2px rgba(15,23,42,.04);
  --sh-md:0 4px 16px rgba(15,23,42,.08),0 2px 6px rgba(15,23,42,.05);
  --sh-lg:0 12px 40px rgba(15,23,42,.12),0 4px 12px rgba(15,23,42,.06);
  --sh-xl:0 20px 60px rgba(15,23,42,.16),0 8px 20px rgba(15,23,42,.08);
  --sh-blue:0 4px 18px rgba(37,99,235,.28);
  --sh-accent:0 4px 18px rgba(224,92,42,.28);
  --ease:cubic-bezier(.4,0,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);--t:.22s var(--ease);
  --font-display:'Fraunces',Georgia,serif;
  --font-body:'Plus Jakarta Sans',system-ui,sans-serif;
  --font-mono:'JetBrains Mono',monospace;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:var(--font-body);background:var(--ghost);color:var(--ink);overflow-x:hidden;font-size:16px;line-height:1.6}
h1,h2,h3,h4{font-family:var(--font-display);line-height:1.1;letter-spacing:-.02em}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--ink)}
::-webkit-scrollbar-thumb{background:var(--blue);border-radius:4px}
@media(pointer:fine){body{cursor:none}a,button,[role="button"],input,select{cursor:none}}
#cursor-dot{position:fixed;width:8px;height:8px;border-radius:50%;background:var(--accent);pointer-events:none;z-index:99999;transform:translate(-50%,-50%);transition:background .25s,transform .2s var(--spring),opacity .2s;will-change:left,top}
#cursor-ring{position:fixed;width:36px;height:36px;border-radius:50%;border:1.5px solid rgba(224,92,42,.5);pointer-events:none;z-index:99998;transform:translate(-50%,-50%);will-change:left,top;transition:width .22s,height .22s,border-color .22s}
body.cursor-hover #cursor-dot{transform:translate(-50%,-50%) scale(2.5);background:var(--blue)}
body.cursor-hover #cursor-ring{width:54px;height:54px;border-color:rgba(37,99,235,.4)}
body.cursor-click #cursor-dot{transform:translate(-50%,-50%) scale(.5)}
body.cursor-hidden #cursor-dot,body.cursor-hidden #cursor-ring{opacity:0}
#scroll-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,var(--primary),var(--blue),var(--accent));z-index:9999;transition:width .06s linear}

/* DARK MODE */
body.dark{background:#0a0f1e;color:rgba(255,255,255,.88)}
body.dark .navbar{background:rgba(10,15,30,.97);border-bottom-color:rgba(255,255,255,.06)}
body.dark .navbar.scrolled{box-shadow:0 1px 16px rgba(0,0,0,.3)}
body.dark .nav-links .nl-a{color:rgba(255,255,255,.65)}
body.dark .nav-links .nl-a:hover{color:#fff}
body.dark .mega-drop{background:rgba(13,18,36,.98);border-color:rgba(255,255,255,.07)}
body.dark .btn-nav-signin{border-color:rgba(255,255,255,.14);color:rgba(255,255,255,.55)}
body.dark .detail-card{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.07)}
body.dark .breadcrumb-item{color:rgba(255,255,255,.35)}
body.dark .breadcrumb-sep{color:rgba(255,255,255,.15)}
body.dark .meta-row span{background:rgba(255,255,255,.07);color:rgba(255,255,255,.55)}
body.dark .btn-back{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);color:rgba(255,255,255,.55)}
body.dark .btn-back:hover{border-color:var(--blue);color:rgba(147,197,253,.9)}
body.dark footer{background:#080d1a}
body.dark .footer-divider{border-color:rgba(255,255,255,.06)}
body.dark .mob-panel{background:#0d1220}

/* NAVBAR */
.navbar{position:fixed;top:0;left:0;right:0;z-index:900;background:rgba(255,255,255,.97);border-bottom:1px solid rgba(15,23,42,.06);backdrop-filter:blur(18px);transition:box-shadow var(--t),background var(--t)}
.navbar.scrolled{box-shadow:0 1px 14px rgba(15,23,42,.09)}
.nav-inner{max-width:1280px;margin:0 auto;padding:0 28px;height:var(--nav-h);display:flex;align-items:center;gap:28px}
.nav-brand{display:flex;align-items:center;gap:9px;flex-shrink:0}
.nav-logo-circle{width:34px;height:34px;border-radius:50%;overflow:hidden;background:var(--primary);flex-shrink:0;border:1.5px solid rgba(37,99,235,.2)}
.nav-logo-circle img{width:100%;height:100%;object-fit:cover}
.nav-brand-text{font-family:var(--font-display);font-size:1.08rem;font-weight:600;letter-spacing:-.02em;color:var(--ink)}
.nav-brand-text em{font-style:normal;color:var(--accent)}
.nav-links{display:flex;list-style:none;gap:2px;margin-left:auto}
.nl-item{position:relative}
.nl-a{font-size:.82rem;font-weight:600;padding:7px 13px;border-radius:var(--r-lg);color:var(--slate);transition:color var(--t),background var(--t);display:flex;align-items:center;gap:5px}
.nl-a:hover,.nl-a.active{color:var(--ink);background:var(--blue-pale)}
.nl-a .arrow{font-size:.58rem;transition:transform var(--t);opacity:.5}
.nl-item:hover .arrow{transform:rotate(180deg)}
.mega-drop{display:none;position:absolute;top:calc(100% + 8px);left:50%;transform:translateX(-50%);background:var(--white);border:1px solid rgba(15,23,42,.07);border-radius:var(--r-xl);padding:20px;box-shadow:var(--sh-xl);min-width:520px}
.nl-item:hover .mega-drop{display:block}
.mega-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:4px 20px}
.mega-col-label{font-size:.65rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--slate-l);padding:0 10px 6px;display:block}
.mega-link{display:flex;align-items:center;gap:9px;font-size:.79rem;font-weight:600;color:var(--slate);padding:8px 10px;border-radius:var(--r-md);transition:background var(--t),color var(--t)}
.mega-link:hover{background:var(--blue-pale);color:var(--blue)}
.mega-link i{width:16px;text-align:center;opacity:.6}
.nav-cta{display:flex;align-items:center;gap:8px;flex-shrink:0}
.btn-nav-signin{font-size:.78rem;font-weight:700;padding:7px 16px;border-radius:var(--r-pill);border:1.5px solid rgba(15,23,42,.12);color:var(--slate);transition:var(--t)}
.btn-nav-signin:hover{background:var(--surface);color:var(--ink)}
.btn-nav-orange{font-size:.78rem;font-weight:700;padding:7px 16px;border-radius:var(--r-pill);background:var(--accent-pale);color:var(--accent);transition:var(--t);display:flex;align-items:center;gap:5px}
.btn-nav-orange:hover{background:var(--accent);color:#fff}
.btn-nav-start{font-size:.78rem;font-weight:700;padding:7px 18px;border-radius:var(--r-pill);background:var(--g-blue);color:#fff;box-shadow:var(--sh-blue);transition:var(--t);display:flex;align-items:center;gap:6px}
.btn-nav-start:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(37,99,235,.38)}
#theme-toggle{width:34px;height:34px;border-radius:50%;border:none;background:var(--blue-pale);color:var(--blue);display:flex;align-items:center;justify-content:center;transition:var(--t);flex-shrink:0}
#theme-toggle:hover{background:var(--blue);color:#fff}
#theme-toggle svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.mob-quick{display:none;align-items:center;gap:8px;margin-left:auto}
.mob-quick-btn{width:36px;height:36px;border-radius:50%;border:none;background:var(--blue-pale);color:var(--blue);display:flex;align-items:center;justify-content:center;font-size:.85rem}
.mob-quick-wa{width:36px;height:36px;border-radius:50%;background:#25d366;color:#fff;display:flex;align-items:center;justify-content:center;font-size:.9rem}
.ham-btn{width:36px;height:36px;border-radius:var(--r-md);border:none;background:var(--blue-pale);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px}
.ham-line{display:block;width:18px;height:2px;background:var(--blue);border-radius:2px;transition:var(--t)}
.mob-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:800;opacity:0;pointer-events:none;transition:opacity var(--t)}
.mob-overlay.open{opacity:1;pointer-events:all}
.mob-panel{position:fixed;top:0;right:0;bottom:0;width:min(320px,88vw);background:var(--white);z-index:810;transform:translateX(100%);transition:transform .3s var(--ease);overflow-y:auto;padding:20px}
.mob-panel.open{transform:none}
.mob-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid var(--mist)}
.mob-logo{font-family:var(--font-display);font-size:1.05rem;font-weight:600;color:var(--ink)}
.mob-logo em{font-style:normal;color:var(--accent)}
.mob-close{width:32px;height:32px;border-radius:50%;border:none;background:var(--surface);color:var(--slate);font-size:.85rem}
.mob-link{display:flex;align-items:center;gap:10px;font-size:.86rem;font-weight:600;color:var(--slate);padding:11px 0;border-bottom:1px solid var(--mist);transition:color var(--t)}
.mob-link:hover{color:var(--blue)}
.mob-link i{width:16px;text-align:center;opacity:.5}
.mob-sub-toggle{display:flex;align-items:center;gap:10px;font-size:.86rem;font-weight:600;color:var(--slate);padding:11px 0;border-bottom:1px solid var(--mist)}
.mob-sub{display:none;padding:8px 0 0 26px}
.mob-sub.open{display:block}
.mob-sub a{display:block;font-size:.8rem;color:var(--slate);padding:7px 0;border-bottom:1px solid var(--surface)}
.mob-sub a:hover{color:var(--blue)}
.mob-footer-links{margin-top:24px;display:flex;flex-direction:column;gap:10px}
.mob-footer-links a{font-size:.8rem;font-weight:700;padding:11px 16px;border-radius:var(--r-lg);text-align:center;background:var(--surface)}
.mob-footer-links .mob-cta-primary{background:var(--g-blue);color:#fff}
.mob-footer-links .mob-cta-orange{background:var(--g-accent);color:#fff}
@media(max-width:899px){.nav-links,.nav-cta,.btn-nav-orange{display:none!important}.mob-quick{display:flex!important}}
@media(min-width:900px){.mob-overlay,.mob-panel{display:none!important}}

/* LAYOUT */
.container{width:100%;max-width:1200px;margin:0 auto;padding:0 24px}

/* BREADCRUMB */
.breadcrumb{padding:calc(var(--nav-h) + 24px) 0 0}
.breadcrumb-inner{display:flex;align-items:center;gap:6px;font-size:.75rem;font-weight:600}
.breadcrumb-item{color:var(--slate);transition:color var(--t)}
.breadcrumb-item:hover{color:var(--blue)}
.breadcrumb-sep{color:var(--mist);font-size:.6rem}
.breadcrumb-item.current{color:var(--ink)}

/* HERO */
.detail-hero{padding:28px 0 60px}
.detail-hero-inner{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
@media(max-width:800px){.detail-hero-inner{grid-template-columns:1fr;gap:32px}}
.detail-hero h1{font-size:clamp(1.9rem,5vw,3.2rem);font-weight:400;color:var(--ink);margin-bottom:14px;line-height:1.05}
body.dark .detail-hero h1{color:#fff}
.cat-badge{display:inline-flex;align-items:center;gap:6px;font-size:.68rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;padding:5px 13px;border-radius:var(--r-pill);border:1px solid rgba(37,99,235,.2);background:var(--blue-pale);color:var(--blue);margin-bottom:16px}
.featured-badge{display:inline-flex;align-items:center;gap:5px;font-size:.68rem;font-weight:800;padding:4px 11px;border-radius:var(--r-pill);background:rgba(217,119,6,.1);border:1px solid rgba(217,119,6,.2);color:#92400e;margin-left:8px}
.detail-desc{font-size:.96rem;color:var(--slate);line-height:1.82;margin-bottom:28px}
body.dark .detail-desc{color:rgba(255,255,255,.5)}
.meta-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.meta-row span{display:inline-flex;align-items:center;gap:6px;font-size:.76rem;font-weight:700;padding:6px 12px;border-radius:var(--r-md);background:var(--surface);color:var(--slate)}
.meta-row span i{font-size:.72rem;opacity:.6}
.detail-actions{display:flex;gap:12px;flex-wrap:wrap}
.btn-live{display:inline-flex;align-items:center;gap:8px;font-size:.88rem;font-weight:700;padding:12px 26px;border-radius:var(--r-pill);background:var(--g-blue);color:#fff;box-shadow:var(--sh-blue);transition:var(--t)}
.btn-live:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(37,99,235,.38)}
.btn-back{display:inline-flex;align-items:center;gap:8px;font-size:.88rem;font-weight:700;padding:12px 24px;border-radius:var(--r-pill);border:1.5px solid var(--mist);color:var(--slate);background:var(--white);transition:var(--t)}
.btn-back:hover{background:var(--surface);border-color:var(--blue);color:var(--blue)}

/* IMAGE */
.detail-img-wrap{border-radius:var(--r-2xl);overflow:hidden;aspect-ratio:16/10;background:var(--blue-pale);box-shadow:var(--sh-xl);position:relative;border:1px solid var(--mist)}
body.dark .detail-img-wrap{border-color:rgba(255,255,255,.07)}
.detail-img-wrap img{width:100%;height:100%;object-fit:cover}
.img-fallback{position:absolute;inset:0;display:none;align-items:center;justify-content:center;font-size:4rem;background:linear-gradient(135deg,var(--blue-pale2),var(--accent-pale))}

/* CARDS */
.detail-card{background:var(--white);border:1px solid var(--mist);border-radius:var(--r-2xl);padding:36px;margin-bottom:24px}
.detail-card h2{font-size:1.15rem;font-weight:400;margin-bottom:18px;color:var(--ink)}
body.dark .detail-card h2{color:#fff}
.detail-grid{display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start}
@media(max-width:768px){.detail-grid{grid-template-columns:1fr}}
.info-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:480px){.info-row{grid-template-columns:1fr}}
.info-item-lbl{font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--slate-l);margin-bottom:4px}
.info-item-val{font-size:.9rem;font-weight:600;color:var(--ink)}
body.dark .info-item-val{color:rgba(255,255,255,.8)}

/* CTA BAND */
.cta-band{background:linear-gradient(158deg,#060c1a 0%,#0d1628 50%,#111f3a 100%);padding:88px 0;text-align:center;position:relative;overflow:hidden;margin-top:64px}
.cta-band::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 50% 50%,rgba(37,99,235,.13),transparent);pointer-events:none}
.cta-btn-white{display:inline-flex;align-items:center;gap:8px;font-size:.88rem;font-weight:700;padding:13px 28px;border-radius:var(--r-pill);background:#fff;color:var(--primary);box-shadow:var(--sh-lg);transition:var(--t)}
.cta-btn-white:hover{transform:translateY(-2px);box-shadow:var(--sh-xl)}
.cta-btn-orange{display:inline-flex;align-items:center;gap:8px;font-size:.88rem;font-weight:700;padding:13px 28px;border-radius:var(--r-pill);background:var(--g-accent);color:#fff;box-shadow:var(--sh-accent);transition:var(--t)}
.cta-btn-orange:hover{transform:translateY(-2px)}
.btn-wa-cta{display:inline-flex;align-items:center;gap:8px;font-size:.84rem;font-weight:700;padding:13px 22px;border-radius:var(--r-pill);background:#25d366;color:#fff;transition:var(--t)}
.btn-wa-cta:hover{transform:translateY(-2px);background:#1ab757}

/* BACK TO TOP */
#back-to-top{position:fixed;bottom:28px;left:28px;width:40px;height:40px;border-radius:50%;background:var(--g-blue);color:#fff;border:none;box-shadow:var(--sh-blue);display:flex;align-items:center;justify-content:center;font-size:.8rem;z-index:700;opacity:0;pointer-events:none;transition:opacity var(--t),transform var(--t)}
#back-to-top.visible{opacity:1;pointer-events:all}
#back-to-top:hover{transform:translateY(-3px)}

/* FOOTER */
footer{background:#050c1e;color:rgba(255,255,255,.55);font-size:.84rem}
.footer-accent-bar{height:3px;background:linear-gradient(90deg,var(--primary),var(--blue),var(--accent))}
.footer-cta-strip{background:rgba(37,99,235,.07);border-bottom:1px solid rgba(255,255,255,.05);padding:24px 0}
.footer-cta-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.footer-cta-text h4{font-family:var(--font-display);font-weight:400;color:#fff;font-size:1.05rem;margin-bottom:2px}
.footer-cta-text p{font-size:.78rem;color:rgba(255,255,255,.4)}
.footer-cta-actions{display:flex;gap:10px;flex-wrap:wrap}
.btn-primary{display:inline-flex;align-items:center;gap:7px;font-family:var(--font-body);font-size:.82rem;font-weight:700;padding:9px 20px;border-radius:var(--r-pill);background:var(--g-blue);color:#fff;transition:var(--t)}
.btn-primary:hover{transform:translateY(-1px);box-shadow:var(--sh-blue)}
.btn-wa{display:inline-flex;align-items:center;gap:8px;font-size:.84rem;font-weight:700;padding:9px 18px;border-radius:var(--r-pill);background:#25d366;color:#fff;transition:var(--t)}
.btn-wa:hover{transform:translateY(-2px);background:#1ab757}
.footer-body{padding:56px 0 36px}
.footer-cols{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.4fr;gap:40px}
@media(max-width:900px){.footer-cols{grid-template-columns:1fr 1fr;gap:32px 24px}}
@media(max-width:520px){.footer-cols{grid-template-columns:1fr;gap:28px}}
.footer-brand-name{font-family:var(--font-display);font-size:1.3rem;font-weight:400;color:#fff;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.footer-brand-dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}
.footer-brand-name em{font-style:normal;color:var(--accent)}
.footer-tagline{color:rgba(255,255,255,.38);line-height:1.72;max-width:280px;margin-bottom:18px;font-size:.82rem}
.footer-socials{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.fsoc{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.06);color:rgba(255,255,255,.55);display:flex;align-items:center;justify-content:center;font-size:.82rem;transition:var(--t)}
.fsoc:hover{transform:translateY(-2px);color:#fff}
.fsoc.fb:hover{background:#1877f2;color:#fff}.fsoc.li:hover{background:#0077b5}.fsoc.ig:hover{background:linear-gradient(45deg,#f09433,#e6683c,#dc2743)}.fsoc.yt:hover{background:#ff0000}.fsoc.wa:hover{background:#25d366}
.footer-col-title{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.25);margin-bottom:14px}
.footer-links{list-style:none}
.footer-links li{margin-bottom:2px}
.footer-links a{display:flex;align-items:center;gap:9px;font-size:.8rem;color:rgba(255,255,255,.42);padding:5px 0;transition:color var(--t)}
.footer-links a:hover{color:rgba(255,255,255,.82)}
.footer-links i{width:13px;font-size:.7rem;opacity:.5;text-align:center}
.academy-link{color:rgba(52,211,153,.7)!important}
