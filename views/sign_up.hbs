<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="author" content="NeurowexTech" />
  <meta name="geo.region" content="KE-110" />
  <meta name="geo.placename" content="Nairobi, Kenya" />
  <meta name="geo.position" content="-1.2921;36.8219" />
  <meta name="ICBM" content="-1.2921, 36.8219" />
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,400&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
:root{--primary:#1c2b4a;--accent:#e05c2a;--blue:#2563eb;--blue-pale:rgba(37,99,235,.07);--mist:#e2e8f0;--ghost:#f8fafc;--ink:#0f172a;--slate:#64748b;--emerald:#059669;--gold:#d97706;--rose:#e11d48;--font-body:'Plus Jakarta Sans',system-ui,sans-serif;--font-display:'Fraunces',Georgia,serif;--r-md:8px;--sh-blue:0 4px 18px rgba(37,99,235,.28);--t:.22s cubic-bezier(.4,0,.2,1)}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{-webkit-font-smoothing:antialiased}
body{font-family:var(--font-body);background:var(--ghost);color:var(--ink);min-height:100vh}
a{text-decoration:none;color:inherit}
.auth-wrap{display:grid;grid-template-columns:1fr;min-height:100vh}
@media(min-width:900px){.auth-wrap{grid-template-columns:1fr 1fr}}
.auth-left{display:none;background:linear-gradient(158deg,#060c1a 0%,#0c1628 45%,#111f3a 100%);position:relative;overflow:hidden;flex-direction:column;justify-content:space-between;padding:48px}
@media(min-width:900px){.auth-left{display:flex}}
.auth-left::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(37,99,235,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(37,99,235,.04) 1px,transparent 1px);background-size:52px 52px}
.al-orb{position:absolute;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.14) 0%,transparent 65%);top:-120px;left:-80px}
.al-orb2{position:absolute;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle,rgba(224,92,42,.1) 0%,transparent 65%);bottom:-100px;right:-60px}
.al-brand{display:flex;align-items:center;gap:10px;margin-bottom:40px;position:relative;z-index:1}
.al-logo{width:44px;height:44px;border-radius:50%;border:2.5px solid var(--accent);background:#fff;overflow:hidden;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 3px rgba(224,92,42,.15)}
.al-logo img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block}
.al-brand-name{font-family:var(--font-display);font-size:1.2rem;font-weight:600;color:#fff}
.al-brand-name em{font-style:normal;color:var(--accent)}
.al-content{position:relative;z-index:1;flex:1;display:flex;flex-direction:column;justify-content:center}
.al-headline{font-family:var(--font-display);font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:400;color:#fff;line-height:1.1;margin-bottom:16px}
.al-headline span{font-style:italic;background:linear-gradient(135deg,rgba(248,200,130,.95),rgba(224,92,42,.9));-webkit-background-clip:text;background-clip:text;color:transparent}
.al-sub{color:rgba(255,255,255,.5);font-size:.95rem;line-height:1.75;max-width:360px;margin-bottom:32px}
.al-perks{display:flex;flex-direction:column;gap:12px;margin-bottom:32px}
.al-perk{display:flex;align-items:flex-start;gap:12px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:14px}
.al-perk-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.95rem}
.al-perk-text h5{font-family:var(--font-body);font-size:.85rem;font-weight:700;color:#fff;margin-bottom:2px}
.al-perk-text p{font-size:.75rem;color:rgba(255,255,255,.45);line-height:1.5}
.al-trust{display:flex;gap:10px;flex-wrap:wrap}
.al-trust-badge{display:flex;align-items:center;gap:5px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:999px;padding:5px 12px;font-size:.7rem;color:rgba(255,255,255,.6);font-weight:600}
/* RIGHT */
.auth-right{background:#fff;display:flex;align-items:center;justify-content:center;padding:40px 24px;min-height:100vh}
.auth-card{width:100%;max-width:440px}
.logo-top{display:flex;flex-direction:column;align-items:center;margin-bottom:24px}
.logo-circle{width:84px;height:84px;border-radius:50%;border:3px solid var(--accent);background:#fff;overflow:hidden;box-shadow:0 6px 28px rgba(28,43,74,.14),0 0 0 6px rgba(224,92,42,.09);display:flex;align-items:center;justify-content:center}
.logo-circle img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block}
.logo-top-name{font-family:var(--font-display);font-size:1.05rem;color:var(--primary);margin-top:10px;font-weight:600}
.logo-top-name em{font-style:normal;color:var(--accent)}
.back-link{display:inline-flex;align-items:center;gap:6px;font-size:.8rem;color:var(--slate);margin-bottom:24px;transition:color .18s}
.back-link:hover{color:var(--blue)}
h1{font-family:var(--font-display);font-size:clamp(1.5rem,4vw,1.9rem);font-weight:400;color:var(--primary);margin-bottom:5px}
.sub{color:var(--slate);font-size:.9rem;margin-bottom:24px}
.sub a{color:var(--blue);font-weight:600}
.sub a:hover{text-decoration:underline}
.alert{padding:12px 14px;border-radius:var(--r-md);font-size:.83rem;margin-bottom:16px;display:none;align-items:flex-start;gap:9px}
.alert.show{display:flex}
.alert-error{background:rgba(225,29,72,.07);border:1px solid rgba(225,29,72,.2);color:#be123c}
.alert-success{background:rgba(5,150,105,.07);border:1px solid rgba(5,150,105,.2);color:#065f46}
.btn-google{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:11px 20px;border:1.5px solid var(--mist);border-radius:var(--r-md);background:#fff;color:var(--ink);font-family:var(--font-body);font-size:.88rem;font-weight:600;cursor:pointer;transition:var(--t);margin-bottom:18px}
.btn-google:hover{border-color:#4285f4;box-shadow:0 2px 12px rgba(66,133,244,.15)}
.btn-google svg{width:20px;height:20px;flex-shrink:0}
.divider{display:flex;align-items:center;gap:12px;margin-bottom:18px}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--mist)}
.divider span{font-size:.75rem;color:var(--slate);font-weight:600;text-transform:uppercase;letter-spacing:.8px;white-space:nowrap}
.form-group{margin-bottom:14px}
.form-label{display:block;font-size:.8rem;font-weight:700;color:var(--ink);margin-bottom:5px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.form-row{grid-template-columns:1fr}}
.input-wrap{position:relative}
.form-input{width:100%;padding:11px 14px 11px 40px;border:1.5px solid var(--mist);border-radius:var(--r-md);font-size:.9rem;font-family:var(--font-body);color:var(--ink);background:#fff;transition:var(--t);outline:none}
.form-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.08)}
.input-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--slate);font-size:.82rem;pointer-events:none}
.input-action{position:absolute;right:13px;top:50%;transform:translateY(-50%);color:var(--slate);cursor:pointer;background:none;border:none;font-size:.82rem}
.field-err{font-size:.73rem;color:var(--rose);margin-top:4px;display:none;align-items:center;gap:4px}
.field-err.show{display:flex}
.strength-bar{height:4px;border-radius:2px;margin-top:6px;background:var(--mist);overflow:hidden}
.strength-fill{height:100%;border-radius:2px;transition:width .3s,background .3s;width:0}
.strength-label{font-size:.7rem;margin-top:3px;font-weight:600}
.btn-submit{width:100%;padding:13px;border:none;border-radius:var(--r-md);background:linear-gradient(135deg,var(--primary),var(--blue));color:#fff;font-family:var(--font-body);font-size:.95rem;font-weight:700;cursor:pointer;transition:var(--t);display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:var(--sh-blue);margin-top:4px}
.btn-submit:hover{opacity:.92;transform:translateY(-1px)}
.btn-submit:disabled{opacity:.65;cursor:not-allowed;transform:none}
.spinner{display:none;width:16px;height:16px;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
.btn-submit.loading .spinner{display:block}
.btn-submit.loading .btn-text{display:none}
@keyframes spin{to{transform:rotate(360deg)}}
.terms-note{font-size:.72rem;color:var(--slate);text-align:center;margin-top:14px;line-height:1.6}
.terms-note a{color:var(--blue)}
</style>
</head>
<body>
<div class="auth-wrap">
  <!-- LEFT -->
  <div class="auth-left">
    <div class="al-orb"></div><div class="al-orb2"></div>
    <div class="al-brand">
      <div class="al-logo"><img src="/images/logo.png" alt="NeurowexTech"/></div>
      <div class="al-brand-name">Neurowex<em>Tech</em></div>
    </div>
    <div class="al-content">
      <h2 class="al-headline">Join <span>NeurowexTech</span><br>Today</h2>
      <p class="al-sub">Access courses, track projects, hire our team, and grow your digital skills — all in one place.</p>
      <div class="al-perks">
        <div class="al-perk">
          <div class="al-perk-icon" style="background:rgba(37,99,235,.18)"><i class="fas fa-graduation-cap" style="color:rgba(147,197,253,.9)"></i></div>
          <div class="al-perk-text"><h5>Access the Academy</h5><p>40+ courses on web dev, AI, UI/UX, graphic design & more</p></div>
        </div>
        <div class="al-perk">
          <div class="al-perk-icon" style="background:rgba(224,92,42,.16)"><i class="fas fa-rocket" style="color:rgba(251,146,60,.9)"></i></div>
          <div class="al-perk-text"><h5>Track Your Projects</h5><p>Get real-time updates on every project we build for you</p></div>
        </div>
        <div class="al-perk">
          <div class="al-perk-icon" style="background:rgba(5,150,105,.15)"><i class="fas fa-certificate" style="color:rgba(52,211,153,.9)"></i></div>
          <div class="al-perk-text"><h5>Earn Certificates</h5><p>Industry-recognised certificates to boost your career</p></div>
        </div>
      </div>
      <div class="al-trust">
        <div class="al-trust-badge"><i class="fas fa-shield-check" style="color:#34d399"></i> Free to join</div>
        <div class="al-trust-badge"><i class="fas fa-lock" style="color:rgba(147,197,253,.9)"></i> No credit card</div>
        <div class="al-trust-badge"><i class="fas fa-star" style="color:var(--gold)"></i> 4.9/5 rating</div>
      </div>
    </div>
  </div>
  <!-- RIGHT -->
  <div class="auth-right">
    <div class="auth-card">
      <div class="logo-top">
        <div class="logo-circle"><img src="/images/logo.png" alt="NeurowexTech"/></div>
        <span class="logo-top-name">Neurowex<em>Tech</em></span>
      </div>
      <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> Back to home</a>
      <h1>Create your account</h1>
      <p class="sub">Already have an account? <a href="/login">Sign in</a></p>
      <div class="alert alert-error" id="alertBox"><i class="fas fa-exclamation-circle"></i><span id="alertMsg"></span></div>
      <!-- Email verification sent screen (hidden by default) -->
      <div id="verifyScreen" style="display:none;text-align:center;padding:12px 0">
        <div style="width:72px;height:72px;border-radius:50%;background:rgba(5,150,105,.1);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;font-size:2rem;color:#059669"><i class="fas fa-envelope-circle-check"></i></div>
        <h2 style="font-size:1.25rem;color:#0f172a;margin-bottom:8px">Check your email</h2>
        <p style="font-size:.88rem;color:#64748b;line-height:1.7;margin-bottom:20px">We sent a verification link to <strong id="verifyEmail"></strong>. Click the link to activate your account.</p>
        <a href="/login" style="display:inline-block;padding:11px 28px;background:linear-gradient(135deg,#1c2b4a,#2563eb);color:#fff;border-radius:8px;font-weight:700;font-size:.88rem;text-decoration:none">Go to Sign In</a>
        <p style="font-size:.78rem;color:#94a3b8;margin-top:16px">Didn't get it? Check spam or <button id="resendBtn" type="button" style="background:none;border:none;color:#2563eb;font-weight:600;cursor:pointer;font-size:.78rem;padding:0">resend verification email</button></p>
        <p id="resendMsg" style="display:none;font-size:.78rem;color:#059669;margin-top:8px"></p>
      </div>
      <button class="btn-google" id="googleBtn" type="button">
        <svg viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Sign up with Google
      </button>
      <div class="divider"><span>or sign up with email</span></div>
      <form id="signupForm" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="firstName">First name</label>
            <div class="input-wrap">
              <i class="fas fa-user input-icon"></i>
              <input type="text" id="firstName" class="form-input" placeholder="John" autocomplete="given-name" required/>
            </div>
            <div class="field-err" id="firstErr"><i class="fas fa-circle-exclamation"></i><span></span></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="lastName">Last name</label>
            <div class="input-wrap">
              <i class="fas fa-user input-icon"></i>
              <input type="text" id="lastName" class="form-input" placeholder="Smith" autocomplete="family-name"/>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="email">Email address</label>
          <div class="input-wrap">
            <i class="fas fa-envelope input-icon"></i>
            <input type="email" id="email" class="form-input" placeholder="you@example.com" autocomplete="email" required/>
          </div>
          <div class="field-err" id="emailErr"><i class="fas fa-circle-exclamation"></i><span></span></div>
        </div>
        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <div class="input-wrap">
            <i class="fas fa-lock input-icon"></i>
            <input type="password" id="password" class="form-input" placeholder="Create a strong password" autocomplete="new-password" required/>
            <button type="button" class="input-action" id="togglePwd"><i class="fas fa-eye"></i></button>
          </div>
          <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
          <div class="strength-label" id="strengthLabel" style="color:var(--slate)"></div>
          <div class="field-err" id="pwdErr"><i class="fas fa-circle-exclamation"></i><span></span></div>
        </div>
        <div class="form-group">
          <label class="form-label" for="confirmPassword">Confirm password</label>
          <div class="input-wrap">
            <i class="fas fa-lock input-icon"></i>
            <input type="password" id="confirmPassword" class="form-input" placeholder="Repeat your password" autocomplete="new-password" required/>
            <button type="button" class="input-action" id="toggleConfirm"><i class="fas fa-eye"></i></button>
          </div>
          <div class="field-err" id="confirmErr"><i class="fas fa-circle-exclamation"></i><span></span></div>
        </div>
        <button type="submit" class="btn-submit" id="submitBtn">
          <span class="btn-text"><i class="fas fa-user-plus"></i> Create Account</span>
          <span class="spinner"></span>
        </button>
      </form>
      <div class="terms-note">By creating an account you agree to our <a href="/terms-of-service">Terms of Service</a> and <a href="/privacy-policy">Privacy Policy</a>.</div>
    </div>
  </div>
</div>
<script>
function showAlert(msg,type){var b=document.getElementById('alertBox');b.className='alert show alert-'+type;document.getElementById('alertMsg').textContent=msg;b.querySelector('i').className=type==='success'?'fas fa-circle-check':'fas fa-exclamation-circle';b.scrollIntoView({behavior:'smooth',block:'nearest'});}
function hideAlert(){document.getElementById('alertBox').classList.remove('show');}
function fieldErr(id,msg){var e=document.getElementById(id);if(!e)return;if(msg){e.classList.add('show');e.querySelector('span').textContent=msg;}else{e.classList.remove('show');}}
function setLoading(on){var b=document.getElementById('submitBtn');b.classList.toggle('loading',on);b.disabled=on;}
function togglePwd(inputId,btnId){document.getElementById(btnId).addEventListener('click',function(){var i=document.getElementById(inputId),ic=this.querySelector('i');i.type=i.type==='password'?'text':'password';ic.className=i.type==='password'?'fas fa-eye':'fas fa-eye-slash';});}
togglePwd('password','togglePwd');
togglePwd('confirmPassword','toggleConfirm');
document.getElementById('password').addEventListener('input',function(){
  var v=this.value,f=document.getElementById('strengthFill'),l=document.getElementById('strengthLabel');
  var score=0;
  if(v.length>=8)score++;if(v.length>=12)score++;if(/[A-Z]/.test(v))score++;if(/[0-9]/.test(v))score++;if(/[^A-Za-z0-9]/.test(v))score++;
  var pct=[0,25,50,75,100][Math.min(score,4)];
  var colors=['','#ef4444','#f97316','#eab308','#22c55e'];
  var labels=['','Weak','Fair','Good','Strong'];
  f.style.width=pct+'%';f.style.background=colors[Math.max(score,1)]||'';
  l.textContent=v.length?labels[Math.min(score,4)]:'';l.style.color=colors[Math.max(score,1)]||'';
});
document.getElementById('signupForm').addEventListener('submit',async function(e){
  e.preventDefault();hideAlert();
  fieldErr('firstErr','');fieldErr('emailErr','');fieldErr('pwdErr','');fieldErr('confirmErr','');
  var first=document.getElementById('firstName').value.trim();
  var last=document.getElementById('lastName').value.trim();
  var email=document.getElementById('email').value.trim();
  var pwd=document.getElementById('password').value;
  var confirm=document.getElementById('confirmPassword').value;
  var valid=true;
  if(!first){fieldErr('firstErr','First name is required.');valid=false;}
  if(!email||!/^\S+@\S+\.\S+$/.test(email)){fieldErr('emailErr','Please enter a valid email.');valid=false;}
  if(pwd.length<8){fieldErr('pwdErr','Password must be at least 8 characters.');valid=false;}
  if(pwd!==confirm){fieldErr('confirmErr','Passwords do not match.');valid=false;}
  if(!valid)return;
  setLoading(true);
  var username=(first+' '+last).trim();
  try{
    var res=await fetch('/api/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username,email,password:pwd})});
    var data=await res.json();
    if(res.ok&&data.success){
      if(data.needsVerify){
        // Show email verification screen
        document.getElementById('signupForm').closest('form') && (document.getElementById('signupForm').style.display='none');
        document.querySelector('.btn-google') && (document.querySelector('.btn-google').style.display='none');
        document.querySelector('.divider') && (document.querySelector('.divider').style.display='none');
        _resendEmail=data.email||'';
        document.getElementById('verifyEmail').textContent=data.email||'your email';
        document.getElementById('verifyScreen').style.display='block';
        document.querySelector('h1') && (document.querySelector('h1').style.display='none');
        document.querySelector('.sub') && (document.querySelector('.sub').style.display='none');
      } else {
        showAlert('Account created! Redirecting…','success');
        setTimeout(()=>{window.location.href=data.redirect||'/user_dashboard';},900);
      }
    } else {showAlert(data.message||'Registration failed. Please try again.','error');}
  }catch(err){showAlert('Network error. Please try again.','error');}
  finally{setLoading(false);}
});
var GID='{{googleClientId}}';
document.getElementById('googleBtn').addEventListener('click',function(){
  if(!GID||GID===''){showAlert('Google Sign-In is not configured.','error');return;}
  if(typeof google==='undefined'){showAlert('Google Sign-In failed to load. Please refresh.','error');return;}
  google.accounts.id.initialize({client_id:GID,callback:handleGoogle,auto_select:false});
  google.accounts.id.prompt();
});
async function handleGoogle(response){
  setLoading(true);
  try{
    var res=await fetch('/api/auth/google',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({credential:response.credential})});
    var data=await res.json();
    if(res.ok&&data.success){window.location.href=data.redirect||'/user_dashboard';}
    else{showAlert(data.message||'Google Sign-In failed.','error');}
  }catch(err){showAlert('Google error. Please try again.','error');}
  finally{setLoading(false);}
}

// Resend verification email
var _resendEmail='';
document.getElementById('resendBtn') && document.getElementById('resendBtn').addEventListener('click',async function(){
  var email=_resendEmail||document.getElementById('verifyEmail').textContent;
  if(!email)return;
  this.disabled=true;this.textContent='Sending…';
  var msg=document.getElementById('resendMsg');
  try{
    var r=await fetch('/api/resend-verification',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email})});
    var d=await r.json();
    msg.textContent=d.message||'Sent!';msg.style.display='block';msg.style.color=d.success?'#059669':'#e11d48';
  }catch(e){msg.textContent='Network error. Try again.';msg.style.display='block';msg.style.color='#e11d48';}
  setTimeout(()=>{this.disabled=false;this.textContent='resend verification email';},30000);
});
</script>
