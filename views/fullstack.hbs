.btn-cta-white:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(0,0,0,.25)}
.btn-cta-ghost{background:rgba(255,255,255,.1);color:#fff;font-weight:700;border-radius:var(--r-pill);padding:13px 26px;font-size:.9rem;font-family:'DM Sans',sans-serif;display:inline-flex;align-items:center;gap:7px;transition:var(--t);border:1.5px solid rgba(255,255,255,.28);backdrop-filter:blur(8px);text-decoration:none}
