.nl-form{position:relative;display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.nl-form-inp{flex:1;min-width:0;padding:12px 16px 12px 42px;border:1.5px solid var(--mist);border-radius:var(--r-pill);font-size:15px;font-family:'DM Sans',sans-serif;transition:var(--t);background:#fff;color:var(--ink);outline:none}
body.dark .nl-form-inp{background:var(--ink-3);border-color:rgba(255,255,255,.1);color:#fff}
.nl-form-inp:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,79,214,.08)}
.nl-form .nl-ico{position:absolute;left:15px;color:var(--slate-l);font-size:.86rem;pointer-events:none;top:50%;transform:translateY(-50%)}
.nl-submit{background:var(--g-blue);color:#fff;border:none;padding:12px 20px;border-radius:var(--r-pill);font-weight:700;font-size:.82rem;font-family:'DM Sans',sans-serif;transition:var(--t);cursor:pointer;white-space:nowrap;flex-shrink:0}
