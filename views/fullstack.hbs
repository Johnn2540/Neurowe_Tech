  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<style>
/* ── DESIGN TOKENS ── */
:root{
  --blue:#1a4fd6;--blue-d:#1340b0;--blue-l:#4a7aee;
  --blue-pale:rgba(26,79,214,.08);--blue-pale2:rgba(26,79,214,.14);
  --orange:#e8620a;--orange-d:#c94f05;--orange-l:#f28840;
  --orange-pale:rgba(232,98,10,.08);
  --black:#050810;--ink:#0c1220;--ink-2:#141c30;--ink-3:#1c2840;
  --slate:#5a6880;--slate-l:#7a8ea8;
  --mist:#e2e8f5;--ghost:#f5f7fd;
  --emerald:#059669;--teal:#0d9488;--yellow:#f59e0b;--rose:#e11d48;
  --cyan:#06b6d4;--violet:#7c3aed;
  --g-blue:linear-gradient(135deg,#1a4fd6,#1340b0);
  --g-orange:linear-gradient(135deg,#e8620a,#c94f05);
  --g-hero:linear-gradient(168deg,#030610 0%,#07102a 50%,#0b1535 100%);
  --g-fs:linear-gradient(135deg,#1a4fd6 0%,#0d9488 100%);
  --g-fs-warm:linear-gradient(135deg,#1a4fd6,#7c3aed);
  --r-xs:6px;--r-sm:10px;--r-md:14px;--r-lg:18px;--r-xl:24px;--r-2xl:32px;--r-pill:999px;
  --nav-h:66px;
  --ease:cubic-bezier(.4,0,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);--t:.26s var(--ease);
  --sh-sm:0 1px 4px rgba(8,12,24,.06),0 4px 12px rgba(8,12,24,.06);
  --sh-md:0 4px 16px rgba(8,12,24,.08),0 12px 36px rgba(8,12,24,.08);
  --sh-lg:0 12px 40px rgba(8,12,24,.12),0 4px 12px rgba(8,12,24,.06);
  --sh-blue:0 8px 28px rgba(26,79,214,.28);
  --sh-orange:0 8px 28px rgba(232,98,10,.26);
}

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{font-family:'DM Sans',sans-serif;background:var(--ghost);color:var(--ink);overflow-x:hidden;line-height:1.65}
h1,h2,h3,h4,h5{font-family:'Instrument Serif',Georgia,serif;line-height:1.15;font-weight:400}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
button,input,select,textarea{font-family:'DM Sans',sans-serif}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:rgba(37,99,235,.3);border-radius:4px}::-webkit-scrollbar-thumb:hover{background:var(--blue)}

#scroll-progress{position:fixed;top:0;left:0;height:2px;width:0%;background:var(--g-fs);z-index:9999;transition:width .08s linear}

/* ── NAVBAR ── */
.navbar{position:fixed;top:0;left:0;right:0;z-index:1040;height:var(--nav-h);background:rgba(255,255,255,.95);backdrop-filter:blur(24px) saturate(2);border-bottom:1px solid rgba(8,12,24,.06);transition:var(--t)}
.navbar.scrolled{background:rgba(255,255,255,.98);box-shadow:0 2px 24px rgba(8,12,24,.07)}
.nav-inner{max-width:1320px;margin:0 auto;padding:0 24px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}
.nav-brand{font-family:var(--font-display);font-size:1.2rem;font-weight:700;color:var(--ink);flex-shrink:0;letter-spacing:-.04em;display:flex;align-items:center;gap:7px}
.brand-mark{width:30px;height:30px;background:var(--g-blue);border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-family:'Instrument Serif',Georgia,serif;font-weight:700;font-size:.85rem;color:#fff;flex-shrink:0}
.nav-brand em{font-style:italic;color:var(--orange)}
.nav-links{display:none;align-items:center;gap:2px;list-style:none;flex:1;justify-content:center}
.nl-item{position:relative}
.nl-a{font-size:.82rem;font-weight:600;color:var(--slate);padding:7px 12px;border-radius:var(--r-sm);transition:var(--t);white-space:nowrap;display:flex;align-items:center;gap:5px}
.nl-a:hover,.nl-a.active{color:var(--blue);background:var(--blue-pale)}
.nl-a .chev{font-size:.52rem;transition:transform .22s}
.nl-item:hover .chev{transform:rotate(180deg)}
.mega-drop{position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%) translateY(8px);min-width:540px;background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);box-shadow:0 24px 64px rgba(8,12,24,.14);padding:22px;opacity:0;visibility:hidden;pointer-events:none;transition:all .2s var(--ease)}
.nl-item:hover .mega-drop{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0)}
.mega-drop::before{content:'';position:absolute;top:-5px;left:50%;width:10px;height:10px;background:#fff;border-left:1px solid var(--mist);border-top:1px solid var(--mist);transform:translateX(-50%) rotate(45deg)}
.mega-grid{display:grid;grid-template-columns:1fr 1fr 1fr}
.mega-col-label{font-size:.61rem;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--blue);padding:0 8px 8px;display:block}
.mega-link{display:flex;align-items:center;gap:7px;padding:7px 10px;border-radius:var(--r-sm);font-size:.79rem;font-weight:500;color:var(--slate);transition:all .14s}
.mega-link i{width:15px;color:var(--blue);font-size:.74rem;flex-shrink:0}
.mega-link:hover{background:var(--blue-pale);color:var(--blue);transform:translateX(2px)}
.nav-cta{display:none;align-items:center;gap:8px;flex-shrink:0}
.user-drop{position:relative}
.user-btn{display:inline-flex;align-items:center;gap:6px;background:var(--g-blue);color:#fff;border:none;padding:7px 16px;border-radius:var(--r-pill);font-size:.79rem;font-weight:700;cursor:pointer;transition:var(--t);font-family:'DM Sans',sans-serif}
.user-btn:hover{transform:translateY(-1px);box-shadow:var(--sh-blue)}
.user-btn .chev-u{font-size:.5rem;transition:transform .22s}
.user-drop:hover .chev-u{transform:rotate(180deg)}
.user-menu{position:absolute;top:calc(100% + 10px);right:0;min-width:200px;background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);box-shadow:var(--sh-md);padding:8px;opacity:0;visibility:hidden;pointer-events:none;transition:all .2s var(--ease)}
.user-drop:hover .user-menu{opacity:1;visibility:visible;pointer-events:auto}
.user-menu a{display:flex;align-items:center;gap:9px;padding:9px 12px;border-radius:var(--r-sm);font-size:.81rem;font-weight:600;color:var(--slate);transition:var(--t)}
.user-menu a i{width:15px;color:var(--blue);font-size:.75rem}
.user-menu a:hover{background:var(--blue-pale);color:var(--blue)}
.user-menu-divider{border:none;border-top:1px solid var(--mist);margin:5px 0}
.btn-nav-signin{font-size:.79rem;font-weight:600;color:var(--slate);padding:7px 15px;border:1.5px solid var(--mist);border-radius:var(--r-pill);background:#fff;cursor:pointer;transition:var(--t)}
.btn-nav-signin:hover{color:var(--blue);border-color:var(--blue)}
.btn-nav-signup{font-size:.79rem;font-weight:700;color:#fff;padding:8px 19px;border:none;border-radius:var(--r-pill);background:var(--g-blue);cursor:pointer;box-shadow:var(--sh-blue);display:inline-flex;align-items:center;gap:5px;transition:var(--t)}
.btn-nav-signup:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(26,79,214,.38)}
.ham-btn{display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;width:44px;height:44px;background:none;border:none;cursor:pointer;border-radius:var(--r-sm);transition:var(--t);flex-shrink:0}
.ham-btn:hover{background:var(--blue-pale)}
.ham-line{display:block;width:20px;height:1.5px;background:var(--ink);border-radius:2px;transition:all .24s var(--ease);transform-origin:center}
.ham-btn.open .ham-line:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.ham-btn.open .ham-line:nth-child(2){opacity:0;transform:scaleX(0)}
.ham-btn.open .ham-line:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.mob-quick{display:flex;align-items:center;gap:6px;flex-shrink:0}
.mob-quick-btn{width:38px;height:38px;border-radius:var(--r-sm);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:var(--t);background:var(--blue-pale);color:var(--blue)}
.mob-overlay{position:fixed;inset:0;background:rgba(8,12,24,.55);backdrop-filter:blur(6px);z-index:1038;opacity:0;visibility:hidden;transition:opacity .28s,visibility .28s}
.mob-overlay.open{opacity:1;visibility:visible}
.mob-panel{position:fixed;top:0;right:0;width:min(340px,88vw);height:100dvh;background:#fff;z-index:1039;overflow-y:auto;transform:translateX(100%);transition:transform .3s var(--ease);box-shadow:-12px 0 48px rgba(8,12,24,.18);display:flex;flex-direction:column}
.mob-panel.open{transform:translateX(0)}
.mob-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--mist);flex-shrink:0}
.mob-close{width:36px;height:36px;border:none;background:var(--mist);cursor:pointer;border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;transition:var(--t);font-size:.82rem}
.mob-close:hover{background:#ef4444;color:#fff}
.mob-body{padding:8px 0;flex:1}
.mob-link{display:flex;align-items:center;gap:11px;padding:12px 22px;font-size:.88rem;font-weight:600;color:var(--ink);transition:var(--t);min-height:48px}
.mob-link i{width:18px;color:var(--blue);font-size:.8rem;flex-shrink:0}
.mob-link:hover,.mob-link.cur{background:var(--blue-pale);color:var(--blue);padding-left:28px}
.mob-hr{border:none;border-top:1px solid var(--mist);margin:6px 18px}
.mob-footer{padding:14px 18px 30px;border-top:1px solid var(--mist);display:flex;flex-direction:column;gap:9px}

/* ── DARK MODE ── */
body.dark{background:var(--black);color:rgba(255,255,255,.84)}
body.dark .navbar{background:rgba(8,12,24,.97);border-bottom-color:rgba(255,255,255,.05)}
body.dark .navbar.scrolled{background:rgba(8,12,24,.99)}
body.dark .nl-a{color:rgba(255,255,255,.52)}
body.dark .nl-a:hover{color:var(--blue-l);background:rgba(26,79,214,.1)}
body.dark .mega-drop{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-drop::before{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .mega-link{color:rgba(255,255,255,.52)}
body.dark .ham-line{background:rgba(255,255,255,.85)}
body.dark .mob-panel{background:var(--ink-2)}
body.dark .mob-head{border-color:rgba(255,255,255,.07)}
body.dark .mob-link{color:rgba(255,255,255,.82)}
body.dark .mob-close{background:rgba(255,255,255,.07);color:rgba(255,255,255,.7)}
body.dark .mob-hr{border-color:rgba(255,255,255,.07)}
body.dark .mob-footer{border-color:rgba(255,255,255,.07)}
body.dark .btn-nav-signin{color:rgba(255,255,255,.52);border-color:rgba(255,255,255,.1);background:transparent}
body.dark #theme-toggle{background:var(--ink-2);border-color:rgba(255,255,255,.09)}
body.dark #theme-toggle svg{stroke:rgba(255,255,255,.72)}
body.dark .user-menu{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
body.dark .user-menu a{color:rgba(255,255,255,.65)}
body.dark .user-menu-divider{border-color:rgba(255,255,255,.07)}

/* ── UTILITIES ── */
.container{max-width:1320px;margin:0 auto;padding:0 24px}
.section-py{padding:80px 0}
.section-py-sm{padding:56px 0}
.text-center{text-align:center}
.g-blue{background:var(--g-blue);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-orange{background:var(--g-orange);-webkit-background-clip:text;background-clip:text;color:transparent}
.g-fs{background:var(--g-fs);-webkit-background-clip:text;background-clip:text;color:transparent}
.section-kicker{display:inline-flex;align-items:center;gap:7px;border-radius:var(--r-pill);padding:5px 14px;font-size:.67rem;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;margin-bottom:14px;border:1px solid rgba(26,79,214,.15);background:var(--blue-pale);color:var(--blue)}
.section-kicker::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--blue);flex-shrink:0}
.section-kicker.orange{background:var(--orange-pale);color:var(--orange);border-color:rgba(232,98,10,.15)}
.section-kicker.orange::before{background:var(--orange)}
.section-kicker.teal{background:rgba(13,148,136,.08);color:var(--teal);border-color:rgba(13,148,136,.2)}
.section-kicker.teal::before{background:var(--teal)}
.section-title{font-size:clamp(1.75rem,5vw,3rem);font-weight:400;margin-bottom:14px;line-height:1.15}
.section-body{color:var(--slate);font-size:clamp(.9rem,2.5vw,1.04rem);line-height:1.78;max-width:540px}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font-family:'DM Sans',sans-serif;font-weight:700;font-size:.86rem;border-radius:var(--r-pill);transition:var(--t);cursor:pointer;border:none;letter-spacing:.01em;white-space:nowrap}
.btn-primary{background:var(--g-blue);color:#fff;padding:12px 26px;box-shadow:var(--sh-blue)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(26,79,214,.36)}
.btn-orange{background:var(--g-orange);color:#fff;padding:12px 26px;box-shadow:var(--sh-orange)}
.btn-orange:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(232,98,10,.36)}
.btn-teal{background:linear-gradient(135deg,#0d9488,#0f766e);color:#fff;padding:12px 26px;box-shadow:0 8px 28px rgba(13,148,136,.28)}
.btn-teal:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(13,148,136,.38)}
.btn-outline{background:transparent;color:var(--blue);padding:10px 22px;border:1.5px solid var(--blue)}
.btn-outline:hover{background:var(--g-blue);color:#fff;transform:translateY(-2px)}
.btn-ghost{background:rgba(255,255,255,.1);color:#fff;padding:11px 22px;border:1.5px solid rgba(255,255,255,.25);backdrop-filter:blur(8px)}
.btn-ghost:hover{background:rgba(255,255,255,.18);transform:translateY(-2px)}
.btn-sm{padding:8px 18px;font-size:.78rem}
.btn-lg{padding:14px 32px;font-size:.95rem}

/* ── ANIMATIONS ── */
@keyframes dot-p{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.45);opacity:.5}}
@keyframes wa-ripple{0%{transform:scale(1);opacity:.65}100%{transform:scale(2);opacity:0}}
@keyframes bounce-up{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-8px)}}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes fade-up{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes bar-shift{0%{background-position:0%}100%{background-position:200%}}
@keyframes type-cursor{0%,100%{opacity:1}50%{opacity:0}}
@keyframes code-scan{0%{top:0}100%{top:100%}}
@keyframes pulse-ring{0%{transform:scale(1);opacity:.6}100%{transform:scale(1.5);opacity:0}}

/* ── FIXED WIDGETS ── */
#theme-toggle{position:fixed;bottom:22px;left:22px;z-index:10000;width:44px;height:44px;background:#fff;border:1.5px solid rgba(8,12,24,.08);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 18px rgba(8,12,24,.1);transition:var(--t)}
#theme-toggle svg{width:16px;height:16px;stroke:var(--slate);stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round}
#theme-toggle:hover{background:var(--blue);border-color:var(--blue);transform:rotate(20deg) scale(1.07)}
#theme-toggle:hover svg{stroke:#fff}
#back-to-top{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(16px);z-index:10000;width:48px;height:48px;background:var(--g-blue);border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .3s,transform .4s var(--spring);box-shadow:var(--sh-blue)}
#back-to-top.visible{opacity:1;transform:translateX(-50%) translateY(0);pointer-events:auto;animation:bounce-up 2.4s ease-in-out infinite}
#back-to-top:hover{animation-play-state:paused}
#back-to-top svg{width:18px;height:18px;stroke:#fff;stroke-width:2.6;fill:none;stroke-linecap:round;stroke-linejoin:round}
#wa-float{position:fixed;bottom:86px;right:20px;z-index:10001;text-decoration:none;display:block}
.wa-ring{position:absolute;inset:0;border-radius:999px;border:2px solid #25D366;opacity:0;animation:wa-ripple 2.8s ease-out infinite;pointer-events:none}
.wa-ring:nth-child(2){animation-delay:1.2s}
.wa-pill{display:flex;align-items:center;gap:9px;background:linear-gradient(135deg,#128C7E,#075E54);border-radius:999px;padding:8px 17px 8px 8px;box-shadow:0 6px 26px rgba(18,140,126,.42);transition:transform .3s var(--spring),box-shadow .28s;white-space:nowrap}
#wa-float:hover .wa-pill{transform:translateY(-3px) scale(1.02)}
.wa-ico{width:36px;height:36px;flex-shrink:0;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.15rem;color:#fff;position:relative}
.wa-dot{position:absolute;top:1px;right:1px;width:9px;height:9px;background:#a8ff78;border:2px solid #128C7E;border-radius:50%;animation:dot-p 2.4s ease-in-out infinite}
.wa-text{display:flex;flex-direction:column;gap:1px}
.wa-label{font-size:.64rem;color:rgba(255,255,255,.55);font-weight:600}
.wa-cta{font-size:.88rem;color:#fff;font-weight:800;font-family:'Instrument Serif',Georgia,serif}
.wa-arr{color:rgba(255,255,255,.6);font-size:.68rem;margin-left:2px;transition:transform .2s}
#wa-float:hover .wa-arr{transform:translateX(3px)}
#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--ink-2);color:#fff;border-radius:var(--r-md);padding:11px 17px;font-size:.82rem;display:flex;align-items:center;gap:8px;z-index:10002;opacity:0;transition:var(--t);border-left:3px solid var(--emerald);min-width:210px;max-width:calc(100vw - 40px)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#cookie-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ink-2);color:rgba(255,255,255,.8);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;z-index:9998;transform:translateY(100%);transition:transform .38s;border-top:1px solid rgba(255,255,255,.06);flex-wrap:wrap}
#cookie-bar.show{transform:translateY(0)}
#cookie-bar p{font-size:.77rem;margin:0;flex:1;min-width:180px}
#cookie-accept{background:var(--blue);color:#fff;border:none;padding:7px 18px;border-radius:var(--r-pill);font-size:.79rem;cursor:pointer;font-weight:700;transition:var(--t)}
#cookie-accept:hover{background:var(--blue-d)}
@media(max-width:767px){
  #wa-float{bottom:74px;right:14px}
  .wa-text,.wa-arr{display:none}
  .wa-pill{padding:0;width:52px;height:52px;border-radius:50%;justify-content:center}
  .wa-ico{width:52px;height:52px;font-size:1.4rem}
  #theme-toggle{bottom:14px;left:14px;width:40px;height:40px}
  #back-to-top{bottom:12px;width:46px;height:46px}
}

/* ════════════════════════════════
   HERO
════════════════════════════════ */
.hero-fs{background:var(--g-hero);padding-top:var(--nav-h);position:relative;overflow:hidden}
.hero-fs::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(26,79,214,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(26,79,214,.05) 1px,transparent 1px);background-size:44px 44px}
.orb-1{position:absolute;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,rgba(26,79,214,.18) 0%,transparent 68%);top:-120px;right:-80px;pointer-events:none}
.orb-2{position:absolute;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(13,148,136,.12) 0%,transparent 70%);bottom:-40px;left:-20px;pointer-events:none}
.orb-3{position:absolute;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,.1) 0%,transparent 70%);top:38%;left:44%;pointer-events:none}

.hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr;gap:40px;padding:64px 0 72px;align-items:center}
.hero-eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.hero-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:var(--r-pill);padding:5px 13px;color:rgba(255,255,255,.75);font-size:.72rem;font-weight:700;backdrop-filter:blur(8px)}
.hero-badge .dot{width:6px;height:6px;border-radius:50%;background:#34d399;animation:dot-p 2s infinite;flex-shrink:0}
.premium-chip{display:inline-flex;align-items:center;gap:5px;background:linear-gradient(135deg,rgba(245,158,11,.2),rgba(232,98,10,.2));border:1px solid rgba(245,158,11,.3);border-radius:var(--r-pill);padding:5px 13px;color:#fbbf24;font-size:.72rem;font-weight:800}

.hero-inner h1{font-size:clamp(2.2rem,6.5vw,4.4rem);font-weight:700;color:#fff;margin-bottom:14px;line-height:1.04}
.hero-inner h1 em{font-style:italic;background:var(--g-fs);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-desc{color:rgba(255,255,255,.58);font-size:clamp(.9rem,2.4vw,1.06rem);line-height:1.78;max-width:500px;margin-bottom:28px}

/* outcome pills */
.outcome-pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}
.op{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-pill);padding:5px 13px;font-size:.75rem;font-weight:600;color:rgba(255,255,255,.76)}
.op i{font-size:.68rem;color:#34d399}

.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:36px}

/* hero meta strip */
.hero-meta{display:flex;flex-wrap:wrap;gap:18px;padding-top:20px;border-top:1px solid rgba(255,255,255,.08)}
.hm-item{display:flex;align-items:center;gap:7px;font-size:.78rem;color:rgba(255,255,255,.55);font-weight:600}
.hm-item i{color:rgba(255,255,255,.35);font-size:.72rem;width:14px}
.hm-item strong{color:rgba(255,255,255,.82)}

/* hero right — browser mockup */
.browser-frame{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-xl);overflow:hidden;backdrop-filter:blur(16px)}
.browser-bar{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid rgba(255,255,255,.07)}
.b-dots{display:flex;gap:6px}
.b-dot{width:10px;height:10px;border-radius:50%}
.b-dot.r{background:#ff5f57}.b-dot.y{background:#febc2e}.b-dot.g{background:#28c840}
.b-url{flex:1;background:rgba(255,255,255,.08);border-radius:6px;padding:4px 12px;font-size:.7rem;color:rgba(255,255,255,.38);font-family:'Courier New',monospace;margin:0 8px}
.browser-body{padding:0;position:relative;overflow:hidden}
.browser-preview{width:100%;display:block;min-height:200px;background:linear-gradient(145deg,#0f172a,#1e293b)}
.preview-nav{display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-bottom:1px solid rgba(255,255,255,.06)}
.preview-logo{font-family:'Instrument Serif',Georgia,serif;font-size:.88rem;font-weight:700;color:#fff}
.preview-links{display:flex;gap:14px}
.preview-link{width:28px;height:5px;background:rgba(255,255,255,.12);border-radius:3px}
.preview-hero-mini{padding:24px 18px}
.ph-tag{width:60px;height:5px;background:rgba(26,79,214,.5);border-radius:3px;margin-bottom:10px}
.ph-h1{width:85%;height:10px;background:rgba(255,255,255,.22);border-radius:4px;margin-bottom:7px}
.ph-h2{width:60%;height:7px;background:rgba(255,255,255,.12);border-radius:3px;margin-bottom:20px}
.ph-btns{display:flex;gap:8px}
.ph-btn{height:26px;border-radius:13px}
.ph-btn.p{width:90px;background:var(--g-blue)}
.ph-btn.s{width:74px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15)}
.preview-stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:0 18px 18px}
.psr{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:10px 8px;text-align:center}
.psr-val{width:28px;height:8px;background:var(--g-fs);border-radius:3px;margin:0 auto 5px}
.psr-lbl{width:36px;height:4px;background:rgba(255,255,255,.1);border-radius:2px;margin:0 auto}
/* scan line effect */
.scan-line{position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(26,79,214,.4),transparent);animation:code-scan 3s linear infinite;pointer-events:none}

/* ════════════════════════════════
   MARQUEE
════════════════════════════════ */
.marquee-wrap{background:var(--g-fs);padding:11px 0;overflow:hidden;white-space:nowrap}
.marquee-track{display:inline-flex;animation:marquee 32s linear infinite}
.marquee-track:hover{animation-play-state:paused}
.marquee-item{display:inline-flex;align-items:center;gap:7px;padding:0 24px;color:rgba(255,255,255,.9);font-size:.81rem;font-weight:700}
.marquee-sep{opacity:.3}

/* ════════════════════════════════
   WHAT YOU'LL BUILD
════════════════════════════════ */
.build-grid{display:grid;grid-template-columns:1fr;gap:22px}
@media(min-width:640px){.build-grid{grid-template-columns:repeat(3,1fr)}}

.build-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);overflow:hidden;transition:var(--t);box-shadow:var(--sh-sm);position:relative}
body.dark .build-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.build-card:hover{transform:translateY(-6px);box-shadow:var(--sh-lg)}
.bc-thumb{height:160px;position:relative;overflow:hidden}
.bc-thumb img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.build-card:hover .bc-thumb img{transform:scale(1.05)}
.bc-thumb-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2.8rem;position:relative;overflow:hidden}
.bc-thumb-placeholder::before{content:'';position:absolute;inset:0}
.bc-th-1::before{background:linear-gradient(135deg,#0f172a,#1e3a5f)}
.bc-th-2::before{background:linear-gradient(135deg,#0c1a14,#064e3b)}
.bc-th-3::before{background:linear-gradient(135deg,#1a0530,#3b0764)}
.bc-num{position:absolute;top:10px;left:12px;background:rgba(8,12,24,.72);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-pill);padding:3px 10px;font-size:.67rem;font-weight:800;color:rgba(255,255,255,.7);backdrop-filter:blur(8px)}
.bc-stack{position:absolute;bottom:10px;left:12px;display:flex;gap:5px;flex-wrap:wrap}
.bc-tag{background:rgba(8,12,24,.72);border:1px solid rgba(255,255,255,.12);border-radius:var(--r-pill);padding:2px 8px;font-size:.62rem;font-weight:800;color:rgba(255,255,255,.7);backdrop-filter:blur(8px)}
.bc-body{padding:18px 20px}
.bc-title{font-size:1rem;font-weight:700;font-family:'Instrument Serif',Georgia,serif;color:var(--ink);margin-bottom:6px}
body.dark .bc-title{color:rgba(255,255,255,.9)}
.bc-desc{font-size:.79rem;color:var(--slate);line-height:1.62}
body.dark .bc-desc{color:rgba(255,255,255,.48)}

/* ════════════════════════════════
   CURRICULUM
════════════════════════════════ */
.curriculum-wrap{display:grid;grid-template-columns:1fr;gap:14px}

.module-card{background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);overflow:hidden;transition:border-color .22s;box-shadow:var(--sh-sm)}
body.dark .module-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.module-card.open{border-color:var(--blue)}
.module-head{display:flex;align-items:center;gap:14px;padding:18px 22px;cursor:pointer;user-select:none}
.module-num{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.82rem;font-weight:800;color:#fff;flex-shrink:0}
.mn-1{background:linear-gradient(135deg,#1a4fd6,#4a7aee)}
.mn-2{background:linear-gradient(135deg,#0d9488,#14b8a6)}
.mn-3{background:linear-gradient(135deg,#7c3aed,#a78bfa)}
.mn-4{background:linear-gradient(135deg,#059669,#10b981)}
.mn-5{background:linear-gradient(135deg,#e8620a,#f28840)}
.module-info{flex:1}
.module-title{font-size:.92rem;font-weight:700;color:var(--ink);font-family:'DM Sans',sans-serif;margin-bottom:2px}
body.dark .module-title{color:rgba(255,255,255,.88)}
.module-subtitle{font-size:.73rem;color:var(--slate);display:flex;align-items:center;gap:8px}
body.dark .module-subtitle{color:rgba(255,255,255,.4)}
.module-subtitle span{display:flex;align-items:center;gap:4px}
.module-icon{width:22px;height:22px;flex-shrink:0;background:var(--blue-pale);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:.58rem;transition:transform .24s,background .22s}
.module-card.open .module-icon{transform:rotate(180deg);background:var(--blue);color:#fff}
.module-body{max-height:0;overflow:hidden;transition:max-height .35s ease}
.module-card.open .module-body{max-height:500px}
.module-lessons{padding:0 22px 18px;display:grid;grid-template-columns:1fr;gap:6px}
@media(min-width:640px){.module-lessons{grid-template-columns:1fr 1fr}}
.lesson-row{display:flex;align-items:center;gap:9px;padding:8px 12px;background:var(--ghost);border-radius:var(--r-sm);font-size:.78rem;color:var(--slate)}
body.dark .lesson-row{background:var(--ink-3);color:rgba(255,255,255,.5)}
.lesson-row i{width:14px;color:var(--blue-l);font-size:.7rem;flex-shrink:0}
body.dark .lesson-row i{color:var(--blue-l)}

/* ════════════════════════════════
   TECH STACK
════════════════════════════════ */
.stack-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media(min-width:480px){.stack-grid{grid-template-columns:repeat(4,1fr)}}
@media(min-width:768px){.stack-grid{grid-template-columns:repeat(6,1fr)}}
@media(min-width:1024px){.stack-grid{grid-template-columns:repeat(8,1fr)}}

.stack-item{background:#fff;border:1px solid var(--mist);border-radius:var(--r-xl);padding:18px 12px;text-align:center;transition:var(--t);box-shadow:var(--sh-sm);cursor:default}
body.dark .stack-item{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.stack-item:hover{transform:translateY(-4px);box-shadow:var(--sh-lg);border-color:rgba(26,79,214,.2)}
.stack-icon{font-size:1.8rem;margin-bottom:8px;line-height:1;display:block;transition:transform .28s}
.stack-item:hover .stack-icon{transform:scale(1.15) rotate(-4deg)}
.stack-name{font-size:.68rem;font-weight:700;color:var(--slate)}
body.dark .stack-name{color:rgba(255,255,255,.48)}

/* ════════════════════════════════
   WHO IT'S FOR
════════════════════════════════ */
.who-grid{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:640px){.who-grid{grid-template-columns:1fr 1fr}}

.who-card{display:flex;align-items:flex-start;gap:14px;background:#fff;border-radius:var(--r-xl);border:1px solid var(--mist);padding:20px;box-shadow:var(--sh-sm);transition:var(--t)}
body.dark .who-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.who-card:hover{transform:translateY(-3px);box-shadow:var(--sh-lg)}
.who-icon{width:42px;height:42px;flex-shrink:0;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.15rem}
.wi-a{background:rgba(26,79,214,.1);border:1px solid rgba(26,79,214,.18)}
.wi-b{background:rgba(13,148,136,.1);border:1px solid rgba(13,148,136,.18)}
.wi-c{background:rgba(124,58,237,.1);border:1px solid rgba(124,58,237,.18)}
.wi-d{background:rgba(232,98,10,.1);border:1px solid rgba(232,98,10,.18)}
.who-text h5{font-size:.88rem;font-weight:700;font-family:'DM Sans',sans-serif;color:var(--ink);margin-bottom:4px}
body.dark .who-text h5{color:rgba(255,255,255,.88)}
.who-text p{font-size:.77rem;color:var(--slate);line-height:1.6}
body.dark .who-text p{color:rgba(255,255,255,.45)}

/* ════════════════════════════════
   INSTRUCTOR SECTION
════════════════════════════════ */
.instructor-strip{background:linear-gradient(135deg,#0c1630,#101f40);border-radius:var(--r-2xl);padding:44px 40px;display:grid;grid-template-columns:1fr;gap:32px;align-items:center;position:relative;overflow:hidden}
@media(min-width:768px){.instructor-strip{grid-template-columns:auto 1fr}}
.instructor-strip::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);background-size:40px 40px}
.instr-avatar-wrap{position:relative;z-index:1;flex-shrink:0}
.instr-avatar{width:110px;height:110px;border-radius:50%;background:var(--g-fs);display:flex;align-items:center;justify-content:center;font-family:'Instrument Serif',Georgia,serif;font-size:2.4rem;font-weight:700;color:#fff;border:3px solid rgba(255,255,255,.18);box-shadow:0 0 0 6px rgba(26,79,214,.2)}
.instr-ring{position:absolute;inset:-8px;border-radius:50%;border:2px dashed rgba(255,255,255,.1);animation:spin-slow 20s linear infinite}
@keyframes spin-slow{from{transform:rotate(0)}to{transform:rotate(360deg)}}
.instr-content{position:relative;z-index:1}
.instr-name{font-size:1.3rem;font-weight:700;color:#fff;margin-bottom:3px;font-family:'Instrument Serif',Georgia,serif}
.instr-role{font-size:.78rem;color:rgba(255,255,255,.5);margin-bottom:14px;font-weight:600}
.instr-bio{font-size:.82rem;color:rgba(255,255,255,.6);line-height:1.72;margin-bottom:18px;max-width:540px}
.instr-stats{display:flex;flex-wrap:wrap;gap:18px}
.is-stat{display:flex;align-items:center;gap:7px;font-size:.76rem;color:rgba(255,255,255,.55);font-weight:600}
.is-stat i{color:rgba(255,255,255,.35);font-size:.7rem}
.is-stat strong{color:rgba(255,255,255,.82)}

/* ════════════════════════════════
   TESTIMONIALS
════════════════════════════════ */
.testimonials-grid{display:grid;grid-template-columns:1fr;gap:18px}
@media(min-width:640px){.testimonials-grid{grid-template-columns:repeat(3,1fr)}}

.t-card{background:#fff;border-radius:var(--r-xl);padding:26px 22px;border:1px solid var(--mist);transition:var(--t);display:flex;flex-direction:column;box-shadow:var(--sh-sm);position:relative;overflow:hidden}
body.dark .t-card{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.t-card::before{content:'"';position:absolute;top:-8px;left:16px;font-family:'Instrument Serif',Georgia,serif;font-size:7rem;color:var(--blue-pale);line-height:1;pointer-events:none}
.t-card:hover{transform:translateY(-4px);box-shadow:var(--sh-lg)}
.t-stars{color:var(--yellow);letter-spacing:1px;margin-bottom:10px;font-size:.9rem}
.t-quote{font-style:italic;color:var(--slate);line-height:1.78;font-size:.83rem;flex-grow:1;margin-bottom:16px;position:relative;z-index:1}
body.dark .t-quote{color:rgba(255,255,255,.5)}
.t-author{display:flex;align-items:center;gap:11px}
.t-ava{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.t-name{font-weight:700;font-size:.84rem;font-family:'Instrument Serif',Georgia,serif;color:var(--ink)}
body.dark .t-name{color:rgba(255,255,255,.88)}
.t-role{font-size:.69rem;color:var(--slate)}
.t-outcome{display:inline-flex;align-items:center;gap:4px;background:rgba(5,150,105,.08);border:1px solid rgba(5,150,105,.18);border-radius:var(--r-pill);padding:3px 9px;font-size:.65rem;font-weight:700;color:var(--emerald);margin-top:8px}

/* ════════════════════════════════
   PRICING CARD
════════════════════════════════ */
.pricing-wrap{display:grid;grid-template-columns:1fr;gap:20px;max-width:860px;margin:0 auto}
@media(min-width:640px){.pricing-wrap{grid-template-columns:1fr 1fr}}

.price-card{background:#fff;border-radius:var(--r-2xl);border:2px solid var(--mist);padding:32px 28px;transition:var(--t);box-shadow:var(--sh-sm);position:relative}
body.dark .price-card{background:var(--ink-2);border-color:rgba(255,255,255,.08)}
.price-card.featured{border-color:var(--blue);box-shadow:var(--sh-blue),var(--sh-md)}
.price-card:hover{transform:translateY(-4px)}
.featured-chip{position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--g-blue);color:#fff;padding:4px 18px;border-radius:0 0 var(--r-md) var(--r-md);font-size:.66rem;font-weight:800;letter-spacing:.5px;white-space:nowrap}
.price-label{font-size:.7rem;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--slate);margin-bottom:10px}
body.dark .price-label{color:rgba(255,255,255,.35)}
.price-amount{display:flex;align-items:baseline;gap:4px;margin-bottom:6px}
.price-val{font-family:'Instrument Serif',Georgia,serif;font-size:2.6rem;font-weight:700;color:var(--ink);line-height:1}
body.dark .price-val{color:#fff}
.price-currency{font-size:.9rem;font-weight:700;color:var(--slate);margin-bottom:4px}
body.dark .price-currency{color:rgba(255,255,255,.5)}
.price-sub{font-size:.74rem;color:var(--slate);margin-bottom:22px}
body.dark .price-sub{color:rgba(255,255,255,.4)}
.price-features{display:flex;flex-direction:column;gap:9px;margin-bottom:24px}
.pf{display:flex;align-items:flex-start;gap:9px;font-size:.8rem;color:var(--slate)}
body.dark .pf{color:rgba(255,255,255,.55)}
.pf i{flex-shrink:0;width:14px;margin-top:2px;font-size:.7rem}
.pf i.ok{color:var(--emerald)}
.pf i.no{color:var(--slate-l);opacity:.5}
.pf.dim{opacity:.5}

/* ════════════════════════════════
   FAQ
════════════════════════════════ */
.faq-grid{display:grid;grid-template-columns:1fr;gap:9px}
@media(min-width:640px){.faq-grid{grid-template-columns:1fr 1fr}}
.faq-item{background:#fff;border-radius:var(--r-lg);border:1px solid var(--mist);overflow:hidden;transition:border-color .22s;box-shadow:var(--sh-sm)}
body.dark .faq-item{background:var(--ink-2);border-color:rgba(255,255,255,.07)}
.faq-item:hover{border-color:var(--blue)}
.faq-item.open{border-color:var(--blue-l)}
.faq-q{padding:15px 18px;font-weight:700;font-size:.84rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-family:'DM Sans',sans-serif;min-height:52px;gap:12px;color:var(--ink)}
body.dark .faq-q{color:rgba(255,255,255,.85)}
.faq-icon{width:20px;height:20px;flex-shrink:0;background:var(--blue-pale);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:.62rem;transition:transform .24s,background .22s}
.faq-item.open .faq-icon{transform:rotate(45deg);background:var(--blue);color:#fff}
.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;color:var(--slate);font-size:.81rem;line-height:1.76}
body.dark .faq-a{color:rgba(255,255,255,.48)}
.faq-item.open .faq-a{max-height:200px;padding:0 18px 14px}

/* ════════════════════════════════
   CTA BAND
════════════════════════════════ */
.cta-band{background:linear-gradient(135deg,var(--blue),var(--blue-d) 45%,#0e2d88);border-radius:var(--r-2xl);padding:60px 44px;text-align:center;position:relative;overflow:hidden}
.cta-band::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:40px 40px}
.cta-band::after{content:'';position:absolute;top:-80px;right:-80px;width:320px;height:320px;background:radial-gradient(circle,rgba(255,255,255,.07) 0%,transparent 70%);border-radius:50%}
.cta-inner{position:relative;z-index:1}
.cta-band h2{font-size:clamp(1.8rem,4.5vw,2.9rem);font-weight:700;color:#fff;margin-bottom:12px}
.cta-band h2 em{font-style:italic;color:rgba(255,255,255,.7)}
.cta-band p{color:rgba(255,255,255,.62);font-size:clamp(.9rem,2vw,1.04rem);line-height:1.76;max-width:480px;margin:0 auto 30px}
.cta-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
