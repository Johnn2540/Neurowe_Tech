<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script>
AOS.init({duration:720,once:true,offset:50,easing:'ease-out-cubic'});

/* CURSOR */
(function(){var dot=document.getElementById('cursor-dot'),ring=document.getElementById('cursor-ring'),lbl=document.getElementById('cursor-label');if(!dot||!ring)return;var mx=window.innerWidth/2,my=window.innerHeight/2,rx=mx,ry=my;document.addEventListener('mouseleave',function(){document.body.classList.add('cursor-hidden');});document.addEventListener('mouseenter',function(){document.body.classList.remove('cursor-hidden');});document.addEventListener('mousedown',function(){document.body.classList.add('cursor-click');});document.addEventListener('mouseup',function(){document.body.classList.remove('cursor-click');});window.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;dot.style.left=mx+'px';dot.style.top=my+'px';},{passive:true});(function loop(){rx+=(mx-rx)*.13;ry+=(my-ry)*.13;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(loop);})();function mode(m,t){document.body.classList.remove('cursor-hover','cursor-view','cursor-text');if(m)document.body.classList.add('cursor-'+m);if(lbl)lbl.textContent=t||'';}document.querySelectorAll('a,button,[role="button"]').forEach(function(el){el.addEventListener('mouseenter',function(){mode('hover','');});el.addEventListener('mouseleave',function(){mode('','');});});document.querySelectorAll('input,textarea,select').forEach(function(el){el.addEventListener('mouseenter',function(){mode('text','');});el.addEventListener('mouseleave',function(){mode('','');});});document.querySelectorAll('.pf-card-wrap').forEach(function(el){el.addEventListener('mouseenter',function(){mode('view','VIEW');});el.addEventListener('mouseleave',function(){mode('','');});});document.querySelectorAll('.btn-primary,.btn-orange,.cta-btn-white,.cta-btn-orange,.btn-nav-start').forEach(function(btn){btn.addEventListener('mousemove',function(e){var r=btn.getBoundingClientRect();btn.style.transform='translate('+(e.clientX-r.left-r.width/2)*.28+'px,'+(e.clientY-r.top-r.height/2)*.28+'px)';});btn.addEventListener('mouseleave',function(){btn.style.transform='';});});})();

/* SCROLL / NAV */
var navbar=document.getElementById('mainNav'),backToTop=document.getElementById('back-to-top'),scrollPrg=document.getElementById('scroll-progress');
window.addEventListener('scroll',function(){var st=window.pageYOffset,docH=document.documentElement.scrollHeight-window.innerHeight;scrollPrg.style.width=(docH>0?(st/docH)*100:0)+'%';navbar.classList.toggle('scrolled',st>40);backToTop.classList.toggle('visible',st>400);},{passive:true});
backToTop.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});

/* MOBILE NAV */
var mobOverlay=document.getElementById('mobOverlay'),mobPanel=document.getElementById('mobPanel'),hamBtn=document.getElementById('hamBtn'),mobClose=document.getElementById('mobClose'),mobSvcToggle=document.getElementById('mobSvcToggle'),mobSvcSub=document.getElementById('mobSvcSub');
function openMob(){mobOverlay.classList.add('open');mobPanel.classList.add('open');hamBtn.classList.add('open');hamBtn.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';mobClose.focus();}
function closeMob(){mobPanel.classList.remove('open');mobOverlay.classList.remove('open');hamBtn.classList.remove('open');hamBtn.setAttribute('aria-expanded','false');document.body.style.overflow='';}
hamBtn.addEventListener('click',openMob);mobClose.addEventListener('click',closeMob);mobOverlay.addEventListener('click',closeMob);
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&mobPanel.classList.contains('open'))closeMob();});
mobSvcToggle.addEventListener('click',function(){var o=mobSvcSub.classList.toggle('open');mobSvcToggle.classList.toggle('open',o);mobSvcToggle.setAttribute('aria-expanded',o);});

/* THEME */
var themeBtn=document.getElementById('theme-toggle'),mobThemeBtn=document.getElementById('mobThemeBtn');
var dark=localStorage.getItem('nw-theme')==='dark'||(!localStorage.getItem('nw-theme')&&window.matchMedia('(prefers-color-scheme:dark)').matches);
var MOON='<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
var SUN='<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme(){document.body.classList.toggle('dark',dark);themeBtn.innerHTML=dark?SUN:MOON;if(mobThemeBtn)mobThemeBtn.innerHTML=dark?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>';}
applyTheme();function toggleTheme(){dark=!dark;localStorage.setItem('nw-theme',dark?'dark':'light');applyTheme();}
themeBtn.addEventListener('click',toggleTheme);if(mobThemeBtn)mobThemeBtn.addEventListener('click',toggleTheme);

/* COOKIE */
var cookieBar=document.getElementById('cookie-bar');
if(!localStorage.getItem('nw-cookie'))setTimeout(function(){cookieBar.classList.add('show');},2800);
document.getElementById('cookie-accept').addEventListener('click',function(){localStorage.setItem('nw-cookie','1');cookieBar.classList.remove('show');});

/* WA TOOLTIP */
(function(){var shown=sessionStorage.getItem('nw-wa-tip');if(!shown){setTimeout(function(){var tip=document.getElementById('wa-tooltip');if(tip){tip.classList.add('show');sessionStorage.setItem('nw-wa-tip','1');}},5500);}var closeBtn=document.getElementById('waTooltipClose');if(closeBtn){closeBtn.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();document.getElementById('wa-tooltip').classList.remove('show');});}var badge=document.getElementById('waBadge'),floatEl=document.getElementById('wa-float');if(floatEl&&badge){floatEl.addEventListener('mouseenter',function(){badge.style.opacity='0';badge.style.transform='scale(0)';});floatEl.addEventListener('click',function(){var tip=document.getElementById('wa-tooltip');if(tip)tip.classList.remove('show');});}})();

/* COUNTER */
var cObs=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(!entry.isIntersecting)return;var c=entry.target;if(c.dataset.done)return;c.dataset.done='1';var target=+c.dataset.target,duration=1600,step=target/(duration/16),val=0;(function tick(){val=Math.min(val+step,target);c.textContent=Math.floor(val);if(val<target)requestAnimationFrame(tick);})();});},{threshold:.4});
document.querySelectorAll('.pf-stat .counter').forEach(function(el){cObs.observe(el);});

/* FILTER */
(function(){
  var cards=document.querySelectorAll('.pf-card-wrap');
  var noResults=document.getElementById('noResults');

  // Count per category
  var counts={all:0,'Web App':0,'Mobile App':0,'E-commerce':0,'Healthcare':0};
  cards.forEach(function(c){
    var cat=c.dataset.category||'';
    counts.all++;
    if(counts[cat]!==undefined)counts[cat]++;
  });
  var map={'all':'cnt-all','Web App':'cnt-web','Mobile App':'cnt-mobile','E-commerce':'cnt-ecom','Healthcare':'cnt-health'};
  Object.keys(map).forEach(function(k){
    var el=document.getElementById(map[k]);
    if(el)el.textContent=counts[k]||0;
  });

  document.querySelectorAll('.filter-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.querySelectorAll('.filter-btn').forEach(function(b){b.classList.remove('active');});
      this.classList.add('active');
      var filter=this.dataset.filter;
      var visible=0;
      cards.forEach(function(card){
        var match=filter==='all'||card.dataset.category===filter;
        card.classList.toggle('hidden',!match);
        if(match)visible++;
      });
      noResults.style.display=visible===0?'block':'none';
    });
  });
})();
</script>
