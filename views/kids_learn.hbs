</aside>
{{> widget}}

<script>
var COURSE_ID   = {{courseId}};
var CHILD_ID    = {{childId}};
var CURRENT_ID  = {{#if currentLessonId}}{{currentLessonId}}{{else}}null{{/if}};
var CURRENT_DONE= {{#if currentLessonCompleted}}true{{else}}false{{/if}};

/* Build a flat ordered list of all lesson items from the sidebar DOM */
function allLessonItems() {
  return Array.from(document.querySelectorAll('.lesson-item[data-lesson-id]'));
}
function currentIndex() {
  if (!CURRENT_ID) return -1;
  return allLessonItems().findIndex(function(el) { return parseInt(el.dataset.lessonId) === CURRENT_ID; });
}

function toast(msg, type) {
  var el  = document.getElementById('kl-toast');
  var ico = document.getElementById('kl-ico');
  document.getElementById('kl-msg').textContent = msg;
  el.className = 'show ' + (type === 'error' ? 'tkle' : 'tkl');
  ico.className = type === 'error' ? 'fas fa-times-circle' : 'fas fa-check-circle';
  setTimeout(function() { el.className = ''; }, 3400);
}

function switchLesson(el) {
  /* Update sidebar highlight */
  allLessonItems().forEach(function(o) { o.classList.remove('current'); });
  el.classList.add('current');

  CURRENT_ID   = parseInt(el.dataset.lessonId);
  CURRENT_DONE = el.dataset.completed === 'true';
  var videoUrl  = el.dataset.video  || '';
  var title     = el.dataset.title  || '';
  var modTitle  = el.dataset.module || '';

  /* Update lesson bar */
  document.getElementById('lbModule').textContent = modTitle;
  document.getElementById('lbTitle').textContent  = title;

  /* Update video */
  var wrap = document.getElementById('videoWrap');
  if (videoUrl) {
    wrap.innerHTML = '<iframe id="videoFrame" src="' + videoUrl + '" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>';
  } else {
    wrap.innerHTML = '<div class="no-video"><i class="fas fa-film"></i><p id="noVideoMsg">The instructor hasn\'t uploaded a video for this lesson yet.</p></div>';
  }

  /* Update complete button */
  var btn = document.getElementById('completeBtn');
  btn.disabled = false;
  if (CURRENT_DONE) {
    btn.className = 'complete-btn done';
    btn.innerHTML = '<i class="fas fa-check-circle"></i> Completed';
  } else {
    btn.className = 'complete-btn';
    btn.innerHTML = '<i class="fas fa-check"></i> Mark Complete';
  }

  /* Update prev/next */
  var idx = currentIndex();
  var all = allLessonItems();
  document.getElementById('prevBtn').disabled = idx <= 0;
  document.getElementById('nextBtn').disabled = idx < 0 || idx >= all.length - 1;

  /* Scroll sidebar item into view */
  el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  /* Close mobile sidebar */
  document.getElementById('sidebar').classList.remove('open');
}

function goPrev() {
  var idx = currentIndex();
  var all = allLessonItems();
  if (idx > 0) switchLesson(all[idx - 1]);
}
function goNext() {
  var idx = currentIndex();
  var all = allLessonItems();
  if (idx >= 0 && idx < all.length - 1) switchLesson(all[idx + 1]);
}

function markComplete() {
  if (!CURRENT_ID) return;
  if (CURRENT_DONE) { toast('Already marked complete!'); return; }
  var btn = document.getElementById('completeBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving…';

  fetch('/api/kids/lesson/complete', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ childId: CHILD_ID, lessonId: CURRENT_ID, courseId: COURSE_ID })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.success) {
      CURRENT_DONE = true;
      btn.className = 'complete-btn done';
      btn.innerHTML = '<i class="fas fa-check-circle"></i> Completed';
      btn.disabled  = false;
      toast('Lesson complete! 🎉');

      /* Update sidebar item */
      var el = allLessonItems().find(function(o) { return parseInt(o.dataset.lessonId) === CURRENT_ID; });
      if (el) {
        el.classList.add('completed');
        el.dataset.completed = 'true';
        var ico = el.querySelector('.li-ico');
        if (ico) ico.innerHTML = '<i class="fas fa-check"></i>';
        /* Update module counts */
        var modSection = el.closest('.mod-section');
        if (modSection) {
          var total    = modSection.querySelectorAll('.lesson-item').length;
          var done     = modSection.querySelectorAll('.lesson-item.completed').length;
          var cntEl    = modSection.querySelector('.mod-done-cnt');
          if (cntEl) cntEl.textContent = done + '/' + total;
        }
      }

      /* Update progress bars */
      var pct = d.progress || 0;
      document.getElementById('topProgFill').style.width = pct + '%';
      document.getElementById('topProgPct').textContent  = pct + '%';
      document.getElementById('sbProgFill').style.width  = pct + '%';
      document.getElementById('sbProgTxt').textContent   = pct + '%';

      /* Show course complete banner at 100% */
      if (pct >= 100) {
        document.getElementById('completeBanner').classList.add('vis');
      }

      /* Auto-advance to next lesson after a moment */
      setTimeout(function() {
        var idx = currentIndex();
        var all = allLessonItems();
        if (idx >= 0 && idx < all.length - 1) {
          goNext();
        }
      }, 1200);
    } else {
      toast(d.message || 'Could not save progress', 'error');
      btn.disabled  = false;
      btn.innerHTML = '<i class="fas fa-check"></i> Mark Complete';
    }
  }).catch(function() {
    toast('Something went wrong', 'error');
    btn.disabled  = false;
    btn.innerHTML = '<i class="fas fa-check"></i> Mark Complete';
  });
}

function toggleModule(section) {
  section.classList.toggle('closed');
}
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
}

/* Keyboard shortcuts */
document.addEventListener('keydown', function(e) {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
  if (e.key === 'ArrowRight' || e.key === 'n') goNext();
  if (e.key === 'ArrowLeft'  || e.key === 'p') goPrev();
  if (e.key === 'c') markComplete();
});

/* Scroll to current lesson on load */
(function() {
  var cur = document.querySelector('.lesson-item.current');
  if (cur) cur.scrollIntoView({ behavior: 'auto', block: 'center' });
})();
</script>
</body>
</html>
