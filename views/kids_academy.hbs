#soc-sidebar{position:fixed;right:0;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:4px;z-index:9000}
/* desktop: expanding tabs flush right */
.ss-link{display:flex;align-items:center;color:#fff;text-decoration:none;border-radius:8px 0 0 8px;overflow:hidden;width:46px;height:48px;transition:width .32s cubic-bezier(.4,0,.2,1);box-shadow:-3px 2px 14px rgba(0,0,0,.28);flex-shrink:0}
.ss-link:hover,.ss-link:focus-visible{width:154px;outline:none}
.ss-icon{min-width:46px;height:48px;display:flex;align-items:center;justify-content:center;font-size:.95rem;order:2;flex-shrink:0;transition:transform .2s}
.ss-link:hover .ss-icon,.ss-link:focus-visible .ss-icon{transform:scale(1.12)}
.ss-label{order:1;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;padding-left:14px;opacity:0;transform:translateX(10px);transition:opacity .2s .08s,transform .2s .08s;flex:1}
.ss-link:hover .ss-label,.ss-link:focus-visible .ss-label{opacity:1;transform:translateX(0)}
.ss-link.fb{background:#1877f2}
.ss-link.yt{background:#ff0000}
.ss-link.li{background:#0a66c2}
.ss-link.ig{background:linear-gradient(160deg,#f77737 0%,#c13584 45%,#405de6 100%)}
/* mobile: compact pills on the left (opposite WhatsApp) */
@media(max-width:768px){
  #soc-sidebar{right:auto;left:0;gap:5px;top:50%;transform:translateY(-50%)}
  .ss-link{width:36px;height:36px;border-radius:0 10px 10px 0;box-shadow:3px 2px 10px rgba(0,0,0,.25)}
  .ss-link:hover,.ss-link:focus-visible{width:36px}
  .ss-label{display:none}
  .ss-icon{min-width:36px;height:36px;font-size:.8rem;order:1}
  .ss-link:hover .ss-icon,.ss-link:focus-visible .ss-icon{transform:scale(1.08)}
}
@media print{#soc-sidebar{display:none}}
</style>
<aside id="soc-sidebar" aria-label="Follow us on social media">
  <a href="https://www.facebook.com/share/1928ETerkE/" target="_blank" rel="noopener noreferrer" class="ss-link fb" aria-label="Follow us on Facebook"><span class="ss-label">Facebook</span><span class="ss-icon"><i class="fab fa-facebook-f"></i></span></a>
  <a href="https://youtube.com/@neurowextech?si=CSiI92E2peTQmngO" target="_blank" rel="noopener noreferrer" class="ss-link yt" aria-label="Subscribe on YouTube"><span class="ss-label">YouTube</span><span class="ss-icon"><i class="fab fa-youtube"></i></span></a>
  <a href="https://www.linkedin.com/in/neurowex-tech-588045312" target="_blank" rel="noopener noreferrer" class="ss-link li" aria-label="Connect on LinkedIn"><span class="ss-label">LinkedIn</span><span class="ss-icon"><i class="fab fa-linkedin-in"></i></span></a>
  <a href="https://www.instagram.com/neorowex_tech_solutions" target="_blank" rel="noopener noreferrer" class="ss-link ig" aria-label="Follow us on Instagram"><span class="ss-label">Instagram</span><span class="ss-icon"><i class="fab fa-instagram"></i></span></a>
</aside>
{{> widget}}

<script>
var CURRENT_COURSE_ID = null;
var SELECTED_CHILD    = null;
var SELECTED_AVATAR   = '🧒';
var CHILDREN          = {{{json parentChildren}}};

function openEnroll(courseId, title) {
  CURRENT_COURSE_ID = courseId;
  SELECTED_CHILD    = null;
  document.getElementById('modalCourseTitle').textContent = title;
  {{#if isAuthenticated}}
  renderChildren();
  document.getElementById('addChildForm').classList.remove('vis');
  document.getElementById('enrollBtn').disabled = true;
  {{/if}}
  document.getElementById('enrollModal').classList.add('open');
}
function closeEnroll() {
  document.getElementById('enrollModal').classList.remove('open');
}
function handleOverlayClick(e) {
  if (e.target === document.getElementById('enrollModal')) closeEnroll();
}

function renderChildren() {
  var el = document.getElementById('childList');
  if (!el) return;
  if (!CHILDREN.length) {
    el.innerHTML = '<p style="font-size:.82rem;color:#5a6880;padding:4px 0 6px">No children yet — add one below to enrol!</p>';
    return;
  }
  el.innerHTML = CHILDREN.map(function(c) {
    return '<div class="child-opt" data-id="' + c.id + '" onclick="selectChild(this,' + c.id + ')">' +
      '<span class="ch-av">' + (c.avatar_emoji || '🧒') + '</span>' +
      '<div><div class="ch-name">' + esc(c.name) + '</div>' +
      (c.age ? '<div class="ch-age">Age ' + c.age + '</div>' : '') + '</div>' +
    '</div>';
  }).join('');
}

function selectChild(el, id) {
  if (el.classList.contains('is-enrolled')) return;
  document.querySelectorAll('.child-opt').forEach(function(o) { o.classList.remove('selected'); });
  el.classList.add('selected');
  SELECTED_CHILD = id;
  document.getElementById('enrollBtn').disabled = false;
}

function toggleAddForm() {
  document.getElementById('addChildForm').classList.toggle('vis');
}
function pickAv(el) {
  document.querySelectorAll('.av-opt').forEach(function(o) { o.classList.remove('on'); });
  el.classList.add('on');
  SELECTED_AVATAR = el.dataset.emoji;
}
function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function toast(msg, type) {
  var el  = document.getElementById('ka-toast');
  var ico = document.getElementById('toast-ico');
  document.getElementById('toast-msg').textContent = msg;
  el.className = 'show ' + (type === 'error' ? 'toast-err' : 'toast-ok');
  ico.className = type === 'error' ? 'fas fa-times-circle' : 'fas fa-check-circle';
  setTimeout(function() { el.className = ''; }, 3400);
}

function saveChild() {
  var name = (document.getElementById('newChildName').value || '').trim();
  var age  = parseInt(document.getElementById('newChildAge').value) || null;
  if (!name) { toast("Please enter the child's name", 'error'); return; }
  fetch('/api/kids/children', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name: name, age: age, avatar_emoji: SELECTED_AVATAR })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.success) {
      CHILDREN.push(d.child);
      renderChildren();
      document.getElementById('newChildName').value = '';
      document.getElementById('newChildAge').value  = '';
      document.getElementById('addChildForm').classList.remove('vis');
      toast(name + ' added!');
    } else { toast(d.message || 'Could not add child', 'error'); }
  }).catch(function() { toast('Something went wrong', 'error'); });
}

function doEnroll() {
  if (!SELECTED_CHILD || !CURRENT_COURSE_ID) return;
  var btn = document.getElementById('enrollBtn');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enrolling…';
  fetch('/api/kids/enroll', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ childId: SELECTED_CHILD, courseId: CURRENT_COURSE_ID })
  }).then(function(r) { return r.json(); }).then(function(d) {
    if (d.success) {
      toast(d.message || 'Enrolled!');
      closeEnroll();
      if (d.redirect) setTimeout(function() { window.location.href = d.redirect; }, 900);
    } else {
      toast(d.message || 'Enrollment failed', 'error');
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-rocket"></i> Enrol Now';
    }
  }).catch(function() {
    toast('Something went wrong', 'error');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-rocket"></i> Enrol Now';
  });
}
</script>
</body>
</html>
