const navbar    = document.getElementById('mainNav');
const btt       = document.getElementById('back-to-top');
window.addEventListener('scroll', () => {
  const st = window.pageYOffset;
  const dh = document.documentElement.scrollHeight - window.innerHeight;
  if(scrollPrg) scrollPrg.style.width = (dh > 0 ? (st/dh)*100 : 0) + '%';
  if(navbar)    navbar.classList.toggle('scrolled', st > 40);
  if(btt)       btt.classList.toggle('visible', st > 400);
}, {passive:true});
btt && btt.addEventListener('click', () => window.scrollTo({top:0,behavior:'smooth'}));

// ── THEME ──────────────────────────────────────────────────────
const themeBtn = document.getElementById('theme-toggle');
let dark = localStorage.getItem('nw-theme') === 'dark' ||
           (!localStorage.getItem('nw-theme') && window.matchMedia('(prefers-color-scheme:dark)').matches);
const MOON = '<svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
const SUN  = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
function applyTheme() { document.body.classList.toggle('dark', dark); if(themeBtn) themeBtn.innerHTML = dark ? SUN : MOON; }
applyTheme();
themeBtn && themeBtn.addEventListener('click', () => { dark=!dark; localStorage.setItem('nw-theme',dark?'dark':'light'); applyTheme(); });
const mobThemeBtn = document.getElementById('mobThemeBtn');
mobThemeBtn && mobThemeBtn.addEventListener('click', () => { dark=!dark; localStorage.setItem('nw-theme',dark?'dark':'light'); applyTheme(); });

// ── MOBILE NAV ──────────────────────────────────────────────────
const mobOverlay   = document.getElementById('mobOverlay');
const mobPanel     = document.getElementById('mobPanel');
const hamBtn       = document.getElementById('hamBtn');
const mobClose     = document.getElementById('mobClose');
const mobSvcToggle = document.getElementById('mobSvcToggle');
const mobSvcSub    = document.getElementById('mobSvcSub');
function openMob()  { mobOverlay.classList.add('open'); mobPanel.classList.add('open'); hamBtn.classList.add('open'); hamBtn.setAttribute('aria-expanded','true'); document.body.style.overflow='hidden'; }
function closeMob() { mobPanel.classList.remove('open'); mobOverlay.classList.remove('open'); hamBtn.classList.remove('open'); hamBtn.setAttribute('aria-expanded','false'); document.body.style.overflow=''; }
hamBtn    && hamBtn.addEventListener('click', openMob);
mobClose  && mobClose.addEventListener('click', closeMob);
mobOverlay && mobOverlay.addEventListener('click', closeMob);
document.addEventListener('keydown', e => { if(e.key==='Escape' && mobPanel?.classList.contains('open')) closeMob(); });
mobSvcToggle && mobSvcToggle.addEventListener('click', function() {
  const isOpen = mobSvcSub.classList.toggle('open');
  mobSvcToggle.classList.toggle('open', isOpen);
  mobSvcToggle.setAttribute('aria-expanded', isOpen);
});

// ── COOKIE ──────────────────────────────────────────────────────
const cookieBar = document.getElementById('cookie-bar');
if(!localStorage.getItem('nw-cookie')) setTimeout(()=>cookieBar?.classList.add('show'), 2600);
document.getElementById('cookie-accept')?.addEventListener('click', () => {
  localStorage.setItem('nw-cookie','1'); cookieBar?.classList.remove('show');
});

// ── TOAST ────────────────────────────────────────────────────────
function showToast(msg, col) {
  const t = document.getElementById('toast');
  if(!t) return;
  t.style.borderLeftColor = col || 'var(--emerald)';
  document.getElementById('toast-msg').textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3800);
}

// ── WA FLOAT ────────────────────────────────────────────────────
(function(){
  const badge   = document.getElementById('waBadge');
  const tooltip = document.getElementById('wa-tooltip') || document.getElementById('waTooltip');
  const ttClose = document.getElementById('waTooltipClose') || document.getElementById('waTTClose');
  const wa      = document.getElementById('wa-float');
  if(wa && badge) wa.addEventListener('mouseenter', () => { badge.style.opacity='0'; badge.style.transform='scale(0)'; });
  if(tooltip && !sessionStorage.getItem('nw-wa-tt')) setTimeout(()=>tooltip.classList.add('show'), 5200);
  if(ttClose && tooltip) ttClose.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); tooltip.classList.remove('show'); sessionStorage.setItem('nw-wa-tt','1'); });
  if(wa && tooltip) wa.addEventListener('click', () => sessionStorage.setItem('nw-wa-tt','1'));
})();

// ── FILTERING ────────────────────────────────────────────────────
const posts       = document.querySelectorAll('.post-item');
const noResultsEl = document.getElementById('noResults');
const searchInp   = document.getElementById('blogSearch');
let activeCat     = 'all';

function filterPosts() {
  const term = searchInp.value.toLowerCase().trim();
  let visible = 0;
  posts.forEach(p => {
    const cat   = p.dataset.cat   || '';
    const title = p.dataset.title || '';
    const matchCat    = activeCat === 'all' || cat.includes(activeCat);
    const matchSearch = !term || title.includes(term) || cat.includes(term);
    const show = matchCat && matchSearch;
    p.style.display = show ? '' : 'none';
    if(show) visible++;
  });
  if(noResultsEl) noResultsEl.classList.toggle('show', visible === 0 && posts.length > 0);
}

// Category buttons
document.querySelectorAll('.cat-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
    activeCat = this.dataset.cat;
    filterPosts();
    window.scrollTo({top: document.getElementById('catFilters')?.offsetTop - 100, behavior:'smooth'});
  });
});

// Search
searchInp && searchInp.addEventListener('input', filterPosts);
document.getElementById('searchGoBtn')?.addEventListener('click', () => {
  filterPosts();
  document.getElementById('postsGrid')?.scrollIntoView({behavior:'smooth', block:'start'});
});
searchInp && searchInp.addEventListener('keydown', e => {
  if(e.key === 'Enter') {
    filterPosts();
    document.getElementById('postsGrid')?.scrollIntoView({behavior:'smooth', block:'start'});
  }
});

function filterByTag(cat) {
  activeCat = cat;
  document.querySelectorAll('.cat-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.cat === cat);
  });
  filterPosts();
  document.getElementById('catFilters')?.scrollIntoView({behavior:'smooth', block:'start'});
}

// ── SIDEBAR NEWSLETTER ────────────────────────────────────────
document.getElementById('sidebarNlForm')?.addEventListener('submit', async e => {
  e.preventDefault();
  const email  = document.getElementById('sidebarNlEmail').value.trim();
  const msg    = document.getElementById('sidebarNlMsg');
  const btn    = e.target.querySelector('button[type="submit"]');
  if(!email) return;
  const orig = btn.innerHTML;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Subscribing…';
  btn.disabled = true;
  try {
    const r = await fetch('/subscribe', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({email})
    });
    const d = await r.json();
    if(d.success) {
      msg.innerHTML = '<span style="color:var(--emerald)"><i class="fas fa-check-circle"></i> Subscribed! Welcome 🎉</span>';
      document.getElementById('sidebarNlEmail').value = '';
      showToast('Subscribed! Welcome aboard 🎉');
    } else {
      msg.innerHTML = `<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> ${d.message}</span>`;
    }
  } catch {
    msg.innerHTML = '<span style="color:#ef4444"><i class="fas fa-exclamation-circle"></i> Network error. Try again.</span>';
  }
  btn.innerHTML = orig; btn.disabled = false;
  setTimeout(() => { if(msg) msg.innerHTML = ''; }, 5000);
});

// ── SMOOTH SCROLL for # links ─────────────────────────────────
document.addEventListener('click', e => {
  const link = e.target.closest('a[href^="#"]');
  if(!link) return;
  const href = link.getAttribute('href');
  if(!href || href.length <= 1) return;
  const target = document.querySelector(href);
  if(target) { e.preventDefault(); target.scrollIntoView({behavior:'smooth', block:'start'}); }
});
</script>
