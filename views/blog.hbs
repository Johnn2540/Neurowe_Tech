             {{#if this.external_url}}target="_blank" rel="noopener noreferrer"{{/if}}
             class="recent-post-item">
            <div class="rpi-img">
              {{#if this.image_url}}
              <img src="{{this.image_url}}" alt="{{this.title}}" loading="lazy" onerror="this.parentElement.style.background='var(--mist)'" />
              {{else}}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:1.3rem;background:var(--blue-pale)">📝</div>
              {{/if}}
            </div>
            <div>
              <div class="rpi-title">{{this.title}}</div>
              <div class="rpi-date">{{shortDate this.created_at}}</div>
            </div>
          </a>
          {{/if}}
          {{/if}}
          {{/each}}
        </div>
      </div>
      {{/if}}

      <!-- Tags -->
      <div class="sidebar-card" data-aos="fade-up">
        <div class="sidebar-card-head"><i class="fas fa-tags"></i> Topics</div>
        <div class="sidebar-card-body">
          <div class="tag-cloud">
            <a class="tag-pill" onclick="filterByTag('development'); return false;" href="#">Development</a>
            <a class="tag-pill" onclick="filterByTag('ai & machine learning'); return false;" href="#">AI & ML</a>
            <a class="tag-pill" onclick="filterByTag('ui/ux design'); return false;" href="#">UI/UX</a>
            <a class="tag-pill" onclick="filterByTag('business'); return false;" href="#">Business</a>
            <a class="tag-pill" onclick="filterByTag('tutorial'); return false;" href="#">Tutorial</a>
            <a class="tag-pill" onclick="filterByTag('all'); return false;" href="#">All Topics</a>
          </div>
        </div>
      </div>

      <!-- Newsletter -->
      <div class="sidebar-card" data-aos="fade-up">
        <div class="sidebar-card-head"><i class="fas fa-envelope-open-text"></i> Newsletter</div>
        <div class="sidebar-card-body">
          <p style="font-size:.8rem;color:var(--slate);margin-bottom:13px;line-height:1.6;">
            Get the best articles delivered to your inbox. Zero spam, unsubscribe anytime.
          </p>
          <form id="sidebarNlForm">
            <input type="email" id="sidebarNlEmail" class="nl-mini-input" placeholder="your@email.com" required />
            <button type="submit" class="btn-primary" style="width:100%;justify-content:center;padding:10px;font-size:.82rem;">
              <i class="fas fa-paper-plane"></i> Subscribe Free
            </button>
            <p id="sidebarNlMsg" style="font-size:.74rem;margin-top:7px;min-height:18px;" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>

      <!-- CTA -->
      <div style="background:var(--g-hero);border-radius:var(--r-xl);padding:24px 20px;text-align:center;position:relative;overflow:hidden;" data-aos="fade-up">
        <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(26,86,232,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(26,86,232,.07) 1px,transparent 1px);background-size:28px 28px;pointer-events:none"></div>
        <div style="position:relative;">
          <div style="font-size:2rem;margin-bottom:10px;">🚀</div>
          <h4 style="font-size:1rem;font-weight:800;color:#fff;margin-bottom:8px;">Ready to build?</h4>
          <p style="font-size:.77rem;color:rgba(255,255,255,.55);margin-bottom:16px;line-height:1.6;">Turn your idea into a product in 6 weeks.</p>
          <a href="/#contact" class="btn-orange" style="padding:10px 18px;font-size:.82rem;width:100%;justify-content:center;">Start a Project</a>
        </div>
      </div>

    </aside>
  </div>

</div>

