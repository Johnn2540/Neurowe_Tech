<!-- BLOG HERO -->
<section class="blog-hero">
  <div class="bh-glow-1" aria-hidden="true"></div>
  <div class="bh-glow-2" aria-hidden="true"></div>
  <div class="container">
    <div data-aos="fade-up">
      <div class="bh-eyebrow"><span class="dot"></span> NeurowexTech Insights</div>
      <h1>Expert <span>Articles</span> &<br>Tech Insights</h1>
      <p>Deep-dives on web development, AI, UI/UX design, and digital growth — written by the NeurowexTech team.</p>
      <div style="margin-top:24px;">
        <div class="blog-search-wrap">
          <i class="fas fa-search"></i>
          <input type="text" id="blogSearch" placeholder="Search articles…" autocomplete="off" />
          <button class="search-go" id="searchGoBtn">Search</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MAIN CONTENT -->
<div class="container section-py">

  <!-- FEATURED POST -->
  {{#if featuredPost}}
  <div data-aos="fade-up">
    <div class="featured-post">
      <div class="fp-img">
        <img src="{{featuredPost.image_url}}" alt="{{featuredPost.title}}"
             onerror="this.src='https://placehold.co/800x500/1a56e8/white?text=Featured'" loading="lazy" />
      </div>
      <div class="fp-body">
        <div class="fp-featured-tag"><i class="fas fa-star" style="font-size:.6rem"></i> Featured Article</div>
        <h2><a href="/blog/{{featuredPost.slug}}">{{featuredPost.title}}</a></h2>
        <p class="desc">{{truncateWords featuredPost.excerpt 28}}</p>
        <div class="fp-meta">
          <span><i class="fas fa-user"></i> {{featuredPost.author}}</span>
          <span><i class="fas fa-calendar-alt"></i> {{shortDate featuredPost.created_at}}</span>
          {{#if featuredPost.read_time}}<span><i class="fas fa-clock"></i> {{featuredPost.read_time}} min read</span>{{/if}}
        </div>
        <div style="margin-top:18px;">
          <a href="/blog/{{featuredPost.slug}}" class="btn-primary" style="padding:10px 22px;font-size:.84rem;">
            Read Article <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

  <!-- CATEGORY FILTERS -->
  <div class="cat-filters" data-aos="fade-up" id="catFilters">
    <button class="cat-btn active" data-cat="all">All Posts</button>
    <button class="cat-btn cat-dev" data-cat="development">
      <i class="fas fa-laptop-code" style="font-size:.7rem;margin-right:4px"></i> Development
    </button>
    <button class="cat-btn cat-ai" data-cat="ai & machine learning">
      <i class="fas fa-robot" style="font-size:.7rem;margin-right:4px"></i> AI & ML
    </button>
    <button class="cat-btn cat-ui" data-cat="ui/ux design">
      <i class="fas fa-palette" style="font-size:.7rem;margin-right:4px"></i> UI/UX Design
    </button>
    <button class="cat-btn cat-gen" data-cat="business">
      <i class="fas fa-briefcase" style="font-size:.7rem;margin-right:4px"></i> Business
    </button>
    <button class="cat-btn cat-gen" data-cat="tutorial">
      <i class="fas fa-book-open" style="font-size:.7rem;margin-right:4px"></i> Tutorial
    </button>
  </div>

  <!-- LAYOUT: Posts + Sidebar -->
  <div class="blog-layout">

    <!-- POSTS GRID -->
    <div>
      {{#if posts}}
      <div class="posts-grid" id="postsGrid">
        {{#each posts}}
        <article class="bl-card post-item"
                 data-cat="{{lowercase this.category}}"
                 data-title="{{lowercase this.title}}"
                 data-aos="fade-up" data-aos-delay="{{multiply @index 40}}">
          <div class="bl-img">
            {{#if this.image_url}}
            <img src="{{this.image_url}}" alt="{{this.title}}"
                 onerror="this.parentElement.innerHTML='<div class=\"bl-img-placeholder\" style=\"background:var(--blue-pale)\">📝</div>'"
                 loading="lazy" />
            {{else}}
            <div class="bl-img-placeholder" style="background:{{#if (eq this.category 'AI & Machine Learning')}}rgba(13,191,126,.09){{else if (eq this.category 'UI/UX Design')}}var(--orange-pale){{else}}var(--blue-pale){{/if}}">
              {{#if (eq this.category 'AI & Machine Learning')}}🤖{{else if (eq this.category 'UI/UX Design')}}🎨{{else if (eq this.category 'Tutorial')}}📚{{else if (eq this.category 'Business')}}💼{{else}}💻{{/if}}
            </div>
            {{/if}}
          </div>
          <div class="bl-body">
            <span class="bl-cat {{#if (eq this.category 'Development')}}dev{{else if (eq this.category 'AI & Machine Learning')}}ai{{else if (eq this.category 'UI/UX Design')}}ui{{else}}gen{{/if}}">
              {{this.category}}
            </span>
            <h3><a href="/blog/{{this.slug}}">{{this.title}}</a></h3>
            <p class="bl-excerpt">{{this.excerpt}}</p>
            <div class="bl-meta">
              <span><i class="fas fa-user"></i> {{default this.author "NeurowexTech"}}</span>
              <span><i class="fas fa-calendar-alt"></i> {{shortDate this.created_at}}</span>
              {{#if this.read_time}}<span><i class="fas fa-clock"></i> {{this.read_time}} min</span>{{/if}}
            </div>
            {{#if this.external_url}}
            <a href="{{this.external_url}}" target="_blank" rel="noopener noreferrer" class="bl-read-more">
              {{#if this.is_video}}Watch Video <i class="fab fa-youtube"></i>{{else}}Read Article <i class="fas fa-arrow-right"></i>{{/if}}
            </a>
            {{else}}
            <a href="/blog/{{this.slug}}" class="bl-read-more">
              Read Article <i class="fas fa-arrow-right"></i>
            </a>
            {{/if}}
          </div>
        </article>
        {{/each}}
        <div class="no-results" id="noResults">
          <i class="fas fa-search"></i>
          <h4>No articles found</h4>
          <p>Try a different search term or category filter.</p>
        </div>
      </div>
      {{else}}
      <div class="blog-empty">
        <i class="fas fa-feather-pointed"></i>
        <h4>No articles yet</h4>
        <p>We're working on some great content — check back soon!</p>
        <a href="/" class="btn-primary" style="margin-top:18px;display:inline-flex;">Back to Home</a>
      </div>
      {{/if}}

      <!-- PAGINATION -->
      {{#if (gt totalPages 1)}}
      <nav class="pagination" aria-label="Blog pagination" style="margin-top:36px;">
        {{#if hasPrev}}
        <a href="/blog?page={{dec page}}" class="pag-btn" aria-label="Previous page">
          <i class="fas fa-chevron-left"></i>
        </a>
        {{else}}
        <button class="pag-btn" disabled style="opacity:.4;cursor:not-allowed;" aria-label="Previous page">
          <i class="fas fa-chevron-left"></i>
        </button>
        {{/if}}

        <span class="pag-btn active" aria-current="page">{{page}}</span>
        {{#if (gt totalPages 1)}}
        <span style="display:flex;align-items:center;padding:0 4px;font-size:.78rem;color:var(--slate);">of {{totalPages}}</span>
        {{/if}}

        {{#if hasNext}}
        <a href="/blog?page={{inc page}}" class="pag-btn" aria-label="Next page">
          <i class="fas fa-chevron-right"></i>
        </a>
        {{else}}
        <button class="pag-btn" disabled style="opacity:.4;cursor:not-allowed;" aria-label="Next page">
          <i class="fas fa-chevron-right"></i>
        </button>
        {{/if}}
      </nav>
      {{/if}}
    </div>

    <!-- SIDEBAR -->
    <aside class="blog-sidebar">

      <!-- Recent Posts -->
      {{#if posts}}
      <div class="sidebar-card" data-aos="fade-up">
        <div class="sidebar-card-head"><i class="fas fa-clock-rotate-left"></i> Recent Posts</div>
        <div class="sidebar-card-body" style="padding:10px 16px;">
          {{#each posts}}
          {{#if @first}}{{else}}
          {{#if (lt @index 5)}}
